%YAML 1.2
---
# Ctron (.ct) — Sublime Text syntax
# 权威依据:docs/spec/01-lexical-grammar.md §1.2–§1.6
# 结构与 editors/vscode-ctron/syntaxes/ctron.tmLanguage.json 对齐
name: Ctron
file_extensions:
  - ct
scope: source.ctron

variables:
  keyword: '(?:(?:fn|let|var|const|static|comptime|if|else|match|while|for|in|return|struct|class|enum|trait|impl|own|scope|test|use|pub|extern|prop|break|continue)\b)'
  boolean: '(?:true|false|void|self)'
  number: '(?:0x[0-9a-fA-F][0-9a-fA-F_]*|0o[0-7][0-7_]*|0b[01][01_]*|[0-9][0-9_]*(?:\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?(?:i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64)?)'
  identifier: '(?:_?[A-Za-z_][A-Za-z0-9_]*)'

contexts:
  main:
    - match: '//'
      scope: punctuation.definition.comment.ctron
      push: line_comment
    - match: '@derive\b'
      scope: meta.annotation.ctron storage.modifier.ctron
    - match: '#\['
      scope: punctuation.definition.annotation.begin.ctron
      push: annotation_body
    - match: '"'
      scope: punctuation.definition.string.begin.ctron
      push: string
    - match: '{{number}}'
      scope: constant.numeric.ctron
    - match: '{{boolean}}'
      scope: constant.language.ctron
    - match: '\b(fn)\s+({{identifier}})\b'
      captures:
        1: keyword.declaration.fn.ctron
        2: entity.name.function.ctron
    - match: '\b(struct|class|enum|trait)\s+([A-Z][A-Za-z0-9_]*)\b'
      captures:
        1: keyword.declaration.struct.ctron
        2: entity.name.type.ctron
    - match: '\b(const|static)(?:\s+(let))?\s+([A-Z_][A-Z0-9_]*)\b'
      captures:
        1: keyword.declaration.const.ctron
        2: keyword.declaration.const.ctron
        3: entity.name.constant.ctron
    - match: '\b(if|else|match)\b'
      scope: keyword.control.conditional.ctron
    - match: '\b(while|for|in|return)\b'
      scope: keyword.control.repeat.ctron
    - match: '\b(struct|class|enum|trait|impl|own|scope|prop|test|use|pub|extern|comptime|as)\b'
      scope: keyword.control.ctron
    - match: '\b(fn|let|var|const|static)\b'
      scope: keyword.declaration.ctron
    - match: '\b(self)\b'
      scope: variable.language.ctron
    - match: '\b(Bool|I8|I16|I32|I64|ISize|U8|U16|U32|U64|USize|F32|F64|Str|String)\b'
      scope: support.type.ctron
    - match: '\b(Option|Result|List|Box|Channel|Mutex|Atomic|Global|Arena|Task|Simd|AnyError)\b'
      scope: support.class.ctron
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type.ctron
    - match: '\.\.'
      scope: keyword.operator.range.ctron
    - match: '=>|->|\+\+|--'
      scope: keyword.operator.ctron
    - match: '[+\-*/%<>=!&|?]'
      scope: keyword.operator.arithmetic.ctron
    - match: ';|,|:|\.'
      scope: punctuation.separator.ctron
    - match: '\(|\)|\[|\]|\{|\}'
      scope: punctuation.section.block.ctron

  line_comment:
    - meta_scope: comment.line.double-slash.ctron
    - match: $
      pop: true

  annotation_body:
    - meta_scope: meta.annotation.ctron
    - match: '[A-Za-z_][A-Za-z0-9_.]*'
      scope: entity.other.attribute-name.ctron
    - match: '\)'
      scope: punctuation.definition.annotation.end.ctron
      pop: true
    - match: '\]'
      scope: punctuation.definition.annotation.end.ctron
      pop: true

  string:
    - meta_scope: string.quoted.double.ctron
    - match: '\\[ntr\\"0{]|\\u\{[0-9a-fA-F_]+\}'
      scope: constant.character.escape.ctron
    - match: '\{'
      scope: punctuation.section.interpolation.begin.ctron
      push: interpolation
    - match: '"'
      scope: punctuation.definition.string.end.ctron
      pop: true

  interpolation:
    - meta_scope: meta.interpolation.ctron
    - match: '\}'
      scope: punctuation.section.interpolation.end.ctron
      pop: true
    - match: '{{number}}'
      scope: constant.numeric.ctron
    - match: '{{identifier}}'
      scope: variable.other.ctron
