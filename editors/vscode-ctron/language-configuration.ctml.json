{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_-]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*(//.*)?$|^.*<[a-zA-Z][A-Za-z0-9_-]*(\\s[^<>]*)?>$",
    "decreaseIndentPattern": "^\\s*\\}\\s*(//.*)?$|^\\s*</[a-zA-Z][A-Za-z0-9_-]*>.*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*///.*$",
      "afterText": "^\\s*///\\s.*$",
      "action": {
        "indent": "none",
        "appendText": "/// "
      }
    },
    {
      "beforeText": "^\\s*///.*$",
      "action": {
        "indent": "none",
        "appendText": "/// "
      }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  }
}
