{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ctron Config Language (CTCL)",
  "scopeName": "source.ctcl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#invalid" },
    { "include": "#block-head-known" },
    { "include": "#block-head" },
    { "include": "#fields" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ctcl",
          "match": "//.*$"
        }
      ]
    },
    "invalid": {
      "patterns": [
        {
          "name": "invalid.illegal.hash-comment.ctcl",
          "match": "#.*$"
        },
        {
          "name": "invalid.illegal.section-header.ctcl",
          "match": "^\\s*\\[[^\\]\\n]*\\]?"
        },
        {
          "name": "invalid.illegal.single-quote.ctcl",
          "match": "'[^'\\n]*"
        },
        {
          "name": "invalid.illegal.number-base.ctcl",
          "match": "\\b0[xXoObB][0-9a-fA-F_]+\\b"
        },
        {
          "name": "invalid.illegal.float.ctcl",
          "match": "\\b[0-9]+\\.[0-9_]+"
        },
        {
          "name": "invalid.illegal.trailing-comma.ctcl",
          "match": ",\\s*\\]"
        }
      ]
    },
    "block-head-known": {
      "name": "meta.block.head.ctcl",
      "match": "^\\s*\\b(pkg|comptime|dep|lock|resolve|workspace|profile|member|cap|menu|fmt|bench)\\b(\\s+(\"(?:\\\\.|[^\"\\\\])*\"))?(?=\\s*\\{)",
      "captures": {
        "1": { "name": "keyword.declaration.ctcl" },
        "3": {
          "name": "string.quoted.double.block-name.ctcl",
          "patterns": [ { "include": "#escapes" } ]
        }
      }
    },
    "block-head": {
      "name": "meta.block.head.ctcl",
      "match": "^\\s*([a-z_][a-z0-9_]*)(\\s+(\"(?:\\\\.|[^\"\\\\])*\"))?(?=\\s*\\{)",
      "captures": {
        "1": { "name": "entity.name.section.ctcl" },
        "3": {
          "name": "string.quoted.double.block-name.ctcl",
          "patterns": [ { "include": "#escapes" } ]
        }
      }
    },
    "fields": {
      "patterns": [
        {
          "name": "meta.field.ctcl",
          "match": "^\\s*([a-z_][a-z0-9_]*)(\\s*)(=)(?!=)",
          "captures": {
            "1": { "name": "variable.other.property.ctcl" },
            "3": { "name": "keyword.operator.assignment.ctcl" }
          }
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.ctcl",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.ctcl",
          "match": "-?\\b(0|[1-9][0-9_]*)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ctcl",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ctcl" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ctcl" } },
          "patterns": [
            { "include": "#escapes" },
            {
              "name": "invalid.illegal.escape.ctcl",
              "match": "\\\\[^\"\\\\]"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.ctcl",
          "match": "\\\\[\"\\\\]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "meta.brackets.square.ctcl",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.separator.comma.ctcl",
          "match": ","
        },
        {
          "name": "punctuation.section.block.begin.ctcl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.ctcl",
          "match": "\\}"
        }
      ]
    }
  }
}
