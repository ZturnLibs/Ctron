// net.ct —— 服务器档传输门面(§11;P1-C 完整面)
// 门面形态(控制器裁定,依 Task 4/5/6 发射面事实):
//   ① 免费函数面(struct Net + pub fn net_*,std/fs.ct 同款),非 trait 方法——
//      trait 方法调用不可发射(t_m 尾逗号缺口,Task 5 登记);trait Net +
//      probe() + Net_probe() stub 面原样保留(caps_net/modules 依赖,sem 绿)。
//   ② 传输函数首参 net: StdNet 按值——&Net/&struct 引用形参发射即坏
//      (Ref+Named → int32_t / 非法 C,Task 6 微探针登记),句柄按值传递即
//      调用点能力显形;E4010 审计锚 = &Net 引用形参 fn(本文件 trait 面 +
//      tests/modules/caps_net + r7b 锚点)。
//   ③ 错误面 = rc 路径:0 成 / <0 败 + last_net_error() 取 NetError——
//      Result[struct, _] 的 Ok 绑定成员访问不可发射(ct_expr:Member panic,
//      Task 6 微探针登记);Result[标量, _] 可用但句柄成员必经路,统一 rc。
//   ④ 句柄 = 值 struct + I64 fd + impl Drop(fd>=0 才关);var fd 允许显式
//      close 后置 -1 防作用域出口二次关。缓冲 = &I64[] 视图 lane(每字节
//      一条 I64 lane,Task 4 登记的 I8/U8 视图缺口绕行)。
//   ⑤ 单次读/收调用至多搬运 4096 字节(垫片 CT_CHUNK 上限,cap 更大也被截到
//      该值);UDP 单报文超限截断,EMSGSIZE 守卫列 P2。
// 时钟/睡眠经 bind.ct 外链 ctron_net.c 垫片;TCP/UDP/AF_UNIX/resolve 全量同文件。
use net.bind.{ctron_net_now_ns, ctron_net_sleep_ms, ctron_net_last_errno, ctron_net_strerror, str_from_c, ctron_net_tcp_listen, ctron_net_tcp_sockname, ctron_net_tcp_accept, ctron_net_tcp_connect, ctron_net_read_t, ctron_net_write, ctron_net_write_str, ctron_net_close, ctron_net_shutdown_write, ctron_net_set_nodelay, ctron_net_get_nodelay, ctron_net_udp_socket, ctron_net_udp_bind, ctron_net_udp_sendto, ctron_net_udp_recvfrom, ctron_net_resolve_first, ctron_net_unix_listen, ctron_net_unix_accept, ctron_net_unix_connect, ctron_net_unix_unlink}

// ---- 能力 trait(stub 面原样保留;sem 审计锚:E4010 看 &Net 引用形参) ----

trait Net: Cap {
    fn probe(&self) -> I32
    fn now_ns(&self) -> I64
    fn sleep_ms(&self, ms: I64)
}

struct StdNet {
}

impl Net for StdNet {
    fn probe(&self) -> I32 {
        return 0
    }
    fn now_ns(&self) -> I64 {
        return ctron_net_now_ns()
    }
    fn sleep_ms(&self, ms: I64) {
        ctron_net_sleep_ms(ms)
    }
}

pub fn Net_probe() -> StdNet {
    return StdNet { }
}

// ---- 句柄与错误类型(值 struct;fd < 0 视为已关闭) ----

struct NetError {
    let message: Str
}

struct TcpListener {
    var fd: I64
    let port: I32
}

struct TcpStream {
    var fd: I64
}

struct UdpSock {
    var fd: I64
}

// P3-E:AF_UNIX 句柄(POSIX 专面;_WIN32 垫片显式 EAFNOSUPPORT)。path 仅
// 记录面(Drop 不摘 socket 文件 —— 后绑者赢语义下"最后一个 Drop 摘路径"会
// 误摘继任者的活路径;显式清理走 net_unix_unlink,夹具负责)。
struct UnixListener {
    var fd: I64
    let path: Str
}

struct UnixStream {
    var fd: I64
}

// RAII:作用域出口关 fd;显式 net_close 后须把 fd 置 -1(见下注),Drop 跳过。
impl Drop for TcpListener {
    fn drop(var self) {
        if self.fd >= 0 {
            ctron_net_close(self.fd)
        }
    }
}

impl Drop for TcpStream {
    fn drop(var self) {
        if self.fd >= 0 {
            ctron_net_close(self.fd)
        }
    }
}

impl Drop for UdpSock {
    fn drop(var self) {
        if self.fd >= 0 {
            ctron_net_close(self.fd)
        }
    }
}

impl Drop for UnixListener {
    fn drop(var self) {
        if self.fd >= 0 {
            ctron_net_close(self.fd)
        }
    }
}

impl Drop for UnixStream {
    fn drop(var self) {
        if self.fd >= 0 {
            ctron_net_close(self.fd)
        }
    }
}

// 最后一次垫片错误的详情(errno 槽;0 = 无错可读)。
pub fn last_net_error() -> NetError {
    let e = ctron_net_last_errno()
    if e == 0 {
        return NetError { message: "unknown net error" }
    }
    return NetError { message: "net error " + e.to_string() + ": " + str_from_c(ctron_net_strerror(e)) }
}

// ---- SocketAddr 纯 Ctron 解析/格式化("host:port" / "[v6]:port") ----

// 取端口;无 ':' 或端口段非数字 → -1
pub fn addr_port(addr: Str) -> I64 {
    var i: I32 = addr.len - 1
    while i >= 0 {
        if byte_at(addr, i) == 58 {
            if i + 1 >= addr.len {
                return -1
            }
            var v: I64 = 0
            var j: I32 = i + 1
            while j < addr.len {
                let c = byte_at(addr, j)
                if c < 48 || c > 57 {
                    return -1
                }
                v = v * 10 + (c - 48)
                j += 1
            }
            return v
        }
        i -= 1
    }
    return -1
}

// 取主机:点分形态取最后一个 ':' 前;方括号形态取 '[' ']' 之间
pub fn addr_host(addr: Str) -> Str {
    if addr.len > 0 && byte_at(addr, 0) == 91 {
        var k: I32 = 1
        while k < addr.len {
            if byte_at(addr, k) == 93 {
                return byte_slice(addr, 1, k)
            }
            k += 1
        }
        return ""
    }
    var i: I32 = addr.len - 1
    while i >= 0 {
        if byte_at(addr, i) == 58 {
            return byte_slice(addr, 0, i)
        }
        i -= 1
    }
    return addr
}

pub fn addr_format(host: Str, port: I64) -> Str {
    return host + ":" + port.to_string()
}

// ---- 传输免费函数(net: StdNet 首参 = 调用点能力显形;rc 约定见 bind.ct) ----

// 监听;SO_REUSEADDR 于垫片内开启;port 传 0 由内核分配,实际端口经
// net_tcp_sockname 回读。成功后可构造 TcpListener { fd: out_fd.v, port: <回读> }。
pub fn net_tcp_listen(net: StdNet, host: Str, port: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_tcp_listen(host, port, out_fd)
}

// 回读监听/绑定实际端口(:0 分配结果)
pub fn net_tcp_sockname(net: StdNet, fd: I64, out_port: Box[Box64]) -> I64 {
    return ctron_net_tcp_sockname(fd, out_port)
}

// 接受连接;垫片在出口开 NODELAY+KEEPALIVE(§11.3)。构造 TcpStream { fd: out_fd.v }。
pub fn net_tcp_accept(net: StdNet, lfd: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_tcp_accept(lfd, out_fd)
}

// 连接;NODELAY+KEEPALIVE 默认开(§11.3)。
pub fn net_tcp_connect(net: StdNet, host: Str, port: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_tcp_connect(host, port, out_fd)
}

// 带超时读:timeout_ms <= 0 永久阻塞;>0 到时置 ETIMEDOUT 返 -1。
// >0 n / 0 eof / <0 err;字节逐条入 lane;单次调用至多搬运 4096 字节(头注⑤)。
pub fn net_read_t(net: StdNet, fd: I64, buf: &I64[], cap: I64, timeout_ms: I64) -> I64 {
    return ctron_net_read_t(fd, buf, cap, timeout_ms)
}

pub fn net_write(net: StdNet, fd: I64, buf: &I64[], n: I64) -> I64 {
    return ctron_net_write(fd, buf, n)
}

pub fn net_write_str(net: StdNet, fd: I64, s: Str) -> I64 {
    return ctron_net_write_str(fd, s)
}

// 显式关闭;调用后必须 st.fd = -1(var 字段),否则作用域出口 Drop 二次关。
// P1 夹具推荐 Drop-only(不显式 close)。
pub fn net_close(net: StdNet, fd: I64) -> I64 {
    return ctron_net_close(fd)
}

// 半关:发 FIN,对端读到 eof(0);本端仍可读。
pub fn net_shutdown_write(net: StdNet, fd: I64) -> I64 {
    return ctron_net_shutdown_write(fd)
}

pub fn net_set_nodelay(net: StdNet, fd: I64, on: I64) -> I64 {
    return ctron_net_set_nodelay(fd, on)
}

pub fn net_get_nodelay(net: StdNet, fd: I64) -> I64 {
    return ctron_net_get_nodelay(fd)
}

pub fn net_udp_socket(net: StdNet, out_fd: Box[Box64]) -> I64 {
    return ctron_net_udp_socket(out_fd)
}

// UDP 绑定并回读实际端口(:0);自发自收回环的前置。
pub fn net_udp_bind(net: StdNet, fd: I64, host: Str, port: I64, out_port: Box[Box64]) -> I64 {
    return ctron_net_udp_bind(fd, host, port, out_port)
}

pub fn net_udp_sendto(net: StdNet, fd: I64, host: Str, port: I64, buf: &I64[], n: I64) -> I64 {
    return ctron_net_udp_sendto(fd, host, port, buf, n)
}

// 单次调用至多收回 4096 字节(单报文,超限截断;头注⑤ CT_CHUNK 上限)。
pub fn net_udp_recvfrom(net: StdNet, fd: I64, buf: &I64[], cap: I64, timeout_ms: I64) -> I64 {
    return ctron_net_udp_recvfrom(fd, buf, cap, timeout_ms)
}

// ---- AF_UNIX(P3-E;与 TCP 三件同形,差异点) ----
// SO_REUSEADDR 不开(AF_UNIX 无端口占用语义;tcp_defaults 的 NODELAY 断言面
// 同理不适用 —— AF_UNIX 无 NODELAY 可言);垫片 bind 前 unlink 清陈旧 socket
// 文件(后绑者赢);路径上限 104(darwin sun_path 104 / linux 108 取 min,含
// NUL):超限 EINVAL。accept/connect 阻塞形态与 tcp 同(无新停车点)。
pub fn net_unix_listen(net: StdNet, path: Str, out_fd: Box[Box64]) -> I64 {
    return ctron_net_unix_listen(path, out_fd)
}

pub fn net_unix_accept(net: StdNet, lfd: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_unix_accept(lfd, out_fd)
}

pub fn net_unix_connect(net: StdNet, path: Str, out_fd: Box[Box64]) -> I64 {
    return ctron_net_unix_connect(path, out_fd)
}

// 显式移除 socket 文件(listener Drop 只关 fd 不摘文件,见 UnixListener 注;
// 夹具/服务退出路径负责调用;ENOENT 亦 rc<0,幂等清理调用方自判)。
pub fn net_unix_unlink(net: StdNet, path: Str) -> I64 {
    return ctron_net_unix_unlink(path)
}

// 解析主机,返回首个 IPv4 点分串(C-owned → str_from_c 深拷);失败返回 ""。
// P3-E 异步化:协程上下文经 2 线程 helper 池 + park 完成(不再阻塞调用协程
// 所在 worker);裸线程面 P1 原路径。签名/返回不变。
pub fn net_resolve(net: StdNet, host: Str) -> Str {
    return str_from_c(ctron_net_resolve_first(host))
}

// ---- inline tests(纯 Ctron 面;行为面见 tests/net/tcp_echo) ----

test "addr parse dotted" {
    assert_eq(addr_host("127.0.0.1:8080"), "127.0.0.1")
    assert_eq(addr_port("127.0.0.1:8080"), 8080)
    assert_eq(addr_host("0.0.0.0:0"), "0.0.0.0")
    assert_eq(addr_port("0.0.0.0:0"), 0)
}

test "addr parse bracket v6" {
    assert_eq(addr_host("[::1]:80"), "::1")
    assert_eq(addr_port("[::1]:80"), 80)
    assert_eq(addr_host("[::1]"), "::1")
    assert_eq(addr_port("[::1]"), -1)
}

test "addr parse rejects malformed" {
    assert_eq(addr_port("no-colon"), -1)
    assert_eq(addr_port("host:port"), -1)
    assert_eq(addr_port("host:"), -1)
    assert_eq(addr_host("justhost"), "justhost")
}

test "addr format roundtrip" {
    let a = addr_format("10.0.0.9", 443)
    assert_eq(a, "10.0.0.9:443")
    assert_eq(addr_host(a), "10.0.0.9")
    assert_eq(addr_port(a), 443)
}
