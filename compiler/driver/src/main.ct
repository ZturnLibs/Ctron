// main.ct —— ctron 原生用户驱动器(W4 波1:骨架批1 + 委派族批2 + fmt/lint 批3)
// sh 参考 = 仓库根 ctron 脚本:usage :231-275 / help_cmd :281-313 / dispatch :1120-1548。
// 帮助文本逐字复刻(逐行 println,ctgrep 范式;生成自 sh 原文,非手抄)——
// 字节级对拍门 = tests/drv_parity/run.sh(stdout+stderr 合流 diff + rc 对比)。
// 波1 行为面:--version|-V / --help|-h / help [cmd] / <cmd> --help 拦截(16 名)+
// 未知子命令 rc2;批2 委派族 run/check/doc/test(镜像 sh :1133-1150/:1162-1165):
// 组 argv → W3 proc.run_argv_rc 直 exec 兄弟件 → rc 直通。cwd 空串 = 继承
// (ctron_proc.c chdir 分支 `cwd[0] != 0 &&` 显式跳过——读码钉定,= sh exec 语义);
// stdout/stderr/stdin/env 全继承 → 编译器诊断透传即逐字。批3 fmt/lint 真逻辑
// (镜像 sh fmt 臂 :1166-1214 / cmd_lint :338-380):逐文件 proc 捕获形(run/run_argv,
// stdout 捕获、stderr 直通 = sh `> tmp` 重定向同构)——捕获缓冲 [0]*8 定长 literal
// 复制清零底座 + NUL 终界扫描 + UTF-8 解码→utf8_enc 再编码(有效 UTF-8 往返逐字节
// 保真;先例 http/client.ct cx_slice_str 的 U8[]→Str 攒形)。staging 集空,已删。
// 定位:ctron_exe_path() → bin = 其父,仓库根 = bin 父的父(compiler/bin → compiler → 根);
// VERSION 在场 → "ctron <内容>"(镜像 sh $(cat) 尾换行剥离),缺席 → "ctron dev"。
// 注:native.sh 壳层剥除发射模板的 C main --version 劫持臂(模板版串≠sh 语义),
//     本文件的 --version 臂才可达——详见 native.sh 驱动器段注释。
// 参数面:env.args() 无发射翻译(解释口径专属)——裸执行取参走 ctron_prog_args_n/at
//     extern 底座(argv_off=1:args[0]=首用户参;eval_call.ct:33-36 前例,模板 T26 同源)。
// 委派族进程面:use proc(W3)——run_argv_rc(rc 型,stdout/stderr 直通父进程)+ argv_to_blob
//     (argv 列表 → NUL 块);垫片 ctron_proc.c 由 native.sh 驱动链行同链(纯 emit 单文件缺符号)。
// fmt/lint 目录面:use std.fs.{list}(walk_entries pub 化薄壳,W4 批3 同批)——
//     非递归顶层名表字节序 = sh `find -maxdepth 1 | LC_ALL=C sort` 同序。
// task/gate/clean 面(W4 波2 批2):use std.fs.{walk}(缓存域递归净除底座)——
//     本地 CTCL 读取模块(根脚本 DRV_READER_AWK 状态机/消息/E 码族逐字:strip
//     字符串感知/unquote UQ_OK 空串合法/四键白名单/重复键/END 三查)+ runner
//     (DRV_SPLIT_AWK 切分/元字符 11 字符拒逐字/裸名 ctron 自解析/进度行与判词
//     echo_line 直写/task.cwd=spawn cwd 参非 chdir/env_set 注入 CTRON_STDPATH/
//     败即停 rc 透传)+ gate 解析序三段(首块嗅探防大小写误中)+ clean 三域与
//     --all 项目守卫(探针①:fs_delete 空目录可删非空拒 → walk 逆序净除)。
// bench/pkg 面(W4 波3 批2):bench 注册表五族(DEVROOT=exe 父父父 dev 布局;
//     spawn sh 脚本 rc 直通)+ pkg 分派 verify/attest/log/seal(verify L1 三段
//     判决+--deep 委派 ctron-verify 与 attest 腿/复放腿挂账批C;seal ctron-ast
//     env 通道 set+restore+traces 拾取+SHA256SUMS 整串序+self_digest 注入;
//     log git 委派 -c 身份逐字+append-only 守卫)。
// pkg trace 面(W4 波3 批3):record/replay 码gen 全量(WSB/MemFs 合成/三层转义
//     谱/单值守卫/E5056 族判词逐字;--deep 复放腿深码gen 异构仍挂账,见分派臂注)。

use proc.{run, run_argv, run_argv_rc, argv_to_blob}
use std.fs.{list, walk}
use std.str.{contains, starts_with, ends_with}
use std.crypto.{sha256_hex}

fn usage() {
    println("ctron —— Ctron 工具链驱动")
    println("用法:")
    println("  ctron run <file.ct>          解释执行(不需要 C 编译器)")
    println("  ctron check <file.ct> [--format=json] [--profile=bare]")
    println("                             静态检查")
    println("  ctron doc <file.ct> [--format=json]")
    println("                             iface 投影:pub 符号表 + trait/impl 面 + 契约注释")
    println("  ctron build <file.ct>        发射 C → 本机 cc → 可执行 <stem>(C 侧 <stem>.c)")
    println("  ctron build                  项目模式:读 Ctron.ctcl(入口 src/main.ct,链接 c_src/*.c)")
    println("  ctron test <file.ct>         test 块执行(无 main 走解释;含 main 文件的 test 执行挂账)")
    println("  ctron fmt <file|pkg目录> [-w|--check]")
    println("                             规范格式化(docs/fmt-spec.md):默认打印;-w 原位写回;")
    println("                             --check 列出待格式化文件后非零退出")
    println("  ctron lint <file|pkg目录> [--trusted] [--strict]")
    println("                             lint 汇总:错误红(rc=1),警告默认只汇总;")
    println("                             --trusted 信任审计枚举(§9.6);--strict 警告也红")
    println("  ctron bench [族]            基准族入口(lang/gc/http/net/ffi;dev 布局)")
    println("  ctron add <名>[@<版本约束>] 装包:写 dep 块 + pkgs/ 安装 + 刷新 Ctron.lock(T49 本地 registry)")
    println("  ctron publish               发布当前目录单文件包到本地 registry(T49;CTRON_REGPATH,缺省 ~/.ctron/registry)")
    println("  ctron lock                  解析依赖并生成/校验 Ctron.lock(内容寻址)")
    println("  ctron pkg verify <artifact-dir>")
    println("                             密封工件(.ctart)摘要自洽校验(D8-2 L1):SHA256SUMS 逐成员重算")
    println("                             + self_digest 重算;fail-closed,不过即 rc=1;--deep 走")
    println("                             in-language 发射验证器(ctron-verify,C 速,L3 载体)")
    println("  ctron pkg trace record <src.ct> --case <fn>=<args 字面量> [--case ...]")
    println("                             黄金轨迹录制(S3:纯函数+效果函数 γ):值=to_string 规范形,--fs 种子挂 case,落")
    println("                             traces/<stem>.ctrt;含 main 源不支持")
    println("  ctron pkg trace replay <src.ct>")
    println("                             轨迹复放:逐字比对,不符即 rc=1 点名双值(S3)")
    println("  ctron pkg log append <日志仓> <工件目录>")
    println("                             透明日志追加(§7.1 公证层):records/<名>/<digest>/attest")
    println("                             内容寻址不可变,append-only git 仓;零网络")
    println("  ctron pkg log query <日志仓> [名]")
    println("                             日志查询:列名或列某名的 digest+公证要点")
    println("  ctron new <dir>              脚手架:hello + Ctron.ctcl")
    println("  ctron task [-f <file>] [名]  列出/执行 ctron.ctcl 任务(驱动器面;步骤直 exec,拒 shell 元字符;")
    println("                             task 可带 cwd = 相对清单目录,步骤以其为工作目录)")
    println("  ctron gate [名]              ≡ task,缺省名 gate;无 ctron.ctcl 时项目模式")
    println("                             回落内建默认门(build + fmt --check)")
    println("  ctron clean [--all]          清工具链缓存三域(.cache/emit|bare|wasm);")
    println("                             --all 加项目 build/ 与 pkgs/")
    println("  ctron --version              版本")
    println("  ctron --help | help [cmd]    帮助(亦可 ctron <cmd> --help)")
    println("环境变量:CC(默认 cc)、CTRON_STDPATH(覆盖标准库位置)")
    println("rc 约定:0 成功 / 1 程序诊断失败 / 2 ctron 环境或用法错误")
}

fn help_cmd(cmd: Str) -> I32 {
    if cmd == "build" {
        println("ctron build —— 发射 C 并编译为可执行")
        println("  ctron build <file.ct>   产物 <stem> 与 <stem>.c(与源同目录)")
        println("  ctron build             项目模式:入口 src/main.ct,产物 build/<name>;")
        println("                        Ctron.ctcl 同目录 c_src/*.c 一并链接")
        println("前置:本机 C 编译器(可用 CC 覆盖);缺失时 C 照常发射,并给出两条出路")
        return 0
    }
    if cmd == "check" {
        println("ctron check <file.ct> [--format=json] [--profile=bare] —— 静态检查,不改任何文件")
        return 0
    }
    if cmd == "doc" {
        println("ctron doc <file.ct> [--format=json] —— iface 投影:pub 符号表/trait/impl 面 + 模块头与 per-fn 契约注释(§5.3),不改任何文件")
        return 0
    }
    if cmd == "run" {
        println("ctron run <file.ct> —— 解释执行;不需要 C 编译器")
        return 0
    }
    if cmd == "test" {
        println("ctron test <file.ct> —— 执行 test 块(无 main 文件);含 main 文件的 test 执行暂走宿主口径挂账")
        return 0
    }
    if cmd == "fmt" {
        println("ctron fmt <file|pkg目录> [-w|--check] —— 规范格式化(docs/fmt-spec.md);默认打印,-w 原位写回,--check 列出待格式化并不零退出")
        return 0
    }
    if cmd == "lint" {
        println("ctron lint <file.ct|pkg目录> [--trusted] [--strict] —— check 命令化+汇总(§9.7):错误 rc=1;警告默认只汇总不红,--strict 才红;--trusted 信任边界审计枚举 #[trusted] extern(§9.6)")
        return 0
    }
    if cmd == "bench" {
        println("ctron bench [族] —— tests/ 基准族统一入口(T43;dev 布局,脚本自定位仓库根,任目录可跑)")
        println("  lang   own/热点算术核 vs C 同构对照(T44;门 ≤1.05,WARN 档)")
        println("  gc     GC 档 vs bump 档 churn(T32;门 ≤1.15)")
        println("  http   http_parse_head vs picohttpparser(CTRON_HTTP_BENCH=1 启用)")
        println("  net    吞吐/协程切换三门禁(CTRON_NET_BENCH=1 启用)")
        println("  ffi    FFI 边界微基准四场景(报告制)")
        println("无族名列出注册表;未注册族名清晰诊断(fail-closed)。")
        return 0
    }
    if cmd == "add" {
        println("ctron add <name>[@<版本约束>] —— 本地 registry 装包(T49):写 dep 块 + pkgs/<名>/ 安装(module+manifest)+ ctron-dep 刷新 Ctron.lock;registry = CTRON_REGPATH 或 ~/.ctron/registry;零网络")
        return 0
    }
    if cmd == "publish" {
        println("ctron publish —— 当前目录单文件包发布到本地 registry(T49):manifest+module+sha256 三件落 <reg>/<名>/<版>/;版本不可覆盖;零网络(对外发布面启用仍须经用户确认)")
        return 0
    }
    if cmd == "lock" {
        println("ctron lock —— 依赖解析并生成/校验 Ctron.lock(T49 内容寻址;= ctron-dep run Ctron.ctcl)")
        return 0
    }
    if cmd == "pkg" {
        println("ctron pkg verify <artifact-dir> [--deep] / pkg trace record|replay —— verify: 密封工件摘要自洽校验(D8-2 L1;SHA256SUMS 逐成员+self_digest 重算,fail-closed rc=1;--deep = ctron-verify 发射验证器 L3 载体);trace: 纯函数黄金轨迹录制/复放(S3-α,值=to_string 规范形);trace 复放腿接线与效果函数 FakeFs 归 S3-β")
        return 0
    }
    if cmd == "new" {
        println("ctron new <dir> —— 生成 <dir>/Ctron.ctcl + src/main.ct(hello)")
        return 0
    }
    if cmd == "task" {
        println("ctron task [-f <file>] [名] —— 列出/执行 ctron.ctcl 任务(驱动器面;步骤直 exec,拒 shell 元字符);-f 指定清单(缺省 ./ctron.ctcl),步骤以清单所在目录为 cwd")
        return 0
    }
    if cmd == "gate" {
        println("ctron gate [名] —— ≡ task,缺省名 gate;无 ctron.ctcl 时项目模式回落内建默认门(build + fmt --check);步骤引号语义非 shell 全同")
        return 0
    }
    if cmd == "clean" {
        println("ctron clean [--all] —— 清工具链缓存三域(.cache/emit|bare|wasm);--all 加项目 build/ 与 pkgs/;CTRON_DRV_ROOT 可覆盖缓存根")
        return 0
    }
    // 未知命令臂 = 整版 usage(sh help_cmd * 臂)
    usage()
    return 0
}

fn dir_of(p: Str) -> Str {
    // 路径父目录(末个 '/' 前截断;无 '/' = "")——壳层无 dirname,自筹
    var cut: I32 = -1
    var i: I32 = 0
    while i < p.len {
        if byte_at(p, i) == 47 {
            cut = i
        }
        i += 1
    }
    if cut < 0 {
        return ""
    }
    return byte_slice(p, 0, cut)
}

fn version_line() -> Str {
    // 逐字镜像 sh:VERSION 在场 → "ctron $(cat $ROOT/VERSION)",缺席 → "ctron dev";
    // $(cat) 吃掉结尾换行 → 逐个剥离尾部 \n(字节 10)至尽
    var bin = dir_of(ctron_exe_path())
    var compiler = dir_of(bin)
    var root = dir_of(compiler)
    var vp = root + "/VERSION"
    if fs_exists(vp) {
        match read_file(vp) {
            Some(s) => {
                var t = s
                var strip: Bool = true
                while strip {
                    if t.len > 0 {
                        if byte_at(t, t.len - 1) == 10 {
                            t = byte_slice(t, 0, t.len - 1)
                        } else {
                            strip = false
                        }
                    } else {
                        strip = false
                    }
                }
                return "ctron " + t
            }
            None => {
                return "ctron dev"
            }
        }
    }
    return "ctron dev"
}

fn unknown_line(cmd: Str) -> Str {
    // sh 同款:stderr 一行 + rc 2(\n 自附——eprint 裸写不补行)
    return "ctron: 未知子命令 '" + cmd + "'(详见 ctron --help)\n"
}

fn is_known16(c: Str) -> Bool {
    // sh <cmd> --help 拦截面全集(:1124-1126 名单;help 面先行,行为分期不受此限)
    if c == "run" { return true }
    if c == "check" { return true }
    if c == "build" { return true }
    if c == "test" { return true }
    if c == "new" { return true }
    if c == "fmt" { return true }
    if c == "doc" { return true }
    if c == "lint" { return true }
    if c == "bench" { return true }
    if c == "add" { return true }
    if c == "publish" { return true }
    if c == "lock" { return true }
    if c == "pkg" { return true }
    if c == "task" { return true }
    if c == "gate" { return true }
    if c == "clean" { return true }
    return false
}

// 波1 占位族 staging 集(fmt/lint)已随批3 全量落地删除(曾位:is_w1_delegate
// + main 分派 rc2 臂;集空即撤,诚实账闭环)。

extern "c" fn ctron_prog_args_n() -> I64
extern "c" fn ctron_prog_args_at(i: I64) -> Str

fn bin_dir() -> Str {
    // 兄弟件目录 = exe 父(version_line 同源;安装/开发两布局原生件恒与 ctron-cc 同目录,
    // sh 版的 dev 回落逻辑在此不需要)
    return dir_of(ctron_exe_path())
}

fn has_slash(p: Str) -> Bool {
    var i: I32 = 0
    while i < p.len {
        if byte_at(p, i) == 47 {
            return true
        }
        i += 1
    }
    return false
}

fn norm_join(pwd: Str, dir: Str) -> Str {
    // 逻辑归一化 = sh `cd && pwd` 同构(评审 Important 修复):pwd/dir 串接后按 '/'
    // 拆件——"." 剔除、".." 对已攒件弹栈(根守卫:根上 ".." 停留,POSIX root/..=root)、
    // 空件("//")折叠;重建恒以单 '/' 起头,空栈(根)回 "/"。basename 由调用方在其后
    // 追加,不经归一(sh 亦在 pwd 输出之后拼 basename,逐字同构)。
    // 注:弹栈以"重建去尾"实现——List.pop 在发射口径缺 t_pop 运行时符号(实测
    // native.sh 链响);List 下标读 + push 为已证可发射面(tests/proc 前例)。
    var whole = pwd + "/" + dir
    var comps: List[Str] = List[Str]()
    var start: I32 = 0
    var i: I32 = 0
    while i <= whole.len {
        if i == whole.len || byte_at(whole, i) == 47 {
            if i > start {
                var c = byte_slice(whole, start, i)
                if c == ".." {
                    if comps.len > 0 {
                        // 重建去尾(无 pop 的弹栈;根上 ".." 停留 = 根守卫)
                        var kept: List[Str] = List[Str]()
                        var q: I32 = 0
                        while q < comps.len - 1 {
                            kept.push(comps[q])
                            q += 1
                        }
                        comps = kept
                    }
                } else {
                    if c != "." {
                        comps.push(c)
                    }
                }
            }
            start = i + 1
        }
        i += 1
    }
    if comps.len == 0 {
        return "/"
    }
    var out = ""
    var k: I32 = 0
    while k < comps.len {
        out = out + "/" + comps[k]
        k += 1
    }
    return out
}

fn absolutize(p: Str) -> Str {
    // 逐字镜像 sh 绝对化:IN=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
    // (ctron:766-768/:773-775)。sh pwd = 逻辑路径($PWD 同源),cd 对目标串做逻辑归一
    // (norm_join 同构,含 ".." 弹栈/"." 剔除/"//" 折叠);basename 后拼不经归一。
    // 已知在案偏差:dirname 不存在时 sh 泄 cd 诊断行且 IN 落 "/base"(见任务报告
    // 已知分歧账),native 不模拟。
    var cut: I32 = -1
    var i: I32 = 0
    while i < p.len {
        if byte_at(p, i) == 47 {
            cut = i
        }
        i += 1
    }
    if cut < 0 {
        // 无 '/':dirname="." → cd . && pwd = PWD(已规范态)→ PWD/裸名
        var pwd0 = env_get("PWD")
        if pwd0.len == 0 {
            return p
        }
        return pwd0 + "/" + p
    }
    var dir = byte_slice(p, 0, cut)
    var base = byte_slice(p, cut + 1, p.len)
    if byte_at(p, 0) == 47 {
        // dirname 绝对:无需 PWD(cd 归一只作用于 dir 串自身,根起天然含根守卫);
        // cut=0(dir="/")归一仍得 "/" → 拼 "//base" = sh 字面串接行为(逐字对齐)
        return norm_join("", dir) + "/" + base
    }
    var pwd = env_get("PWD")
    if pwd.len == 0 {
        return p
    }
    return norm_join(pwd, dir) + "/" + base
}

fn miss_line(cmd: Str) -> Str {
    // sh die2(:26)= `echo "ctron: $*" >&2; exit 2` —— 四臂缺参逐字(rc2 由调用方回)
    return "ctron: " + cmd + " 需要输入文件\n"
}

fn delegate(argv: List[Str]) -> I32 {
    // 委派核:argv → NUL 块 → W3 run_argv_rc(cwd 空串 = 继承——ctron_proc.c chdir
    // 分支 `cwd[0] != 0 &&` 显式跳过;stdin_path 空串 = 继承;stdout/stderr 不捕 =
    // 直通父进程)。整体 = sh exec 语义:子进程产出即驱动器产出,rc 直通 exit。
    var blob: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = argv_to_blob(argv, blob)
    if n < 0 {
        // argv 超 4KB(路径极端;sh 无此上限)——按 exec 失败口径回 127,不产出半截 argv
        return 127
    }
    return run_argv_rc("", blob, n.as[I64](), "")
}

// ---- fmt/lint 捕获面(W4 波1 批3;sh `> 临时件` 重定向同构)----
// 捕获缓冲容量 262144(256KB;sh 临时件无上限——-w 恰满容量拒写回守卫,
// --check 超容误报面,登记在案)

// 捕获缓冲清零(decl 位 8×0 literal 复制分支已整容清零,迭代间重清防前文件残尾
// 串进 NUL 终界扫描——sh `>` 截断重建的逐文件同构)
fn capture_zero(var buf: U8[]) {
    var i: I32 = 0
    while i < buf.len {
        buf[i] = 0
        i += 1
    }
}

// 捕获逻辑长(NUL 终界扫描;捕获文本无内嵌 NUL——劣例登记在案)。
// 底座对齐:ctron_amalloc 不清零 → 靠 decl 复制清零 + 本扫描双保险。
fn capture_len(var buf: U8[]) -> I32 {
    var i: I32 = 0
    while i < buf.len {
        if buf[i].as[I64]() == 0 {
            return i
        }
        i += 1
    }
    return buf.len
}

// 捕获字节 → Str:UTF-8 序列解码 → utf8_enc 再编码(有效 UTF-8 往返逐字节保真
// = ctron-fmt/ctron-chk 文本输出全域;劣序列 → 单码点替形,病理面登记在案)。
// 选择缘起:bytes_to_str 内建只收 read_file_bytes 堆对象(tag Y),U8[] 视图不收;
// 先例 = http/client.ct cx_slice_str 的 U8[]→Str 逐字节攒形(彼 ASCII 白名单,
// 此全 UTF-8 域)。
fn capture_str(var buf: U8[]) -> Str {
    var s = ""
    var n = capture_len(buf)
    var i: I32 = 0
    while i < n {
        var b0: I64 = buf[i].as[I64]()
        var cp: I64 = b0
        var adv: I32 = 1
        if b0 >= 194 && b0 < 224 && i + 1 < n {
            var b1: I64 = buf[i + 1].as[I64]()
            if b1 >= 128 && b1 < 192 {
                cp = (b0 - 192) * 64 + (b1 - 128)
                adv = 2
            }
        } else if b0 >= 224 && b0 < 240 && i + 2 < n {
            var b1: I64 = buf[i + 1].as[I64]()
            var b2: I64 = buf[i + 2].as[I64]()
            if b1 >= 128 && b1 < 192 && b2 >= 128 && b2 < 192 {
                cp = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)
                adv = 3
            }
        } else if b0 >= 240 && b0 < 245 && i + 3 < n {
            var b1: I64 = buf[i + 1].as[I64]()
            var b2: I64 = buf[i + 2].as[I64]()
            var b3: I64 = buf[i + 3].as[I64]()
            if b1 >= 128 && b1 < 192 && b2 >= 128 && b2 < 192 && b3 >= 128 && b3 < 192 {
                cp = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)
                adv = 4
            }
        }
        s = s + utf8_enc(cp.as[I32]())
        i += adv
    }
    return s
}

// 捕获 vs 磁盘逐字节比对(sh cmp -s 同判):文件缺 = 异(cmp 打不开即 rc2 非零);
// 双域字节面(捕获缓冲 U8[] vs read_file_bytes;bytes_at 实证无符号,探针 228)。
// NUL 终界扫描长 vs bytes_len 全等后再逐字节;容量截断 = 异(sh 无上限,登记在案)。
fn capture_differs(var buf: U8[], f: Str) -> Bool {
    if !fs_exists(f) {
        return true
    }
    var fb = read_file_bytes(f)
    var flen: I32 = bytes_len(fb).as[I32]()
    var i: I32 = 0
    while i < buf.len {
        if buf[i].as[I64]() == 0 {
            break
        }
        if i >= flen {
            return true
        }
        if buf[i].as[I64]() != bytes_at(fb, i).as[I64]() {
            return true
        }
        i += 1
    }
    if i < flen {
        return true
    }
    return false
}

// ---- fmt/lint 目标展开(sh `find -maxdepth 1 -type f -name '*.ct' | LC_ALL=C sort` 同义)----

fn is_dir_target(t: Str) -> Bool {
    // sh -d 同判:read_dir 开得动 = 目录(空目录 Some("")/文件 None 两宿同形,
    // pkg_dep match 形先例)
    match read_dir(t) {
        Some(_d) => {
            return true
        }
        None => {}
    }
    return false
}

fn has_ct_suffix(nm: Str) -> Bool {
    // sh find -name '*.ct' 同义(名尾 ".ct";`*` 匹配空 = 裸 ".ct" 亦合)
    var nl = nm.len
    if nl < 3 {
        return false
    }
    return byte_at(nm, nl - 3) == 46 && byte_at(nm, nl - 2) == 99 && byte_at(nm, nl - 1) == 116
}

fn expand_dir_files(dir: Str) -> List[Str] {
    // 目录 → 顶层 .ct 全路径表(list 名表字节序 = LC_ALL=C sort 同序:同名前缀,
    // 全序确定)。已知偏差登记:sh -type f 排除 .ct 名目录(病理面;native 无
    // stat 型判内建,不模拟),文件名含空格 sh 分词裂、native 保真(同上)。
    var out = List[Str]()
    var names = list(dir)
    var i: I32 = 0
    while i < names.len {
        var nm = names[i]
        if has_ct_suffix(nm) {
            out.push(join_entry(dir, nm))
        }
        i += 1
    }
    return out
}

// 路径拼合(sh find 同构,批3 评审 Fix 2):只折叠根前缀自身尾 '/'——find 对
// 根路径尾分隔符不叠加(`find dir/` → `dir/m.ct`,裸根 `/` → `/m.ct`);根前缀
// 内部 `//` 逐字保留(`find dir//src` → `dir//src/a.ct`,sh FMT_DIR = "$t/src"
// 串接原样,内部形两侧同为 `//`)。裸 "/" 剥尽 → "/" + 名。
fn join_entry(dir: Str, nm: Str) -> Str {
    var d = dir
    while d.len > 0 && byte_at(d, d.len - 1) == 47 {
        d = byte_slice(d, 0, d.len - 1)
    }
    if d.len == 0 {
        return "/" + nm
    }
    return d + "/" + nm
}

// fmt/lint 共用:目录 → src 优先否则直下(sh `[ -d "$t/src" ] && DIR=$t/src`)
fn target_files(t: Str) -> List[Str] {
    if is_dir_target(t) {
        var dir = t
        if is_dir_target(t + "/src") {
            dir = t + "/src"
        }
        return expand_dir_files(dir)
    }
    var out = List[Str]()
    out.push(t)
    return out
}

// stdout 单行直写(/bin/echo 子进程,fd1 继承直落):fmt --check/-w 的文件名行走
// 此路——发射 println = printf(重定向文件态块缓冲),父进程尾部计数行走 eprint
// (stderr 无缓冲)会反超缓冲中的名行(sh 合流捕获口径 = 名行在前);echo 子进程
// 即时物理写,保序逐字(= sh echo "$f" 内建行的 exec 同构;delegate 家族先例
// run_argv_rc 不捕全继承)。已知病理面:文件名恰为 "-n"/"-e" 形会被 echo 吞作
// 旗标(sh 内建 echo 同病,对拍语料不含)。
fn echo_line(s: Str) {
    var argv = List[Str]()
    argv.push("/bin/echo")
    argv.push(s)
    var blob: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = argv_to_blob(argv, blob)
    if n >= 0 {
        run_argv_rc("", blob, n.as[I64](), "")
    }
}

// ---- build 面(W4 波2 批1)----
// sh 镜像源(仓库根 ctron 脚本,live text 为准):ct_target_check :431-439 /
// cmd_build :441-459 / cmd_build_proj :461-497 / cc_missing_guidance :326-331 /
// have_cc :317-324 / --target 解析循环 :1155-1161。

fn cc_bin() -> Str {
    // sh CC_BIN=${CC:-cc}
    var c = env_get("CC")
    if c.len == 0 {
        return "cc"
    }
    return c
}

// blob 化 rc 型 spawn(= delegate 的 cwd 参化;非零 rc 语义由各臂按 sh || exit N 收口)
fn blob_rc_cwd(argv: List[Str], cwd: Str) -> I32 {
    var blob: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
    let nb = argv_to_blob(argv, blob)
    if nb < 0 {
        return 127
    }
    return run_argv_rc(cwd, blob, nb.as[I64](), "")
}

fn fail2(msg: Str) -> I32 {
    // sh die2(:26)= `echo "ctron: $*" >&2; exit 2`
    eprint("ctron: " + msg + "\n")
    return 2
}

fn stem_of(abs: Str) -> Str {
    // sh STEM=$(basename "${IN%.ct}"):先剥 .ct 尾(仅当在尾)再取末段
    var s = abs
    var l = s.len
    if l >= 3 {
        if byte_at(s, l - 3) == 46 && byte_at(s, l - 2) == 99 && byte_at(s, l - 1) == 116 {
            s = byte_slice(s, 0, l - 3)
        }
    }
    var cut: I32 = -1
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == 47 {
            cut = i
        }
        i += 1
    }
    return byte_slice(s, cut + 1, s.len)
}

fn basename_sh(p: Str) -> Str {
    // POSIX basename:剥尾部 '/'(根 "/" 保留)后取末段
    var end = p.len
    while end > 1 {
        if byte_at(p, end - 1) == 47 {
            end -= 1
        } else {
            break
        }
    }
    var cut: I32 = -1
    var i: I32 = 0
    while i < end {
        if byte_at(p, i) == 47 {
            cut = i
        }
        i += 1
    }
    return byte_slice(p, cut + 1, end)
}

fn have_cc_probe() -> Bool {
    // sh have_cc:冒烟 C 件 + $CC_BIN -O0 -w 编译。native = 固定名临时件
    // (sh mktemp 唯一性 = 登记偏差;并发 build 病理面,冒烟件即用即删)
    var srcp = "/tmp/ctron_ccp_drv.c"
    var binp = "/tmp/ctron_ccp_drv"
    fs_write(srcp, "int main(void)\{return 0;}")
    var argv = List[Str]()
    argv.push(cc_bin())
    argv.push("-O0")
    argv.push("-w")
    argv.push("-o")
    argv.push(binp)
    argv.push(srcp)
    let rc = blob_rc_cwd(argv, "")
    fs_delete(srcp)
    fs_delete(binp)
    return rc == 0
}

fn cc_missing_guidance(cpath: Str) {
    // sh cc_missing_guidance 四行逐字(stderr;$CC_BIN 插值;② 行手册式无 -pthread)
    eprint("ctron: 未找到可用的 C 编译器('" + cc_bin() + "' 冒烟失败)—— ctron build 需要。\n")
    eprint("  两条出路:\n")
    eprint("  ① 安装编译器后重跑:macOS 'xcode-select --install' / linux 发行版 gcc / windows MSYS2 或 w64devkit\n")
    eprint("  ② C 已发射到 " + cpath + " —— 可手动编译,或拿到任何有 cc 的机器上: cc -O2 -w " + cpath + " -o <名>\n")
}

fn build_file(farg: Str, target: Str) -> I32 {
    // sh cmd_build 单文件臂。ct_target_check 先行(未注册 rc2 逐字);
    // 非 native 委派 ctc.sh(rc 非零一律 exit 2 = sh `|| exit 2`,不透传);
    // native = emit 捕获落 <stem>.c → have_cc 冒烟(败 = 双出路文案 rc2)→
    // cc -O2 -w -pthread 于源目录(cwd=OUTDIR = sh 子壳 cd 同构)。
    if !target_registered(target) {
        return fail2("未注册后端 target: " + target + "(注册表: native, thumbv7em-none-eabi, riscv32imac-unknown-none, wasm32-unknown-unknown)")
    }
    var inp = absolutize(farg)
    var stem = stem_of(inp)
    var outdir = dir_of(inp)
    if target != "native" {
        // T40 bare/wasm 靶:委派 ctc.sh 同管线(sh :446-450;stdout/stderr 直通)
        var root = dir_of(dir_of(bin_dir()))
        var argv = List[Str]()
        argv.push(root + "/compiler/ctc.sh")
        argv.push("build")
        argv.push(inp)
        argv.push("--target")
        argv.push(target)
        argv.push("-o")
        argv.push(outdir + "/" + stem)
        if blob_rc_cwd(argv, "") != 0 {
            return 2
        }
        println("ctron: 已构建 " + outdir + "/" + stem + "(target: " + target + ")")
        return 0
    }
    var bin = bin_dir() + "/ctron-emit"
    var buf: U8[1048576] = [0, 0, 0, 0, 0, 0, 0, 0]
    capture_zero(buf)
    let rc = run("", bin, inp, buf)
    if rc != 0 {
        return 1
    }
    if capture_len(buf) == buf.len {
        // 容量截断守卫(sh `>` 无上限;>1MB 发射面登记在案,拒半截 C 落盘)
        eprint("ctron: 发射输出超捕获容量 " + buf.len.to_string() + " 字节: " + inp + "\n")
        return 1
    }
    // sh 失败残档偏差登记:emit 败时 `>` 已留空/半截 <stem>.c,native 捕获形不落盘
    fs_write(outdir + "/" + stem + ".c", capture_str(buf))
    if !have_cc_probe() {
        cc_missing_guidance(outdir + "/" + stem + ".c")
        return 2
    }
    var argv = List[Str]()
    argv.push(cc_bin())
    argv.push("-O2")
    argv.push("-w")
    argv.push("-pthread")
    argv.push(stem + ".c")
    argv.push("-o")
    argv.push(stem)
    if blob_rc_cwd(argv, outdir) != 0 {
        return 2
    }
    println("ctron: 已构建 " + outdir + "/" + stem + "(target: " + target + ")")
    return 0
}

fn read_text(p: Str) -> Str {
    match read_file(p) {
        Some(s) => {
            return s
        }
        None => {}
    }
    return ""
}

fn name_line_value(line: Str) -> Option[Str] {
    // sh sed 's/^ *name *= *"\(.*\)".*/\1/p' 单行判:前缀 ^空格*name空格*=空格*" ;
    // 捕获贪心至行末最后一个 '"'(BRE \(.*\)" 左最右长同构;须有第二个引号)
    var i: I32 = 0
    while i < line.len && byte_at(line, i) == 32 {
        i += 1
    }
    if i + 4 > line.len {
        return None
    }
    if byte_at(line, i) != 110 || byte_at(line, i + 1) != 97 || byte_at(line, i + 2) != 109 || byte_at(line, i + 3) != 101 {
        return None
    }
    i += 4
    while i < line.len && byte_at(line, i) == 32 {
        i += 1
    }
    if i >= line.len || byte_at(line, i) != 61 {
        return None
    }
    i += 1
    while i < line.len && byte_at(line, i) == 32 {
        i += 1
    }
    if i >= line.len || byte_at(line, i) != 34 {
        return None
    }
    var open = i
    var last: I32 = -1
    var q: I32 = open + 1
    while q < line.len {
        if byte_at(line, q) == 34 {
            last = q
        }
        q += 1
    }
    if last < 0 {
        return None
    }
    return Some(byte_slice(line, open + 1, last))
}

fn manifest_name(text: Str) -> Option[Str] {
    // 首个匹配行(sed | head -1;值可空——空值由调用方回退目录名,sh -n 判空同构)
    var i: I32 = 0
    var start: I32 = 0
    while i <= text.len {
        var isEnd: Bool = i == text.len
        if isEnd || byte_at(text, i) == 10 {
            match name_line_value(byte_slice(text, start, i)) {
                Some(v) => {
                    return Some(v)
                }
                None => {}
            }
            start = i + 1
        }
        i += 1
    }
    return None
}

fn has_line_prefix(text: Str, pre: Str) -> Bool {
    // 行首前缀判(grep -q '^pre' 同义;pre 自含字面字节)
    var i: I32 = 0
    var start: I32 = 0
    while i <= text.len {
        var isEnd: Bool = i == text.len
        if isEnd || byte_at(text, i) == 10 {
            var line = byte_slice(text, start, i)
            if line.len >= pre.len {
                if byte_slice(line, 0, pre.len) == pre {
                    return true
                }
            }
            start = i + 1
        }
        i += 1
    }
    return false
}

fn push_ws_tokens(out: List[Str], s: Str) {
    // sh for 分词同构(IFS 空白裂;语料洁面 m/v 无内白,内白病理登记在案)
    var i: I32 = 0
    var start: I32 = -1
    while i <= s.len {
        var isWs: Bool = i == s.len
        if !isWs {
            var b = byte_at(s, i)
            isWs = b == 32 || b == 9 || b == 10
        }
        if isWs {
            if start >= 0 {
                out.push(byte_slice(s, start, i))
                start = -1
            }
        } else {
            if start < 0 {
                start = i
            }
        }
        i += 1
    }
}

fn ws_pairs(text: Str) -> List[Str] {
    // sh awk 逐字镜像(:479):member 行(列 0)取名(截至尾内首个 '"');
    // 其后首个 path 行(缩进可,= 前空格可)取值(贪心 = 最末 `=空格*"` 组之后,
    // 截至其内首个 '"');pending 跨行保持,member 行覆写,配对即印即清。
    // 返回扁平 token 表 = sh `for WSE in $WSPATHS` 分词(m 与 v 各自再裂)。
    var out = List[Str]()
    var pending = ""
    var i: I32 = 0
    var start: I32 = 0
    while i <= text.len {
        var isEnd: Bool = i == text.len
        if isEnd || byte_at(text, i) == 10 {
            var line = byte_slice(text, start, i)
            var isMember: Bool = false
            if line.len >= 8 {
                if byte_slice(line, 0, 8) == "member \"" {
                    isMember = true
                }
            }
            if isMember {
                // sub(/^member "/,"",n) → 尾;sub(/".*$/,"",n) → 尾内首个 '"' 截断
                var tail = byte_slice(line, 8, line.len)
                var cut: I32 = -1
                var q: I32 = 0
                while q < tail.len {
                    if byte_at(tail, q) == 34 {
                        cut = q
                        break
                    }
                    q += 1
                }
                if cut >= 0 {
                    pending = byte_slice(tail, 0, cut)
                } else {
                    pending = tail
                }
            } else {
                // ^[[:space:]]*path[[:space:]]*=[[:space:]]*"
                var pi: I32 = 0
                while pi < line.len && (byte_at(line, pi) == 32 || byte_at(line, pi) == 9) {
                    pi += 1
                }
                var isPath: Bool = false
                if pi + 5 <= line.len {
                    if byte_at(line, pi) == 112 && byte_at(line, pi + 1) == 97 && byte_at(line, pi + 2) == 116 && byte_at(line, pi + 3) == 104 {
                        var pj = pi + 4
                        while pj < line.len && (byte_at(line, pj) == 32 || byte_at(line, pj) == 9) {
                            pj += 1
                        }
                        if pj < line.len && byte_at(line, pj) == 61 {
                            pj += 1
                            while pj < line.len && (byte_at(line, pj) == 32 || byte_at(line, pj) == 9) {
                                pj += 1
                            }
                            if pj < line.len && byte_at(line, pj) == 34 {
                                isPath = true
                            }
                        }
                    }
                }
                if isPath {
                    if pending.len > 0 {
                        // sub(/.*= *"/,"",v) 贪心:最末 `=空格*"` 组(自尾向首扫)
                        var li: I32 = -1
                        var qi: I32 = -1
                        var s2: I32 = line.len - 1
                        while s2 >= 0 {
                            if byte_at(line, s2) == 61 {
                                var j2 = s2 + 1
                                while j2 < line.len && byte_at(line, j2) == 32 {
                                    j2 += 1
                                }
                                if j2 < line.len && byte_at(line, j2) == 34 {
                                    li = s2
                                    qi = j2
                                    break
                                }
                            }
                            s2 -= 1
                        }
                        var v = ""
                        if li >= 0 {
                            v = byte_slice(line, qi + 1, line.len)
                            var c2: I32 = -1
                            var q2: I32 = 0
                            while q2 < v.len {
                                if byte_at(v, q2) == 34 {
                                    c2 = q2
                                    break
                                }
                                q2 += 1
                            }
                            if c2 >= 0 {
                                v = byte_slice(v, 0, c2)
                            }
                        }
                        push_ws_tokens(out, pending)
                        push_ws_tokens(out, v)
                        pending = ""
                    }
                }
            }
            start = i + 1
        }
        i += 1
    }
    return out
}

fn build_proj() -> I32 {
    // sh cmd_build_proj 项目模式臂(cwd = 用户现场;清单 name 提取 / dep→ctron-dep /
    // workspace 逐成员自 spawn 递归 / 入口 src/main.ct / 产物 build/<name>+
    // c_src/*.c 收集链接)。
    if !fs_exists("Ctron.ctcl") {
        if fs_exists("Ctron.toml") {
            return fail2("清单格式已硬切 CTCL(T48):检测到 Ctron.toml——请迁移为 Ctron.ctcl:pkg \{ manifest_version = 1, name = \"…\", version = \"…\" }(设计:docs/superpowers/specs/2026-09-16-config-language-v1.md)")
        }
        return fail2("项目模式需 Ctron.ctcl")
    }
    var mtext = read_text("Ctron.ctcl")
    var name = ""
    match manifest_name(mtext) {
        Some(v) => {
            name = v
        }
        None => {}
    }
    if name.len == 0 {
        name = basename_sh(env_get("PWD"))
    }
    if !fs_exists("src/main.ct") {
        return fail2("缺入口 src/main.ct")
    }
    // T49:清单含 dep → 先过依赖解析(lock 生成/校验),再发射
    if has_line_prefix(mtext, "dep \"") {
        var depp = bin_dir() + "/ctron-dep"
        if fs_exists(depp) {
            // sh [ -x ] 同判偏差登记:native 无执行位内建,存在即判可执行
            var argv = List[Str]()
            argv.push(depp)
            argv.push("run")
            argv.push(env_get("PWD") + "/Ctron.ctcl")
            if blob_rc_cwd(argv, "") != 0 {
                return 1
            }
        } else {
            eprint("ctron: 清单含 dep 但缺 ctron-dep,跳过 lock 校验(重装工具链解锁)\n")
        }
    }
    // T49:workspace 根清单 → 逐成员子构建(sh `$0 build` 同构 = 自 spawn 于成员目录)。
    // PWD 面:sh 子壳 `cd -- "$MDIR"` 会把 PWD 导给子进程(其 $PWD/src/main.ct 取
    // 成员目录);native chdir 不动 env → spawn 前 env_set PWD = norm_join(原PWD,
    // 成员)(= sh cd 逻辑归一同构),spawn 后还原(子壳隔离同构)。
    if has_line_prefix(mtext, "workspace") {
        var toks = ws_pairs(mtext)
        var selfp = ctron_exe_path()
        var pwd0 = env_get("PWD")
        var k: I32 = 0
        while k < toks.len {
            var mdir = toks[k]
            // 成员行 = /bin/echo 直写(fmt 面 echo_line 先例:println 块缓冲会在
            // 子进程产出之后才落,sh echo 内建逐行即时序破)
            echo_line("ctron: workspace 成员 " + mdir)
            var npwd = pwd0
            if mdir.len > 0 {
                if byte_at(mdir, 0) == 47 {
                    npwd = norm_join("", mdir)
                } else {
                    npwd = norm_join(pwd0, mdir)
                }
            }
            env_set("PWD", npwd)
            var argv = List[Str]()
            argv.push(selfp)
            argv.push("build")
            let src = blob_rc_cwd(argv, mdir)
            env_set("PWD", pwd0)
            if src != 0 {
                return 1
            }
            k += 1
        }
        return 0
    }
    fs_mkdir("build")
    var bin = bin_dir() + "/ctron-emit"
    var buf: U8[1048576] = [0, 0, 0, 0, 0, 0, 0, 0]
    capture_zero(buf)
    let rc = run("", bin, env_get("PWD") + "/src/main.ct", buf)
    if rc != 0 {
        return 1
    }
    if capture_len(buf) == buf.len {
        eprint("ctron: 发射输出超捕获容量 " + buf.len.to_string() + " 字节: src/main.ct\n")
        return 1
    }
    fs_write("build/" + name + ".c", capture_str(buf))
    if !have_cc_probe() {
        cc_missing_guidance("build/" + name + ".c")
        return 2
    }
    var argv = List[Str]()
    argv.push(cc_bin())
    argv.push("-O2")
    argv.push("-w")
    argv.push("-pthread")
    argv.push("build/" + name + ".c")
    // c_src/*.c 收集(sh glob 同义;list 字节序 = C 序,locale 病理登记在案;
    // .c 名目录/点首文件 = sh [ -f ]/glob 不含,登记在案)
    if is_dir_target("c_src") {
        var names = list("c_src")
        var q: I32 = 0
        while q < names.len {
            var nm = names[q]
            var nl = nm.len
            if nl >= 2 {
                if byte_at(nm, nl - 1) == 99 && byte_at(nm, nl - 2) == 46 {
                    argv.push("c_src/" + nm)
                }
            }
            q += 1
        }
    }
    argv.push("-o")
    argv.push("build/" + name)
    if blob_rc_cwd(argv, "") != 0 {
        return 2
    }
    println("ctron: 已构建 build/" + name)
    return 0
}

fn target_registered(t: Str) -> Bool {
    // sh ct_target_check 注册表(:431-439)
    if t == "native" { return true }
    if t == "thumbv7em-none-eabi" { return true }
    if t == "riscv32imac-unknown-none" { return true }
    if t == "wasm32-unknown-unknown" { return true }
    return false
}

// ---- task/gate/clean 面(W4 波2 批2)----
// sh 镜像源(仓库根 ctron 脚本,live text 为准):DRV_READER_AWK :35-182 /
// DRV_SPLIT_AWK :184-227 / drv_env_setup :956-962 / run_step :968-983 /
// drv_load :988-995 / cmd_task :997-1048 / drv_is_driver_manifest :1054-1057 /
// cmd_gate :1063-1088 / cmd_clean :1093-1119。
// 架构差:任务表 = 内存记录流(List[Str];T/W/S 前缀 + TAB 分隔 = sh TASKS_CFG
// 的 List 形)——sh fd3/stdin 劫持洞在结构上不存在;task.cwd 不 chdir 本进程,
// 解析绝对传 run_argv_rc cwd 参(非空 = 子进程 chdir,ctron_proc.c 读码钉定);
// env 注入 = W3 env_set 本进程 setenv(子 execve 继承);stdout 用户行走 echo_line
// 直写(fmt 面先例:println 块缓冲与子步骤产出交错会反序)。

fn ctcl_fail(nr: I32, msg: Str) -> I32 {
    // awk fail():printf "ctron: ctron.ctcl:%d: %s\n", NR, msg > "/dev/stderr";exit 1
    // (文件名恒字面 ctron.ctcl,与实参 -f 无关,= sh 逐字;返回 2 供调用方回)
    eprint("ctron: ctron.ctcl:" + nr.to_string() + ": " + msg + "\n")
    return 2
}

fn ctcl_rtrim(s: Str) -> Str {
    // awk rtrim:sub(/[ \t\r]+$/, "", s)
    var end = s.len
    while end > 0 {
        var c = byte_at(s, end - 1)
        if c == 32 || c == 9 || c == 13 {
            end -= 1
        } else {
            break
        }
    }
    return byte_slice(s, 0, end)
}

fn ctcl_ltrim(s: Str) -> Str {
    // awk ltrim:sub(/^[ \t]+/, "", s)(不含 \r——与 rtrim 的字符类差 = sh 逐字)
    var b: I32 = 0
    while b < s.len {
        var c = byte_at(s, b)
        if c == 32 || c == 9 {
            b += 1
        } else {
            break
        }
    }
    return byte_slice(s, b, s.len)
}

fn ctcl_strip_comment(s: Str) -> Str {
    // awk strip_comment 逐字:字符串感知(引号内 \\ 消费、/" 收尾);引号外 // 即截
    var out = ""
    var inq: Bool = false
    var bs: Bool = false
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if inq {
            out = out + byte_slice(s, i, i + 1)
            if bs {
                bs = false
            } else if c == 92 {
                bs = true
            } else if c == 34 {
                inq = false
            }
        } else {
            if c == 34 {
                inq = true
                out = out + byte_slice(s, i, i + 1)
            } else if c == 47 && i + 1 < s.len && byte_at(s, i + 1) == 47 {
                return out
            } else {
                out = out + byte_slice(s, i, i + 1)
            }
        }
        i += 1
    }
    return out
}

fn ctcl_uq_ok(s: Str) -> Bool {
    // awk unquote 的 UQ_OK 判定面:length<2 / 首尾非引号 / 孤立尾反斜杠 /
    // 转义白名单外(\" \\ 之外)= 假;空串合法("")= 真(UQ_OK 哨兵语义)
    if s.len < 2 {
        return false
    }
    if byte_at(s, 0) != 34 {
        return false
    }
    if byte_at(s, s.len - 1) != 34 {
        return false
    }
    var bl = s.len - 2
    var i: I32 = 0
    while i < bl {
        if byte_at(s, 1 + i) == 92 {
            if i == bl - 1 {
                return false
            }
            var c2 = byte_at(s, 1 + i + 1)
            if c2 != 34 && c2 != 92 {
                return false
            }
            i += 2
        } else {
            i += 1
        }
    }
    return true
}

fn ctcl_unquote(s: Str) -> Str {
    // awk unquote 解码头(仅 UQ_OK 在场时调用):剥首尾引号;\\x 取 x 原样
    // (白名单外已由 ctcl_uq_ok 拒),余字原样
    var out = ""
    var body = byte_slice(s, 1, s.len - 1)
    var i: I32 = 0
    while i < body.len {
        var c = byte_at(body, i)
        if c == 92 {
            if i + 1 < body.len {
                out = out + byte_slice(body, i + 1, i + 2)
                i += 2
            } else {
                i += 1
            }
        } else {
            out = out + byte_slice(body, i, i + 1)
            i += 1
        }
    }
    return out
}

fn ctcl_task_name_ok(s: Str) -> Bool {
    // awk /^[a-z][a-z0-9_-]*$/
    if s.len < 1 {
        return false
    }
    if byte_at(s, 0) < 97 || byte_at(s, 0) > 122 {
        return false
    }
    var i: I32 = 1
    while i < s.len {
        var c = byte_at(s, i)
        var okc: Bool = false
        if c >= 97 && c <= 122 { okc = true }
        if c >= 48 && c <= 57 { okc = true }
        if c == 95 { okc = true }
        if c == 45 { okc = true }
        if !okc {
            return false
        }
        i += 1
    }
    return true
}

fn ctcl_key_ok(s: Str) -> Bool {
    // awk /^[a-z_][a-z0-9_]*$/
    if s.len < 1 {
        return false
    }
    var c0 = byte_at(s, 0)
    if !((c0 >= 97 && c0 <= 122) || c0 == 95) {
        return false
    }
    var i: I32 = 1
    while i < s.len {
        var c = byte_at(s, i)
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) {
            return false
        }
        i += 1
    }
    return true
}

fn ctcl_int_ok(s: Str) -> Bool {
    // awk /^-?(0|[1-9][0-9]*)$/
    var i: I32 = 0
    if s.len > 0 {
        if byte_at(s, 0) == 45 {
            i = 1
        }
    }
    var rl = s.len - i
    if rl == 0 {
        return false
    }
    var c0 = byte_at(s, i)
    if rl == 1 {
        // 单字符 = 0-9 任一(awk 交替 0|[1-9][0-9]* 的两侧单字符全集)
        return c0 >= 48 && c0 <= 57
    }
    if c0 < 49 || c0 > 57 {
        return false
    }
    var k: I32 = i + 1
    while k < s.len {
        var c = byte_at(s, k)
        if c < 48 || c > 57 {
            return false
        }
        k += 1
    }
    return true
}

// 单行 CTCL 处理共用:取行(\n 界,尾行无换行亦计——awk NR 同义)
fn ctcl_next_line(text: Str, start: I32) -> I32 {
    var sc: I32 = start
    while sc < text.len {
        if byte_at(text, sc) == 10 {
            return sc
        }
        sc += 1
    }
    return text.len
}

fn ctcl_parse(text: Str, var recs: List[Str], var tnames: List[Str]) -> I32 {
    // 根脚本 DRV_READER_AWK 状态机逐字(:74-180)。记录流:T\t名\tdesc(关块时落,
    // = awk printf "TASK...")/ W\t名\tcwd(有 cwd 键才落)/ S\t名\t步(steps 解析
    // 即落)。END 路径三查:块未闭合 → 缺 ctron 块(E5047)→ 缺 config_version
    // (E5050),消息无行号前缀逐字;一错即停(fail 即 return,后续不再处理)。
    var blk = ""
    var cur = ""
    var desc = ""
    var tcwd = ""
    var nsteps: I32 = 0
    var hasSteps: Bool = false
    var hasDesc: Bool = false
    var hasCwd: Bool = false
    var sawCtron: Bool = false
    var seenCfg: Bool = false
    var cfgOk: Bool = false
    var nr: I32 = 0
    var start: I32 = 0
    while start < text.len {
        var nl = ctcl_next_line(text, start)
        nr += 1
        var line = ctcl_rtrim(ctcl_ltrim(ctcl_strip_comment(byte_slice(text, start, nl))))
        if nl >= text.len {
            start = text.len
        } else {
            start = nl + 1
        }
        if line.len == 0 {
            continue
        }
        if blk.len == 0 {
            // 块头行(IDENT + 可选带引号实参 + 行尾 {)
            if byte_at(line, 0) == 91 {
                return ctcl_fail(nr, "本语言不用 [section] 段头;请用块:ctron \{ ... } / task \"名\" \{ ... }")
            }
            if byte_at(line, line.len - 1) != 123 {
                return ctcl_fail(nr, "块头 \{ 必须行尾:ctron \{ ... } / task \"名\" \{ ... }")
            }
            var head = ctcl_rtrim(byte_slice(line, 0, line.len - 1))
            var id = head
            var arg = ""
            var wcut: I32 = -1
            var hi: I32 = 0
            while hi < head.len {
                var hc = byte_at(head, hi)
                if hc == 32 || hc == 9 {
                    wcut = hi
                    break
                }
                hi += 1
            }
            if wcut >= 0 {
                id = byte_slice(head, 0, wcut)
                arg = ctcl_rtrim(byte_slice(head, wcut + 1, head.len))
            }
            if id != "ctron" && id != "task" {
                return ctcl_fail(nr, "E5044 未知块 " + id + ";合法块:ctron, task")
            }
            if id == "ctron" {
                if arg.len != 0 {
                    return ctcl_fail(nr, "E5041 ctron 是记录块,不带名字实参")
                }
                if sawCtron {
                    return ctcl_fail(nr, "E5045 ctron 块最多一个")
                }
                sawCtron = true
            } else {
                if arg.len == 0 {
                    return ctcl_fail(nr, "E5041 task 是键控块:task \"名\" \{ ... }")
                }
                if !ctcl_uq_ok(arg) {
                    return ctcl_fail(nr, "E5040 task 名实参非法")
                }
                var tname = ctcl_unquote(arg)
                if !ctcl_task_name_ok(tname) {
                    return ctcl_fail(nr, "E5046 task 名非法(形:[a-z][a-z0-9_-]*):" + tname)
                }
                var dup: Bool = false
                var ti: I32 = 0
                while ti < tnames.len {
                    if tnames[ti] == tname {
                        dup = true
                        break
                    }
                    ti += 1
                }
                if dup {
                    return ctcl_fail(nr, "E5045 重复的 task \"" + tname + "\"")
                }
                tnames.push(tname)
                cur = tname
                nsteps = 0
                hasSteps = false
                hasDesc = false
                hasCwd = false
                desc = ""
                tcwd = ""
            }
            blk = id
        } else if line == "}" {
            if blk == "task" {
                if !hasSteps {
                    return ctcl_fail(nr, "E5051 task \"" + cur + "\" 缺必填键 steps")
                }
                if nsteps == 0 {
                    return ctcl_fail(nr, "E5054 steps 不允许空列表(空 steps 的任务不合法)")
                }
                recs.push("T\t" + cur + "\t" + desc)
                if tcwd.len != 0 {
                    recs.push("W\t" + cur + "\t" + tcwd)
                }
            }
            blk = ""
            cur = ""
        } else {
            // 键值行({ } 内嵌/单行块先拒,再 = 切分,四键白名单)
            var hasBrace: Bool = false
            var bi: I32 = 0
            while bi < line.len {
                var bc = byte_at(line, bi)
                if bc == 123 || bc == 125 {
                    hasBrace = true
                    break
                }
                bi += 1
            }
            if hasBrace {
                return ctcl_fail(nr, "E5040 块内禁止嵌套块/单行块(深度恒 1)")
            }
            var eq: I32 = -1
            var ei: I32 = 0
            while ei < line.len {
                if byte_at(line, ei) == 61 {
                    eq = ei
                    break
                }
                ei += 1
            }
            if eq < 0 {
                return ctcl_fail(nr, "E5040 块内每行必须是 键 = 值")
            }
            var key = ctcl_rtrim(byte_slice(line, 0, eq))
            var val = ctcl_ltrim(byte_slice(line, eq + 1, line.len))
            if !ctcl_key_ok(key) {
                return ctcl_fail(nr, "E5040 块内每行必须是 键 = 值")
            }
            if blk == "ctron" {
                if key != "config_version" {
                    return ctcl_fail(nr, "E5043 块 ctron 中未知键 " + key + ";合法键:config_version")
                }
                if seenCfg {
                    return ctcl_fail(nr, "E5045 重复键 " + key)
                }
                seenCfg = true
                if !ctcl_int_ok(val) {
                    return ctcl_fail(nr, "E5046 config_version 的类型应为 int")
                }
                if val != "1" {
                    return ctcl_fail(nr, "E5050 config_version 必须为 1")
                }
                cfgOk = true
            } else {
                if key != "steps" && key != "desc" && key != "cwd" {
                    return ctcl_fail(nr, "E5043 块 task 中未知键 " + key + ";合法键:steps, desc, cwd")
                }
                // 重复键 per-task 查(awk (cur SUBSEP key) in seen_key 同义;
                // 块不嵌套,cur 单活跃,三键 has 旗标即全义)
                if key == "steps" {
                    if hasSteps {
                        return ctcl_fail(nr, "E5045 重复键 " + key)
                    }
                    hasSteps = true
                } else if key == "desc" {
                    if hasDesc {
                        return ctcl_fail(nr, "E5045 重复键 " + key)
                    }
                    hasDesc = true
                } else {
                    if hasCwd {
                        return ctcl_fail(nr, "E5045 重复键 " + key)
                    }
                    hasCwd = true
                }
                if key == "desc" {
                    if byte_at(val, 0) != 34 {
                        return ctcl_fail(nr, "E5046 desc 的类型应为 str")
                    }
                    if !ctcl_uq_ok(val) {
                        return ctcl_fail(nr, "E5048 desc 字符串非法(转义仅 \\\" 与 \\\\)")
                    }
                    desc = ctcl_unquote(val)
                } else if key == "cwd" {
                    if byte_at(val, 0) != 34 {
                        return ctcl_fail(nr, "E5046 cwd 的类型应为 str")
                    }
                    if !ctcl_uq_ok(val) {
                        return ctcl_fail(nr, "E5048 cwd 字符串非法(转义仅 \\\" 与 \\\\)")
                    }
                    tcwd = ctcl_unquote(val)
                } else {
                    // steps:list 单行、非空、无尾逗号,元素逐个双引号解码头
                    if byte_at(val, 0) != 91 {
                        return ctcl_fail(nr, "E5046 steps 的类型应为 list")
                    }
                    if byte_at(val, val.len - 1) != 93 {
                        return ctcl_fail(nr, "E5040 列表必须单行且以 ] 结尾")
                    }
                    var inner = ctcl_ltrim(ctcl_rtrim(byte_slice(val, 1, val.len - 1)))
                    if inner.len == 0 {
                        return ctcl_fail(nr, "E5054 steps 不允许空列表(空 steps 的任务不合法)")
                    }
                    if byte_at(inner, inner.len - 1) == 44 {
                        return ctcl_fail(nr, "E5048 列表不允许尾逗号(最后元素后直接 ])")
                    }
                    var rest = inner
                    while true {
                        // awk 元素切分:字符串感知逐字(引号内 \\ 消费;引号外逗号即断)
                        var inq: Bool = false
                        var bsq: Bool = false
                        var elem = ""
                        var m = rest.len
                        var j: I32 = 1
                        var brokeAt: I32 = -1
                        while j <= m {
                            var c = byte_at(rest, j - 1)
                            if inq {
                                elem = elem + byte_slice(rest, j - 1, j)
                                if bsq {
                                    bsq = false
                                } else if c == 92 {
                                    bsq = true
                                } else if c == 34 {
                                    inq = false
                                }
                            } else {
                                if c == 34 {
                                    inq = true
                                    elem = elem + byte_slice(rest, j - 1, j)
                                } else if c == 44 {
                                    brokeAt = j
                                    break
                                } else {
                                    elem = elem + byte_slice(rest, j - 1, j)
                                }
                            }
                            j += 1
                        }
                        var e2 = ctcl_rtrim(ctcl_ltrim(elem))
                        var uqOk: Bool = false
                        var sv = ""
                        if e2.len != 0 {
                            if ctcl_uq_ok(e2) {
                                uqOk = true
                                sv = ctcl_unquote(e2)
                            }
                        }
                        if !uqOk {
                            return ctcl_fail(nr, "E5048 列表元素必须是双引号字符串(转义仅 \\\" 与 \\\\)")
                        }
                        nsteps += 1
                        recs.push("S\t" + cur + "\t" + sv)
                        if brokeAt < 0 {
                            break
                        }
                        rest = byte_slice(rest, brokeAt, rest.len)
                    }
                }
            }
        }
    }
    // END 路径三查(:175-180;消息无行号前缀,逐字)
    if blk.len != 0 {
        eprint("ctron: ctron.ctcl: 块未闭合(缺 })\n")
        return 2
    }
    if !sawCtron {
        eprint("ctron: ctron.ctcl: E5047 缺 ctron 块\n")
        return 2
    }
    if !cfgOk {
        eprint("ctron: ctron.ctcl: E5050 ctron 缺语言版本键 config_version(必须存在且 = 1)\n")
        return 2
    }
    return 0
}

// ---- runner(DRV_SPLIT_AWK + run_step 同构)----

fn split_step(s: Str, var argv: List[Str]) -> Bool {
    // 根脚本 DRV_SPLIT_AWK(:184-227)逐字:元字符 11 字符全串拒(| & ; $ ` < > ( ) * ?;
    // 消息含「两条出路」行);切分 = 空白分组/双引号串接(引号内 \" 与 \\ 取下一字符
    // 原样;孤立尾反斜杠/引号未闭合诊断逐字)。假 = 已落 stderr,调用方回 2。
    var mch: Bool = false
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if c == 124 || c == 38 || c == 59 || c == 36 || c == 96 || c == 60 || c == 62 || c == 40 || c == 41 || c == 42 || c == 63 {
            mch = true
            break
        }
        i += 1
    }
    if mch {
        eprint("ctron: E5040 步骤含 shell 元字符(| & ; $ ` < > ( ) * ?):" + s + ";两条出路:改写为多步骤 / 写脚本文件后以 sh 调用\n")
        return false
    }
    var p: I32 = 0
    var n = s.len
    while p < n {
        var c = byte_at(s, p)
        if c == 32 || c == 9 {
            p += 1
            continue
        }
        var arg = ""
        if c == 34 {
            p += 1
            var closed: Bool = false
            while p < n {
                c = byte_at(s, p)
                if c == 92 {
                    if p == n - 1 {
                        eprint("ctron: 步骤串孤立的尾部反斜杠:" + s + "\n")
                        return false
                    }
                    arg = arg + byte_slice(s, p + 1, p + 2)
                    p += 2
                } else if c == 34 {
                    closed = true
                    p += 1
                    break
                } else {
                    arg = arg + byte_slice(s, p, p + 1)
                    p += 1
                }
            }
            if !closed {
                eprint("ctron: 步骤串引号未闭合:" + s + "\n")
                return false
            }
        } else {
            while p < n {
                c = byte_at(s, p)
                if c == 32 || c == 9 || c == 34 {
                    break
                }
                arg = arg + byte_slice(s, p, p + 1)
                p += 1
            }
        }
        argv.push(arg)
    }
    return true
}

fn run_step(step: Str, cwd: Str) -> I32 {
    // 根脚本 run_step(:968-983)同构:切分 argv → 仅 argv[0] 的裸名 ctron 替换
    // 自身 exe 全路径(sh CTRON_SELF;他位的字面 ctron 是用户数据不改写)→
    // run_argv_rc 直 exec(cwd 非空 = 子进程 chdir;stdin 继承 = sh fd3 教训的
    // 结构性消解;rc 由 waitpid 直取,无 shell 中间层)。
    var argv = List[Str]()
    if !split_step(step, argv) {
        return 2
    }
    if argv.len == 0 {
        // sh "$@" 空参 = rc 0(病理面:空串步骤;语料不含,诚实账登记)
        return 0
    }
    if argv[0] == "ctron" {
        argv[0] = ctron_exe_path()
    }
    var blob: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
    let nb = argv_to_blob(argv, blob)
    if nb < 0 {
        // 步骤串超 blob 容量(sh 无上限;= exec 失败口径 127,delegate 家族先例)
        return 127
    }
    return run_argv_rc(cwd, blob, nb.as[I64](), "")
}

// ---- env 注入 / 缓存根 / 门嗅探 ----

fn drv_root() -> Str {
    // sh DRV_ROOT=${CTRON_DRV_ROOT:-$DEVROOT}:sh DEVROOT = 根脚本目录(仓库根);
    // native = exe 父的父(compiler/bin → compiler → 仓库根,两布局同值)
    var e = env_get("CTRON_DRV_ROOT")
    if e.len != 0 {
        return e
    }
    return dir_of(dir_of(bin_dir()))
}

fn drv_env_setup() {
    // sh drv_env_setup(:956-962)同构:lib/std 在场才注入 CTRON_STDPATH
    // (W3 env_set = 本进程 setenv;子步骤 execve 继承;task/gate 分派臂先行,
    // clean 不注入 = sh 逐字)
    var root = drv_root()
    if is_dir_target(root + "/lib/std") {
        env_set("CTRON_STDPATH", root + "/lib/std")
    }
}

fn drv_is_driver_manifest(p: Str) -> Bool {
    // sh drv_is_driver_manifest(:1054-1057)逐字:逐行(首空白剥;^// 行滤)
    // 前缀 ^(ctron|task)[[:space:]{] 任一行命中即真(整文扫 = sh grep 同义;
    // 大小写不敏感文件系统上 ctron.ctcl ≡ Ctron.ctcl,项目清单 pkg 块首不命中
    // = darwin 坑防误中;嗅探只把关卡分派,诊断仍归读取器)
    if !fs_exists(p) {
        return false
    }
    var text = read_text(p)
    var start: I32 = 0
    while start < text.len {
        var nl = ctcl_next_line(text, start)
        var line = byte_slice(text, start, nl)
        var b: I32 = 0
        while b < line.len {
            var bc = byte_at(line, b)
            if bc == 32 || bc == 9 || bc == 11 || bc == 12 || bc == 13 {
                b += 1
            } else {
                break
            }
        }
        var isComment: Bool = false
        if line.len - b >= 2 {
            if byte_at(line, b) == 47 && byte_at(line, b + 1) == 47 {
                isComment = true
            }
        }
        if !isComment {
            var rest = byte_slice(line, b, line.len)
            var hit: Bool = false
            if rest.len >= 6 {
                if byte_slice(rest, 0, 5) == "ctron" {
                    var nc = byte_at(rest, 5)
                    if nc == 32 || nc == 9 || nc == 11 || nc == 12 || nc == 13 || nc == 123 {
                        hit = true
                    }
                }
            }
            if !hit {
                if rest.len >= 5 {
                    if byte_slice(rest, 0, 4) == "task" {
                        var nc2 = byte_at(rest, 4)
                        if nc2 == 32 || nc2 == 9 || nc2 == 11 || nc2 == 12 || nc2 == 13 || nc2 == 123 {
                            hit = true
                        }
                    }
                }
            }
            if hit {
                return true
            }
        }
        if nl >= text.len {
            break
        }
        start = nl + 1
    }
    return false
}

// ---- cmd_task / cmd_gate / cmd_clean ----

fn cmd_task(tfile: Str, tname: Str) -> I32 {
    // 根脚本 cmd_task(:997-1048)同构。清单缺席 = die2 逐字(实参原形内嵌);
    // 绝对化 = sh cd&&pwd/basename 同构;读表入内存记录流;无名列出(TASK 记录
    // 名\tDesc,echo 直写)/ 有名执行两臂;task.cwd 解析绝对传 spawn cwd(不 chdir
    // 本进程;PWD 同步导给子步骤 = sh cd 的导出语义);败即停 rc 透传 + 判词逐字。
    if !fs_exists(tfile) {
        return fail2("task: 缺清单 " + tfile + "(驱动器面;试: ctron task -f <文件> 或先 ctron new)")
    }
    var mdir = dir_of(absolutize(tfile))
    var recs = List[Str]()
    var tnames = List[Str]()
    if ctcl_parse(read_text(absolutize(tfile)), recs, tnames) != 0 {
        return 2
    }
    if tname.len == 0 {
        var i: I32 = 0
        while i < recs.len {
            var r = recs[i]
            if r.len >= 2 {
                if byte_at(r, 0) == 84 && byte_at(r, 1) == 9 {
                    var t2: I32 = -1
                    var k: I32 = 2
                    while k < r.len {
                        if byte_at(r, k) == 9 {
                            t2 = k
                            break
                        }
                        k += 1
                    }
                    if t2 >= 0 {
                        echo_line(byte_slice(r, 2, t2) + "\t" + byte_slice(r, t2 + 1, r.len))
                    }
                }
            }
            i += 1
        }
        return 0
    }
    var found: Bool = false
    var i2: I32 = 0
    while i2 < recs.len {
        var r2 = recs[i2]
        if r2.len >= 2 {
            if byte_at(r2, 0) == 84 && byte_at(r2, 1) == 9 {
                var t3: I32 = -1
                var k3: I32 = 2
                while k3 < r2.len {
                    if byte_at(r2, k3) == 9 {
                        t3 = k3
                        break
                    }
                    k3 += 1
                }
                if t3 >= 0 {
                    if byte_slice(r2, 2, t3) == tname {
                        found = true
                        break
                    }
                }
            }
        }
        i2 += 1
    }
    if !found {
        return fail2("task: 未知任务 " + tname + "(试: ctron task 列表)")
    }
    var tcwd = ""
    var i3: I32 = 0
    while i3 < recs.len {
        var r3 = recs[i3]
        if r3.len >= 2 {
            if byte_at(r3, 0) == 87 && byte_at(r3, 1) == 9 {
                var t4: I32 = -1
                var k4: I32 = 2
                while k4 < r3.len {
                    if byte_at(r3, k4) == 9 {
                        t4 = k4
                        break
                    }
                    k4 += 1
                }
                if t4 >= 0 {
                    if byte_slice(r3, 2, t4) == tname {
                        tcwd = byte_slice(r3, t4 + 1, r3.len)
                    }
                }
            }
        }
        i3 += 1
    }
    var stepCwd = mdir
    if tcwd.len != 0 {
        // sh TASK_CWD_ABS="$PWD/$TASK_CWD"(cd 清单目录后的 PWD = 清单目录同形)
        stepCwd = mdir + "/" + tcwd
        if !is_dir_target(stepCwd) {
            return fail2("task " + tname + ": cwd 目录不存在: " + tcwd + "(相对清单目录)")
        }
    }
    var steps = List[Str]()
    var i4: I32 = 0
    while i4 < recs.len {
        var r4 = recs[i4]
        if r4.len >= 2 {
            if byte_at(r4, 0) == 83 && byte_at(r4, 1) == 9 {
                var t5: I32 = -1
                var k5: I32 = 2
                while k5 < r4.len {
                    if byte_at(r4, k5) == 9 {
                        t5 = k5
                        break
                    }
                    k5 += 1
                }
                if t5 >= 0 {
                    if byte_slice(r4, 2, t5) == tname {
                        steps.push(byte_slice(r4, t5 + 1, r4.len))
                    }
                }
            }
        }
        i4 += 1
    }
    var total = steps.len
    var nn: I32 = 0
    var pwd0 = env_get("PWD")
    while nn < steps.len {
        var st = steps[nn]
        nn += 1
        // 进度行:echo 子进程直写(println 块缓冲会在子步骤产出之后才落 = 合流交错)
        echo_line("ctron: task " + tname + " 步骤 " + nn.to_string() + "/" + total.to_string() + ": " + st)
        env_set("PWD", stepCwd)
        var rc = run_step(st, stepCwd)
        env_set("PWD", pwd0)
        if rc != 0 {
            eprint("ctron: task " + tname + " 在步骤 " + nn.to_string() + " 失败(rc=" + rc.to_string() + ")\n")
            return rc
        }
    }
    echo_line("ctron: task " + tname + " 完成(" + nn.to_string() + " 步)")
    return 0
}

fn cmd_gate(gname: Str) -> I32 {
    // 根脚本 cmd_gate(:1063-1088)同构:D4 解析序 fail-closed —— cwd ctron.ctcl
    // (经首块嗅探确证驱动器清单)走 task 表;项目模式(Ctron.ctcl 在场)内建
    // 默认门 ["ctron build", "ctron fmt --check ."] 横幅先行;rc 2 用法错。
    // 旗标形实参不转发(sh fail-open 评审钉);步骤败 rc 原样透传。
    var name = gname
    if name.len != 0 {
        if byte_at(name, 0) == 45 {
            return fail2("gate: 未知旗标/名字不合法: " + name + "(用法: ctron gate [名])")
        }
    }
    if name.len == 0 {
        name = "gate"
    }
    if drv_is_driver_manifest("ctron.ctcl") {
        return cmd_task("ctron.ctcl", name)
    }
    if name == "gate" {
        if fs_exists("Ctron.ctcl") {
            echo_line("ctron: 内建默认门(build + fmt --check;项目自定义门:写 ctron.ctcl 的 task \"gate\")")
            var rc = run_step("ctron build", "")
            if rc != 0 {
                eprint("ctron: gate 在步骤 1 失败(rc=" + rc.to_string() + ")\n")
                return rc
            }
            rc = run_step("ctron fmt --check .", "")
            if rc != 0 {
                eprint("ctron: gate 在步骤 2 失败(rc=" + rc.to_string() + ")\n")
                return rc
            }
            echo_line("ctron: gate 完成(2 步)")
            return 0
        }
    }
    return fail2("gate: 缺 ctron.ctcl 且非项目模式(Ctron.ctcl 亦缺);试: ctron task / 先 ctron new")
}

fn delete_tree(p: Str) {
    // sh rm -rf 同义(探针①:fs_delete 空目录可删、非空拒)→ walk 前序(父先
    // 子后)逆序删(子先父后,父到时已空)= 全树净除,空目录壳不残留
    var all = walk(p)
    var i: I32 = all.len - 1
    while i >= 0 {
        fs_delete(all[i])
        i -= 1
    }
}

fn cmd_clean(allFlag: Bool) -> I32 {
    // 根脚本 cmd_clean(:1093-1119)同构:工具链缓存三域(.cache/emit|bare|wasm;
    // 根 = CTRON_DRV_ROOT 覆盖,缺省 exe/../..)逐域 [ -d ] 守卫(缺席域零输出,
    // 探针②钉定)——已清理行 echo 直写;--all 加项目 build/ 与 pkgs/(清单在场
    // 才动 = D5 项目模式限定词;非项目目录静默跳过,破坏性半径不越 cwd)。
    var root = drv_root()
    var doms = List[Str]()
    doms.push("emit")
    doms.push("bare")
    doms.push("wasm")
    var i: I32 = 0
    while i < doms.len {
        var d = root + "/.cache/" + doms[i]
        if is_dir_target(d) {
            delete_tree(d)
            echo_line("ctron: 已清理 .cache/" + doms[i])
        }
        i += 1
    }
    if allFlag {
        if fs_exists("Ctron.ctcl") {
            var doms2 = List[Str]()
            doms2.push("build")
            doms2.push("pkgs")
            var j: I32 = 0
            while j < doms2.len {
                if is_dir_target(doms2[j]) {
                    delete_tree(doms2[j])
                    echo_line("ctron: 已清理 " + doms2[j] + "/")
                }
                j += 1
            }
        }
    }
    return 0
}

// ---- new/add/publish/lock 臂(W4 波3 批1;sh :1215-1308 逐字镜像)----

// T49 registry 定位(sh REG=${CTRON_REGPATH:-$HOME/.ctron/registry} 同构:
// :- = 空值亦回落;HOME 经 env_get)
fn reg_path() -> Str {
    var r = env_get("CTRON_REGPATH")
    if r.len > 0 {
        return r
    }
    return env_get("HOME") + "/.ctron/registry"
}

// add_validate(:412)名段白名单:非空、全 [A-Za-z0-9_-]、首字符非 - 非数字
// (sh case ""|*[!A-Za-z0-9_-]*|[-0-9]* 同判)
fn dep_name_ok(name: Str) -> Bool {
    if name.len == 0 {
        return false
    }
    var b0 = byte_at(name, 0)
    if b0 == 45 || (b0 >= 48 && b0 <= 57) {
        return false
    }
    var i: I32 = 0
    while i < name.len {
        var b = byte_at(name, i)
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45) {
            return false
        }
        i += 1
    }
    return true
}

// add_validate 约束段白名单:grep -q '[^A-Za-z0-9.^~<>=,*_-]' 同判 —— 任一字节
// 出类即非法(方括号类不经 shell case 的坑,sh 侧已登记)
fn dep_req_ok(req: Str) -> Bool {
    var i: I32 = 0
    while i < req.len {
        var b = byte_at(req, i)
        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 46 || b == 94 || b == 126 || b == 60 || b == 62 || b == 61 || b == 44 || b == 42 || b == 95 || b == 45) {
            return false
        }
        i += 1
    }
    return true
}

// 版本第 idx 段(0..2)前导数字值;缺段/非数字起 = 0(sh sort -t. -k<n>n 口径:
// 非数字字段按 0 参与数值比较)
fn ver_part(v: Str, idx: I32) -> I64 {
    var i: I32 = 0
    var comp: I32 = 0
    while comp < idx {
        if i >= v.len {
            return 0
        }
        if byte_at(v, i) == 46 {
            comp += 1
        }
        i += 1
    }
    var n: I64 = 0
    while i < v.len {
        var b = byte_at(v, i)
        if b < 48 || b > 57 {
            break
        }
        n = n * 10 + (b - 48).as[I64]()
        i += 1
    }
    return n
}

// 三段数值全序 ≥(tail -1 语义:全等时取字节序靠后者 —— 候选按 list 字节序
// 扫过即替位,等值者末位胜出 = sort 稳定尾取同形)
fn ver_ge(a: Str, b: Str) -> Bool {
    var k: I32 = 0
    while k < 3 {
        var pa = ver_part(a, k)
        var pb = ver_part(b, k)
        if pa != pb {
            return pa > pb
        }
        k += 1
    }
    return true
}

// ls | sort -t. -k1,1n -k2,2n -k3,3n | tail -1:三段数值最大者(入表已是字节序)
fn max_ver(vs: List[Str]) -> Str {
    var best = ""
    var j: I64 = 0
    while j < vs.len {
        var v = vs[j]
        if best.len == 0 || ver_ge(v, best) {
            best = v
        }
        j += 1
    }
    return best
}

fn cmd_new(dir: Str) -> I32 {
    // sh new 臂(:1215-1221):mkdir -p 败 = 裸 exit 2(无诊断);清单/hello
    // printf 同文;echo 行逐字
    if !fs_mkdir(dir + "/src") {
        return 2
    }
    fs_write(dir + "/Ctron.ctcl", "pkg \{\n    manifest_version = 1\n    name = \"" + basename_sh(dir) + "\"\n    version = \"0.1.0\"\n}\n")
    fs_write(dir + "/src/main.ct", "fn main() \{\n    println(\"hello, ctron\")\n}\n")
    println("ctron: 已生成 " + dir + "/(ctron run " + dir + "/src/main.ct 试跑)")
    return 0
}

fn cmd_add(spec: Str) -> I32 {
    // sh add 臂(:1240-1277)+ add_validate(:412-430)逐字镜像
    var name = spec
    var req = ""
    var at: I32 = -1
    var i: I32 = 0
    while i < spec.len {
        if byte_at(spec, i) == 64 {
            at = i
            break
        }
        i += 1
    }
    if at >= 0 {
        name = byte_slice(spec, 0, at)
        req = byte_slice(spec, at + 1, spec.len)
    }
    if !dep_name_ok(name) {
        return fail2("add: 依赖名非法: '" + name + "'(形: <name>[@<版本约束>],name = [A-Za-z_][A-Za-z0-9_-]*)")
    }
    if req.len > 0 {
        if !dep_req_ok(req) {
            return fail2("add: 版本约束非法: '" + req + "'(semver 约束形,T49 实装)")
        }
    }
    if !fs_exists("Ctron.ctcl") {
        return fail2("add: 当前目录缺 Ctron.ctcl(项目模式)")
    }
    var reg = reg_path()
    if !fs_exists(reg + "/" + name) {
        return fail2("add: registry 无包 " + name + "(registry: " + reg + ";试: ctron publish)")
    }
    var ver = ""
    if req.len == 0 {
        ver = max_ver(list(reg + "/" + name))
    } else {
        var dots: I32 = 0
        var k: I32 = 0
        while k < req.len {
            if byte_at(req, k) == 46 {
                dots += 1
            }
            k += 1
        }
        if dots >= 2 {
            // sh case *.*.*):两点以上 = 精确版本直取
            ver = req
        } else {
            // 前缀约束(X / X.Y):case "$REQ"|"$REQ".* 收集 —— 段界前缀
            // (v == req,或 req 后恰为 '.'),再同序取最大
            var cands = List[Str]()
            var vers = list(reg + "/" + name)
            var j: I64 = 0
            while j < vers.len {
                var v = vers[j]
                if v == req || (v.len > req.len && byte_at(v, req.len) == 46 && starts_with(v, req)) {
                    cands.push(v)
                }
                j += 1
            }
            ver = max_ver(cands)
        }
    }
    if ver.len == 0 {
        return fail2("add: " + name + " 无满足约束 " + req + " 的版本")
    }
    if !fs_exists(reg + "/" + name + "/" + ver + "/module") {
        return fail2("add: registry 损坏:缺 module(" + name + "@" + ver + ")")
    }
    var mf = read_file("Ctron.ctcl")
    if contains(mf, "dep \"" + name + "\"") {
        eprint("ctron: dep \"" + name + "\" 已在清单(不重复追加)\n")
    } else {
        fs_write("Ctron.ctcl", mf + "\ndep \"" + name + "\" \{\n    version = \"" + ver + "\"\n}\n")
    }
    fs_mkdir("pkgs/" + name)
    fs_write("pkgs/" + name + "/" + name + ".ct", read_file(reg + "/" + name + "/" + ver + "/module"))
    fs_write("pkgs/" + name + "/Ctron.ctcl", read_file(reg + "/" + name + "/" + ver + "/manifest"))
    // 已安装行走 echo_line(/bin/echo 即时物理写):后随 ctron-dep 子进程 fd1 直写,
    // println 发射态 = stdio 块缓冲会反序(fmt 文件名行先例同病同方)
    echo_line("ctron: 已安装 pkgs/" + name + "/(" + name + "@" + ver + ")")
    var depbin = bin_dir() + "/ctron-dep"
    if !fs_exists(depbin) {
        return fail2("add: 缺 ctron-dep(重装工具链;或试: ctc.sh dep Ctron.ctcl)")
    }
    var argv = List[Str]()
    argv.push(depbin)
    argv.push("run")
    argv.push(env_get("PWD") + "/Ctron.ctcl")
    let rc = blob_rc_cwd(argv, "")
    if rc != 0 {
        return 1
    }
    return 0
}

fn cmd_lock() -> I32 {
    // sh lock 臂(:1278-1282):清单守卫 + ctron-dep 缺件 die2 + spawn rc 直通
    if !fs_exists("Ctron.ctcl") {
        return fail2("lock: 当前目录缺 Ctron.ctcl")
    }
    var depbin = bin_dir() + "/ctron-dep"
    if !fs_exists(depbin) {
        return fail2("lock: 缺 ctron-dep(重装工具链;或试: ctc.sh dep Ctron.ctcl)")
    }
    var argv = List[Str]()
    argv.push(depbin)
    argv.push("run")
    argv.push(env_get("PWD") + "/Ctron.ctcl")
    return blob_rc_cwd(argv, "")
}

// 清单键值提取(sh sed -n 's/^ *key *= *"\(.*\)".*/\1/p' | head -1 同构):首个
// 匹配行胜;捕获 = 锚引号至行内最末引号之间(greedy .* 语义);无匹配行/空捕获
// 皆空串([ -n ] 判空回退与 sh 同形)
fn manifest_value(txt: Str, key: Str) -> Str {
    var ls: I32 = 0
    var i: I32 = 0
    while i <= txt.len {
        if i == txt.len || byte_at(txt, i) == 10 {
            var line = byte_slice(txt, ls, i)
            var p: I32 = 0
            while p < line.len && byte_at(line, p) == 32 {
                p += 1
            }
            var ok: Bool = true
            var ki: I32 = 0
            while ki < key.len {
                if p >= line.len || byte_at(line, p) != byte_at(key, ki) {
                    ok = false
                    break
                }
                p += 1
                ki += 1
            }
            if ok {
                while p < line.len && byte_at(line, p) == 32 {
                    p += 1
                }
                if p < line.len && byte_at(line, p) == 61 {
                    p += 1
                    while p < line.len && byte_at(line, p) == 32 {
                        p += 1
                    }
                    if p < line.len && byte_at(line, p) == 34 {
                        var q0 = p
                        var q1: I32 = -1
                        var r: I32 = p + 1
                        while r < line.len {
                            if byte_at(line, r) == 34 {
                                q1 = r
                            }
                            r += 1
                        }
                        if q1 > q0 {
                            return byte_slice(line, q0 + 1, q1)
                        }
                    }
                }
            }
            ls = i + 1
        }
        i += 1
    }
    return ""
}

// 严格 semver:^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$
fn semver_ok(v: Str) -> Bool {
    var i: I32 = 0
    var c: I32 = 0
    while c < 3 {
        if c > 0 {
            if i >= v.len || byte_at(v, i) != 46 {
                return false
            }
            i += 1
        }
        var st = i
        while i < v.len && byte_at(v, i) >= 48 && byte_at(v, i) <= 57 {
            i += 1
        }
        var dl = i - st
        if dl == 0 {
            return false
        }
        if byte_at(v, st) == 48 && dl > 1 {
            return false
        }
        c += 1
    }
    // 前置标识 -pre 与构建元数据 +build:非空 [0-9A-Za-z.-] 跑
    var s: I32 = 0
    while s < 2 {
        if i < v.len && (byte_at(v, i) == 45 || byte_at(v, i) == 43) {
            i += 1
            var st2 = i
            while i < v.len {
                var b = byte_at(v, i)
                if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 46) {
                    break
                }
                i += 1
            }
            if i == st2 {
                return false
            }
        }
        s += 1
    }
    return i == v.len
}

fn cmd_publish() -> I32 {
    // sh publish 臂(:1283-1308)逐字:清单守卫/name(缺 = basename PWD)/
    // version 提取/严格 semver/单文件守卫/版本不可覆盖/三件落(manifest+module+
    // sha256 —— 摘要经 std.crypto sha256_hex,sh shasum 同字节同摘要,语料钉)
    if !fs_exists("Ctron.ctcl") {
        return fail2("publish 需项目清单 Ctron.ctcl(当前目录)")
    }
    var mf = read_file("Ctron.ctcl")
    var pname = manifest_value(mf, "name")
    if pname.len == 0 {
        pname = basename_sh(env_get("PWD"))
    }
    var pver = manifest_value(mf, "version")
    if pver.len == 0 {
        return fail2("publish: 清单缺 version")
    }
    if !semver_ok(pver) {
        return fail2("publish: version '" + pver + "' 不符严格 semver")
    }
    if !fs_exists("src/main.ct") {
        return fail2("publish: v0 registry 单文件包,需 src/main.ct")
    }
    var pn = walk("src")
    var pn_ct: I64 = 0
    var wi: I64 = 0
    while wi < pn.len {
        if ends_with(pn[wi], ".ct") {
            pn_ct += 1
        }
        wi += 1
    }
    if pn_ct != 1 {
        return fail2("publish: v0 registry 单文件包(src/ 下有 " + pn_ct.to_string() + " 个 .ct);多文件 tar 志向")
    }
    var ptgt = reg_path() + "/" + pname + "/" + pver
    if fs_exists(ptgt) {
        return fail2("publish: " + pname + "@" + pver + " 已发布(版本不可覆盖)")
    }
    if !fs_mkdir(ptgt) {
        return 2
    }
    fs_write(ptgt + "/manifest", mf)
    var mod_txt = read_file("src/main.ct")
    fs_write(ptgt + "/module", mod_txt)
    var digest = sha256_hex(mod_txt)
    fs_write(ptgt + "/sha256", digest + "\n")
    println("ctron: 已发布 " + pname + "@" + pver + " → " + ptgt + "(sha256:" + digest + ")")
    return 0
}

// ---- bench + pkg verify/attest/log/seal 面(W4 波3 批2)----
// sh 镜像源(仓库根 ctron 脚本,live text 为准):cmd_bench :386-411 / pkg 分派
// 臂 :1302-1502(verify L1 三段+--deep)/ cmd_pkg_attest :803-830 / cmd_pkg_log
// :832-897 / cmd_pkg_seal :899-949。
// --deep 复放腿挂账(批C):轨迹码gen + ctron-cc 逐例复放与 C 轨迹批共用机械,
// 本批 = ctron-verify 委派 + attest 腿(E5057)+ 判决行;复放计数恒 0(有轨
// 工件的 --deep 不入对拍语料——sh 真行为在案,诚实暂缓非分歧)。
// pkg trace 分派臂 rc2 暂缓已随批3 撤除(record/replay 全量落地;--deep 复放腿
// 异构码gen 仍挂账,见 pkg 分派臂注)。
// git 委派:run_argv_rc 直 exec(-c user.name/-c user.email 逐字);sh git add 的
// >/dev/null 2>&1 静音面不模拟(正常路径零输出;病理告警登记不语料化)。

fn repo_root() -> Str {
    // sh DEVROOT=$BIN(:13;dev 布局脚本目录 = 仓库根)同位:exe 父 = bin,
    // bin 父 = compiler,再父 = 仓库根(version_line 同源三级)
    var bin = dir_of(ctron_exe_path())
    var compiler = dir_of(bin)
    return dir_of(compiler)
}

fn find_from(s: Str, sub: Str, from: I32) -> I32 {
    // 子串首址(自 from 起;无 = -1)——行扫/标记定位底座
    var sl: I32 = s.len
    var nl: I32 = sub.len
    if nl == 0 {
        return from
    }
    var i: I32 = from
    while i + nl <= sl {
        var ok: Bool = true
        var j: I32 = 0
        while j < nl {
            if byte_at(s, i + j) != byte_at(sub, j) {
                ok = false
                j = nl
            }
            j += 1
        }
        if ok {
            return i
        }
        i += 1
    }
    return -1
}

fn str_lt(a: Str, b: Str) -> Bool {
    // LC_ALL=C sort 全行字节序(pkg seal SHA256SUMS 排序口径:find 两域合流后
    // 按相对路整串排,非 walk 的分层 DFS 序)
    var i: I32 = 0
    while i < a.len && i < b.len {
        if byte_at(a, i) != byte_at(b, i) {
            return byte_at(a, i) < byte_at(b, i)
        }
        i += 1
    }
    return a.len < b.len
}

fn sort_strs(names: List[Str]) {
    // 插入排序(walk_sort 同形;比较子换 str_lt 全行序)
    var a: I32 = 1
    while a < names.len {
        var v = names[a]
        var b: I32 = a - 1
        while b >= 0 {
            if str_lt(v, names[b]) {
                names[b + 1] = names[b]
                b -= 1
            } else {
                break
            }
        }
        names[b + 1] = v
        a += 1
    }
}

fn is_dir_p(p: Str) -> Bool {
    // sh -d 同判(is_dir_target 同构;read_dir 开得动 = 目录)
    match read_dir(p) {
        Some(_d) => {
            return true
        }
        None => {}
    }
    return false
}

fn is_file_p(p: Str) -> Bool {
    // sh -f:存在且非目录
    if !fs_exists(p) {
        return false
    }
    return !is_dir_p(p)
}

fn hex64(s: Str) -> Bool {
    // grep -Eq '^[0-9a-f]{64}$' 同义(全串 64 位小写十六进制)
    if s.len != 64 {
        return false
    }
    var i: I32 = 0
    while i < 64 {
        var c = byte_at(s, i)
        if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
            return false
        }
        i += 1
    }
    return true
}

fn abs_dir(p: Str) -> Str {
    // sh `cd <dir> && pwd` 同构:尾 '/' 剥尽(cd 对尾分隔符不敏感)后归一;
    // 裸名/缺省 = "."(dirname 裸名回 ".";pwd 即归一 PWD)
    var d = p
    while d.len > 1 {
        if byte_at(d, d.len - 1) == 47 {
            d = byte_slice(d, 0, d.len - 1)
        } else {
            break
        }
    }
    if d == "." || d.len == 0 {
        return norm_join(env_get("PWD"), "")
    }
    if byte_at(d, 0) == 47 {
        return norm_join("", d)
    }
    return norm_join(env_get("PWD"), d)
}

fn cp_r(src: Str, dst: Str) -> Bool {
    // sh cp -r 同构:walk 前序(父先子后)+ 目录建/文件写;根目必建
    if !fs_mkdir(dst) {
        return false
    }
    var ents = walk(src)
    var i: I32 = 1
    while i < ents.len {
        var rel = byte_slice(ents[i], src.len + 1, ents[i].len)
        var tgt = dst + "/" + rel
        if is_dir_p(ents[i]) {
            if !fs_mkdir(tgt) {
                return false
            }
        } else {
            fs_write(tgt, read_file(ents[i]))
        }
        i += 1
    }
    return true
}

fn seal_files(out: Str, sub: Str) -> List[Str] {
    // `find <sub> -type f` 相对路表(walk 全树 → 目录滤除;排序归调用方——
    // sh 两域 find 合流后按整串 LC_ALL=C sort)
    var base = out + "/" + sub
    var ents = walk(base)
    var out_l = List[Str]()
    var i: I32 = 1
    while i < ents.len {
        if !is_dir_p(ents[i]) {
            out_l.push(sub + "/" + byte_slice(ents[i], base.len + 1, ents[i].len))
        }
        i += 1
    }
    return out_l
}

fn meta_artifact_name(meta: Str) -> Str {
    // sed 's/^artifact "\([^"]*\)".*/\1/p' | head -1:行首 artifact " → 首个闭
    // 引号前(无闭引号 = 该行不命中;空值与不命中同形 = 下游 -n 判缺)
    var mk = "artifact \""
    var start: I32 = 0
    var i: I32 = 0
    while i <= meta.len {
        var isEnd: Bool = i == meta.len
        if isEnd || byte_at(meta, i) == 10 {
            var elen = i - start
            if elen >= mk.len {
                var hit: Bool = true
                var k: I32 = 0
                while k < mk.len {
                    if byte_at(meta, start + k) != byte_at(mk, k) {
                        hit = false
                        k = mk.len
                    }
                    k += 1
                }
                if hit {
                    var q = find_from(meta, "\"", start + mk.len)
                    if q >= 0 {
                        return byte_slice(meta, start + mk.len, q)
                    }
                }
            }
            start = i + 1
        }
        if isEnd {
            break
        }
        i += 1
    }
    return ""
}

fn meta_self_digest(meta: Str) -> Str {
    // sed 's/.*self_digest = "\(.*\)"/\1/p' | head -1:含标记行 → 最末标记后至
    // 行内最末引号(sed 左右双 greedy 同构;无右引号 = 该行不命中)
    var mk = "self_digest = \""
    var start: I32 = 0
    var i: I32 = 0
    while i <= meta.len {
        var isEnd: Bool = i == meta.len
        if isEnd || byte_at(meta, i) == 10 {
            var line = byte_slice(meta, start, i)
            var m = find_from(line, mk, 0)
            var lastm: I32 = -1
            while m >= 0 {
                lastm = m
                m = find_from(line, mk, m + 1)
            }
            if lastm >= 0 {
                var rest = byte_slice(line, lastm + mk.len, line.len)
                var q = find_from(rest, "\"", 0)
                var lastq: I32 = -1
                while q >= 0 {
                    lastq = q
                    q = find_from(rest, "\"", q + 1)
                }
                if lastq >= 0 {
                    return byte_slice(rest, 0, lastq)
                }
            }
            start = i + 1
        }
        if isEnd {
            break
        }
        i += 1
    }
    return ""
}

fn attest_digest_field(att: Str) -> Str {
    // sed 's/^  artifact_digest = "\(.*\)"/\1/p' | head -1:行首两空格 + 键 +
    // ` = "` → 行内最末引号前(同上双 greedy;deep attest 腿 E5057 对账读面)
    var mk = "  artifact_digest = \""
    var start: I32 = 0
    var i: I32 = 0
    while i <= att.len {
        var isEnd: Bool = i == att.len
        if isEnd || byte_at(att, i) == 10 {
            var elen = i - start
            if elen >= mk.len {
                var hit: Bool = true
                var k: I32 = 0
                while k < mk.len {
                    if byte_at(att, start + k) != byte_at(mk, k) {
                        hit = false
                        k = mk.len
                    }
                    k += 1
                }
                if hit {
                    var rest = byte_slice(att, start + mk.len, i)
                    var q = find_from(rest, "\"", 0)
                    var lastq: I32 = -1
                    while q >= 0 {
                        lastq = q
                        q = find_from(rest, "\"", q + 1)
                    }
                    if lastq >= 0 {
                        return byte_slice(rest, 0, lastq)
                    }
                }
            }
            start = i + 1
        }
        if isEnd {
            break
        }
        i += 1
    }
    return ""
}

fn attest_count_field(att: Str) -> Str {
    // sed 's/^  trace_count = \(.*\)$/\1/p' | head -1:行首两空格 + 键 + " = "
    // → 行尾全量(可空;空值与不命中同形 = 下游 -z 判畸形)
    var mk = "  trace_count = "
    var start: I32 = 0
    var i: I32 = 0
    while i <= att.len {
        var isEnd: Bool = i == att.len
        if isEnd || byte_at(att, i) == 10 {
            var elen = i - start
            if elen >= mk.len {
                var hit: Bool = true
                var k: I32 = 0
                while k < mk.len {
                    if byte_at(att, start + k) != byte_at(mk, k) {
                        hit = false
                        k = mk.len
                    }
                    k += 1
                }
                if hit {
                    return byte_slice(att, start + mk.len, i)
                }
            }
            start = i + 1
        }
        if isEnd {
            break
        }
        i += 1
    }
    return ""
}

fn count_traces_in(s: Str) -> I64 {
    // grep -c '^trace "':行首 trace " 行数(grep 与 read 异:尾无换行的末残行
    // 亦计入—— SHA256SUMS 逐行 read 口径弃残行,两工具各照各)
    var n: I64 = 0
    var mk = "trace \""
    var atBol: Bool = true
    var i: I32 = 0
    while i < s.len {
        if atBol {
            var hit: Bool = s.len - i >= mk.len
            var k: I32 = 0
            while hit && k < mk.len {
                if byte_at(s, i + k) != byte_at(mk, k) {
                    hit = false
                }
                k += 1
            }
            if hit {
                n += 1
            }
            atBol = false
        }
        if byte_at(s, i) == 10 {
            atBol = true
        }
        i += 1
    }
    return n
}

fn traces_trace_count(dir: Str) -> Str {
    // §5.4 轨迹计数:traces/*.ctrt 文件(glob 不匹配/非文件 = 跳)逐个行数和;
    // 返回 Str(与 attest.ctcl 记录值串比——sh [ A != B ] 字符串比较同构)
    var total: I64 = 0
    if is_dir_p(dir + "/traces") {
        var names = list(dir + "/traces")
        var i: I32 = 0
        while i < names.len {
            var f = dir + "/traces/" + names[i]
            if ends_with(names[i], ".ctrt") && is_file_p(f) {
                total += count_traces_in(read_file(f))
            }
            i += 1
        }
    }
    return total.to_string()
}

fn cat_stripped(p: Str) -> Str {
    // $(cat <文件>):尾 \n 全剥(version_line 同构)
    var t = read_file(p)
    while t.len > 0 {
        if byte_at(t, t.len - 1) == 10 {
            t = byte_slice(t, 0, t.len - 1)
        } else {
            break
        }
    }
    return t
}

fn capture_trimmed(var buf: U8[]) -> Str {
    // 捕获 stdout → $() 语义(尾 \n 全剥);git rev-parse --short HEAD 读面
    var s = ""
    var i: I32 = 0
    while i < buf.len {
        if buf[i].as[I64]() == 0 {
            break
        }
        s = s + utf8_enc(buf[i].as[I32]())
        i += 1
    }
    while s.len > 0 {
        if byte_at(s, s.len - 1) == 10 {
            s = byte_slice(s, 0, s.len - 1)
        } else {
            break
        }
    }
    return s
}

fn cmd_bench(rest: List[Str]) -> I32 {
    // sh cmd_bench(:386-411):无族 = 注册表清单(7 行)rc0;未注册 die2 逐字;
    // 脚本缺席 die2(基准族仅 dev 布局随发);命中 = `sh <族脚本>` spawn rc 直通
    if rest.len < 1 {
        println("ctron bench —— 基准族注册表(§9.4 性能口径;脚本内含门禁与归因)")
        println("  lang   own/热点算术核 vs C 同构对照(T44;门 ≤1.05,WARN 档)")
        println("  gc     GC 档 vs bump 档 churn(T32;门 ≤1.15)")
        println("  http   http_parse_head vs picohttpparser(CTRON_HTTP_BENCH=1 启用)")
        println("  net    吞吐/协程切换三门禁(CTRON_NET_BENCH=1 启用)")
        println("  ffi    FFI 边界微基准四场景(报告制)")
        println("  engine-proxy  秘本引擎代理 vs C 同构(设计 §11 RTF 线;digest pin+×3,门 ≤1.2)")
        println("用法: ctron bench <族>")
        return 0
    }
    var fam = rest[0]
    var script = ""
    if fam == "lang" {
        script = repo_root() + "/tests/lang/bench/bench.sh"
    } else if fam == "gc" {
        script = repo_root() + "/tests/gc/bench.sh"
    } else if fam == "http" {
        script = repo_root() + "/tests/http/bench/bench.sh"
    } else if fam == "net" {
        script = repo_root() + "/tests/net/bench/bench.sh"
    } else if fam == "ffi" {
        script = repo_root() + "/compiler/test/bench_ffi.sh"
    } else if fam == "engine-proxy" {
        script = repo_root() + "/tests/bench/engine-proxy/bench.sh"
    } else {
        return fail2("未注册基准族: " + fam + "(注册表: lang gc http net ffi engine-proxy;ctron bench 看详)")
    }
    if !fs_exists(script) {
        return fail2("基准族脚本缺席: " + script + "(基准族仅 dev 布局随发;装机形态未含)")
    }
    var argv = List[Str]()
    argv.push("sh")
    argv.push(script)
    return blob_rc_cwd(argv, "")
}

fn cmd_pkg_verify(rest: List[Str]) -> I32 {
    // sh pkg verify 臂(:1311-1502):--deep/dir 解析(非 --deep 首个 = dir,余弃)
    // → deep 腿(ctron-verify 委派 + attest 腿;复放挂账批C)→ L1 轻面四段
    // (①形态守卫 ②SHA256SUMS 逐行对账 ③self_digest 重算 ④判决行)。
    var deep: Bool = false
    var dir = ""
    var i: I32 = 0
    while i < rest.len {
        var a = rest[i]
        if a == "--deep" {
            deep = true
        } else {
            if dir.len == 0 {
                dir = a
            }
        }
        i += 1
    }
    if dir.len == 0 {
        return fail2("pkg verify 需要工件目录(.ctart)")
    }
    if !is_dir_p(dir) {
        return fail2("pkg verify: 工件目录不存在: " + dir)
    }
    if deep {
        // --deep = L3 载体(缺件 die2 → spawn ctron-verify rc 直通非零即 1)+
        // S4-② attest 腿(E5057)。复放腿挂账批C(见文件头批注);计数恒 0。
        var vbin = bin_dir() + "/ctron-verify"
        if !fs_exists(vbin) {
            return fail2("pkg verify --deep: 缺 ctron-verify(重装工具链;或先: compiler/native.sh)")
        }
        var vdir = abs_dir(dir)
        var argv = List[Str]()
        argv.push(vbin)
        argv.push("run")
        argv.push(vdir)
        let vrc = blob_rc_cwd(argv, "")
        if vrc != 0 {
            return 1
        }
        if is_file_p(vdir + "/attest.ctcl") {
            var att = read_file(vdir + "/attest.ctcl")
            var ad = attest_digest_field(att)
            var atc = attest_count_field(att)
            if ad.len == 0 || atc.len == 0 {
                eprint("ctron pkg verify: attest 畸形(缺 artifact_digest/trace_count;E5057)\n")
                return 1
            }
            var sd2 = meta_self_digest(read_file(vdir + "/meta.ctcl"))
            if ad != sd2 {
                eprint("E5057 attest 与工件不符: artifact_digest 记录 " + ad + " 实际 " + sd2 + "\n")
                return 1
            }
            var tc = traces_trace_count(vdir)
            if atc != tc {
                eprint("E5057 attest 与工件不符: trace_count 记录 " + atc + " 实际 " + tc + "\n")
                return 1
            }
            println("ctron pkg verify OK: " + vdir + "(deep: 摘要自洽;复放 0 用例;attest 过验)")
            return 0
        }
        println("ctron pkg verify OK: " + vdir + "(deep: 摘要自洽;复放 0 用例)")
        return 0
    }
    // ① 形态面(§3.5 后缀即契约:自称 .ctart 而缺成员 = 损坏/伪造,fail-closed)
    var bad: Bool = false
    if !is_file_p(dir + "/meta.ctcl") {
        eprint("ctron pkg verify: 缺 meta.ctcl(fail-closed 拒载)\n")
        bad = true
    }
    if !is_file_p(dir + "/SHA256SUMS") {
        eprint("ctron pkg verify: 缺 SHA256SUMS(fail-closed 拒载)\n")
        bad = true
    }
    if !is_dir_p(dir + "/impl") {
        eprint("ctron pkg verify: 缺 impl/(密封实现目录;fail-closed 拒载)\n")
        bad = true
    }
    if bad {
        return 1
    }
    // ② SHA256SUMS 逐成员重算(read 逐行口径:仅 \n 终结行入账,尾残行弃 = sh
    // while read 同;SHA256SUMS 是不可信输入,行解析/路径越界守卫先行)
    var n: I64 = 0
    var sums = read_file(dir + "/SHA256SUMS")
    var start: I32 = 0
    var p: I32 = 0
    while p < sums.len {
        if byte_at(sums, p) == 10 {
            var line = byte_slice(sums, start, p)
            if line.len > 0 {
                var sep = find_from(line, "  ", 0)
                var hex = ""
                var mpath = ""
                var shapeOk: Bool = false
                if sep >= 0 {
                    hex = byte_slice(line, 0, sep)
                    mpath = byte_slice(line, sep + 2, line.len)
                    if hex64(hex) {
                        shapeOk = true
                    }
                }
                if !shapeOk {
                    eprint("ctron pkg verify: SHA256SUMS 行畸形: " + line + "\n")
                    bad = true
                } else if starts_with(mpath, "/") || contains(mpath, "..") || mpath.len == 0 {
                    eprint("ctron pkg verify: 成员路径越界: " + mpath + "\n")
                    bad = true
                } else if !is_file_p(dir + "/" + mpath) {
                    eprint("ctron pkg verify: 成员缺失: " + mpath + "\n")
                    bad = true
                } else {
                    var act = sha256_hex(read_file(dir + "/" + mpath))
                    if act != hex {
                        eprint("ctron pkg verify: 成员摘要不符: " + mpath + " 记录 " + hex + " 实际 " + act + "\n")
                        bad = true
                    }
                    n += 1
                }
            }
            start = p + 1
        }
        p += 1
    }
    // ③ self_digest 重算 = sha256(SHA256SUMS 字节)(D8-2 冻结定义;与成员腿
    // 相互独立——②败仍照算,消息序 = sh 同)
    var sd = meta_self_digest(read_file(dir + "/meta.ctcl"))
    var sum = sha256_hex(sums)
    if sd.len == 0 {
        eprint("ctron pkg verify: meta 缺 self_digest(fail-closed;工件须经 ctc.sh ast --ast=seal 摘要步骤)\n")
        bad = true
    } else if sd != "sha256:" + sum {
        eprint("ctron pkg verify: self_digest 不符: 记录 " + sd + " 实际 sha256:" + sum + "\n")
        bad = true
    }
    // ④ 判决(shell 轻面 = 摘要四段;复放腿在 --deep 路径)
    if !bad {
        println("ctron pkg verify OK: " + dir + "(" + n.to_string() + " 成员,self_digest sha256:" + sum + ")")
        return 0
    }
    return 1
}

fn cmd_pkg_attest(rest: List[Str]) -> I32 {
    // sh cmd_pkg_attest(:803-830):meta 读 artifact/self_digest(行扫)+ traces
    // 计数 + VERSION 读(dev 缺省)+ printf 同文写 attest.ctcl + echo 行
    if rest.len < 1 {
        return fail2("pkg attest 需要工件目录(.ctart;须先 seal)")
    }
    var dir = rest[0]
    if !is_dir_p(dir) {
        return fail2("pkg attest: 工件目录不存在: " + dir)
    }
    if !is_file_p(dir + "/meta.ctcl") {
        return fail2("pkg attest: 缺 meta.ctcl(工件须先 seal)")
    }
    var meta = read_file(dir + "/meta.ctcl")
    var name = meta_artifact_name(meta)
    if name.len == 0 {
        return fail2("pkg attest: meta artifact 块缺失")
    }
    var sd = meta_self_digest(meta)
    if sd.len == 0 {
        return fail2("pkg attest: meta 缺 self_digest(工件须先 seal 摘要步骤)")
    }
    var tc = traces_trace_count(dir)
    var ver = "dev"
    var vp = repo_root() + "/VERSION"
    if fs_exists(vp) {
        ver = cat_stripped(vp)
    }
    fs_write(dir + "/attest.ctcl", "attest \"" + name + "\" \{\n  artifact_digest = \"" + sd + "\"\n  toolchain = \"" + ver + "\"\n  hosts = [\"interp-cc\"]\n  trace_count = " + tc + "\n}\n")
    println("ctron: attest 已生成 → " + dir + "/attest.ctcl(摘要 " + sd + ";轨迹 " + tc + " 例)")
    return 0
}

fn find_in_path(prog: Str) -> Str {
    // execvp PATH 语义(裸名解析):PATH 按 ':' 分段逐段 dir + "/" + prog 常规
    // 文件在即命中返(不查执行位,与 execvp 试 exec 全量同效于正常环境);空段
    // = "."(POSIX);全落空返裸名原样(execv 照旧失败 = 上游 rc 127 同形)。
    // 用途:proc.run_argv 捕获形 C 垫片 execv 无 PATH 查找(pkg log append 的
    // git rev-parse --short HEAD 读面)——裸 "git" 直入 execv = 子进程 127,
    // 捕获空 = "(commit )" 空哈希行(对拍抓活);init/add/commit 腿走
    // run_argv_rc → proc_exec_core execvp 无此患,仅捕获腿需解析。
    var path = env_get("PATH")
    var start: I32 = 0
    var i: I32 = 0
    while i <= path.len {
        var isEnd: Bool = i == path.len
        if isEnd || byte_at(path, i) == 58 {
            var seg = byte_slice(path, start, i)
            if seg.len == 0 {
                seg = "."
            }
            var cand = seg + "/" + prog
            if is_file_p(cand) {
                return cand
            }
            start = i + 1
        }
        if isEnd {
            break
        }
        i += 1
    }
    return prog
}

fn cmd_pkg_log(rest: List[Str]) -> I32 {
    // sh cmd_pkg_log(:832-897):append-only git 仓(records/<名>/<digest>/attest
    // 内容寻址不可变)+ query 列名/名腿。git 委派 run_argv_rc(身份 -c 逐字;
    // add 静音面不模拟,见文件头批注)
    if rest.len < 1 {
        return fail2("pkg log 需要子命令(用法: pkg log append <日志仓> <工件目录> / pkg log query <日志仓> [名])")
    }
    var sub = rest[0]
    if sub == "append" {
        if rest.len < 3 {
            return fail2("pkg log append 需要 <日志仓> <工件目录>")
        }
        var lg = rest[1]
        var art = rest[2]
        if !is_dir_p(art) {
            return fail2("pkg log append: 工件目录不存在: " + art)
        }
        if !is_file_p(art + "/meta.ctcl") {
            return fail2("pkg log append: 缺 meta.ctcl(工件须先 seal)")
        }
        if !is_file_p(art + "/attest.ctcl") {
            return fail2("pkg log append: 缺 attest.ctcl(工件须先 pkg attest;日志只存证据)")
        }
        var meta = read_file(art + "/meta.ctcl")
        var name = meta_artifact_name(meta)
        var sd = meta_self_digest(meta)
        if name.len == 0 || sd.len == 0 {
            return fail2("pkg log append: meta artifact/self_digest 缺失")
        }
        fs_mkdir(lg)
        if !is_dir_p(lg + "/.git") {
            var ia = List[Str]()
            ia.push("git")
            ia.push("init")
            ia.push("-q")
            if blob_rc_cwd(ia, lg) != 0 {
                return fail2("pkg log append: git init 失败(" + lg + ")")
            }
        }
        var dst = lg + "/records/" + name + "/" + sd
        if is_file_p(dst + "/attest.ctcl") {
            if read_file(art + "/attest.ctcl") == read_file(dst + "/attest.ctcl") {
                println("ctron: 日志记录已存在(幂等): records/" + name + "/" + sd)
                return 0
            }
            return fail2("pkg log append: 记录已存在且内容不同(append-only;同 digest 不得翻改公证): records/" + name + "/" + sd)
        }
        fs_mkdir(dst)
        fs_write(dst + "/attest.ctcl", read_file(art + "/attest.ctcl"))
        var aa = List[Str]()
        aa.push("git")
        aa.push("add")
        aa.push("records")
        blob_rc_cwd(aa, lg)
        var ca = List[Str]()
        ca.push("git")
        ca.push("-c")
        ca.push("user.name=ctron-log")
        ca.push("-c")
        ca.push("user.email=ctron@local")
        ca.push("commit")
        ca.push("-q")
        ca.push("-m")
        ca.push("log: " + name + " @ " + sd)
        if blob_rc_cwd(ca, lg) != 0 {
            return fail2("pkg log append: git commit 失败")
        }
        var ha = List[Str]()
        ha.push(find_in_path("git"))
        ha.push("rev-parse")
        ha.push("--short")
        ha.push("HEAD")
        var buf: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
        var hb: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
        var shrt = ""
        let hn = argv_to_blob(ha, hb)
        if hn >= 0 {
            if run_argv(lg, hb, hn.as[I64](), buf) == 0 {
                shrt = capture_trimmed(buf)
            }
        }
        println("ctron: 日志已记 → records/" + name + "/" + sd + "(commit " + shrt + ")")
        return 0
    }
    if sub == "query" {
        if rest.len < 2 {
            return fail2("pkg log query 需要 <日志仓>[ 名]")
        }
        var lg = rest[1]
        var qname = ""
        if rest.len >= 3 {
            qname = rest[2]
        }
        if !is_dir_p(lg + "/records") {
            eprint("ctron: 日志仓无记录(" + lg + "/records 缺席)\n")
            return 1
        }
        if qname.len > 0 {
            var d = lg + "/records/" + qname
            if !is_dir_p(d) {
                eprint("ctron: 日志无 " + qname + " 的记录\n")
                return 1
            }
            var ds = list(d)
            var di: I32 = 0
            while di < ds.len {
                var d2 = d + "/" + ds[di]
                if is_dir_p(d2) && is_file_p(d2 + "/attest.ctcl") {
                    println("record: " + qname + " @ " + ds[di])
                    // grep -E "toolchain|trace_count" | sed 's/^/  /':行含任一子串
                    // 即印(grep 与 read 异:尾残行亦入列,恒补行)
                    var att = read_file(d2 + "/attest.ctcl")
                    var start: I32 = 0
                    var pp: I32 = 0
                    while pp <= att.len {
                        var isEnd: Bool = pp == att.len
                        if isEnd || byte_at(att, pp) == 10 {
                            var ln = byte_slice(att, start, pp)
                            if contains(ln, "toolchain") || contains(ln, "trace_count") {
                                print("  " + ln + "\n")
                            }
                            start = pp + 1
                        }
                        if isEnd {
                            break
                        }
                        pp += 1
                    }
                }
                di += 1
            }
            return 0
        }
        var ns = list(lg + "/records")
        var ni: I32 = 0
        while ni < ns.len {
            if is_dir_p(lg + "/records/" + ns[ni]) {
                println("name: " + ns[ni])
            }
            ni += 1
        }
        return 0
    }
    return fail2("pkg log: 未知子命令 '" + sub + "'(现支持: append query)")
}

fn cmd_pkg_seal(rest: List[Str]) -> I32 {
    // sh cmd_pkg_seal(:899-949):--out/--name 双形解析 + main 守卫 + ctron-ast
    // env 通道(CTRON_AST_MODE/OUT/NAME spawn 前置、后还原 = sh 每命令前缀env
    // 语义)+ traces 拾取(cp -r)+ SHA256SUMS(两域 find 合流整串 sort + 逐
    // 成员摘要)+ self_digest 注入(awk 首个 "}" 行前插 → 字节扫重写)
    // sh :900 无参守卫先行(用法行随 die2;解析前拦,与余参静默弃两分)
    if rest.len < 1 {
        return fail2("pkg seal 需要源文件(用法: pkg seal <src.ct> [--out <目录>] [--name <工件名>])")
    }
    var src = ""
    var out = ""
    var name = ""
    var prev: I32 = 0
    var i: I32 = 0
    while i < rest.len {
        var a = rest[i]
        if prev == 1 {
            out = a
            prev = 0
        } else if prev == 2 {
            name = a
            prev = 0
        } else if a == "--out" {
            prev = 1
        } else if starts_with(a, "--out=") {
            out = byte_slice(a, 6, a.len)
        } else if a == "--name" {
            prev = 2
        } else if starts_with(a, "--name=") {
            name = byte_slice(a, 7, a.len)
        } else {
            if src.len == 0 {
                src = a
            }
        }
        i += 1
    }
    if src.len == 0 {
        return fail2("pkg seal 需要源文件")
    }
    if !is_file_p(src) {
        return fail2("pkg seal: 源文件不存在: " + src)
    }
    if contains(read_file(src), "fn main") {
        return fail2("pkg seal: 源含 main(provider 模块面)")
    }
    var astbin = bin_dir() + "/ctron-ast"
    if !fs_exists(astbin) {
        return fail2("pkg seal: 缺 ctron-ast(重装工具链;或先: compiler/native.sh)")
    }
    var srcdir = abs_dir(dir_of(src))
    var base = stem_of(src)
    if name.len == 0 {
        name = base
    }
    if out.len == 0 {
        out = srcdir + "/" + name + ".ctart"
    }
    fs_mkdir(out + "/impl")
    // env 通道:set+restore(sh `VAR=x cmd` 前缀 = 仅本命令可见;W3 env_set =
    // 本进程 setenv,子 execve 继承,spawn 后还原前置值)
    var m0 = env_get("CTRON_AST_MODE")
    var o0 = env_get("CTRON_AST_OUT")
    var n0 = env_get("CTRON_AST_NAME")
    env_set("CTRON_AST_MODE", "seal")
    env_set("CTRON_AST_OUT", out)
    env_set("CTRON_AST_NAME", name)
    var sa = List[Str]()
    sa.push(astbin)
    sa.push("run")
    sa.push(src)
    let rc = blob_rc_cwd(sa, "")
    env_set("CTRON_AST_MODE", m0)
    env_set("CTRON_AST_OUT", o0)
    env_set("CTRON_AST_NAME", n0)
    if rc != 0 {
        return 1
    }
    if is_dir_p(srcdir + "/traces") {
        if !fs_exists(out + "/traces") {
            cp_r(srcdir + "/traces", out + "/traces")
        }
    }
    // SHA256SUMS:find impl(+traces 在场)文件相对路 → 整串 LC_ALL=C sort →
    // `<摘要>  <路>` 逐行(rm -f 不模拟:fs_write 截断重建同位)
    var rels = seal_files(out, "impl")
    var tr = seal_files(out, "traces")
    var ti: I32 = 0
    while ti < tr.len {
        rels.push(tr[ti])
        ti += 1
    }
    sort_strs(rels)
    var sums = ""
    var si: I32 = 0
    while si < rels.len {
        sums = sums + sha256_hex(read_file(out + "/" + rels[si])) + "  " + rels[si] + "\n"
        si += 1
    }
    fs_write(out + "/SHA256SUMS", sums)
    var sd = sha256_hex(sums)
    // self_digest 注入:首个恰为 "}" 的行前插一行(awk ins==0 同位——meta 为
    // CTCL 块串,首个 "}" 即 artifact 块闭;字节扫重写,行尾恒补 \n = awk print)
    var meta = read_file(out + "/meta.ctcl")
    var ins = "  self_digest = \"sha256:" + sd + "\"\n"
    var rebuilt = ""
    var start: I32 = 0
    var pp: I32 = 0
    var done: Bool = false
    while pp <= meta.len {
        var isEnd: Bool = pp == meta.len
        if isEnd || byte_at(meta, pp) == 10 {
            var ln = byte_slice(meta, start, pp)
            if !done {
                if ln == "}" {
                    rebuilt = rebuilt + ins
                    done = true
                }
            }
            // awk print 语义:记录终结于 \n——文件以 \n 收尾不生残记录(空尾
            // 段不印,否则 meta.ctcl 多一行尾空行,对拍树 diff 抓活);非 isEnd
            // 的空行(内空行)与无尾 \n 的残记录照印(print 恒补 \n)
            if !(isEnd && ln.len == 0) {
                rebuilt = rebuilt + ln + "\n"
            }
            start = pp + 1
        }
        if isEnd {
            break
        }
        pp += 1
    }
    fs_write(out + "/meta.ctcl", rebuilt)
    println("ctron: 已封印 " + out + "(模块 " + base + ";self_digest sha256:" + sd + ")")
    return 0
}

// ---- pkg trace record/replay(W4 波3 批3;sh cmd_pkg_trace :510-773 逐字镜像)----
// 黄金轨迹(编排层码gen;宿主 ctron-cc run 捕获):α 纯函数值 = to_string 规范形;
// γ 效果函数 --fs 种子挂最近 --case,args 位写 MemFs 变量名。轨迹块 = trace 行制
// (fn/args/expect + fs 种子对 + wrote 面)。
// 转义层谱(码gen 陷阱面,三层各有口径):
//   L0 本文件串字面量 → " 需 \",\ 需 \\,{ 需 \{(} 裸写,\} 非法 E1001);
//   L1 生成 drv.ct 内的字面量 → 种子内容/args 经 trace_esc_q("→\")(= sh
//      sed 's/"/\\"/g');写积累串里的 "\n" 两字符 → L0 写作 \\n;
//   L2 .ctrt 行文本 → args 经 esc_q 落盘,replay 侧 trace_unesc_q(= sed
//      's/\\"/"/g');expect/wrote 原样落盘原样读(sh 口径,不转义)。
// 已知病理(如实镜像 sh,不修):fs 种子内容含 " 时 replay 只再做一次加转义
// (L1 双重转义 → 生成串编译败 → 运行失败 rc2 路径);expect 含 " 时块格式
// 破形(awk 解析口径分叉)——语料避开,登记在案。

fn trace_fn_ok(s: Str) -> Bool {
    // case $TR_FN in ""|*[!A-Za-z0-9_]*|[0-9]*) 同判 = [A-Za-z_][A-Za-z0-9_]*
    if s.len == 0 {
        return false
    }
    var c = byte_at(s, 0)
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
        return false
    }
    var i: I32 = 1
    while i < s.len {
        c = byte_at(s, i)
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) {
            return false
        }
        i += 1
    }
    return true
}

fn trace_esc_q(s: Str) -> Str {
    // sed 's/"/\\"/g':双引号前插反斜杠(byte_slice 攒形保多字节序, capture 同款)
    var r = ""
    var run: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == 34 {
            r = r + byte_slice(s, run, i) + "\\\""
            run = i + 1
        }
        i += 1
    }
    return r + byte_slice(s, run, s.len)
}

fn trace_unesc_q(s: Str) -> Str {
    // sed 's/\\"/"/g':反斜杠+双引号对 → 双引号(孤立反斜杠不动)
    var r = ""
    var run: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == 92 {
            if i + 1 < s.len {
                if byte_at(s, i + 1) == 34 {
                    r = r + byte_slice(s, run, i) + "\""
                    i += 1
                    run = i + 1
                }
            }
        }
        i += 1
    }
    return r + byte_slice(s, run, s.len)
}

fn trace_first_line(s: Str) -> Str {
    // $(printf '%s\n' "$TR_OUT" | sed -n '1p'):首行(空串 → 空;无 \n = 全串)
    if s.len == 0 {
        return ""
    }
    var nl = find_from(s, "\n", 0)
    if nl < 0 {
        return s
    }
    return byte_slice(s, 0, nl)
}

fn trace_atoi(s: Str) -> I32 {
    // 自产 NF/NW 计数字串还原(非数字即止 = 0;sh read 脏值病理面不合作口径)
    var v: I32 = 0
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if c < 48 || c > 57 {
            return v
        }
        v = v * 10 + (c - 48)
        i += 1
    }
    return v
}

fn trace_capture_out(var buf: U8[]) -> Str {
    // $(ctron-cc run ...) 语义:捕获全量(UTF-8 保真)+ 尾 \n 全剥
    var s = capture_str(buf)
    while s.len > 0 {
        if byte_at(s, s.len - 1) == 10 {
            s = byte_slice(s, 0, s.len - 1)
        } else {
            break
        }
    }
    return s
}

fn trace_wrote_lines(out: Str) -> List[Str] {
    // sed -n '/^---writes---$/,$p' | sed '1d' | grep -v '^$':首个 ---writes---
    // 行后的非空行(grep -v 空行滤,写积累为空的病理面同判)
    var ls = List[Str]()
    var inW: Bool = false
    var start: I32 = 0
    var p: I32 = 0
    while p <= out.len {
        var isEnd: Bool = p == out.len
        if isEnd || byte_at(out, p) == 10 {
            var ln = byte_slice(out, start, p)
            if inW {
                if ln.len > 0 {
                    ls.push(ln)
                }
            } else {
                if ln == "---writes---" {
                    inW = true
                }
            }
            start = p + 1
            if isEnd {
                break
            }
        }
        p += 1
    }
    return ls
}

fn trace_flush(cases: List[Str], cfn: Str, cargs: Str, pairs: List[Str]) {
    // sh TR_FLUSH 同构:落一条用例(fn/args/NF 三行头 + NF 对 path/content;
    // manifest 行制语义的内存同构,NF 由对数自算)
    if cfn.len == 0 {
        return
    }
    cases.push(cfn)
    cases.push(cargs)
    cases.push((pairs.len / 2).to_string())
    var z: I32 = 0
    while z < pairs.len {
        cases.push(pairs[z])
        z += 1
    }
}

fn trace_build_drv(src: Str, tfn: Str, targs: Str, pairs: List[Str]) -> Str {
    // 码gen 核(record/replay 双臂同构;sh 两个 printf 块逐字节):NF≥1 =
    // esc 头 + 源 + WSB/MemFs 合成(字段声明/读分支链回 Ok(bN.to_string())/
    // 写积累 esc(path)+" "+esc(data)+"\n" 经 Box 入 log/exists 链)+ main
    // match(Ok → println(v.to_string()),Err → <err>)+ ---writes--- 面;
    // NF=0 = 纯值 main。L1 层转义只在种子内容(esc_q);args 原样内插。
    var np: I32 = pairs.len / 2
    var d = ""
    if np >= 1 {
        d = "use std.json.\{ esc }\n"
    }
    d = d + src
    if np >= 1 {
        var fields = ""
        var reads = ""
        var exch = ""
        var init = ""
        var i: I32 = 0
        while i < np {
            var fp = pairs[i * 2]
            var fc = trace_esc_q(pairs[i * 2 + 1])
            fields = fields + "    let f" + i.to_string() + ": Str\n    let b" + i.to_string() + ": Str\n"
            reads = reads + "        if path == self.f" + i.to_string() + " \{\n            return Ok(self.b" + i.to_string() + ".to_string())\n        }\n"
            exch = exch + "        if path == self.f" + i.to_string() + " \{\n            return true\n        }\n"
            init = init + " f" + i.to_string() + ": \"" + fp + "\", b" + i.to_string() + ": \"" + fc + "\","
            i += 1
        }
        d = d + "\nclass WSB \{\n    let s: Str\n}\n\n"
        d = d + "class MemFs \{\n" + fields + "    let log: Box[WSB]\n}\n\n"
        d = d + "impl Fs for MemFs \{\n    fn read_to_string(&self, path: Str) -> Result[String, FsError] \{\n" + reads + "        return Err(FsError \{ message: \"not found\".to_string() })\n    }\n"
        d = d + "    fn write(&self, path: Str, data: Str) -> Result[Void, FsError] \{\n        let inner = self.log\n        inner.s = inner.s + esc(path) + \" \" + esc(data) + \"\\n\"\n        return Ok(void)\n    }\n"
        d = d + "    fn exists(&self, path: Str) -> Bool \{\n" + exch + "        return false\n    }\n}\n\n"
        d = d + "fn main() \{\n    let wsb = WSB \{ s: \"\" }\n    let fs = MemFs \{ " + init + " log: Box[WSB](wsb) }\n    match " + tfn + "(" + targs + ") \{\n        Ok(v) => println(v.to_string())\n        Err(_) => println(\"<err>\")\n    }\n    println(\"---writes---\")\n    print(fs.log.s)\n}\n"
    } else {
        d = d + "\nfn main() \{\n    println(" + tfn + "(" + targs + ").to_string())\n}\n"
    }
    return d
}

fn trace_drv_dir() -> Str {
    // sh mktemp -d /tmp/ctron_tr.XXXXXX 同位:固定名 + 用前净除(登记偏差:
    // 并发 trace 同名互踩;have_cc_probe 固定名先例同账)
    return "/tmp/ctron_tr_drv"
}

fn trace_run_drv(drv: Str, var buf: U8[]) -> I32 {
    // 写 drv.ct + CTRON_STDPATH 注入(sh 单命令前缀作用域 = 本进程 setenv,
    // 一次性命令进程面同构)+ ctron-cc run stdout 捕获。stderr 直通非合流 =
    // sh 2>&1 的登记偏差(编译诊断 stdout 恒空 → 合并序不可辨,字节同)。
    var d = trace_drv_dir()
    delete_tree(d)
    fs_mkdir(d)
    fs_write(d + "/drv.ct", drv)
    env_set("CTRON_STDPATH", repo_root() + "/lib/std")
    var argv = List[Str]()
    argv.push(bin_dir() + "/ctron-cc")
    argv.push("run")
    argv.push(d + "/drv.ct")
    var blob: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
    let bn = argv_to_blob(argv, blob)
    if bn < 0 {
        return 127
    }
    return run_argv("", blob, bn.as[I64](), buf)
}

fn trace_parse_ctrt(text: Str) -> List[Str] {
    // sh replay awk 块提取逐字(trace "/^  fs /等行前缀 + ^}$ 出块):出块序 =
    // fn,args,nf,种子对(path/content 交错),expect,nw,wlines。awk sub 单次
    // 替换/尾引号剥除序(先 " = " 换制表符再剥尾 ")与 split 取 pa[1]/pa[2]
    // (第三段起弃)同口径。
    var out = List[Str]()
    var cfn = ""
    var cargs = ""
    var cexp = ""
    var nfs: I32 = 0
    var nws: I32 = 0
    var pairs = List[Str]()
    var wls = List[Str]()
    var start: I32 = 0
    var p: I32 = 0
    while p <= text.len {
        var isEnd: Bool = p == text.len
        if isEnd || byte_at(text, p) == 10 {
            var ln = byte_slice(text, start, p)
            if starts_with(ln, "trace \"") {
                var l = byte_slice(ln, 7, ln.len)
                if ends_with(l, "\" \{") {
                    l = byte_slice(l, 0, l.len - 3)
                }
                cfn = l
                cargs = ""
                cexp = ""
                nfs = 0
                nws = 0
                pairs = List[Str]()
                wls = List[Str]()
            } else if starts_with(ln, "  fs ") {
                var q = ln
                if starts_with(q, "  fs \"") {
                    q = byte_slice(q, 6, q.len)
                }
                var tab = find_from(q, "\" = \"", 0)
                var joined = q
                if tab >= 0 {
                    joined = byte_slice(q, 0, tab) + "\t" + byte_slice(q, tab + 5, q.len)
                }
                if ends_with(joined, "\"") {
                    joined = byte_slice(joined, 0, joined.len - 1)
                }
                var t1 = find_from(joined, "\t", 0)
                var path = joined
                var content = ""
                if t1 >= 0 {
                    var t2 = find_from(joined, "\t", t1 + 1)
                    if t2 < 0 {
                        t2 = joined.len
                    }
                    path = byte_slice(joined, 0, t1)
                    content = byte_slice(joined, t1 + 1, t2)
                }
                pairs.push(path)
                pairs.push(content)
                nfs += 1
            } else if starts_with(ln, "  args = ") {
                var a = ln
                if starts_with(a, "  args = \"") {
                    a = byte_slice(a, 10, a.len)
                }
                if ends_with(a, "\"") {
                    a = byte_slice(a, 0, a.len - 1)
                }
                cargs = a
            } else if starts_with(ln, "  expect = ") {
                var x = ln
                if starts_with(x, "  expect = \"") {
                    x = byte_slice(x, 12, x.len)
                }
                if ends_with(x, "\"") {
                    x = byte_slice(x, 0, x.len - 1)
                }
                cexp = x
            } else if starts_with(ln, "  wrote ") {
                wls.push(byte_slice(ln, 8, ln.len))
                nws += 1
            } else if ln == "}" {
                out.push(cfn)
                out.push(cargs)
                out.push(nfs.to_string())
                var z: I32 = 0
                while z < pairs.len {
                    out.push(pairs[z])
                    z += 1
                }
                out.push(cexp)
                out.push(nws.to_string())
                z = 0
                while z < wls.len {
                    out.push(wls[z])
                    z += 1
                }
            }
            start = p + 1
            if isEnd {
                break
            }
        }
        p += 1
    }
    return out
}

fn cmd_pkg_trace(rest: List[Str]) -> I32 {
    // sh cmd_pkg_trace(:510-773):子命令/工具链守卫 → --case/--fs 参数循环
    // (--case flush 前例;--fs 种子挂最近例;fn 名白名单)→ 源守卫(缺参/
    // 缺席/含 main 拒)→ record:逐例码gen + ctron-cc run 捕获(单值守卫/
    // 运行失败拒)+ 轨迹块追加;replay:块解析 → 同构重建 → 逐字比对
    // (mismatch 判词:NF≥1 首行 + 全文两段,NF=0 单段全嵌)。
    if rest.len < 1 {
        return fail2("pkg trace 需要子命令(用法: pkg trace record <src.ct> --case <fn>=<args> [--fs <path>=<content>]... / pkg trace replay <src.ct>)")
    }
    var sub = rest[0]
    if sub != "record" && sub != "replay" {
        return fail2("pkg trace: 未知子命令 '" + sub + "'(现支持: record replay)")
    }
    if !fs_exists(bin_dir() + "/ctron-cc") {
        return fail2("pkg trace: 缺 ctron-cc(重装工具链;或先: compiler/native.sh)")
    }
    var cases = List[Str]()
    var cfn = ""
    var cargs = ""
    var cfss = List[Str]()
    var src = ""
    var prev: I32 = 0
    var i: I32 = 1
    while i < rest.len {
        var a = rest[i]
        if prev == 1 {
            var cut = find_from(a, "=", 0)
            if cut < 0 {
                cfn = a
                cargs = a
            } else {
                cfn = byte_slice(a, 0, cut)
                cargs = byte_slice(a, cut + 1, a.len)
            }
            if !trace_fn_ok(cfn) {
                return fail2("pkg trace record: fn 名非法: '" + cfn + "'([A-Za-z_][A-Za-z0-9_]*)")
            }
            prev = 0
            i += 1
            continue
        }
        if prev == 2 {
            if cfn.len == 0 {
                return fail2("pkg trace: --fs 须跟在 --case 之后(种子挂最近用例)")
            }
            var cut2 = find_from(a, "=", 0)
            if cut2 < 0 {
                cfss.push(a)
                cfss.push(a)
            } else {
                cfss.push(byte_slice(a, 0, cut2))
                cfss.push(byte_slice(a, cut2 + 1, a.len))
            }
            prev = 0
            i += 1
            continue
        }
        if a == "--case" {
            trace_flush(cases, cfn, cargs, cfss)
            cfn = ""
            cargs = ""
            cfss = List[Str]()
            prev = 1
        } else if a == "--fs" {
            prev = 2
        } else if starts_with(a, "--case=") {
            trace_flush(cases, cfn, cargs, cfss)
            cfn = ""
            cargs = ""
            cfss = List[Str]()
            var v = byte_slice(a, 7, a.len)
            var cut3 = find_from(v, "=", 0)
            if cut3 < 0 {
                cfn = v
                cargs = v
            } else {
                cfn = byte_slice(v, 0, cut3)
                cargs = byte_slice(v, cut3 + 1, v.len)
            }
            if !trace_fn_ok(cfn) {
                return fail2("pkg trace record: fn 名非法: '" + cfn + "'([A-Za-z_][A-Za-z0-9_]*)")
            }
        } else if starts_with(a, "--fs=") {
            if cfn.len == 0 {
                return fail2("pkg trace: --fs 须跟在 --case 之后(种子挂最近用例)")
            }
            var v2 = byte_slice(a, 5, a.len)
            var cut4 = find_from(v2, "=", 0)
            if cut4 < 0 {
                cfss.push(v2)
                cfss.push(v2)
            } else {
                cfss.push(byte_slice(v2, 0, cut4))
                cfss.push(byte_slice(v2, cut4 + 1, v2.len))
            }
        } else {
            if src.len == 0 {
                src = a
            }
        }
        i += 1
    }
    if prev != 0 {
        return fail2("pkg trace: --case/--fs 缺值")
    }
    if src.len == 0 {
        return fail2("pkg trace " + sub + " 需要源文件")
    }
    if !is_file_p(src) {
        return fail2("pkg trace: 源文件不存在: " + src)
    }
    var srctext = read_file(src)
    if find_from(srctext, "fn main", 0) >= 0 {
        return fail2("pkg trace: 源含 main(轨迹面向无 main 的 provider 源)")
    }
    var tdir = abs_dir(dir_of(src))
    var tstem = stem_of(src)
    var ttgt = tdir + "/traces/" + tstem + ".ctrt"
    if sub == "record" {
        trace_flush(cases, cfn, cargs, cfss)
        if cases.len == 0 {
            return fail2("pkg trace record 需要 --case <fn>=<args>(可多例;--fs 种子挂最近 --case)")
        }
        // mkdir -p + 截断(sh mkdir -p / : > 同位;父目录恒在)
        if !is_dir_p(tdir + "/traces") {
            fs_mkdir(tdir + "/traces")
        }
        fs_write(ttgt, "")
        var acc = ""
        var buf: U8[262144] = [0, 0, 0, 0, 0, 0, 0, 0]
        var n: I32 = 0
        var ci: I32 = 0
        while ci < cases.len {
            var tfn = cases[ci]
            var targs = cases[ci + 1]
            var nf = trace_atoi(cases[ci + 2])
            var pairs = List[Str]()
            var z: I32 = 0
            while z < nf * 2 {
                pairs.push(cases[ci + 3 + z])
                z += 1
            }
            ci += 3 + nf * 2
            var drv = trace_build_drv(srctext, tfn, targs, pairs)
            capture_zero(buf)
            let rc = trace_run_drv(drv, buf)
            var out = trace_capture_out(buf)
            if rc != 0 {
                eprint(out + "\n")
                delete_tree(trace_drv_dir())
                return fail2("pkg trace record: 用例 " + tfn + "(" + targs + ") 运行失败(rc=" + rc.to_string() + ")")
            }
            if nf == 0 {
                if find_from(out, "\n", 0) >= 0 {
                    delete_tree(trace_drv_dir())
                    return fail2("pkg trace record: 用例 " + tfn + "(" + targs + ") 输出多行(纯函数轨迹面向单值)")
                }
            }
            // 轨迹块写(批3 评审 Important×2 登记处;裁决 = 登记 不镜像,native 正确侧):
            // ① sh fs 泄漏 quirk 不镜像——sh TR_FSLINES 仅 NF≥1 分支重置而块写出口
            //    无条件非空即印,NF≥1→NF=0 混序泄前例 fs 行入后块(sh replay 随之误
            //    解析);本侧 pairs 每例现造零陈旧态,纯块恒无 fs 行。
            // ② 多行 --fs 内容:sh 行制 manifest 首行静默截断成坏轨迹(rc0);本侧
            //    全量入码 gen → E1001 响亮拒(record rc2 运行失败)。
            var blk = "trace \"" + tfn + "\" \{\n"
            var pi: I32 = 0
            while pi < pairs.len {
                blk = blk + "  fs \"" + pairs[pi] + "\" = \"" + trace_esc_q(pairs[pi + 1]) + "\"\n"
                pi += 2
            }
            blk = blk + "  args = \"" + trace_esc_q(targs) + "\"\n  expect = \"" + trace_first_line(out) + "\"\n"
            if nf >= 1 {
                var wls = trace_wrote_lines(out)
                var wi: I32 = 0
                while wi < wls.len {
                    blk = blk + "  wrote " + wls[wi] + "\n"
                    wi += 1
                }
            }
            blk = blk + "}\n"
            acc = acc + blk
            fs_write(ttgt, acc)
            delete_tree(trace_drv_dir())
            n += 1
        }
        println("ctron: 轨迹已录制 " + n.to_string() + " 用例 → " + ttgt)
        return 0
    }
    // replay(sh :704-773):轨迹块解析 → 同构重建 → 逐字比对
    if !is_file_p(ttgt) {
        return fail2("pkg trace replay: 无轨迹文件: " + ttgt)
    }
    var blocks = trace_parse_ctrt(read_file(ttgt))
    if blocks.len == 0 {
        return fail2("pkg trace replay: 轨迹文件无块: " + ttgt)
    }
    var buf: U8[262144] = [0, 0, 0, 0, 0, 0, 0, 0]
    var n: I32 = 0
    var bad: I32 = 0
    var bi: I32 = 0
    while bi < blocks.len {
        var tfn = blocks[bi]
        var targsU = trace_unesc_q(blocks[bi + 1])
        var nf = trace_atoi(blocks[bi + 2])
        var pairs = List[Str]()
        var z: I32 = 0
        while z < nf * 2 {
            pairs.push(blocks[bi + 3 + z])
            z += 1
        }
        bi += 3 + nf * 2
        var exp = trace_unesc_q(blocks[bi])
        bi += 1
        var nw = trace_atoi(blocks[bi])
        bi += 1
        var wls = List[Str]()
        z = 0
        while z < nw {
            wls.push(blocks[bi + z])
            z += 1
        }
        bi += nw
        var drv = trace_build_drv(srctext, tfn, targsU, pairs)
        capture_zero(buf)
        let rc = trace_run_drv(drv, buf)
        var out = trace_capture_out(buf)
        if rc != 0 {
            eprint(out + "\n")
            delete_tree(trace_drv_dir())
            return fail2("pkg trace replay: 用例 " + tfn + "(" + targsU + ") 运行失败(rc=" + rc.to_string() + ")")
        }
        if nf >= 1 {
            // sh TR_CANON 同构:expect + ---writes--- + wrote 面(%? 剥尾换行)
            var canon = exp + "\n---writes---"
            if wls.len > 0 {
                var wj = ""
                var k: I32 = 0
                while k < wls.len {
                    wj = wj + wls[k] + "\n"
                    k += 1
                }
                canon = canon + "\n" + byte_slice(wj, 0, wj.len - 1)
            }
            if out != canon {
                eprint("trace mismatch: " + tfn + "(" + targsU + ") 记录 " + exp + " 实际 " + trace_first_line(out) + "(含 wrote 面,全文见上)\n")
                eprint(out + "\n")
                bad += 1
            }
        } else {
            if out != exp {
                eprint("trace mismatch: " + tfn + "(" + targsU + ") 记录 " + exp + " 实际 " + out + "\n")
                bad += 1
            }
        }
        delete_tree(trace_drv_dir())
        n += 1
    }
    if bad > 0 {
        eprint("pkg trace replay: " + n.to_string() + " 用例中 " + bad.to_string() + " 不符\n")
        return 1
    }
    println("trace replay OK: " + n.to_string() + " 用例")
    return 0
}

fn main() -> I32 {
    var n: I64 = ctron_prog_args_n()
    // 无参 = 整版 usage + rc 2(sh:[ $# -lt 1 ])
    if n == 0 {
        usage()
        return 2
    }
    var cmd = ctron_prog_args_at(0)
    // <cmd> --help|-h 拦截(sh :1124-1128,先于分派臂)
    if n >= 2 {
        if is_known16(cmd) {
            var sub = ctron_prog_args_at(1)
            if sub == "--help" {
                return help_cmd(cmd)
            }
            if sub == "-h" {
                return help_cmd(cmd)
            }
        }
    }
    // --help|-h|help:带参 → help_cmd(未知名也落 usage 臂),无参 → 整版 usage;rc 0
    if cmd == "--help" {
        if n >= 2 {
            return help_cmd(ctron_prog_args_at(1))
        }
        usage()
        return 0
    }
    if cmd == "-h" {
        if n >= 2 {
            return help_cmd(ctron_prog_args_at(1))
        }
        usage()
        return 0
    }
    if cmd == "help" {
        if n >= 2 {
            return help_cmd(ctron_prog_args_at(1))
        }
        usage()
        return 0
    }
    // --version|-V:VERSION 语义面(见 version_line)
    if cmd == "--version" {
        println(version_line())
        return 0
    }
    if cmd == "-V" {
        println(version_line())
        return 0
    }
    // 委派族(波1 批2,镜像 sh :1133-1150/:1162-1165):缺参 rc2 逐字 → 组 argv →
    // 直 exec 兄弟件 → rc 直通。stdout/stderr/stdin/env/cwd 全继承 = sh exec 语义,
    // 编译器诊断透传即逐字(对拍语料含编译错例钉死)。
    if cmd == "run" {
        if n < 2 {
            eprint(miss_line(cmd))
            return 2
        }
        var argv = List[Str]()
        argv.push(bin_dir() + "/ctron-cc")
        argv.push("run")
        argv.push(ctron_prog_args_at(1))
        // sh run 臂 $1 之外不透传(exec "$BIN/ctron-cc" run "$1"——多余参静默丢弃)
        return delegate(argv)
    }
    if cmd == "check" {
        if n < 2 {
            eprint(miss_line(cmd))
            return 2
        }
        var argv = List[Str]()
        argv.push(bin_dir() + "/ctron-chk")
        argv.push("run")
        argv.push(absolutize(ctron_prog_args_at(1)))
        // $1 绝对化后其余参原样透传(sh :766-768;旗标次序/取值均不解析)
        var i: I64 = 2
        while i < n {
            argv.push(ctron_prog_args_at(i))
            i += 1
        }
        return delegate(argv)
    }
    if cmd == "doc" {
        if n < 2 {
            eprint(miss_line(cmd))
            return 2
        }
        var a1 = ctron_prog_args_at(1)
        // sh :770-778 case */*:含 '/'(路径形)→ 绝对化;裸名(std.<模块>、cwd 相对
        // 文件名)→ 原样透传,由 ctron-doc 四级 std 根/cwd 解析
        var target = a1
        if has_slash(a1) {
            target = absolutize(a1)
        }
        var argv = List[Str]()
        argv.push(bin_dir() + "/ctron-doc")
        argv.push("run")
        argv.push(target)
        var j: I64 = 2
        while j < n {
            argv.push(ctron_prog_args_at(j))
            j += 1
        }
        return delegate(argv)
    }
    if cmd == "test" {
        if n < 2 {
            eprint(miss_line(cmd))
            return 2
        }
        var argv = List[Str]()
        argv.push(bin_dir() + "/ctron-cc")
        argv.push("run")
        argv.push(ctron_prog_args_at(1))
        // ≡ run(sh :789-792 同为 exec ctron-cc run "$1";仅缺参报文异)
        return delegate(argv)
    }
    if cmd == "fmt" {
        // W4 波1 批3:镜像 sh fmt 臂(:1166-1214)。旗标可在目标前——目标 = 首个
        // 非旗标实参,-w|--write/--check 之外静默忽略(sh case 无 * 之分照抄);
        // 缺目标 = die2 逐字(sh :1170/:1180 同文 rc2)。
        if n < 2 {
            eprint("ctron: fmt 需要输入文件或 pkg 目录\n")
            return 2
        }
        var w: Bool = false
        var chk: Bool = false
        var target = ""
        var ai: I64 = 1
        while ai < n {
            var a = ctron_prog_args_at(ai)
            if a == "-w" {
                w = true
            } else if a == "--write" {
                w = true
            } else if a == "--check" {
                chk = true
            } else {
                if target.len == 0 {
                    target = a
                }
            }
            ai += 1
        }
        if target.len == 0 {
            eprint("ctron: fmt 需要输入文件或 pkg 目录\n")
            return 2
        }
        // 目标集:目录 → 顶层 .ct(list 字节序 = LC_ALL=C sort 同序);单文件直通
        // (sh 对缺席单文件不作守卫,ctron-fmt 空 out 即 cat 空形——照抄)。
        // 目录无 .ct = 零迭代静默 rc0(sh fmt 无 lint 的 die2 臂,语义同构)。
        var files = target_files(target)
        var err: Bool = false
        var unf: I32 = 0
        var bin = bin_dir() + "/ctron-fmt"
        var buf: U8[262144] = [0, 0, 0, 0, 0, 0, 0, 0]
        var k: I32 = 0
        while k < files.len {
            var f = files[k]
            capture_zero(buf)
            // proc.run 定形 argv = [bin, "run", arg] —— arg = 文件路径裸串
            // (sh `"$BIN/ctron-fmt" run "$f"` 同构;勿再拼 "run " 前缀)
            let rc = run("", bin, f, buf)
            if rc != 0 {
                // sh:cat 临时件 >&2(捕获物全量转 stderr)+ err 置位续跑
                eprint(capture_str(buf))
                err = true
                k += 1
                continue
            }
            if chk {
                // sh:cmp -s 异 → 打印文件名计数(名行 = echo 子进程直写,保序)
                if capture_differs(buf, f) {
                    echo_line(f)
                    unf += 1
                }
            } else if w {
                // 容量截断守卫(批3 评审 Fix 1,数据破坏面):捕获恰满容量 = 真实
                // 输出可能 ≥ 容量(proc.run 读至 out.n 即止、rc 照回,截断不可辨)
                // ——写回恐落截断字节,拒写;名行照常(sh -w 无条件 echo 同构),
                // stderr 登记行 = 账面分歧(sh 全量写回;正解 = 捕获面扩容/流式,
                // 波2 挂账)。rc 语义不变。
                if capture_len(buf) == buf.len {
                    echo_line(f)
                    eprint("ctron: fmt -w 跳过写回: 输出超捕获容量 " + buf.len.to_string() + " 字节(" + f + ")\n")
                } else {
                    // sh:异则 cp 写回(产物 = 捕获字节,fs_write 经 Str 逐字节保真),
                    // echo 文件名无条件(未变亦打)
                    if capture_differs(buf, f) {
                        fs_write(f, capture_str(buf))
                    }
                    echo_line(f)
                }
            } else {
                // sh:cat 临时件(裸 print,不加行——捕获物自带换行)
                print(capture_str(buf))
            }
            k += 1
        }
        if err {
            return 1
        }
        if chk && unf > 0 {
            eprint(unf.to_string() + " 个文件待格式化\n")
            return 1
        }
        return 0
    }
    if cmd == "lint" {
        // W4 波1 批3:镜像 sh cmd_lint(:338-380)。首参 = 目标(sh $1 恒目标,与
        // fmt 的"首非旗标"异),余参只认 --trusted/--strict,未知即 die2 逐字;
        // 目录展开同 fmt,目录无 .ct = die2(sh :352)。逐文件 run_argv 捕获
        // (--trusted 须 4 段 argv,proc.run 定形不敷)→ 行首 E/W+4 数字字节扫计数
        // (grep -c '^E[0-9]{4}' 同义)→ rc≥2 且无 E 行 = 硬错误(信号死 native 映
        // -1,一并计硬 = sh 139≥2 同判;sh 侧崩时泄 shell 作业行含 PID,不可对拍,
        // 登记在案不入谱)→ 汇总行逐字 → 退出三态(错红 / --strict 警告红)。
        if n < 2 {
            eprint("ctron: lint 需要输入文件或 pkg 目录\n")
            return 2
        }
        var target = ctron_prog_args_at(1)
        var trusted: Bool = false
        var strict: Bool = false
        var ai: I64 = 2
        while ai < n {
            var a = ctron_prog_args_at(ai)
            if a == "--trusted" {
                trusted = true
            } else if a == "--strict" {
                strict = true
            } else {
                eprint("ctron: lint 未知旗标: " + a + "(支持: --trusted --strict)\n")
                return 2
            }
            ai += 1
        }
        var files = List[Str]()
        if is_dir_target(target) {
            files = target_files(target)
            if files.len == 0 {
                eprint("ctron: lint 目录无 .ct 文件: " + target + "\n")
                return 2
            }
        } else {
            if !fs_exists(target) {
                eprint("ctron: lint 目标不存在: " + target + "\n")
                return 2
            }
            files.push(target)
        }
        var bin = bin_dir() + "/ctron-chk"
        var buf: U8[262144] = [0, 0, 0, 0, 0, 0, 0, 0]
        var nf: I32 = 0
        var totE: I32 = 0
        var totW: I32 = 0
        var hard: I32 = 0
        var k: I32 = 0
        while k < files.len {
            var f = files[k]
            nf += 1
            // sh:`[ $LINT_NF -gt 1 ] && echo "-- $f"`(第 2 件起_stdout 分隔行)
            if nf > 1 {
                println("-- " + f)
            }
            capture_zero(buf)
            var argv = List[Str]()
            argv.push(bin)
            argv.push("run")
            argv.push(f)
            if trusted {
                argv.push("--trusted")
            }
            var blob: U8[4096] = [0, 0, 0, 0, 0, 0, 0, 0]
            var rc: I32 = 127
            let bn = argv_to_blob(argv, blob)
            if bn >= 0 {
                rc = run_argv("", blob, bn.as[I64](), buf)
            }
            // 行扫单趟:'^check OK' 行滤(grep -v 打印面);行首 E/W + ≥4 数字计数;
            // 末行无换行 = grep 同款裸出(不补行);空行照印(非 check OK)。
            var captured = capture_str(buf)
            var fe: I32 = 0
            var fw: I32 = 0
            var start: I32 = 0
            var p: I32 = 0
            while p <= captured.len {
                var isEnd: Bool = p == captured.len
                if isEnd || byte_at(captured, p) == 10 {
                    var elen = p - start
                    var isOk: Bool = elen >= 8 && byte_at(captured, start) == 99 && byte_at(captured, start + 1) == 104 && byte_at(captured, start + 2) == 101 && byte_at(captured, start + 3) == 99 && byte_at(captured, start + 4) == 107 && byte_at(captured, start + 5) == 32 && byte_at(captured, start + 6) == 79 && byte_at(captured, start + 7) == 75
                    if !isOk {
                        if elen > 0 || !isEnd {
                            print(byte_slice(captured, start, p))
                            if !isEnd {
                                print("\n")
                            }
                        }
                    }
                    if elen >= 5 {
                        var c0 = byte_at(captured, start)
                        if c0 == 69 || c0 == 87 {
                            if byte_at(captured, start + 1) >= 48 && byte_at(captured, start + 1) <= 57 && byte_at(captured, start + 2) >= 48 && byte_at(captured, start + 2) <= 57 && byte_at(captured, start + 3) >= 48 && byte_at(captured, start + 3) <= 57 && byte_at(captured, start + 4) >= 48 && byte_at(captured, start + 4) <= 57 {
                                if c0 == 69 {
                                    fe += 1
                                } else {
                                    fw += 1
                                }
                            }
                        }
                    }
                    start = p + 1
                }
                if isEnd {
                    break
                }
                p += 1
            }
            if (rc >= 2 || rc < 0) && fe == 0 {
                hard += 1
            }
            totE += fe
            totW += fw
            k += 1
        }
        println("lint: " + nf.to_string() + " 文件," + (totE + hard).to_string() + " 个错误 / " + totW.to_string() + " 警告")
        if totE + hard > 0 {
            return 1
        }
        if strict && totW > 0 {
            return 1
        }
        return 0
    }
    if cmd == "build" {
        // W4 波2 批1:镜像 sh build 臂(:1155-1161)。--target 解析循环(last wins;
        // env CTRON_TARGET 为底,空值落 native);$1 在场 = 单文件臂(首参恒文件,
        // 旗标位亦然 = sh 逐字),否则项目模式臂。
        var target = env_get("CTRON_TARGET")
        var prevt: Bool = false
        var ai: I64 = 1
        while ai < n {
            var a = ctron_prog_args_at(ai)
            if prevt {
                target = a
                prevt = false
            } else {
                if a.len >= 9 && byte_slice(a, 0, 9) == "--target=" {
                    target = byte_slice(a, 9, a.len)
                } else {
                    if a == "--target" {
                        prevt = true
                    }
                }
            }
            ai += 1
        }
        if target.len == 0 {
            target = "native"
        }
        if n >= 2 {
            return build_file(ctron_prog_args_at(1), target)
        }
        return build_proj()
    }
    if cmd == "task" {
        // W4 波2 批2:env 注入(lib/std 在场 → env_set CTRON_STDPATH,sh 分派臂
        // 先行同序)+ -f 清单/名实参解析(sh for 循环同序:后者覆盖;悬空 -f = 清单
        // 缺省 ./ctron.ctcl;-f= 空串同构)
        drv_env_setup()
        var tf = "./ctron.ctcl"
        var tn = ""
        var prevf: Bool = false
        var ai: I64 = 1
        while ai < n {
            var a = ctron_prog_args_at(ai)
            if prevf {
                tf = a
                prevf = false
            } else if a == "-f" {
                prevf = true
            } else if a.len >= 3 {
                if byte_slice(a, 0, 3) == "-f=" {
                    tf = byte_slice(a, 3, a.len)
                } else {
                    tn = a
                }
            } else {
                tn = a
            }
            ai += 1
        }
        return cmd_task(tf, tn)
    }
    if cmd == "gate" {
        // W4 波2 批2:env 注入 + 单名实参(sh $1 之外静默丢弃同构;旗标形在
        // cmd_gate 内拒)
        drv_env_setup()
        var gn = ""
        if n >= 2 {
            gn = ctron_prog_args_at(1)
        }
        return cmd_gate(gn)
    }
    if cmd == "clean" {
        // W4 波2 批2:--all 旗标解析;未知旗标 = rc2 用法错逐字(不支持 env 注入
        // = sh clean 臂无 drv_env_setup 同构)
        var allF: Bool = false
        var ci: I64 = 1
        while ci < n {
            var a = ctron_prog_args_at(ci)
            if a == "--all" {
                allF = true
            } else {
                return fail2("clean 未知旗标: " + a + "(支持: --all)")
            }
            ci += 1
        }
        return cmd_clean(allF)
    }
    if cmd == "new" {
        // W4 波3 批1:new 臂(sh :1215-1221):缺参 rc2 逐字;$1 之外静默丢弃
        if n < 2 {
            return fail2("new 需要目录名")
        }
        return cmd_new(ctron_prog_args_at(1))
    }
    if cmd == "add" {
        // W4 波3 批1:add 臂(sh :1240-1277):缺参 rc2 逐字 → 校验白名单 →
        // registry 版本解析/安装/dep 块追加 → ctron-dep 刷新(rc 非零 = 1)
        if n < 2 {
            return fail2("add 需要依赖名(形: <name>[@<版本约束>])")
        }
        return cmd_add(ctron_prog_args_at(1))
    }
    if cmd == "publish" {
        // W4 波3 批1:publish 臂(sh :1283-1308):实参全忽略(sh 臂无 $* 消费)
        return cmd_publish()
    }
    if cmd == "lock" {
        // W4 波3 批1:lock 臂(sh :1278-1282):spawn ctron-dep,rc 直通
        return cmd_lock()
    }
    if cmd == "bench" {
        // W4 波3 批2:bench 分派臂(sh :1237-1239 直落 cmd_bench;$1 之外余参由
        // cmd_bench 自弃——case 只读 $1)。无族 = 注册表清单 rc0;未注册/脚本
        // 缺席 die2;命中 = `sh <族脚本>` spawn rc 直通。
        var rest = List[Str]()
        var bi: I64 = 1
        while bi < n {
            rest.push(ctron_prog_args_at(bi))
            bi += 1
        }
        return cmd_bench(rest)
    }
    if cmd == "pkg" {
        // W4 波3 批2+3:pkg 分派臂(sh :1302-1310):verify/attest/log/seal/trace
        // 全落地(--deep 复放腿仍挂账:深腿码gen = 工件 deps 布局 + use 名.模.{
        // fn 集} 头 + impl 陈旧证据查,与本批 record/replay 的源拷贝 drv 不同构,
        // 不干净组合 → 维持暂缓,诚实登记)
        if n < 2 {
            return fail2("pkg 需要子命令(现支持: pkg verify [--deep] <工件目录> / pkg trace / pkg attest)")
        }
        var sub = ctron_prog_args_at(1)
        var rest = List[Str]()
        var ri: I64 = 2
        while ri < n {
            rest.push(ctron_prog_args_at(ri))
            ri += 1
        }
        if sub == "verify" {
            return cmd_pkg_verify(rest)
        }
        if sub == "trace" {
            return cmd_pkg_trace(rest)
        }
        if sub == "attest" {
            return cmd_pkg_attest(rest)
        }
        if sub == "log" {
            return cmd_pkg_log(rest)
        }
        if sub == "seal" {
            return cmd_pkg_seal(rest)
        }
        return fail2("pkg: 未知子命令 '" + sub + "'(现支持: verify trace attest log seal)")
    }
    // 其余一切名字 = sh 同款未知子命令(stderr + rc 2)
    eprint(unknown_line(cmd))
    return 2
}
