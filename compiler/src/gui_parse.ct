// =====================================================================
// gui_parse.ct —— GUI 块认领与折叠(W1/W2;规范 specs/2026-09-16-gui-ctml-design.md §11.1)
// W1:顶层 view/style 块在 token 流上的平衡扫描认领,记 File 子节点 GuiBlock:
//    [1]=kind [2]=name [3]=块内 token 数 [4]=块内 token 空格连接串 [6]=体 {/} 行:列
//    (GUI-12:[4] 的空格连接非无损——词法切词处重建会插空格,叶 "INNER-ON"→
//    "INNER -ON";保真径=[6] 坐标反推源字节切片,gui_blocks_src_raw 消费)
// W2:gui_lower 折叠——token 串 → 结构化 IR 文本 dump(--dump-gui 口径);
//    颜色 #RRGGBB 格式校验(E8130 前身,W3 接诊断面);令牌查用户常量随 W3(sem 表)。
// 契约:eat_tok 助手(花括号字面量不可词法化)(触发插值扫描吞引号,E1001)——一律字节码比较;
//       注释中不放花括号字符(发射口径词法分歧,见计划文档登记)。
// =====================================================================

fn gui_block(toks: List[Str], cur: Atomic[I32], kind: Str, lns: List[Str], cols: List[Str]) -> List[Str] {
    var nd = mk("GuiBlock")
    nd.push(kind)
    adv(cur)
    var name: Str = tok(toks, cur)
    adv(cur)
    nd.push(name)
    // 8c-1:view props 形参表捕获(view Name(a: T, b: U) { … })——平衡圆括号
    // 原文入节点尾槽(d[5];既有 d[4]=joined 索引消费者不动)。域包侧仅跳过。
    var props: Str = ""
    if cur.load() < toks.len {
        var pt: Str = tok(toks, cur)
        if pt.len == 1 {
            if byte_at(pt, 0) == 40 {
                adv(cur)
                props = "( "
                var pd: I32 = 1
                while cur.load() < toks.len && pd > 0 {
                    var t2: Str = tok(toks, cur)
                    adv(cur)
                    // 剥 join 流行尾 ~ 标记(多行形参表防护;与 gui_sk_word 同规)
                    if t2.len > 1 {
                        if byte_at(t2, t2.len - 1) == 126 {
                            t2 = byte_slice(t2, 0, t2.len - 1)
                        }
                    }
                    if t2.len == 1 {
                        var b2: I32 = byte_at(t2, 0)
                        if b2 == 40 {
                            pd += 1
                        } else {
                            if b2 == 41 {
                                pd -= 1
                                if pd == 0 {
                                    break
                                }
                            }
                        }
                    }
                    props = props + t2 + " "
                }
                props = props + ")"
            }
        }
    }
    var joined: Str = name
    // GUI-12 内嵌重建保真:块体原文切片面。rawok=false 时 d[6] 留空=消费侧
    // 回退 token 重建;style extends 的头经 token 流承载(切片会丢 extends 对),
    // 故仅 extends 关 raw——顺带根治连字符样式名重建丢后缀("in-t"→"in" 实证)
    var rawok: Bool = true
    if kind == "style" {
        // P-W2:extends 对并入 joined——started 旗会丢弃 { 前的 token,
        // 而 check/skeleton/lower 三面的 extends 消费全走 joined 串
        if cur.load() < toks.len {
            var pt2: Str = tok(toks, cur)
            if pt2 == "extends" {
                adv(cur)
                var pn2: Str = tok(toks, cur)
                adv(cur)
                joined = joined + " extends " + pn2
                rawok = false
            }
        }
    }
    var depth: I32 = 0
    var toks_n: I32 = 1
    var started: Bool = false
    var pos: Str = ""
    var pos1: Str = ""
    while true {
        var t: Str = tok(toks, cur)
        if t == "#EOF" {
            panic("gui: 块未闭合 " + kind + " " + name)
        }
        var one: Bool = t.len == 1
        var is_open: Bool = false
        var is_close: Bool = false
        if one {
            if byte_at(t, 0) == 123 {
                is_open = true
            }
            if byte_at(t, 0) == 125 {
                is_close = true
            }
        }
        if is_open {
            depth += 1
            started = true
            if depth == 1 {
                pos1 = gui_pos_at(lns, cols, cur.load())
                adv(cur)
                continue
            }
        } else {
            if is_close {
                depth -= 1
                if depth == 0 {
                    if rawok {
                        var pos2: Str = gui_pos_at(lns, cols, cur.load())
                        if pos1.len > 0 {
                            if pos2.len > 0 {
                                pos = pos1 + " " + pos2
                            }
                        }
                    }
                    adv(cur)
                    break
                }
            }
        }
        if started {
            joined = joined + " " + t
            toks_n += 1
        }
        adv(cur)
    }
    nd.push(toks_n.to_string())
    nd.push(joined)
    nd.push(props)
    nd.push(pos)
    return nd
}

// token 行:列 → "行 列" 串(无位置面/越界 = 空,消费侧回退;gui_ctml_file
// 自有词法无 lns/cols,传空表即走此路)
fn gui_pos_at(lns: List[Str], cols: List[Str], i: I32) -> Str {
    if i < 0 {
        return ""
    }
    if i >= lns.len {
        return ""
    }
    if i >= cols.len {
        return ""
    }
    return lns[i] + " " + cols[i]
}

// ---- token 串拆分(词法 token 无空格,空格单切无损) ----

fn gui_split(joined: Str, out: List[Str]) -> I32 {
    var n: I32 = joined.len
    var i: I32 = 0
    while i < n {
        var start: I32 = i
        while i < n {
            if byte_at(joined, i) == 32 {
                break
            }
            i += 1
        }
        if i > start {
            out.push(byte_slice(joined, start, i))
        }
        i += 1
    }
    return 0
}

fn gui_hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui E8130: 颜色非法十六进制")
    return 0
}

// 颜色串校验(E8130 前身):#RRGGBB;返回打包色
fn gui_unq(v: Str) -> Str {
    if v.len >= 2 {
        if byte_at(v, 0) == 34 {
            if byte_at(v, v.len - 1) == 34 {
                return byte_slice(v, 1, v.len - 1)
            }
        }
    }
    return v
}

fn eat_tok(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    return t
}

fn gui_parse_color(v: Str) -> I32 {
    if v.len != 7 {
        panic("gui E8130: 颜色须 #RRGGBB,得 " + v)
    }
    if byte_at(v, 0) != 35 {
        panic("gui E8130: 颜色须 # 开头,得 " + v)
    }
    var r: I32 = gui_hex1(byte_at(v, 1)) * 16 + gui_hex1(byte_at(v, 2))
    var g: I32 = gui_hex1(byte_at(v, 3)) * 16 + gui_hex1(byte_at(v, 4))
    var b: I32 = gui_hex1(byte_at(v, 5)) * 16 + gui_hex1(byte_at(v, 6))
    return r * 65536 + g * 256 + b
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 视图块折叠:<' tag attrs '>' content '</' tag '>';返回 IR 行(已含缩进)
// attrs:class="x" 与 on:名={handler};叶子文本:字面量 token* + 至多一个 {ident}
fn gui_dump_file(file: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            var out = List[Str]()
            if d[1] == "view" {
                gui_lower_view(tks, cur, "  ", out)
            } else {
                if d[1] == "style" {
                    gui_lower_style(tks, cur, "  ", out)
                }
            }
        }
        i += 1
    }
    return 0
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 元素折叠:<' tag attrs '>' content '</' tag '>'(限深递归;子元素自递归)
// SL-6a 认领:自闭合(input/>)、each item 位置头(in= 绑定列表名)、when cond 绑定名、
// input bind 绑定名、花括号属性值(单词 = 绑定名通道,与域包解析器同构)
fn gui_lower_element(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    if eat_tok(tks, cur) != "<" {
        panic("gui E8100: 期待 <")
    }
    var tag: Str = eat_tok(tks, cur)
    // P2 组件实例:args `名: 值` 三形跳读(值不走 = 契约,实例名无 attr 语义);
    // 投影子树递归——dump 面先于 E81xx 走查,不认实例即在检查前 panic(s50 语料实证)
    var fb5: I32 = byte_at(tag, 0)
    if fb5 >= 65 {
        if fb5 <= 90 {
            var saws5: Bool = false
            while tks[cur.load()] != ">" {
                var pk5: Str = tks[cur.load()]
                if pk5.len == 1 {
                    if byte_at(pk5, 0) == 47 {
                        cur.store(cur.load() + 1)
                        saws5 = true
                        break
                    }
                }
                eat_tok(tks, cur)
                eat_tok(tks, cur)
                var vw5: Str = tks[cur.load()]
                if vw5.len == 1 {
                    if byte_at(vw5, 0) == 123 {
                        cur.store(cur.load() + 1)
                        gui_bx_expr(tks, cur)
                    } else {
                        eat_tok(tks, cur)
                    }
                } else {
                    eat_tok(tks, cur)
                }
            }
            eat_tok(tks, cur)
            println(ind + "el call:" + tag)
            if !saws5 {
                while true {
                    if tks[cur.load()] == "<" {
                        if tks[cur.load() + 1] == "/" {
                            break
                        }
                        gui_lower_element(tks, cur, ind + "  ", out)
                    } else {
                        if tks[cur.load()] == "#EOF" {
                            panic("gui E8100: 未终止")
                        }
                        eat_tok(tks, cur)
                    }
                }
                eat_tok(tks, cur)
                eat_tok(tks, cur)
                var et5: Str = eat_tok(tks, cur)
                if et5 != tag {
                    panic("gui E8100: 闭合标签不匹配 " + et5)
                }
                eat_tok(tks, cur)
            }
            return 0
        }
    }
    var c: Str = ""
    var onn: Str = ""
    var onf: Str = ""
    var bv: Str = ""
    var itemvar: Str = ""
    if tag == "each" {
        itemvar = eat_tok(tks, cur)
    }
    var selfc: Bool = false
    while tks[cur.load()] != ">" {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            if byte_at(pk, 0) == 47 {
                cur.store(cur.load() + 1)
                selfc = true
                break
            }
        }
        var an: Str = eat_tok(tks, cur)
        if an == "hover" {
            // S3:hover:名 裸属性——检查面放行(消费 token 不产 IR);
            // 生效面=内嵌形态(域包 gt_attrs 入事件表);文件形态忽略=登记限制
            if eat_tok(tks, cur) != ":" {
                panic("gui E8100: hover 期待冒号")
            }
            eat_tok(tks, cur)
        } else {
        if an == "password" {
            // input 变体裸属性——检查面放行;sk 面入事件表(见 gui_sk_attrs)
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "numeric" {
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "switch" {
            // checkbox 变体裸属性(药丸滑块)——三面放行;sk 面入事件表
            // (渲染期 rt_has_mark 消费,密码/数字同款承载)
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "radio" {
            // checkbox 变体裸属性(单选圆钮)——同 switch 承载
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "on" {
            if eat_tok(tks, cur) != ":" {
                panic("gui E8100: on 期待冒号")
            }
            onn = eat_tok(tks, cur)
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: on 期待等号")
            }
            var ob: Str = eat_tok(tks, cur)
            if ob.len >= 2 {
                if byte_at(ob, 0) == 34 {
                    // GUI-15:on:after="ms:handler" 引号串事件——原样透传内嵌源
                    onf = ob
                }
            }
            if onf == "" {
                if ob.len != 1 {
                    panic("gui E8100: on 期待块开")
                }
                if byte_at(ob, 0) != 123 {
                    panic("gui E8100: on 期待块开")
                }
                // 8c-3:事件表达式平衡捕获(单标识符旧契约为其特例;gui_bx_expr
                // 消费至配对 } 并剥行尾 ~ 标记)
                onf = gui_bx_expr(tks, cur)
            }
        } else {
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: 属性期待等号")
            }
            var av: Str = ""
            if tks[cur.load()].len == 1 {
                if byte_at(tks[cur.load()], 0) == 123 {
                    cur.store(cur.load() + 1)
                    // SL-8a:平衡捕获+规范形(IR 展示仍包花括号)
                    av = "\{" + gui_bx_expr(tks, cur) + "}"
                }
            }
            if av == "" {
                av = gui_unq(eat_tok(tks, cur))
            }
            if an == "class" {
                c = av
            }
            if an == "cond" {
                bv = av
            }
            if an == "bind" {
                bv = av
            }
            if an == "in" {
                bv = av
            }
        }
        }
        }
        }
        }
        }
    }
    eat_tok(tks, cur)
    var line: Str = ind + "el " + tag
    if itemvar != "" {
        line = line + " item=" + itemvar
    }
    if c != "" {
        line = line + " cls=" + c
    }
    if bv != "" {
        line = line + " bind=" + bv
    }
    if onn != "" {
        line = line + " on:" + onn + "=" + onf
    }
    println(line)
    out.push(line)
    if selfc {
        return 0
    }
    var lit: Str = ""
    while true {
        if tks[cur.load()] == "<" {
            if tks[cur.load() + 1] == "/" {
                break
            }
            if lit != "" {
                var tl: Str = ind + "  " + tag + " text=\"" + lit + "\""
                println(tl)
                out.push(tl)
                lit = ""
            }
            gui_lower_element(tks, cur, ind + "  ", out)
        } else {
            if tks[cur.load()] == "#EOF" {
                panic("gui E8100: 未终止")
            }
            var w: Str = eat_tok(tks, cur)
            if lit != "" {
                lit = lit + " "
            }
            lit = lit + w
        }
    }
    if lit != "" {
        var tline: Str = ind + "  " + tag + " text=\"" + lit + "\""
        println(tline)
        out.push(tline)
    }
    eat_tok(tks, cur)
    eat_tok(tks, cur)
    var et: Str = eat_tok(tks, cur)
    if et != tag {
        panic("gui E8100: 闭合标签不匹配 " + et)
    }
    eat_tok(tks, cur)
    return 0
}

fn gui_lower_view(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui view " + name)
    out.push("view " + name)
    gui_lower_element(tks, cur, ind + "  ", out)
    return 0
}

fn gui_lower_style(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    // P-W2:extends 单亲派生——跳过关键字与父名(dump 不展开继承)
    if cur.load() < tks.len {
        if tks[cur.load()] == "extends" {
            cur.store(cur.load() + 1)
            cur.store(cur.load() + 1)
        }
    }
    println(ind + "gui style " + name)
    out.push("style " + name)
    while cur.load() < tks.len {
        var p: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if tks[cur.load()] != ":" {
            panic("gui E8130: 期待 :,得 " + tks[cur.load()])
        }
        cur.store(cur.load() + 1)
        var v: Str = gui_unq(tks[cur.load()])
        cur.store(cur.load() + 1)
        if p == "bg" {
            var packed: I32 = gui_parse_color(v)
            if packed < 0 {
                panic("gui E8130: 颜色解析失败")
            }
        }
        println(ind + "  " + p + "=" + v)
        out.push(p + "=" + v)
        if cur.load() < tks.len {
            if tks[cur.load()] == ";" {
                cur.store(cur.load() + 1)
            }
        }
    }
    cur.store(cur.load() + 1)
    return 0
}

// SL-7α:程序自身 GuiBlock 重建为 CTML 文本(内嵌 view/style 块端到端的数据源)。
// 形态 = 空格化 token(kind 名 { token* })——域包词法 glit 前置 gws,全容忍;
// ctron_embedded 内建(eval/emit 双口径)据此返回,run_d 文件缺失时兜底。
fn gui_blocks_src(file: List[Str]) -> Str {
    return gui_blocks_src_raw(file, "")
}

// SL-7α:程序自身 GuiBlock 重建为 CTML 文本(内嵌 view/style 块端到端的数据源)。
// GUI-12 保真径:src 非空且 GuiBlock 带行:列位置槽(d[6])时,块体按源字节
// 切片原文直出——词法切-连的空格损失不再发生(叶 "INNER-ON" 不再重建为
// "INNER -ON");探针校验不过(跨文件坐标/无源面)回退 token 空格连接旧径。
fn gui_blocks_src_raw(file: List[Str], src: Str) -> Str {
    var starts = gui_line_starts(src)
    var out: Str = ""
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d.len < 3 {
            i += 1
            continue
        }
        if d[0] == "GuiBlock" {
            var got: Bool = false
            if src.len > 0 {
                if d.len >= 7 {
                    if d[6].len > 0 {
                        var body: Str = gui_raw_body(src, starts, d[6])
                        if body.len > 0 {
                            // 8c-2:props 形参表(d[5])随重建——否则内嵌兜底源丢 props,
                            // 域包 gt_parse 捕获空表,求值切换/链解析静默失效
                            got = true
                            out = out + d[1] + " " + d[2] + d[5] + " \{" + body + "} "
                        }
                    }
                }
            }
            if !got {
                out = out + gui_blocks_rejoin(d)
            }
        }
        i += 1
    }
    return out
}

// 旧径:块体 token 空格连接串 → 逐 token 重排(词法切词处插空格,连字符/
// 标点叶失真;保留作无位置面/探针不过的回退)
fn gui_blocks_rejoin(d: List[Str]) -> Str {
    var out: Str = ""
    // 8c-2:props 形参表(d[5])随重建(同上)
    out = out + d[1] + " " + d[2] + d[5] + " \{"
    var tks = List[Str]()
    gui_split(d[4], tks)
    var k: I32 = 1
    while k < tks.len {
        var tk: Str = tks[k]
        // 剥行尾标记 ~:join 流的换行编码只服务 dump/check 面,域包词法
        // 不认(gspan 值位 "8~" 会在 ~ 处断词 → 期待标识符)
        if tk.len > 1 {
            if byte_at(tk, tk.len - 1) == 126 {
                tk = byte_slice(tk, 0, tk.len - 1)
            }
        }
        if tk == "<" {
            if k + 1 < tks.len {
                if tks[k + 1] == "/" {
                    // </ 粘连:容器闭合探测是裸字节检查(gui.ct 子循环 peek2),
                    // "< /" 会被误判为子元素开头 → gword("/") 期待标识符
                    out = out + " </"
                    k += 2
                    continue
                }
            }
        }
        if tk == "=" {
            if k + 1 < tks.len {
                var nk2: Str = tks[k + 1]
                if nk2.len == 1 {
                    if byte_at(nk2, 0) == 123 {
                        // ={ 粘连:attr 值花括号探测同为裸字节检查(= 后直接看 {),
                        // "= {" 会走 gstr 误期待引号串
                        out = out + " =\{"
                        k += 2
                        continue
                    }
                }
            }
        }
        out = out + " " + tk
        k += 1
    }
    out = out + " } "
    return out
}

// 源文本行起始字节表(starts[0]=0;遇 \n 记下一行起点)
fn gui_line_starts(src: Str) -> List[I32] {
    var starts = List[I32]()
    starts.push(0)
    var n: I32 = src.len
    var i: I32 = 0
    while i < n {
        if byte_at(src, i) == 10 {
            starts.push(i + 1)
        }
        i += 1
    }
    return starts
}

// 位置串("l1 c1 l2 c2")→ 开/闭花括号字节切片块体;探针不过 = 空(回退)。
// 探针双验:两坐标处字节须真为 { 与 }(跨文件坐标必错位),杜绝错切。
fn gui_raw_body(src: Str, starts: List[I32], pos: Str) -> Str {
    var ps = List[I32]()
    var j: I32 = 0
    var acc: I32 = 0 - 1
    var n: I32 = pos.len
    while j <= n {
        var b: I32 = 32
        if j < n {
            b = byte_at(pos, j)
        }
        if b == 32 {
            if acc >= 0 {
                ps.push(acc)
                acc = 0 - 1
            }
        } else {
            if b < 48 || b > 57 {
                return ""
            }
            if acc < 0 {
                acc = 0
            }
            acc = acc * 10 + (b - 48)
        }
        j += 1
    }
    if ps.len != 4 {
        return ""
    }
    if ps[0] < 1 || ps[0] > starts.len {
        return ""
    }
    if ps[2] < 1 || ps[2] > starts.len {
        return ""
    }
    var open: I32 = starts[ps[0] - 1] + ps[1] - 1
    var close: I32 = starts[ps[2] - 1] + ps[3] - 1
    if open < 0 || close >= src.len || open + 2 > close {
        return ""
    }
    if byte_at(src, open) != 123 {
        return ""
    }
    if byte_at(src, close) != 125 {
        return ""
    }
    return byte_slice(src, open + 1, close)
}

// ==================== SL-8c-4②:gui.run 装配合成 ====================
// run(ViewCall) 调用点改写 + __gui_bind/__gui_act/__gui_run 三 fn 以源文本
// 生成后经真解析器(scan4+p_file)拼写进 File——产物即普通 AST,解释/发射
// 双口径免费。钩子 = pkg_load_use 外壳(预合并注入 use gui.{run_d} 请求,
// 合并后改写+拼写)。v1 差集登记:标题/尺寸默认值(ctcl gui{} 归 J18)、
// 标量 prop 快照语义、旧契约单词事件生成零参调用。

// 构型字段表收集(check 面/合成器共用)
fn gui_field_tables(file: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var ds = file[i]
        if ds[0] == "Struct" {
            if ds.len > 4 {
                var fsx = ds[4]
                var fi: I32 = 1
                while fi < fsx.len {
                    var fd = fsx[fi]
                    if fd[0] == "Field" {
                        stns.push(ds[1])
                        sfk.push(ds[1] + "." + fd[2])
                        stv.push(gui_ty_head_node(fd[3]))
                    }
                    fi += 1
                }
            }
        }
        i += 1
    }
    return 0
}

// 视图收集:名表 + props 形参串表(d[5])
fn gui_ds_views(file: List[Str], vnames: List[Str], vprops: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            if d[1] == "view" {
                vnames.push(d[2])
                if d.len > 5 {
                    vprops.push(d[5])
                } else {
                    vprops.push("")
                }
            }
        }
        i += 1
    }
    return 0
}

// run(ViewCall) 检出:表达式走查(命中返回视图名;未知标签安全返回 "")
fn gui_ds_find_expr(e: List[Str], views: List[Str], names: List[Str]) -> Str {
    if e.len < 1 {
        return ""
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[2].len > 1 {
                                        if gui_ck_has_style(views, a[1][1]) {
                                            names.push(a[1][1])
                                            var k2: I32 = 1
                                            while k2 < a[2].len {
                                                names.push(a[2][k2][1])
                                                k2 += 1
                                            }
                                            return a[1][1]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var r: Str = gui_ds_find_expr(e[1], views, names)
        if r != "" {
            return r
        }
        var i: I32 = 1
        while i < e[2].len {
            r = gui_ds_find_expr(e[2][i], views, names)
            if r != "" {
                return r
            }
            i += 1
        }
        return ""
    }
    if t == "Binary" {
        var r2: Str = gui_ds_find_expr(e[2], views, names)
        if r2 != "" {
            return r2
        }
        return gui_ds_find_expr(e[3], views, names)
    }
    if t == "Unary" {
        return gui_ds_find_expr(e[2], views, names)
    }
    if t == "Member" {
        return gui_ds_find_expr(e[1], views, names)
    }
    if t == "NParg" {
        return gui_ds_find_expr(e[2], views, names)
    }
    if t == "Index" {
        return gui_ds_find_expr(e[1], views, names)
    }
    return ""
}

// 语句块走查(镜像 p_stmt 标签集;裸表达式语句原样试查)
fn gui_ds_find_block(b: List[Str], views: List[Str], names: List[Str]) -> Str {
    var i: I32 = 1
    while i < b.len {
        var s = b[i]
        var t: Str = s[0]
        var hit: Str = ""
        if t == "Return" {
            if s.len > 1 {
                hit = gui_ds_find_expr(s[1], views, names)
            }
        } else {
            if t == "Let" {
                hit = gui_ds_find_expr(s[4], views, names)
            } else {
                if t == "While" {
                    hit = gui_ds_find_expr(s[1], views, names)
                    if hit == "" {
                        hit = gui_ds_find_block(s[2], views, names)
                    }
                } else {
                    if t == "For" {
                        hit = gui_ds_find_expr(s[2], views, names)
                        if hit == "" {
                            hit = gui_ds_find_block(s[3], views, names)
                        }
                    } else {
                        if t == "If" {
                            hit = gui_ds_find_expr(s[1], views, names)
                            if hit == "" {
                                hit = gui_ds_find_block(s[2], views, names)
                            }
                            if hit == "" {
                                if s[3][0] == "If" {
                                    hit = gui_ds_find_block(s[3], views, names)
                                } else {
                                    if s[3][0] == "BlockExpr" {
                                        hit = gui_ds_find_block(s[3][1], views, names)
                                    }
                                }
                            }
                        } else {
                            if t == "Expr" {
                                hit = gui_ds_find_expr(s[1], views, names)
                            } else {
                                if t == "Assign" {
                                    hit = gui_ds_find_expr(s[1], views, names)
                                    if hit == "" {
                                        hit = gui_ds_find_expr(s[3], views, names)
                                    }
                                } else {
                                    hit = gui_ds_find_expr(s, views, names)
                                }
                            }
                        }
                    }
                }
            }
        }
        if hit != "" {
            return hit
        }
        i += 1
    }
    return ""
}

fn gui_ds_find_file(file: List[Str], views: List[Str], names: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" {
            var hit: Str = gui_ds_find_block(d[5], views, names)
            if hit != "" {
                return hit
            }
        }
        i += 1
    }
    return ""
}

// 命中节点就地改写:被调换 __gui_run_<V>,实参 = NParg 值表达式按序

// 路径型别解析(prop 根起逐段;len 尾段=I32;未知="")
fn gui_ds_path_ty(path: Str, pnames: List[Str], ptyps: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str]) -> Str {
    var segs = List[Str]()
    var i: I32 = 0
    var start: I32 = 0
    while i < path.len {
        if byte_at(path, i) == 46 {
            segs.push(byte_slice(path, start, i))
            start = i + 1
        }
        i += 1
    }
    segs.push(byte_slice(path, start, path.len))
    var root: Str = segs[0]
    if !gui_ck_has_style(pnames, root) {
        return ""
    }
    var cur: Str = ""
    var ri: I32 = 0
    while ri < pnames.len {
        if pnames[ri] == root {
            cur = gui_ty_head_txt(ptyps[ri])
            ri = pnames.len
        }
        ri += 1
    }
    var si: I32 = 1
    while si < segs.len {
        var seg: Str = segs[si]
        var last: Bool = si == segs.len - 1
        var fkey: Str = cur + "." + seg
        if gui_ck_has_style(sfk, fkey) {
            var fi: I32 = 0
            while fi < sfk.len {
                if sfk[fi] == fkey {
                    cur = gui_ty_head_txt(stv[fi])
                    fi = sfk.len
                }
                fi += 1
            }
        } else {
            if seg == "len" {
                if last {
                    return "I32"
                }
                return ""
            }
            return ""
        }
        si += 1
    }
    return cur
}

// 路径根改写(prop 名 → 合成参数 token)
fn gui_ds_rw(path: Str, pnames: List[Str], ptoks: List[Str]) -> Str {
    var root: Str = path
    var di: I32 = 0
    while di < path.len {
        if byte_at(path, di) == 46 {
            root = byte_slice(path, 0, di)
            di = path.len
        }
        di += 1
    }
    var ri: I32 = 0
    while ri < pnames.len {
        if pnames[ri] == root {
            return ptoks[ri] + byte_slice(path, root.len, path.len)
        }
        ri += 1
    }
    return path
}

// ==================== 独立 .ctml 检查入口(SL-6c;§5.1 语法缝)====================
// 内嵌/独立同语法同路径:标记 tokenizer → 复用 gui_block 平衡认领 → GuiBlock File 节
// → gui_dump_file/gui_check_file 同一走查。契约不变:GuiBlock[4]=空格连接串,
// token 不得含空格(串字面量含空格即降级,与内嵌口径一致)。

// 后缀判定:p 以 .ctml 结尾
fn gui_is_ctml(p: Str) -> Bool {
    if p.len < 5 {
        return false
    }
    var i: I32 = 0
    while i < 5 {
        if byte_at(p, p.len - 5 + i) != byte_at(".ctml", i) {
            return false
        }
        i += 1
    }
    return true
}

// 标记 tokenizer:< > = : ; / 单字符;花括号单字符;串字面量(可含转义)一 token;
// // 行注释跳过;词 = 非空白非特殊字节连续段(含 UTF-8 多字节)
fn gui_ctml_tokens(src: Str, out: List[Str]) -> I32 {
    var n: I32 = src.len
    var i: I32 = 0
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i += 1
        } else {
            if b == 47 {
                if i + 1 < n {
                    if byte_at(src, i + 1) == 47 {
                        while i < n {
                            if byte_at(src, i) == 10 {
                                break
                            }
                            i += 1
                        }
                        continue
                    }
                }
                out.push("/")
                i += 1
            } else {
                if b == 34 {
                    var j: I32 = i + 1
                    while j < n {
                        var cb: I32 = byte_at(src, j)
                        if cb == 92 {
                            j += 2
                            continue
                        }
                        if cb == 34 {
                            break
                        }
                        j += 1
                    }
                    if j >= n {
                        j = n - 1
                    }
                    out.push(byte_slice(src, i, j + 1))
                    i = j + 1
                } else {
                    // GUI-27:左右圆括号入单字符集——view props 形参表捕获
                    // (gui_block 8c-1 期待单字符括号,内嵌 .ct 词法即此形);
                    // 独立流对齐内嵌流(内嵌/独立同语法同路径,§5.1)
                    if b == 60 || b == 62 || b == 61 || b == 123 || b == 125 || b == 58 || b == 59 || b == 40 || b == 41 {
                        out.push(byte_slice(src, i, i + 1))
                        i += 1
                    } else {
                        var j2: I32 = i
                        while j2 < n {
                            var wb: I32 = byte_at(src, j2)
                            if wb == 32 || wb == 9 || wb == 10 || wb == 13 {
                                break
                            }
                            if wb == 60 || wb == 62 || wb == 61 || wb == 123 || wb == 125 || wb == 58 || wb == 59 || wb == 47 || wb == 34 || wb == 40 || wb == 41 {
                                break
                            }
                            j2 += 1
                        }
                        if j2 > i {
                            out.push(byte_slice(src, i, j2))
                            i = j2
                        } else {
                            i += 1
                        }
                    }
                }
            }
        }
    }
    return 0
}

// 独立 .ctml 源 → File 节(子 = GuiBlock;顶层扫 view/style 关键字交 gui_block 认领)
// 自有标记词法无 lns/cols:传空表,d[6] 位置槽留空(消费侧自动回退 token 重建)
fn gui_ctml_file(src: Str) -> List[Str] {
    var toks = List[Str]()
    gui_ctml_tokens(src, toks)
    var nol = List[Str]()
    var noc = List[Str]()
    var file = mk("File")
    var cur = Atomic[I32](0)
    while cur.load() < toks.len {
        var t: Str = toks[cur.load()]
        if t == "view" {
            file.push(gui_block(toks, cur, "view", nol, noc))
        } else {
            if t == "style" {
                file.push(gui_block(toks, cur, "style", nol, noc))
            } else {
                cur.store(cur.load() + 1)
            }
        }
    }
    return file
}

// ==================== GUI-27:跨文件 view 导入(use 装载器) ====================
// 规格 §4.3.1:pub view 导出 + use mod.Name 导入,view 默认文件私有。
// GuiBlock 追加槽:d[7]=fileid(逐文件递增) d[8]=pub("1"/"");旧节点无槽 =
// 通配可见(内嵌形态与单文件路径零波及,访问器兜底)。
// 合并序 = DFS imports-先-自身-后(应用根=最后声明视图契约);路径集环守卫。

fn gui_blk_fileid(d: List[Str]) -> Str {
    if d.len > 7 {
        return d[7]
    }
    return ""
}

fn gui_blk_pub(d: List[Str]) -> Str {
    if d.len > 8 {
        return d[8]
    }
    return ""
}

fn gui_ctml_dir(p: Str) -> Str {
    var i: I32 = p.len - 1
    while i >= 0 {
        if byte_at(p, i) == 47 {
            return byte_slice(p, 0, i)
        }
        i -= 1
    }
    return ""
}

fn gui_ctml_mod_path(dir: Str, mod: Str) -> Str {
    if dir.len == 0 {
        return mod + ".ctml"
    }
    return dir + "/" + mod + ".ctml"
}

// use 行名称收集:点分单名 / 花括号列表(词法:逗号非单字符,缀词尾随剥)
fn gui_use_names(toks: List[Str], cur: Atomic[I32], out: List[Str]) -> I32 {
    var br: Bool = false
    while cur.load() < toks.len {
        var t: Str = toks[cur.load()]
        if t.len == 1 {
            var tb: I32 = byte_at(t, 0)
            if tb == 123 {
                br = true
                cur.store(cur.load() + 1)
                continue
            }
            if tb == 125 {
                cur.store(cur.load() + 1)
                break
            }
        }
        if t == "." {
            cur.store(cur.load() + 1)
            continue
        }
        var nm: Str = t
        if byte_at(nm, nm.len - 1) == 44 {
            nm = byte_slice(nm, 0, nm.len - 1)
        }
        if nm != "" {
            out.push(nm)
        }
        cur.store(cur.load() + 1)
        if !br {
            break
        }
    }
    return 0
}

// 独立 .ctml use 装载器(node 级合并)。返回本文件 fileid(缺文件 = -1)。
// 诊断(收集式):E8100 use 目标不存在 <path> / E8100 use 名未导出 <mod>.<Name>
fn gui_ctml_file_use(path: Str, seen: List[Str], file: List[Str], gdiags: List[Str], fid: Atomic[I32], imp_from: List[Str], imp_to: List[Str]) -> I32 {
    var si: I32 = 0
    while si < seen.len {
        if seen[si] == path {
            return 0
        }
        si += 1
    }
    // read_file 双口径:seed 解释 = Option[Str](driver_check 同款 match 形),
    // 原生发射 = Str 直返——match 形两宿通吃
    var text: Str = ""
    var ruse = read_file(path)
    match ruse {
        Some(tx) => { text = tx }
        None => { }
    }
    if text == "" {
        gdiags.push("E8100: use 目标不存在 " + path)
        return -1
    }
    seen.push(path)
    var myid: I32 = fid.load()
    fid.store(myid + 1)
    var toks = List[Str]()
    gui_ctml_tokens(text, toks)
    var nol = List[Str]()
    var noc = List[Str]()
    var dir: Str = gui_ctml_dir(path)
    var cur = Atomic[I32](0)
    while cur.load() < toks.len {
        var t: Str = toks[cur.load()]
        if t == "use" {
            cur.store(cur.load() + 1)
            if cur.load() >= toks.len {
                continue
            }
            // 词法不切点:路径整体一词("xcomp.Badge");模块 = 首段,
            // 点分尾段即单名;花括号名单形(xcomp 点大括号 A/B)名单随后续 token
            var mod: Str = toks[cur.load()]
            cur.store(cur.load() + 1)
            var dot: I32 = -1
            var ci3: I32 = 0
            while ci3 < mod.len {
                if byte_at(mod, ci3) == 46 {
                    dot = ci3
                    break
                }
                ci3 += 1
            }
            var mseg: Str = mod
            var names = List[Str]()
            if dot >= 0 {
                mseg = byte_slice(mod, 0, dot)
                var tail: Str = byte_slice(mod, dot + 1, mod.len)
                if tail != "" {
                    names.push(tail)
                }
            }
            if cur.load() < toks.len {
                var nt: Str = toks[cur.load()]
                // 花括号开符一律字节码比较(字符串裸开括号须转义,坑位在册)
                if nt.len == 1 {
                    if byte_at(nt, 0) == 123 {
                        gui_use_names(toks, cur, names)
                    }
                }
            }
            mod = mseg
            var mpath: Str = gui_ctml_mod_path(dir, mod)
            var before: I32 = file.len
            var rid: I32 = gui_ctml_file_use(mpath, seen, file, gdiags, fid, imp_from, imp_to)
            if rid >= 0 {
                imp_from.push(myid.to_string())
                imp_to.push(rid.to_string())
            }
            // 名称逐一核 pub 视图(仅并入了的本模块块段)
            var ni: I32 = 0
            while ni < names.len {
                var found: Bool = false
                var bi: I32 = before
                while bi < file.len {
                    var d = file[bi]
                    if d[0] == "GuiBlock" {
                        if d[1] == "view" {
                            if d[2] == names[ni] {
                                if gui_blk_pub(d) == "1" {
                                    found = true
                                }
                            }
                        }
                    }
                    bi += 1
                }
                if !found {
                    gdiags.push("E8100: use 名未导出 " + mod + "." + names[ni])
                }
                ni += 1
            }
            continue
        }
        var ispub: Bool = false
        if t == "pub" {
            ispub = true
            cur.store(cur.load() + 1)
            if cur.load() >= toks.len {
                continue
            }
            t = toks[cur.load()]
        }
        if t == "view" {
            var nd = gui_block(toks, cur, "view", nol, noc)
            nd.push(myid.to_string())
            if ispub {
                nd.push("1")
            } else {
                nd.push("")
            }
            file.push(nd)
            continue
        }
        if t == "style" {
            var nd2 = gui_block(toks, cur, "style", nol, noc)
            nd2.push(myid.to_string())
            nd2.push("")
            file.push(nd2)
            continue
        }
        cur.store(cur.load() + 1)
    }
    return myid
}

// 可见性判定:本文件全可见;他文件须 pub 且为本文件**直接导入**(规格=
// 显式逐级导入,不传递);无槽通配(内嵌/单文件旧节点)
fn gui_vis_ok(vf: Str, vp: Str, fid: Str, imp_from: List[Str], imp_to: List[Str]) -> Bool {
    if vf == "" {
        return true
    }
    if vf == fid {
        return true
    }
    if vp != "1" {
        return false
    }
    var i: I32 = 0
    while i < imp_from.len {
        if imp_from[i] == fid {
            if imp_to[i] == vf {
                return true
            }
        }
        i += 1
    }
    return false
}

// ==================== gui_check:检查面(W3;§4.4 E8xxx 语料验收)====================
// 收集式(不 panic/不打印):诊断行入 gdiags("E8xxx: msg"),块内首错即止。
// 结构口径与 dump lower 一致(限深 1:根=容器,子=叶子)。
// 注意:本段一律用 eat_tok(eat 旧名已弃;花括号字面量不可词法化,一律字节码比较)。

fn gui_ck_has_style(sn: List[Str], name: Str) -> Bool {
    var i: I32 = 0
    while i < sn.len {
        if sn[i] == name {
            return true
        }
        i += 1
    }
    return false
}

// 8c-1:表达式根标识符提取——每个 ident 路径的首段(点前);字符串字面量内跳过
fn gui_bx_roots(e: Str, out: List[Str]) {    var i: I32 = 0
    var instr: Bool = false
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 {
                    var start: I32 = i
                    while i < e.len {
                        var c: I32 = byte_at(e, i)
                        if c == 46 {
                            break
                        }
                        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
                            i += 1
                        } else {
                            break
                        }
                    }
                    var root: Str = byte_slice(e, start, i)
                    // 点链续段:成员访问非根,吞并 .ident 序列(model.todos.len → 根 model)
                    while i < e.len {
                        if byte_at(e, i) != 46 {
                            break
                        }
                        var j: I32 = i + 1
                        if j >= e.len {
                            break
                        }
                        var c2: I32 = byte_at(e, j)
                        if !((c2 >= 65 && c2 <= 90) || (c2 >= 97 && c2 <= 122) || c2 == 95) {
                            break
                        }
                        i = j
                        while i < e.len {
                            var c3: I32 = byte_at(e, i)
                            if c3 == 46 {
                                break
                            }
                            if (c3 >= 65 && c3 <= 90) || (c3 >= 97 && c3 <= 122) || (c3 >= 48 && c3 <= 57) || c3 == 95 {
                                i += 1
                            } else {
                                break
                            }
                        }
                    }
                    if !gui_ck_has_style(out, root) {
                        out.push(root)
                    }
                }
            }
        }
        i += 1
    }
}

// 8c-3:Fn/FnExt 节点形参个数(d[3]=Ps 子节点数,VaArgs 计一;形态外 -2)
fn gui_fn_arity(d: List[Str]) -> I32 {
    if d.len <= 3 {
        return -2
    }
    var ps = d[3]
    if ps[0] != "Ps" {
        return -2
    }
    return ps.len - 1
}

// P2 契约Ⅱ-b:Box[T] 结构判别(自包含;ct_ty_code 是 trans 面专属不可用)
fn gui_ty_is_box(t: List[Str]) -> Bool {
    if t.len > 1 {
        if t[0] == "Named" {
            if t[1] == "Box" {
                return true
            }
        }
    }
    return false
}

// P2 契约Ⅱ:名 → 形参型别头表(首匹配;未声明空表)——组件事件 ev_arg
// 解码器选型依据(Box: 前缀=模型捕获,I32→i/Bool→b/余 s)
fn gui_fn_ptyps(file: List[Str], nm: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) && d[1] == nm {
            var ps = d[3]
            var k: I32 = 1
            while k < ps.len {
                var pr = ps[k]
                if pr[0] == "Param" {
                    // Box 参数打 "Box:" 前缀标记(gui_ty_head_node 会剥 Box 返回
                    // 载荷型;ct_ty_code 是 trans 面专属,check 驱动文件集没有——
                    // gui_parse 内助手必须双驱动自包含)
                    var th: Str = gui_ty_head_node(pr[3])
                    if gui_ty_is_box(pr[3]) {
                        th = "Box:" + th
                    }
                    out.push(th)
                }
                k += 1
            }
            return out
        }
        i += 1
    }
    return out
}

// 8c-3:名 → 形参个数(首匹配;未声明 -1)
fn gui_ck_fn_argc(fns: List[Str], fna: List[I32], name: Str) -> I32 {
    var i: I32 = 0
    while i < fns.len {
        if fns[i] == name {
            return fna[i]
        }
        i += 1
    }
    return -1
}

// 8c-3:on: 事件表达式形态分析(规范化形,空白已剥)。
// 头 = 前导标识符;argc[0]: -1=单标识符(旧契约)/ -2=形态非法 / >=0=调用实参数;
// aout[0] = 调用形态实参串(括号内原文)。字符串字面量内标点不参与配对;
// 闭括号须为表达式末字节(f(a)(b) 即非法)。
fn gui_ev_head2(e: Str, argc: List[I32], aout: List[Str]) -> Str {
    var i: I32 = 0
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
            i += 1
        } else {
            break
        }
    }
    var head: Str = byte_slice(e, 0, i)
    if i == e.len {
        if head.len == 0 {
            argc.push(-2)
        } else {
            argc.push(-1)
        }
        return head
    }
    if head.len == 0 {
        argc.push(-2)
        return head
    }
    if byte_at(e, i) != 40 {
        argc.push(-2)
        return head
    }
    var j: I32 = i + 1
    var depth: I32 = 1
    var instr: Bool = false
    var commas: I32 = 0
    var seen: Bool = false
    var close: I32 = -1
    while j < e.len {
        var c: I32 = byte_at(e, j)
        if instr {
            if c == 92 {
                j += 1
            } else {
                if c == 34 {
                    instr = false
                }
            }
        } else {
            if c == 34 {
                instr = true
            } else {
                if c == 40 {
                    depth += 1
                } else {
                    if c == 41 {
                        depth -= 1
                        if depth == 0 {
                            close = j
                            break
                        }
                    } else {
                        if c == 44 {
                            if depth == 1 {
                                commas += 1
                            }
                        }
                    }
                }
            }
            if c != 32 && c != 9 && c != 10 && c != 13 {
                seen = true
            }
        }
        j += 1
    }
    if close != e.len - 1 {
        argc.push(-2)
        return head
    }
    if seen {
        argc.push(commas + 1)
    } else {
        argc.push(0)
    }
    aout.push(byte_slice(e, i + 1, close))
    return head
}

// 8c-4 地基:完整点链路径提取(含段;"m.count" 整链;字符串字面量内跳过)。
// GUI-13:subs 收下标根(ident 直随 [ 者,全点链路径)——collect 据此路由 each:
// 通道;out 与 subs 各自去重、可同名共存
fn gui_bx_dotted(e: Str, out: List[Str], subs: List[Str]) {
    var i: I32 = 0
    var instr: Bool = false
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 {
                    var start: I32 = i
                    while i < e.len {
                        var c: I32 = byte_at(e, i)
                        if c == 46 || c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
                            i += 1
                        } else {
                            break
                        }
                    }
                    var path: Str = byte_slice(e, start, i)
                    // 内建调用名(直随 ()非引用:不入 paths/subs(E8110 误报防;
                    // 白名单核对归 gui_bx_form_gate)
                    var iscall: Bool = false
                    if i < e.len {
                        if byte_at(e, i) == 40 {
                            iscall = true
                        }
                    }
                    if !iscall {
                        if !gui_ck_has_style(out, path) {
                            out.push(path)
                        }
                        if i < e.len {
                            if byte_at(e, i) == 91 {
                                if !gui_ck_has_style(subs, path) {
                                    subs.push(path)
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
}

// 8c-4 地基:props 形参类型提取——"( m: Model, n: Box[T] )" 拆 名:型原文
fn gui_props_typed(d5: Str, names: List[Str], types: List[Str]) -> I32 {
    if d5.len > 2 {
        var seg: Str = byte_slice(d5, 2, d5.len - 2)
        var pi: I32 = 0
        while pi < seg.len {
            var ps: I32 = pi
            while pi < seg.len {
                if byte_at(seg, pi) == 44 {
                    break
                }
                pi += 1
            }
            var unit: Str = byte_slice(seg, ps, pi)
            var ui: I32 = 0
            while ui < unit.len {
                if byte_at(unit, ui) == 58 {
                    var pn: Str = byte_slice(unit, 0, ui)
                    var pt: Str = byte_slice(unit, ui + 1, unit.len)
                    names.push(gui_trim(pn))
                    types.push(gui_trim(pt))
                    ui = unit.len
                }
                ui += 1
            }
            pi += 1
        }
    }
    return 0
}

// 首尾剥空白
fn gui_trim(s: Str) -> Str {
    var a: I32 = 0
    var b: I32 = s.len
    while a < b {
        var c: I32 = byte_at(s, a)
        if c == 32 || c == 9 {
            a += 1
        } else {
            break
        }
    }
    while b > a {
        var c2: I32 = byte_at(s, b - 1)
        if c2 == 32 || c2 == 9 {
            b -= 1
        } else {
            break
        }
    }
    return byte_slice(s, a, b)
}

// 型原文取头名(Box[T] 拆内层头;List/基元原样)
fn gui_ty_head_txt(t: Str) -> Str {
    var head: Str = ""
    var i: I32 = 0
    while i < t.len {
        var c: I32 = byte_at(t, i)
        if c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            head = head + byte_slice(t, i, i + 1)
            i += 1
        } else {
            break
        }
    }
    if head == "Box" {
        var lo: I32 = -1
        var k: I32 = 0
        while k < t.len {
            if byte_at(t, k) == 91 {
                lo = k
                break
            }
            k += 1
        }
        if lo >= 0 {
            return gui_ty_head_txt(gui_trim(byte_slice(t, lo + 1, t.len)))
        }
    }
    return head
}

// 8c-4 地基:props 类型门——dotted 路径段级核对(构型字段存在性;
// 尾段 len 对 List/Str 豁免;未知构型/跨包型跳过=登记边界)。
// 返回 -1 即违例(诊断已入 gdiags)
fn gui_ck_prop_path(path: Str, pnames: List[Str], ptyps: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], gdiags: List[Str], where: Str) -> I32 {
    // 拆段
    var segs = List[Str]()
    var i: I32 = 0
    var start: I32 = 0
    while i < path.len {
        if byte_at(path, i) == 46 {
            segs.push(byte_slice(path, start, i))
            start = i + 1
        }
        i += 1
    }
    segs.push(byte_slice(path, start, path.len))
    var root: Str = segs[0]
    // 根须为 prop
    if !gui_ck_has_style(pnames, root) {
        return 0
    }
    var cur: Str = ""
    var ri: I32 = 0
    while ri < pnames.len {
        if pnames[ri] == root {
            cur = gui_ty_head_txt(ptyps[ri])
            ri = pnames.len
        }
        ri += 1
    }
    // 根型未知(基元/未声明/跨包)→ 段级门跳过
    if !gui_ck_has_style(stns, cur) {
        return 0
    }
    var si: I32 = 1
    while si < segs.len {
        var seg: Str = segs[si]
        var last: Bool = si == segs.len - 1
        var fkey: Str = cur + "." + seg
        if gui_ck_has_style(sfk, fkey) {
            var fi: I32 = 0
            while fi < sfk.len {
                if sfk[fi] == fkey {
                    cur = gui_ty_head_txt(stv[fi])
                    fi = sfk.len
                }
                fi += 1
            }
        } else {
            if seg == "len" {
                if last {
                    return 0
                }
                gdiags.push("E8110: len 后缀须为路径末段 " + path + " 于 " + where)
                return -1
            }
            gdiags.push("E8110: 字段未声明 " + path + "(" + cur + " 无 " + seg + ") 于 " + where)
            return -1
        }
        si += 1
    }
    return 0
}

// 型节点取头名(Box 拆内层;Ref/Optional 穿透;其余以节点 tag 收底——非 Named
// 不入构型表即段级门自然跳过)
fn gui_ty_head_node(t: List[Str]) -> Str {
    var tag: Str = t[0]
    if tag == "Named" {
        if t[1] == "Box" {
            if t.len > 2 {
                var ta = t[2]
                if ta.len > 1 {
                    return gui_ty_head_node(ta[1])
                }
            }
        }
        return t[1]
    }
    if tag == "Ref" {
        return gui_ty_head_node(t[1])
    }
    if tag == "Optional" {
        return gui_ty_head_node(t[1])
    }
    return tag
}

// 8c-4 地基:绑定/事件实参表达式统一引用门——props 视图内:
//   根 ∈ each 项 scope → 不设门;根 ∈ prop → 段级类型门;否则根越界 E8110。
// 裸名单视图(props 空)零设门(8c-1 契约)
// GUI-13:视图表达式形态门——下标括号平衡(串字面量感知)+ 内建调用名白名单
// (词表 = 域包 bxv_call 分发同源,新增双侧同步);违规 E8195 编译期拦截,
// 运行时 bxv 同文法 panic 兜底。on: 事件槽豁免(不经本门,与 E8190 同规)
fn gui_bx_form_gate(e: Str, gdiags: List[Str], where: Str) -> I32 {
    var i: I32 = 0
    var instr: Bool = false
    var depth: I32 = 0
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if b == 91 {
                    depth += 1
                } else {
                    if b == 93 {
                        depth -= 1
                        if depth < 0 {
                            gdiags.push("E8195: 视图表达式下标括号不匹配 " + where)
                            return -1
                        }
                    } else {
                        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 {
                            var start: I32 = i
                            while i < e.len {
                                var c: I32 = byte_at(e, i)
                                if c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
                                    i += 1
                                } else {
                                    break
                                }
                            }
                            var name: Str = byte_slice(e, start, i)
                            var j: I32 = i
                            while j < e.len {
                                var w: I32 = byte_at(e, j)
                                if w == 32 || w == 9 {
                                    j += 1
                                } else {
                                    break
                                }
                            }
                            if j < e.len {
                                if byte_at(e, j) == 40 {
                                    if !(name == "cut" || name == "fld" || name == "sethas" || name == "contains") {
                                        gdiags.push("E8195: 视图表达式未知内建 " + name + " 于 " + where)
                                        return -1
                                    }
                                }
                            }
                            continue
                        }
                    }
                }
            }
        }
        i += 1
    }
    if depth != 0 {
        gdiags.push("E8195: 视图表达式下标括号不匹配 " + where)
        return -1
    }
    return 0
}

fn gui_ck_bx_gate(e: Str, props: List[Str], ptyps: List[Str], pscope: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], gdiags: List[Str], where: Str) -> I32 {
    // GUI-13:形态门先于 props 门——裸名通道视图同样受内建白名单/括号平衡约束
    if gui_bx_form_gate(e, gdiags, where) < 0 {
        return -1
    }
    if props.len == 0 {
        return 0
    }
    var bad: I32 = 0
    var paths = List[Str]()
    var subs = List[Str]()
    gui_bx_dotted(e, paths, subs)
    var ii: I32 = 0
    while ii < paths.len {
        var p: Str = paths[ii]
        var root: Str = p
        var di: I32 = 0
        while di < p.len {
            if byte_at(p, di) == 46 {
                root = byte_slice(p, 0, di)
                di = p.len
            }
            di += 1
        }
        if gui_ck_has_style(pscope, root) {
            // each 项变量:项文本直取,不设门
        } else {
            if gui_ck_has_style(props, root) {
                if gui_ck_prop_path(p, props, ptyps, stns, sfk, stv, gdiags, where) < 0 {
                    bad = -1
                }
            } else {
                gdiags.push("E8110: 绑定引用未声明(须 prop/each 项) " + root + " 于 " + where)
                bad = -1
            }
        }
        ii += 1
    }
    return bad
}

fn gui_ck_color(v: Str, gdiags: List[Str]) -> I32 {
    if v.len != 7 {
        gdiags.push("E8130: 颜色须 #RRGGBB,得 " + v)
        return -1
    }
    if byte_at(v, 0) != 35 {
        gdiags.push("E8130: 颜色须 # 开头,得 " + v)
        return -1
    }
    var i: I32 = 1
    while i < 7 {
        var b: I32 = byte_at(v, i)
        var ok: Bool = b >= 48 && b <= 57
        if !ok {
            if b >= 97 {
                if b <= 102 {
                    ok = true
                }
            }
        }
        if !ok {
            if b >= 65 {
                if b <= 70 {
                    ok = true
                }
            }
        }
        if !ok {
            gdiags.push("E8130: 颜色含非十六进制字符,得 " + v)
            return -1
        }
        i += 1
    }
    return 0
}

fn gui_ck_tag(tag: Str, gdiags: List[Str]) -> I32 {
    // 白名单对齐域包 rt_emit 认领面(gui.ct):容器/叶子/包装元素
    if tag == "vbox" {
        return 0
    }
    if tag == "hbox" {
        return 0
    }
    if tag == "label" {
        return 0
    }
    if tag == "button" {
        return 0
    }
    if tag == "when" {
        return 0
    }
    if tag == "each" {
        return 0
    }
    if tag == "input" {
        return 0
    }
    if tag == "checkbox" {
        return 0
    }
    if tag == "spacer" {
        return 0
    }
    if tag == "slot" {
        // P2 投影锚:组件体内容注点位(运行时拼接实例子树)
        return 0
    }
    var fb3: I32 = byte_at(tag, 0)
    if fb3 >= 65 {
        if fb3 <= 90 {
            // ViewCall 组件实例(大写首字母;波次四)——完整 attr/props 契约
            // 检查随组件检查专项,此处仅认领不误报
            return 0
        }
    }
    gdiags.push("E8100: 未声明标签 " + tag)
    return -1
}

// SL-6(M1-d 合流):递归元素走查(镜像 gui_lower 结构;限深 8 守卫)。
// 认领:when cond 绑定名 / each item 位置头(in= 绑定列表名) / input bind 绑定名自闭合 /
// 花括号属性值(单词 = 绑定名通道)。诊断:
//   E8100 未知标签/闭合不匹配/props 缺失(when 无 cond、input 无 bind、each 无 in)
//   E8110 cond/bind/in 属性契约形态(须花括号绑定名,字符串即绑定期物不符);
//        8c-3 扩:on: 事件表达式形态(仅路径/调用)与实参根门(props 视图)
//   E8120 on: 处理器未声明;8c-3 扩:调用形态实参个数 vs 声明形参(签名门;
//        单标识符旧契约仅存在性;indep 独立形态两门均跳)
//   E8193 each 体含 input 型控件(警告入 gwarns,不置 rc;key 原语未落地前索引对齐即串位)
// sawin = 子树 input 计数累加器(Atomic;each 据此发 E8193,嵌套 each 各自报)。
// GUI-27:实例可见性门。返回 0=可见/可深查;-1=不可见(诊断已入列)。
// 未知(不在 vr_nm)= E8100 未声明组件;他文件非 pub 或未直导 = E8100 未导入组件
fn gui_ck_view_vis(tag: Str, vr_nm: List[Str], vr_file: List[Str], vr_pub: List[Str], vfid: Str, imp_from: List[Str], imp_to: List[Str], gdiags: List[Str]) -> I32 {
    var i: I32 = 0
    while i < vr_nm.len {
        if vr_nm[i] == tag {
            if gui_vis_ok(vr_file[i], vr_pub[i], vfid, imp_from, imp_to) {
                return 0
            }
            gdiags.push("E8100: 未导入组件 " + tag + "(私有 view 须经 pub 导出并 use 导入)")
            return -1
        }
        i += 1
    }
    gdiags.push("E8100: 未声明组件 " + tag)
    return -1
}

fn gui_ck_elem(tks: List[Str], cur: Atomic[I32], sn: List[Str], fns: List[Str], fna: List[I32], gdiags: List[Str], gwarns: List[Str], depth: I32, sawin: Atomic[I32], indep: Bool, props: List[Str], ptyps: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], pscope: List[Str], vr_nm: List[Str], vr_pp: List[Str], vr_file: List[Str], vr_pub: List[Str], vfid: Str, imp_from: List[Str], imp_to: List[Str], iscomp: Bool, fbox: List[Str]) -> I32 {
    var bad: I32 = 0
    if depth > 8 {
        gdiags.push("E8100: 嵌套超限(限深 8)")
        return -1
    }
    var tag: Str = eat_tok(tks, cur)
    if gui_ck_tag(tag, gdiags) < 0 {
        bad = -1
    }
    if tag == "input" {
        sawin.store(sawin.load() + 1)
    }
    // 子树词法作用域:each 项变量入内(8c-1;非 each 视图共享外层 scope 列表)
    var cscope: List[Str] = pscope
    if tag == "each" {
        // 位置头:item in={列表}(域包先于 attrs 解析,镜像)
        if cur.load() < tks.len {
            var it: Str = tks[cur.load()]
            if it != ">" {
                if it != "/" {
                    cur.store(cur.load() + 1)
                    cscope = List[Str]()
                    var si: I32 = 0
                    while si < pscope.len {
                        cscope.push(pscope[si])
                        si += 1
                    }
                    cscope.push(it)
                }
            }
        }
    }
    // P2 组件实例深查(大写首字母):args `名: 值` 三形逐参核组件声明 prop 表
    // (未知=E8110/缺失=E8100);{表达式} 值走宿主根门(与 attr 槽同规);非
    // 自闭合投影子树递归(宿主上下文,slot 语义同骨架面)。此支先于通用
    // attrs 循环——实例实参 `名: 值` 非 attr=值 形,通用循环会错位误报
    var fb4: I32 = byte_at(tag, 0)
    if fb4 >= 65 {
        if fb4 <= 90 {
            // GUI-27:导入可见性门(独立 ctml 形态;无槽通配=恒过)。未知 =
            // E8100 未声明组件;他文件非 pub 或未直导 = E8100 未导入组件。
            // 门不过则后续 props 深查静默(消未知视图逐参 E8110 噪声)
            var vok: I32 = 0
            if indep {
                vok = gui_ck_view_vis(tag, vr_nm, vr_file, vr_pub, vfid, imp_from, imp_to, gdiags)
                if vok < 0 {
                    bad = -1
                }
            }
            var passed = List[Str]()
            while cur.load() < tks.len {
                var pk3: Str = tks[cur.load()]
                if pk3.len == 1 {
                    var pb3: I32 = byte_at(pk3, 0)
                    if or2(pb3 == 62, pb3 == 47) {
                        break
                    }
                }
                var pn2: Str = eat_tok(tks, cur)
                eat_tok(tks, cur)
                var brf: Bool = false
                if cur.load() < tks.len {
                    var vw2: Str = tks[cur.load()]
                    if vw2.len == 1 {
                        if byte_at(vw2, 0) == 123 {
                            cur.store(cur.load() + 1)
                            var ev2: Str = gui_bx_expr(tks, cur)
                            brf = true
                            if gui_ck_bx_gate(ev2, props, ptyps, pscope, stns, sfk, stv, gdiags, "实例prop:" + pn2) < 0 {
                                bad = -1
                            }
                        } else {
                            eat_tok(tks, cur)
                        }
                    } else {
                        eat_tok(tks, cur)
                    }
                }
                var cpi: I32 = 0
                var found = false
                while cpi < vr_nm.len {
                    if vr_nm[cpi] == tag {
                        var cp2: Str = vr_pp[cpi]
                        var ci: I32 = 0
                        var cos: I32 = 0
                        while ci <= cp2.len {
                            if ci == cp2.len {
                                if ci > cos {
                                    if byte_slice(cp2, cos, ci) == pn2 {
                                        found = true
                                    }
                                }
                                ci += 1
                            } else {
                                if byte_at(cp2, ci) == 1 {
                                    if ci > cos {
                                        if byte_slice(cp2, cos, ci) == pn2 {
                                            found = true
                                        }
                                    }
                                    cos = ci + 1
                                }
                                ci += 1
                            }
                        }
                        cpi = vr_nm.len
                    }
                    cpi += 1
                }
                if !found {
                    // GUI-27:门不过(未知/不可见)时 E8100 已入列,props 逐参 E8110 静默
                    if vok >= 0 {
                        gdiags.push("E8110: 实例未知 prop " + pn2 + "(组件 " + tag + " 未声明)")
                        bad = -1
                    }
                }
                passed.push(pn2)
            }
            var selfc3: Bool = false
            if cur.load() < tks.len {
                var cw4: Str = tks[cur.load()]
                if cw4.len == 1 {
                    if byte_at(cw4, 0) == 47 {
                        cur.store(cur.load() + 1)
                        selfc3 = true
                    }
                }
            }
            if cur.load() < tks.len {
                cur.store(cur.load() + 1)
            }
            // 缺失 prop 门:组件声明而实例未传
            var cpi2: I32 = 0
            while cpi2 < vr_nm.len {
                if vr_nm[cpi2] == tag {
                    var cp3: Str = vr_pp[cpi2]
                    var ci2: I32 = 0
                    var cos2: I32 = 0
                    while ci2 <= cp3.len {
                        if ci2 == cp3.len {
                            if ci2 > cos2 {
                                var want: Str = byte_slice(cp3, cos2, ci2)
                                var got: I32 = 0
                                var gi2: I32 = 0
                                while gi2 < passed.len {
                                    if passed[gi2] == want {
                                        got = 1
                                    }
                                    gi2 += 1
                                }
                                if got == 0 {
                                    // GUI-27:门不过时缺 prop 亦静默(E8100 已入列)
                                    if vok >= 0 {
                                        gdiags.push("E8100: 实例缺 prop " + want + "(组件 " + tag + ")")
                                        bad = -1
                                    }
                                }
                            }
                            ci2 += 1
                        } else {
                            if byte_at(cp3, ci2) == 1 {
                                cos2 = ci2 + 1
                            }
                            ci2 += 1
                        }
                    }
                    cpi2 = vr_nm.len
                }
                cpi2 += 1
            }
            if !selfc3 {
                while cur.load() < tks.len {
                    var pk4: Str = tks[cur.load()]
                    if pk4.len == 1 {
                        if byte_at(pk4, 0) == 60 {
                            if cur.load() + 1 < tks.len {
                                var nk3: Str = tks[cur.load() + 1]
                                if nk3.len == 1 {
                                    if byte_at(nk3, 0) == 47 {
                                        cur.store(cur.load() + 2)
                                        if cur.load() < tks.len {
                                            var et3: Str = eat_tok(tks, cur)
                                            if et3 != tag {
                                                gdiags.push("E8100: 闭合标签不匹配 " + et3)
                                                bad = -1
                                            }
                                        }
                                        if cur.load() < tks.len {
                                            var gt2: Str = tks[cur.load()]
                                            if gt2.len == 1 {
                                                if byte_at(gt2, 0) == 62 {
                                                    cur.store(cur.load() + 1)
                                                }
                                            }
                                        }
                                        break
                                    }
                                }
                            }
                            // 实例子树先吃开尖再递归(镜像通用容器递归;此前
                            // tag 吃到 "<" 脱轨级联误报——实例带子树从未入语料
                            // 的存量缺口,GUI-27 投影夹具首曝)
                            cur.store(cur.load() + 1)
                        }
                    }
                    var cb2: I32 = gui_ck_elem(tks, cur, sn, fns, fna, gdiags, gwarns, depth + 1, sawin, indep, props, ptyps, stns, sfk, stv, cscope, vr_nm, vr_pp, vr_file, vr_pub, vfid, imp_from, imp_to, iscomp, fbox)
                    if cb2 < 0 {
                        bad = -1
                    }
                }
            }
            return bad
        }
    }
    var has_cond: Bool = false
    var has_bind: Bool = false
    var has_in: Bool = false
    var has_checked: Bool = false
    var selfc: Bool = false
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 62 {
                cur.store(cur.load() + 1)
                break
            }
            if pb == 47 {
                cur.store(cur.load() + 1)
                selfc = true
                break
            }
        }
        var an: Str = eat_tok(tks, cur)
        if an == "hover" {
            // S3:hover:名 裸属性——检查面放行(消费 token 不产 IR);
            // 生效面=内嵌形态(域包 gt_attrs 入事件表);文件形态忽略=登记限制
            if eat_tok(tks, cur) != ":" {
                panic("gui E8100: hover 期待冒号")
            }
            eat_tok(tks, cur)
        } else {
        if an == "password" {
            // input 变体裸属性——检查面放行;sk 面入事件表(见 gui_sk_attrs)
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "numeric" {
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "switch" {
            // checkbox 变体裸属性(药丸滑块)——检查面放行;sk 面入事件表
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "radio" {
            // checkbox 变体裸属性(单选圆钮)——同 switch 承载
            if cur.load() < tks.len {
                if tks[cur.load()] == ":" {
                    eat_tok(tks, cur)
                    eat_tok(tks, cur)
                }
            }
        } else {
        if an == "on" {
            // on:名=花括号事件表达式:块开逐 token 校验(曾盲吃 5 漏收尾闭,W3 口径),
            // 块体 8c-3 平衡捕获(单标识符旧契约为特例;配对 } 由捕获消费)
            if eat_tok(tks, cur) != ":" {
                gdiags.push("E8100: on 期待冒号")
                bad = -1
            }
            var evn: Str = eat_tok(tks, cur)
            var hn: Str = ""
            if eat_tok(tks, cur) != "=" {
                gdiags.push("E8100: on 期待等号")
                bad = -1
            } else {
                var ob: Str = eat_tok(tks, cur)
                if ob.len >= 2 {
                    if byte_at(ob, 0) == 34 {
                        // GUI-15:on:after="ms:handler" 引号串事件——仅 after 受持;
                        // 形态 = 非零毫秒:简单名(E8120 处理器存在门沿用)
                        if evn != "after" {
                            gdiags.push("E8110: on:" + evn + " 不受持引号事件(仅 after) ")
                            bad = -1
                        } else {
                            var qv: Str = byte_slice(ob, 1, ob.len - 1)
                            var ci2: I32 = 0
                            while ci2 < qv.len {
                                if byte_at(qv, ci2) == 58 {
                                    break
                                }
                                ci2 += 1
                            }
                            var msok: Bool = ci2 > 0 && ci2 < qv.len
                            if msok {
                                var mi: I32 = 0
                                while mi < ci2 {
                                    var mb: I32 = byte_at(qv, mi)
                                    if mb < 48 || mb > 57 {
                                        msok = false
                                        mi = ci2
                                    }
                                    mi += 1
                                }
                                var mv: I32 = 0
                                var mi2: I32 = 0
                                while mi2 < ci2 {
                                    mv = mv * 10 + (byte_at(qv, mi2) - 48)
                                    mi2 += 1
                                }
                                if mv <= 0 {
                                    msok = false
                                }
                                var hd: Str = byte_slice(qv, ci2 + 1, qv.len)
                                if !gui_ck_has_style(fns, hd) {
                                    gdiags.push("E8120: 事件处理器未声明 " + hd + "(on:" + evn + ")")
                                    bad = -1
                                    msok = false
                                }
                            }
                            if !msok {
                                gdiags.push("E8110: on:after 期待 \"毫秒:处理器名\" 得 " + qv)
                                bad = -1
                            }
                            hn = " "
                        }
                    }
                }
                if ob.len == 1 {
                    if byte_at(ob, 0) != 123 {
                        gdiags.push("E8100: on 期待块开")
                        bad = -1
                    } else {
                        hn = gui_bx_expr(tks, cur)
                    }
                }
            }
            if hn == "" {
                gdiags.push("E8100: on 事件表达式为空")
                bad = -1
            }
            if hn != "" {
                // 8c-3 事件表达式门:形态(单标识符旧契约 / 调用形态)+ E8120
                // 存在与签名(实参个数 vs 声明形参;indep 独立形态处理函数在
                // 伴生 .ct,跳过)+ E8110 实参根门(props 视图,复用 8c-1 通道)
                var argc = List[I32]()
                var aout = List[Str]()
                var head: Str = gui_ev_head2(hn, argc, aout)
                if argc[0] == -2 {
                    gdiags.push("E8110: on: 事件表达式仅路径或调用形态 " + hn + "(on:" + evn + ")")
                    bad = -1
                } else {
                    if argc[0] == -1 {
                        // indep = 独立 .ctml 形态(处理函数在伴生 .ct,跨文件解析 SL-7+)
                        // ——跳过存在性检查;内嵌形态恒严格核对(与 Fn 表有无无关)
                        if !indep {
                            if !gui_ck_has_style(fns, hn) {
                                gdiags.push("E8120: 事件处理器未声明 " + hn + "(on:" + evn + ")")
                                bad = -1
                            }
                        }
                    } else {
                        if !indep {
                            var da: I32 = gui_ck_fn_argc(fns, fna, head)
                            // 8c-4④:on:input(input 元素)隐式尾参 text——全文经
                            // 名通道("头名:全文")送达,花括号实参 +1 豁免
                            var imp: I32 = 0
                            if evn == "input" {
                                if tag == "input" {
                                    imp = 1
                                }
                                if tag == "textarea" {
                                    imp = 1
                                }
                            }
                            if evn == "submit" {
                                if tag == "input" {
                                    // on:submit 隐式尾参 value——回车提交经名通道
                                    // ("头名:值")送达,镜像 on:input 契约
                                    imp = 1
                                }
                            }
                            if pscope.len > 0 {
                                // each 体内事件隐式实例下标(P-H1 "名:下标" 命中契约)
                                imp += 1
                            }
                            // 契约Ⅱ-b:组件视图事件首参 Box = 模型捕获直传(合成面
                            // gen 同规)——声明形参 = 表达式实参 + 1
                            if iscomp {
                                if gui_ck_has_style(fbox, head) {
                                    imp += 1
                                }
                            }
                            if da < 0 {
                                gdiags.push("E8120: 事件处理器未声明 " + head + "(on:" + evn + ")")
                                bad = -1
                            } else {
                                if da != argc[0] + imp {
                                    gdiags.push("E8120: 事件签名不匹配 " + head + "(实参 " + argc[0].to_string() + ",声明 " + da.to_string() + ")(on:" + evn + ")")
                                    bad = -1
                                }
                            }
                        }
                        if gui_ck_bx_gate(aout[0], props, ptyps, pscope, stns, sfk, stv, gdiags, "on:" + evn + "=\{" + hn + "}") < 0 {
                            bad = -1
                        }
                    }
                }
            }
        } else {
            if eat_tok(tks, cur) != "=" {
                gdiags.push("E8100: 属性期待等号")
                bad = -1
            } else {
                var av: Str = ""
                var brform: Bool = false
                if cur.load() < tks.len {
                    var pv: Str = tks[cur.load()]
                    if pv.len == 1 {
                        if byte_at(pv, 0) == 123 {
                            cur.store(cur.load() + 1)
                            av = gui_bx_expr(tks, cur)
                            if av == "" {
                                gdiags.push("E8100: 花括号属性期待表达式")
                                bad = -1
                            }
                            brform = true
                            if gui_bx_impure(av) {
                                gdiags.push("E8190: 绑定表达式纯度违规(赋值/自增减) " + an + "=\{" + av + "}")
                                bad = -1
                            }
                            // 8c-1:prop 引用门——props 视图内,路径根须为已声明
                            // prop 或 each 项变量(裸名通道视图不设门,零破坏)
                            if gui_ck_bx_gate(av, props, ptyps, pscope, stns, sfk, stv, gdiags, an + "=\{" + av + "}") < 0 {
                                bad = -1
                            }
                        }
                    }
                }
                if !brform {
                    if cur.load() < tks.len {
                        av = gui_unq(eat_tok(tks, cur))
                    }
                }
                if an == "class" {
                    if !gui_ck_has_style(sn, av) {
                        gdiags.push("E8150: class 引用未定义样式 " + av)
                        bad = -1
                    }
                }
                if an == "cond" {
                    has_cond = true
                    if !brform {
                        gdiags.push("E8110: cond 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "bind" {
                    has_bind = true
                    if !brform {
                        gdiags.push("E8110: bind 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "in" {
                    has_in = true
                    if !brform {
                        gdiags.push("E8110: in 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "checked" {
                    has_checked = true
                    if !brform {
                        gdiags.push("E8110: checked 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
            }
        }
        }
        }
        }
        }
        }
    }
    if tag == "when" {
        if !has_cond {
            gdiags.push("E8100: when 缺 cond")
            bad = -1
        }
    }
    if tag == "input" {
        if !has_bind {
            gdiags.push("E8100: input 缺 bind")
            bad = -1
        }
    }
    if tag == "checkbox" {
        if !has_checked {
            gdiags.push("E8100: checkbox 缺 checked")
            bad = -1
        }
    }
    if tag == "each" {
        if !has_in {
            gdiags.push("E8100: each 缺 in")
            bad = -1
        }
    }
    if selfc {
        return bad
    }
    var in_before: I32 = sawin.load()
    while cur.load() < tks.len {
        var pk2: Str = tks[cur.load()]
        if pk2.len == 1 {
            var b2: I32 = byte_at(pk2, 0)
            if b2 == 60 {
                // <:子元素或本元素闭合
                if cur.load() + 1 < tks.len {
                    var nk: Str = tks[cur.load() + 1]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 47 {
                            cur.store(cur.load() + 2)
                            if cur.load() < tks.len {
                                var et: Str = eat_tok(tks, cur)
                                if et != tag {
                                    gdiags.push("E8100: 闭合标签不匹配 " + et)
                                    bad = -1
                                }
                            }
                            if cur.load() < tks.len {
                                var gt: Str = tks[cur.load()]
                                if gt.len == 1 {
                                    if byte_at(gt, 0) == 62 {
                                        cur.store(cur.load() + 1)
                                    }
                                }
                            }
                            break
                        }
                    }
                }
                cur.store(cur.load() + 1)
                var cb: I32 = gui_ck_elem(tks, cur, sn, fns, fna, gdiags, gwarns, depth + 1, sawin, indep, props, ptyps, stns, sfk, stv, cscope, vr_nm, vr_pp, vr_file, vr_pub, vfid, imp_from, imp_to, iscomp, fbox)
                if cb < 0 {
                    bad = -1
                }
            } else {
                if b2 == 35 {
                    gdiags.push("E8100: 未终止 " + tag)
                    bad = -1
                    break
                }
                if b2 == 123 {
                    // 叶插值槽(8c-1):平衡捕获 + prop 引用门(与 attr 槽同规)
                    cur.store(cur.load() + 1)
                    var lv: Str = gui_bx_expr(tks, cur)
                    if gui_ck_bx_gate(lv, props, ptyps, pscope, stns, sfk, stv, gdiags, "叶") < 0 {
                        bad = -1
                    }
                    continue
                }
                cur.store(cur.load() + 1)
            }
        } else {
            cur.store(cur.load() + 1)
        }
    }
    if tag == "each" {
        if sawin.load() > in_before {
            gwarns.push("E8193: each 体含 input,索引对齐重排将串位(key 原语未落地)")
        }
    }
    return bad
}

// 8c-1/8c-2:view props 形参名表——"( a: T, b: U )" 形态拆名(类型段弃,
// 字段段类型门登记待 props 类型面)。check 面引用门与骨架表(s22 双端同形)共用。
fn gui_props_names(d5: Str, out: List[Str]) -> I32 {
    if d5.len > 2 {
        var seg: Str = byte_slice(d5, 2, d5.len - 2)
        var pi: I32 = 0
        while pi < seg.len {
            var ps: I32 = pi
            while pi < seg.len {
                if byte_at(seg, pi) == 44 {
                    break
                }
                pi += 1
            }
            var unit: Str = byte_slice(seg, ps, pi)
            var ui: I32 = 0
            while ui < unit.len {
                if byte_at(unit, ui) == 58 {
                    var pn: Str = byte_slice(unit, 0, ui)
                    var pe: I32 = pn.len
                    while pe > 0 {
                        var pc: I32 = byte_at(pn, pe - 1)
                        if pc == 32 || pc == 9 {
                            pe -= 1
                        } else {
                            break
                        }
                    }
                    var psi: I32 = 0
                    while psi < pe {
                        if byte_at(pn, psi) != 32 && byte_at(pn, psi) != 9 {
                            break
                        }
                        psi += 1
                    }
                    if pe > psi {
                        out.push(byte_slice(pn, psi, pe))
                    }
                    ui = unit.len
                }
                ui += 1
            }
            pi += 1
        }
    }
    return 0
}

fn gui_check_file(file: List[Str], gdiags: List[Str], gwarns: List[Str], indep: Bool, imp_from: List[Str], imp_to: List[Str]) -> I32 {
    // 第一遍:样式名表 + Fn/FnExt 名表与形参个数表(E8120 存在/签名门依据)
    var sn = List[Str]()
    var fns = List[Str]()
    var fna = List[I32]()
    var sext = List[Str]()
    // 组件注册表(P2 实例深查):视图名 → 声明 prop 名表(0x01 连接)——
    // 实例实参名核对/缺失 prop 门依据;视图可居后被用模块(跨文件)亦可本文件
    var vr_nm = List[Str]()
    var vr_pp = List[Str]()
    // GUI-27:可见性平行表(d[7]=fileid d[8]=pub;无槽=通配 "")
    var vr_file = List[Str]()
    var vr_pub = List[Str]()
    // 契约Ⅱ-b:desugar 靶视图名(run(<Ident>) 标记检出;无标记="")与
    // Box 首参处理器名表——组件视图事件首参 Box = 模型捕获 +1 豁免依据
    var tgt: Str = gui_ds_marker_file(file)
    var fbox = List[Str]()
    var vri: I32 = 1
    while vri < file.len {
        var vd = file[vri]
        if vd[0] == "Fn" || vd[0] == "FnPub" || vd[0] == "FnExt" || vd[0] == "FnC" {
            if vd.len > 3 {
                if vd[3].len > 1 {
                    var p0 = vd[3][1]
                    if p0[0] == "Param" {
                        if p0.len > 3 {
                            if gui_ty_is_box(p0[3]) {
                                fbox.push(vd[1])
                            }
                        }
                    }
                }
            }
        }
        if vd[0] == "GuiBlock" {
            if vd[1] == "view" {
                vr_nm.push(vd[2])
                vr_file.push(gui_blk_fileid(vd))
                vr_pub.push(gui_blk_pub(vd))
                var pp2 = List[Str]()
                if vd.len > 5 {
                    gui_props_names(vd[5], pp2)
                }
                var joined: Str = ""
                var pj: I32 = 0
                while pj < pp2.len {
                    if pj > 0 {
                        joined = joined + utf8_enc(1)
                    }
                    joined = joined + pp2[pj]
                    pj += 1
                }
                vr_pp.push(joined)
            }
        }
        vri += 1
    }
    // 8c-4 地基:构型字段表(stns=构型名 sfk=构型.字段 stv=字段型头)——段级类型门依据
    var stns = List[Str]()
    var sfk = List[Str]()
    var stv = List[Str]()
    var si: I32 = 1
    while si < file.len {
        var ds = file[si]
        if ds[0] == "GuiBlock" {
            if ds[1] == "style" {
                var stks = List[Str]()
                gui_split(ds[4], stks)
                sn.push(stks[0])
                // P-W2:extends 对收集(第二遍做环/缺父诊断)
                if stks.len > 2 {
                    if stks[1] == "extends" {
                        sext.push(stks[0])
                        sext.push(stks[2])
                    }
                }
            }
        }
        if ds[0] == "Fn" {
            if ds.len > 1 {
                fns.push(ds[1])
                fna.push(gui_fn_arity(ds))
            }
        }
        if ds[0] == "Struct" {
            if ds.len > 4 {
                var fsx = ds[4]
                var fi: I32 = 1
                while fi < fsx.len {
                    var fd = fsx[fi]
                    if fd[0] == "Field" {
                        stns.push(ds[1])
                        sfk.push(ds[1] + "." + fd[2])
                        stv.push(gui_ty_head_node(fd[3]))
                    }
                    fi += 1
                }
            }
        }
        if ds[0] == "FnExt" {
            if ds.len > 1 {
                fns.push(ds[1])
                fna.push(gui_fn_arity(ds))
            }
        }
        si += 1
    }
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                // 8c-1:props 形参表(d[5],"( a: T, b: U )" 形)解析为名表
                var vprops = List[Str]()
                var vptyps = List[Str]()
                if d.len > 5 {
                    gui_props_typed(d[5], vprops, vptyps)
                }
                cur.store(1)
                if eat_tok(tks, cur) != "<" {
                    gdiags.push("E8100: view 期待 <")
                } else {
                var sawin = Atomic[I32](0)
                var emptyscope = List[Str]()
                // 契约Ⅱ-b:靶视图=宿主语义(无模型豁免),其余视图=组件(首参
                // Box 捕获 +1 豁免);无 run(<Ident>) 标记的程序全视图严格(旧契
                // 约,无合成面)
                var iscomp: Bool = false
                if tgt != "" {
                    if d[2] != tgt {
                        iscomp = true
                    }
                }
                // GUI-27:本视图所属 fileid(可见性基准;无槽=通配 "")
                var vfid: Str = gui_blk_fileid(d)
                gui_ck_elem(tks, cur, sn, fns, fna, gdiags, gwarns, 1, sawin, indep, vprops, vptyps, stns, sfk, stv, emptyscope, vr_nm, vr_pp, vr_file, vr_pub, vfid, imp_from, imp_to, iscomp, fbox)
                }
            } else {
                if d[1] == "style" {
                    // joined 以名字开头(tks[0]),与 view 路径同样跳过——
                    // 否则属性错位一位:冒号误报 + 游标越界,整个检查崩溃丢诊断(W3 修复)
                    cur.store(1)
                    // P-W2:extends 跳过(诊断在主循环后统一做)
                    if cur.load() < tks.len {
                        if tks[cur.load()] == "extends" {
                            cur.store(cur.load() + 2)
                        }
                    }
                    while cur.load() < tks.len {
                        var pp: Str = eat_tok(tks, cur)
                        if eat_tok(tks, cur) != ":" {
                            gdiags.push("E8130: style 期待冒号")
                        }
                        var vv: Str = gui_unq(eat_tok(tks, cur))
                        if pp == "bg" {
                            gui_ck_color(vv, gdiags)
                        }
                        if cur.load() < tks.len {
                            if tks[cur.load()] == ";" {
                                eat_tok(tks, cur)
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    // P-W2:extends 诊断——缺父(E8100)+ 环(E8100;镜像域包走查)
    var xi: I32 = 0
    while xi < sext.len {
        if !gui_ck_has_style(sn, sext[xi + 1]) {
            gdiags.push("E8100: extends 父样式未声明 " + sext[xi] + " extends " + sext[xi + 1])
        }
        xi += 2
    }
    xi = 0
    while xi < sext.len {
        var cur2: Str = sext[xi]
        var step: I32 = 0
        var cyc: Bool = true
        while step <= sext.len {
            var found: Bool = false
            var pi: I32 = 0
            while pi < sext.len {
                if sext[pi] == cur2 {
                    cur2 = sext[pi + 1]
                    found = true
                    pi = sext.len
                }
                pi += 2
            }
            if !found {
                cyc = false
                step = sext.len + 1
            }
            step += 1
        }
        if cyc {
            gdiags.push("E8100: 样式 extends 环 " + sext[xi])
        }
        xi += 2
    }
    return 0
}

// ==================== SL-7β1:编译期骨架解析(镜像 gui.ct gt_parse)====================
// GuiBlock token 流 → GuiTree 15 字段平行表。与运行时 gt_parse 的树等价由
// s22_sk_equiv 夹具双端差分锁定(编译器 dump vs 域包 sk_dump)。语义镜像:
// 节点 id = push 序;when = 带旗容器(cond 名自持);each 节点 npre=列表名 nbid=itemvar;
// 叶文本 pre/bind/post 按 {ident} 三段(词流单空格拼接,词法切分标点文本为已登记偏差);
// 事件槽 nes/nec = ev_name/ev_fn 的 [起,计) 切片;button 注册 btns;style sk=名.属性 sv=值。
// 语法缝:token 流为裸切分形态(</ 与 ={ 无粘连,本 builder 按独立 token 消费)。

fn gui_sk_word(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    // 剥 W1 join 行尾标记 ~:gs2i 等数值解析不认("8~" → 158),样式/文本均受害
    if t.len > 1 {
        if byte_at(t, t.len - 1) == 126 {
            t = byte_slice(t, 0, t.len - 1)
        }
    }
    return t
}

// SL-8a:花括号槽表达式捕获——平衡消费至配对 },token 直拼即规范形
// (W1 token 不携带空白,唯字符串字面量内例外;与域包源字节剥空白捕获同规范形,
// 对两侧词法粒度不变——s22 双端差分锁)。字符串 token(引号开头)的内部花括号不参与配对。
fn gui_bx_expr(tks: List[Str], cur: Atomic[I32]) -> Str {
    var out: Str = ""
    var depth: I32 = 1
    while cur.load() < tks.len {
        var t: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if t.len > 1 {
            if byte_at(t, t.len - 1) == 126 {
                t = byte_slice(t, 0, t.len - 1)
            }
        }
        var isstr: Bool = false
        if t.len > 0 {
            if byte_at(t, 0) == 34 {
                isstr = true
            }
        }
        if !isstr {
            if t.len == 1 {
                var tb: I32 = byte_at(t, 0)
                if tb == 123 {
                    depth += 1
                } else {
                    if tb == 125 {
                        depth -= 1
                        if depth == 0 {
                            return out
                        }
                    }
                }
            }
        }
        out = out + t
    }
    return out
}

// SL-8a E8190 纯读门:规范化表达式的 token 可判定变异形态(赋值/复合赋值/自增减)
// 即违例;==/!=/<=/>= 比较与字符串字面量内容豁免。on: 槽不进此门(自动闭包,8c)。
// 已知边界(登记):`a - -b`(负字面量二元减)与 `a + +b` 会误报——以 let 拆解绕行。
fn gui_bx_impure(e: Str) -> Bool {
    var i: I32 = 0
    var instr: Bool = false
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if b == 61 {
                    var p: Bool = false
                    if i > 0 {
                        var pb: I32 = byte_at(e, i - 1)
                        if pb == 61 || pb == 33 || pb == 60 || pb == 62 {
                            p = true
                        }
                    }
                    var q: Bool = false
                    if i + 1 < e.len {
                        if byte_at(e, i + 1) == 61 {
                            q = true
                        }
                    }
                    if !p {
                        if !q {
                            return true
                        }
                    }
                } else {
                    if b == 43 || b == 45 {
                        if i + 1 < e.len {
                            var nb: I32 = byte_at(e, i + 1)
                            if nb == b {
                                return true
                            }
                            if nb == 61 {
                                return true
                            }
                        }
                    } else {
                        if b == 42 || b == 47 || b == 37 {
                            if i + 1 < e.len {
                                if byte_at(e, i + 1) == 61 {
                                    return true
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    return false
}

fn gui_sk_attrs(tks: List[Str], cur: Atomic[I32], ev_name: List[Str], ev_fn: List[Str], out4: List[Str]) -> I32 {
    // out4 预置 4 槽:[0]=class [1]=cond [2]=bind [3]=placeholder(末值覆盖,镜像末推)
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 62 {
                break
            }
            if pb == 47 {
                break
            }
        }
        var an: Str = gui_sk_word(tks, cur)
        if an == "hover" {
            // S3:hover:名 裸属性——sk 树入事件表(name="hover",fn=名),
            // 与域包 gt_attrs 同构;渲染注册/询问钩通用(文件形态同生效)
            gui_sk_word(tks, cur)
            var hnm: Str = gui_sk_word(tks, cur)
            ev_name.push("hover")
            ev_fn.push(hnm)
        } else {
        if an == "password" {
            gui_sk_word(tks, cur)
            ev_name.push("password")
            ev_fn.push("")
        } else {
        if an == "numeric" {
            gui_sk_word(tks, cur)
            ev_name.push("numeric")
            ev_fn.push("")
        } else {
        if an == "switch" {
            // checkbox 变体裸属性 → 事件表(域包 rt_has_mark 渲染期消费)
            gui_sk_word(tks, cur)
            ev_name.push("switch")
            ev_fn.push("")
        } else {
        if an == "radio" {
            gui_sk_word(tks, cur)
            ev_name.push("radio")
            ev_fn.push("")
        } else {
        if an == "on" {
            gui_sk_word(tks, cur)
            var evn: Str = gui_sk_word(tks, cur)
            gui_sk_word(tks, cur)
            var ob: Str = gui_sk_word(tks, cur)
            var ev_branch: I32 = 0
            if ob.len >= 2 {
                if byte_at(ob, 0) == 34 {
                    // GUI-15:on:after="ms:handler" 引号串事件(定时;存活域一次性)
                    ev_name.push(evn)
                    ev_fn.push(byte_slice(ob, 1, ob.len - 1))
                    ev_branch = 1
                }
            }
            if ev_branch == 0 {
            // 块开守卫(缺 { 错位吞词,镜像 check 面 W3 教训)后 8c-3 平衡捕获
            if ob.len != 1 {
                panic("gui: on 期待块开")
            }
            if byte_at(ob, 0) != 123 {
                panic("gui: on 期待块开")
            }
            var fnn: Str = gui_bx_expr(tks, cur)
            ev_name.push(evn)
            ev_fn.push(fnn)
            }
        } else {
            gui_sk_word(tks, cur)
            var av: Str = ""
            var brform: Bool = false
            if cur.load() < tks.len {
                var pv: Str = tks[cur.load()]
                if pv.len == 1 {
                    if byte_at(pv, 0) == 123 {
                        cur.store(cur.load() + 1)
                        av = gui_bx_expr(tks, cur)
                        brform = true
                    }
                }
            }
            if !brform {
                if cur.load() < tks.len {
                    av = gui_unq(gui_sk_word(tks, cur))
                }
            }
            if an == "class" {
                out4[0] = av
            }
            if an == "cond" {
                out4[1] = av
            }
            if an == "bind" {
                out4[2] = av
            }
            if an == "checked" {
                // checkbox 选中态表达式 → nbid 槽(镜像 input bind)
                out4[2] = av
            }
            if an == "placeholder" {
                out4[3] = av
            }
        }
        }
        }
        }
        }
        }
    }
    return 0
}

fn gui_sk_node(tks: List[Str], cur: Atomic[I32], ntag: List[Str], nflag: List[Str], ncls: List[Str], npre: List[Str], nbid: List[Str], npost: List[Str], nfc: List[I32], ns: List[I32], nes: List[I32], nec: List[I32], ev_name: List[Str], ev_fn: List[Str], btns: List[I32], depth: I32) -> I32 {
    cur.store(cur.load() + 1)
    var tag: Str = gui_sk_word(tks, cur)
    var is_leaf: Bool = false
    if tag == "label" {
        is_leaf = true
    }
    if tag == "button" {
        is_leaf = true
    }
    var is_input: Bool = false
    if tag == "input" {
        is_input = true
    }
    // GUI-30 前置缝:textarea 与 input 同为自闭合叶子(bind 进 nbid;旧走通用
    // 自闭合分支 nbid.push(itemvar)=恒空,装配面 collect 面丢 bind——显示面走
    // 运行时 gt 树故无症状,默认写回面(bset 收集)首曝)
    if tag == "textarea" {
        is_input = true
    }
    var is_check: Bool = false
    if tag == "checkbox" {
        is_check = true
    }
    var itemvar: Str = ""
    var listname: Str = ""
    if tag == "each" {
        // 头:item in={列表表达式}(先于 attrs,镜像 gt_node;SL-8a 花括号表达式捕获)
        itemvar = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        var ob: Str = gui_sk_word(tks, cur)
        if ob.len != 1 {
            panic("gui: each 期待花括号列表")
        }
        if byte_at(ob, 0) != 123 {
            panic("gui: each 期待花括号列表")
        }
        listname = gui_bx_expr(tks, cur)
    }
    var estart: I32 = ev_name.len
    // 波次四跨文件:ViewCall 实例(大写首字母)——args `名: 值` 三形同 gt_node。
    // 表达式值以 0x01 连接入 npost,collect 抽取为合成 bind 路径(展开期
    // bxv_ask 走 prop:<表达式> 装配通道取值,s49 探针实证);引号串/裸词
    // 字面值不入 bind(展开期直取/字面入 env)
    var fb2: I32 = byte_at(tag, 0)
    if fb2 >= 65 {
        if fb2 <= 90 {
            var argtxt: Str = ""
            while cur.load() < tks.len {
                var pk2: Str = tks[cur.load()]
                if pk2.len == 1 {
                    var pb2: I32 = byte_at(pk2, 0)
                    if or2(pb2 == 62, pb2 == 47) {
                        break
                    }
                }
                gui_sk_word(tks, cur)
                gui_sk_word(tks, cur)
                if cur.load() >= tks.len {
                    break
                }
                var vw: Str = tks[cur.load()]
                var is_br: Bool = false
                var is_q: Bool = false
                if vw.len == 1 {
                    var vb2: I32 = byte_at(vw, 0)
                    if vb2 == 123 {
                        is_br = true
                    }
                    if vb2 == 34 {
                        is_q = true
                    }
                }
                if is_br {
                    cur.store(cur.load() + 1)
                    var ex2: Str = gui_bx_expr(tks, cur)
                    if argtxt != "" {
                        argtxt = argtxt + utf8_enc(1)
                    }
                    argtxt = argtxt + ex2
                } else {
                    if is_q {
                        gui_sk_word(tks, cur)
                    } else {
                        gui_sk_word(tks, cur)
                    }
                }
            }
            var selfc: Bool = false
            if cur.load() < tks.len {
                var cw2: Str = tks[cur.load()]
                if cw2.len == 1 {
                    if byte_at(cw2, 0) == 47 {
                        gui_sk_word(tks, cur)
                        selfc = true
                    }
                }
            }
            gui_sk_word(tks, cur)
            ntag.push("call:" + tag)
            ncls.push("")
            npre.push("")
            nbid.push("")
            npost.push(argtxt)
            nfc.push(-1)
            ns.push(-1)
            nes.push(estart)
            nec.push(0)
            nflag.push("")
            var vid2: I32 = ntag.len - 1
            // P2 投影实例:非自闭合并带子树时,子树链接到实例节点——collect
            // 多树走查即覆盖槽内容(bind 路径/事件全按主文件语义收集)
            if !selfc {
                var prev2: I32 = -1
                while cur.load() < tks.len {
                    var nk: Str = tks[cur.load()]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 60 {
                            if cur.load() + 1 < tks.len {
                                var nk2: Str = tks[cur.load() + 1]
                                if nk2.len == 1 {
                                    if byte_at(nk2, 0) == 47 {
                                        break
                                    }
                                }
                            }
                        }
                    }
                    var kid: I32 = gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, depth + 1)
                    if prev2 < 0 {
                        nfc[vid2] = kid
                    } else {
                        ns[prev2] = kid
                    }
                    prev2 = kid
                }
                gui_sk_word(tks, cur)
                gui_sk_word(tks, cur)
                gui_sk_word(tks, cur)
                gui_sk_word(tks, cur)
            }
            return vid2
        }
    }
    var out4 = List[Str]()
    out4.push("")
    out4.push("")
    out4.push("")
    out4.push("")
    gui_sk_attrs(tks, cur, ev_name, ev_fn, out4)
    var id: I32 = ntag.len
    if is_input {
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        ntag.push(tag)
        ncls.push(out4[0])
        npre.push(out4[3])
        nbid.push(out4[2])
        npost.push("")
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push("")
        return id
    }
    if is_check {
        // 自闭合:<checkbox checked={表达式} ... />;checked → nbid;登记可点击
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        ntag.push(tag)
        ncls.push(out4[0])
        npre.push("")
        nbid.push(out4[2])
        npost.push("")
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push("")
        btns.push(id)
        return id
    }
    // 自闭合空元素(spacer 等,§4.2 内建集):attrs 后遇 "/>" 即收口无子树
    if cur.load() < tks.len {
        var sk1: Str = tks[cur.load()]
        if sk1.len == 1 {
            if byte_at(sk1, 0) == 47 {
                gui_sk_word(tks, cur)
                gui_sk_word(tks, cur)
                ntag.push(tag)
                ncls.push(out4[0])
                npre.push(listname)
                nbid.push(itemvar)
                npost.push("")
                nfc.push(-1)
                ns.push(-1)
                nes.push(estart)
                nec.push(ev_name.len - estart)
                nflag.push(out4[1])
                return id
            }
        }
    }
    gui_sk_word(tks, cur)
    if is_leaf {
        // 叶文本三段:词流(单空格拼接)至 { → 表达式槽(SL-8a 平衡捕获) → 词流至 <
        var p0: Str = ""
        var b: Str = ""
        var p1: Str = ""
        var phase: I32 = 0
        while cur.load() < tks.len {
            var tk: Str = tks[cur.load()]
            if tk.len == 1 {
                var tb: I32 = byte_at(tk, 0)
                if tb == 123 {
                    cur.store(cur.load() + 1)
                    b = gui_bx_expr(tks, cur)
                    phase = 2
                    continue
                }
                if tb == 60 {
                    break
                }
            }
            if phase == 0 {
                if p0 != "" {
                    p0 = p0 + " "
                }
                p0 = p0 + tk
            } else {
                if p1 != "" {
                    p1 = p1 + " "
                }
                p1 = p1 + tk
            }
            cur.store(cur.load() + 1)
        }
        npre.push(p0)
        nbid.push(b)
        npost.push(p1)
        ntag.push(tag)
        ncls.push(out4[0])
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push(out4[1])
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        if tag == "button" {
            btns.push(id)
        }
        return id
    }
    ntag.push(tag)
    ncls.push(out4[0])
    npre.push(listname)
    nbid.push(itemvar)
    npost.push("")
    nfc.push(-1)
    ns.push(-1)
    nes.push(estart)
    nec.push(ev_name.len - estart)
    nflag.push(out4[1])
    var prev: I32 = -1
    while cur.load() < tks.len {
        var pk2: Str = tks[cur.load()]
        if pk2.len == 1 {
            if byte_at(pk2, 0) == 60 {
                if cur.load() + 1 < tks.len {
                    var nk: Str = tks[cur.load() + 1]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 47 {
                            break
                        }
                    }
                }
            }
        }
        var kid: I32 = gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, depth + 1)
        var fcl: List[I32] = nfc
        var nsl: List[I32] = ns
        if prev < 0 {
            fcl[id] = kid
        } else {
            nsl[prev] = kid
        }
        prev = kid
    }
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    return id
}

fn gui_sk_style(tks: List[Str], cur: Atomic[I32], sk: List[Str], sv: List[Str], ext: List[Str]) -> I32 {
    var name: Str = gui_sk_word(tks, cur)
    // P-W2:extends 单亲派生——记 (child, parent) 对,build 期定点解析
    if cur.load() < tks.len {
        var ek: Str = tks[cur.load()]
        if ek == "extends" {
            cur.store(cur.load() + 1)
            var pn: Str = gui_sk_word(tks, cur)
            ext.push(name)
            ext.push(pn)
        }
    }
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 59 {
                cur.store(cur.load() + 1)
                continue
            }
            if pb == 125 {
                break
            }
        }
        var p: Str = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        var v: Str = ""
        if cur.load() < tks.len {
            var pv: Str = tks[cur.load()]
            if pv.len > 1 {
                if byte_at(pv, 0) == 34 {
                    v = gui_unq(pv)
                    cur.store(cur.load() + 1)
                }
            }
        }
        if v == "" {
            if cur.load() < tks.len {
                v = gui_sk_word(tks, cur)
            }
        }
        sk.push(name + "." + p)
        sv.push(v)
    }
    return 0
}

fn gui_sk_build(file: List[Str], ntag: List[Str], nflag: List[Str], ncls: List[Str], npre: List[Str], nbid: List[Str], npost: List[Str], nfc: List[I32], ns: List[I32], nes: List[I32], nec: List[I32], ev_name: List[Str], ev_fn: List[Str], btns: List[I32], sk: List[Str], sv: List[Str], props: List[Str]) -> I32 {
    var ext = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                // 8c-2:props 名表入骨架(双端同形,s22 差分面)
                if d.len > 5 {
                    gui_props_names(d[5], props)
                }
                cur.store(1)
                if cur.load() < tks.len {
                    gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, 1)
                }
            } else {
                if d[1] == "style" {
                    gui_sk_style(tks, cur, sk, sv, ext)
                }
            }
        }
        i += 1
    }
    gui_sk_ext_resolve(sk, sv, ext)
    return 0
}

// P-W2:extends 解析(骨架侧)——镜像域包 gt_ext_resolve:环 panic、
// 定点迭代复制父属性(子已定义不覆盖)
fn gui_sk_ext_resolve(sk: List[Str], sv: List[Str], ext: List[Str]) -> I32 {
    var ci: I32 = 0
    while ci < ext.len {
        var cur: Str = ext[ci]
        var step: I32 = 0
        var cyc: Bool = true
        while step <= ext.len {
            var found: Bool = false
            var pi: I32 = 0
            while pi < ext.len {
                if ext[pi] == cur {
                    cur = ext[pi + 1]
                    found = true
                    pi = ext.len
                }
                pi += 2
            }
            if !found {
                cyc = false
                step = ext.len + 1
            }
            step += 1
        }
        if cyc {
            panic("gui: 样式 extends 环 " + ext[ci])
        }
        ci += 2
    }
    var changed: Bool = true
    var guard: I32 = 0
    while changed {
        changed = false
        guard += 1
        if guard > 16 {
            break
        }
        var pi: I32 = 0
        while pi < ext.len {
            var child: Str = ext[pi]
            var parent: Str = ext[pi + 1]
            var pp: Str = parent + "."
            var si: I32 = 0
            while si < sk.len {
                var k: Str = sk[si]
                if k.len > pp.len {
                    if byte_slice(k, 0, pp.len) == pp {
                        var pname: Str = byte_slice(k, pp.len, k.len)
                        var ck: Str = child + "." + pname
                        if !gui_sk_has(sk, ck) {
                            sk.push(ck)
                            sv.push(sv[si])
                            changed = true
                        }
                    }
                }
                si += 1
            }
            pi += 2
        }
    }
    return 0
}

fn gui_sk_has(sk: List[Str], key: Str) -> Bool {
    var i: I32 = 0
    while i < sk.len {
        if sk[i] == key {
            return true
        }
        i += 1
    }
    return false
}

// 骨架表倾倒(格式与域包 gui.ct sk_dump 逐字节一致,双端差分用;空串以 - 表示)
fn gui_sk_dump_all(file: List[Str]) -> I32 {
    var ntag = List[Str]()
    var nflag = List[Str]()
    var ncls = List[Str]()
    var npre = List[Str]()
    var nbid = List[Str]()
    var npost = List[Str]()
    var nfc = List[I32]()
    var ns = List[I32]()
    var nes = List[I32]()
    var nec = List[I32]()
    var ev_name = List[Str]()
    var ev_fn = List[Str]()
    var btns = List[I32]()
    var sk = List[Str]()
    var sv = List[Str]()
    var props = List[Str]()
    gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, sk, sv, props)
    // 8c-2:props 名表行(首行;空 = -;与域包 sk_dump 同格式)
    var pline: Str = ""
    var pi: I32 = 0
    while pi < props.len {
        if pi > 0 {
            pline = pline + ","
        }
        pline = pline + props[pi]
        pi += 1
    }
    if pline == "" {
        pline = "-"
    }
    println("props=" + pline)
    var i: I32 = 0
    while i < ntag.len {
        var pre: Str = npre[i]
        if pre == "" {
            pre = "-"
        }
        var bid: Str = nbid[i]
        if bid == "" {
            bid = "-"
        }
        var post: Str = npost[i]
        if post == "" {
            post = "-"
        }
        var flag: Str = nflag[i]
        if flag == "" {
            flag = "-"
        }
        var cls: Str = ncls[i]
        if cls == "" {
            cls = "-"
        }
        println("n" + i.to_string() + " tag=" + ntag[i] + " cls=" + cls + " pre=" + pre + " bid=" + bid + " post=" + post + " flag=" + flag + " fc=" + nfc[i].to_string() + " ns=" + ns[i].to_string() + " es=" + nes[i].to_string() + " ec=" + nec[i].to_string())
        i += 1
    }
    var k: I32 = 0
    while k < ev_name.len {
        println("e" + k.to_string() + " on=" + ev_name[k] + " fn=" + ev_fn[k])
        k += 1
    }
    var b: I32 = 0
    while b < btns.len {
        println("btn id=" + btns[b].to_string())
        b += 1
    }
    var s: I32 = 0
    while s < sk.len {
        println("s " + sk[s] + "=" + sv[s])
        s += 1
    }
    println("sk-end")
    return 0
}

// SL-7β3:C 串字面量转义(自包含;不依赖 trans_ty 的 ct_cstr——cc_run 拼接无该符号)
fn gui_sk_cesc(s: Str) -> Str {
    var out: Str = ""
    var i: I32 = 0
    var start: I32 = 0
    while i < s.len {
        var b: I32 = byte_at(s, i)
        if b == 34 {
            if i > start {
                out = out + byte_slice(s, start, i)
            }
            out = out + "\\"
            out = out + "\""
            i += 1
            start = i
        } else {
            if b == 92 {
                if i > start {
                    out = out + byte_slice(s, start, i)
                }
                out = out + "\\"
                out = out + "\\"
                i += 1
                start = i
            } else {
                if b == 10 {
                    if i > start {
                        out = out + byte_slice(s, start, i)
                    }
                    out = out + "\\"
                    out = out + "n"
                    i += 1
                    start = i
                } else {
                    i += 1
                }
            }
        }
    }
    if s.len > start {
        out = out + byte_slice(s, start, s.len)
    }
    return out
}

// SL-7β3:C 静态数组发射文本(串表/整表;driver_emit 骨架构造用)
fn gui_sk_emit_str_arr(id: I32, tbl: List[Str]) -> Str {
    var arr: Str = "static const char* sk_t" + id.to_string() + "[] = \{"
    var k2: I32 = 0
    while k2 < tbl.len {
        if k2 > 0 {
            arr = arr + ","
        }
        arr = arr + " \"" + gui_sk_cesc(tbl[k2]) + "\""
        k2 += 1
    }
    return arr + " };"
}

fn gui_sk_emit_int_arr(id: I32, tbl: List[I32]) -> Str {
    var arr: Str = "static const int32_t sk_t" + id.to_string() + "[] = \{"
    var k2: I32 = 0
    while k2 < tbl.len {
        if k2 > 0 {
            arr = arr + ","
        }
        arr = arr + tbl[k2].to_string()
        k2 += 1
    }
    return arr + " };"
}

// SL-7β2:裸值表 → 解释节点值表(vS/vI 包裹;与 gt_parse 解释执行值形态同构)
fn gui_sk_wrap_s(src: List[Str]) -> List[Str] {
    var out = List[Str]()
    out.push("L")
    var i: I32 = 0
    while i < src.len {
        out.push(v_box(vS(src[i])))
        i += 1
    }
    return out
}

fn gui_sk_wrap_i(src: List[I32]) -> List[Str] {
    var out = List[Str]()
    out.push("L")
    var i: I32 = 0
    while i < src.len {
        out.push(v_box(vI(src[i])))
        i += 1
    }
    return out
}

// ==================== SL-8c-4② 续:定位/生成/钩子 ====================

// 视图声明型表(d[5] → 与 pnames 同序的型原文表)
fn gui_ds_ptyps(file: List[Str], pnames: List[Str]) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            if d[1] == "view" {
                var vn = List[Str]()
                var vt = List[Str]()
                if d.len > 5 {
                    gui_props_typed(d[5], vn, vt)
                }
                if vn.len == pnames.len {
                    var same: Bool = true
                    var k: I32 = 0
                    while k < vn.len {
                        if vn[k] != pnames[k] {
                            same = false
                            k = vn.len
                        }
                        k += 1
                    }
                    if same {
                        var w: I32 = 0
                        while w < vt.len {
                            out.push(vt[w])
                            w += 1
                        }
                        return out
                    }
                }
            }
        }
        i += 1
    }
    return out
}

// 骨架表驱动收集:标量查询路径(+型)/each 列表表达式/事件表/input on:input
// 处理器(inps = 名通道前缀分支的调用表达式,8c-4④ 键入持久化面)
// bset/bty = GUI-30 默认写回集(无 on:input 的 input/textarea 点链 bind + 型别)
fn gui_ds_collect_slots(file: List[Str], pnames: List[Str], paths: List[Str], pty: List[Str], lists: List[Str], evn: List[Str], evf: List[Str], inps: List[Str], ievs: List[Str], crows: List[Str], cty: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], cvn: List[Str], cvf: List[Str], ciev: List[Str], bset: List[Str], bty: List[Str]) -> I32 {
    // 单一树走查统一收集(I32 双栈,子树承 in_each 旗;域包 gs2i 不可见
    // 于编译器,禁字符串栈):标量路径表达式 / each 列表 / 行域 checkbox /
    // in-each 事件(实例分发)/ input on:input 处理器(名通道)
    var ntag = List[Str]()
    var nflag = List[Str]()
    var ncls = List[Str]()
    var npre = List[Str]()
    var nbid = List[Str]()
    var npost = List[Str]()
    var nfc = List[I32]()
    var ns = List[I32]()
    var nes = List[I32]()
    var nec = List[I32]()
    var f_evn = List[Str]()
    var f_evf = List[Str]()
    var btns = List[I32]()
    var sk = List[Str]()
    var sv = List[Str]()
    var skprops = List[Str]()
    gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, f_evn, f_evf, btns, sk, sv, skprops)
    var ptyps: List[Str] = gui_ds_ptyps(file, pnames)
    // 多树走查(组件跨文件/靶视图居末后):sk 平面数组含全部视图的树,
    // 走查须从每个树根(非任何节点孩子者)起步——单根 stid=[0] 在靶视图
    // 居末时只走组件树,主文件实例实参/事件全漏(s49 探针实证)
    var isch = List[I32]()
    var z: I32 = 0
    while z < ntag.len {
        isch.push(0)
        z += 1
    }
    var z2: I32 = 0
    while z2 < ntag.len {
        var ch2: I32 = nfc[z2]
        while ch2 >= 0 {
            isch[ch2] = 1
            ch2 = ns[ch2]
        }
        z2 += 1
    }
    var exprs = List[Str]()
    // P2 契约分家:靶视图(挪靶后=末根)事件/each/路径进合成面;组件树事件
    // → cvn/cvf(ev_arg 按位解码),组件 each 通道/绑定路径跳过——env 前置
    // 应答(Ⅰ),宿主合成 bind 无组件数据源,合了反而 C 未定义符号
    var rst = List[I32]()
    var z3: I32 = 0
    while z3 < ntag.len {
        if isch[z3] == 0 {
            rst.push(z3)
        }
        z3 += 1
    }
    var ri4: I32 = 0
    while ri4 < rst.len {
        var istgt: Bool = false
        if ri4 == rst.len - 1 {
            istgt = true
        }
        var stid = List[I32]()
        var stie = List[I32]()
        stid.push(rst[ri4])
        stie.push(0)
        var si: I32 = 0
        while si < stid.len {
            var id: I32 = stid[si]
            var ie: I32 = stie[si]
            si += 1
            if ntag[id] == "each" {
                ie = 1
                if istgt {
                    lists.push(npre[id])
                }
            }
            if ntag[id].len > 5 {
                if byte_slice(ntag[id], 0, 5) == "call:" {
                    // 组件实例表达式实参(npost 0x01 连接)→ 合成 bind 路径:
                    // 展开期 bxv_ask 以 prop:<表达式> 问装配通道,合成侧须有应答分支
                    var atx: Str = npost[id]
                    var ai: I32 = 0
                    var aos: I32 = 0
                    while ai <= atx.len {
                        if ai == atx.len {
                            if ai > aos {
                                exprs.push(byte_slice(atx, aos, ai))
                            }
                            ai += 1
                        } else {
                            if byte_at(atx, ai) == 1 {
                                if ai > aos {
                                    exprs.push(byte_slice(atx, aos, ai))
                                }
                                aos = ai + 1
                            }
                            ai += 1
                        }
                    }
                }
            }
            if tag_is_input_evt(ntag[id], nbid[id]) {
                if istgt {
                    crows.push(nbid[id])
                    cty.push("Bool")
                }
            } else {
                if istgt {
                    if nbid[id] != "" {
                        exprs.push(nbid[id])
                    }
                    if nflag[id] != "" {
                        exprs.push(nflag[id])
                    }
                    // GUI-30:默认写回集——input/textarea 无 on:input(应用未接管)
                    // 且 bind 为纯点链且型别可写(Str/I32)者收入 bset;有处理器 =
                    // 受控契约原样(零分支合成)。表达式槽/未知型别豁免(现状=丢)
                    if ntag[id] == "input" || ntag[id] == "textarea" {
                        if nbid[id] != "" {
                            if !rt_ds_node_has_input_evt(nes[id], nec[id], f_evn) {
                                var ps0 = List[Str]()
                                var sub0 = List[Str]()
                                gui_bx_dotted(nbid[id], ps0, sub0)
                                if ps0.len == 1 {
                                    if sub0.len == 0 {
                                        if ps0[0] == nbid[id] {
                                            var tyw: Str = gui_ds_path_ty(nbid[id], pnames, ptyps, stns, sfk, stv)
                                            if tyw == "Str" || tyw == "I32" {
                                                if !gui_ck_has_style(bset, nbid[id]) {
                                                    bset.push(nbid[id])
                                                    bty.push(tyw)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            var e: I32 = 0
            while e < nec[id] {
                var gi: I32 = nes[id] + e
                if ie == 1 {
                    if f_evn[gi] == "input" {
                        if istgt {
                            inps.push(f_evf[gi])
                        }
                    } else {
                        if istgt {
                            ievs.push(f_evf[gi])
                        } else {
                            // 契约Ⅱ-b:组件树 each 内事件→后缀前缀分支(模型捕获
                            // +行下标),组件树不做 ievs(目标面专属)
                            ciev.push(f_evf[gi])
                        }
                    }
                } else {
                    if f_evn[gi] == "input" {
                        if istgt {
                            inps.push(f_evf[gi])
                        }
                    } else {
                        if istgt {
                            evn.push(f_evn[gi])
                            evf.push(f_evf[gi])
                        } else {
                            cvn.push(f_evn[gi])
                            cvf.push(f_evf[gi])
                        }
                    }
                }
                e += 1
            }
            var ch: I32 = nfc[id]
            while ch >= 0 {
                stid.push(ch)
                stie.push(ie)
                ch = ns[ch]
            }
        }
        ri4 += 1
    }
    // GUI-13:依赖两遍提取——先全量 paths+subs,再路由:下标根入 lists(each:
    // 通道多推分支,gen 复用零改动),标量依赖照旧 prop: 分支;lists 去重
    //(既有 each 重复列表名潜在双分支一并收口)
    var allps = List[Str]()
    var allsub = List[Str]()
    var i: I32 = 0
    while i < exprs.len {
        gui_bx_dotted(exprs[i], allps, allsub)
        i += 1
    }
    i = 0
    while i < allps.len {
        var rt: Str = allps[i]
        var di: I32 = 0
        while di < allps[i].len {
            if byte_at(allps[i], di) == 46 {
                rt = byte_slice(allps[i], 0, di)
                di = allps[i].len
            }
            di += 1
        }
        if gui_ck_has_style(pnames, rt) {
            if gui_ck_has_style(allsub, allps[i]) {
                if !gui_ck_has_style(lists, allps[i]) {
                    lists.push(allps[i])
                }
            } else {
                if !gui_ck_has_style(paths, allps[i]) {
                    paths.push(allps[i])
                    pty.push(gui_ds_path_ty(allps[i], pnames, ptyps, stns, sfk, stv))
                }
            }
        }
        i += 1
    }
    return 0
}

// checkbox checked 槽判定(each 行域勾选面)
fn tag_is_input_evt(tag: Str, nbid: Str) -> Bool {
    if tag == "checkbox" {
        if nbid != "" {
            return true
        }
    }
    return false
}

// 节点事件表含 on:input 否(GUI-30 bset 收集的受控契约判据;nes 为全局事件
// 名表基址偏移,f_evn 即该表)
fn rt_ds_node_has_input_evt(nes0: I32, nec0: I32, f_evn: List[Str]) -> Bool {
    var e: I32 = 0
    while e < nec0 {
        if f_evn[nes0 + e] == "input" {
            return true
        }
        e += 1
    }
    return false
}

// 合成三 fn(源文本 → 真解析拼写单元,File 节)
fn gui_ds_gen(file: List[Str], vname: Str, pnames: List[Str], ptyps: List[Str], ordn: List[Str], paths: List[Str], pty: List[Str], lists: List[Str], evn: List[Str], evf: List[Str], inps: List[Str], ievs: List[Str], crows: List[Str], cty: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], cvn: List[Str], cvf: List[Str], ciev: List[Str], bset: List[Str], bty: List[Str]) -> List[Str] {
    var ptoks = List[Str]()
    var boxes = List[Str]()
    var ii: I32 = 0
    while ii < ordn.len {
        var pn: Str = ordn[ii]
        var ty: Str = ""
        var ti: I32 = 0
        while ti < pnames.len {
            if pnames[ti] == pn {
                ty = ptyps[ti]
                ti = pnames.len
            }
            ti += 1
        }
        var head: Str = gui_ty_head_txt(ty)
        var tok: Str = "__a" + ii.to_string()
        if gui_ck_has_style(stns, head) {
            tok = "__p_" + pn
            var bl: Str = "    var " + tok + ": Box[" + head + "] = "
            if head == gui_trim(ty) {
                bl = bl + "Box[" + head + "](" + "__a" + ii.to_string() + ")"
            } else {
                bl = bl + "__a" + ii.to_string()
            }
            boxes.push(bl)
        }
        ptoks.push(tok)
        ii += 1
    }
    var params: Str = ""
    var cargs: Str = ""
    var sigargs: Str = ""
    ii = 0
    while ii < ordn.len {
        if ii > 0 {
            params = params + ", "
            cargs = cargs + ", "
            sigargs = sigargs + ", "
        }
        var pn: Str = ordn[ii]
        var ty: Str = ""
        var ti: I32 = 0
        while ti < pnames.len {
            if pnames[ti] == pn {
                ty = gui_trim(ptyps[ti])
                ti = pnames.len
            }
            ti += 1
        }
        params = params + "__a" + ii.to_string() + ": " + ty
        cargs = cargs + ptoks[ii]
        var head2: Str = gui_ty_head_txt(ty)
        if gui_ck_has_style(stns, head2) {
            sigargs = sigargs + ptoks[ii] + ": Box[" + head2 + "]"
        } else {
            sigargs = sigargs + ptoks[ii] + ": " + ty
        }
        ii += 1
    }
    var g: Str = "fn __gui_bind_" + vname + "(buf: List[Str]"
    if sigargs.len > 0 {
        g = g + ", " + sigargs
    }
    g = g + ") \{\n"
    var k: I32 = 0
    while k < paths.len {
        var rw: Str = gui_ds_rw(paths[k], pnames, ptoks)
        var tyk: Str = pty[k]
        g = g + "    if buf[0] == \"prop:" + paths[k] + "\" \{\n"
        if tyk == "I32" {
            g = g + "        buf.push(\"i:\" + (" + rw + ").to_string())\n"
        } else {
            if tyk == "Bool" {
                g = g + "        if (" + rw + ") \{ buf.push(\"b:1\") } else \{ buf.push(\"b:0\") }\n"
            } else {
                g = g + "        buf.push(" + rw + ")\n"
            }
        }
        g = g + "    }\n"
        k += 1
    }
    k = 0
    while k < crows.len {
        var rwc: Str = gui_ds_rw(crows[k], pnames, ptoks)
        var plc: I32 = crows[k].len + 9
        g = g + "    if buf[0].len >= " + plc.to_string() + " \{\n"
        g = g + "        if byte_slice(buf[0], 0, " + plc.to_string() + ") == \"eachrow:" + crows[k] + ":\" \{\n"
        g = g + "            if " + rwc + "[ev_suffix_i(buf[0])] \{ buf.push(\"1\") } else \{ buf.push(\"0\") }\n"
        g = g + "        }\n"
        g = g + "    }\n"
        k += 1
    }
    k = 0
    while k < lists.len {
        var rwl: Str = gui_ds_rw(lists[k], pnames, ptoks)
        g = g + "    if buf[0] == \"each:" + lists[k] + "\" \{\n"
        g = g + "        var gi: I32 = 0\n"
        g = g + "        while gi < " + rwl + ".len \{\n"
        g = g + "            buf.push(" + rwl + "[gi])\n"
        g = g + "            gi += 1\n"
        g = g + "        }\n"
        g = g + "    }\n"
        k += 1
    }
    g = g + "}\n"
    var a2: Str = "fn __gui_act_" + vname + "(name: Str, args: List[Str]"
    if sigargs.len > 0 {
        a2 = a2 + ", " + sigargs
    }
    a2 = a2 + ") \{\n"
    // P2 契约Ⅱ:组件视图 call 形事件——实参全 ev_arg 按位解码(处理器声明
    // 型别,合成期可知;事件实参=事件局部数据,4a 同构);先于靶事件分支
    // 契约Ⅱ-b:处理器首参 Box = 模型捕获直传(与 4a 根捕获同构;check 面
    // fbox+iscomp 同规豁免 +1)——组件事件即可改宿主模型
    var mcap: Str = ""
    if ptoks.len > 0 {
        mcap = ptoks[0]
    }
    k = 0
    while k < cvf.len {
        var argcC = List[I32]()
        var aoC = List[Str]()
        var headC: Str = gui_ev_head2(cvf[k], argcC, aoC)
        if headC.len > 0 {
            var ptsl = gui_fn_ptyps(file, headC)
            var hasm: Bool = false
            if ptsl.len > 0 {
                if ptsl[0].len >= 4 {
                    if byte_slice(ptsl[0], 0, 4) == "Box:" {
                        hasm = true
                    }
                }
            }
            if argcC[0] >= 0 {
                var parr: Str = ""
                if hasm {
                    parr = mcap + ", "
                }
                var pi2: I32 = 0
                while pi2 < argcC[0] {
                    // 数据参型别 = 声明形参表跳过模型首参(hasm)后按位对齐
                    var didx: I32 = pi2
                    if hasm {
                        didx = pi2 + 1
                    }
                    var dc: Str = "ev_arg_s"
                    if didx < ptsl.len {
                        var pts: Str = ptsl[didx]
                        if pts == "i" {
                            dc = "ev_arg_i"
                        } else {
                            if pts == "b" {
                                dc = "ev_arg_b"
                            }
                        }
                    }
                    if pi2 > 0 {
                        parr = parr + ", "
                    }
                    parr = parr + dc + "(args, " + pi2.to_string() + ")"
                    pi2 += 1
                }
                a2 = a2 + "    if name == \"" + headC + "\" \{ " + headC + "(" + parr + ") }\n"
            } else {
                if hasm {
                    a2 = a2 + "    if name == \"" + headC + "\" \{ " + headC + "(" + mcap + ") }\n"
                } else {
                    a2 = a2 + "    if name == \"" + headC + "\" \{ " + headC + "() }\n"
                }
            }
        }
        k += 1
    }
    // 契约Ⅱ-b:组件树 each 内事件——后缀前缀分支("头:N" P-H1 同构),处理器
    // 声明 (Box[M], I32):模型捕获 + 行下标(ev_suffix_i)
    k = 0
    while k < ciev.len {
        var argcC2 = List[I32]()
        var aoC2 = List[Str]()
        var headC2: Str = gui_ev_head2(ciev[k], argcC2, aoC2)
        if headC2.len > 0 {
            var hl: I32 = headC2.len
            a2 = a2 + "    if name.len > " + hl.to_string() + " \{\n"
            a2 = a2 + "        if byte_slice(name, 0, " + hl.to_string() + ") == \"" + headC2 + "\" \{\n"
            a2 = a2 + "        if byte_at(name, " + hl.to_string() + ") == 58 \{\n"
            a2 = a2 + "            " + headC2 + "(" + mcap + ", ev_suffix_i(name))\n"
            a2 = a2 + "        }\n"
            a2 = a2 + "        }\n"
            a2 = a2 + "    }\n"
        }
        k += 1
    }
    k = 0
    while k < evf.len {
        // input 元素的 on:input 已由名通道前缀分支接管(inps),主循环跳过免双写
        if evn[k] == "input" {
            if gui_ck_has_style(inps, evf[k]) {
                k += 1
                continue
            }
        }
        // each 体内事件已由实例后缀分支接管(ievs),主循环跳过
        if gui_ck_has_style(ievs, evf[k]) {
            k += 1
            continue
        }
        var argc = List[I32]()
        var ao = List[Str]()
        var head2: Str = gui_ev_head2(evf[k], argc, ao)
        if head2.len > 0 {
            if argc.len > 0 {
                if argc[0] >= 1 {
                    var sp: Str = ao[0]
                    var parts = List[Str]()
                    var si: I32 = 0
                    var depth: I32 = 0
                    var cur0: Str = ""
                    while si < sp.len {
                        var c: I32 = byte_at(sp, si)
                        if c == 40 {
                            depth += 1
                        } else {
                            if c == 41 {
                                depth -= 1
                            } else {
                                if c == 44 {
                                    if depth == 0 {
                                        parts.push(gui_trim(cur0))
                                        cur0 = ""
                                        si += 1
                                        continue
                                    }
                                }
                            }
                        }
                        cur0 = cur0 + byte_slice(sp, si, si + 1)
                        si += 1
                    }
                    parts.push(gui_trim(cur0))
                    var ar: Str = ""
                    var pj: I32 = 0
                    while pj < parts.len {
                        if pj > 0 {
                            ar = ar + ", "
                        }
                        ar = ar + gui_ds_rw(parts[pj], pnames, ptoks)
                        pj += 1
                    }
                    a2 = a2 + "    if name == \"" + head2 + "\" \{ " + head2 + "(" + ar + ") }\n"
                } else {
                    a2 = a2 + "    if name == \"" + head2 + "\" \{ " + head2 + "() }\n"
                }
            } else {
                a2 = a2 + "    if name == \"" + evf[k] + "\" \{ " + evf[k] + "() }\n"
            }
        }
        k += 1
    }
    // each 体内事件实例后缀分支("头:N" → 头(__p_*, N))——P-H1 命中契约
    k = 0
    while k < ievs.len {
        var argcE = List[I32]()
        var aoE = List[Str]()
        var headE: Str = gui_ev_head2(ievs[k], argcE, aoE)
        if headE.len > 0 {
            var arE: Str = ""
            if argcE.len > 0 {
                if argcE[0] >= 1 {
                    arE = gui_ds_rw(aoE[0], pnames, ptoks)
                }
            }
            a2 = a2 + "    if name.len > " + headE.len.to_string() + " \{\n"
            a2 = a2 + "        if byte_slice(name, 0, " + headE.len.to_string() + ") == \"" + headE + "\" \{\n"
            a2 = a2 + "        if byte_at(name, " + headE.len.to_string() + ") == 58 \{\n"
            a2 = a2 + "            " + headE + "(" + arE + ", ev_suffix_i(name))\n"
            a2 = a2 + "        }\n"
            a2 = a2 + "        }\n"
            a2 = a2 + "    }\n"
        }
        k += 1
    }
    // input on:input 名通道前缀分支("头名:全文" → 头(__p_*, 全文))
    k = 0
    while k < inps.len {
        var argcI = List[I32]()
        var aoI = List[Str]()
        var headI: Str = gui_ev_head2(inps[k], argcI, aoI)
        if headI.len > 0 {
            if argcI.len == 0 {
                k = inps.len
                continue
            }
            var pl: I32 = headI.len + 1
            var arI: Str = ""
            if argcI.len > 0 {
                if argcI[0] >= 1 {
                    arI = gui_ds_rw(aoI[0], pnames, ptoks)
                }
            }
            a2 = a2 + "    if name.len >= " + pl.to_string() + " \{\n"
            a2 = a2 + "        if byte_slice(name, 0, " + pl.to_string() + ") == \"" + headI + ":\" \{\n"
            a2 = a2 + "            " + headI + "(" + arI + ", byte_slice(name, " + pl.to_string() + ", name.len))\n"
            a2 = a2 + "        }\n"
            a2 = a2 + "    }\n"
        }
        k += 1
    }
    // GUI-30:持久化默认化写回分支("__bs:路径:全文" → 路径 = 全文)。运行时
    // rt_in_fire 无 on:input 处理器时改发此头(bind 变量唯一值源不变:显示每帧
    // 从变量读,输入即写回;第二值源不存在)。Str 直赋;I32 经 ev_arg_i 桥
    k = 0
    while k < bset.len {
        var rwB: Str = gui_ds_rw(bset[k], pnames, ptoks)
        var plB: I32 = bset[k].len + 6
        a2 = a2 + "    if name.len >= " + plB.to_string() + " \{\n"
        a2 = a2 + "        if byte_slice(name, 0, " + plB.to_string() + ") == \"__bs:" + bset[k] + ":\" \{\n"
        if bty[k] == "I32" {
            a2 = a2 + "            var bsv = List[Str]()\n"
            a2 = a2 + "            bsv.push(byte_slice(name, " + plB.to_string() + ", name.len))\n"
            a2 = a2 + "            " + rwB + " = ev_arg_i(bsv, 0)\n"
        } else {
            a2 = a2 + "            " + rwB + " = byte_slice(name, " + plB.to_string() + ", name.len)\n"
        }
        a2 = a2 + "        }\n"
        a2 = a2 + "    }\n"
        k += 1
    }
    a2 = a2 + "}\n"
    var r: Str = "fn __gui_run_" + vname + "(" + params + ") -> I32 \{\n"
    k = 0
    while k < boxes.len {
        r = r + boxes[k] + "\n"
        k += 1
    }
    var bindcl: Str = "|buf| __gui_bind_" + vname + "(buf"
    if cargs.len > 0 {
        bindcl = bindcl + ", " + cargs
    }
    bindcl = bindcl + ")"
    var actcl: Str = "|nm, ar| __gui_act_" + vname + "(nm, ar"
    if cargs.len > 0 {
        actcl = actcl + ", " + cargs
    }
    actcl = actcl + ")"
    r = r + "    return rt_run_anchor(\"Ctron\", 320, 480,\n"
    r = r + "        " + bindcl + ",\n"
    r = r + "        " + actcl + ")\n"
    r = r + "}\n"
    var src: Str = g + a2 + r
    fs_write("/tmp/ds_gen_dump.ct", src)
    var toks = List[Str]()
    var lns = List[Str]()
    var cols = List[Str]()
    var pd = List[Str]()
    scan4(src, toks, lns, cols, pd)
    var cur = Atomic[I32](0)
    return p_file(toks, cur, lns, cols, pd)
}

// 预合并:run(ViewCall) 命中即注入 use gui.{run_d} 请求(合并期生效)。
// 定位/收集/生成全部前置——合并产物含签名级 stub(d[5]=类型戳字符串),
// 后置遍历按 Block 索引即 SEGV(0ea0513 余账根因);unit 出参带合成 decl。
// ==================== P2 跨文件:标记/ordn/改写族 ====================
// 视图可居被用模块(GuiBlock 合并恒随),主文件零 GuiBlock 亦然——标记检测
// 泛化为 run(<Ident>(...));视图名合并后 gui_ds_target 核(缺=sem E2020)。

fn gui_ds_marker_expr(e: List[Str]) -> Str {
    if e.len < 1 {
        return ""
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[2].len > 1 {
                                        return a[1][1]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var r: Str = gui_ds_marker_expr(e[1])
        if r != "" {
            return r
        }
        var i: I32 = 1
        while i < e[2].len {
            r = gui_ds_marker_expr(e[2][i])
            if r != "" {
                return r
            }
            i += 1
        }
        return ""
    }
    if t == "Binary" {
        var r2: Str = gui_ds_marker_expr(e[2])
        if r2 != "" {
            return r2
        }
        return gui_ds_marker_expr(e[3])
    }
    if t == "Unary" {
        return gui_ds_marker_expr(e[2])
    }
    if t == "Member" {
        return gui_ds_marker_expr(e[1])
    }
    if t == "NParg" {
        return gui_ds_marker_expr(e[2])
    }
    if t == "Index" {
        return gui_ds_marker_expr(e[1])
    }
    return ""
}

fn gui_ds_marker_block(b: List[Str]) -> Str {
    var i: I32 = 1
    while i < b.len {
        var st: Str = b[i][0]
        var hit: Str = ""
        if st == "Return" {
            if b[i].len > 1 {
                hit = gui_ds_marker_expr(b[i][1])
            }
        } else {
            if st == "Let" {
                hit = gui_ds_marker_expr(b[i][4])
            } else {
                if st == "While" {
                    hit = gui_ds_marker_expr(b[i][1])
                } else {
                    if st == "For" {
                        hit = gui_ds_marker_expr(b[i][2])
                    } else {
                        if st == "If" {
                            hit = gui_ds_marker_expr(b[i][1])
                            if hit == "" {
                                hit = gui_ds_marker_block(b[i][2])
                            }
                            if hit == "" {
                                if b[i][3][0] == "If" {
                                    hit = gui_ds_marker_block(b[i][3])
                                } else {
                                    if b[i][3][0] == "BlockExpr" {
                                        hit = gui_ds_marker_block(b[i][3][1])
                                    }
                                }
                            }
                        } else {
                            if st == "Expr" {
                                hit = gui_ds_marker_expr(b[i][1])
                            } else {
                                if st == "Assign" {
                                    hit = gui_ds_marker_expr(b[i][1])
                                    if hit == "" {
                                        hit = gui_ds_marker_expr(b[i][3])
                                    }
                                } else {
                                    hit = gui_ds_marker_expr(b[i])
                                }
                            }
                        }
                    }
                }
            }
        }
        if hit != "" {
            return hit
        }
        i += 1
    }
    return ""
}

fn gui_ds_marker_file(file: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        if file[i][0] == "Fn" {
            var hit: Str = gui_ds_marker_block(file[i][5])
            if hit != "" {
                return hit
            }
        }
        i += 1
    }
    return ""
}

fn gui_ds_ordn_expr(e: List[Str], vname: Str, names: List[Str]) -> I32 {
    if e.len < 1 {
        return 0
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[1][1] == vname {
                                        if a[2].len > 1 {
                                            var k: I32 = 1
                                            while k < a[2].len {
                                                names.push(a[2][k][1])
                                                k += 1
                                            }
                                            return 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if gui_ds_ordn_expr(e[1], vname, names) > 0 {
            return 1
        }
        var i: I32 = 1
        while i < e[2].len {
            if gui_ds_ordn_expr(e[2][i], vname, names) > 0 {
                return 1
            }
            i += 1
        }
        return 0
    }
    if t == "Binary" {
        if gui_ds_ordn_expr(e[2], vname, names) > 0 {
            return 1
        }
        return gui_ds_ordn_expr(e[3], vname, names)
    }
    if t == "Unary" {
        return gui_ds_ordn_expr(e[2], vname, names)
    }
    if t == "Member" {
        return gui_ds_ordn_expr(e[1], vname, names)
    }
    if t == "NParg" {
        return gui_ds_ordn_expr(e[2], vname, names)
    }
    if t == "Index" {
        return gui_ds_ordn_expr(e[1], vname, names)
    }
    return 0
}

fn gui_ds_ordn_block(b: List[Str], vname: Str, names: List[Str]) -> I32 {
    var i: I32 = 1
    while i < b.len {
        var st: Str = b[i][0]
        var got: I32 = 0
        if st == "Return" {
            if b[i].len > 1 {
                got = gui_ds_ordn_expr(b[i][1], vname, names)
            }
        } else {
            if st == "Let" {
                got = gui_ds_ordn_expr(b[i][4], vname, names)
            } else {
                if st == "While" {
                    got = gui_ds_ordn_expr(b[i][1], vname, names)
                } else {
                    if st == "For" {
                        got = gui_ds_ordn_expr(b[i][2], vname, names)
                    } else {
                        if st == "If" {
                            got = gui_ds_ordn_expr(b[i][1], vname, names)
                            if got == 0 {
                                got = gui_ds_ordn_block(b[i][2], vname, names)
                            }
                            if got == 0 {
                                if b[i][3][0] == "If" {
                                    got = gui_ds_ordn_block(b[i][3], vname, names)
                                } else {
                                    if b[i][3][0] == "BlockExpr" {
                                        got = gui_ds_ordn_block(b[i][3][1], vname, names)
                                    }
                                }
                            }
                        } else {
                            if st == "Expr" {
                                got = gui_ds_ordn_expr(b[i][1], vname, names)
                            } else {
                                if st == "Assign" {
                                    got = gui_ds_ordn_expr(b[i][1], vname, names)
                                    if got == 0 {
                                        got = gui_ds_ordn_expr(b[i][3], vname, names)
                                    }
                                } else {
                                    got = gui_ds_ordn_expr(b[i], vname, names)
                                }
                            }
                        }
                    }
                }
            }
        }
        if got > 0 {
            return 1
        }
        i += 1
    }
    return 0
}

fn gui_ds_ordn_file(file: List[Str], vname: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" {
            var names = List[Str]()
            if gui_ds_ordn_block(d[5], vname, names) > 0 {
                return names
            }
        }
        i += 1
    }
    return List[Str]()
}

fn gui_ds_rew_expr(e: List[Str], vname: Str) -> I32 {
    if e.len < 1 {
        return 0
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[1][1] == vname {
                                        var nn = mk("Ident")
                                        nn.push("__gui_run_" + vname)
                                        e[1] = nn
                                        var na = mk("Args")
                                        var i: I32 = 1
                                        while i < a[2].len {
                                            na.push(a[2][i][2])
                                            i += 1
                                        }
                                        e[2] = na
                                        return 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if gui_ds_rew_expr(e[1], vname) > 0 {
            return 1
        }
        var i: I32 = 1
        while i < e[2].len {
            if gui_ds_rew_expr(e[2][i], vname) > 0 {
                return 1
            }
            i += 1
        }
        return 0
    }
    if t == "Binary" {
        if gui_ds_rew_expr(e[2], vname) > 0 {
            return 1
        }
        return gui_ds_rew_expr(e[3], vname)
    }
    if t == "Unary" {
        return gui_ds_rew_expr(e[2], vname)
    }
    if t == "Member" {
        return gui_ds_rew_expr(e[1], vname)
    }
    if t == "NParg" {
        return gui_ds_rew_expr(e[2], vname)
    }
    if t == "Index" {
        return gui_ds_rew_expr(e[1], vname)
    }
    return 0
}

fn gui_ds_rew_block(b: List[Str], vname: Str) -> I32 {
    var i: I32 = 1
    while i < b.len {
        var st: Str = b[i][0]
        var got: I32 = 0
        if st == "Return" {
            if b[i].len > 1 {
                got = gui_ds_rew_expr(b[i][1], vname)
            }
        } else {
            if st == "Let" {
                got = gui_ds_rew_expr(b[i][4], vname)
            } else {
                if st == "While" {
                    got = gui_ds_rew_expr(b[i][1], vname)
                } else {
                    if st == "For" {
                        got = gui_ds_rew_expr(b[i][2], vname)
                    } else {
                        if st == "If" {
                            got = gui_ds_rew_expr(b[i][1], vname)
                            if got == 0 {
                                got = gui_ds_rew_block(b[i][2], vname)
                            }
                            if got == 0 {
                                if b[i][3][0] == "If" {
                                    got = gui_ds_rew_block(b[i][3], vname)
                                } else {
                                    if b[i][3][0] == "BlockExpr" {
                                        got = gui_ds_rew_block(b[i][3][1], vname)
                                    }
                                }
                            }
                        } else {
                            if st == "Expr" {
                                got = gui_ds_rew_expr(b[i][1], vname)
                            } else {
                                if st == "Assign" {
                                    got = gui_ds_rew_expr(b[i][1], vname)
                                    if got == 0 {
                                        got = gui_ds_rew_expr(b[i][3], vname)
                                    }
                                } else {
                                    got = gui_ds_rew_expr(b[i], vname)
                                }
                            }
                        }
                    }
                }
            }
        }
        if got > 0 {
            return 1
        }
        i += 1
    }
    return 0
}

fn gui_ds_rew_file(file: List[Str], vname: Str) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" {
            if gui_ds_rew_block(d[5], vname) > 0 {
                return 1
            }
        }
        i += 1
    }
    return 0
}

fn gui_ds_premerge(file: List[Str], unit: List[Str]) -> List[Str] {
    // 单文件视图 find + ordn + 就地改写 + ordn 头;
    // P2 跨文件:视图居被用模块 —— 纯标记检测(run(<Ident>(...)),不依赖本文件
    // views;marker/ordn 族 70fcda7 已备,此为接线),ordn 取调用点命名实参。
    // 当日移除跨文件路径的根因(合并串流入遍历 SEGV)已定性为 made[0] 头串
    // 拼入 + sanitize 白名单缺 FnPub 两 bug,修复后遍历合并面恢复类型安全。
    var vnames = List[Str]()
    var vprops = List[Str]()
    gui_ds_views(file, vnames, vprops)
    var names = List[Str]()
    var vname: Str = gui_ds_find_file(file, vnames, names)
    var ordn = List[Str]()
    if vname != "" {
        var oi: I32 = 1
        while oi < names.len {
            ordn.push(names[oi])
            oi += 1
        }
    } else {
        vname = gui_ds_marker_file(file)
        if vname == "" {
            return file
        }
        names = gui_ds_ordn_file(file, vname)
        var oi2: I32 = 0
        while oi2 < names.len {
            ordn.push(names[oi2])
            oi2 += 1
        }
    }
    gui_ds_rew_file(file, vname)
    // 合成面宿主符号请求(SL-8c-4② 注入落地):合成三 fn 引 rt_run_anchor/
    // ev_suffix_i,而合并闭包(pkg_refs_walk)看不到 postmerge 才生成的引用——
    // 不请求即被选择性合并剔除(rt_run_anchor undeclared 实红)。顶层 use 走
    // redo 补并路径,已并入符号在 dup 处静默跳过,零重复
    var nu = mk("Use")
    var nsegs = mk("Segs")
    nsegs.push("gui")
    var nsyms = mk("Syms")
    nsyms.push("rt_run_anchor")
    nsyms.push("rt_run_anchor")
    nsyms.push("ev_suffix_i")
    nsyms.push("ev_suffix_i")
    // 契约Ⅱ:组件事件分支调 ev_arg_* 解码器——同闭包不可见铁律
    nsyms.push("ev_arg_s")
    nsyms.push("ev_arg_s")
    nsyms.push("ev_arg_i")
    nsyms.push("ev_arg_i")
    nsyms.push("ev_arg_b")
    nsyms.push("ev_arg_b")
    nu.push(nsegs)
    nu.push(nsyms)
    file.push(nu)
    var hdr: Str = "__ordn__"
    var k2: I32 = 0
    while k2 < ordn.len {
        if k2 > 0 {
            hdr = hdr + ","
        }
        hdr = hdr + ordn[k2]
        k2 += 1
    }
    unit.push(hdr)
    return file
}

// 目标视图名:合并文件中首个 view GuiBlock
fn gui_ds_target(file: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            if d[1] == "view" {
                return d[2]
            }
        }
        i += 1
    }
    return ""
}

// P2 合并面文件净化器:移除合并产物中的非节点子项。
// 白名单 = 顶层 decl 全 kind 集(缺 FnPub 即剥掉全部 pub fn——s41 实红:
// rt_bind_items 等被清,trans 期 fnret 塌 "i" panic;与 pkg_is_named_kind 对齐)
fn gui_ds_sanitize(file: List[Str]) -> List[Str] {
    var out = List[Str]()
    out.push(file[0])
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d.len > 2 {
            var keep: Bool = false
            var tag: Str = d[0]
            if tag == "Fn" { keep = true }
            if tag == "FnPub" { keep = true }
            if tag == "FnC" { keep = true }
            if tag == "FnExt" { keep = true }
            if tag == "Method" { keep = true }
            if tag == "Struct" { keep = true }
            if tag == "Enum" { keep = true }
            if tag == "Trait" { keep = true }
            if tag == "Impl" { keep = true }
            if tag == "Test" { keep = true }
            if tag == "GuiBlock" { keep = true }
            if tag == "Use" { keep = true }
            if tag == "Static" { keep = true }
            if tag == "Const" { keep = true }
            if keep {
                out.push(d)
            }
        }
        i += 1
    }
    return out
}

fn gui_ds_postmerge(file: List[Str], unit: List[Str], diags: List[Str]) -> List[Str] {
    if diags.len > 0 {
        return file
    }
    if unit.len == 0 {
        return file
    }
    var hdr: Str = unit[0]
    if hdr.len < 9 {
        return file
    }
    if byte_slice(hdr, 0, 8) != "__ordn__" {
        return file
    }
    var ordntxt: Str = byte_slice(hdr, 8, hdr.len)
    var ordn = List[Str]()
    var oi: I32 = 0
    var os: I32 = 0
    while oi <= ordntxt.len {
        if oi == ordntxt.len {
            if oi > os {
                ordn.push(byte_slice(ordntxt, os, oi))
            }
            oi += 1
        } else {
            if byte_at(ordntxt, oi) == 44 {
                ordn.push(byte_slice(ordntxt, os, oi))
                os = oi + 1
            }
            oi += 1
        }
    }
    file = gui_ds_sanitize(file)
    var vname: Str = gui_ds_target(file)
    if vname == "" {
        return file
    }
    // 靶视图居末:gt_parse 应用根 = 内嵌源最后声明的视图(组件先声明后用惯例)。
    // 跨文件合并序靶视图(主文件)在前、组件视图(被用模块)在后,不挪则根选中
    // 组件 → 渲染空树(s49 探针实证)。挪尾后 gui_blocks_src 重建序与合成
    // root 一致;单文件靶本就居末,重建为同序 no-op
    var tgt = file[0]
    var found = false
    var nf = List[Str]()
    nf.push(file[0])
    var ri: I32 = 1
    while ri < file.len {
        var rd = file[ri]
        var is_tgt = false
        if rd[0] == "GuiBlock" {
            if rd[1] == "view" {
                if rd[2] == vname {
                    is_tgt = true
                }
            }
        }
        if is_tgt {
            tgt = rd
            found = true
        } else {
            nf.push(rd)
        }
        ri += 1
    }
    if found {
        nf.push(tgt)
        file = nf
    }
    var vnames = List[Str]()
    var vprops = List[Str]()
    gui_ds_views(file, vnames, vprops)
    var dn = List[Str]()
    var dt = List[Str]()
    var vi: I32 = 0
    while vi < vnames.len {
        if vnames[vi] == vname {
            gui_props_typed(vprops[vi], dn, dt)
            vi = vnames.len
        }
        vi += 1
    }
    var stns = List[Str]()
    var sfk = List[Str]()
    var stv = List[Str]()
    gui_field_tables(file, stns, sfk, stv)
    var paths = List[Str]()
    var pty = List[Str]()
    var lists = List[Str]()
    var evn = List[Str]()
    var evf = List[Str]()
    var inps = List[Str]()
    var ievs = List[Str]()
    var crows = List[Str]()
    var cty = List[Str]()
    var cvn = List[Str]()
    var cvf = List[Str]()
    var ciev = List[Str]()
    var bset = List[Str]()
    var bty = List[Str]()
    gui_ds_collect_slots(file, dn, paths, pty, lists, evn, evf, inps, ievs, crows, cty, stns, sfk, stv, cvn, cvf, ciev, bset, bty)
    var made: List[Str] = gui_ds_gen(file, vname, dn, dt, ordn, paths, pty, lists, evn, evf, inps, ievs, crows, cty, stns, sfk, stv, cvn, cvf, ciev, bset, bty)
    // made = p_file 产物(File 节点):[0] 是 "File" 头字符串,从 1 起拼——
    // 从 0 拼即把头串当 decl 注入,trans/emit 面遍历 d[0] 解引用即 SEGV(s41 根因)
    var k: I32 = 1
    while k < made.len {
        file.push(made[k])
        k += 1
    }
    return file
}
