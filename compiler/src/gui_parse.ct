// =====================================================================
// gui_parse.ct —— GUI 块认领与折叠(W1/W2;规范 specs/2026-09-16-gui-ctml-design.md §11.1)
// W1:顶层 view/style 块在 token 流上的平衡扫描认领,记 File 子节点 GuiBlock:
//    [1]=kind [2]=name [3]=块内 token 数 [4]=块内 token 空格连接串(词法 token 无空格,无损)
// W2:gui_lower 折叠——token 串 → 结构化 IR 文本 dump(--dump-gui 口径);
//    颜色 #RRGGBB 格式校验(E8130 前身,W3 接诊断面);令牌查用户常量随 W3(sem 表)。
// 契约:eat_tok 助手(花括号字面量不可词法化)(触发插值扫描吞引号,E1001)——一律字节码比较;
//       注释中不放花括号字符(发射口径词法分歧,见计划文档登记)。
// =====================================================================

fn gui_block(toks: List[Str], cur: Atomic[I32], kind: Str) -> List[Str] {
    var nd = mk("GuiBlock")
    nd.push(kind)
    adv(cur)
    var name: Str = tok(toks, cur)
    adv(cur)
    nd.push(name)
    // 8c-1:view props 形参表捕获(view Name(a: T, b: U) { … })——平衡圆括号
    // 原文入节点尾槽(d[5];既有 d[4]=joined 索引消费者不动)。域包侧仅跳过。
    var props: Str = ""
    if cur.load() < toks.len {
        var pt: Str = tok(toks, cur)
        if pt.len == 1 {
            if byte_at(pt, 0) == 40 {
                adv(cur)
                props = "( "
                var pd: I32 = 1
                while cur.load() < toks.len && pd > 0 {
                    var t2: Str = tok(toks, cur)
                    adv(cur)
                    // 剥 join 流行尾 ~ 标记(多行形参表防护;与 gui_sk_word 同规)
                    if t2.len > 1 {
                        if byte_at(t2, t2.len - 1) == 126 {
                            t2 = byte_slice(t2, 0, t2.len - 1)
                        }
                    }
                    if t2.len == 1 {
                        var b2: I32 = byte_at(t2, 0)
                        if b2 == 40 {
                            pd += 1
                        } else {
                            if b2 == 41 {
                                pd -= 1
                                if pd == 0 {
                                    break
                                }
                            }
                        }
                    }
                    props = props + t2 + " "
                }
                props = props + ")"
            }
        }
    }
    var joined: Str = name
    if kind == "style" {
        // P-W2:extends 对并入 joined——started 旗会丢弃 { 前的 token,
        // 而 check/skeleton/lower 三面的 extends 消费全走 joined 串
        if cur.load() < toks.len {
            var pt2: Str = tok(toks, cur)
            if pt2 == "extends" {
                adv(cur)
                var pn2: Str = tok(toks, cur)
                adv(cur)
                joined = joined + " extends " + pn2
            }
        }
    }
    var depth: I32 = 0
    var toks_n: I32 = 1
    var started: Bool = false
    while true {
        var t: Str = tok(toks, cur)
        if t == "#EOF" {
            panic("gui: 块未闭合 " + kind + " " + name)
        }
        var one: Bool = t.len == 1
        var is_open: Bool = false
        var is_close: Bool = false
        if one {
            if byte_at(t, 0) == 123 {
                is_open = true
            }
            if byte_at(t, 0) == 125 {
                is_close = true
            }
        }
        if is_open {
            depth += 1
            started = true
            if depth == 1 {
                adv(cur)
                continue
            }
        } else {
            if is_close {
                depth -= 1
                if depth == 0 {
                    adv(cur)
                    break
                }
            }
        }
        if started {
            joined = joined + " " + t
            toks_n += 1
        }
        adv(cur)
    }
    nd.push(toks_n.to_string())
    nd.push(joined)
    nd.push(props)
    return nd
}

// ---- token 串拆分(词法 token 无空格,空格单切无损) ----

fn gui_split(joined: Str, out: List[Str]) -> I32 {
    var n: I32 = joined.len
    var i: I32 = 0
    while i < n {
        var start: I32 = i
        while i < n {
            if byte_at(joined, i) == 32 {
                break
            }
            i += 1
        }
        if i > start {
            out.push(byte_slice(joined, start, i))
        }
        i += 1
    }
    return 0
}

fn gui_hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui E8130: 颜色非法十六进制")
    return 0
}

// 颜色串校验(E8130 前身):#RRGGBB;返回打包色
fn gui_unq(v: Str) -> Str {
    if v.len >= 2 {
        if byte_at(v, 0) == 34 {
            if byte_at(v, v.len - 1) == 34 {
                return byte_slice(v, 1, v.len - 1)
            }
        }
    }
    return v
}

fn eat_tok(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    return t
}

fn gui_parse_color(v: Str) -> I32 {
    if v.len != 7 {
        panic("gui E8130: 颜色须 #RRGGBB,得 " + v)
    }
    if byte_at(v, 0) != 35 {
        panic("gui E8130: 颜色须 # 开头,得 " + v)
    }
    var r: I32 = gui_hex1(byte_at(v, 1)) * 16 + gui_hex1(byte_at(v, 2))
    var g: I32 = gui_hex1(byte_at(v, 3)) * 16 + gui_hex1(byte_at(v, 4))
    var b: I32 = gui_hex1(byte_at(v, 5)) * 16 + gui_hex1(byte_at(v, 6))
    return r * 65536 + g * 256 + b
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 视图块折叠:<' tag attrs '>' content '</' tag '>';返回 IR 行(已含缩进)
// attrs:class="x" 与 on:名={handler};叶子文本:字面量 token* + 至多一个 {ident}
fn gui_dump_file(file: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            var out = List[Str]()
            if d[1] == "view" {
                gui_lower_view(tks, cur, "  ", out)
            } else {
                if d[1] == "style" {
                    gui_lower_style(tks, cur, "  ", out)
                }
            }
        }
        i += 1
    }
    return 0
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 元素折叠:<' tag attrs '>' content '</' tag '>'(限深递归;子元素自递归)
// SL-6a 认领:自闭合(input/>)、each item 位置头(in= 绑定列表名)、when cond 绑定名、
// input bind 绑定名、花括号属性值(单词 = 绑定名通道,与域包解析器同构)
fn gui_lower_element(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    if eat_tok(tks, cur) != "<" {
        panic("gui E8100: 期待 <")
    }
    var tag: Str = eat_tok(tks, cur)
    var c: Str = ""
    var onn: Str = ""
    var onf: Str = ""
    var bv: Str = ""
    var itemvar: Str = ""
    if tag == "each" {
        itemvar = eat_tok(tks, cur)
    }
    var selfc: Bool = false
    while tks[cur.load()] != ">" {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            if byte_at(pk, 0) == 47 {
                cur.store(cur.load() + 1)
                selfc = true
                break
            }
        }
        var an: Str = eat_tok(tks, cur)
        if an == "on" {
            if eat_tok(tks, cur) != ":" {
                panic("gui E8100: on 期待冒号")
            }
            onn = eat_tok(tks, cur)
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: on 期待等号")
            }
            var ob: Str = eat_tok(tks, cur)
            if ob.len != 1 {
                panic("gui E8100: on 期待块开")
            }
            if byte_at(ob, 0) != 123 {
                panic("gui E8100: on 期待块开")
            }
            // 8c-3:事件表达式平衡捕获(单标识符旧契约为其特例;gui_bx_expr
            // 消费至配对 } 并剥行尾 ~ 标记)
            onf = gui_bx_expr(tks, cur)
        } else {
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: 属性期待等号")
            }
            var av: Str = ""
            if tks[cur.load()].len == 1 {
                if byte_at(tks[cur.load()], 0) == 123 {
                    cur.store(cur.load() + 1)
                    // SL-8a:平衡捕获+规范形(IR 展示仍包花括号)
                    av = "\{" + gui_bx_expr(tks, cur) + "}"
                }
            }
            if av == "" {
                av = gui_unq(eat_tok(tks, cur))
            }
            if an == "class" {
                c = av
            }
            if an == "cond" {
                bv = av
            }
            if an == "bind" {
                bv = av
            }
            if an == "in" {
                bv = av
            }
        }
    }
    eat_tok(tks, cur)
    var line: Str = ind + "el " + tag
    if itemvar != "" {
        line = line + " item=" + itemvar
    }
    if c != "" {
        line = line + " cls=" + c
    }
    if bv != "" {
        line = line + " bind=" + bv
    }
    if onn != "" {
        line = line + " on:" + onn + "=" + onf
    }
    println(line)
    out.push(line)
    if selfc {
        return 0
    }
    var lit: Str = ""
    while true {
        if tks[cur.load()] == "<" {
            if tks[cur.load() + 1] == "/" {
                break
            }
            if lit != "" {
                var tl: Str = ind + "  " + tag + " text=\"" + lit + "\""
                println(tl)
                out.push(tl)
                lit = ""
            }
            gui_lower_element(tks, cur, ind + "  ", out)
        } else {
            if tks[cur.load()] == "#EOF" {
                panic("gui E8100: 未终止")
            }
            var w: Str = eat_tok(tks, cur)
            if lit != "" {
                lit = lit + " "
            }
            lit = lit + w
        }
    }
    if lit != "" {
        var tline: Str = ind + "  " + tag + " text=\"" + lit + "\""
        println(tline)
        out.push(tline)
    }
    eat_tok(tks, cur)
    eat_tok(tks, cur)
    var et: Str = eat_tok(tks, cur)
    if et != tag {
        panic("gui E8100: 闭合标签不匹配 " + et)
    }
    eat_tok(tks, cur)
    return 0
}

fn gui_lower_view(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui view " + name)
    out.push("view " + name)
    gui_lower_element(tks, cur, ind + "  ", out)
    return 0
}

fn gui_lower_style(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    // P-W2:extends 单亲派生——跳过关键字与父名(dump 不展开继承)
    if cur.load() < tks.len {
        if tks[cur.load()] == "extends" {
            cur.store(cur.load() + 1)
            cur.store(cur.load() + 1)
        }
    }
    println(ind + "gui style " + name)
    out.push("style " + name)
    while cur.load() < tks.len {
        var p: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if tks[cur.load()] != ":" {
            panic("gui E8130: 期待 :,得 " + tks[cur.load()])
        }
        cur.store(cur.load() + 1)
        var v: Str = gui_unq(tks[cur.load()])
        cur.store(cur.load() + 1)
        if p == "bg" {
            var packed: I32 = gui_parse_color(v)
            if packed < 0 {
                panic("gui E8130: 颜色解析失败")
            }
        }
        println(ind + "  " + p + "=" + v)
        out.push(p + "=" + v)
        if cur.load() < tks.len {
            if tks[cur.load()] == ";" {
                cur.store(cur.load() + 1)
            }
        }
    }
    cur.store(cur.load() + 1)
    return 0
}

// SL-7α:程序自身 GuiBlock 重建为 CTML 文本(内嵌 view/style 块端到端的数据源)。
// 形态 = 空格化 token(kind 名 { token* })——域包词法 glit 前置 gws,全容忍;
// ctron_embedded 内建(eval/emit 双口径)据此返回,run_d 文件缺失时兜底。
fn gui_blocks_src(file: List[Str]) -> Str {
    var out: Str = ""
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            // 8c-2:props 形参表(d[5])随重建——否则内嵌兜底源丢 props,
            // 域包 gt_parse 捕获空表,求值切换/链解析静默失效
            out = out + d[1] + " " + d[2] + d[5] + " \{"
            var tks = List[Str]()
            gui_split(d[4], tks)
            var k: I32 = 1
            while k < tks.len {
                var tk: Str = tks[k]
                // 剥行尾标记 ~:join 流的换行编码只服务 dump/check 面,域包词法
                // 不认(gspan 值位 "8~" 会在 ~ 处断词 → 期待标识符)
                if tk.len > 1 {
                    if byte_at(tk, tk.len - 1) == 126 {
                        tk = byte_slice(tk, 0, tk.len - 1)
                    }
                }
                if tk == "<" {
                    if k + 1 < tks.len {
                        if tks[k + 1] == "/" {
                            // </ 粘连:容器闭合探测是裸字节检查(gui.ct 子循环 peek2),
                            // "< /" 会被误判为子元素开头 → gword("/") 期待标识符
                            out = out + " </"
                            k += 2
                            continue
                        }
                    }
                }
                if tk == "=" {
                    if k + 1 < tks.len {
                        var nk2: Str = tks[k + 1]
                        if nk2.len == 1 {
                            if byte_at(nk2, 0) == 123 {
                                // ={ 粘连:attr 值花括号探测同为裸字节检查(= 后直接看 {),
                                // "= {" 会走 gstr 误期待引号串
                                out = out + " =\{"
                                k += 2
                                continue
                            }
                        }
                    }
                }
                out = out + " " + tk
                k += 1
            }
            out = out + " } "
        }
        i += 1
    }
    return out
}

// ==================== SL-8c-4②:gui.run 装配合成 ====================
// run(ViewCall) 调用点改写 + __gui_bind/__gui_act/__gui_run 三 fn 以源文本
// 生成后经真解析器(scan4+p_file)拼写进 File——产物即普通 AST,解释/发射
// 双口径免费。钩子 = pkg_load_use 外壳(预合并注入 use gui.{run_d} 请求,
// 合并后改写+拼写)。v1 差集登记:标题/尺寸默认值(ctcl gui{} 归 J18)、
// 标量 prop 快照语义、旧契约单词事件生成零参调用。

// 构型字段表收集(check 面/合成器共用)
fn gui_field_tables(file: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var ds = file[i]
        if ds[0] == "Struct" {
            if ds.len > 4 {
                var fsx = ds[4]
                var fi: I32 = 1
                while fi < fsx.len {
                    var fd = fsx[fi]
                    if fd[0] == "Field" {
                        stns.push(ds[1])
                        sfk.push(ds[1] + "." + fd[2])
                        stv.push(gui_ty_head_node(fd[3]))
                    }
                    fi += 1
                }
            }
        }
        i += 1
    }
    return 0
}

// 视图收集:名表 + props 形参串表(d[5])
fn gui_ds_views(file: List[Str], vnames: List[Str], vprops: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            if d[1] == "view" {
                vnames.push(d[2])
                if d.len > 5 {
                    vprops.push(d[5])
                } else {
                    vprops.push("")
                }
            }
        }
        i += 1
    }
    return 0
}

// run(ViewCall) 检出:表达式走查(命中返回视图名;未知标签安全返回 "")
fn gui_ds_find_expr(e: List[Str], views: List[Str]) -> Str {
    if e.len < 1 {
        return ""
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[2].len > 1 {
                                        if gui_ck_has_style(views, a[1][1]) {
                                            return a[1][1]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var r: Str = gui_ds_find_expr(e[1], views)
        if r != "" {
            return r
        }
        var i: I32 = 1
        while i < e[2].len {
            r = gui_ds_find_expr(e[2][i], views)
            if r != "" {
                return r
            }
            i += 1
        }
        return ""
    }
    if t == "Binary" {
        var r2: Str = gui_ds_find_expr(e[2], views)
        if r2 != "" {
            return r2
        }
        return gui_ds_find_expr(e[3], views)
    }
    if t == "Unary" {
        return gui_ds_find_expr(e[2], views)
    }
    if t == "Member" {
        return gui_ds_find_expr(e[1], views)
    }
    if t == "NParg" {
        return gui_ds_find_expr(e[2], views)
    }
    if t == "Index" {
        return gui_ds_find_expr(e[1], views)
    }
    return ""
}

// 语句块走查(镜像 p_stmt 标签集;裸表达式语句原样试查)
fn gui_ds_find_block(b: List[Str], views: List[Str]) -> Str {
    var i: I32 = 1
    while i < b.len {
        var s = b[i]
        var t: Str = s[0]
        var hit: Str = ""
        if t == "Return" {
            if s.len > 1 {
                hit = gui_ds_find_expr(s[1], views)
            }
        } else {
            if t == "Let" {
                hit = gui_ds_find_expr(s[4], views)
            } else {
                if t == "While" {
                    hit = gui_ds_find_expr(s[1], views)
                    if hit == "" {
                        hit = gui_ds_find_block(s[2], views)
                    }
                } else {
                    if t == "For" {
                        hit = gui_ds_find_expr(s[2], views)
                        if hit == "" {
                            hit = gui_ds_find_block(s[3], views)
                        }
                    } else {
                        if t == "If" {
                            hit = gui_ds_find_expr(s[1], views)
                            if hit == "" {
                                hit = gui_ds_find_block(s[2], views)
                            }
                            if hit == "" {
                                if s[3][0] == "If" {
                                    hit = gui_ds_find_block(s[3], views)
                                } else {
                                    if s[3][0] == "BlockExpr" {
                                        hit = gui_ds_find_block(s[3][1], views)
                                    }
                                }
                            }
                        } else {
                            if t == "Expr" {
                                hit = gui_ds_find_expr(s[1], views)
                            } else {
                                if t == "Assign" {
                                    hit = gui_ds_find_expr(s[1], views)
                                    if hit == "" {
                                        hit = gui_ds_find_expr(s[3], views)
                                    }
                                } else {
                                    hit = gui_ds_find_expr(s, views)
                                }
                            }
                        }
                    }
                }
            }
        }
        if hit != "" {
            return hit
        }
        i += 1
    }
    return ""
}

fn gui_ds_find_file(file: List[Str], views: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" {
            var hit: Str = gui_ds_find_block(d[5], views)
            if hit != "" {
                return hit
            }
        }
        i += 1
    }
    return ""
}

// 命中节点就地改写:被调换 __gui_run_<V>,实参 = NParg 值表达式按序
fn gui_ds_rew_expr(e: List[Str], vname: Str) -> I32 {
    if e.len < 1 {
        return 0
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[1][1] == vname {
                                        var nn = mk("Ident")
                                        nn.push("__gui_run_" + vname)
                                        e[1] = nn
                                        var na = mk("Args")
                                        var i: I32 = 1
                                        while i < a[2].len {
                                            na.push(a[2][i][2])
                                            i += 1
                                        }
                                        e[2] = na
                                        return 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if gui_ds_rew_expr(e[1], vname) > 0 {
            return 1
        }
        var i: I32 = 1
        while i < e[2].len {
            if gui_ds_rew_expr(e[2][i], vname) > 0 {
                return 1
            }
            i += 1
        }
        return 0
    }
    if t == "Binary" {
        if gui_ds_rew_expr(e[2], vname) > 0 {
            return 1
        }
        return gui_ds_rew_expr(e[3], vname)
    }
    if t == "Unary" {
        return gui_ds_rew_expr(e[2], vname)
    }
    if t == "Member" {
        return gui_ds_rew_expr(e[1], vname)
    }
    if t == "NParg" {
        return gui_ds_rew_expr(e[2], vname)
    }
    if t == "Index" {
        return gui_ds_rew_expr(e[1], vname)
    }
    return 0
}

fn gui_ds_rew_block(b: List[Str], vname: Str) -> I32 {
    var i: I32 = 1
    while i < b.len {
        var s = b[i]
        var t: Str = s[0]
        var hit: I32 = 0
        if t == "Return" {
            if s.len > 1 {
                hit = gui_ds_rew_expr(s[1], vname)
            }
        } else {
            if t == "Let" {
                hit = gui_ds_rew_expr(s[4], vname)
            } else {
                if t == "While" {
                    hit = gui_ds_rew_expr(s[1], vname)
                    if hit == 0 {
                        hit = gui_ds_rew_block(s[2], vname)
                    }
                } else {
                    if t == "For" {
                        hit = gui_ds_rew_expr(s[2], vname)
                        if hit == 0 {
                            hit = gui_ds_rew_block(s[3], vname)
                        }
                    } else {
                        if t == "If" {
                            hit = gui_ds_rew_expr(s[1], vname)
                            if hit == 0 {
                                hit = gui_ds_rew_block(s[2], vname)
                            }
                            if hit == 0 {
                                if s[3][0] == "If" {
                                    hit = gui_ds_rew_block(s[3], vname)
                                } else {
                                    if s[3][0] == "BlockExpr" {
                                        hit = gui_ds_rew_block(s[3][1], vname)
                                    }
                                }
                            }
                        } else {
                            if t == "Expr" {
                                hit = gui_ds_rew_expr(s[1], vname)
                            } else {
                                if t == "Assign" {
                                    hit = gui_ds_rew_expr(s[1], vname)
                                    if hit == 0 {
                                        hit = gui_ds_rew_expr(s[3], vname)
                                    }
                                } else {
                                    hit = gui_ds_rew_expr(s, vname)
                                }
                            }
                        }
                    }
                }
            }
        }
        if hit > 0 {
            return 1
        }
        i += 1
    }
    return 0
}

fn gui_ds_rew_file(file: List[Str], vname: Str) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" {
            if gui_ds_rew_block(d[5], vname) > 0 {
                return 1
            }
        }
        i += 1
    }
    return 0
}

// 路径型别解析(prop 根起逐段;len 尾段=I32;未知="")
fn gui_ds_path_ty(path: Str, pnames: List[Str], ptyps: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str]) -> Str {
    var segs = List[Str]()
    var i: I32 = 0
    var start: I32 = 0
    while i < path.len {
        if byte_at(path, i) == 46 {
            segs.push(byte_slice(path, start, i))
            start = i + 1
        }
        i += 1
    }
    segs.push(byte_slice(path, start, path.len))
    var root: Str = segs[0]
    if !gui_ck_has_style(pnames, root) {
        return ""
    }
    var cur: Str = ""
    var ri: I32 = 0
    while ri < pnames.len {
        if pnames[ri] == root {
            cur = gui_ty_head_txt(ptyps[ri])
            ri = pnames.len
        }
        ri += 1
    }
    var si: I32 = 1
    while si < segs.len {
        var seg: Str = segs[si]
        var last: Bool = si == segs.len - 1
        var fkey: Str = cur + "." + seg
        if gui_ck_has_style(sfk, fkey) {
            var fi: I32 = 0
            while fi < sfk.len {
                if sfk[fi] == fkey {
                    cur = gui_ty_head_txt(stv[fi])
                    fi = sfk.len
                }
                fi += 1
            }
        } else {
            if seg == "len" {
                if last {
                    return "I32"
                }
                return ""
            }
            return ""
        }
        si += 1
    }
    return cur
}

// 路径根改写(prop 名 → 合成参数 token)
fn gui_ds_rw(path: Str, pnames: List[Str], ptoks: List[Str]) -> Str {
    var root: Str = path
    var di: I32 = 0
    while di < path.len {
        if byte_at(path, di) == 46 {
            root = byte_slice(path, 0, di)
            di = path.len
        }
        di += 1
    }
    var ri: I32 = 0
    while ri < pnames.len {
        if pnames[ri] == root {
            return ptoks[ri] + byte_slice(path, root.len, path.len)
        }
        ri += 1
    }
    return path
}

// ==================== 独立 .ctml 检查入口(SL-6c;§5.1 语法缝)====================
// 内嵌/独立同语法同路径:标记 tokenizer → 复用 gui_block 平衡认领 → GuiBlock File 节
// → gui_dump_file/gui_check_file 同一走查。契约不变:GuiBlock[4]=空格连接串,
// token 不得含空格(串字面量含空格即降级,与内嵌口径一致)。

// 后缀判定:p 以 .ctml 结尾
fn gui_is_ctml(p: Str) -> Bool {
    if p.len < 5 {
        return false
    }
    var i: I32 = 0
    while i < 5 {
        if byte_at(p, p.len - 5 + i) != byte_at(".ctml", i) {
            return false
        }
        i += 1
    }
    return true
}

// 标记 tokenizer:< > = : ; / 单字符;花括号单字符;串字面量(可含转义)一 token;
// // 行注释跳过;词 = 非空白非特殊字节连续段(含 UTF-8 多字节)
fn gui_ctml_tokens(src: Str, out: List[Str]) -> I32 {
    var n: I32 = src.len
    var i: I32 = 0
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i += 1
        } else {
            if b == 47 {
                if i + 1 < n {
                    if byte_at(src, i + 1) == 47 {
                        while i < n {
                            if byte_at(src, i) == 10 {
                                break
                            }
                            i += 1
                        }
                        continue
                    }
                }
                out.push("/")
                i += 1
            } else {
                if b == 34 {
                    var j: I32 = i + 1
                    while j < n {
                        var cb: I32 = byte_at(src, j)
                        if cb == 92 {
                            j += 2
                            continue
                        }
                        if cb == 34 {
                            break
                        }
                        j += 1
                    }
                    if j >= n {
                        j = n - 1
                    }
                    out.push(byte_slice(src, i, j + 1))
                    i = j + 1
                } else {
                    if b == 60 || b == 62 || b == 61 || b == 123 || b == 125 || b == 58 || b == 59 {
                        out.push(byte_slice(src, i, i + 1))
                        i += 1
                    } else {
                        var j2: I32 = i
                        while j2 < n {
                            var wb: I32 = byte_at(src, j2)
                            if wb == 32 || wb == 9 || wb == 10 || wb == 13 {
                                break
                            }
                            if wb == 60 || wb == 62 || wb == 61 || wb == 123 || wb == 125 || wb == 58 || wb == 59 || wb == 47 || wb == 34 {
                                break
                            }
                            j2 += 1
                        }
                        if j2 > i {
                            out.push(byte_slice(src, i, j2))
                            i = j2
                        } else {
                            i += 1
                        }
                    }
                }
            }
        }
    }
    return 0
}

// 独立 .ctml 源 → File 节(子 = GuiBlock;顶层扫 view/style 关键字交 gui_block 认领)
fn gui_ctml_file(src: Str) -> List[Str] {
    var toks = List[Str]()
    gui_ctml_tokens(src, toks)
    var file = mk("File")
    var cur = Atomic[I32](0)
    while cur.load() < toks.len {
        var t: Str = toks[cur.load()]
        if t == "view" {
            file.push(gui_block(toks, cur, "view"))
        } else {
            if t == "style" {
                file.push(gui_block(toks, cur, "style"))
            } else {
                cur.store(cur.load() + 1)
            }
        }
    }
    return file
}

// ==================== gui_check:检查面(W3;§4.4 E8xxx 语料验收)====================
// 收集式(不 panic/不打印):诊断行入 gdiags("E8xxx: msg"),块内首错即止。
// 结构口径与 dump lower 一致(限深 1:根=容器,子=叶子)。
// 注意:本段一律用 eat_tok(eat 旧名已弃;花括号字面量不可词法化,一律字节码比较)。

fn gui_ck_has_style(sn: List[Str], name: Str) -> Bool {
    var i: I32 = 0
    while i < sn.len {
        if sn[i] == name {
            return true
        }
        i += 1
    }
    return false
}

// 8c-1:表达式根标识符提取——每个 ident 路径的首段(点前);字符串字面量内跳过
fn gui_bx_roots(e: Str, out: List[Str]) {    var i: I32 = 0
    var instr: Bool = false
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 {
                    var start: I32 = i
                    while i < e.len {
                        var c: I32 = byte_at(e, i)
                        if c == 46 {
                            break
                        }
                        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
                            i += 1
                        } else {
                            break
                        }
                    }
                    var root: Str = byte_slice(e, start, i)
                    // 点链续段:成员访问非根,吞并 .ident 序列(model.todos.len → 根 model)
                    while i < e.len {
                        if byte_at(e, i) != 46 {
                            break
                        }
                        var j: I32 = i + 1
                        if j >= e.len {
                            break
                        }
                        var c2: I32 = byte_at(e, j)
                        if !((c2 >= 65 && c2 <= 90) || (c2 >= 97 && c2 <= 122) || c2 == 95) {
                            break
                        }
                        i = j
                        while i < e.len {
                            var c3: I32 = byte_at(e, i)
                            if c3 == 46 {
                                break
                            }
                            if (c3 >= 65 && c3 <= 90) || (c3 >= 97 && c3 <= 122) || (c3 >= 48 && c3 <= 57) || c3 == 95 {
                                i += 1
                            } else {
                                break
                            }
                        }
                    }
                    if !gui_ck_has_style(out, root) {
                        out.push(root)
                    }
                }
            }
        }
        i += 1
    }
}

// 8c-3:Fn/FnExt 节点形参个数(d[3]=Ps 子节点数,VaArgs 计一;形态外 -2)
fn gui_fn_arity(d: List[Str]) -> I32 {
    if d.len <= 3 {
        return -2
    }
    var ps = d[3]
    if ps[0] != "Ps" {
        return -2
    }
    return ps.len - 1
}

// 8c-3:名 → 形参个数(首匹配;未声明 -1)
fn gui_ck_fn_argc(fns: List[Str], fna: List[I32], name: Str) -> I32 {
    var i: I32 = 0
    while i < fns.len {
        if fns[i] == name {
            return fna[i]
        }
        i += 1
    }
    return -1
}

// 8c-3:on: 事件表达式形态分析(规范化形,空白已剥)。
// 头 = 前导标识符;argc[0]: -1=单标识符(旧契约)/ -2=形态非法 / >=0=调用实参数;
// aout[0] = 调用形态实参串(括号内原文)。字符串字面量内标点不参与配对;
// 闭括号须为表达式末字节(f(a)(b) 即非法)。
fn gui_ev_head2(e: Str, argc: List[I32], aout: List[Str]) -> Str {
    var i: I32 = 0
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
            i += 1
        } else {
            break
        }
    }
    var head: Str = byte_slice(e, 0, i)
    if i == e.len {
        if head.len == 0 {
            argc.push(-2)
        } else {
            argc.push(-1)
        }
        return head
    }
    if head.len == 0 {
        argc.push(-2)
        return head
    }
    if byte_at(e, i) != 40 {
        argc.push(-2)
        return head
    }
    var j: I32 = i + 1
    var depth: I32 = 1
    var instr: Bool = false
    var commas: I32 = 0
    var seen: Bool = false
    var close: I32 = -1
    while j < e.len {
        var c: I32 = byte_at(e, j)
        if instr {
            if c == 92 {
                j += 1
            } else {
                if c == 34 {
                    instr = false
                }
            }
        } else {
            if c == 34 {
                instr = true
            } else {
                if c == 40 {
                    depth += 1
                } else {
                    if c == 41 {
                        depth -= 1
                        if depth == 0 {
                            close = j
                            break
                        }
                    } else {
                        if c == 44 {
                            if depth == 1 {
                                commas += 1
                            }
                        }
                    }
                }
            }
            if c != 32 && c != 9 && c != 10 && c != 13 {
                seen = true
            }
        }
        j += 1
    }
    if close != e.len - 1 {
        argc.push(-2)
        return head
    }
    if seen {
        argc.push(commas + 1)
    } else {
        argc.push(0)
    }
    aout.push(byte_slice(e, i + 1, close))
    return head
}

// 8c-4 地基:完整点链路径提取(含段;"m.count" 整链;字符串字面量内跳过)
fn gui_bx_dotted(e: Str, out: List[Str]) {
    var i: I32 = 0
    var instr: Bool = false
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 {
                    var start: I32 = i
                    while i < e.len {
                        var c: I32 = byte_at(e, i)
                        if c == 46 || c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
                            i += 1
                        } else {
                            break
                        }
                    }
                    var path: Str = byte_slice(e, start, i)
                    if !gui_ck_has_style(out, path) {
                        out.push(path)
                    }
                }
            }
        }
        i += 1
    }
}

// 8c-4 地基:props 形参类型提取——"( m: Model, n: Box[T] )" 拆 名:型原文
fn gui_props_typed(d5: Str, names: List[Str], types: List[Str]) -> I32 {
    if d5.len > 2 {
        var seg: Str = byte_slice(d5, 2, d5.len - 2)
        var pi: I32 = 0
        while pi < seg.len {
            var ps: I32 = pi
            while pi < seg.len {
                if byte_at(seg, pi) == 44 {
                    break
                }
                pi += 1
            }
            var unit: Str = byte_slice(seg, ps, pi)
            var ui: I32 = 0
            while ui < unit.len {
                if byte_at(unit, ui) == 58 {
                    var pn: Str = byte_slice(unit, 0, ui)
                    var pt: Str = byte_slice(unit, ui + 1, unit.len)
                    names.push(gui_trim(pn))
                    types.push(gui_trim(pt))
                    ui = unit.len
                }
                ui += 1
            }
            pi += 1
        }
    }
    return 0
}

// 首尾剥空白
fn gui_trim(s: Str) -> Str {
    var a: I32 = 0
    var b: I32 = s.len
    while a < b {
        var c: I32 = byte_at(s, a)
        if c == 32 || c == 9 {
            a += 1
        } else {
            break
        }
    }
    while b > a {
        var c2: I32 = byte_at(s, b - 1)
        if c2 == 32 || c2 == 9 {
            b -= 1
        } else {
            break
        }
    }
    return byte_slice(s, a, b)
}

// 型原文取头名(Box[T] 拆内层头;List/基元原样)
fn gui_ty_head_txt(t: Str) -> Str {
    var head: Str = ""
    var i: I32 = 0
    while i < t.len {
        var c: I32 = byte_at(t, i)
        if c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            head = head + byte_slice(t, i, i + 1)
            i += 1
        } else {
            break
        }
    }
    if head == "Box" {
        var lo: I32 = -1
        var k: I32 = 0
        while k < t.len {
            if byte_at(t, k) == 91 {
                lo = k
                break
            }
            k += 1
        }
        if lo >= 0 {
            return gui_ty_head_txt(gui_trim(byte_slice(t, lo + 1, t.len)))
        }
    }
    return head
}

// 8c-4 地基:props 类型门——dotted 路径段级核对(构型字段存在性;
// 尾段 len 对 List/Str 豁免;未知构型/跨包型跳过=登记边界)。
// 返回 -1 即违例(诊断已入 gdiags)
fn gui_ck_prop_path(path: Str, pnames: List[Str], ptyps: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], gdiags: List[Str], where: Str) -> I32 {
    // 拆段
    var segs = List[Str]()
    var i: I32 = 0
    var start: I32 = 0
    while i < path.len {
        if byte_at(path, i) == 46 {
            segs.push(byte_slice(path, start, i))
            start = i + 1
        }
        i += 1
    }
    segs.push(byte_slice(path, start, path.len))
    var root: Str = segs[0]
    // 根须为 prop
    if !gui_ck_has_style(pnames, root) {
        return 0
    }
    var cur: Str = ""
    var ri: I32 = 0
    while ri < pnames.len {
        if pnames[ri] == root {
            cur = gui_ty_head_txt(ptyps[ri])
            ri = pnames.len
        }
        ri += 1
    }
    // 根型未知(基元/未声明/跨包)→ 段级门跳过
    if !gui_ck_has_style(stns, cur) {
        return 0
    }
    var si: I32 = 1
    while si < segs.len {
        var seg: Str = segs[si]
        var last: Bool = si == segs.len - 1
        var fkey: Str = cur + "." + seg
        if gui_ck_has_style(sfk, fkey) {
            var fi: I32 = 0
            while fi < sfk.len {
                if sfk[fi] == fkey {
                    cur = gui_ty_head_txt(stv[fi])
                    fi = sfk.len
                }
                fi += 1
            }
        } else {
            if seg == "len" {
                if last {
                    return 0
                }
                gdiags.push("E8110: len 后缀须为路径末段 " + path + " 于 " + where)
                return -1
            }
            gdiags.push("E8110: 字段未声明 " + path + "(" + cur + " 无 " + seg + ") 于 " + where)
            return -1
        }
        si += 1
    }
    return 0
}

// 型节点取头名(Box 拆内层;Ref/Optional 穿透;其余以节点 tag 收底——非 Named
// 不入构型表即段级门自然跳过)
fn gui_ty_head_node(t: List[Str]) -> Str {
    var tag: Str = t[0]
    if tag == "Named" {
        if t[1] == "Box" {
            if t.len > 2 {
                var ta = t[2]
                if ta.len > 1 {
                    return gui_ty_head_node(ta[1])
                }
            }
        }
        return t[1]
    }
    if tag == "Ref" {
        return gui_ty_head_node(t[1])
    }
    if tag == "Optional" {
        return gui_ty_head_node(t[1])
    }
    return tag
}

// 8c-4 地基:绑定/事件实参表达式统一引用门——props 视图内:
//   根 ∈ each 项 scope → 不设门;根 ∈ prop → 段级类型门;否则根越界 E8110。
// 裸名单视图(props 空)零设门(8c-1 契约)
fn gui_ck_bx_gate(e: Str, props: List[Str], ptyps: List[Str], pscope: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], gdiags: List[Str], where: Str) -> I32 {
    if props.len == 0 {
        return 0
    }
    var bad: I32 = 0
    var paths = List[Str]()
    gui_bx_dotted(e, paths)
    var ii: I32 = 0
    while ii < paths.len {
        var p: Str = paths[ii]
        var root: Str = p
        var di: I32 = 0
        while di < p.len {
            if byte_at(p, di) == 46 {
                root = byte_slice(p, 0, di)
                di = p.len
            }
            di += 1
        }
        if gui_ck_has_style(pscope, root) {
            // each 项变量:项文本直取,不设门
        } else {
            if gui_ck_has_style(props, root) {
                if gui_ck_prop_path(p, props, ptyps, stns, sfk, stv, gdiags, where) < 0 {
                    bad = -1
                }
            } else {
                gdiags.push("E8110: 绑定引用未声明(须 prop/each 项) " + root + " 于 " + where)
                bad = -1
            }
        }
        ii += 1
    }
    return bad
}

fn gui_ck_color(v: Str, gdiags: List[Str]) -> I32 {
    if v.len != 7 {
        gdiags.push("E8130: 颜色须 #RRGGBB,得 " + v)
        return -1
    }
    if byte_at(v, 0) != 35 {
        gdiags.push("E8130: 颜色须 # 开头,得 " + v)
        return -1
    }
    var i: I32 = 1
    while i < 7 {
        var b: I32 = byte_at(v, i)
        var ok: Bool = b >= 48 && b <= 57
        if !ok {
            if b >= 97 {
                if b <= 102 {
                    ok = true
                }
            }
        }
        if !ok {
            if b >= 65 {
                if b <= 70 {
                    ok = true
                }
            }
        }
        if !ok {
            gdiags.push("E8130: 颜色含非十六进制字符,得 " + v)
            return -1
        }
        i += 1
    }
    return 0
}

fn gui_ck_tag(tag: Str, gdiags: List[Str]) -> I32 {
    // 白名单对齐域包 rt_emit 认领面(gui.ct):容器/叶子/包装元素
    if tag == "vbox" {
        return 0
    }
    if tag == "hbox" {
        return 0
    }
    if tag == "label" {
        return 0
    }
    if tag == "button" {
        return 0
    }
    if tag == "when" {
        return 0
    }
    if tag == "each" {
        return 0
    }
    if tag == "input" {
        return 0
    }
    if tag == "checkbox" {
        return 0
    }
    if tag == "spacer" {
        return 0
    }
    gdiags.push("E8100: 未声明标签 " + tag)
    return -1
}

// SL-6(M1-d 合流):递归元素走查(镜像 gui_lower 结构;限深 8 守卫)。
// 认领:when cond 绑定名 / each item 位置头(in= 绑定列表名) / input bind 绑定名自闭合 /
// 花括号属性值(单词 = 绑定名通道)。诊断:
//   E8100 未知标签/闭合不匹配/props 缺失(when 无 cond、input 无 bind、each 无 in)
//   E8110 cond/bind/in 属性契约形态(须花括号绑定名,字符串即绑定期物不符);
//        8c-3 扩:on: 事件表达式形态(仅路径/调用)与实参根门(props 视图)
//   E8120 on: 处理器未声明;8c-3 扩:调用形态实参个数 vs 声明形参(签名门;
//        单标识符旧契约仅存在性;indep 独立形态两门均跳)
//   E8193 each 体含 input 型控件(警告入 gwarns,不置 rc;key 原语未落地前索引对齐即串位)
// sawin = 子树 input 计数累加器(Atomic;each 据此发 E8193,嵌套 each 各自报)。
fn gui_ck_elem(tks: List[Str], cur: Atomic[I32], sn: List[Str], fns: List[Str], fna: List[I32], gdiags: List[Str], gwarns: List[Str], depth: I32, sawin: Atomic[I32], indep: Bool, props: List[Str], ptyps: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str], pscope: List[Str]) -> I32 {
    var bad: I32 = 0
    if depth > 8 {
        gdiags.push("E8100: 嵌套超限(限深 8)")
        return -1
    }
    var tag: Str = eat_tok(tks, cur)
    if gui_ck_tag(tag, gdiags) < 0 {
        bad = -1
    }
    if tag == "input" {
        sawin.store(sawin.load() + 1)
    }
    // 子树词法作用域:each 项变量入内(8c-1;非 each 视图共享外层 scope 列表)
    var cscope: List[Str] = pscope
    if tag == "each" {
        // 位置头:item in={列表}(域包先于 attrs 解析,镜像)
        if cur.load() < tks.len {
            var it: Str = tks[cur.load()]
            if it != ">" {
                if it != "/" {
                    cur.store(cur.load() + 1)
                    cscope = List[Str]()
                    var si: I32 = 0
                    while si < pscope.len {
                        cscope.push(pscope[si])
                        si += 1
                    }
                    cscope.push(it)
                }
            }
        }
    }
    var has_cond: Bool = false
    var has_bind: Bool = false
    var has_in: Bool = false
    var has_checked: Bool = false
    var selfc: Bool = false
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 62 {
                cur.store(cur.load() + 1)
                break
            }
            if pb == 47 {
                cur.store(cur.load() + 1)
                selfc = true
                break
            }
        }
        var an: Str = eat_tok(tks, cur)
        if an == "on" {
            // on:名=花括号事件表达式:块开逐 token 校验(曾盲吃 5 漏收尾闭,W3 口径),
            // 块体 8c-3 平衡捕获(单标识符旧契约为特例;配对 } 由捕获消费)
            if eat_tok(tks, cur) != ":" {
                gdiags.push("E8100: on 期待冒号")
                bad = -1
            }
            var evn: Str = eat_tok(tks, cur)
            var hn: Str = ""
            if eat_tok(tks, cur) != "=" {
                gdiags.push("E8100: on 期待等号")
                bad = -1
            } else {
                var ob: Str = eat_tok(tks, cur)
                if ob.len != 1 {
                    gdiags.push("E8100: on 期待块开")
                    bad = -1
                } else {
                    if byte_at(ob, 0) != 123 {
                        gdiags.push("E8100: on 期待块开")
                        bad = -1
                    } else {
                        hn = gui_bx_expr(tks, cur)
                    }
                }
            }
            if hn == "" {
                gdiags.push("E8100: on 事件表达式为空")
                bad = -1
            }
            if hn != "" {
                // 8c-3 事件表达式门:形态(单标识符旧契约 / 调用形态)+ E8120
                // 存在与签名(实参个数 vs 声明形参;indep 独立形态处理函数在
                // 伴生 .ct,跳过)+ E8110 实参根门(props 视图,复用 8c-1 通道)
                var argc = List[I32]()
                var aout = List[Str]()
                var head: Str = gui_ev_head2(hn, argc, aout)
                if argc[0] == -2 {
                    gdiags.push("E8110: on: 事件表达式仅路径或调用形态 " + hn + "(on:" + evn + ")")
                    bad = -1
                } else {
                    if argc[0] == -1 {
                        // indep = 独立 .ctml 形态(处理函数在伴生 .ct,跨文件解析 SL-7+)
                        // ——跳过存在性检查;内嵌形态恒严格核对(与 Fn 表有无无关)
                        if !indep {
                            if !gui_ck_has_style(fns, hn) {
                                gdiags.push("E8120: 事件处理器未声明 " + hn + "(on:" + evn + ")")
                                bad = -1
                            }
                        }
                    } else {
                        if !indep {
                            var da: I32 = gui_ck_fn_argc(fns, fna, head)
                            if da < 0 {
                                gdiags.push("E8120: 事件处理器未声明 " + head + "(on:" + evn + ")")
                                bad = -1
                            } else {
                                if da != argc[0] {
                                    gdiags.push("E8120: 事件签名不匹配 " + head + "(实参 " + argc[0].to_string() + ",声明 " + da.to_string() + ")(on:" + evn + ")")
                                    bad = -1
                                }
                            }
                        }
                        if gui_ck_bx_gate(aout[0], props, ptyps, pscope, stns, sfk, stv, gdiags, "on:" + evn + "=\{" + hn + "}") < 0 {
                            bad = -1
                        }
                    }
                }
            }
        } else {
            if eat_tok(tks, cur) != "=" {
                gdiags.push("E8100: 属性期待等号")
                bad = -1
            } else {
                var av: Str = ""
                var brform: Bool = false
                if cur.load() < tks.len {
                    var pv: Str = tks[cur.load()]
                    if pv.len == 1 {
                        if byte_at(pv, 0) == 123 {
                            cur.store(cur.load() + 1)
                            av = gui_bx_expr(tks, cur)
                            if av == "" {
                                gdiags.push("E8100: 花括号属性期待表达式")
                                bad = -1
                            }
                            brform = true
                            if gui_bx_impure(av) {
                                gdiags.push("E8190: 绑定表达式纯度违规(赋值/自增减) " + an + "=\{" + av + "}")
                                bad = -1
                            }
                            // 8c-1:prop 引用门——props 视图内,路径根须为已声明
                            // prop 或 each 项变量(裸名通道视图不设门,零破坏)
                            if gui_ck_bx_gate(av, props, ptyps, pscope, stns, sfk, stv, gdiags, an + "=\{" + av + "}") < 0 {
                                bad = -1
                            }
                        }
                    }
                }
                if !brform {
                    if cur.load() < tks.len {
                        av = gui_unq(eat_tok(tks, cur))
                    }
                }
                if an == "class" {
                    if !gui_ck_has_style(sn, av) {
                        gdiags.push("E8150: class 引用未定义样式 " + av)
                        bad = -1
                    }
                }
                if an == "cond" {
                    has_cond = true
                    if !brform {
                        gdiags.push("E8110: cond 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "bind" {
                    has_bind = true
                    if !brform {
                        gdiags.push("E8110: bind 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "in" {
                    has_in = true
                    if !brform {
                        gdiags.push("E8110: in 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "checked" {
                    has_checked = true
                    if !brform {
                        gdiags.push("E8110: checked 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
            }
        }
    }
    if tag == "when" {
        if !has_cond {
            gdiags.push("E8100: when 缺 cond")
            bad = -1
        }
    }
    if tag == "input" {
        if !has_bind {
            gdiags.push("E8100: input 缺 bind")
            bad = -1
        }
    }
    if tag == "checkbox" {
        if !has_checked {
            gdiags.push("E8100: checkbox 缺 checked")
            bad = -1
        }
    }
    if tag == "each" {
        if !has_in {
            gdiags.push("E8100: each 缺 in")
            bad = -1
        }
    }
    if selfc {
        return bad
    }
    var in_before: I32 = sawin.load()
    while cur.load() < tks.len {
        var pk2: Str = tks[cur.load()]
        if pk2.len == 1 {
            var b2: I32 = byte_at(pk2, 0)
            if b2 == 60 {
                // <:子元素或本元素闭合
                if cur.load() + 1 < tks.len {
                    var nk: Str = tks[cur.load() + 1]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 47 {
                            cur.store(cur.load() + 2)
                            if cur.load() < tks.len {
                                var et: Str = eat_tok(tks, cur)
                                if et != tag {
                                    gdiags.push("E8100: 闭合标签不匹配 " + et)
                                    bad = -1
                                }
                            }
                            if cur.load() < tks.len {
                                var gt: Str = tks[cur.load()]
                                if gt.len == 1 {
                                    if byte_at(gt, 0) == 62 {
                                        cur.store(cur.load() + 1)
                                    }
                                }
                            }
                            break
                        }
                    }
                }
                cur.store(cur.load() + 1)
                var cb: I32 = gui_ck_elem(tks, cur, sn, fns, fna, gdiags, gwarns, depth + 1, sawin, indep, props, ptyps, stns, sfk, stv, cscope)
                if cb < 0 {
                    bad = -1
                }
            } else {
                if b2 == 35 {
                    gdiags.push("E8100: 未终止 " + tag)
                    bad = -1
                    break
                }
                if b2 == 123 {
                    // 叶插值槽(8c-1):平衡捕获 + prop 引用门(与 attr 槽同规)
                    cur.store(cur.load() + 1)
                    var lv: Str = gui_bx_expr(tks, cur)
                    if gui_ck_bx_gate(lv, props, ptyps, pscope, stns, sfk, stv, gdiags, "叶") < 0 {
                        bad = -1
                    }
                    continue
                }
                cur.store(cur.load() + 1)
            }
        } else {
            cur.store(cur.load() + 1)
        }
    }
    if tag == "each" {
        if sawin.load() > in_before {
            gwarns.push("E8193: each 体含 input,索引对齐重排将串位(key 原语未落地)")
        }
    }
    return bad
}

// 8c-1/8c-2:view props 形参名表——"( a: T, b: U )" 形态拆名(类型段弃,
// 字段段类型门登记待 props 类型面)。check 面引用门与骨架表(s22 双端同形)共用。
fn gui_props_names(d5: Str, out: List[Str]) -> I32 {
    if d5.len > 2 {
        var seg: Str = byte_slice(d5, 2, d5.len - 2)
        var pi: I32 = 0
        while pi < seg.len {
            var ps: I32 = pi
            while pi < seg.len {
                if byte_at(seg, pi) == 44 {
                    break
                }
                pi += 1
            }
            var unit: Str = byte_slice(seg, ps, pi)
            var ui: I32 = 0
            while ui < unit.len {
                if byte_at(unit, ui) == 58 {
                    var pn: Str = byte_slice(unit, 0, ui)
                    var pe: I32 = pn.len
                    while pe > 0 {
                        var pc: I32 = byte_at(pn, pe - 1)
                        if pc == 32 || pc == 9 {
                            pe -= 1
                        } else {
                            break
                        }
                    }
                    var psi: I32 = 0
                    while psi < pe {
                        if byte_at(pn, psi) != 32 && byte_at(pn, psi) != 9 {
                            break
                        }
                        psi += 1
                    }
                    if pe > psi {
                        out.push(byte_slice(pn, psi, pe))
                    }
                    ui = unit.len
                }
                ui += 1
            }
            pi += 1
        }
    }
    return 0
}

fn gui_check_file(file: List[Str], gdiags: List[Str], gwarns: List[Str], indep: Bool) -> I32 {
    // 第一遍:样式名表 + Fn/FnExt 名表与形参个数表(E8120 存在/签名门依据)
    var sn = List[Str]()
    var fns = List[Str]()
    var fna = List[I32]()
    var sext = List[Str]()
    // 8c-4 地基:构型字段表(stns=构型名 sfk=构型.字段 stv=字段型头)——段级类型门依据
    var stns = List[Str]()
    var sfk = List[Str]()
    var stv = List[Str]()
    var si: I32 = 1
    while si < file.len {
        var ds = file[si]
        if ds[0] == "GuiBlock" {
            if ds[1] == "style" {
                var stks = List[Str]()
                gui_split(ds[4], stks)
                sn.push(stks[0])
                // P-W2:extends 对收集(第二遍做环/缺父诊断)
                if stks.len > 2 {
                    if stks[1] == "extends" {
                        sext.push(stks[0])
                        sext.push(stks[2])
                    }
                }
            }
        }
        if ds[0] == "Fn" {
            if ds.len > 1 {
                fns.push(ds[1])
                fna.push(gui_fn_arity(ds))
            }
        }
        if ds[0] == "Struct" {
            if ds.len > 4 {
                var fsx = ds[4]
                var fi: I32 = 1
                while fi < fsx.len {
                    var fd = fsx[fi]
                    if fd[0] == "Field" {
                        stns.push(ds[1])
                        sfk.push(ds[1] + "." + fd[2])
                        stv.push(gui_ty_head_node(fd[3]))
                    }
                    fi += 1
                }
            }
        }
        if ds[0] == "FnExt" {
            if ds.len > 1 {
                fns.push(ds[1])
                fna.push(gui_fn_arity(ds))
            }
        }
        si += 1
    }
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                // 8c-1:props 形参表(d[5],"( a: T, b: U )" 形)解析为名表
                var vprops = List[Str]()
                var vptyps = List[Str]()
                if d.len > 5 {
                    gui_props_typed(d[5], vprops, vptyps)
                }
                cur.store(1)
                if eat_tok(tks, cur) != "<" {
                    gdiags.push("E8100: view 期待 <")
                } else {
                var sawin = Atomic[I32](0)
                var emptyscope = List[Str]()
                gui_ck_elem(tks, cur, sn, fns, fna, gdiags, gwarns, 1, sawin, indep, vprops, vptyps, stns, sfk, stv, emptyscope)
                }
            } else {
                if d[1] == "style" {
                    // joined 以名字开头(tks[0]),与 view 路径同样跳过——
                    // 否则属性错位一位:冒号误报 + 游标越界,整个检查崩溃丢诊断(W3 修复)
                    cur.store(1)
                    // P-W2:extends 跳过(诊断在主循环后统一做)
                    if cur.load() < tks.len {
                        if tks[cur.load()] == "extends" {
                            cur.store(cur.load() + 2)
                        }
                    }
                    while cur.load() < tks.len {
                        var pp: Str = eat_tok(tks, cur)
                        if eat_tok(tks, cur) != ":" {
                            gdiags.push("E8130: style 期待冒号")
                        }
                        var vv: Str = gui_unq(eat_tok(tks, cur))
                        if pp == "bg" {
                            gui_ck_color(vv, gdiags)
                        }
                        if cur.load() < tks.len {
                            if tks[cur.load()] == ";" {
                                eat_tok(tks, cur)
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    // P-W2:extends 诊断——缺父(E8100)+ 环(E8100;镜像域包走查)
    var xi: I32 = 0
    while xi < sext.len {
        if !gui_ck_has_style(sn, sext[xi + 1]) {
            gdiags.push("E8100: extends 父样式未声明 " + sext[xi] + " extends " + sext[xi + 1])
        }
        xi += 2
    }
    xi = 0
    while xi < sext.len {
        var cur2: Str = sext[xi]
        var step: I32 = 0
        var cyc: Bool = true
        while step <= sext.len {
            var found: Bool = false
            var pi: I32 = 0
            while pi < sext.len {
                if sext[pi] == cur2 {
                    cur2 = sext[pi + 1]
                    found = true
                    pi = sext.len
                }
                pi += 2
            }
            if !found {
                cyc = false
                step = sext.len + 1
            }
            step += 1
        }
        if cyc {
            gdiags.push("E8100: 样式 extends 环 " + sext[xi])
        }
        xi += 2
    }
    return 0
}

// ==================== SL-7β1:编译期骨架解析(镜像 gui.ct gt_parse)====================
// GuiBlock token 流 → GuiTree 15 字段平行表。与运行时 gt_parse 的树等价由
// s22_sk_equiv 夹具双端差分锁定(编译器 dump vs 域包 sk_dump)。语义镜像:
// 节点 id = push 序;when = 带旗容器(cond 名自持);each 节点 npre=列表名 nbid=itemvar;
// 叶文本 pre/bind/post 按 {ident} 三段(词流单空格拼接,词法切分标点文本为已登记偏差);
// 事件槽 nes/nec = ev_name/ev_fn 的 [起,计) 切片;button 注册 btns;style sk=名.属性 sv=值。
// 语法缝:token 流为裸切分形态(</ 与 ={ 无粘连,本 builder 按独立 token 消费)。

fn gui_sk_word(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    // 剥 W1 join 行尾标记 ~:gs2i 等数值解析不认("8~" → 158),样式/文本均受害
    if t.len > 1 {
        if byte_at(t, t.len - 1) == 126 {
            t = byte_slice(t, 0, t.len - 1)
        }
    }
    return t
}

// SL-8a:花括号槽表达式捕获——平衡消费至配对 },token 直拼即规范形
// (W1 token 不携带空白,唯字符串字面量内例外;与域包源字节剥空白捕获同规范形,
// 对两侧词法粒度不变——s22 双端差分锁)。字符串 token(引号开头)的内部花括号不参与配对。
fn gui_bx_expr(tks: List[Str], cur: Atomic[I32]) -> Str {
    var out: Str = ""
    var depth: I32 = 1
    while cur.load() < tks.len {
        var t: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if t.len > 1 {
            if byte_at(t, t.len - 1) == 126 {
                t = byte_slice(t, 0, t.len - 1)
            }
        }
        var isstr: Bool = false
        if t.len > 0 {
            if byte_at(t, 0) == 34 {
                isstr = true
            }
        }
        if !isstr {
            if t.len == 1 {
                var tb: I32 = byte_at(t, 0)
                if tb == 123 {
                    depth += 1
                } else {
                    if tb == 125 {
                        depth -= 1
                        if depth == 0 {
                            return out
                        }
                    }
                }
            }
        }
        out = out + t
    }
    return out
}

// SL-8a E8190 纯读门:规范化表达式的 token 可判定变异形态(赋值/复合赋值/自增减)
// 即违例;==/!=/<=/>= 比较与字符串字面量内容豁免。on: 槽不进此门(自动闭包,8c)。
// 已知边界(登记):`a - -b`(负字面量二元减)与 `a + +b` 会误报——以 let 拆解绕行。
fn gui_bx_impure(e: Str) -> Bool {
    var i: I32 = 0
    var instr: Bool = false
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if b == 61 {
                    var p: Bool = false
                    if i > 0 {
                        var pb: I32 = byte_at(e, i - 1)
                        if pb == 61 || pb == 33 || pb == 60 || pb == 62 {
                            p = true
                        }
                    }
                    var q: Bool = false
                    if i + 1 < e.len {
                        if byte_at(e, i + 1) == 61 {
                            q = true
                        }
                    }
                    if !p {
                        if !q {
                            return true
                        }
                    }
                } else {
                    if b == 43 || b == 45 {
                        if i + 1 < e.len {
                            var nb: I32 = byte_at(e, i + 1)
                            if nb == b {
                                return true
                            }
                            if nb == 61 {
                                return true
                            }
                        }
                    } else {
                        if b == 42 || b == 47 || b == 37 {
                            if i + 1 < e.len {
                                if byte_at(e, i + 1) == 61 {
                                    return true
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    return false
}

fn gui_sk_attrs(tks: List[Str], cur: Atomic[I32], ev_name: List[Str], ev_fn: List[Str], out4: List[Str]) -> I32 {
    // out4 预置 4 槽:[0]=class [1]=cond [2]=bind [3]=placeholder(末值覆盖,镜像末推)
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 62 {
                break
            }
            if pb == 47 {
                break
            }
        }
        var an: Str = gui_sk_word(tks, cur)
        if an == "on" {
            gui_sk_word(tks, cur)
            var evn: Str = gui_sk_word(tks, cur)
            gui_sk_word(tks, cur)
            var ob: Str = gui_sk_word(tks, cur)
            // 块开守卫(缺 { 错位吞词,镜像 check 面 W3 教训)后 8c-3 平衡捕获
            if ob.len != 1 {
                panic("gui: on 期待块开")
            }
            if byte_at(ob, 0) != 123 {
                panic("gui: on 期待块开")
            }
            var fnn: Str = gui_bx_expr(tks, cur)
            ev_name.push(evn)
            ev_fn.push(fnn)
        } else {
            gui_sk_word(tks, cur)
            var av: Str = ""
            var brform: Bool = false
            if cur.load() < tks.len {
                var pv: Str = tks[cur.load()]
                if pv.len == 1 {
                    if byte_at(pv, 0) == 123 {
                        cur.store(cur.load() + 1)
                        av = gui_bx_expr(tks, cur)
                        brform = true
                    }
                }
            }
            if !brform {
                if cur.load() < tks.len {
                    av = gui_unq(gui_sk_word(tks, cur))
                }
            }
            if an == "class" {
                out4[0] = av
            }
            if an == "cond" {
                out4[1] = av
            }
            if an == "bind" {
                out4[2] = av
            }
            if an == "checked" {
                // checkbox 选中态表达式 → nbid 槽(镜像 input bind)
                out4[2] = av
            }
            if an == "placeholder" {
                out4[3] = av
            }
        }
    }
    return 0
}

fn gui_sk_node(tks: List[Str], cur: Atomic[I32], ntag: List[Str], nflag: List[Str], ncls: List[Str], npre: List[Str], nbid: List[Str], npost: List[Str], nfc: List[I32], ns: List[I32], nes: List[I32], nec: List[I32], ev_name: List[Str], ev_fn: List[Str], btns: List[I32], depth: I32) -> I32 {
    cur.store(cur.load() + 1)
    var tag: Str = gui_sk_word(tks, cur)
    var is_leaf: Bool = false
    if tag == "label" {
        is_leaf = true
    }
    if tag == "button" {
        is_leaf = true
    }
    var is_input: Bool = false
    if tag == "input" {
        is_input = true
    }
    var is_check: Bool = false
    if tag == "checkbox" {
        is_check = true
    }
    var itemvar: Str = ""
    var listname: Str = ""
    if tag == "each" {
        // 头:item in={列表表达式}(先于 attrs,镜像 gt_node;SL-8a 花括号表达式捕获)
        itemvar = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        var ob: Str = gui_sk_word(tks, cur)
        if ob.len != 1 {
            panic("gui: each 期待花括号列表")
        }
        if byte_at(ob, 0) != 123 {
            panic("gui: each 期待花括号列表")
        }
        listname = gui_bx_expr(tks, cur)
    }
    var estart: I32 = ev_name.len
    var out4 = List[Str]()
    out4.push("")
    out4.push("")
    out4.push("")
    out4.push("")
    gui_sk_attrs(tks, cur, ev_name, ev_fn, out4)
    var id: I32 = ntag.len
    if is_input {
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        ntag.push(tag)
        ncls.push(out4[0])
        npre.push(out4[3])
        nbid.push(out4[2])
        npost.push("")
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push("")
        return id
    }
    if is_check {
        // 自闭合:<checkbox checked={表达式} ... />;checked → nbid;登记可点击
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        ntag.push(tag)
        ncls.push(out4[0])
        npre.push("")
        nbid.push(out4[2])
        npost.push("")
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push("")
        btns.push(id)
        return id
    }
    // 自闭合空元素(spacer 等,§4.2 内建集):attrs 后遇 "/>" 即收口无子树
    if cur.load() < tks.len {
        var sk1: Str = tks[cur.load()]
        if sk1.len == 1 {
            if byte_at(sk1, 0) == 47 {
                gui_sk_word(tks, cur)
                gui_sk_word(tks, cur)
                ntag.push(tag)
                ncls.push(out4[0])
                npre.push(listname)
                nbid.push(itemvar)
                npost.push("")
                nfc.push(-1)
                ns.push(-1)
                nes.push(estart)
                nec.push(ev_name.len - estart)
                nflag.push(out4[1])
                return id
            }
        }
    }
    gui_sk_word(tks, cur)
    if is_leaf {
        // 叶文本三段:词流(单空格拼接)至 { → 表达式槽(SL-8a 平衡捕获) → 词流至 <
        var p0: Str = ""
        var b: Str = ""
        var p1: Str = ""
        var phase: I32 = 0
        while cur.load() < tks.len {
            var tk: Str = tks[cur.load()]
            if tk.len == 1 {
                var tb: I32 = byte_at(tk, 0)
                if tb == 123 {
                    cur.store(cur.load() + 1)
                    b = gui_bx_expr(tks, cur)
                    phase = 2
                    continue
                }
                if tb == 60 {
                    break
                }
            }
            if phase == 0 {
                if p0 != "" {
                    p0 = p0 + " "
                }
                p0 = p0 + tk
            } else {
                if p1 != "" {
                    p1 = p1 + " "
                }
                p1 = p1 + tk
            }
            cur.store(cur.load() + 1)
        }
        npre.push(p0)
        nbid.push(b)
        npost.push(p1)
        ntag.push(tag)
        ncls.push(out4[0])
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push(out4[1])
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        if tag == "button" {
            btns.push(id)
        }
        return id
    }
    ntag.push(tag)
    ncls.push(out4[0])
    npre.push(listname)
    nbid.push(itemvar)
    npost.push("")
    nfc.push(-1)
    ns.push(-1)
    nes.push(estart)
    nec.push(ev_name.len - estart)
    nflag.push(out4[1])
    var prev: I32 = -1
    while cur.load() < tks.len {
        var pk2: Str = tks[cur.load()]
        if pk2.len == 1 {
            if byte_at(pk2, 0) == 60 {
                if cur.load() + 1 < tks.len {
                    var nk: Str = tks[cur.load() + 1]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 47 {
                            break
                        }
                    }
                }
            }
        }
        var kid: I32 = gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, depth + 1)
        var fcl: List[I32] = nfc
        var nsl: List[I32] = ns
        if prev < 0 {
            fcl[id] = kid
        } else {
            nsl[prev] = kid
        }
        prev = kid
    }
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    return id
}

fn gui_sk_style(tks: List[Str], cur: Atomic[I32], sk: List[Str], sv: List[Str], ext: List[Str]) -> I32 {
    var name: Str = gui_sk_word(tks, cur)
    // P-W2:extends 单亲派生——记 (child, parent) 对,build 期定点解析
    if cur.load() < tks.len {
        var ek: Str = tks[cur.load()]
        if ek == "extends" {
            cur.store(cur.load() + 1)
            var pn: Str = gui_sk_word(tks, cur)
            ext.push(name)
            ext.push(pn)
        }
    }
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 59 {
                cur.store(cur.load() + 1)
                continue
            }
            if pb == 125 {
                break
            }
        }
        var p: Str = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        var v: Str = ""
        if cur.load() < tks.len {
            var pv: Str = tks[cur.load()]
            if pv.len > 1 {
                if byte_at(pv, 0) == 34 {
                    v = gui_unq(pv)
                    cur.store(cur.load() + 1)
                }
            }
        }
        if v == "" {
            if cur.load() < tks.len {
                v = gui_sk_word(tks, cur)
            }
        }
        sk.push(name + "." + p)
        sv.push(v)
    }
    return 0
}

fn gui_sk_build(file: List[Str], ntag: List[Str], nflag: List[Str], ncls: List[Str], npre: List[Str], nbid: List[Str], npost: List[Str], nfc: List[I32], ns: List[I32], nes: List[I32], nec: List[I32], ev_name: List[Str], ev_fn: List[Str], btns: List[I32], sk: List[Str], sv: List[Str], props: List[Str]) -> I32 {
    var ext = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                // 8c-2:props 名表入骨架(双端同形,s22 差分面)
                if d.len > 5 {
                    gui_props_names(d[5], props)
                }
                cur.store(1)
                if cur.load() < tks.len {
                    gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, 1)
                }
            } else {
                if d[1] == "style" {
                    gui_sk_style(tks, cur, sk, sv, ext)
                }
            }
        }
        i += 1
    }
    gui_sk_ext_resolve(sk, sv, ext)
    return 0
}

// P-W2:extends 解析(骨架侧)——镜像域包 gt_ext_resolve:环 panic、
// 定点迭代复制父属性(子已定义不覆盖)
fn gui_sk_ext_resolve(sk: List[Str], sv: List[Str], ext: List[Str]) -> I32 {
    var ci: I32 = 0
    while ci < ext.len {
        var cur: Str = ext[ci]
        var step: I32 = 0
        var cyc: Bool = true
        while step <= ext.len {
            var found: Bool = false
            var pi: I32 = 0
            while pi < ext.len {
                if ext[pi] == cur {
                    cur = ext[pi + 1]
                    found = true
                    pi = ext.len
                }
                pi += 2
            }
            if !found {
                cyc = false
                step = ext.len + 1
            }
            step += 1
        }
        if cyc {
            panic("gui: 样式 extends 环 " + ext[ci])
        }
        ci += 2
    }
    var changed: Bool = true
    var guard: I32 = 0
    while changed {
        changed = false
        guard += 1
        if guard > 16 {
            break
        }
        var pi: I32 = 0
        while pi < ext.len {
            var child: Str = ext[pi]
            var parent: Str = ext[pi + 1]
            var pp: Str = parent + "."
            var si: I32 = 0
            while si < sk.len {
                var k: Str = sk[si]
                if k.len > pp.len {
                    if byte_slice(k, 0, pp.len) == pp {
                        var pname: Str = byte_slice(k, pp.len, k.len)
                        var ck: Str = child + "." + pname
                        if !gui_sk_has(sk, ck) {
                            sk.push(ck)
                            sv.push(sv[si])
                            changed = true
                        }
                    }
                }
                si += 1
            }
            pi += 2
        }
    }
    return 0
}

fn gui_sk_has(sk: List[Str], key: Str) -> Bool {
    var i: I32 = 0
    while i < sk.len {
        if sk[i] == key {
            return true
        }
        i += 1
    }
    return false
}

// 骨架表倾倒(格式与域包 gui.ct sk_dump 逐字节一致,双端差分用;空串以 - 表示)
fn gui_sk_dump_all(file: List[Str]) -> I32 {
    var ntag = List[Str]()
    var nflag = List[Str]()
    var ncls = List[Str]()
    var npre = List[Str]()
    var nbid = List[Str]()
    var npost = List[Str]()
    var nfc = List[I32]()
    var ns = List[I32]()
    var nes = List[I32]()
    var nec = List[I32]()
    var ev_name = List[Str]()
    var ev_fn = List[Str]()
    var btns = List[I32]()
    var sk = List[Str]()
    var sv = List[Str]()
    var props = List[Str]()
    gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, sk, sv, props)
    // 8c-2:props 名表行(首行;空 = -;与域包 sk_dump 同格式)
    var pline: Str = ""
    var pi: I32 = 0
    while pi < props.len {
        if pi > 0 {
            pline = pline + ","
        }
        pline = pline + props[pi]
        pi += 1
    }
    if pline == "" {
        pline = "-"
    }
    println("props=" + pline)
    var i: I32 = 0
    while i < ntag.len {
        var pre: Str = npre[i]
        if pre == "" {
            pre = "-"
        }
        var bid: Str = nbid[i]
        if bid == "" {
            bid = "-"
        }
        var post: Str = npost[i]
        if post == "" {
            post = "-"
        }
        var flag: Str = nflag[i]
        if flag == "" {
            flag = "-"
        }
        var cls: Str = ncls[i]
        if cls == "" {
            cls = "-"
        }
        println("n" + i.to_string() + " tag=" + ntag[i] + " cls=" + cls + " pre=" + pre + " bid=" + bid + " post=" + post + " flag=" + flag + " fc=" + nfc[i].to_string() + " ns=" + ns[i].to_string() + " es=" + nes[i].to_string() + " ec=" + nec[i].to_string())
        i += 1
    }
    var k: I32 = 0
    while k < ev_name.len {
        println("e" + k.to_string() + " on=" + ev_name[k] + " fn=" + ev_fn[k])
        k += 1
    }
    var b: I32 = 0
    while b < btns.len {
        println("btn id=" + btns[b].to_string())
        b += 1
    }
    var s: I32 = 0
    while s < sk.len {
        println("s " + sk[s] + "=" + sv[s])
        s += 1
    }
    println("sk-end")
    return 0
}

// SL-7β3:C 串字面量转义(自包含;不依赖 trans_ty 的 ct_cstr——cc_run 拼接无该符号)
fn gui_sk_cesc(s: Str) -> Str {
    var out: Str = ""
    var i: I32 = 0
    var start: I32 = 0
    while i < s.len {
        var b: I32 = byte_at(s, i)
        if b == 34 {
            if i > start {
                out = out + byte_slice(s, start, i)
            }
            out = out + "\\"
            out = out + "\""
            i += 1
            start = i
        } else {
            if b == 92 {
                if i > start {
                    out = out + byte_slice(s, start, i)
                }
                out = out + "\\"
                out = out + "\\"
                i += 1
                start = i
            } else {
                if b == 10 {
                    if i > start {
                        out = out + byte_slice(s, start, i)
                    }
                    out = out + "\\"
                    out = out + "n"
                    i += 1
                    start = i
                } else {
                    i += 1
                }
            }
        }
    }
    if s.len > start {
        out = out + byte_slice(s, start, s.len)
    }
    return out
}

// SL-7β3:C 静态数组发射文本(串表/整表;driver_emit 骨架构造用)
fn gui_sk_emit_str_arr(id: I32, tbl: List[Str]) -> Str {
    var arr: Str = "static const char* sk_t" + id.to_string() + "[] = \{"
    var k2: I32 = 0
    while k2 < tbl.len {
        if k2 > 0 {
            arr = arr + ","
        }
        arr = arr + " \"" + gui_sk_cesc(tbl[k2]) + "\""
        k2 += 1
    }
    return arr + " };"
}

fn gui_sk_emit_int_arr(id: I32, tbl: List[I32]) -> Str {
    var arr: Str = "static const int32_t sk_t" + id.to_string() + "[] = \{"
    var k2: I32 = 0
    while k2 < tbl.len {
        if k2 > 0 {
            arr = arr + ","
        }
        arr = arr + tbl[k2].to_string()
        k2 += 1
    }
    return arr + " };"
}

// SL-7β2:裸值表 → 解释节点值表(vS/vI 包裹;与 gt_parse 解释执行值形态同构)
fn gui_sk_wrap_s(src: List[Str]) -> List[Str] {
    var out = vL()
    var i: I32 = 0
    while i < src.len {
        out.push(vS(src[i]))
        i += 1
    }
    return out
}

fn gui_sk_wrap_i(src: List[I32]) -> List[Str] {
    var out = vL()
    var i: I32 = 0
    while i < src.len {
        out.push(vI(src[i]))
        i += 1
    }
    return out
}

// ==================== SL-8c-4② 续:定位/生成/钩子 ====================

// 定位 run(ViewCall) 调用节点:返回调用点 prop 名序;节点出参 outn[0]
fn gui_ds_locate(file: List[Str], views: List[Str], vname: Str, outn: List[Str]) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" {
            if gui_ds_locate_block(d[5], vname, outn) > 0 {
                var names = List[Str]()
                var call = outn[0]
                var a = call[2][1]
                var k: I32 = 1
                while k < a[2].len {
                    names.push(a[2][k][1])
                    k += 1
                }
                return names
            }
        }
        i += 1
    }
    return List[Str]()
}

fn gui_ds_locate_block(b: List[Str], vname: Str, outn: List[Str]) -> I32 {
    var i: I32 = 1
    while i < b.len {
        var s = b[i]
        var t: Str = s[0]
        var hit: I32 = 0
        if t == "Return" {
            if s.len > 1 {
                hit = gui_ds_locate_expr(s[1], vname, outn)
            }
        } else {
            if t == "Let" {
                hit = gui_ds_locate_expr(s[4], vname, outn)
            } else {
                if t == "While" {
                    hit = gui_ds_locate_expr(s[1], vname, outn)
                } else {
                    if t == "For" {
                        hit = gui_ds_locate_expr(s[2], vname, outn)
                    } else {
                        if t == "If" {
                            hit = gui_ds_locate_expr(s[1], vname, outn)
                        } else {
                            if t == "Expr" {
                                hit = gui_ds_locate_expr(s[1], vname, outn)
                            } else {
                                if t == "Assign" {
                                    hit = gui_ds_locate_expr(s[1], vname, outn)
                                } else {
                                    hit = gui_ds_locate_expr(s, vname, outn)
                                }
                            }
                        }
                    }
                }
            }
        }
        if hit > 0 {
            return 1
        }
        i += 1
    }
    return 0
}

fn gui_ds_locate_expr(e: List[Str], vname: Str, outn: List[Str]) -> I32 {
    if e.len < 1 {
        return 0
    }
    var t: Str = e[0]
    if t == "Call" {
        if e[1].len > 1 {
            if e[1][0] == "Ident" {
                if e[1][1] == "run" {
                    if e[2].len == 2 {
                        var a = e[2][1]
                        if a[0] == "Call" {
                            if a[1].len > 1 {
                                if a[1][0] == "Ident" {
                                    if a[1][1] == vname {
                                        outn.push(a)
                                        return 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if gui_ds_locate_expr(e[1], vname, outn) > 0 {
            return 1
        }
        var i: I32 = 1
        while i < e[2].len {
            if gui_ds_locate_expr(e[2][i], vname, outn) > 0 {
                return 1
            }
            i += 1
        }
        return 0
    }
    if t == "Binary" {
        if gui_ds_locate_expr(e[2], vname, outn) > 0 {
            return 1
        }
        return gui_ds_locate_expr(e[3], vname, outn)
    }
    if t == "Unary" {
        return gui_ds_locate_expr(e[2], vname, outn)
    }
    if t == "Member" {
        return gui_ds_locate_expr(e[1], vname, outn)
    }
    if t == "NParg" {
        return gui_ds_locate_expr(e[2], vname, outn)
    }
    if t == "Index" {
        return gui_ds_locate_expr(e[1], vname, outn)
    }
    return 0
}

// 视图声明型表(d[5] → 与 pnames 同序的型原文表)
fn gui_ds_ptyps(file: List[Str], pnames: List[Str]) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            if d[1] == "view" {
                var vn = List[Str]()
                var vt = List[Str]()
                if d.len > 5 {
                    gui_props_typed(d[5], vn, vt)
                }
                if vn.len == pnames.len {
                    var same: Bool = true
                    var k: I32 = 0
                    while k < vn.len {
                        if vn[k] != pnames[k] {
                            same = false
                            k = vn.len
                        }
                        k += 1
                    }
                    if same {
                        var w: I32 = 0
                        while w < vt.len {
                            out.push(vt[w])
                            w += 1
                        }
                        return out
                    }
                }
            }
        }
        i += 1
    }
    return out
}

// 骨架表驱动收集:标量查询路径(+型)/each 列表表达式/事件表
fn gui_ds_collect_slots(file: List[Str], pnames: List[Str], paths: List[Str], pty: List[Str], lists: List[Str], evn: List[Str], evf: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str]) -> I32 {
    var ntag = List[Str]()
    var nflag = List[Str]()
    var ncls = List[Str]()
    var npre = List[Str]()
    var nbid = List[Str]()
    var npost = List[Str]()
    var nfc = List[I32]()
    var ns = List[I32]()
    var nes = List[I32]()
    var nec = List[I32]()
    var f_evn = List[Str]()
    var f_evf = List[Str]()
    var btns = List[I32]()
    var sk = List[Str]()
    var sv = List[Str]()
    var skprops = List[Str]()
    gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, f_evn, f_evf, btns, sk, sv, skprops)
    var ptyps: List[Str] = gui_ds_ptyps(file, pnames)
    var exprs = List[Str]()
    var i: I32 = 0
    while i < ntag.len {
        if nbid[i] != "" {
            exprs.push(nbid[i])
        }
        if nflag[i] != "" {
            exprs.push(nflag[i])
        }
        if ntag[i] == "each" {
            lists.push(npre[i])
        }
        i += 1
    }
    i = 0
    while i < exprs.len {
        var ps = List[Str]()
        gui_bx_dotted(exprs[i], ps)
        var j: I32 = 0
        while j < ps.len {
            if gui_ck_has_style(pnames, ps[j]) {
                if !gui_ck_has_style(paths, ps[j]) {
                    paths.push(ps[j])
                    pty.push(gui_ds_path_ty(ps[j], pnames, ptyps, stns, sfk, stv))
                }
            }
            j += 1
        }
        i += 1
    }
    i = 0
    while i < f_evn.len {
        evn.push(f_evn[i])
        evf.push(f_evf[i])
        i += 1
    }
    return 0
}

// 合成三 fn(源文本 → 真解析拼写单元,File 节)
fn gui_ds_gen(vname: Str, pnames: List[Str], ptyps: List[Str], ordn: List[Str], paths: List[Str], pty: List[Str], lists: List[Str], evn: List[Str], evf: List[Str], stns: List[Str], sfk: List[Str], stv: List[Str]) -> List[Str] {
    var ptoks = List[Str]()
    var boxes = List[Str]()
    var ii: I32 = 0
    while ii < ordn.len {
        var pn: Str = ordn[ii]
        var ty: Str = ""
        var ti: I32 = 0
        while ti < pnames.len {
            if pnames[ti] == pn {
                ty = ptyps[ti]
                ti = pnames.len
            }
            ti += 1
        }
        var head: Str = gui_ty_head_txt(ty)
        var tok: Str = "__a" + ii.to_string()
        if gui_ck_has_style(stns, head) {
            tok = "__p_" + pn
            var bl: Str = "    var " + tok + ": Box[" + head + "] = "
            if head == gui_trim(ty) {
                bl = bl + "Box[" + head + "](" + "__a" + ii.to_string() + ")"
            } else {
                bl = bl + "__a" + ii.to_string()
            }
            boxes.push(bl)
        }
        ptoks.push(tok)
        ii += 1
    }
    var params: Str = ""
    var cargs: Str = ""
    ii = 0
    while ii < ordn.len {
        if ii > 0 {
            params = params + ", "
            cargs = cargs + ", "
        }
        var pn: Str = ordn[ii]
        var ty: Str = ""
        var ti: I32 = 0
        while ti < pnames.len {
            if pnames[ti] == pn {
                ty = gui_trim(ptyps[ti])
                ti = pnames.len
            }
            ti += 1
        }
        params = params + "__a" + ii.to_string() + ": " + ty
        cargs = cargs + ptoks[ii]
        ii += 1
    }
    var g: Str = "fn __gui_bind_" + vname + "(buf: List[Str]"
    if cargs.len > 0 {
        g = g + ", " + cargs
    }
    g = g + ") \{\n"
    var k: I32 = 0
    while k < paths.len {
        var rw: Str = gui_ds_rw(paths[k], pnames, ptoks)
        var tyk: Str = pty[k]
        g = g + "    if buf[0] == \"prop:" + paths[k] + "\" \{\n"
        if tyk == "I32" {
            g = g + "        buf.push(\"i:\" + (" + rw + ").to_string())\n"
        } else {
            if tyk == "Bool" {
                g = g + "        if (" + rw + ") \{ buf.push(\"b:1\") } else \{ buf.push(\"b:0\") }\n"
            } else {
                g = g + "        buf.push(" + rw + ")\n"
            }
        }
        g = g + "    }\n"
        k += 1
    }
    k = 0
    while k < lists.len {
        var rwl: Str = gui_ds_rw(lists[k], pnames, ptoks)
        g = g + "    if buf[0] == \"each:" + lists[k] + "\" \{\n"
        g = g + "        var gi: I32 = 0\n"
        g = g + "        while gi < " + rwl + ".len \{\n"
        g = g + "            buf.push(" + rwl + "[gi])\n"
        g = g + "            gi += 1\n"
        g = g + "        }\n"
        g = g + "    }\n"
        k += 1
    }
    g = g + "}\n"
    var a2: Str = "fn __gui_act_" + vname + "(name: Str"
    if cargs.len > 0 {
        a2 = a2 + ", " + cargs
    }
    a2 = a2 + ") \{\n"
    k = 0
    while k < evf.len {
        var argc = List[I32]()
        var ao = List[Str]()
        var head2: Str = gui_ev_head2(evf[k], argc, ao)
        if head2.len > 0 {
            if argc.len > 0 {
                if argc[0] >= 1 {
                    var sp: Str = ao[0]
                    var parts = List[Str]()
                    var si: I32 = 0
                    var depth: I32 = 0
                    var cur0: Str = ""
                    while si < sp.len {
                        var c: I32 = byte_at(sp, si)
                        if c == 40 {
                            depth += 1
                        } else {
                            if c == 41 {
                                depth -= 1
                            } else {
                                if c == 44 {
                                    if depth == 0 {
                                        parts.push(gui_trim(cur0))
                                        cur0 = ""
                                        si += 1
                                        continue
                                    }
                                }
                            }
                        }
                        cur0 = cur0 + byte_slice(sp, si, si + 1)
                        si += 1
                    }
                    parts.push(gui_trim(cur0))
                    var ar: Str = ""
                    var pj: I32 = 0
                    while pj < parts.len {
                        if pj > 0 {
                            ar = ar + ", "
                        }
                        ar = ar + gui_ds_rw(parts[pj], pnames, ptoks)
                        pj += 1
                    }
                    a2 = a2 + "    if name == \"" + head2 + "\" \{ " + head2 + "(" + ar + ") }\n"
                } else {
                    a2 = a2 + "    if name == \"" + head2 + "\" \{ " + head2 + "() }\n"
                }
            } else {
                a2 = a2 + "    if name == \"" + evf[k] + "\" \{ " + evf[k] + "() }\n"
            }
        }
        k += 1
    }
    a2 = a2 + "}\n"
    var r: Str = "fn __gui_run_" + vname + "(" + params + ") -> I32 \{\n"
    k = 0
    while k < boxes.len {
        r = r + boxes[k] + "\n"
        k += 1
    }
    var bindcl: Str = "|buf| __gui_bind_" + vname + "(buf"
    if cargs.len > 0 {
        bindcl = bindcl + ", " + cargs
    }
    bindcl = bindcl + ")"
    var actcl: Str = "|nm| __gui_act_" + vname + "(nm"
    if cargs.len > 0 {
        actcl = actcl + ", " + cargs
    }
    actcl = actcl + ")"
    r = r + "    return run_d(\"Ctron\", 320, 480, " + bindcl + ", " + actcl + ")\n"
    r = r + "}\n"
    var src: Str = g + a2 + r
    var toks = List[Str]()
    var lns = List[Str]()
    var cols = List[Str]()
    var pd = List[Str]()
    scan4(src, toks, lns, cols, pd)
    var cur = Atomic[I32](0)
    return p_file(toks, cur, lns, cols, pd)
}

// 预合并:run(ViewCall) 命中即注入 use gui.{run_d} 请求(合并期生效)
fn gui_ds_premerge(file: List[Str]) -> List[Str] {
    var has: Bool = false
    var i: I32 = 1
    while i < file.len {
        if file[i][0] == "GuiBlock" {
            has = true
            i = file.len
        }
        i += 1
    }
    if !has {
        return file
    }
    var vnames = List[Str]()
    var vprops = List[Str]()
    gui_ds_views(file, vnames, vprops)
    if vnames.len == 0 {
        return file
    }
    if gui_ds_find_file(file, vnames) == "" {
        return file
    }
    // Use 节点经真解析生成(手拼形态与解析器产物微差即炸合并面)
    var utoks = List[Str]()
    var ulns = List[Str]()
    var ucols = List[Str]()
    var upd = List[Str]()
    scan4("use gui.\{ run_d }", utoks, ulns, ucols, upd)
    var ucur = Atomic[I32](0)
    var uf: List[Str] = p_file(utoks, ucur, ulns, ucols, upd)
    var un: List[Str] = uf[1]
    var out = List[Str]()
    out.push(file[0])
    out.push(un)
    i = 1
    while i < file.len {
        out.push(file[i])
        i += 1
    }
    return out
}

// 合并后:改写调用点 + 生成三 fn 拼写进 File
fn gui_ds_postmerge(file: List[Str], diags: List[Str]) -> List[Str] {
    if diags.len > 0 {
        // 合并已带诊断(use 不可解析等)——失败树上不合成,诊断主导出
        return file
    }
    var has: Bool = false
    var i: I32 = 1
    while i < file.len {
        if file[i][0] == "GuiBlock" {
            has = true
            i = file.len
        }
        i += 1
    }
    if !has {
        return file
    }
    var vnames = List[Str]()
    var vprops = List[Str]()
    gui_ds_views(file, vnames, vprops)
    if vnames.len == 0 {
        return file
    }
    var vname: Str = gui_ds_find_file(file, vnames)
    if vname == "" {
        return file
    }
    var outn = List[Str]()
    var ordn: List[Str] = gui_ds_locate(file, vnames, vname, outn)
    if outn.len == 0 {
        return file
    }
    var dn = List[Str]()
    var dt = List[Str]()
    var vi: I32 = 0
    while vi < vnames.len {
        if vnames[vi] == vname {
            gui_props_typed(vprops[vi], dn, dt)
            vi = vnames.len
        }
        vi += 1
    }
    var stns = List[Str]()
    var sfk = List[Str]()
    var stv = List[Str]()
    gui_field_tables(file, stns, sfk, stv)
    var paths = List[Str]()
    var pty = List[Str]()
    var lists = List[Str]()
    var evn = List[Str]()
    var evf = List[Str]()
    gui_ds_collect_slots(file, dn, paths, pty, lists, evn, evf, stns, sfk, stv)
    var unit: List[Str] = gui_ds_gen(vname, dn, dt, ordn, paths, pty, lists, evn, evf, stns, sfk, stv)
    gui_ds_rew_file(file, vname)
    var k: I32 = 1
    while k < unit.len {
        file.push(unit[k])
        k += 1
    }
    return file
}
