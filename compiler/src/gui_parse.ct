// =====================================================================
// gui_parse.ct —— GUI 块认领与折叠(W1/W2;规范 specs/2026-09-16-gui-ctml-design.md §11.1)
// W1:顶层 view/style 块在 token 流上的平衡扫描认领,记 File 子节点 GuiBlock:
//    [1]=kind [2]=name [3]=块内 token 数 [4]=块内 token 空格连接串(词法 token 无空格,无损)
// W2:gui_lower 折叠——token 串 → 结构化 IR 文本 dump(--dump-gui 口径);
//    颜色 #RRGGBB 格式校验(E8130 前身,W3 接诊断面);令牌查用户常量随 W3(sem 表)。
// 契约:eat_tok 助手(花括号字面量不可词法化)(触发插值扫描吞引号,E1001)——一律字节码比较;
//       注释中不放花括号字符(发射口径词法分歧,见计划文档登记)。
// =====================================================================

fn gui_block(toks: List[Str], cur: Atomic[I32], kind: Str) -> List[Str] {
    var nd = mk("GuiBlock")
    nd.push(kind)
    adv(cur)
    var name: Str = tok(toks, cur)
    adv(cur)
    nd.push(name)
    var joined: Str = name
    var depth: I32 = 0
    var toks_n: I32 = 1
    var started: Bool = false
    while true {
        var t: Str = tok(toks, cur)
        if t == "#EOF" {
            panic("gui: 块未闭合 " + kind + " " + name)
        }
        var one: Bool = t.len == 1
        var is_open: Bool = false
        var is_close: Bool = false
        if one {
            if byte_at(t, 0) == 123 {
                is_open = true
            }
            if byte_at(t, 0) == 125 {
                is_close = true
            }
        }
        if is_open {
            depth += 1
            started = true
            if depth == 1 {
                adv(cur)
                continue
            }
        } else {
            if is_close {
                depth -= 1
                if depth == 0 {
                    adv(cur)
                    break
                }
            }
        }
        if started {
            joined = joined + " " + t
            toks_n += 1
        }
        adv(cur)
    }
    nd.push(toks_n.to_string())
    nd.push(joined)
    return nd
}

// ---- token 串拆分(词法 token 无空格,空格单切无损) ----

fn gui_split(joined: Str, out: List[Str]) -> I32 {
    var n: I32 = joined.len
    var i: I32 = 0
    while i < n {
        var start: I32 = i
        while i < n {
            if byte_at(joined, i) == 32 {
                break
            }
            i += 1
        }
        if i > start {
            out.push(byte_slice(joined, start, i))
        }
        i += 1
    }
    return 0
}

fn gui_hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui E8130: 颜色非法十六进制")
    return 0
}

// 颜色串校验(E8130 前身):#RRGGBB;返回打包色
fn gui_unq(v: Str) -> Str {
    if v.len >= 2 {
        if byte_at(v, 0) == 34 {
            if byte_at(v, v.len - 1) == 34 {
                return byte_slice(v, 1, v.len - 1)
            }
        }
    }
    return v
}

fn eat_tok(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    return t
}

fn gui_parse_color(v: Str) -> I32 {
    if v.len != 7 {
        panic("gui E8130: 颜色须 #RRGGBB,得 " + v)
    }
    if byte_at(v, 0) != 35 {
        panic("gui E8130: 颜色须 # 开头,得 " + v)
    }
    var r: I32 = gui_hex1(byte_at(v, 1)) * 16 + gui_hex1(byte_at(v, 2))
    var g: I32 = gui_hex1(byte_at(v, 3)) * 16 + gui_hex1(byte_at(v, 4))
    var b: I32 = gui_hex1(byte_at(v, 5)) * 16 + gui_hex1(byte_at(v, 6))
    return r * 65536 + g * 256 + b
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 视图块折叠:<' tag attrs '>' content '</' tag '>';返回 IR 行(已含缩进)
// attrs:class="x" 与 on:名={handler};叶子文本:字面量 token* + 至多一个 {ident}
fn gui_lower_element(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    if eat_tok(tks, cur) != "<" {
        panic("gui E8100: 期待 <")
    }
    var tag: Str = eat_tok(tks, cur)
    var c: Str = ""
    var onn: Str = ""
    var onf: Str = ""
    while tks[cur.load()] != ">" {
        var an: Str = eat_tok(tks, cur)
        if an == "on" {
            if eat_tok(tks, cur) != ":" {
                panic("gui E8100: on 期待冒号")
            }
            onn = eat_tok(tks, cur)
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: on 期待等号")
            }
            var ob: Str = eat_tok(tks, cur)
            if ob.len != 1 {
                panic("gui E8100: on 期待块开")
            }
            if byte_at(ob, 0) != 123 {
                panic("gui E8100: on 期待块开")
            }
            onf = eat_tok(tks, cur)
            if eat_tok(tks, cur) != "}" {
                panic("gui E8100: on 期待块闭")
            }
        } else {
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: 属性期待等号")
            }
            var av: Str = gui_unq(eat_tok(tks, cur))
            if an == "class" {
                c = av
            }
        }
    }
    eat_tok(tks, cur)
    var line: Str = ind + "el " + tag
    if c != "" {
        line = line + " cls=" + c
    }
    if onn != "" {
        line = line + " on:" + onn + "=" + onf
    }
    println(line)
    out.push(line)
    var lit: Str = ""
    while true {
        if tks[cur.load()] == "<" {
            if tks[cur.load() + 1] == "/" {
                break
            }
            if lit != "" {
                var tl: Str = ind + "  " + tag + " text=\"" + lit + "\""
                println(tl)
                out.push(tl)
                lit = ""
            }
            gui_lower_element(tks, cur, ind + "  ", out)
        } else {
            if tks[cur.load()] == "#EOF" {
                panic("gui E8100: 未终止")
            }
            var w: Str = eat_tok(tks, cur)
            if lit != "" {
                lit = lit + " "
            }
            lit = lit + w
        }
    }
    if lit != "" {
        var tline: Str = ind + "  " + tag + " text=\"" + lit + "\""
        println(tline)
        out.push(tline)
    }
    eat_tok(tks, cur)
    eat_tok(tks, cur)
    var et: Str = eat_tok(tks, cur)
    if et != tag {
        panic("gui E8100: 闭合标签不匹配 " + et)
    }
    eat_tok(tks, cur)
    return 0
}

fn gui_lower_view(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui view " + name)
    out.push("view " + name)
    gui_lower_element(tks, cur, ind + "  ", out)
    return 0
}

fn gui_lower_style(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui style " + name)
    out.push("style " + name)
    while cur.load() < tks.len {
        var p: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if tks[cur.load()] != ":" {
            panic("gui E8130: 期待 :,得 " + tks[cur.load()])
        }
        cur.store(cur.load() + 1)
        var v: Str = gui_unq(tks[cur.load()])
        cur.store(cur.load() + 1)
        if p == "bg" {
            var packed: I32 = gui_parse_color(v)
            if packed < 0 {
                panic("gui E8130: 颜色解析失败")
            }
        }
        println(ind + "  " + p + "=" + v)
        out.push(p + "=" + v)
        if cur.load() < tks.len {
            if tks[cur.load()] == ";" {
                cur.store(cur.load() + 1)
            }
        }
    }
    cur.store(cur.load() + 1)
    return 0
}

// File 子节点遍历 dump(--dump-gui 消费口;driver_check 调用)
fn gui_dump_file(file: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            var out = List[Str]()
            if d[1] == "view" {
                gui_lower_view(tks, cur, "  ", out)
            } else {
                if d[1] == "style" {
                    gui_lower_style(tks, cur, "  ", out)
                }
            }
        }
        i += 1
    }
    return 0
}

// ==================== gui_check:检查面(W3;§4.4 E8xxx 语料验收)====================
// 收集式(不 panic/不打印):诊断行入 gdiags("E8xxx: msg"),块内首错即止。
// 结构口径与 dump lower 一致(限深 1:根=容器,子=叶子)。

fn gui_ck_has_style(sn: List[Str], name: Str) -> Bool {
    var i: I32 = 0
    while i < sn.len {
        if sn[i] == name {
            return true
        }
        i += 1
    }
    return false
}

fn gui_ck_color(v: Str, gdiags: List[Str]) -> I32 {
    if v.len != 7 {
        gdiags.push("E8130: 颜色须 #RRGGBB,得 " + v)
        return -1
    }
    if byte_at(v, 0) != 35 {
        gdiags.push("E8130: 颜色须 # 开头,得 " + v)
        return -1
    }
    var i: I32 = 1
    while i < 7 {
        var b: I32 = byte_at(v, i)
        var ok: Bool = b >= 48 && b <= 57
        if !ok {
            if b >= 97 {
                if b <= 102 {
                    ok = true
                }
            }
        }
        if !ok {
            if b >= 65 {
                if b <= 70 {
                    ok = true
                }
            }
        }
        if !ok {
            gdiags.push("E8130: 颜色含非十六进制字符,得 " + v)
            return -1
        }
        i += 1
    }
    return 0
}

fn gui_ck_tag(tag: Str, gdiags: List[Str]) -> I32 {
    if tag == "vbox" {
        return 0
    }
    if tag == "hbox" {
        return 0
    }
    if tag == "label" {
        return 0
    }
    if tag == "button" {
        return 0
    }
    gdiags.push("E8100: 未声明标签 " + tag)
    return -1
}

// 叶子检查:< tag attrs '>' 文本(至 '<')'</' '/' tag '>'
fn gui_ck_leaf(tks: List[Str], cur: Atomic[I32], sn: List[Str], gdiags: List[Str]) -> I32 {
    cur.store(cur.load() + 1)
    var tag: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    var bad: I32 = gui_ck_tag(tag, gdiags)
    var c: Str = ""
    while tks[cur.load()] != ">" {
        var an: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if an == "on" {
            cur.store(cur.load() + 1)
            cur.store(cur.load() + 1)
            cur.store(cur.load() + 1)
            cur.store(cur.load() + 1)
            cur.store(cur.load() + 1)
        } else {
            cur.store(cur.load() + 1)
            var av: Str = gui_unq(tks[cur.load()])
            cur.store(cur.load() + 1)
            if an == "class" {
                c = av
            }
        }
    }
    cur.store(cur.load() + 1)
    if c != "" {
        if !gui_ck_has_style(sn, c) {
            gdiags.push("E8150: class 引用未定义样式 " + c)
            bad = -1
        }
    }
    while tks[cur.load()] != "<" {
        cur.store(cur.load() + 1)
    }
    cur.store(cur.load() + 1)
    cur.store(cur.load() + 1)
    var et: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    if et != tag {
        gdiags.push("E8100: 闭合标签不匹配 " + et)
        bad = -1
    }
    return bad
}

fn gui_check_file(file: List[Str], gdiags: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                // 根容器 + 叶子循环(限深 1)
                cur.store(1)
                if eat_tok(tks, cur) != "<" {
                    gdiags.push("E8100: view 期待 <")
                } else {
                    var tag: Str = eat_tok(tks, cur)
                    gui_ck_tag(tag, gdiags)
                    var c: Str = ""
                    while tks[cur.load()] != ">" {
                        var an: Str = eat_tok(tks, cur)
                        if an == "on" {
                            eat_tok(tks, cur)
                            eat_tok(tks, cur)
                            eat_tok(tks, cur)
                            eat_tok(tks, cur)
                            eat_tok(tks, cur)
                        } else {
                            if eat_tok(tks, cur) != "=" {
                                gdiags.push("E8100: 属性期待 =")
                            } else {
                                var av: Str = gui_unq(eat_tok(tks, cur))
                                if an == "class" {
                                    c = av
                                }
                            }
                        }
                    }
                    if c != "" {
                        if !gui_ck_has_style(sn, c) {
                            gdiags.push("E8150: class 引用未定义样式 " + c)
                        }
                    }
                    while tks[cur.load()] != "<" {
                        cur.store(cur.load() + 1)
                    }
                    // 叶子循环
                    var guard: I32 = 0
                    while guard < 64 {
                        if tks[cur.load()] == "<" {
                            if tks[cur.load() + 1] == "/" {
                                cur.store(cur.load() + 2)
                                break
                            }
                            cur.store(cur.load() + 1)
                            var ltag: Str = eat_tok(tks, cur)
                            gui_ck_tag(ltag, gdiags)
                            var lc: Str = ""
                            while tks[cur.load()] != ">" {
                                var lan: Str = eat_tok(tks, cur)
                                if lan == "on" {
                                    eat_tok(tks, cur)
                                    eat_tok(tks, cur)
                                    eat_tok(tks, cur)
                                    eat_tok(tks, cur)
                                    eat_tok(tks, cur)
                                } else {
                                    if eat_tok(tks, cur) != "=" {
                                        gdiags.push("E8100: 属性期待 =")
                                    } else {
                                        var lav: Str = gui_unq(eat_tok(tks, cur))
                                        if lan == "class" {
                                            lc = lav
                                        }
                                    }
                                }
                            }
                            if lc != "" {
                                if !gui_ck_has_style(sn, lc) {
                                    gdiags.push("E8150: class 引用未定义样式 " + lc)
                                }
                            }
                            while tks[cur.load()] != "<" {
                                cur.store(cur.load() + 1)
                            }
                            cur.store(cur.load() + 1)
                            cur.store(cur.load() + 1)
                        } else {
                            break
                        }
                        guard += 1
                    }
                }
            } else {
                if d[1] == "style" {
                    var nm: Str = eat_tok(tks, cur)
                    while cur.load() < tks.len {
                        var pp: Str = eat_tok(tks, cur)
                        if eat_tok(tks, cur) != ":" {
                            gdiags.push("E8130: style 期待冒号")
                        }
                        var vv: Str = gui_unq(eat_tok(tks, cur))
                        if pp == "bg" {
                            gui_ck_color(vv, gdiags)
                        }
                        if cur.load() < tks.len {
                            if tks[cur.load()] == ";" {
                                eat_tok(tks, cur)
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    return 0
}
