// =====================================================================
// gui_parse.ct —— GUI 块认领与折叠(W1/W2;规范 specs/2026-09-16-gui-ctml-design.md §11.1)
// W1:顶层 view/style 块在 token 流上的平衡扫描认领,记 File 子节点 GuiBlock:
//    [1]=kind [2]=name [3]=块内 token 数 [4]=块内 token 空格连接串(词法 token 无空格,无损)
// W2:gui_lower 折叠——token 串 → 结构化 IR 文本 dump(--dump-gui 口径);
//    颜色 #RRGGBB 格式校验(E8130 前身,W3 接诊断面);令牌查用户常量随 W3(sem 表)。
// 契约:eat_tok 助手(花括号字面量不可词法化)(触发插值扫描吞引号,E1001)——一律字节码比较;
//       注释中不放花括号字符(发射口径词法分歧,见计划文档登记)。
// =====================================================================

fn gui_block(toks: List[Str], cur: Atomic[I32], kind: Str) -> List[Str] {
    var nd = mk("GuiBlock")
    nd.push(kind)
    adv(cur)
    var name: Str = tok(toks, cur)
    adv(cur)
    nd.push(name)
    var joined: Str = name
    var depth: I32 = 0
    var toks_n: I32 = 1
    var started: Bool = false
    while true {
        var t: Str = tok(toks, cur)
        if t == "#EOF" {
            panic("gui: 块未闭合 " + kind + " " + name)
        }
        var one: Bool = t.len == 1
        var is_open: Bool = false
        var is_close: Bool = false
        if one {
            if byte_at(t, 0) == 123 {
                is_open = true
            }
            if byte_at(t, 0) == 125 {
                is_close = true
            }
        }
        if is_open {
            depth += 1
            started = true
            if depth == 1 {
                adv(cur)
                continue
            }
        } else {
            if is_close {
                depth -= 1
                if depth == 0 {
                    adv(cur)
                    break
                }
            }
        }
        if started {
            joined = joined + " " + t
            toks_n += 1
        }
        adv(cur)
    }
    nd.push(toks_n.to_string())
    nd.push(joined)
    return nd
}

// ---- token 串拆分(词法 token 无空格,空格单切无损) ----

fn gui_split(joined: Str, out: List[Str]) -> I32 {
    var n: I32 = joined.len
    var i: I32 = 0
    while i < n {
        var start: I32 = i
        while i < n {
            if byte_at(joined, i) == 32 {
                break
            }
            i += 1
        }
        if i > start {
            out.push(byte_slice(joined, start, i))
        }
        i += 1
    }
    return 0
}

fn gui_hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui E8130: 颜色非法十六进制")
    return 0
}

// 颜色串校验(E8130 前身):#RRGGBB;返回打包色
fn gui_unq(v: Str) -> Str {
    if v.len >= 2 {
        if byte_at(v, 0) == 34 {
            if byte_at(v, v.len - 1) == 34 {
                return byte_slice(v, 1, v.len - 1)
            }
        }
    }
    return v
}

fn eat_tok(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    return t
}

fn gui_parse_color(v: Str) -> I32 {
    if v.len != 7 {
        panic("gui E8130: 颜色须 #RRGGBB,得 " + v)
    }
    if byte_at(v, 0) != 35 {
        panic("gui E8130: 颜色须 # 开头,得 " + v)
    }
    var r: I32 = gui_hex1(byte_at(v, 1)) * 16 + gui_hex1(byte_at(v, 2))
    var g: I32 = gui_hex1(byte_at(v, 3)) * 16 + gui_hex1(byte_at(v, 4))
    var b: I32 = gui_hex1(byte_at(v, 5)) * 16 + gui_hex1(byte_at(v, 6))
    return r * 65536 + g * 256 + b
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 视图块折叠:<' tag attrs '>' content '</' tag '>';返回 IR 行(已含缩进)
// attrs:class="x" 与 on:名={handler};叶子文本:字面量 token* + 至多一个 {ident}
fn gui_dump_file(file: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            var out = List[Str]()
            if d[1] == "view" {
                gui_lower_view(tks, cur, "  ", out)
            } else {
                if d[1] == "style" {
                    gui_lower_style(tks, cur, "  ", out)
                }
            }
        }
        i += 1
    }
    return 0
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 元素折叠:<' tag attrs '>' content '</' tag '>'(限深递归;子元素自递归)
// SL-6a 认领:自闭合(input/>)、each item 位置头(in= 绑定列表名)、when cond 绑定名、
// input bind 绑定名、花括号属性值(单词 = 绑定名通道,与域包解析器同构)
fn gui_lower_element(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    if eat_tok(tks, cur) != "<" {
        panic("gui E8100: 期待 <")
    }
    var tag: Str = eat_tok(tks, cur)
    var c: Str = ""
    var onn: Str = ""
    var onf: Str = ""
    var bv: Str = ""
    var itemvar: Str = ""
    if tag == "each" {
        itemvar = eat_tok(tks, cur)
    }
    var selfc: Bool = false
    while tks[cur.load()] != ">" {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            if byte_at(pk, 0) == 47 {
                cur.store(cur.load() + 1)
                selfc = true
                break
            }
        }
        var an: Str = eat_tok(tks, cur)
        if an == "on" {
            if eat_tok(tks, cur) != ":" {
                panic("gui E8100: on 期待冒号")
            }
            onn = eat_tok(tks, cur)
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: on 期待等号")
            }
            var ob: Str = eat_tok(tks, cur)
            if ob.len != 1 {
                panic("gui E8100: on 期待块开")
            }
            if byte_at(ob, 0) != 123 {
                panic("gui E8100: on 期待块开")
            }
            onf = eat_tok(tks, cur)
            if eat_tok(tks, cur) != "}" {
                panic("gui E8100: on 期待块闭")
            }
        } else {
            if eat_tok(tks, cur) != "=" {
                panic("gui E8100: 属性期待等号")
            }
            var av: Str = ""
            if tks[cur.load()].len == 1 {
                if byte_at(tks[cur.load()], 0) == 123 {
                    cur.store(cur.load() + 1)
                    av = "\{" + eat_tok(tks, cur) + "}"
                    cur.store(cur.load() + 1)
                }
            }
            if av == "" {
                av = gui_unq(eat_tok(tks, cur))
            }
            if an == "class" {
                c = av
            }
            if an == "cond" {
                bv = av
            }
            if an == "bind" {
                bv = av
            }
            if an == "in" {
                bv = av
            }
        }
    }
    eat_tok(tks, cur)
    var line: Str = ind + "el " + tag
    if itemvar != "" {
        line = line + " item=" + itemvar
    }
    if c != "" {
        line = line + " cls=" + c
    }
    if bv != "" {
        line = line + " bind=" + bv
    }
    if onn != "" {
        line = line + " on:" + onn + "=" + onf
    }
    println(line)
    out.push(line)
    if selfc {
        return 0
    }
    var lit: Str = ""
    while true {
        if tks[cur.load()] == "<" {
            if tks[cur.load() + 1] == "/" {
                break
            }
            if lit != "" {
                var tl: Str = ind + "  " + tag + " text=\"" + lit + "\""
                println(tl)
                out.push(tl)
                lit = ""
            }
            gui_lower_element(tks, cur, ind + "  ", out)
        } else {
            if tks[cur.load()] == "#EOF" {
                panic("gui E8100: 未终止")
            }
            var w: Str = eat_tok(tks, cur)
            if lit != "" {
                lit = lit + " "
            }
            lit = lit + w
        }
    }
    if lit != "" {
        var tline: Str = ind + "  " + tag + " text=\"" + lit + "\""
        println(tline)
        out.push(tline)
    }
    eat_tok(tks, cur)
    eat_tok(tks, cur)
    var et: Str = eat_tok(tks, cur)
    if et != tag {
        panic("gui E8100: 闭合标签不匹配 " + et)
    }
    eat_tok(tks, cur)
    return 0
}

fn gui_lower_view(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui view " + name)
    out.push("view " + name)
    gui_lower_element(tks, cur, ind + "  ", out)
    return 0
}

fn gui_lower_style(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui style " + name)
    out.push("style " + name)
    while cur.load() < tks.len {
        var p: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if tks[cur.load()] != ":" {
            panic("gui E8130: 期待 :,得 " + tks[cur.load()])
        }
        cur.store(cur.load() + 1)
        var v: Str = gui_unq(tks[cur.load()])
        cur.store(cur.load() + 1)
        if p == "bg" {
            var packed: I32 = gui_parse_color(v)
            if packed < 0 {
                panic("gui E8130: 颜色解析失败")
            }
        }
        println(ind + "  " + p + "=" + v)
        out.push(p + "=" + v)
        if cur.load() < tks.len {
            if tks[cur.load()] == ";" {
                cur.store(cur.load() + 1)
            }
        }
    }
    cur.store(cur.load() + 1)
    return 0
}

// SL-7α:程序自身 GuiBlock 重建为 CTML 文本(内嵌 view/style 块端到端的数据源)。
// 形态 = 空格化 token(kind 名 { token* })——域包词法 glit 前置 gws,全容忍;
// ctron_embedded 内建(eval/emit 双口径)据此返回,run_d 文件缺失时兜底。
fn gui_blocks_src(file: List[Str]) -> Str {
    var out: Str = ""
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            out = out + d[1] + " " + d[2] + " \{"
            var tks = List[Str]()
            gui_split(d[4], tks)
            var k: I32 = 1
            while k < tks.len {
                var tk: Str = tks[k]
                // 剥行尾标记 ~:join 流的换行编码只服务 dump/check 面,域包词法
                // 不认(gspan 值位 "8~" 会在 ~ 处断词 → 期待标识符)
                if tk.len > 1 {
                    if byte_at(tk, tk.len - 1) == 126 {
                        tk = byte_slice(tk, 0, tk.len - 1)
                    }
                }
                if tk == "<" {
                    if k + 1 < tks.len {
                        if tks[k + 1] == "/" {
                            // </ 粘连:容器闭合探测是裸字节检查(gui.ct 子循环 peek2),
                            // "< /" 会被误判为子元素开头 → gword("/") 期待标识符
                            out = out + " </"
                            k += 2
                            continue
                        }
                    }
                }
                if tk == "=" {
                    if k + 1 < tks.len {
                        var nk2: Str = tks[k + 1]
                        if nk2.len == 1 {
                            if byte_at(nk2, 0) == 123 {
                                // ={ 粘连:attr 值花括号探测同为裸字节检查(= 后直接看 {),
                                // "= {" 会走 gstr 误期待引号串
                                out = out + " =\{"
                                k += 2
                                continue
                            }
                        }
                    }
                }
                out = out + " " + tk
                k += 1
            }
            out = out + " } "
        }
        i += 1
    }
    return out
}

// ==================== 独立 .ctml 检查入口(SL-6c;§5.1 语法缝)====================
// 内嵌/独立同语法同路径:标记 tokenizer → 复用 gui_block 平衡认领 → GuiBlock File 节
// → gui_dump_file/gui_check_file 同一走查。契约不变:GuiBlock[4]=空格连接串,
// token 不得含空格(串字面量含空格即降级,与内嵌口径一致)。

// 后缀判定:p 以 .ctml 结尾
fn gui_is_ctml(p: Str) -> Bool {
    if p.len < 5 {
        return false
    }
    var i: I32 = 0
    while i < 5 {
        if byte_at(p, p.len - 5 + i) != byte_at(".ctml", i) {
            return false
        }
        i += 1
    }
    return true
}

// 标记 tokenizer:< > = : ; / 单字符;花括号单字符;串字面量(可含转义)一 token;
// // 行注释跳过;词 = 非空白非特殊字节连续段(含 UTF-8 多字节)
fn gui_ctml_tokens(src: Str, out: List[Str]) -> I32 {
    var n: I32 = src.len
    var i: I32 = 0
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i += 1
        } else {
            if b == 47 {
                if i + 1 < n {
                    if byte_at(src, i + 1) == 47 {
                        while i < n {
                            if byte_at(src, i) == 10 {
                                break
                            }
                            i += 1
                        }
                        continue
                    }
                }
                out.push("/")
                i += 1
            } else {
                if b == 34 {
                    var j: I32 = i + 1
                    while j < n {
                        var cb: I32 = byte_at(src, j)
                        if cb == 92 {
                            j += 2
                            continue
                        }
                        if cb == 34 {
                            break
                        }
                        j += 1
                    }
                    if j >= n {
                        j = n - 1
                    }
                    out.push(byte_slice(src, i, j + 1))
                    i = j + 1
                } else {
                    if b == 60 || b == 62 || b == 61 || b == 123 || b == 125 || b == 58 || b == 59 {
                        out.push(byte_slice(src, i, i + 1))
                        i += 1
                    } else {
                        var j2: I32 = i
                        while j2 < n {
                            var wb: I32 = byte_at(src, j2)
                            if wb == 32 || wb == 9 || wb == 10 || wb == 13 {
                                break
                            }
                            if wb == 60 || wb == 62 || wb == 61 || wb == 123 || wb == 125 || wb == 58 || wb == 59 || wb == 47 || wb == 34 {
                                break
                            }
                            j2 += 1
                        }
                        if j2 > i {
                            out.push(byte_slice(src, i, j2))
                            i = j2
                        } else {
                            i += 1
                        }
                    }
                }
            }
        }
    }
    return 0
}

// 独立 .ctml 源 → File 节(子 = GuiBlock;顶层扫 view/style 关键字交 gui_block 认领)
fn gui_ctml_file(src: Str) -> List[Str] {
    var toks = List[Str]()
    gui_ctml_tokens(src, toks)
    var file = mk("File")
    var cur = Atomic[I32](0)
    while cur.load() < toks.len {
        var t: Str = toks[cur.load()]
        if t == "view" {
            file.push(gui_block(toks, cur, "view"))
        } else {
            if t == "style" {
                file.push(gui_block(toks, cur, "style"))
            } else {
                cur.store(cur.load() + 1)
            }
        }
    }
    return file
}

// ==================== gui_check:检查面(W3;§4.4 E8xxx 语料验收)====================
// 收集式(不 panic/不打印):诊断行入 gdiags("E8xxx: msg"),块内首错即止。
// 结构口径与 dump lower 一致(限深 1:根=容器,子=叶子)。
// 注意:本段一律用 eat_tok(eat 旧名已弃;花括号字面量不可词法化,一律字节码比较)。

fn gui_ck_has_style(sn: List[Str], name: Str) -> Bool {
    var i: I32 = 0
    while i < sn.len {
        if sn[i] == name {
            return true
        }
        i += 1
    }
    return false
}

fn gui_ck_color(v: Str, gdiags: List[Str]) -> I32 {
    if v.len != 7 {
        gdiags.push("E8130: 颜色须 #RRGGBB,得 " + v)
        return -1
    }
    if byte_at(v, 0) != 35 {
        gdiags.push("E8130: 颜色须 # 开头,得 " + v)
        return -1
    }
    var i: I32 = 1
    while i < 7 {
        var b: I32 = byte_at(v, i)
        var ok: Bool = b >= 48 && b <= 57
        if !ok {
            if b >= 97 {
                if b <= 102 {
                    ok = true
                }
            }
        }
        if !ok {
            if b >= 65 {
                if b <= 70 {
                    ok = true
                }
            }
        }
        if !ok {
            gdiags.push("E8130: 颜色含非十六进制字符,得 " + v)
            return -1
        }
        i += 1
    }
    return 0
}

fn gui_ck_tag(tag: Str, gdiags: List[Str]) -> I32 {
    // 白名单对齐域包 rt_emit 认领面(std/gui.ct):容器/叶子/包装元素
    if tag == "vbox" {
        return 0
    }
    if tag == "hbox" {
        return 0
    }
    if tag == "label" {
        return 0
    }
    if tag == "button" {
        return 0
    }
    if tag == "when" {
        return 0
    }
    if tag == "each" {
        return 0
    }
    if tag == "input" {
        return 0
    }
    gdiags.push("E8100: 未声明标签 " + tag)
    return -1
}

// SL-6(M1-d 合流):递归元素走查(镜像 gui_lower 结构;限深 8 守卫)。
// 认领:when cond 绑定名 / each item 位置头(in= 绑定列表名) / input bind 绑定名自闭合 /
// 花括号属性值(单词 = 绑定名通道)。诊断:
//   E8100 未知标签/闭合不匹配/props 缺失(when 无 cond、input 无 bind、each 无 in)
//   E8110 cond/bind/in 属性契约形态(须花括号绑定名,字符串即绑定期物不符)
//   E8120 on: 处理函数未在本文件 Fn/FnExt 声明表(签名级联动随 sem,登记非目标)
//   E8193 each 体含 input 型控件(警告入 gwarns,不置 rc;key 原语未落地前索引对齐即串位)
// sawin = 子树 input 计数累加器(Atomic;each 据此发 E8193,嵌套 each 各自报)。
fn gui_ck_elem(tks: List[Str], cur: Atomic[I32], sn: List[Str], fns: List[Str], gdiags: List[Str], gwarns: List[Str], depth: I32, sawin: Atomic[I32], indep: Bool) -> I32 {
    var bad: I32 = 0
    if depth > 8 {
        gdiags.push("E8100: 嵌套超限(限深 8)")
        return -1
    }
    var tag: Str = eat_tok(tks, cur)
    if gui_ck_tag(tag, gdiags) < 0 {
        bad = -1
    }
    if tag == "input" {
        sawin.store(sawin.load() + 1)
    }
    if tag == "each" {
        // 位置头:item in={列表}(域包先于 attrs 解析,镜像)
        if cur.load() < tks.len {
            var it: Str = tks[cur.load()]
            if it != ">" {
                if it != "/" {
                    cur.store(cur.load() + 1)
                }
            }
        }
    }
    var has_cond: Bool = false
    var has_bind: Bool = false
    var has_in: Bool = false
    var selfc: Bool = false
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 62 {
                cur.store(cur.load() + 1)
                break
            }
            if pb == 47 {
                cur.store(cur.load() + 1)
                selfc = true
                break
            }
        }
        var an: Str = eat_tok(tks, cur)
        if an == "on" {
            // on:名=花括号处理函数:逐 token 校验(曾盲吃 5 漏收尾闭,错位越界,W3 修复口径)
            if eat_tok(tks, cur) != ":" {
                gdiags.push("E8100: on 期待冒号")
                bad = -1
            }
            var evn: Str = eat_tok(tks, cur)
            var hn: Str = ""
            if eat_tok(tks, cur) != "=" {
                gdiags.push("E8100: on 期待等号")
                bad = -1
            } else {
                var ob: Str = eat_tok(tks, cur)
                if ob.len != 1 {
                    gdiags.push("E8100: on 期待块开")
                    bad = -1
                } else {
                    if byte_at(ob, 0) != 123 {
                        gdiags.push("E8100: on 期待块开")
                        bad = -1
                    } else {
                        hn = eat_tok(tks, cur)
                        var cb: Str = eat_tok(tks, cur)
                        if cb.len != 1 {
                            gdiags.push("E8100: on 期待块闭")
                            bad = -1
                        } else {
                            if byte_at(cb, 0) != 125 {
                                gdiags.push("E8100: on 期待块闭")
                                bad = -1
                            }
                        }
                    }
                }
            }
            if hn != "" {
                // indep = 独立 .ctml 形态(处理函数在伴生 .ct,跨文件解析 SL-7+)
                // ——跳过存在性检查;内嵌形态恒严格核对(与 Fn 表有无无关)
                if !indep {
                    if !gui_ck_has_style(fns, hn) {
                        gdiags.push("E8120: 事件处理器未声明 " + hn + "(on:" + evn + ")")
                        bad = -1
                    }
                }
            }
        } else {
            if eat_tok(tks, cur) != "=" {
                gdiags.push("E8100: 属性期待 =")
                bad = -1
            } else {
                var av: Str = ""
                var brform: Bool = false
                if cur.load() < tks.len {
                    var pv: Str = tks[cur.load()]
                    if pv.len == 1 {
                        if byte_at(pv, 0) == 123 {
                            cur.store(cur.load() + 1)
                            av = eat_tok(tks, cur)
                            var cbv: Str = eat_tok(tks, cur)
                            if cbv.len != 1 {
                                gdiags.push("E8100: 花括号属性期待闭")
                                bad = -1
                            } else {
                                if byte_at(cbv, 0) != 125 {
                                    gdiags.push("E8100: 花括号属性期待闭")
                                    bad = -1
                                }
                            }
                            brform = true
                        }
                    }
                }
                if !brform {
                    if cur.load() < tks.len {
                        av = gui_unq(eat_tok(tks, cur))
                    }
                }
                if an == "class" {
                    if !gui_ck_has_style(sn, av) {
                        gdiags.push("E8150: class 引用未定义样式 " + av)
                        bad = -1
                    }
                }
                if an == "cond" {
                    has_cond = true
                    if !brform {
                        gdiags.push("E8110: cond 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "bind" {
                    has_bind = true
                    if !brform {
                        gdiags.push("E8110: bind 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
                if an == "in" {
                    has_in = true
                    if !brform {
                        gdiags.push("E8110: in 须花括号绑定名形态,得 " + av)
                        bad = -1
                    }
                }
            }
        }
    }
    if tag == "when" {
        if !has_cond {
            gdiags.push("E8100: when 缺 cond")
            bad = -1
        }
    }
    if tag == "input" {
        if !has_bind {
            gdiags.push("E8100: input 缺 bind")
            bad = -1
        }
    }
    if tag == "each" {
        if !has_in {
            gdiags.push("E8100: each 缺 in")
            bad = -1
        }
    }
    if selfc {
        return bad
    }
    var in_before: I32 = sawin.load()
    while cur.load() < tks.len {
        var pk2: Str = tks[cur.load()]
        if pk2.len == 1 {
            var b2: I32 = byte_at(pk2, 0)
            if b2 == 60 {
                // <:子元素或本元素闭合
                if cur.load() + 1 < tks.len {
                    var nk: Str = tks[cur.load() + 1]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 47 {
                            cur.store(cur.load() + 2)
                            if cur.load() < tks.len {
                                var et: Str = eat_tok(tks, cur)
                                if et != tag {
                                    gdiags.push("E8100: 闭合标签不匹配 " + et)
                                    bad = -1
                                }
                            }
                            if cur.load() < tks.len {
                                var gt: Str = tks[cur.load()]
                                if gt.len == 1 {
                                    if byte_at(gt, 0) == 62 {
                                        cur.store(cur.load() + 1)
                                    }
                                }
                            }
                            break
                        }
                    }
                }
                cur.store(cur.load() + 1)
                var cb: I32 = gui_ck_elem(tks, cur, sn, fns, gdiags, gwarns, depth + 1, sawin, indep)
                if cb < 0 {
                    bad = -1
                }
            } else {
                if b2 == 35 {
                    gdiags.push("E8100: 未终止 " + tag)
                    bad = -1
                    break
                }
                cur.store(cur.load() + 1)
            }
        } else {
            cur.store(cur.load() + 1)
        }
    }
    if tag == "each" {
        if sawin.load() > in_before {
            gwarns.push("E8193: each 体含 input,索引对齐重排将串位(key 原语未落地)")
        }
    }
    return bad
}

fn gui_check_file(file: List[Str], gdiags: List[Str], gwarns: List[Str], indep: Bool) -> I32 {
    // 第一遍:样式名表 + Fn/FnExt 名表(E8120 处理函数存在性依据)
    var sn = List[Str]()
    var fns = List[Str]()
    var si: I32 = 1
    while si < file.len {
        var ds = file[si]
        if ds[0] == "GuiBlock" {
            if ds[1] == "style" {
                var stks = List[Str]()
                gui_split(ds[4], stks)
                sn.push(stks[0])
            }
        }
        if ds[0] == "Fn" {
            if ds.len > 1 {
                fns.push(ds[1])
            }
        }
        if ds[0] == "FnExt" {
            if ds.len > 1 {
                fns.push(ds[1])
            }
        }
        si += 1
    }
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                cur.store(1)
                if eat_tok(tks, cur) != "<" {
                    gdiags.push("E8100: view 期待 <")
                } else {
                    var sawin = Atomic[I32](0)
                    gui_ck_elem(tks, cur, sn, fns, gdiags, gwarns, 1, sawin, indep)
                }
            } else {
                if d[1] == "style" {
                    // joined 以名字开头(tks[0]),与 view 路径同样跳过——
                    // 否则属性错位一位:冒号误报 + 游标越界,整个检查崩溃丢诊断(W3 修复)
                    cur.store(1)
                    while cur.load() < tks.len {
                        var pp: Str = eat_tok(tks, cur)
                        if eat_tok(tks, cur) != ":" {
                            gdiags.push("E8130: style 期待冒号")
                        }
                        var vv: Str = gui_unq(eat_tok(tks, cur))
                        if pp == "bg" {
                            gui_ck_color(vv, gdiags)
                        }
                        if cur.load() < tks.len {
                            if tks[cur.load()] == ";" {
                                eat_tok(tks, cur)
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    return 0
}

// ==================== SL-7β1:编译期骨架解析(镜像 std/gui.ct gt_parse)====================
// GuiBlock token 流 → GuiTree 15 字段平行表。与运行时 gt_parse 的树等价由
// s22_sk_equiv 夹具双端差分锁定(编译器 dump vs 域包 sk_dump)。语义镜像:
// 节点 id = push 序;when = 带旗容器(cond 名自持);each 节点 npre=列表名 nbid=itemvar;
// 叶文本 pre/bind/post 按 {ident} 三段(词流单空格拼接,词法切分标点文本为已登记偏差);
// 事件槽 nes/nec = ev_name/ev_fn 的 [起,计) 切片;button 注册 btns;style sk=名.属性 sv=值。
// 语法缝:token 流为裸切分形态(</ 与 ={ 无粘连,本 builder 按独立 token 消费)。

fn gui_sk_word(tks: List[Str], cur: Atomic[I32]) -> Str {
    var t: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    // 剥 W1 join 行尾标记 ~:gs2i 等数值解析不认("8~" → 158),样式/文本均受害
    if t.len > 1 {
        if byte_at(t, t.len - 1) == 126 {
            t = byte_slice(t, 0, t.len - 1)
        }
    }
    return t
}

fn gui_sk_attrs(tks: List[Str], cur: Atomic[I32], ev_name: List[Str], ev_fn: List[Str], out4: List[Str]) -> I32 {
    // out4 预置 4 槽:[0]=class [1]=cond [2]=bind [3]=placeholder(末值覆盖,镜像末推)
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 62 {
                break
            }
            if pb == 47 {
                break
            }
        }
        var an: Str = gui_sk_word(tks, cur)
        if an == "on" {
            gui_sk_word(tks, cur)
            var evn: Str = gui_sk_word(tks, cur)
            gui_sk_word(tks, cur)
            gui_sk_word(tks, cur)
            var fnn: Str = gui_sk_word(tks, cur)
            gui_sk_word(tks, cur)
            ev_name.push(evn)
            ev_fn.push(fnn)
        } else {
            gui_sk_word(tks, cur)
            var av: Str = ""
            var brform: Bool = false
            if cur.load() < tks.len {
                var pv: Str = tks[cur.load()]
                if pv.len == 1 {
                    if byte_at(pv, 0) == 123 {
                        cur.store(cur.load() + 1)
                        av = gui_sk_word(tks, cur)
                        gui_sk_word(tks, cur)
                        brform = true
                    }
                }
            }
            if !brform {
                if cur.load() < tks.len {
                    av = gui_unq(gui_sk_word(tks, cur))
                }
            }
            if an == "class" {
                out4[0] = av
            }
            if an == "cond" {
                out4[1] = av
            }
            if an == "bind" {
                out4[2] = av
            }
            if an == "placeholder" {
                out4[3] = av
            }
        }
    }
    return 0
}

fn gui_sk_node(tks: List[Str], cur: Atomic[I32], ntag: List[Str], nflag: List[Str], ncls: List[Str], npre: List[Str], nbid: List[Str], npost: List[Str], nfc: List[I32], ns: List[I32], nes: List[I32], nec: List[I32], ev_name: List[Str], ev_fn: List[Str], btns: List[I32], depth: I32) -> I32 {
    cur.store(cur.load() + 1)
    var tag: Str = gui_sk_word(tks, cur)
    var is_leaf: Bool = false
    if tag == "label" {
        is_leaf = true
    }
    if tag == "button" {
        is_leaf = true
    }
    var is_input: Bool = false
    if tag == "input" {
        is_input = true
    }
    var itemvar: Str = ""
    var listname: Str = ""
    if tag == "each" {
        // 头:item in={列表}(先于 attrs,镜像 gt_node;六 token:名 in = { 表 })
        itemvar = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        listname = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
    }
    var estart: I32 = ev_name.len
    var out4 = List[Str]()
    out4.push("")
    out4.push("")
    out4.push("")
    out4.push("")
    gui_sk_attrs(tks, cur, ev_name, ev_fn, out4)
    var id: I32 = ntag.len
    if is_input {
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        ntag.push(tag)
        ncls.push(out4[0])
        npre.push(out4[3])
        nbid.push(out4[2])
        npost.push("")
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push("")
        return id
    }
    gui_sk_word(tks, cur)
    if is_leaf {
        // 叶文本三段:词流(单空格拼接)至 { → bind 名 → 词流至 <
        var p0: Str = ""
        var b: Str = ""
        var p1: Str = ""
        var phase: I32 = 0
        while cur.load() < tks.len {
            var tk: Str = tks[cur.load()]
            if tk.len == 1 {
                var tb: I32 = byte_at(tk, 0)
                if tb == 123 {
                    cur.store(cur.load() + 1)
                    phase = 1
                    continue
                }
                if tb == 60 {
                    break
                }
            }
            if phase == 0 {
                if p0 != "" {
                    p0 = p0 + " "
                }
                p0 = p0 + tk
            } else {
                if phase == 1 {
                    b = tk
                    phase = 3
                } else {
                    if phase == 3 {
                        // bind 闭括号 }:镜像 gt_leaf_text glit(125)——消费不入 post
                        phase = 2
                        if tk.len == 1 {
                            if byte_at(tk, 0) == 125 {
                                cur.store(cur.load() + 1)
                                continue
                            }
                        }
                    }
                    if p1 != "" {
                        p1 = p1 + " "
                    }
                    p1 = p1 + tk
                }
            }
            cur.store(cur.load() + 1)
        }
        npre.push(p0)
        nbid.push(b)
        npost.push(p1)
        ntag.push(tag)
        ncls.push(out4[0])
        nfc.push(-1)
        ns.push(-1)
        nes.push(estart)
        nec.push(ev_name.len - estart)
        nflag.push(out4[1])
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        if tag == "button" {
            btns.push(id)
        }
        return id
    }
    ntag.push(tag)
    ncls.push(out4[0])
    npre.push(listname)
    nbid.push(itemvar)
    npost.push("")
    nfc.push(-1)
    ns.push(-1)
    nes.push(estart)
    nec.push(ev_name.len - estart)
    nflag.push(out4[1])
    var prev: I32 = -1
    while cur.load() < tks.len {
        var pk2: Str = tks[cur.load()]
        if pk2.len == 1 {
            if byte_at(pk2, 0) == 60 {
                if cur.load() + 1 < tks.len {
                    var nk: Str = tks[cur.load() + 1]
                    if nk.len == 1 {
                        if byte_at(nk, 0) == 47 {
                            break
                        }
                    }
                }
            }
        }
        var kid: I32 = gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, depth + 1)
        var fcl: List[I32] = nfc
        var nsl: List[I32] = ns
        if prev < 0 {
            fcl[id] = kid
        } else {
            nsl[prev] = kid
        }
        prev = kid
    }
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    gui_sk_word(tks, cur)
    return id
}

fn gui_sk_style(tks: List[Str], cur: Atomic[I32], sk: List[Str], sv: List[Str]) -> I32 {
    var name: Str = gui_sk_word(tks, cur)
    while cur.load() < tks.len {
        var pk: Str = tks[cur.load()]
        if pk.len == 1 {
            var pb: I32 = byte_at(pk, 0)
            if pb == 59 {
                cur.store(cur.load() + 1)
                continue
            }
            if pb == 125 {
                break
            }
        }
        var p: Str = gui_sk_word(tks, cur)
        gui_sk_word(tks, cur)
        var v: Str = ""
        if cur.load() < tks.len {
            var pv: Str = tks[cur.load()]
            if pv.len > 1 {
                if byte_at(pv, 0) == 34 {
                    v = gui_unq(pv)
                    cur.store(cur.load() + 1)
                }
            }
        }
        if v == "" {
            if cur.load() < tks.len {
                v = gui_sk_word(tks, cur)
            }
        }
        sk.push(name + "." + p)
        sv.push(v)
    }
    return 0
}

fn gui_sk_build(file: List[Str], ntag: List[Str], nflag: List[Str], ncls: List[Str], npre: List[Str], nbid: List[Str], npost: List[Str], nfc: List[I32], ns: List[I32], nes: List[I32], nec: List[I32], ev_name: List[Str], ev_fn: List[Str], btns: List[I32], sk: List[Str], sv: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            if d[1] == "view" {
                cur.store(1)
                if cur.load() < tks.len {
                    gui_sk_node(tks, cur, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, 1)
                }
            } else {
                if d[1] == "style" {
                    gui_sk_style(tks, cur, sk, sv)
                }
            }
        }
        i += 1
    }
    return 0
}

// 骨架表倾倒(格式与域包 std/gui.ct sk_dump 逐字节一致,双端差分用;空串以 - 表示)
fn gui_sk_dump_all(file: List[Str]) -> I32 {
    var ntag = List[Str]()
    var nflag = List[Str]()
    var ncls = List[Str]()
    var npre = List[Str]()
    var nbid = List[Str]()
    var npost = List[Str]()
    var nfc = List[I32]()
    var ns = List[I32]()
    var nes = List[I32]()
    var nec = List[I32]()
    var ev_name = List[Str]()
    var ev_fn = List[Str]()
    var btns = List[I32]()
    var sk = List[Str]()
    var sv = List[Str]()
    gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, sk, sv)
    var i: I32 = 0
    while i < ntag.len {
        var pre: Str = npre[i]
        if pre == "" {
            pre = "-"
        }
        var bid: Str = nbid[i]
        if bid == "" {
            bid = "-"
        }
        var post: Str = npost[i]
        if post == "" {
            post = "-"
        }
        var flag: Str = nflag[i]
        if flag == "" {
            flag = "-"
        }
        var cls: Str = ncls[i]
        if cls == "" {
            cls = "-"
        }
        println("n" + i.to_string() + " tag=" + ntag[i] + " cls=" + cls + " pre=" + pre + " bid=" + bid + " post=" + post + " flag=" + flag + " fc=" + nfc[i].to_string() + " ns=" + ns[i].to_string() + " es=" + nes[i].to_string() + " ec=" + nec[i].to_string())
        i += 1
    }
    var k: I32 = 0
    while k < ev_name.len {
        println("e" + k.to_string() + " on=" + ev_name[k] + " fn=" + ev_fn[k])
        k += 1
    }
    var b: I32 = 0
    while b < btns.len {
        println("btn id=" + btns[b].to_string())
        b += 1
    }
    var s: I32 = 0
    while s < sk.len {
        println("s " + sk[s] + "=" + sv[s])
        s += 1
    }
    println("sk-end")
    return 0
}

// SL-7β3:C 串字面量转义(自包含;不依赖 trans_ty 的 ct_cstr——cc_run 拼接无该符号)
fn gui_sk_cesc(s: Str) -> Str {
    var out: Str = ""
    var i: I32 = 0
    var start: I32 = 0
    while i < s.len {
        var b: I32 = byte_at(s, i)
        if b == 34 {
            if i > start {
                out = out + byte_slice(s, start, i)
            }
            out = out + "\\"
            out = out + "\""
            i += 1
            start = i
        } else {
            if b == 92 {
                if i > start {
                    out = out + byte_slice(s, start, i)
                }
                out = out + "\\"
                out = out + "\\"
                i += 1
                start = i
            } else {
                if b == 10 {
                    if i > start {
                        out = out + byte_slice(s, start, i)
                    }
                    out = out + "\\"
                    out = out + "n"
                    i += 1
                    start = i
                } else {
                    i += 1
                }
            }
        }
    }
    if s.len > start {
        out = out + byte_slice(s, start, s.len)
    }
    return out
}

// SL-7β3:C 静态数组发射文本(串表/整表;driver_emit 骨架构造用)
fn gui_sk_emit_str_arr(id: I32, tbl: List[Str]) -> Str {
    var arr: Str = "static const char* sk_t" + id.to_string() + "[] = \{"
    var k2: I32 = 0
    while k2 < tbl.len {
        if k2 > 0 {
            arr = arr + ","
        }
        arr = arr + " \"" + gui_sk_cesc(tbl[k2]) + "\""
        k2 += 1
    }
    return arr + " };"
}

fn gui_sk_emit_int_arr(id: I32, tbl: List[I32]) -> Str {
    var arr: Str = "static const int32_t sk_t" + id.to_string() + "[] = \{"
    var k2: I32 = 0
    while k2 < tbl.len {
        if k2 > 0 {
            arr = arr + ","
        }
        arr = arr + tbl[k2].to_string()
        k2 += 1
    }
    return arr + " };"
}
