// =====================================================================
// gui_parse.ct —— GUI 块认领与折叠(W1/W2;规范 specs/2026-09-16-gui-ctml-design.md §11.1)
// W1:顶层 view/style 块在 token 流上的平衡扫描认领,记 File 子节点 GuiBlock:
//    [1]=kind [2]=name [3]=块内 token 数 [4]=块内 token 空格连接串(词法 token 无空格,无损)
// W2:gui_lower 折叠——token 串 → 结构化 IR 文本 dump(--dump-gui 口径);
//    颜色 #RRGGBB 格式校验(E8130 前身,W3 接诊断面);令牌查用户常量随 W3(sem 表)。
// 契约:花括号字面量不可词法化(触发插值扫描吞引号,E1001)——一律字节码比较;
//       注释中不放花括号字符(发射口径词法分歧,见计划文档登记)。
// =====================================================================

fn gui_block(toks: List[Str], cur: Atomic[I32], kind: Str) -> List[Str] {
    var nd = mk("GuiBlock")
    nd.push(kind)
    adv(cur)
    var name: Str = tok(toks, cur)
    adv(cur)
    nd.push(name)
    var joined: Str = ""
    var depth: I32 = 0
    var toks_n: I32 = 0
    var started: Bool = false
    var first: Bool = true
    while true {
        var t: Str = tok(toks, cur)
        if t == "#EOF" {
            panic("gui: 块未闭合 " + kind + " " + name)
        }
        var one: Bool = t.len == 1
        var is_open: Bool = false
        var is_close: Bool = false
        if one {
            if byte_at(t, 0) == 123 {
                is_open = true
            }
            if byte_at(t, 0) == 125 {
                is_close = true
            }
        }
        if is_open {
            depth += 1
            started = true
        } else {
            if is_close {
                depth -= 1
            }
        }
        var keep: Bool = false
        if started {
            if depth == 0 {
                adv(cur)
                break
            }
            keep = true
        }
        if keep {
            if first {
                joined = t
                first = false
            } else {
                joined = joined + " " + t
            }
            toks_n += 1
        }
        adv(cur)
    }
    nd.push(toks_n.to_string())
    nd.push(joined)
    return nd
}

// ---- token 串拆分(词法 token 无空格,空格单切无损) ----

fn gui_split(joined: Str, out: List[Str]) -> I32 {
    var n: I32 = joined.len
    var i: I32 = 0
    while i < n {
        var start: I32 = i
        while i < n {
            if byte_at(joined, i) == 32 {
                break
            }
            i += 1
        }
        if i > start {
            out.push(byte_slice(joined, start, i))
        }
        i += 1
    }
    return 0
}

fn gui_hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui E8130: 颜色非法十六进制")
    return 0
}

// 颜色串校验(E8130 前身):#RRGGBB;返回打包色
fn gui_parse_color(v: Str) -> I32 {
    if v.len != 7 {
        panic("gui E8130: 颜色须 #RRGGBB,得 " + v)
    }
    if byte_at(v, 0) != 35 {
        panic("gui E8130: 颜色须 # 开头,得 " + v)
    }
    var r: I32 = gui_hex1(byte_at(v, 1)) * 16 + gui_hex1(byte_at(v, 2))
    var g: I32 = gui_hex1(byte_at(v, 3)) * 16 + gui_hex1(byte_at(v, 4))
    var b: I32 = gui_hex1(byte_at(v, 5)) * 16 + gui_hex1(byte_at(v, 6))
    return r * 65536 + g * 256 + b
}

// ==================== gui_lower:折叠为 IR 文本 ====================

// 视图块折叠:<' tag attrs '>' content '</' tag '>';返回 IR 行(已含缩进)
// attrs:class="x" 与 on:名={handler};叶子文本:字面量 token* + 至多一个 {ident}
fn gui_lower_view(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui view " + name)
    out.push("view " + name)
    gui_lower_element(tks, cur, ind + "  ", out)
    return 0
}

fn gui_lower_element(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var i: I32 = cur.load()
    var t: Str = tks[i]
    if t != "<" {
        panic("gui E8100: 期待 <,得 " + t)
    }
    i += 1
    var tag: Str = tks[i]
    i += 1
    var c: Str = ""
    var onn: Str = ""
    var onf: Str = ""
    while tks[i] != ">" {
        var an: Str = tks[i]
        i += 1
        if an == "on" {
            i += 1              // ':'
            var evn: Str = tks[i]
            i += 1              // '='
            i += 1              // '{'
            var fnn: Str = tks[i]
            i += 1              // '}'
            onn = evn
            onf = fnn
        } else {
            i += 1              // '='
            var av: Str = tks[i]
            i += 1
            if an == "class" {
                c = av
            }
        }
    }
    i += 1
    var line: Str = ind + "el " + tag
    if c != "" {
        line = line + " cls=" + c
    }
    if onn != "" {
        line = line + " on:" + onn + "=" + onf
    }
    println(line)
    out.push(line)
    // 叶子文本:字面量 token(至 '</' 前的 '{')+ 至多一个 {ident} + 尾字面量 token*
    var lit: Str = ""
    var bid: Str = ""
    var done: Bool = false
    while !done {
        var w: Str = tks[i]
        var one: Bool = w.len == 1
        if one {
            if byte_at(w, 0) == 60 {
                done = true
            }
        }
        if !done {
            if one {
                if byte_at(w, 0) == 123 {
                    done = true
                    i += 1
                    bid = tks[i]
                    i += 1
                    if tks[i] != "}" {
                        panic("gui E8100: 绑定未闭合")
                    }
                    i += 1
                } else {
                    if lit != "" {
                        lit = lit + " "
                    }
                    lit = lit + w
                    i += 1
                }
            } else {
                if lit != "" {
                    lit = lit + " "
                }
                lit = lit + w
                i += 1
            }
        }
    }
    var tline: Str = ind + "  " + tag + " text=\"" + lit + "\""
    if bid != "" {
        tline = tline + " bind=" + bid
    }
    println(tline)
    out.push(tline)
    if tks[i] != "</" {
        panic("gui E8100: 期待闭合,得 " + tks[i])
    }
    i += 1
    if tks[i] != tag {
        panic("gui E8100: 闭合标签不匹配 " + tks[i])
    }
    i += 1
    if tks[i] != ">" {
        panic("gui E8100: 期待 >,得 " + tks[i])
    }
    i += 1
    cur.store(i)
    return 0
}

// 样式块折叠:IDENT ':' value(';'?)*;bg 做 #RRGGBB 校验(E8130)
fn gui_lower_style(tks: List[Str], cur: Atomic[I32], ind: Str, out: List[Str]) -> I32 {
    var name: Str = tks[cur.load()]
    cur.store(cur.load() + 1)
    println(ind + "gui style " + name)
    out.push("style " + name)
    while tks[cur.load()] != "}" {
        var p: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if tks[cur.load()] != ":" {
            panic("gui E8130: 期待 :,得 " + tks[cur.load()])
        }
        cur.store(cur.load() + 1)
        var v: Str = tks[cur.load()]
        cur.store(cur.load() + 1)
        if p == "bg" {
            var packed: I32 = gui_parse_color(v)
            if packed < 0 {
                panic("gui E8130: 颜色解析失败")
            }
        }
        println(ind + "  " + p + "=" + v)
        out.push(p + "=" + v)
        if tks[cur.load()] == ";" {
            cur.store(cur.load() + 1)
        }
    }
    cur.store(cur.load() + 1)
    return 0
}

// File 子节点遍历 dump(--dump-gui 消费口;driver_check 调用)
fn gui_dump_file(file: List[Str]) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "GuiBlock" {
            var tks = List[Str]()
            gui_split(d[4], tks)
            var cur = Atomic[I32](0)
            var out = List[Str]()
            if d[1] == "view" {
                gui_lower_view(tks, cur, "  ", out)
            } else {
                if d[1] == "style" {
                    gui_lower_style(tks, cur, "  ", out)
                }
            }
        }
        i += 1
    }
    return 0
}
