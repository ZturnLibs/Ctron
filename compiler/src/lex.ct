// =====================================================================
// lex.ct —— 词法器
// 职责:源码字符流 → token 串(标点原始串/数值=text~sfx/标识符/哨兵 #EOF),
//       注释与空白丢弃;换行过滤按规范 §1.6 行延续规则。
// 接口:scan(src, toks)   辅助:or2/or3/is_*/suffix_len/nl_set_*
// =====================================================================
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }
fn or3(a: Bool, b: Bool, c: Bool) -> Bool { return or2(or2(a, b), c) }
fn is_digit(b: I32) -> Bool { return b >= 48 && b <= 57 }
fn is_alpha(b: I32) -> Bool { return or2(b >= 65 && b <= 90, b >= 97 && b <= 122) }
fn is_al(b: I32) -> Bool { return or2(is_alpha(b), b == 95) }
fn is_ac(b: I32) -> Bool { return or2(is_al(b), is_digit(b)) }

fn is_hex(b: I32) -> Bool { return or2(b >= 48 && b <= 57, or2(b >= 65 && b <= 70, b >= 97 && b <= 102)) }
fn is_oct(b: I32) -> Bool { return b >= 48 && b <= 55 }
fn is_bin(b: I32) -> Bool { return b >= 48 && b <= 49 }

fn suffix_len(src: Str, n: I32, i: I32) -> I32 {
    if i + 2 <= n {
        var a = byte_at(src, i)
        var b = byte_at(src, i + 1)
        var len: I32 = 0
        if a == 105 && b == 56 { len = 2 }
        if a == 105 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 { len = 3 }
        if a == 105 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 105 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if a == 105 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 { len = 5 }
        if a == 117 && b == 56 { len = 2 }
        if a == 117 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 { len = 3 }
        if a == 117 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 117 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if a == 117 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 { len = 5 }
        if a == 102 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 102 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if len > 0 {
            if i + len < n && is_ac(byte_at(src, i + len)) { return 0 }
            return len
        }
    }
    return 0
}

// 词法:空白/换行(NL)/注释丢弃;数值=text~sfx;标点原始串;哨兵 #EOF
// ---------------- 换行过滤(规范 §1.6 行延续规则) ----------------
// 行尾延续集 → 其后换行抑制;下一行首在延续集 → 换行抑制;连续换行折叠为一个。
fn nl_set_line_end(t: Str) -> Bool {
    var ops = List[Str]()
    ops.push(",")
    ops.push("=")
    ops.push("->")
    ops.push("=>")
    ops.push("&&")
    ops.push("||")
    ops.push("..")
    ops.push("..=")
    ops.push("+")
    ops.push("-")
    ops.push("*")
    ops.push("/")
    ops.push("%")
    ops.push("+%")
    ops.push("-%")
    ops.push("==")
    ops.push("!=")
    ops.push("<")
    ops.push(">")
    ops.push("<=")
    ops.push(">=")
    ops.push("(")
    ops.push("[")
    ops.push("|")
    var i: I32 = 0
    while i < ops.len {
        if ops[i] == t { return true }
        i += 1
    }
    return false
}
fn nl_set_next(t: Str) -> Bool {
    var ops = List[Str]()
    ops.push(".")
    ops.push("+")
    ops.push("-")
    ops.push("*")
    ops.push("/")
    ops.push("%")
    ops.push("+%")
    ops.push("-%")
    ops.push("==")
    ops.push("!=")
    ops.push("<")
    ops.push(">")
    ops.push("<=")
    ops.push(">=")
    ops.push("&&")
    ops.push("||")
    ops.push("..")
    ops.push("..=")
    var i: I32 = 0
    while i < ops.len {
        if ops[i] == t { return true }
        i += 1
    }
    return false
}
fn filter_nl(raw: List[Str], rlines: List[Str], rcols: List[Str], toks: List[Str], lns: List[Str], cols: List[Str]) {
    var i: I32 = 0
    while i < raw.len && raw[i] == "NL" {
        i += 1
    }
    while i < raw.len {
        if raw[i] != "NL" {
            toks.push(raw[i])
            lns.push(rlines[i])
            cols.push(rcols[i])
            i += 1
        } else {
            var run = i
            while run < raw.len && raw[run] == "NL" {
                run += 1
            }
            var nxt = "#EOF"
            if run < raw.len {
                nxt = raw[run]
            }
            var suppressed = false
            if toks.len > 0 && nl_set_line_end(toks[toks.len - 1]) {
                suppressed = true
            }
            if nl_set_next(nxt) {
                suppressed = true
            }
            if !suppressed {
                toks.push("NL")
                lns.push(rlines[i])
                cols.push(rcols[i])
            }
            i = run
        }
    }
}

// 诊断入口(镜像 seed lx_err/err_here 的 text 形态:PATH:LINE:COL CODE: MSG)
// pdiags 条目 = "LINE:COL CODE: msg",路径由驱动拼前缀
fn pdiag(pdiags: List[Str], lns: List[Str], cols: List[Str], cur: Atomic[I32], code: Str, msg: Str) {
    var i = cur.load()
    var ln = "0"
    if i < lns.len { ln = lns[i] }
    var cl = "0"
    if i < cols.len { cl = cols[i] }
    pdiags.push(ln + ":" + cl + " " + code + ": " + msg)
}

// scan4:scan + 逐 token 列号(cols 与 toks 平行)+ 词法诊断(pdiags)
// 镜像 seed 词法器守卫:`;`/`::` 禁用标点与无法识别字符报 E1001(`;`/未知字符丢弃记号续扫)
fn scan4(src: Str, toks: List[Str], lns: List[Str], cols: List[Str], pdiags: List[Str]) {
    var raw = List[Str]()
    var rlines = List[Str]()
    var rcols = List[Str]()
    var line: I32 = 1
    var lst: I32 = 0
    var n = src.len
    var i: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        var c0 = i - lst + 1
        if b == 10 {
            raw.push("NL")
            rlines.push(line.to_string())
            rcols.push(c0.to_string())
            line += 1
            i += 1
            lst = i
        } else if or2(b == 32, or2(b == 9, b == 13)) {
            i += 1
        } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            while i < n && byte_at(src, i) != 10 { i += 1 }
        } else if b == 34 {
            var q0 = i
            i += 1
            var done = false
            while i < n && !done {
                var c = byte_at(src, i)
                if c == 34 {
                    i += 1
                    done = true
                } else if c == 92 {
                    i += 2
                } else if c == 10 {
                    done = true
                } else {
                    i += 1
                }
            }
            rpush(raw, rlines, rcols, line, c0, byte_slice(src, q0, i))
        } else if is_al(b) {
            var start = i
            while i < n && is_ac(byte_at(src, i)) { i += 1 }
            rpush(raw, rlines, rcols, line, c0, byte_slice(src, start, i))
        } else if is_digit(b) {
            var tstart = i
            var radix: I32 = 0
            if b == 48 && i + 1 < n {
                var p2 = byte_at(src, i + 1)
                if p2 == 120 { radix = 16 }
                if p2 == 111 { radix = 8 }
                if p2 == 98 { radix = 2 }
            }
            var fnum = false
            if radix > 0 {
                i += 2
                if radix == 16 {
                    while i < n && or2(is_hex(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
                if radix == 8 {
                    while i < n && or2(is_oct(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
                if radix == 2 {
                    while i < n && or2(is_bin(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
            } else {
                while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                if i + 1 < n && byte_at(src, i) == 46 && is_digit(byte_at(src, i + 1)) {
                    fnum = true
                    i += 1
                    while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
                if i < n && or2(byte_at(src, i) == 101, byte_at(src, i) == 69) {
                    var esign = false
                    if i + 1 < n && or2(byte_at(src, i + 1) == 43, byte_at(src, i + 1) == 45) { esign = true }
                    var eok = false
                    if esign && i + 2 < n && is_digit(byte_at(src, i + 2)) { eok = true }
                    if !esign && i + 1 < n && is_digit(byte_at(src, i + 1)) { eok = true }
                    if eok {
                        fnum = true
                        i += 1
                        if esign { i += 1 }
                        while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                    }
                }
            }
            var tend = i
            var tk = byte_slice(src, tstart, tend) + "~"
            var sl = suffix_len(src, n, i)
            if sl > 0 { tk = tk + byte_slice(src, i, i + sl) }
            i += sl
            rpush(raw, rlines, rcols, line, c0, tk)
        } else {
            if b == 46 && i + 2 < n && byte_at(src, i + 1) == 46 && byte_at(src, i + 2) == 46 {
                // "..." 变参标记(§9.6 v0.7:extern 形参表尾)
                rpush(raw, rlines, rcols, line, c0, "...")
                i += 3
            } else if b == 46 && i + 2 < n && byte_at(src, i + 1) == 46 && byte_at(src, i + 2) == 61 {
                rpush(raw, rlines, rcols, line, c0, "..=")
                i += 3
            } else if b == 46 && i + 1 < n && byte_at(src, i + 1) == 46 {
                rpush(raw, rlines, rcols, line, c0, "..")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 62 {
                rpush(raw, rlines, rcols, line, c0, "->")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 62 {
                rpush(raw, rlines, rcols, line, c0, "=>")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "==")
                i += 2
            } else if b == 33 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "!=")
                i += 2
            } else if b == 60 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "<=")
                i += 2
            } else if b == 62 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, ">=")
                i += 2
            } else if b == 38 && i + 1 < n && byte_at(src, i + 1) == 38 {
                rpush(raw, rlines, rcols, line, c0, "&&")
                i += 2
            } else if b == 124 && i + 1 < n && byte_at(src, i + 1) == 124 {
                // v0.7 修订一:|| 最长匹配(起始位零参闭包由 parse 角色分离,§4.0)
                rpush(raw, rlines, rcols, line, c0, "||")
                i += 2
            } else if b == 43 && i + 1 < n && byte_at(src, i + 1) == 37 {
                rpush(raw, rlines, rcols, line, c0, "+%")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 37 {
                rpush(raw, rlines, rcols, line, c0, "-%")
                i += 2
            } else if b == 43 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "+=")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "-=")
                i += 2
            } else if b == 42 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "*=")
                i += 2
            } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "/=")
                i += 2
            } else if b == 37 && i + 1 < n && byte_at(src, i + 1) == 61 {
                rpush(raw, rlines, rcols, line, c0, "%=")
                i += 2
            } else if b == 58 && i + 1 < n && byte_at(src, i + 1) == 58 {
                // 禁用标点 :: (镜像 seed:报 E1001,恢复为单个冒号继续)
                rpush(raw, rlines, rcols, line, c0, ":")
                pdiags.push(line.to_string() + ":" + c0.to_string() + " E1001: " + diag_text0("E1001.punct.colon"))
                i += 2
            } else if b == 59 {
                // 禁用标点 ; (镜像 seed:报 E1001 并丢弃记号,主循环续扫)
                i += 1
                pdiags.push(line.to_string() + ":" + c0.to_string() + " E1001: " + diag_text0("E1001.punct.semi"))
            } else if lex_single(b) {
                rpush(raw, rlines, rcols, line, c0, byte_slice(src, i, i + 1))
                i += 1
            } else {
                pdiags.push(line.to_string() + ":" + c0.to_string() + " E1001: " + diag_text1("E1001.badchar", byte_slice(src, i, i + 1)))
                i += 1
            }
        }
    }
    filter_nl(raw, rlines, rcols, toks, lns, cols)
    toks.push("#EOF")
    lns.push(line.to_string())
    cols.push("0")
}

// 单字符标点集(镜像 seed 词法器 switch;集合外 = 无法识别字符)
// 注:源码串内花括号须 \{ \} 转义(裸 { 开启插值,批次十二教训)
fn lex_single(b: I32) -> Bool {
    var ks = "+-*/%=<>?!.,:[]()\{}|&#@"
    var k: I32 = 0
    while k < ks.len {
        if byte_at(ks, k) == b { return true }
        k += 1
    }
    return false
}

fn scan(src: Str, toks: List[Str], lns: List[Str]) {
    var cols = List[Str]()
    var pd = List[Str]()
    scan4(src, toks, lns, cols, pd)
}

fn rpush(raw: List[Str], rlines: List[Str], rcols: List[Str], line: I32, col: I32, t: Str) {
    raw.push(t)
    rlines.push(line.to_string())
    rcols.push(col.to_string())
}

fn tok(toks: List[Str], cur: Atomic[I32]) -> Str {
    var i = cur.load()
    if i < toks.len { return toks[i] }
    return "#EOF"
}
fn adv(cur: Atomic[I32]) {
    cur.store(cur.load() + 1)
}

fn num_text(t: Str) -> Str {
    var k: I32 = 0
    while k < t.len && byte_at(t, k) != 126 { k += 1 }
    return byte_slice(t, 0, k)
}
fn num_sfx(t: Str) -> Str {
    var k: I32 = 0
    while k < t.len && byte_at(t, k) != 126 { k += 1 }
    return byte_slice(t, k + 1, t.len)
}
