// =====================================================================
// sem_ceval.ct —— comptime 步数预算求值器 ceval(E6010,1200 步,镜像宿主 pkg ceval)
// local_type_or_trait/ce_budget 助手;ceval_expr/ceval_block 支持 const 引用/comptime fn
// 单表达式体/If 值位;超预算 → E6010;不支持形态 → 静默回退全量求值(无挂起/无栈溢出)。
// =====================================================================
// ---------------- E5010/E6010 助手(模块检查 v0) ----------------
fn local_type_or_trait(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if or2(t == "Trait", or2(t == "Struct", or2(t == "Enum", t == "Class"))) {
            if seq2(d[1], nm) {
                return true
            }
        }
        i += 1
    }
    return false
}

// comptime fn 体内是否存在直呼自身的调用
// ---------------- comptime 步数预算求值器(E6010,镜像宿主 pkg ceval) ----------------
// v0 支持:I 域整型字面量/const 引用/一元负号/算术(ari,静默回绕)/比较/逻辑与;
// comptime fn 单表达式体调用。不支持 → "u"(静默回退全量求值);步数超限 → "over"。
fn ce_budget(st: List[Str]) -> Bool {
    var used = dvi(st[0])
    if used > 1200 {
        return false
    }
    st[0] = (used + 1).to_string()
    return true
}

fn ceval_expr(file: List[Str], e: List[Str], cenvN: List[Str], cenvV: List[Str], st: List[Str]) -> List[Str] {
    if !ce_budget(st) {
        return cover()
    }
    var t = e[0]
    if t == "Int" {
        return cok(vI(dvi(num_text(e[1]))))
    }
    if t == "Ident" {
        var i: I32 = 0
        while i < cenvN.len {
            if seq2(cenvN[i], e[1]) {
                return cok(cenvV[i])
            }
            i += 1
        }
        return cun()
    }
    if t == "Unary" {
        var x = ceval_expr(file, e[2], cenvN, cenvV, st)
        if x[0] != "k" {
            if seq2(x[0], "over") { return x }
            return x
        }
        if x[2][0] != "I" { return cun() }
        return cok(vI(0 - dvi(x[2][1])))
    }
    if t == "Binary" {
        var op = e[1]
        if seq2(op, "AndAnd") { return cun() }
        var l = ceval_expr(file, e[2], cenvN, cenvV, st)
        if l[0] != "k" { return l }
        var r = ceval_expr(file, e[3], cenvN, cenvV, st)
        if r[0] != "k" { return r }
        if or2(l[2][0] != "I", r[2][0] != "I") { return cun() }
        var a = dvi(l[2][1])
        var b2 = dvi(r[2][1])
        if is_cmp_op(op) {
            var rb = false
            if seq2(op, "Lt") { rb = a < b2 }
            if seq2(op, "Gt") { rb = a > b2 }
            if seq2(op, "Le") { rb = a <= b2 }
            if seq2(op, "Ge") { rb = a >= b2 }
            if seq2(op, "Eq") { rb = a == b2 }
            if seq2(op, "Ne") { rb = a != b2 }
            return cok(vB(rb))
        }
        if seq2(op, "Add") { return cok(vI(a + b2)) }
        if seq2(op, "Sub") { return cok(vI(a - b2)) }
        if seq2(op, "Mul") { return cok(vI(a * b2)) }
        if seq2(op, "Div") {
            if b2 == 0 {
                return cun()
            }
            return cok(vI(a / b2))
        }
        return cun()
    }
    if t == "Call" {
        var cal = e[1]
        if cal[0] != "Ident" { return cun() }
        var fnm = cal[1]
        var d = find_decl(file, fnm)
                var known = d.len > 0
        if known {
            known = d[0] == "FnC"
        }
        if !known {
            return cun()
        }
        var ag = e[2]
        var cenvN2 = List[Str]()
        var cenvV2 = List[Str]()
        var ps = d[3]
        var i: I32 = 1
        var ai: I32 = 1
        while i < ps.len {
            var pr = ps[i]
            if pr[0] == "Param" {
                if ai >= ag.len { return cun() }
                var av = ceval_expr(file, ag[ai], cenvN, cenvV, st)
                if av[0] != "k" { return av }
                if av[2][0] != "I" { return cun() }
                cenvN2.push(pr[2])
                cenvV2.push(av[2])
            } else {
                return cun()
            }
            i += 1
            ai += 1
        }
        return ceval_block(file, d[5], cenvN2, cenvV2, st)
    }
    return cun()
}

fn ceval_block(file: List[Str], b: List[Str], cenvN: List[Str], cenvV: List[Str], st: List[Str]) -> List[Str] {
    // "k"+值 = return/尾值;"u" = 无返回(块贯通);"over" = 预算超限(向上传播)
    var n = b.len
    var i: I32 = 1
    while i < n - 1 {
        var st2 = b[i]
        var t = st2[0]
        if t == "Return" {
            if st2[1].len > 1 {
                return ceval_expr(file, st2[1], cenvN, cenvV, st)
            }
            return cun()
        }
        if t == "Expr" {
            var v = ceval_expr(file, st2[1], cenvN, cenvV, st)
            if v[0] != "k" {
                return v
            }
        } else if t == "If" {
            var cv = ceval_expr(file, st2[1], cenvN, cenvV, st)
            if cv[0] != "k" {
                return cv
            }
            var target = st2[2]
            if !truth(cv[2]) {
                target = st2[3]
            }
            if target[0] == "BlockExpr" {
                target = target[1]
            }
            var br = ceval_block(file, target, cenvN, cenvV, st)
            if br[0] != "u" {
                return br
            }
        } else {
            return cun()
        }
        i += 1
    }
    var tl = b[n - 1]
    if seq2(tl[0], "None") && tl.len == 1 {
        return cun()
    }
    return ceval_expr(file, tl, cenvN, cenvV, st)
}

fn cok(v: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push("k")
    r.push("")
    r.push(v)
    return r
}

fn cun() -> List[Str] {
    var r = List[Str]()
    r.push("u")
    return r
}

fn cover() -> List[Str] {
    var r = List[Str]()
    r.push("over")
    return r
}
