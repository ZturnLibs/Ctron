// =====================================================================
// trans_stmt.ct —— 语句与块发射:ct_structs·ct_is_struct·ct_field_ty 用户 struct
// 表;ct_stmts/ct_stmt 全语句发射(含 match 语句臂 R 分支/s 模型/值位 if 三元
// ct_if_value/ct_is_value、ct_block/ct_body/ct_simple/ct_if_stmt)。
// =====================================================================
fn ct_structs(file: List[Str]) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" {
            out.push(d[1])
        }
        i += 1
    }
    return out
}

fn ct_is_struct(file: List[Str], nm: Str) -> Bool {
    return in_list(ct_structs(file), nm)
}

fn ct_field_ty(file: List[Str], sname: Str, fname: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == sname {
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len {
                var f = fs[j]
                if f[2] == fname {
                    return ct_ty_code(f[3], file)
                }
                j += 1
            }
        }
        i += 1
    }
    return "i"
}

// T54:fn 型字段返回码(§6.1 fn 值字段提取):字段为 FnType → 返回型别码;
// 非 fn 字段/未命中 → ""。let 绑定自字段提取的 F/G 码 fn 值据此挂 #fret 侧条目
//(镜像 ct_fn 形参位口径;无此条目则 h(r) 落 "i",链上 resp.body 分派即翻车)
fn ct_fnfield_ret(file: List[Str], sname: Str, fname: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == sname {
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len {
                var f = fs[j]
                if f[2] == fname {
                    if f[3][0] == "FnType" {
                        return ct_ty_code(f[3][2], file)
                    }
                    return ""
                }
                j += 1
            }
        }
        i += 1
    }
    return ""
}

// P0-2:fn 型字段全签码(F<ar>{p1;p2}>r)——直调 h.f(args) 的实参对位/闭包
// 形参码/返回维同源(ct_fsig_code;ct_fnfield_ret 只有返回码,实参面不够)
fn ct_fnfield_fsig(file: List[Str], sname: Str, fname: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == sname {
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len {
                var f = fs[j]
                if f[2] == fname {
                    if f[3][0] == "FnType" {
                        return ct_fsig_code(file, f[3])
                    }
                    return ""
                }
                j += 1
            }
        }
        i += 1
    }
    return ""
}

// ===== Drop 层栈(§6.4 发射面) =====
// env "#dls" 条目 = 层串:层间 ';',层内条目间 ',',条目 = "名@型码"。
// 串恒以 ';' 结尾(除空串);当前层 = 最后一个 ';' 之后的后缀。
fn dls_of(env: List[Str]) -> Str {
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if en.len >= 5 && byte_slice(en, 0, 5) == "#dls:" {
            return byte_slice(en, 5, en.len)
        }
        i += 1
    }
    return ""
}

fn dls_set(env: List[Str], v: Str) -> List[Str] {
    return env_bind(env, "#dls", v)
}

fn dls_push(env: List[Str]) -> List[Str] {
    return dls_set(env, dls_of(env) + ";")
}

fn dls_head(cur: Str) -> Str {
    var cut = -1
    var k: I32 = 0
    while k < cur.len {
        if byte_at(cur, k) == 59 { cut = k }
        k += 1
    }
    if cut >= 0 {
        return byte_slice(cur, 0, cut + 1)
    }
    return ""
}

fn dls_last(cur: Str) -> Str {
    var cut = -1
    var k: I32 = 0
    while k < cur.len {
        if byte_at(cur, k) == 59 { cut = k }
        k += 1
    }
    if cut >= 0 {
        return byte_slice(cur, cut + 1, cur.len)
    }
    return cur
}

// 当前层登记一个 Drop 局部(声明序;发射时逆序)
fn dls_add(env: List[Str], nm: Str, ty: Str) -> List[Str] {
    var cur = dls_of(env)
    var last = dls_last(cur)
    var entry = nm + "@" + ty
    if last != "" { entry = last + "," + entry }
    return dls_set(env, dls_head(cur) + entry)
}

// 逆序发射当前层 drop 调用(声明逆序 = 条目从尾向头)并弹层
fn dls_pop_emit(env: List[Str], file: List[Str]) -> List[Str] {
    var cur = dls_of(env)
    var last = dls_last(cur)
    if last != "" {
        var pos = last.len
        while pos > 0 {
            var comma = -1
            var k: I32 = 0
            while k < pos {
                if byte_at(last, k) == 44 { comma = k }
                k += 1
            }
            var seg = byte_slice(last, comma + 1, pos)
            var at = -1
            var k2: I32 = 0
            while k2 < seg.len {
                if byte_at(seg, k2) == 64 { at = k2 }
                k2 += 1
            }
            if at > 0 {
                var tyn = byte_slice(seg, at + 1, seg.len)
                if tyn.len > 2 && byte_slice(tyn, 0, 2) == "u:" {
                    var cn = byte_slice(seg, 0, at)
                    eln("t_" + byte_slice(tyn, 2, tyn.len) + "__drop(t_" + cn + ");", env)
                    eln("ctron_drop_pop();", env)
                }
            }
            pos = comma
        }
    }
    // 弹层:去掉最后一个 ';'(含其前的当前层)——排他前缀,单层弹至空串
    var cut = -1
    var k3: I32 = 0
    while k3 < cur.len {
        if byte_at(cur, k3) == 59 { cut = k3 }
        k3 += 1
    }
    var rest = ""
    if cut >= 0 { rest = byte_slice(cur, 0, cut) }
    return dls_set(env, rest)
}

// return 路径:穿透所有开层逆序发射(每层内部声明逆序;内层→外层),弹空层栈
fn dls_return_emit(env: List[Str], file: List[Str]) -> List[Str] {
    var cur = dls_of(env)
    while cur.len > 0 {
        var has = false
        var k: I32 = 0
        while k < cur.len {
            if byte_at(cur, k) == 59 { has = true }
            k += 1
        }
        if !has { break }
        env = dls_pop_emit(env, file)
        cur = dls_of(env)
    }
    return env
}

// 块体 Drop 局部扫描:hl 豁免名(提升挂外层)之外,实现 Drop 的 let 一律响亮拒发
fn dls_reject_unhoisted(body: List[Str], env: List[Str], file: List[Str], hl: List[Str], ctx: Str) {
    var i: I32 = 1
    while i < body.len - 1 {
        var st = body[i]
        if st[0] == "Let" && or2(st[2][0] == "PatId", st[2][0] == "PatAgg" && st[2][2][0] == "SubUnit") {
            var nm = st[2][1]
            var inhl = false
            var hk: I32 = 0
            while hk < hl.len {
                var colon = -1
                var k: I32 = 0
                while k < hl[hk].len {
                    if byte_at(hl[hk], k) == 58 && colon == 0 { colon = k }
                    k += 1
                }
                if colon > 0 && byte_slice(hl[hk], 0, colon) == nm { inhl = true }
                hk += 1
            }
            if !inhl {
                var ty = ""
                if st[3][0] != "None" {
                    ty = ct_ty_code(ct_targ_env(st[3], env), file)
                } else {
                    ty = ct_typeof(st[4], env, file)
                }
                if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
                    if has_drop_impl(file, byte_slice(ty, 2, ty.len)) {
                        panic(ctx + ":Drop 局部未支持(移入内层裸块):" + nm)
                    }
                }
            }
        }
        i += 1
    }
}

fn ct_stmts(b: List[Str], env: List[Str], file: List[Str], hl: List[Str], hreg: List[Str]) -> List[Str] {
    var i: I32 = 1
    var env2 = env
    while i < b.len - 1 {
        var st = b[i]
        var skip = false
        if hl != "" && st[0] == "Let" {
            // 提升名:Let 重写为 Assign(声明已提至循环前)
            var pat = st[2]
            var nm = ""
            if pat[0] == "PatId" { nm = pat[1] }
            if pat[0] == "PatAgg" && pat[2][0] == "SubUnit" { nm = pat[1] }
            var hit = false
            var k: I32 = 0
            while k < hl.len {
                var en = hl[k]
                if en.len > nm.len + 1 && byte_slice(en, 0, nm.len) == nm && byte_at(en, nm.len) == 58 {
                    hit = true
                }
                k += 1
            }
            if hit && nm != "" {
                var na = List[Str]()
                na.push("Ident")
                na.push(nm)
                var nas = List[Str]()
                nas.push("Assign")
                nas.push(na)
                nas.push("Eq")
                nas.push(st[4])
                env2 = ct_stmt(nas, env2, file, hreg)
                skip = true
            }
        }
        if !skip {
            env2 = ct_stmt(st, env2, file, hreg)
            // T30 into_gc 型别图侧条目:let x = List[T]()/arena.list[T]() → #elem/#elemsz/#ielem
            if st[0] == "Let" && st[2][0] == "PatId" && st[4][0] == "Call" && st[4][1][0] == "TypeArgs" && st[4][1][2].len > 1 {
                var e30 = ct_ig_elem_code(st[4][1][2][1], file)
                var z30 = "0"
                if e30 == "3" && st[4][1][2][1][0] == "Named" {
                    z30 = "sizeof(" + ct_ctype("u:" + st[4][1][2][1][1]) + ")"
                }
                var ie30 = "1"
                if e30 == "2" {
                    var in30 = st[4][1][2][1]
                    if in30[0] == "TypeArgs" && in30[2].len > 1 {
                        ie30 = ct_ig_elem_code(in30[2][1], file)
                    } else if in30[0] == "Named" && in30[2].len > 1 {
                        ie30 = ct_ig_elem_code(in30[2][1], file)
                    }
                }
                env2 = env_bind(env_bind(env_bind(env2, "#elem:" + st[2][1], e30), "#elemsz:" + st[2][1], z30), "#ielem:" + st[2][1], ie30)
            }
        }
        i += 1
    }
    return env2
}

// T30:into_gc 元素模式码(0=标量槽/1=Str/2=嵌套表/3=struct 盒;深度>2 层编译期拒绝)
fn ct_ig_elem_code(ty: List[Str], file: List[Str]) -> Str {
    if ty[0] == "TypeArgs" {
        var h30 = ty[1]
        if h30[0] == "Named" {
            if seq2(h30[1], "List") { return "2" }
        }
        return "2"
    }
    if ty[0] == "Named" {
        var n30 = ty[1]
        if seq2(n30, "List") { return "2" }
        if or2(seq2(n30, "I32"), or2(seq2(n30, "I64"), or2(seq2(n30, "U32"), or2(seq2(n30, "U64"), or2(seq2(n30, "I8"), or2(seq2(n30, "U8"), or2(seq2(n30, "I16"), or2(seq2(n30, "U16"), or2(seq2(n30, "ISize"), seq2(n30, "USize")))))))))) { return "0" }
        if seq2(n30, "Str") { return "1" }
        if or2(seq2(n30, "Bool"), or2(seq2(n30, "F64"), seq2(n30, "F32"))) { return "0" }
        if ct_is_struct(file, n30) { return "3" }
        return "1"
    }
    return "1"
}

// 块(闭包体/子块位):语句顺序发射;尾槽无 "None" 哨兵时按语句发射
// (语句类尾 = 臂内 return 位,勘定收束②闭包尾同此)
fn ct_block(b: List[Str], env: List[Str], file: List[Str], hreg: List[Str]) -> List[Str] {
    eln("\{", env)
    var denv = dls_push(env)
    var env2 = ct_stmts(b, denv, file, "", hreg)
    // 尾槽:p_block 末元素为裸尾表达式(无 "None" 哨兵时),按语句发射
    var tl = b[b.len - 1]
    if tl[0] != "None" {
        var es = List[Str]()
        es.push("Expr")
        es.push(tl)
        env2 = ct_stmt(es, env2, file, hreg)
    }
    // RAII(§6.4):作用域退出按声明逆序 drop
    env2 = dls_pop_emit(env2, file)
    eln("}", env)
    return env2
}

// fn 体:语句同 ct_block,但尾表达式在非 void fn 中是返回值(Ctron Block 尾值语义;
// 尾槽 match 作值经 t_mr 中转)
// 尾槽是否为值形态(语句类黑名单;Match/If 尾按语句发射 —— 值位 match 仅 fn 尾特判,
// 值位 if 尾挂账)
// 值位 if(§4.6 if 是表达式):两分支均为纯表达式块 → C 三元;否则 panic(文档化)
fn ct_simple(b: List[Str], env: List[Str], file: List[Str]) -> Str {
    if b.len > 2 {
        return ""
    }
    var tl = b[b.len - 1]
    if tl[0] == "None" {
        return ""
    }
    return ct_expr(tl, env, file)
}

fn ct_if_value(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t1 = ct_simple(e[2], env, file)
    if t1 == "" {
        panic("ct_expr:if 值位需纯表达式分支")
        return ""
    }
    var t2 = ""
    if e[3][0] == "If" {
        t2 = ct_if_value(e[3], env, file)
    } else if e[3][0] == "BlockExpr" {
        // p_if 的 else 分支包 BlockExpr(与 then 的裸 Block 不对称)
        t2 = ct_simple(e[3][1], env, file)
    } else {
        t2 = ct_simple(e[3], env, file)
    }
    if t2 == "" {
        panic("ct_expr:if 值位需纯表达式分支")
        return ""
    }
    return "(" + ct_expr(e[1], env, file) + " ? " + t1 + " : " + t2 + ")"
}

// 臂体 void 内建调用判(assert 族/panic/println 无值可 return;R2b 尾位分支守卫)
fn ct_arm_void_call(e: List[Str]) -> Bool {
    if e[0] != "Call" { return false }
    if e[1][0] != "Ident" { return false }
    var n = e[1][1]
    if or2(n == "assert", n == "assert_eq") { return true }
    if or2(n == "assert_ne", n == "panic") { return true }
    if or2(n == "println", n == "print") { return true }
    if n == "flush_out" { return true }
    return false
}

fn ct_is_value(tg: Str) -> Bool {
    if tg == "Match" { return false }
    if tg == "Try" { return false }
    if tg == "If" { return false }
    if tg == "While" { return false }
    if tg == "For" { return false }
    if tg == "Let" { return false }
    if tg == "Assign" { return false }
    if tg == "Return" { return false }
    if tg == "Expr" { return false }
    if tg == "Block" { return false }
    return true
}

// fn 体:语句同 ct_block,但尾表达式在非 void fn 中是返回值(Ctron Block 尾值语义;
// 尾槽语句类节点按语句发射臂内 return 位;R2b ct_match_value 值形死码已撤——
// 不可达:ct_is_value 黑名单先行,勘定收束①)
fn ct_body(b: List[Str], env: List[Str], file: List[Str], rc: Str) -> List[Str] {
    var hreg = List[Str]()
    // P0-A:本 fn 返回码入 env("#fnret")——return 位 N 槽 fn 值调用(mw(…))
    // 的 #fret 侧条目源(List[fn] 索引读槽无声明返回型可查)
    var fenv = env
    if rc != "v" {
        fenv = env_bind(env, "#fnret", rc)
    }
    // P3:泛型实例返回钉——rc = u:Name__<encs> 时绑 "#Name"→rc + 型参名→码
    //(return 位泛型 struct 字面量的期望型源:iter map 族 `RawSeq { src: xs }`
    // 的槽仅 impl 方法引用,字段推不出 → 自注解面取;径A env 预绑同哲学)
    if rc.len > 2 && byte_slice(rc, 0, 2) == "u:" {
        var rinfo = ct_struct_inst_split(rc)
        if rinfo.len > 1 {
            var rbar = 0
            var rii: I32 = 0
            while rii < rinfo.len {
                if byte_at(rinfo, rii) == 124 { rbar = rii }
                rii += 1
            }
            var rnm = byte_slice(rinfo, 0, rbar)
            var rencs = byte_slice(rinfo, rbar + 1, rinfo.len)
            fenv = env_bind(fenv, "#" + rnm, rc)
            var rtps = ct_struct_tps(file, rnm)
            var rcodes = ct_inst_arg_codes(rencs)
            if rtps.len == rcodes.len {
                var rki: I32 = 0
                while rki < rtps.len {
                    fenv = env_bind(fenv, rtps[rki], rcodes[rki])
                    rki += 1
                }
            }
        }
    }
    var p1 = seq2(ct_pass(fenv), "1")
    if !p1 {
        // P0-A:"#nobrace" 位(特化盒槽序言在 ct_body 前直出,花括号由发射位自带)
        if !ct_env_has(fenv, "#nobrace") {
            eln("\{", fenv)
            // T31 M1.5:帧节点序言+#frpro 形参注册(ct_fn/方法/drop 挂入)
            if ct_env_has(fenv, "#frpro") {
                eln(ct_env_ty(fenv, "#frpro"), fenv)
            }
        }
        // P9 栈面全量:"#mspro" 位(morestack 序言检查行,紧随花括号)
        if ct_env_has(fenv, "#mspro") {
            eln(ct_env_ty(fenv, "#mspro"), fenv)
        }
    }
    var denv = dls_push(fenv)
    var env2 = ct_stmts(b, denv, file, "", hreg)
    var tl = b[b.len - 1]
    if p1 {
        // pass1:与 pass2 同构分派,输出由 eln 门控丢弃,仅为 shim/typedef 发现遍历
        if tl[0] != "None" {
            if tl[0] == "Match" {
                ct_expr(tl[1], env2, file)
                var arms1 = tl[2]
                var ai1: I32 = 1
                while ai1 < arms1.len {
                    var ab1 = arms1[ai1][2]
                    if ab1[0] == "BlockExpr" {
                        ct_stmts(ab1[1], fenv, file, "", hreg)
                    }
                    ai1 += 1
                }
            } else if tl[0] == "Own" {
                // own 块尾位:体平铺发现遍历(与 pass2 同构,输出门控丢弃)
                ct_stmts(tl[2], fenv, file, "", hreg)
            } else if or2(rc == "v", !ct_is_value(tl[0])) {
                var es1 = List[Str]()
                es1.push("Expr")
                es1.push(tl)
                ct_stmt(es1, env2, file, hreg)
            } else {
                ct_expr(tl, env2, file)
            }
        }
        return env2
    }
    if tl[0] != "None" {
        // p_block 尾槽 = NL 折叠后紧跟 } 的表达式 —— 完整语句后跟空行也入尾槽,
        // 故语句类尾槽(如末位 match)仍按语句发射(臂内 return 负责退出)
        // RAII(§6.4):尾值先落临时再发 drops(t_rv 沿 t_mr 固定名先例),随后返回
        if or2(rc == "v", !ct_is_value(tl[0])) {
            // R2b 尾标志穿线(spec §4「ct_stmts 尾标志穿线」;#fnret 同款 env 先例):
            // 尾位语句 match 的 OK/ERR 非块值臂经 "#tailpos" 转 return 位——
            // interp 尾位 match 即块值(eval_run 尾槽求值),emit 落空不返回为
            // UB 类分歧(fx_restail 修复面)。SOME/NONE 四臂无条件 return 口径
            // 不变;中位语句无标志维持丢弃+写法纪律(勘定收束③)
            var tenv = env_bind(env2, "#tailpos", "1")
            var es = List[Str]()
            es.push("Expr")
            es.push(tl)
            env2 = ct_stmt(es, tenv, file, hreg)
            env2 = dls_pop_emit(env2, file)
        } else if tl[0] == "Own" {
            // own 块尾位(§4.9):体平铺;own 尾值即块值,体尾 return 已由语句发射退出
            var ocbody3 = tl[2]
            dls_reject_unhoisted(ocbody3, env2, file, List[Str](), "emit:own 块")
            var orenv3 = ct_stmts(ocbody3, env2, file, "", hreg)
            var otl3 = ocbody3[ocbody3.len - 1]
            if otl3[0] != "None" {
                if otl3[0] != "Return" {
                    eln("return " + ct_expr(otl3, orenv3, file) + ";", env)
                }
            }
            env2 = dls_pop_emit(env2, file)
        } else {
            eln(ct_ctype(rc) + " t_rv = " + ct_expr(tl, env2, file) + ";", env)
            var rtv = ct_reg_line("rv", rc)
            if rtv.len > 0 { eln(rtv, env) }
            env2 = dls_pop_emit(env2, file)
            eln("return t_rv;", fenv)
        }
    } else {
        env2 = dls_pop_emit(env2, file)
    }
    if !p1 {
        eln("}", env)
    }
    return env2
}

fn ct_if_stmt(e: List[Str], env: List[Str], file: List[Str], hreg: List[Str]) {
    eln("if (" + ct_expr(e[1], env, file) + ") \{", env)
    ct_block(e[2], env, file, hreg)
    eln("}", env)
    var els = e[3]
    if els[0] != "None" {
        eln("else \{", env)
        if els[0] == "If" {
            ct_if_stmt(els, env, file, hreg)
        } else {
            ct_block(els[1], env, file, hreg)
        }
        eln("}", env)
    }
}

fn ct_stmt(st: List[Str], env: List[Str], file: List[Str], hreg: List[Str]) -> List[Str] {
    var t = st[0]
    if t == "Let" {
        var pat = st[2]
        // Phase 4:scope/with 仅语句位 —— let 初值位按 ANF 展开(值落 t_<名>)
        if pat[0] == "PatId" && st[4][0] == "Scope" {
            var rc4 = "t_" + pat[1]
            var renv4 = ct_emit_scope_stmt(st[4], env, file, rc4, hreg)
            // G-conc:绑定码 = 块值真型(ct_emit_scope_stmt 尾表达式 typeof,
            // "#scopety" 侧条目;旧硬编码 "g"=F32 → to_string/插值落 F64 渲染臂)
            var svt4 = ct_env_ty(renv4, "#scopety:" + rc4)
            if svt4.len == 0 { svt4 = "g" }
            return env_bind(renv4, pat[1], svt4)
        }
        if pat[0] == "PatId" {
            // T33:parallel let —— map 结果=int 槽表(LI;发射 mapL/pmap 恒 ct_i 槽),reduce=标量
            if st[4][0] == "Call" && st[4][1][0] == "Member" && st[4][1][1][0] == "Ident" && st[4][1][1][1] == "parallel" {
                if st[4][1][3] == "map" {
                    eln("ctron_list* t_" + pat[1] + " = " + ct_expr(st[4], env, file) + ";", env)
                    var rlp = ct_reg_line(pat[1], "LI")
                    if rlp.len > 0 { eln(rlp, env) }
                    return env_bind(env, pat[1], "LI")
                }
                if st[4][1][3] == "reduce" {
                    eln("int64_t t_" + pat[1] + " = " + ct_expr(st[4], env, file) + ";", env)
                    return env_bind(env, pat[1], "6")
                }
            }
            // T30:into_gc let —— 返回型=接收者 List 码;真深拷经 trans_expr #elem 分派
            if st[4][0] == "Call" && st[4][1][0] == "Member" && st[4][1][3] == "into_gc" {
                var rot = ct_typeof(st[4][1][1], env, file)
                eln(ct_ctype(rot) + " t_" + pat[1] + " = " + ct_expr(st[4], env, file) + ";", env)
                var rlg = ct_reg_line(pat[1], rot)
                if rlg.len > 0 { eln(rlg, env) }
                return env_bind(env, pat[1], rot)
            }
            if st[4][0] == "Call" {
                if st[4][1][0] == "Member" {
                    if st[4][1][3] == "with" {
                        var objt4 = ct_typeof(st[4][1][1], env, file)
                        if or2(objt4 == "A", objt4.len > 1 && byte_at(objt4, 0) == 109) {
                            var rc4 = "t_" + pat[1]
                            var ty4 = "i"
                            if st[3][0] != "None" {
                                ty4 = ct_ty_code(ct_targ_env(st[3], env), file)
                            }
                            var obj4 = ct_expr(st[4][1][1], env, file)
                            var renv4 = ct_emit_with_stmt(st[4], obj4, objt4, st[4][2][1], env, file, false, rc4, hreg, "1")
                            return env_bind(renv4, pat[1], ty4)
                        }
                    }
                }
            }
        }
        // Phase 5:own 块(透明语义):体平铺,尾值即块值
        if pat[0] == "PatId" && st[4][0] == "Own" {
            var obody = st[4][2]
            dls_reject_unhoisted(obody, env, file, List[Str](), "emit:own 块")
            var orenv = ct_stmts(obody, env, file, "", hreg)
            var otl = obody[obody.len - 1]
            if otl[0] == "None" {
                panic("emit:own 块无值")
                return env
            }
            var oty = ct_typeof(otl, orenv, file)
            var ovx = ct_expr(otl, orenv, file)
            if or2(oty == "L", or2(ct_is_tlcode(oty), oty == "A")) { ovx = "(" + ct_ctype(oty) + ")(" + ovx + ")" }
            eln(ct_ctype(oty) + " t_" + pat[1] + " = " + ovx + ";", env)
            var rlo = ct_reg_line(pat[1], oty)
            if rlo.len > 0 { eln(rlo, env) }
            return env_bind(env, pat[1], oty)
        }
        // P0-G:let x/_ = match R { Ok(v) => v, Err(m) => {…} } —— ANF,目标即临时
        if or2(pat[0] == "PatId", pat[0] == "PatWild") && st[4][0] == "Match" {
            // R1:Option[Str] 值位 match(t_mv NULL 模型;Some 臂值=t_mv,None 臂值
            // 直赋/块体;json.ct write_json 消费形实证)
            if seq2(ct_typeof(st[4][1], env, file), "s") {
                var dn9 = "_d" + nline(st)
                if pat[0] == "PatId" {
                    dn9 = pat[1]
                }
                var mvq9 = "t_mv" + nline(st)
                eln("const char* " + mvq9 + " = (const char*)(" + ct_expr(st[4][1], env, file) + ");", env)
                eln("const char* t_" + dn9 + ";", env)
                var marms9 = st[4][2]
                var mi9: I32 = 1
                var mfirst9 = true
                while mi9 < marms9.len {
                    var ma9 = marms9[mi9]
                    var mpt9 = ma9[1]
                    var mb9 = ma9[2]
                    var mhead9 = "if (" + mvq9 + " != NULL) \{"
                    if !mfirst9 {
                        mhead9 = "else \{"
                    }
                    eln(mhead9, env)
                    var menv9 = env
                    if mpt9[0] == "PatAgg" && mpt9[1] == "Some" {
                        if mpt9[2].len > 1 && mpt9[2][1][0] == "PatId" && mpt9[2][1][1] != "_" {
                            eln("const char* t_" + mpt9[2][1][1] + " = " + mvq9 + ";", env)
                            menv9 = env_bind(menv9, mpt9[2][1][1], "s")
                        }
                        if mb9[0] == "BlockExpr" {
                            ct_block(mb9[1], menv9, file, hreg)
                        } else {
                            eln("t_" + dn9 + " = " + ct_expr(mb9, menv9, file) + ";", menv9)
                        }
                    } else {
                        // None 臂(值/块体;块体含 return 形直发)
                        if mb9[0] == "BlockExpr" {
                            ct_block(mb9[1], menv9, file, hreg)
                        } else {
                            var nvs9 = ct_expr(mb9, menv9, file)
                            if ct_typeof(mb9, menv9, file) == "R" {
                                nvs9 = "ct_optstr_unr(" + nvs9 + ")"
                            }
                            eln("t_" + dn9 + " = " + nvs9 + ";", menv9)
                        }
                    }
                    eln("}", env)
                    mfirst9 = false
                    mi9 += 1
                }
                var rl9 = ct_reg_line(dn9, "s")
                if rl9.len > 0 { eln(rl9, env) }
                return env_bind(env, dn9, "s")
            }
            if ct_typeof(st[4][1], env, file) == "R" {
                var dn7 = "_d" + nline(st)
                if pat[0] == "PatId" {
                    dn7 = pat[1]
                }
                var ruq = nline(st)
                var rme = "t_mrr" + ruq
                eln("ct_res " + rme + " = " + ct_expr(st[4][1], env, file) + ";", env)
                var rmr = ct_reg_line("mrr" + ruq, "R")
                if rmr.len > 0 { eln(rmr, env) }
                var sec = ct_opt_elem_expr(file, st[4][1], env)
                eln(ct_ctype(sec) + " t_" + dn7 + ";", env)
                var rdr = ct_reg_line(dn7, sec)
                if rdr.len > 0 { eln(rdr, env) }
                var rarms = st[4][2]
                var ok7: I32 = -1
                var some7: I32 = -1
                var err7: I32 = -1
                var none7: I32 = -1
                var ri7: I32 = 1
                while ri7 < rarms.len {
                    var rpt7 = rarms[ri7][1]
                    if rpt7[0] == "PatAgg" && rpt7[1] == "Ok" { ok7 = ri7 }
                    if rpt7[0] == "PatAgg" && rpt7[1] == "Some" { some7 = ri7 }
                    if rpt7[0] == "PatAgg" && rpt7[1] == "Err" { err7 = ri7 }
                    if or2(rpt7[0] == "PatId" && rpt7[1] == "None", rpt7[0] == "PatAgg" && rpt7[1] == "None") { none7 = ri7 }
                    ri7 += 1
                }
                var vi7: I32 = -1
                if ok7 >= 0 { vi7 = ok7 }
                if some7 >= 0 {
                    vi7 = some7
                }
                if vi7 >= 0 {
                    var va = rarms[vi7]
                    var vpt = va[1]
                    var vbe = va[2]
                    eln("if (" + rme + ".variant == 0) \{", env)
                    var venv = env
                    if vpt[2].len > 1 && vpt[2][1][0] == "PatId" && vpt[2][1][1] != "_" {
                        // T53:f 载荷位型双关(旧 (double)(long) 值直转双向失真)
                        var pvx8 = "(" + ct_ctype(sec) + ")(long)(" + rme + ".v)"
                        // u: struct 载荷解引用(盒装写侧配对)
                        if sec.len > 2 && byte_slice(sec, 0, 2) == "u:" {
                            pvx8 = "(*(" + ct_ctype(sec) + "*)(long)(" + rme + ".v))"
                        }
                        if sec == "f" {
                            pvx8 = "((union \{ double _d; ct_i _i; })\{ ._i = (ct_i)(" + rme + ".v) })._d"
                        }
                        eln(ct_ctype(sec) + " t_" + vpt[2][1][1] + " = " + pvx8 + ";", env)
                        venv = env_bind(env, vpt[2][1][1], sec)
                    }
                    if vbe[0] == "BlockExpr" {
                        var venv2 = ct_block(vbe[1], venv, file, hreg)
                        eln("t_" + dn7 + " = " + ct_expr(vbe[1][vbe[1].len - 1], venv2, file) + ";", env)
                    } else {
                        eln("t_" + dn7 + " = " + ct_expr(vbe, venv, file) + ";", env)
                    }
                    eln("}", env)
                }
                eln("if (" + rme + ".variant != 0) \{", env)
                var ei7: I32 = -1
                if err7 >= 0 { ei7 = err7 }
                if none7 >= 0 { ei7 = none7 }
                if ei7 >= 0 {
                    var ea = rarms[ei7]
                    var ebe = ea[2]
                    var eenv = env
                    if ea[1][2].len > 1 && ea[1][2][1][0] == "PatId" && ea[1][2][1][1] != "_" {
                        var eec = "s"
                        eln("const char* t_" + ea[1][2][1][1] + " = (const char*)(long)(" + rme + ".v);", env)
                        eenv = env_bind(env, ea[1][2][1][1], eec)
                    }
                    if ebe[0] == "BlockExpr" {
                        ct_block(ebe[1], eenv, file, hreg)
                    } else {
                        eln("t_" + pat[1] + " = " + ct_expr(ebe, eenv, file) + ";", env)
                    }
                }
                eln("}", env)
                if pat[0] == "PatId" {
                    return env_bind(env, pat[1], sec)
                }
                return env
            }
        }
        // Phase 5:let x = expr? —— ct_res 解包 + Err 短路 return(载荷按元素码;T53:f 位型双关)
        if pat[0] == "PatId" && st[4][0] == "Try" {
            var qv = "t_q" + nline(st)
            var ec2 = ct_try_elem(file, st[4], env)
            // R1:? on char*(read_file 族)——Str? 返回 fn 内 NULL 传播
            if seq2(ct_typeof(st[4][1], env, file), "s") {
                if ct_env_has(env, "#fnret") {
                    if seq2(ct_env_ty(env, "#fnret"), "s") {
                        var qs1 = "t_q" + nline(st)
                        eln("const char* " + qs1 + " = (const char*)(" + ct_expr(st[4][1], env, file) + ");", env)
                        eln("if (!" + qs1 + ") \{ return 0; }", env)
                        eln(ct_ctype("s") + " t_" + pat[1] + " = " + qs1 + ";", env)
                        return env_bind(env, pat[1], "s")
                    }
                }
                panic("emit:? on Str? 需 Str? 返回函数(R1 族;Let+Try)")
                return env
            }
            eln("ct_res " + qv + " = " + ct_expr(st[4][1], env, file) + ";", env)
            var rqt = ct_reg_line("q" + nline(st), "R")
            if rqt.len > 0 { eln(rqt, env) }
            // IP-01 W2:? 传播位 AnyError 物化(Let+Try 专用臂同批;语句/表达式位同款)
            var retl = qv
            if ct_env_has(env, "#cerr") {
                if seq2(ct_env_ty(env, "#cerr"), "u:AnyError") {
                    var iecl = ct_err_elem_expr(file, st[4][1], env)
                    if iecl.len > 2 && byte_slice(iecl, 0, 2) == "E:" {
                        var enl = byte_slice(iecl, 2, iecl.len)
                        retl = "(ct_res)\{ 1, (ct_i)ct_anyerr_wrap_e((void*)(long)(" + qv + ".v), \"" + enl + "\", ct_vnames_" + enl + ", 0) }"
                    } else if iecl == "s" {
                        retl = "(ct_res)\{ 1, (ct_i)ct_anyerr_wrap_s((const char*)(long)(" + qv + ".v)) }"
                    }
                }
            }
            eln("if (" + qv + ".variant != 0) \{ return " + retl + "; }", env)
            var vx6 = "(" + ct_ctype(ec2) + ")" + qv + ".v"
            if ec2 == "f" {
                vx6 = "((union \{ double _d; ct_i _i; })\{ ._i = (ct_i)(" + qv + ".v) })._d"
            }
            // u: struct 载荷解引用(盒装写侧配对;T14-③ 同款)
            if ec2.len > 2 && byte_slice(ec2, 0, 2) == "u:" {
                vx6 = "(*(" + ct_ctype(ec2) + "*)(long)" + qv + ".v)"
            }
            eln(ct_ctype(ec2) + " t_" + pat[1] + " = " + vx6 + ";", env)
            return env_bind(env, pat[1], ec2)
        }
        // Phase 4:let (tx, rx) = Channel[T](cap) —— 双名同一 ct_chan*
        if pat[0] == "PatTup" {
            if pat.len == 3 {
                if st[4][0] == "Call" {
                    if st[4][1][0] == "TypeArgs" {
                        if st[4][1][1][0] == "Ident" {
                            if st[4][1][1][1] == "Channel" {
                                var chx = ct_expr(st[4], env, file)
                                var cn1 = pat[1][1]
                                var cn2 = pat[2][1]
                                eln("ct_chan* t_" + cn1 + " = " + chx + ";", env)
                                eln("ct_chan* t_" + cn2 + " = t_" + cn1 + ";", env)
                                // T14-③:struct 元素通道 → rx 码 hR<元素码>(match Ok 臂
                                // 据此解引用);标量元素两半端均 h(行为不变)
                                var rcode = "h"
                                if st[4][1][2].len > 1 {
                                    if st[4][1][2][1][0] == "Named" {
                                        var ec14 = ct_ty_code(ct_targ_env(st[4][1][2][1], env), file)
                                        if ec14.len > 2 && byte_slice(ec14, 0, 2) == "u:" {
                                            rcode = "hR" + ec14
                                        }
                                    }
                                }
                                return env_bind(env_bind(env, cn1, "h"), cn2, rcode)
                            }
                        }
                    }
                }
            }
        }
        // PatId 或 PatAgg-SubUnit(单大写标识符如 var L,解析器按变体模式收,rt 动态当绑定)
        if or2(pat[0] == "PatId", pat[0] == "PatAgg" && pat[2][0] == "SubUnit") {
            var ty = "i"
            if st[3][0] != "None" {
                // P0-A:注解节点经 env 型参代入(ct_targ_env TArgs 下钻)——单态化体
                // 的 `var rs: List[Route[S]]` 嵌套 TPar 旧落 ct_ty_code "i" →
                // Lu:Route__I 错实例(与 #Router 槽/字段码三面劈叉)
                ty = ct_ty_code(ct_targ_env(st[3], env), file)
                // G3-W3:Result/Option 注解 let 挂 #elem(首实参码)——match Ok 臂
                // 载荷槽/expect/or 恢复面从此可达(成员调用 init 无被调声明可查,
                // edbd2703 直驱线之外的注解直驱线)
                if st[3][0] == "Named" && st[3][1] == "Result" || st[3][0] == "Named" && st[3][1] == "Option" {
                    if st[3][2].len > 1 && st[3][2][1].len > 1 {
                        env = env_bind(env, "#elem:" + pat[1], ct_ty_code(st[3][2][1], file))
                    }
                }
            } else {
                ty = ct_typeof(st[4], env, file)
            }
            if ty.len >= 3 && byte_slice(ty, 0, 1) == "a" {
                // G1-T8(W3):Repeat let 初值位——零字面量块特判 memset(F25 正解,
                // 巨型全零字面量的 AST 膨胀自此断根);否则首块展开 + 取模复制循环
                if st[4][0] == "Repeat" {
                    var rp = st[4]
                    var alr = rp[1]
                    var n0r: I64 = (alr.len - 1).as[I64]()
                    var ntr = a_count(ty)
                    var ecc = a_elem(ty)
                    var allzero = true
                    var zi: I32 = 1
                    while zi < alr.len {
                        if or2(alr[zi][0] != "Int", alr[zi][1] != "0") {
                            allzero = false
                        }
                        zi += 1
                    }
                    if allzero && n0r == 1 {
                        eln(ct_ctype(ecc) + " t_" + pat[1] + "[" + ntr + "];", env)
                        eln("memset(t_" + pat[1] + ", 0, sizeof(t_" + pat[1] + "));", env)
                    } else {
                        var accr = ""
                        var jr: I32 = 1
                        while jr < alr.len {
                            if jr > 1 { accr = accr + ", " }
                            if alr[jr][0] == "ArrLit" {
                                accr = accr + ct_arr_lit_braces(alr[jr], env, file)
                            } else {
                                accr = accr + ct_expr(alr[jr], env, file)
                            }
                            jr += 1
                        }
                        eln(ct_ctype(ecc) + " t_" + pat[1] + "[" + ntr + "] = \{" + accr + "};", env)
                        eln("\{ long long _ri = " + n0r.to_string() + "; while (_ri < (long long)(" + ntr + ")) \{ t_" + pat[1] + "[_ri] = t_" + pat[1] + "[_ri % " + n0r.to_string() + "]; _ri += 1; } }", env)
                    }
                    eln("if (ct_frn.pn < 128) \{ ct_frn.pool[ct_frn.pn].addr = (void**)&t_" + pat[1] + "; ct_frn.pool[ct_frn.pn].kind = 1; ct_frn.pool[ct_frn.pn].sz = sizeof(" + ct_ctype(ecc) + "[" + ntr + "]); ct_frn.pn += 1; } else \{ ct_frn.ovf = 1; }", env)
                    return env_bind(env, pat[1], ty)
                }
                // FB-8 返回面:T[N] let 收 a 码表达式(调用返 elem*)→ 声明+memcpy
                //(值收自存储;旧误走 ArrLit 访问把 Args 当元素 → Args@0)
                if st[4][0] != "ArrLit" {
                    var n9 = a_count(ty)
                    var ec9 = ct_ctype(a_elem(ty))
                    eln(ec9 + " t_" + pat[1] + "[" + n9 + "];", env)
                    eln("memcpy(t_" + pat[1] + ", " + ct_expr(st[4], env, file) + ", sizeof(" + ec9 + ") * " + n9 + ");", env)
                    eln("if (ct_frn.pn < 128) \{ ct_frn.pool[ct_frn.pn].addr = (void**)&t_" + pat[1] + "; ct_frn.pool[ct_frn.pn].kind = 1; ct_frn.pool[ct_frn.pn].sz = sizeof(" + ec9 + ") * " + n9 + "; ct_frn.pn += 1; } else \{ ct_frn.ovf = 1; }", env)
                    return env_bind(env, pat[1], ty)
                }
                // 定长数组 let:<elem C 类型> t_<名>[<N>] = { elems };
                var n = a_count(ty)
                var ec = a_elem(ty)
                var al = st[4]
                var acc = ""
                var j: I32 = 1
                while j < al.len {
                    if j > 1 { acc = acc + ", " }
                    // 嵌套数组:内层 ArrLit → C 嵌套花括号字面
                    if al[j][0] == "ArrLit" {
                        acc = acc + ct_arr_lit_braces(al[j], env, file)
                    } else {
                        acc = acc + ct_expr(al[j], env, file)
                    }
                    j += 1
                }
                // 多维声明链:a2a2i → int32_t t_m[2][2](a_elem 逐层剥)
                var dims9 = "[" + n + "]"
                var rest9 = ec
                while rest9.len >= 3 && byte_slice(rest9, 0, 1) == "a" {
                    dims9 = dims9 + "[" + a_count(rest9) + "]"
                    rest9 = a_elem(rest9)
                }
                eln(ct_ctype(rest9) + " t_" + pat[1] + dims9 + " = \{" + acc + "};", env)
                // T31 M1.5:定长数组槽=整块域扫
                eln("if (ct_frn.pn < 128) \{ ct_frn.pool[ct_frn.pn].addr = (void**)&t_" + pat[1] + "; ct_frn.pool[ct_frn.pn].kind = 1; ct_frn.pool[ct_frn.pn].sz = sizeof(" + ct_ctype(rest9) + dims9 + "); ct_frn.pn += 1; } else \{ ct_frn.ovf = 1; }", env)
                return env_bind(env, pat[1], ty)
            }
            if ty.len > 1 && byte_at(ty, 0) == 118 {
                // 切片视图 let(§3.6,P1-D):初值三分支——数组字面量(堆)/内联数组退化/其余直发
                var vt = ct_ctype(ty)
                var vec = ct_ctype(byte_slice(ty, 1, ty.len))
                // G5-W1:Repeat 切片位——堆块 + 首块展开 + 块复制(d[i]=d[i-n0]);
                // 零块 memset 特判(F25 同门)
                if st[4][0] == "Repeat" {
                    var rp5 = st[4]
                    var alr5 = rp5[1]
                    var n05: I64 = (alr5.len - 1).as[I64]()
                    var cnt5 = "1"
                    if rp5[2][0] == "Int" { cnt5 = lit_to_dec(rp5[2][1]) }
                    var allz5 = true
                    var z5: I32 = 1
                    while z5 < alr5.len {
                        if or2(alr5[z5][0] != "Int", alr5[z5][1] != "0") {
                            allz5 = false
                        }
                        z5 += 1
                    }
                    eln(vt + " t_" + pat[1] + ";", env)
                    eln("t_" + pat[1] + ".n = (long long)(" + cnt5 + ") * " + n05.to_string() + ";", env)
                    eln("t_" + pat[1] + ".d = (" + vec + "*)ctron_amalloc(sizeof(" + vec + ") * ((long long)(" + cnt5 + ") * " + n05.to_string() + "));", env)
                    if allz5 {
                        eln("memset(t_" + pat[1] + ".d, 0, sizeof(" + vec + ") * ((long long)(" + cnt5 + ") * " + n05.to_string() + "));", env)
                    } else {
                        var k6: I32 = 1
                        while k6 < alr5.len {
                            eln("t_" + pat[1] + ".d[" + (k6 - 1).to_string() + "] = " + ct_expr(alr5[k6], env, file) + ";", env)
                            k6 += 1
                        }
                        eln("\{ long long _ri = " + n05.to_string() + "; long long _n0 = " + n05.to_string() + "; long long _tot = (long long)(" + cnt5 + ") * _n0; while (_ri < _tot) \{ t_" + pat[1] + ".d[_ri] = t_" + pat[1] + ".d[_ri - _n0]; _ri += 1; } }", env)
                    }
                    return env_bind(env, pat[1], ty)
                }
                if st[4][0] == "ArrLit" {
                    var al2 = st[4]
                    var n2: I32 = al2.len - 1
                    eln(vt + " t_" + pat[1] + ";", env)
                    eln("t_" + pat[1] + ".n = " + n2.to_string() + ";", env)
                    eln("t_" + pat[1] + ".d = (" + vec + "*)ctron_amalloc(sizeof(" + vec + ") * " + n2.to_string() + ");", env)
                    var k5: I32 = 1
                    while k5 < al2.len {
                        eln("t_" + pat[1] + ".d[" + (k5 - 1).to_string() + "] = " + ct_expr(al2[k5], env, file) + ";", env)
                        k5 += 1
                    }
                    return env_bind(env, pat[1], ty)
                }
                if st[4][0] == "Ident" {
                    var ity = ct_env_ty(env, st[4][1])
                    if ity.len >= 3 && byte_at(ity, 0) == 97 {
                        // T[N] → T[] 退化:复合字面量取内联数组首址,写透过(d 指向原存储)
                        eln(vt + " t_" + pat[1] + " = \{ t_" + st[4][1] + ", " + a_count(ity) + " };", env)
                        return env_bind(env, pat[1], ty)
                    }
                }
                eln(vt + " t_" + pat[1] + " = " + ct_expr(st[4], env, file) + ";", env)
                // R 码绑定挂 #elem 侧条目(P0-G;泛型尾位——后位形态块对本形态不可达,
                // Result/Option 载荷查询(.or/.expect/元素码)经此贯通)
                if st[4][0] == "Call" && st[4][1][0] == "Ident" {
                    var gd8 = ct_fn_decl(file, st[4][1][1])
                    if gd8.len > 0 {
                        var elc8 = ct_opt_elem_of(file, gd8[4])
                        if elc8 != "i" {
                            return env_bind(env_bind(env, "#elem:" + pat[1], elc8), pat[1], ty)
                        }
                    }
                }
                return env_bind(env, pat[1], ty)
            }
            if ty.len > 2 && byte_at(ty, 0) == 119 {
                // W 域 let(§3.1 定宽,P1-B2):Int 字面量转十进制(0b/0o 原文非法 C),其余强转
                var vt = ct_ctype(ty)
                var rhs = ""
                if st[4][0] == "Int" {
                    rhs = lit_to_dec(st[4][1])
                } else {
                    rhs = ct_expr(st[4], env, file)
                }
                eln(vt + " t_" + pat[1] + " = (" + vt + ")(" + rhs + ");", env)
                return env_bind(env, pat[1], ty)
            }
            if st[4][0] == "Call" && st[4][1][0] == "Ident" {
                // R 码绑定挂 #elem 侧条目(P0-G):let x = parse(…) 的载荷型别可查。
                // 闸改被调声明直驱(旧 ty=="R" 依赖 ct_typeof 解用户 fn 调用返回,
                // 不达 → #elem 缺 → .or(字面默认) 按 i32 截断,9007199254740993→1)
                var gd7 = ct_fn_decl(file, st[4][1][1])
                if gd7.len > 0 {
                    var elc7 = ct_opt_elem_of(file, gd7[4])
                    if elc7 != "i" {
                        env = env_bind(env, "#elem:" + pat[1], elc7)
                    }
                }
            }
            // G3-W3:成员调用 init(recv_t/join_t 族)+Result/Option 注解 → 注解首
            // 实参码挂 #elem(被调声明直驱线对成员形态不可达;match Ok 臂载荷槽
            // 依赖此条目,缺即 int32 截断指针=段错误)
            if st[4][0] == "Call" && st[4][1][0] == "Member" && st[3][0] == "Named" && st[3][2].len > 1 && st[3][2][1].len > 1 {
                if or2(st[3][1] == "Result", st[3][1] == "Option") {
                    env = env_bind(env, "#elem:" + pat[1], ct_ty_code(st[3][2][1], file))
                }
            }
            // P0-2/seam②:fn 值绑定(F/G 码)且初值为直调声明 fn 时挂 #fret 侧条目——
            // 返回型取该 fn 的 FnType 返回节点(标量/Str/聚合;v/i 不入码,i 即旧形态无差)
            // 此后 <名>(…) 间接调用与链上成员读按 R 原型化(镜像种子 decl_ty_tc 存槽)
            var chf: I32 = byte_at(ty, 0)
            if or2(chf == 70, chf == 71) {
                // P0-A:LF 列表元素签名码("F1{…}>u:Resp",Index 读)——返回码随码
                // 附带,直拆入 #fret(not_found_h[0]/mws[idx] 的 h(…)/mw(…) 即此形)
                // 批C-3 追补:注解位 FnType 节点走全签码(短码 ct_ty_code 恒
                // "F<arity>" 无返回维,ct_fsig_ret 落 "" → #fret 不绑 → fn 值
                // Str/聚合返回塌 ct_i:strcmp 位裸指针 ==/struct 截断);
                // 镜像 1070 直调声明面 ct_fsig_code(file, gd8[4]) 同源
                var fret10 = ct_fsig_ret(ty)
                if st[3][0] == "FnType" {
                    fret10 = ct_fsig_ret(ct_fsig_code(file, st[3]))
                }
                if fret10.len > 0 {
                    if fret10 != "v" {
                        if fret10 != "i" {
                            env = env_bind(env, "#fret:" + pat[1], fret10)
                        }
                    }
                }
                if st[4][0] == "Call" && st[4][1][0] == "Ident" {
                    var gd8 = ct_fn_decl(file, st[4][1][1])
                    if gd8.len > 0 && gd8[4][0] == "FnType" {
                        // P0-A:fn→fn→R 链的 #fret 取最内返回码(签名尾段)
                        var frc8 = ct_fsig_ret(ct_fsig_code(file, gd8[4]))
                        if frc8.len == 0 {
                            frc8 = ct_ty_code(gd8[4][2], file)
                        }
                        if frc8 != "v" {
                            if frc8 != "i" {
                                env = env_bind(env, "#fret:" + pat[1], frc8)
                            }
                        }
                    }
                }
                // G2:裸 fn 引用初值(let g = pick)同挂 #fret——env 短码 "F<arity>"
                // 无返回维,ct_fsig_ret 落 "",调用位返回型塌 ct_i(Str 返回经
                // printf %d 出指针垃圾/strcmp 位裸指针)。返回码取 ct_fn_ret
                //(与 ct_cbtr 蹦床同源;gd[4] 是返回型节点非 FnType,注解形
                // ct_fsig_code 门不适用);u:/聚合返回同式贯通盒指针解盒约定。
                // fx_fnval_str 钉
                if st[4][0] == "Ident" {
                    var gd9 = ct_fn_decl(file, st[4][1])
                    if gd9.len > 0 {
                        var frc9b = ct_fn_ret(file, st[4][1])
                        if frc9b.len > 0 {
                            if frc9b != "v" {
                                if frc9b != "i" {
                                    env = env_bind(env, "#fret:" + pat[1], frc9b)
                                }
                            }
                        }
                    }
                }
                // T54:fn 值字段提取(let h = e.h,字段型 fn(A)->R)同挂 #fret——
                // 此前仅直调初值入码,h(r) 落 "i",链上 resp.body 即翻 Member 兜底
                //(03l/03n 发射臂 Member@26/27 实证);P<内>/B: 接收者剥前缀后同型
                if st[4][0] == "Member" {
                    var bty8 = ct_strip_p(ct_typeof(st[4][1], env, file))
                    if bty8.len > 2 && byte_slice(bty8, 0, 2) == "u:" {
                        var frc9 = ct_fnfield_ret(file, byte_slice(bty8, 2, bty8.len), st[4][3])
                        if frc9.len > 0 {
                            if frc9 != "v" {
                                if frc9 != "i" {
                                    env = env_bind(env, "#fret:" + pat[1], frc9)
                                }
                            }
                        }
                    }
                }
            }
            // 批C-3 径A:fn 注解 let + 闭包初值 → 绑 '#clcodes'(shim 形参码提示,
            // 镜像 StructLit 字段位两处与调用点 'F' 位;W4 勘定「期望签名未穿入
            // 闭包形参 env」的最后一条公开缝:var f: fn(Box[T[M]])->R = |x| {…}
            // 体内泛型调用 M 槽旧塌 __i,与直参/调用位两面劈叉)
            var lenv = env
            if st[4][0] == "Closure" && st[3][0] == "FnType" {
                var lcc30 = ct_fntype_inner(file, ct_targ_env(st[3], env))
                if lcc30.len > 0 {
                    lenv = env_bind(env, "#clcodes", lcc30)
                }
            }
            var rhs = ct_expr(st[4], lenv, file)
            // extern 返回 fn(v0.7 §9.6):声明位装箱——ct_fnK 裸指针 → ct_clop
            //(fn 槽存裸地址,env 恒 0),绑定后经既有 ct_clop 间接调用与回调摘槽路径
            // 统一工作;仅声明位(RHS 为 FnExt 调用)触发,fn 值直赋不二次装箱
            if or2(ty == "F1", or2(ty == "F2", ty == "F3")) {
                if st[4][0] == "Call" && st[4][1][0] == "Ident" {
                    var bnm = st[4][1][1]
                    var bi: I32 = 1
                    while bi < file.len {
                        var bd = file[bi]
                        if bd[0] == "FnExt" && bd[1] == bnm {
                            rhs = "(\{ ct_clop _cbx = (ct_clop)ctron_amalloc(sizeof(ct_clo)); _cbx->fn = (void*)(" + rhs + "); _cbx->env = (void*)1; _cbx; })"
                            bi = file.len
                        }
                        bi += 1
                    }
                }
            }
            if or2(ty == "L", ct_is_tlcode(ty)) { rhs = "(ctron_list*)(" + rhs + ")" }
            if ty == "A" { rhs = "(ctron_cell*)(" + rhs + ")" }
            // R1(Str? NULL 模型族):注解 s + ct_res 构造初值(Some/None)→ unr 适配
            // 落 char*(构造臂恒产 ct_res;init 已是 char* 直通)
            if ty == "s" {
                var rts = ct_typeof(st[4], env, file)
                if rts == "R" {
                    rhs = "ct_optstr_unr(" + rhs + ")"
                }
            }
            eln(ct_ctype(ty) + " t_" + pat[1] + " = " + rhs + ";", env)
            // T31 M1.5:通用绑定位 GC 槽注册(标量族经谓词空返回跳过)
            var rlg2 = ct_reg_line(pat[1], ty)
            if rlg2.len > 0 { eln(rlg2, env) }
            // RAII(§6.4):struct 值绑定实现 Drop → 当前层登记,作用域出口逆序发射
            if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
                if has_drop_impl(file, byte_slice(ty, 2, ty.len)) {
                    eln("ctron_drop_push(ctron_dth_" + byte_slice(ty, 2, ty.len) + ", &t_" + pat[1] + ");", env)
                }
            }
            if ty.len > 2 && byte_slice(ty, 0, 2) == "B:" {
                var bnm = byte_slice(ty, 2, ty.len)
                if bnm.len > 2 && byte_slice(bnm, 0, 2) == "u:" { bnm = ct_struct_name_of(bnm) }
                if has_drop_impl(file, bnm) {
                    panic("emit:类引用 Drop 未支持(§6.4 类引用不触发;eval 统一 U 分歧挂账):" + pat[1])
                }
            }
            if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
                if has_drop_impl(file, byte_slice(ty, 2, ty.len)) {
                    env = dls_add(env, pat[1], ty)
                }
            }
            return env_bind(env, pat[1], ty)
        }
        panic("ct_stmt:let pat:" + pat[0])
        return env
    }
    if t == "Assign" {
        var tgt = st[1]
        // While+Drop 首赋值注册(哨卫一次性;零迭代不注册 = 无幻析构)
        if tgt[0] == "Ident" {
            var wd9 = ct_env_ty(env, "#whdrop:" + tgt[1])
            if wd9.len > 0 {
                var p1 = -1
                var p2 = -1
                var k9: I32 = 0
                while k9 < wd9.len {
                    if byte_at(wd9, k9) == 64 {
                        if p1 < 0 { p1 = k9 } else { p2 = k9 }
                    }
                    k9 += 1
                }
                if p1 > 0 && p2 > p1 {
                    var wcn = byte_slice(wd9, 0, p1)
                    var wdth = byte_slice(wd9, p1 + 1, p2)
                    var wwf = byte_slice(wd9, p2 + 1, wd9.len)
                    eln("if (!" + wwf + ") \{ ctron_drop_push(" + wdth + ", &" + wcn + "); " + wwf + " = 1; }", env)
                }
            }
        }
        if tgt[0] == "Index" {
            // 索引赋值:目标 List/节点,元素槽 char*
            var tc0 = ct_typeof(tgt[1], env, file)
            // T41:切片视图元素复合赋值(+=等)——读改写展开(越界守卫同 Eq;
            // 登记债:视图元素面无溢出守卫帮手,镜像标量 ctron_w_* 族待切)
            if st[2] != "Eq" && tc0.len > 1 && byte_at(tc0, 0) == 118 {
                if tgt[1][0] != "Ident" {
                    panic("ct_stmt:视图索引写接收者限 Ident")
                    return env
                }
                var cop = "+"
                if st[2] == "SubEq" { cop = "-" }
                if st[2] == "MulEq" { cop = "*" }
                if st[2] == "DivEq" { cop = "/" }
                if st[2] == "ModEq" { cop = "%" }
                var iexpr = ct_expr(tgt[2], env, file)
                var lhs = "t_" + tgt[1][1] + ".d[" + iexpr + "]"
                eln("if (" + iexpr + " < 0 || " + iexpr + " >= t_" + tgt[1][1] + ".n) \{ ctron_panic(\"index out of bounds\"); }", env)
                eln(lhs + " = " + ct_arg_cast(ct_typeof(st[3], env, file), byte_slice(tc0, 1, tc0.len), "(" + lhs + " " + cop + " " + ct_expr(st[3], env, file) + ")") + ";", env)
                return env
            }
            if st[2] != "Eq" {
                panic("ct_stmt:index 复合赋值")
                return env
            }
            if tc0.len > 1 && byte_at(tc0, 0) == 118 {
                // 切片视图元素写(§3.6):越界守卫 + d[i] 直写(写透过,镜像 eval 原地)
                if tgt[1][0] != "Ident" {
                    panic("ct_stmt:视图索引写接收者限 Ident")
                    return env
                }
                eln("if (" + ct_expr(tgt[2], env, file) + " < 0 || " + ct_expr(tgt[2], env, file) + " >= t_" + tgt[1][1] + ".n) \{ ctron_panic(\"index out of bounds\"); }", env)
                eln("t_" + tgt[1][1] + ".d[" + ct_expr(tgt[2], env, file) + "] = " + ct_arg_cast(ct_typeof(st[3], env, file), byte_slice(tc0, 1, tc0.len), ct_expr(st[3], env, file)) + ";", env)
                return env
            }
            var tc = ct_typeof(tgt[1], env, file)
            // 定长 C 数组元素写(§四 #7 修复):t_buf[i] 直写 + 声明计数越界守卫;
            // 成员接收者(v0.9 定长数组字段):p.buf[i] → t_p.buf[i]
            if tc.len >= 3 && byte_at(tc, 0) == 97 {
                var acnt = a_count(tc)
                var aec = a_elem(tc)
                var tgtxt = "t_" + tgt[1][1]
                if tgt[1][0] != "Ident" {
                    tgtxt = ct_expr(tgt[1], env, file)
                }
                eln("if (" + ct_expr(tgt[2], env, file) + " < 0 || " + ct_expr(tgt[2], env, file) + " >= " + acnt + ") \{ ctron_panic(\"index out of bounds\"); }", env)
                eln(tgtxt + "[" + ct_expr(tgt[2], env, file) + "] = " + ct_arg_cast(ct_typeof(st[3], env, file), aec, ct_expr(st[3], env, file)) + ";", env)
                return env
            }
            var tv = ct_expr(tgt[1], env, file)
            var vt = ct_typeof(st[3], env, file)
            var vtxt = ct_arg_cast(vt, "s", ct_expr(st[3], env, file))
            if or2(tc == "LI", tc == "L6") {
                // 标量元素槽写(LI=int32/L6=int64):经 long 中转全宽入槽(镜像索引读)
                vtxt = "(const char*)(long)(" + ct_expr(st[3], env, file) + ")"
            }
            eln("((ctron_list*)(" + tv + "))->items[" + ct_expr(tgt[2], env, file) + "] = " + vtxt + ";", env)
            return env
        }
        if tgt[0] == "Member" {
            // struct 字段赋值(v4 挂账解除,with_mut 体依赖):含 P<内> 解引用接收者
            var oft = ct_strip_p(ct_typeof(tgt[1], env, file))
            var isu = oft.len > 2 && byte_slice(oft, 0, 2) == "u:"
            var isb = oft.len > 2 && byte_slice(oft, 0, 2) == "B:"
            if isu || isb {
                // Box 自动解引用字段写(§6.1):接收者为堆 cell 指针,别名共享可见
                var lhs = "(" + ct_expr(tgt[1], env, file) + ")." + tgt[3]
                if isb { lhs = "(" + ct_expr(tgt[1], env, file) + ")->" + tgt[3] }
                var rhs3 = ct_expr(st[3], env, file)
                if st[2] == "Eq" {
                    eln(lhs + " = " + rhs3 + ";", env)
                    return env
                }
                // 复合赋值(field op= rhs):镜像 Ident 路径——6/W/7 域走检查帮手
                var fc = ct_strip_p(ct_typeof(tgt, env, file))
                var hv = ""
                if fc == "6" {
                    if st[2] == "AddEq" { hv = "ctron_i64_add" }
                    if st[2] == "SubEq" { hv = "ctron_i64_sub" }
                    if st[2] == "MulEq" { hv = "ctron_i64_mul" }
                    if st[2] == "DivEq" { hv = "ctron_i64_div" }
                    if st[2] == "ModEq" { hv = "ctron_i64_mod" }
                    if hv != "" {
                        eln(lhs + " = " + hv + "(" + lhs + ", " + rhs3 + ");", env)
                        return env
                    }
                }
                if or2(fc == "7", fc == "z") {
                    if st[2] == "AddEq" { hv = "ctron_u64_add" }
                    if st[2] == "SubEq" { hv = "ctron_u64_sub" }
                    if st[2] == "MulEq" { hv = "ctron_u64_mul" }
                    if st[2] == "DivEq" { hv = "ctron_u64_div" }
                    if st[2] == "ModEq" { hv = "ctron_u64_mod" }
                    if hv != "" {
                        eln(lhs + " = " + hv + "(" + lhs + ", (uint64_t)(" + rhs3 + "));", env)
                        return env
                    }
                }
                if fc.len > 2 && byte_at(fc, 0) == 119 {
                    var wlo = "0"
                    var whi = "255"
                    if fc == "w8s" {
                        wlo = "-128"
                        whi = "127"
                    }
                    if fc == "w16u" {
                        wlo = "0"
                        whi = "65535"
                    }
                    if fc == "w16s" {
                        wlo = "-32768"
                        whi = "32767"
                    }
                    if st[2] == "AddEq" { hv = "ctron_w_add" }
                    if st[2] == "SubEq" { hv = "ctron_w_sub" }
                    if st[2] == "MulEq" { hv = "ctron_w_mul" }
                    if hv != "" {
                        eln(lhs + " = " + hv + "(" + lhs + ", (int32_t)(" + rhs3 + "), " + wlo + ", " + whi + ");", env)
                        return env
                    }
                }
                eln(lhs + " " + ct_aop(st[2]) + " " + rhs3 + ";", env)
                return env
            }
            panic("ct_stmt:struct 字段赋值未支持")
            return env
        }
        var tt = ct_env_ty(env, tgt[1])
        var rhs2 = ct_expr(st[3], env, file)
        // 6 域复合赋值:经溢出检查帮手(镜像 eval;裸 += 发射无检查)
        if tt == "6" {
            var h6 = ""
            if st[2] == "AddEq" { h6 = "ctron_i64_add" }
            if st[2] == "SubEq" { h6 = "ctron_i64_sub" }
            if st[2] == "MulEq" { h6 = "ctron_i64_mul" }
            if st[2] == "DivEq" { h6 = "ctron_i64_div" }
            if st[2] == "ModEq" { h6 = "ctron_i64_mod" }
            if h6 != "" {
                eln("t_" + tgt[1] + " = " + h6 + "(t_" + tgt[1] + ", " + rhs2 + ");", env)
                return env
            }
        }
        // W 域复合赋值(P1-B2):定宽检查帮手
        if tt.len > 2 && byte_at(tt, 0) == 119 {
            var wlo = "0"
            var whi = "255"
            if tt == "w8s" {
                wlo = "-128"
                whi = "127"
            }
            if tt == "w16u" {
                wlo = "0"
                whi = "65535"
            }
            if tt == "w16s" {
                wlo = "-32768"
                whi = "32767"
            }
            var h8 = ""
            if st[2] == "AddEq" { h8 = "ctron_w_add" }
            if st[2] == "SubEq" { h8 = "ctron_w_sub" }
            if st[2] == "MulEq" { h8 = "ctron_w_mul" }
            if h8 != "" {
                eln("t_" + tgt[1] + " = " + h8 + "(t_" + tgt[1] + ", (int32_t)(" + rhs2 + "), " + wlo + ", " + whi + ");", env)
                return env
            }
        }
        // U64/USize 复合赋值(P1-B):uint64_t 检查帮手;"z"(USize)同宽并入(v0.7)
        if or2(tt == "7", tt == "z") {
            var h7 = ""
            if st[2] == "AddEq" { h7 = "ctron_u64_add" }
            if st[2] == "SubEq" { h7 = "ctron_u64_sub" }
            if st[2] == "MulEq" { h7 = "ctron_u64_mul" }
            if st[2] == "DivEq" { h7 = "ctron_u64_div" }
            if st[2] == "ModEq" { h7 = "ctron_u64_mod" }
            if h7 != "" {
                eln("t_" + tgt[1] + " = " + h7 + "(t_" + tgt[1] + ", (uint64_t)(" + rhs2 + "));", env)
                return env
            }
        }
        if tt.len > 1 && byte_at(tt, 0) == 80 {
            // P<内>:with_mut 体参数是内值指针 → 解引用赋值
            eln("(*t_" + tgt[1] + ") " + ct_aop(st[2]) + " " + rhs2 + ";", env)
            return env
        }
        if or2(tt == "L", ct_is_tlcode(tt)) { rhs2 = "(ctron_list*)(" + rhs2 + ")" }
        if tt == "A" { rhs2 = "(ctron_cell*)(" + rhs2 + ")" }
        eln("t_" + tgt[1] + " " + ct_aop(st[2]) + " " + rhs2 + ";", env)
        return env
    }
    if t == "While" {
        // P1-A3(E2071 解除):drop 栈哨兵——循环入口压哨;break/continue 前
        // unwind_mark 弹到哨(越界 Drop 局部析构;零命名,嵌套天然内层优先)。
        // 2026-11-01 门控:仅体含 u: Drop 局部才压哨/消哨(loom 服务器级
        // 长循环无条件压哨 = drop 栈无界增长 OOM 实证;无 Drop 局部循环
        // 零 drop 栈操作,回归主线上代行为)
        var whd = false
        eln("ctron_drop_mark();", env)
        // 顶层 let 提升到循环前声明(零初始化),块内改赋值 —— 兼容语料中
        // "循环外读循环内绑定"的写法(parsetree/sem_chk p_block 尾 guard),
        // 使发射产物可编译;rt 语义下该读路径本不应执行(执行即宿主 abort)。
        // hreg = fn 级已提升登记:同名同型复用声明,异型放弃提升(块内原样声明)
        var body = st[2]
        var cand = ct_hoists(body, env, file)
        var hl = List[Str]()
        var envw = env
        if cand.len > 0 {
            eln("\{", env)
        }
        // FB-7/F14:包装块内同名同型只发首现声明(旧按站点重复发 → C 重定义
        // "redefinition of 't_t'",Loom 生成器语料 t_t×N 实证);后续站点由体内
        // let 的提升赋值面承接
        var wem7 = List[Str]()
        var hi: I32 = 0
        while hi < cand.len {
            var en = cand[hi]
            // FB-9:首冒号切分(nm 无冒号恒正确;旧末冒号对含冒号型码
            // [u:/TP:] 即碎,"t_t:TP" 垃圾声明实证)
            var colon = 0
            var k2: I32 = 0
            while k2 < en.len {
                if byte_at(en, k2) == 58 && colon == 0 { colon = k2 }
                k2 += 1
            }
            var nm = byte_slice(en, 0, colon)
            var ty = byte_slice(en, colon + 1, en.len)
            var prev = ""
            var reg: I32 = 0
            while reg < hreg.len {
                var rn = hreg[reg]
                if rn.len > colon && byte_slice(rn, 0, colon) == nm && byte_at(rn, colon) == 58 {
                    prev = byte_slice(rn, colon + 1, rn.len)
                }
                reg += 1
            }
            var wgot7 = false
            var wq7: I32 = 0
            while wq7 < wem7.len {
                if seq2(wem7[wq7], nm) { wgot7 = true }
                wq7 += 1
            }
            if prev == "" {
                eln(ct_ctype(ty) + " t_" + nm + " = " + ct_zero(ty) + ";", env)
                wem7.push(nm)
                hreg.push(nm + ":" + ty)
                hl.push(nm + ":" + ty)
                envw = env_bind(envw, nm, ty)
                if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
                    if has_drop_impl(file, byte_slice(ty, 2, ty.len)) {
                        // While+Drop(2026-10-31):drop 栈注册移首赋值位(零迭代
                        // 不注册 = 无幻析构);哨卫一次性;env 影条供 Assign 臂取
                        if !whd {
                            whd = true
                            eln("ctron_drop_mark();", env)
                        }
                        envw = env_bind(envw, "#whdrop:" + nm, "t_" + nm + "@ctron_dth_" + byte_slice(ty, 2, ty.len) + "@t_whf_" + nm)
                        eln("int t_whf_" + nm + " = 0;", env)
                    }
                }
            } else {
                if prev == ty {
                    // 同名同型:兄弟块作用域场景下本包装块须自持一份声明;
                    // 但同包装块内只发首现(FB-7:旧按站点重发 = C 重定义),
                    // 后续站点由体内 let 提升赋值承接
                    var wdup7 = false
                    var wq8: I32 = 0
                    while wq8 < wem7.len {
                        if seq2(wem7[wq8], nm) { wdup7 = true }
                        wq8 += 1
                    }
                    if !wdup7 {
                        eln(ct_ctype(ty) + " t_" + nm + " = " + ct_zero(ty) + ";", env)
                        wem7.push(nm)
                    }
                    hl.push(nm + ":" + ty)
                    envw = env_bind(envw, nm, ty)
                }
                // 异型:不提升,块内保持原声明(独立 C 作用域,无冲突)
            }
            hi += 1
        }
        // While+Drop 提升面(2026-10-31):u: Drop 局部已入提升候选
        // (ct_hoists 放行;零初始化 + ctron_drop_push + dls 逆序发射 =
        // 析构一次于外层出口,中间迭代值按 v1 泄漏契约不析构)
        eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
        eln("while (" + ct_expr(st[1], envw, file) + ") \{", env)
        var benv = ct_stmts(body, envw, file, hl, hreg)
        var tl = body[body.len - 1]
        if tl[0] != "None" {
            var es = List[Str]()
            es.push("Expr")
            es.push(tl)
            ct_stmt(es, benv, file, hreg)
        }
        eln("}", env)
        // While+Drop:正常出口析构末值 + 消哨(break/continue 路径已在 unwind_mark 消化)
        if whd {
            eln("ctron_drop_unwind_mark(0);", env)
        }
        eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
        if cand.len > 0 {
            eln("}", env)
        }
        return envw
    }
    if t == "Match" {
        // ct_res 模型(Phase 4):send/recv/join_or 的 Result —— variant 0=Ok/1=Err,
        // 载荷单槽 v(Ok=元素值,Err="task panic"/"ScopeCancelled" 串指针)
        if ct_typeof(st[1], env, file) == "R" {
            var ruq = nline(st)
            var rme = "t_mrr" + ruq
            eln("ct_res " + rme + " = " + ct_expr(st[1], env, file) + ";", env)
            var rarms = st[2]
            var okIx: I32 = -1
            var errIx: I32 = -1
            var someIx: I32 = -1
            var noneIx: I32 = -1
            var ri: I32 = 1
            while ri < rarms.len {
                var rarm = rarms[ri]
                var rpt = rarm[1]
                if rpt[0] == "PatAgg" && rpt[1] == "Ok" { okIx = ri }
                if rpt[0] == "PatAgg" && rpt[1] == "Err" { errIx = ri }
                // Option[Str] NULL 模型(§5):Some/None 臂与 Ok/Err 同走 ct_res
                if rpt[0] == "PatAgg" && rpt[1] == "Some" { someIx = ri }
                if or2(rpt[0] == "PatId" && rpt[1] == "None", rpt[0] == "PatAgg" && rpt[1] == "None") { noneIx = ri }
                ri += 1
            }
            // T14-③:scrutinee 为 struct 元素通道 recv(hR 码)→ 载荷堆盒解引用
            var recvElem = ""
            if st[1][0] == "Call" {
                var scal14 = st[1][1]
                if scal14[0] == "Member" && scal14[2] == "Nm" && scal14[3] == "recv" {
                    if scal14[1][0] == "Ident" {
                        var rc14 = ct_env_ty(env, scal14[1][1])
                        if rc14.len > 4 && byte_slice(rc14, 0, 2) == "hR" {
                            recvElem = byte_slice(rc14, 2, rc14.len)
                        }
                    }
                }
            }
            // 逐 Some/Ok 臂(源序 else-if 链=解释臂首中即断同义)。原单槽扫描
            // (okIx/someIx 后臂覆盖前臂)=多 Ok 臂静默丢臂(嵌套语料咬出),本环
            // 治之。载荷嵌套用户枚举(PatAgg/裸变体 Ident)→ 内层 variant 判
            // (条件内联 cast,镜像 Err 臂 t_mn 链,R2c 同款);PatId → 载荷绑定;
            // PatWild/_ → 直落。臂体语义各保其位:Some=return 位,Ok=合成语句位。
            var sec = ct_opt_elem_expr(file, st[1], env)
            var anySO = false
            var ri3: I32 = 1
            while ri3 < rarms.len {
                var sa2 = rarms[ri3]
                var spt2 = sa2[1]
                var sbe2 = sa2[2]
                if spt2[0] == "PatAgg" && spt2[1] == "Some" {
                    var nested2 = false
                    var npn2 = ""
                    if spt2[2].len > 1 && spt2[2][1][0] == "PatAgg" {
                        nested2 = true
                        npn2 = spt2[2][1][1]
                    }
                    if spt2[2].len > 1 && spt2[2][1][0] == "PatId" {
                        if ct_enum_of_variant(file, spt2[2][1][1]).len > 0 {
                            nested2 = true
                            npn2 = spt2[2][1][1]
                        }
                    }
                    var senv2 = env
                    var headSO = "if ("
                    if anySO {
                        headSO = "else if ("
                    }
                    if nested2 {
                        var nen2 = ct_enum_of_variant(file, npn2)
                        if nen2.len == 0 {
                            panic("ct_stmt:嵌套模式需用户枚举变体")
                            return env
                        }
                        var nidx2 = ct_variant_index(file, nen2, npn2)
                        eln(headSO + rme + ".variant == 0 && ((ct_enum_" + nen2 + "*)(long)" + rme + ".v)->variant == " + nidx2.to_string() + ") \{", env)
                        eln("ct_enum_" + nen2 + "* t_mn = (ct_enum_" + nen2 + "*)(long)" + rme + ".v;", env)
                        if spt2[2][1][0] == "PatAgg" {
                            var npcs2 = ct_variant_pcodes(file, nen2, npn2)
                            var nk2: I32 = 1
                            while nk2 < spt2[2][1][2].len {
                                var nsp2 = spt2[2][1][2][nk2]
                                if nsp2[0] == "PatId" && nsp2[1] != "_" {
                                    var pct2 = npcs2[nk2 - 1]
                                    var pc2 = ct_ctype(pct2)
                                    eln(pc2 + " t_" + nsp2[1] + " = " + ct_unwrap_i(pct2, "t_mn->p[" + (nk2 - 1).to_string() + "]") + ";", env)
                                    senv2 = env_bind(senv2, nsp2[1], pct2)
                                }
                                nk2 += 1
                            }
                        }
                    } else {
                        eln(headSO + rme + ".variant == 0) \{", env)
                        if spt2[2].len > 1 && spt2[2][1][0] == "PatId" && spt2[2][1][1] != "_" {
                            var pvx9 = "(" + ct_ctype(sec) + ")(long)(" + rme + ".v)"
                            if sec.len > 2 && byte_slice(sec, 0, 2) == "u:" {
                                pvx9 = "(*(" + ct_ctype(sec) + "*)(long)(" + rme + ".v))"
                            }
                            if sec == "f" {
                                pvx9 = "((union \{ double _d; ct_i _i; })\{ ._i = (ct_i)(" + rme + ".v) })._d"
                            }
                            eln(ct_ctype(sec) + " t_" + spt2[2][1][1] + " = " + pvx9 + ";", env)
                            senv2 = env_bind(env, spt2[2][1][1], sec)
                        }
                    }
                    if sbe2[0] == "BlockExpr" {
                        ct_block(sbe2[1], senv2, file, hreg)
                    } else {
                        // 非块臂体 = return 值(Some=return 位既有口径)
                        eln("return " + ct_expr(sbe2, senv2, file) + ";", env)
                    }
                    eln("}", env)
                    anySO = true
                }
                ri3 += 1
            }
            ri3 = 1
            while ri3 < rarms.len {
                var oa2 = rarms[ri3]
                var opt2 = oa2[1]
                var obe2 = oa2[2]
                if opt2[0] == "PatAgg" && opt2[1] == "Ok" {
                    var nested3 = false
                    var npn3 = ""
                    if opt2[2].len > 1 && opt2[2][1][0] == "PatAgg" {
                        nested3 = true
                        npn3 = opt2[2][1][1]
                    }
                    if opt2[2].len > 1 && opt2[2][1][0] == "PatId" {
                        if ct_enum_of_variant(file, opt2[2][1][1]).len > 0 {
                            nested3 = true
                            npn3 = opt2[2][1][1]
                        }
                    }
                    var oenv2 = env
                    var headOK = "if ("
                    if anySO {
                        headOK = "else if ("
                    }
                    if nested3 {
                        var nen3 = ct_enum_of_variant(file, npn3)
                        if nen3.len == 0 {
                            panic("ct_stmt:嵌套模式需用户枚举变体")
                            return env
                        }
                        var nidx3 = ct_variant_index(file, nen3, npn3)
                        eln(headOK + rme + ".variant == 0 && ((ct_enum_" + nen3 + "*)(long)" + rme + ".v)->variant == " + nidx3.to_string() + ") \{", env)
                        eln("ct_enum_" + nen3 + "* t_mn = (ct_enum_" + nen3 + "*)(long)" + rme + ".v;", env)
                        if opt2[2][1][0] == "PatAgg" {
                            var npcs3 = ct_variant_pcodes(file, nen3, npn3)
                            var nk3: I32 = 1
                            while nk3 < opt2[2][1][2].len {
                                var nsp3 = opt2[2][1][2][nk3]
                                if nsp3[0] == "PatId" && nsp3[1] != "_" {
                                    var pct3 = npcs3[nk3 - 1]
                                    var pc3 = ct_ctype(pct3)
                                    eln(pc3 + " t_" + nsp3[1] + " = " + ct_unwrap_i(pct3, "t_mn->p[" + (nk3 - 1).to_string() + "]") + ";", env)
                                    oenv2 = env_bind(oenv2, nsp3[1], pct3)
                                }
                                nk3 += 1
                            }
                        }
                    } else {
                        eln(headOK + rme + ".variant == 0) \{", env)
                        if opt2[2].len > 1 && opt2[2][1][0] == "PatId" && opt2[2][1][1] != "_" {
                            var bnm = opt2[2][1][1]
                            if recvElem.len > 0 {
                                eln(ct_ctype(recvElem) + " t_" + bnm + " = *(" + ct_ctype(recvElem) + "*)(long)" + rme + ".v;", env)
                                oenv2 = env_bind(env, bnm, recvElem)
                            } else {
                                // T53:载荷码恢复(#elem/被调声明首参);f 位型双关,
                                // 6/7 整宽直槽;i 码保持原行(零扰动回落)
                                var sec9 = ct_opt_elem_expr(file, st[1], env)
                                if or2(sec9 == "f", or2(sec9 == "6", sec9 == "7")) {
                                    var vx9 = "(" + ct_ctype(sec9) + ")(long)" + rme + ".v"
                                    if sec9 == "f" {
                                        vx9 = "((union \{ double _d; ct_i _i; })\{ ._i = (ct_i)(" + rme + ".v) })._d"
                                    }
                                    eln(ct_ctype(sec9) + " t_" + bnm + " = " + vx9 + ";", env)
                                    oenv2 = env_bind(env, bnm, sec9)
                                } else {
                                    // u: struct 载荷解引用绑(盒装写侧配对)
                                    if sec9.len > 2 && byte_slice(sec9, 0, 2) == "u:" {
                                        eln(ct_ctype(sec9) + " t_" + bnm + " = *(" + ct_ctype(sec9) + "*)(long)" + rme + ".v;", env)
                                        oenv2 = env_bind(env, bnm, sec9)
                                    } else {
                                        eln("int32_t t_" + bnm + " = (int32_t)" + rme + ".v;", env)
                                        oenv2 = env_bind(env, bnm, "i")
                                    }
                                }
                            }
                        }
                    }
                    if obe2[0] == "BlockExpr" {
                        ct_block(obe2[1], oenv2, file, hreg)
                    } else {
                        // 非块臂体三分支:①尾位(#tailpos)void 臂(assert/assert_eq/
                        // panic/println 族与用户 void fn,ct_typeof=v 判)→ 委派
                        // ct_stmt 语句位专道;②尾位值臂 → return 位(interp 尾位
                        // match 即块值,R2b (d) 修复:emit 落空不返回为 UB 类分歧);
                        // ③中位(无标志)→ 合成 Expr 语句委派,丢弃口径(勘定③)
                        var okv = ""
                        if ct_env_has(oenv2, "#tailpos") {
                            okv = ct_typeof(obe2, oenv2, file)
                        }
                        if ct_env_has(oenv2, "#tailpos") && or2(okv == "v", ct_arm_void_call(obe2)) {
                            var obe21 = List[Str]()
                            obe21.push("Expr")
                            obe21.push(obe2)
                            ct_stmt(obe21, oenv2, file, hreg)
                        } else if ct_env_has(oenv2, "#tailpos") {
                            eln("return " + ct_expr(obe2, oenv2, file) + ";", env)
                        } else {
                            // 非块臂体 = 合成 Expr 语句委派 ct_stmt(match 语句位丢弃臂值;
                            // assert/assert_eq 族复用语句位专道;IP-01 W2 随批解锁)
                            var obe21 = List[Str]()
                            obe21.push("Expr")
                            obe21.push(obe2)
                            ct_stmt(obe21, oenv2, file, hreg)
                        }
                    }
                    eln("}", env)
                    anySO = true
                }
                ri3 += 1
            }
            if errIx >= 0 {
                if anySO {
                    eln("else \{", env)
                } else {
                    eln("if (" + rme + ".variant != 0) \{", env)
                }
                // 逐 Err 臂:嵌套用户枚举(PatAgg/裸变体 Ident) → t_mn variant 链;
                // PatId(非变体名) → char* 绑定;PatWild → 直落。穷尽性由 sem E2030 保证。
                var firstE = true
                var mnDeclared = false
                var ri2: I32 = 1
                while ri2 < rarms.len {
                    var ea = rarms[ri2]
                    var ept = ea[1]
                    var ebe = ea[2]
                    if ept[0] == "PatAgg" && ept[1] == "Err" {
                        var nested = false
                        var npn = ""
                        if ept[2].len > 1 && ept[2][1][0] == "PatAgg" {
                            nested = true
                            npn = ept[2][1][1]
                        }
                        if ept[2].len > 1 && ept[2][1][0] == "PatId" {
                            if ct_enum_of_variant(file, ept[2][1][1]).len > 0 {
                                nested = true
                                npn = ept[2][1][1]
                            }
                        }
                        var eenv = env
                        var armHead = ""
                        if firstE { armHead = "if (" } else { armHead = "else if (" }
                        if nested {
                            var nen = ct_enum_of_variant(file, npn)
                            if nen.len == 0 {
                                panic("ct_stmt:嵌套模式需用户枚举变体")
                                return env
                            }
                            if !mnDeclared {
                                eln("ct_enum_" + nen + "* t_mn = (ct_enum_" + nen + "*)(long)" + rme + ".v;", env)
                                mnDeclared = true
                            }
                            var nidx = ct_variant_index(file, nen, npn)
                            eln(armHead + "t_mn->variant == " + nidx.to_string() + ") \{", env)
                            if ept[2][1][0] == "PatAgg" {
                                var npcs = ct_variant_pcodes(file, nen, npn)
                                var nk: I32 = 1
                                while nk < ept[2][1][2].len {
                                    var nsp = ept[2][1][2][nk]
                                    if nsp[0] == "PatId" && nsp[1] != "_" {
                                        var pct = npcs[nk - 1]
                                        var pc = ct_ctype(pct)
                                        eln(pc + " t_" + nsp[1] + " = " + ct_unwrap_i(pct, "t_mn->p[" + (nk - 1).to_string() + "]") + ";", env)
                                        eenv = env_bind(eenv, nsp[1], pct)
                                    }
                                    nk += 1
                                }
                            }
                        } else {
                            if ept[2].len > 1 && ept[2][1][0] == "PatId" && ept[2][1][1] != "_" {
                                eln("const char* t_" + ept[2][1][1] + " = (const char*)" + rme + ".v;", env)
                                eenv = env_bind(env, ept[2][1][1], "s")
                            }
                            eln(armHead + rme + ".variant != 0) \{", env)
                        }
                        if ebe[0] == "BlockExpr" {
                            ct_block(ebe[1], eenv, file, hreg)
                        } else {
                            // 非块臂体三分支:同 Ok 臂(尾位 void 臂委派专道/尾位值臂
                            // return 位 R2b (d)/中位 Expr 委派丢弃口径)
                            var ekv = ""
                            if ct_env_has(eenv, "#tailpos") {
                                ekv = ct_typeof(ebe, eenv, file)
                            }
                            if ct_env_has(eenv, "#tailpos") && or2(ekv == "v", ct_arm_void_call(ebe)) {
                                var ebe1 = List[Str]()
                                ebe1.push("Expr")
                                ebe1.push(ebe)
                                ct_stmt(ebe1, eenv, file, hreg)
                            } else if ct_env_has(eenv, "#tailpos") {
                                eln("return " + ct_expr(ebe, eenv, file) + ";", env)
                            } else {
                                // 非块臂体 = 合成 Expr 语句委派 ct_stmt(assert 族专道复用)
                                var ebe1 = List[Str]()
                                ebe1.push("Expr")
                                ebe1.push(ebe)
                                ct_stmt(ebe1, eenv, file, hreg)
                            }
                        }
                        eln("}", env)
                        firstE = false
                    }
                    ri2 += 1
                }
                eln("}", env)
            }
            // G-opti:none 臂消费(语句位 Option match)——noneIx 旧只检测不发射
            //(fx_opti32 take_opt(None)/fx_opti32b relay d-none 实红:None 臂块
            // 整个丢失,interp 侧照走 → 双制分歧)。非块臂守 SOME/NONE return 位
            // 既有口径(W2a 勘定);Err 与 None 按 Option/Result 型互斥不共存。
            if noneIx >= 0 {
                if anySO {
                    eln("else \{", env)
                } else {
                    eln("if (" + rme + ".variant != 0) \{", env)
                }
                var armN = rarms[noneIx]
                var nbe = armN[2]
                if nbe[0] == "BlockExpr" {
                    ct_block(nbe[1], env, file, hreg)
                } else {
                    eln("return " + ct_expr(nbe, env, file) + ";", env)
                }
                eln("}", env)
            }
            return env
        }
        // 用户枚举模型(Phase 5):variant 下标 if/else 链 + 载荷槽绑定
        var menm = ct_env_ename(ct_typeof(st[1], env, file))
        if menm.len > 0 {
            var meuq = nline(st)
            var me = "t_me" + meuq
            eln("ct_enum_" + menm + " " + me + " = " + ct_expr(st[1], env, file) + ";", env)
            var m_arms = st[2]
            var mi2: I32 = 1
            var firsta = true
            while mi2 < m_arms.len {
                var ma = m_arms[mi2]
                var mpt = ma[1]
                var mvn = mpt[1]
                var vidx2 = ct_variant_index(file, menm, mvn)
                var vpcs2 = ct_variant_pcodes(file, menm, mvn)
                if firsta {
                    eln("if (" + me + ".variant == " + vidx2.to_string() + ") \{", env)
                    firsta = false
                } else {
                    eln("else if (" + me + ".variant == " + vidx2.to_string() + ") \{", env)
                }
                var aenv = env
                if mpt[2][0] == "SubTup" {
                    var sk: I32 = 1
                    while sk < mpt[2].len {
                        var sp = mpt[2][sk]
                        if sp[0] == "PatId" && sp[1] != "_" {
                            var pct = vpcs2[sk - 1]
                            var pc = ct_ctype(pct)
                            if !or2(pct == "i", or2(pct == "b", pct == "6")) {
                                eln(pc + " t_" + sp[1] + " = " + ct_unwrap_i(pct, me + ".p[" + (sk - 1).to_string() + "]") + ";", env)
                            } else {
                                eln(pc + " t_" + sp[1] + " = " + ct_unwrap_i(pct, me + ".p[" + (sk - 1).to_string() + "]") + ";", env)
                            }
                            aenv = env_bind(aenv, sp[1], pct)
                        }
                        sk += 1
                    }
                }
                var abe = ma[2]
                if abe[0] == "BlockExpr" {
                    ct_block(abe[1], aenv, file, hreg)
                } else {
                    panic("ct_stmt:enum match arm body")
                    return env
                }
                eln("}", env)
                mi2 += 1
            }
            return env
        }
        // 元组模式 match(裸 (a,b) 臂):旁观式求值一次入临时;TP 元素码解箱镜像
        // Member t.<k>(装箱 list:Str 直存/标量 long 解箱/u: 堆盒解引用;浮点槽
        // 沿用构造点 fail-closed)。v0=单臂解构(元组无变体,穷尽=单臂全盖);
        // 守卫/嵌套模式在册
        var mtc = ct_typeof(st[1], env, file)
        if mtc.len > 3 && byte_slice(mtc, 0, 3) == "TP:" {
            var muq = nline(st)
            var mtv = "t_mt" + muq
            eln("ctron_list* " + mtv + " = (ctron_list*)(" + ct_expr(st[1], env, file) + ");", env)
            var mt_arms = st[2]
            if mt_arms.len != 2 {
                panic("emit:元组 match 多臂未支持(v0 单臂解构)")
                return env
            }
            var mta = mt_arms[1]
            var mtp = mta[1]
            if mtp[0] != "PatTup" {
                panic("emit:元组 match 臂须 PatTup")
                return env
            }
            var tenv = env
            var tk: I32 = 1
            while tk < mtp.len {
                var tsp = mtp[tk]
                if tsp[0] == "PatId" && tsp[1] != "_" {
                    var tec = ct_tp_elem(mtc, (tk - 1).to_string())
                    if tec == "s" {
                        eln("const char* t_" + tsp[1] + " = (const char*)" + mtv + "->items[" + (tk - 1).to_string() + "];", env)
                    } else if tec.len > 2 && byte_slice(tec, 0, 2) == "u:" {
                        eln(ct_ctype(tec) + " t_" + tsp[1] + " = (*(" + ct_ctype(tec) + "*)" + mtv + "->items[" + (tk - 1).to_string() + "]);", env)
                    } else if or2(tec == "f", tec == "g") {
                        panic("emit:元组浮点槽未支持(登记债)")
                        return env
                    } else {
                        eln(ct_ctype(tec) + " t_" + tsp[1] + " = (" + ct_ctype(tec) + ")(long)" + mtv + "->items[" + (tk - 1).to_string() + "];", env)
                    }
                    tenv = env_bind(tenv, tsp[1], tec)
                }
                tk += 1
            }
            var mtb = mta[2]
            if mtb[0] == "BlockExpr" {
                ct_block(mtb[1], tenv, file, hreg)
            } else {
                panic("ct_stmt:元组 match arm body")
                return env
            }
            return env
        }
        // Option[Str] 模型:read_file → char*(NULL=None);t_mv 随 nline 唯一化
        //(R1 前单 match 每函数限制,多 Option[Str] match 重定义实证)
        var mvq = "t_mv" + nline(st)
        eln("const char* " + mvq + " = (const char*)(" + ct_expr(st[1], env, file) + ");", env)
        var arms = st[2]
        var someIx: I32 = -1
        var noneIx: I32 = -1
        var mi: I32 = 1
        while mi < arms.len {
            var arm = arms[mi]
            var pt = arm[1]
            if pt[0] == "PatAgg" && pt[1] == "Some" { someIx = mi }
            if pt[0] == "PatAgg" && pt[1] == "None" { noneIx = mi }
            mi += 1
        }
        if someIx < 0 && noneIx < 0 {
            panic("ct_stmt:match pat")
            return env
        }
        if someIx >= 0 {
            var armS = arms[someIx]
            var pt = armS[1]
            var be = armS[2]
            eln("if (" + mvq + " != NULL) \{", env)
            var env3 = env
            if pt[2][0] == "SubTup" {
                var b0 = pt[2][1]
                if b0[0] == "PatId" {
                    eln("const char* t_" + b0[1] + " = " + mvq + ";", env)
                    env3 = env_bind(env3, b0[1], "s")
                }
            }
            if be[0] == "BlockExpr" {
                ct_block(be[1], env3, file, hreg)
            } else {
                // 非块臂体 = return 值(同上)
                eln("return " + ct_expr(be, env3, file) + ";", env)
            }
            eln("}", env)
        }
        if noneIx >= 0 {
            var armN = arms[noneIx]
            var be2 = armN[2]
            if someIx >= 0 {
                eln("else \{", env)
            } else {
                eln("if (" + mvq + " == NULL) \{", env)
            }
            if be2[0] == "BlockExpr" {
                ct_block(be2[1], env, file, hreg)
            } else {
                // 非块臂体 = return 值(同上)
                eln("return " + ct_expr(be2, env, file) + ";", env)
            }
            eln("}", env)
        }
        return env
    }
    if t == "For" {
        var pat = st[1]
        var it = st[2]
        var body = st[3]
        // P1-A3(E2071 解除):drop 栈哨兵(同 While)
        eln("ctron_drop_mark();", env)
        if pat[0] != "PatId" {
            panic("ct_stmt:for pat:" + pat[0])
            return env
        }
        var v0 = pat[1]
        if it[0] == "Range" {
            // for x in lo..hi / lo..=hi:循环变量 int64_t(rt 同宽语义)
            var incl = it[1]
            var lo = ct_expr(it[2], env, file)
            var hi = ct_expr(it[3], env, file)
            var op2 = " < "
            if incl == "true" { op2 = " <= " }
            eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
            eln("for (int64_t t_" + v0 + " = " + lo + "; t_" + v0 + op2 + hi + "; t_" + v0 + "++) \{", env)
            ct_block(body, env_bind(env, v0, "i"), file, hreg)
            eln("}", env)
            eln("ctron_drop_pop();", env)
            eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
            return env
        }
        var ity = ct_typeof(it, env, file)
        if ity == "LI" {
            // for x in List[I32]:槽经 long 取标量。
            // P3:匿名 C 块包裹 t_li(块作用域天然唯一——同 fn 双 List for-in
            // 旧固定名 t_li/ctron_i 即重定义 cc 错;ctron_i 本就 for 内作用域)
            var larr = ct_expr(it, env, file)
            eln("\{ ctron_list* t_li = (ctron_list*)(" + larr + ");", env)
            var rli = ct_reg_line("li", "L")
            if rli.len > 0 { eln(rli, env) }
            eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
            eln("for (int64_t ctron_i = 0; ctron_i < t_li->n; ctron_i++) \{", env)
            eln("    int32_t t_" + v0 + " = (int32_t)(long)t_li->items[ctron_i];", env)
            ct_block(body, env_bind(env, v0, "i"), file, hreg)
            eln("} }", env)
            eln("ctron_drop_pop();", env)
            eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
            return env
        }
        // T25 v2:for x in List[I64](L6;keys()/values() I64 槽消费面)——
        // 槽经 long 取 int64,镜像 LI 臂(旧无臂 panic,在册缺口同批销)
        if ity == "L6" {
            var larr6 = ct_expr(it, env, file)
            eln("\{ ctron_list* t_li = (ctron_list*)(" + larr6 + ");", env)
            var rli6 = ct_reg_line("li", "L")
            if rli6.len > 0 { eln(rli6, env) }
            eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
            eln("for (int64_t ctron_i = 0; ctron_i < t_li->n; ctron_i++) \{", env)
            eln("    int64_t t_" + v0 + " = (int64_t)(long)t_li->items[ctron_i];", env)
            ct_block(body, env_bind(env, v0, "6"), file, hreg)
            eln("} }", env)
            eln("ctron_drop_pop();", env)
            eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
            return env
        }
        if ity.len > 1 && byte_at(ity, 0) == 118 {
            // for x in <切片视图>(§4.6):计数循环遍历 d[0..n)
            if it[0] != "Ident" {
                panic("ct_stmt:for 视图迭代限 Ident")
                return env
            }
            eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
            eln("for (int64_t ctron_i = 0; ctron_i < t_" + it[1] + ".n; ctron_i++) \{", env)
            eln("    " + ct_ctype(byte_slice(ity, 1, ity.len)) + " t_" + v0 + " = t_" + it[1] + ".d[ctron_i];", env)
            ct_block(body, env_bind(env, v0, "i"), file, hreg)
            eln("}", env)
            eln("ctron_drop_pop();", env)
            eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
            return env
        }
        if ity.len >= 3 && byte_slice(ity, 0, 1) == "a" {
            // for x in <定长数组>:按 env 长度编码展开
            var n = byte_slice(ity, 1, ity.len - 1)
            var ec = byte_slice(ity, ity.len - 1, ity.len)
            var arr = ct_expr(it, env, file)
            eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
            eln("for (int64_t ctron_i = 0; ctron_i < " + n + "; ctron_i++) \{", env)
            eln("    " + ct_ctype(ec) + " t_" + v0 + " = " + arr + "[ctron_i];", env)
            ct_block(body, env_bind(env, v0, ec), file, hreg)
            eln("}", env)
            eln("ctron_drop_pop();", env)
            eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
            return env
        }
        if or2(ity == "L", ct_is_lcode(ity)) {
            // for x in <List>(T14-②:L=char* 槽直取 Str;Lu:=堆盒解引用取 struct 值)
            var larrL = ct_expr(it, env, file)
            var ecodeL = "s"
            var getL = "(const char*)t_ll->items[ctron_i]"
            if ct_is_lcode(ity) {
                ecodeL = byte_slice(ity, 1, ity.len)
                getL = "(*(" + ct_ctype(ecodeL) + "*)t_ll->items[ctron_i])"
            }
            eln("ctron_list* t_ll = (ctron_list*)(" + larrL + ");", env)
            var rll = ct_reg_line("ll", "L")
            if rll.len > 0 { eln(rll, env) }
            eln("if (ct_frn.spn < 32) \{ ct_frn.sv[ct_frn.spn] = ct_frn.pn; ct_frn.spn += 1; }", env)
            eln("for (int64_t ctron_i = 0; ctron_i < t_ll->n; ctron_i++) \{", env)
            eln("    " + ct_ctype(ecodeL) + " t_" + v0 + " = " + getL + ";", env)
            ct_block(body, env_bind(env, v0, ecodeL), file, hreg)
            eln("}", env)
            eln("ctron_drop_pop();", env)
            eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
            return env
        }
        panic("ct_stmt:for iter:" + it[0])
        return env
    }
    if or2(t == "Break", t == "Continue") {
        // P1-A3(E2071 解除):越界 Drop 局部清理——unwind 到循环体入口的
        // drop 栈标记(自举 RAII = ctron_drop_push 动态栈;与 Rust 镜像
        // 静态逆序析构同语义),再走池保存栈恢复与直映跳转
        if t == "Break" { eln("ctron_drop_unwind_mark(0);", env) } else { eln("ctron_drop_unwind_mark(1);", env) }
        // v0.7 修订二:直映 C break;/continue;(E2070/E2072 检查面把关合法性;
        // E2071 已解除——越界 Drop 清理由上方 unwind_mark(哨兵)承接)
        // T31 S4①:跳出/续跳弹池保存栈(环合恢复配对;break 跳过环合时防陈旧保存值误缩活槽)
        eln("if (ct_frn.spn > 0) \{ ct_frn.pn = ct_frn.sv[ct_frn.spn - 1]; ct_frn.spn -= 1; }", env)
        if t == "Break" {
            eln("break;", env)
        } else {
            eln("continue;", env)
        }
        return env
    }
    if t == "Return" {
        // RAII(§6.4):return 穿透所有开层,逆序补发各层 drops(内层→外层)
        env = dls_return_emit(env, file)
        // test 块内用户 return:eval 语义 = 提前退出且通过(仅断言失败判负,镜像 run_tests)
        if seq2(ct_env_ty(env, "#intest"), "1") {
            eln("return 0;", env)
            return env
        }
        // Phase 4:spawn shim 体内 return → 写任务结果 + return 0;fnptr 闭包 → return (ct_i)
        if seq2(ct_env_ty(env, "#shim"), "1") {
            if st[1][0] == "None" {
                eln("return 0;", env)
                return env
            }
            var rv1 = ct_expr(st[1], env, file)
            var rt1 = ct_typeof(st[1], env, file)
            if or2(rt1 == "s", rt1 == "N") {
                eln("ct_task_self()->result = (ct_i)(long)(" + rv1 + ");", env)
            } else {
                eln("ct_task_self()->result = (ct_i)(" + rv1 + ");", env)
            }
            eln("return 0;", env)
            return env
        }
        if seq2(ct_env_ty(env, "#shim"), "2") {
            if st[1][0] == "None" {
                eln("return 0;", env)
                return env
            }
            // T55:显式 return 经 ct_clo_ret_line——u: 走 union 低 8 字节式
            //(探针/中间件体 return Resp{…} / return next(r) 皆此臂)
            // with/with_mut return 位同主干 ANF 前置(r3a bump:闭包体 return m.with 形;
            // #shim=2 早于主干 return 臂,漏接即 ct_expr 落「仅语句位」panic)
            if st[1][0] == "Call" {
                if st[1][1][0] == "Member" {
                    if or2(st[1][1][3] == "with", st[1][1][3] == "with_mut") {
                        var robjt2 = ct_typeof(st[1][1][1], env, file)
                        if or2(robjt2 == "A", robjt2.len > 1 && byte_at(robjt2, 0) == 109) {
                            var rismut2 = st[1][1][3] == "with_mut"
                            var rinner2 = "i"
                            if robjt2.len > 1 && byte_at(robjt2, 0) == 109 {
                                rinner2 = byte_slice(robjt2, 1, robjt2.len)
                            }
                            var rcl2 = st[1][2][1]
                            var rtname2 = "t_wret" + nline(st)
                            var robj2 = ct_expr(st[1][1][1], env, file)
                            ct_emit_with_stmt(st[1], robj2, robjt2, rcl2, env, file, rismut2, rtname2, hreg, "1")
                            eln(ct_clo_ret_line(rinner2, rtname2), env)
                            return env
                        }
                    }
                }
            }
            var rv2 = ct_expr(st[1], env, file)
            var rt2 = ct_typeof(st[1], env, file)
            eln(ct_clo_ret_line(rt2, rv2), env)
            return env
        }
        if st[1][0] == "None" {
            eln("return;", env)
            return env
        }
        // P0-2:返回位闭包形参码注入——#retfn(ct_fn 绑的返回 FnType 内参码串)
        // 临时改绑 #clcodes,作用域仅限本返回表达式(ct_emit_clov 消费;§4.7 适配)
        var renv = env
        if ct_env_has(env, "#retfn") {
            var rcc = ct_env_ty(env, "#retfn")
            if rcc.len > 0 {
                renv = env_bind(env, "#clcodes", rcc)
            }
        }
        // P0-A:N 槽 fn 值调用位 #fret 注入——run_chain 的 `return mw(…)`:mw 自
        // List[fn] 索引读("N" 槽,声明返回型不可查),返回码取 #fnret(本 fn 返回)
        if st[1][0] == "Call" {
            if st[1][1][0] == "Ident" {
                if ct_env_has(env, st[1][1][1]) {
                    if seq2(ct_env_ty(env, st[1][1][1]), "N") {
                        if ct_env_has(env, "#fnret") {
                            var fnr = ct_env_ty(env, "#fnret")
                            if fnr != "i" {
                                if fnr != "v" {
                                    renv = env_bind(renv, "#fret:" + st[1][1][1], fnr)
                                }
                            }
                        }
                    }
                }
            }
        }
        // P0-A:return 位 with/with_mut(ANF 前置)——eval 口径闭包值即表达式值,
        // 语句位 rc="" 丢弃合法,返回位须落临时再返回;web.guard lim_hit 即此形
        if st[1][0] == "Call" {
            if st[1][1][0] == "Member" {
                if or2(st[1][1][3] == "with", st[1][1][3] == "with_mut") {
                    var robjt = ct_typeof(st[1][1][1], env, file)
                    if or2(robjt == "A", robjt.len > 1 && byte_at(robjt, 0) == 109) {
                        var rismut = st[1][1][3] == "with_mut"
                        var rinner = "i"
                        if robjt.len > 1 && byte_at(robjt, 0) == 109 {
                            rinner = byte_slice(robjt, 1, robjt.len)
                        }
                        var rcl = st[1][2][1]
                        var rtname = "t_wret" + nline(st)
                        var robj = ct_expr(st[1][1][1], env, file)
                        ct_emit_with_stmt(st[1], robj, robjt, rcl, env, file, rismut, rtname, hreg, "1")
                        eln("return " + rtname + ";", env)
                        return env
                    }
                }
            }
        }
        // FB-8 返回面:T[N] 返回 = amalloc 拷贝出指针(镜像 ct_clo_ret_line u:
        // 堆盒式;调用方 elem* 接,GC 管理;旧直返形参指针=调用点临时悬垂)
        if ct_env_has(env, "#fnret") {
            var frt8 = ct_env_ty(env, "#fnret")
            if frt8.len >= 3 && byte_slice(frt8, 0, 1) == "a" && st[1][0] != "None" {
                var rex8 = ct_expr(st[1], renv, file)
                var rn8 = a_count(frt8)
                var re8 = ct_ctype(a_elem(frt8))
                var rdims8 = ""
                var rrc8 = frt8
                while rrc8.len >= 3 && byte_slice(rrc8, 0, 1) == "a" {
                    rdims8 = rdims8 + "[" + a_count(rrc8) + "]"
                    rrc8 = a_elem(rrc8)
                }
                var rp8 = ct_ctype(rrc8) + "*"
                eln("return (\{ " + rp8 + " t_rn8 = (" + rp8 + ")ctron_amalloc(sizeof(" + ct_ctype(rrc8) + rdims8 + ")); memcpy(t_rn8, " + rex8 + ", sizeof(" + ct_ctype(rrc8) + rdims8 + ")); t_rn8; });", env)
                return env
            }
        }
        // R1(Str? NULL 模型族):#fnret="s" 且返回值表达式为 ct_res 构造(Some/None)
        // → ct_optstr_unr 适配落 char*(注解翻转后 fn 签名=char*,构造臂仍产 ct_res)
        if ct_env_has(env, "#fnret") {
            if seq2(ct_env_ty(env, "#fnret"), "s") {
                var rt9 = ct_typeof(st[1], renv, file)
                if rt9 == "R" {
                    eln("return ct_optstr_unr(" + ct_expr(st[1], renv, file) + ");", env)
                    return env
                }
            }
        }
        eln("return " + ct_expr(st[1], renv, file) + ";", env)
        return env
    }
    if t == "Expr" {
        var e = st[1]
        // Phase 4:语句位 scope / with / with_mut(ANF,无中间值)
        if e[0] == "Scope" {
            var senv2 = ct_emit_scope_stmt(e, env, file, "", hreg)
            return env
        }
        if e[0] == "Own" {
            var ocbody = e[2]
            dls_reject_unhoisted(ocbody, env, file, List[Str](), "emit:own 块")
            var orenv2 = ct_stmts(ocbody, env, file, "", hreg)
            var otl2 = ocbody[ocbody.len - 1]
            if otl2[0] != "None" {
                eln(ct_expr(otl2, orenv2, file) + ";", env)
            }
            return env
        }
        if e[0] == "Try" {
            var qv2 = "t_q" + nline(st)
            // R1:? on char*(read_file 族)——Str? 返回 fn 内 NULL 传播(语句位)
            if seq2(ct_typeof(e[1], env, file), "s") {
                if ct_env_has(env, "#fnret") {
                    if seq2(ct_env_ty(env, "#fnret"), "s") {
                        eln("\{ const char* " + qv2 + " = (const char*)(" + ct_expr(e[1], env, file) + "); if (!" + qv2 + ") \{ return 0; } }", env)
                        return env
                    }
                }
                panic("emit:? on Str? 需 Str? 返回函数(R1 族;语句位)")
                return env
            }
            eln("ct_res " + qv2 + " = " + ct_expr(e[1], env, file) + ";", env)
            // IP-01 W2:? 传播位 AnyError 物化——外层 #cerr=u:AnyError 且操作数错误侧
            // 为枚举/Str 时包 ctron_anyerr(枚举=名表取码;直通形态余面在册)
            var retx = qv2
            if ct_env_has(env, "#cerr") {
                if seq2(ct_env_ty(env, "#cerr"), "u:AnyError") {
                    var iec = ct_err_elem_expr(file, e[1], env)
                    if iec.len > 2 && byte_slice(iec, 0, 2) == "E:" {
                        var en1 = byte_slice(iec, 2, iec.len)
                        retx = "(ct_res)\{ 1, (ct_i)ct_anyerr_wrap_e((void*)(long)(" + qv2 + ".v), \"" + en1 + "\", ct_vnames_" + en1 + ", 0) }"
                    } else if iec == "s" {
                        retx = "(ct_res)\{ 1, (ct_i)ct_anyerr_wrap_s((const char*)(long)(" + qv2 + ".v)) }"
                    }
                }
            }
            eln("if (" + qv2 + ".variant != 0) \{ return " + retx + "; }", env)
            return env
        }
        if e[0] == "Call" {
            if e[1][0] == "Member" {
                if or2(e[1][3] == "with", e[1][3] == "with_mut") {
                    var objt5 = ct_typeof(e[1][1], env, file)
                    if or2(objt5 == "A", objt5.len > 1 && byte_at(objt5, 0) == 109) {
                        var obj5 = ct_expr(e[1][1], env, file)
                        var wenv2 = ct_emit_with_stmt(e, obj5, objt5, e[2][1], env, file, e[1][3] == "with_mut", "", hreg, "1")
                        return env
                    }
                }
            }
        }
        if e[0] == "If" {
            ct_if_stmt(e, env, file, hreg)
            return env
        }
        if e[0] == "Match" {
            ct_stmt(e, env, file, hreg)
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "assert" && e[2].len == 2 {
            // rt assert 失败 panic 退出(对齐 interp 臂 assert_fail 消息;
            // 旧静默 return 1 = 登记的「失败消息丢失」债,消息走 stderr+fflush)
            eln("if (!(" + ct_expr(e[2][1], env, file) + ")) \{ ctron_panic(\"assert failed\"); }", env)
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "assert_eq" && e[2].len == 3 {
            var a0 = e[2][1]
            var a1 = e[2][2]
            var cmp = ""
            var at0 = ct_typeof(a0, env, file)
            if or2(at0 == "s", at0 == "N") {
                cmp = "(strcmp((const char*)(" + ct_expr(a0, env, file) + "), (const char*)(" + ct_expr(a1, env, file) + ")) == 0)"
            } else {
                cmp = "((" + ct_expr(a0, env, file) + ") == (" + ct_expr(a1, env, file) + "))"
            }
            eln("if (!" + cmp + ") \{ ctron_panic(\"assert_eq failed\"); }", env)
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "println" {
            var at = ct_typeof(e[2][1], env, file)
            if or2(at == "s", at == "N") {
                eln("printf(\"%s" + bs() + "n\", (const char*)(" + ct_expr(e[2][1], env, file) + "));", env)
                return env
            }
            if at == "b" {
                eln("printf(\"%s" + bs() + "n\", " + ct_expr(e[2][1], env, file) + " ? \"true\" : \"false\");", env)
                return env
            }
            if or2(at == "f", at == "g") {
                // rt fmt_val:整值 %.1f,否则 %g(实参三次文本展开,仅限简单表达式);
                // "g"(float)经变参默认提升为 double,同型打印
                var fx = ct_expr(e[2][1], env, file)
                eln("printf((" + fx + " == (double)(long long)(" + fx + ")) ? \"%.1f" + bs() + "n\" : \"%g" + bs() + "n\", " + fx + ");", env)
                return env
            }
            if at == "6" {
                eln("printf(\"%lld" + bs() + "n\", (long long)(" + ct_expr(e[2][1], env, file) + "));", env)
                return env
            }
            eln("printf(\"%d" + bs() + "n\", (int)(" + ct_expr(e[2][1], env, file) + "));", env)
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "print" {
            var at = ct_typeof(e[2][1], env, file)
            if or2(at == "s", at == "N") {
                eln("printf(\"%s\", (const char*)(" + ct_expr(e[2][1], env, file) + "));", env)
                return env
            }
            if at == "b" {
                eln("printf(\"%s\", " + ct_expr(e[2][1], env, file) + " ? \"true\" : \"false\");", env)
                return env
            }
            eln("printf(\"%d\", (int)(" + ct_expr(e[2][1], env, file) + "));", env)
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "eprint" {
            // §9 stderr 面(语句位):Str 直写宿主 stderr,与表达式位同形
            eln("fprintf(stderr, \"%s\", (const char*)(" + ct_expr(e[2][1], env, file) + "));", env)
            return env
        }
        eln(ct_expr(e, env, file) + ";", env)
        return env
    }
    // If 语句:此前无路由,shim 体 If 语句触发 panic 写入 C(SL-0.6-⑰ 探针)
    if t == "If" {
        ct_if_stmt(st, env, file, hreg)
        return env
    }
    panic("ct_stmt:" + t)
    return env
}
