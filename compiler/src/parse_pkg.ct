// =====================================================================
// parse_pkg.ct —— 模块加载器 v0(§2):use 节点结构化 → pkg_dir_of 包路径展开
// 读取 src 下模块文件 → 整模块合并(滤除 Use)→ 可见性检查(E2020)→ 栈式循环
// 检测(E5020);pkg_check_caps/pkg_caps_allowed 能力声明核对(E4010)。
// =====================================================================
// ---------------- 模块加载器 v0(§2):use 解析 → 可见性 → 整模块合并 → 循环检测 ----------------
fn pkg_dir_of(path: Str) -> Str {
    var i = path.len - 1
    while i >= 0 {
        if byte_at(path, i) == 47 {
            return byte_slice(path, 0, i)
        }
        i -= 1
    }
    return "."
}

// std.*/stdweb.* 导入:stdlib 未实现跳过加载;stdweb 为内建命名空间,由 sem 按档位解析(§9.2)
fn segs_std(d: List[Str]) -> Bool {
    if d[0] != "Use" {
        return false
    }
    var segs = d[1]
    if segs.len < 2 {
        return false
    }
    return or2(seq2(segs[1], "std"), seq2(segs[1], "stdweb"))
}

fn pkg_check_caps(mf: List[Str], dir: Str, diags: List[Str]) {
    // E4010(§8.2):use std.<key>.<Name>(key ∈ {fs,time,net,db}) 且本文件有 &Name 参数,
    // 而 Ctron.toml [caps] 未声明该 key
    var i: I32 = 1
    while i < mf.len {
        var d = mf[i]
        if d[0] == "Use" {
            var segs = d[1]
            var symsN = d[2]
            // caps 键提取(2026-09-23 推广):std.<key> 取 segs[2];域顶层命名空间
            // (net/db 挂顶层)取 segs[1]。gui/http 无 cap 键,成员测试自然过滤。
            var cap = ""
            if segs.len > 2 && seq2(segs[1], "std") {
                cap = segs[2]
            } else if segs.len > 1 {
                cap = segs[1]
            }
            if cap.len > 0 {
                if or2(or2(seq2(cap, "fs"), seq2(cap, "time")), or2(seq2(cap, "net"), seq2(cap, "db"))) {
                    var name = ""
                    if symsN.len > 1 {
                        name = symsN[1]
                    } else {
                        if segs.len > 3 {
                            name = segs[3]
                        }
                    }
                    if name.len > 0 {
                        var hit = false
                        var j: I32 = 1
                        while j < mf.len && !hit {
                            var dd = mf[j]
                            if dd[0] == "Fn" {
                                var ps = dd[3]
                                var q: I32 = 1
                                while q < ps.len {
                                    var pr = ps[q]
                                    if pr[0] == "Param" {
                                        var pt = pr[3]
                                        if pt[0] == "Ref" {
                                            if pt[1][0] == "Named" {
                                                if seq2(pt[1][1], name) {
                                                    hit = true
                                                }
                                            }
                                        }
                                    }
                                    q += 1
                                }
                            }
                            j += 1
                        }
                        if hit && !pkg_caps_allowed(dir, cap) {
                            diag2(diags, "E4010", "", cap, name)
                        }
                    }
                }
            }
        }
        i += 1
    }
}

// CTCL 清单 caps 提取(v1;规范 config-language-v1 §4/§5):
// 在 Ctron.ctcl 中定位 caps 键(键首词边界 + = [),收集引号词判定成员。
// 注:phase-1 仅面向规范形态清单(无块外干扰);fail-closed 诊断由 C/Rust 线与 tools 承担。
fn pkg_ctcl_at(t: Str, i: I32, key: Str) -> Bool {
    var k: I32 = 0
    while k < key.len {
        if or2(i + k >= t.len, byte_at(t, i + k) != byte_at(key, k)) {
            return false
        }
        k += 1
    }
    return true
}

fn pkg_ctcl_pre(t: Str, i: I32) -> Bool {
    if i == 0 {
        return true
    }
    var p = byte_at(t, i - 1)
    if or2(or2(p >= 97 && p <= 122, p == 95), p >= 48 && p <= 57) {
        return false
    }
    return true
}

fn pkg_caps_allowed(dir: Str, cap: Str) -> Bool {
    var t = ""
    match read_file(dir + "/../Ctron.ctcl") {
        Some(x) => {
            t = x
        }
        None => {
            return true
        }
    }
    var i: I32 = 0
    while i < t.len {
        if pkg_ctcl_at(t, i, "caps") && pkg_ctcl_pre(t, i) {
            var j = i + 4
            while j < t.len && byte_at(t, j) == 32 {
                j += 1
            }
            if j < t.len && byte_at(t, j) == 61 {
                j += 1
                while j < t.len && byte_at(t, j) == 32 {
                    j += 1
                }
                if j < t.len && byte_at(t, j) == 91 {
                    j += 1
                    while j < t.len && byte_at(t, j) != 93 {
                        if byte_at(t, j) == 34 {
                            var nm = ""
                            j += 1
                            while j < t.len && byte_at(t, j) != 34 {
                                nm = nm + byte_slice(t, j, j + 1)
                                j += 1
                            }
                            j += 1
                            if seq2(nm, cap) {
                                return true
                            }
                        } else {
                            j += 1
                        }
                    }
                    return false
                }
            }
        }
        i += 1
    }
    return false
}

// pkg_exe_dir —— 取可执行文件所在目录(无分隔符则空串;与 pkg_dir_of 的 "." 缺省区分)
fn pkg_exe_dir(exe: Str) -> Str {
    var i = exe.len - 1
    while i >= 0 {
        if byte_at(exe, i) == 47 {
            return byte_slice(exe, 0, i)
        }
        i -= 1
    }
    return ""
}

// pkg_std_installed —— std 是否处于"装机/显式指路"态:①CTRON_STDPATH 已设,或
// ②exe 旁 ../lib/ctron/std 实存(探测 str.ct)。两者皆否(种子/源码树回落态)为 false,
// 使③回落路径缺失维持静默(种子语料兼容;std.iter/stdweb 等 sem 内建命名空间不误伤)。
fn pkg_std_installed(dir: Str) -> Bool {
    if env_get("CTRON_STDPATH").len > 0 {
        return true
    }
    var exe = ctron_exe_path()
    if exe.len > 0 {
        var root = pkg_exe_dir(exe) + "/../lib/ctron/std"
        if fs_exists(root + "/str.ct") {
            return true
        }
    }
    return false
}

// pkg_std_root —— std 根三级查找:①CTRON_STDPATH ②exe 旁 ../lib/ctron/std ③回落 ../std(种子约定)
fn pkg_std_root(dir: Str) -> Str {
    var envp = env_get("CTRON_STDPATH")
    if envp.len > 0 {
        return envp
    }
    var exe = ctron_exe_path()
    if exe.len > 0 {
        var root = pkg_exe_dir(exe) + "/../lib/ctron/std"
        if fs_exists(root + "/str.ct") {
            return root
        }
    }
    return dir + "/../std"
}

fn pkg_load_use(file: List[Str], dir: Str, stack: List[Str], diags: List[Str]) -> List[Str] {
    return pkg_load_use_done(file, dir, stack, List[Str](), diags)
}

// 名槽 decl 种类(与 E5030 dup 检查面一致;spec §4.2 P1b 精化口径)
fn pkg_is_named_kind(t: Str) -> Bool {
    return or2(t == "Fn", or2(t == "FnPub", or2(t == "Struct", or2(t == "Enum", or2(t == "FnExt", or2(t == "Static", t == "Const"))))))
}

// 引用收集:形态表驱动,S 槽收集、N 槽递归;未知标签/非法槽/超深 → false(保守信号)
fn pkg_refs_walk(d: List[Str], ktags: List[Str], kshapes: List[Str], acc: List[Str], depth: I32) -> Bool {
    if depth > 4000 { return false }
    var sh = ast_shape(ktags, kshapes, d[0])
    if sh == "?" { return false }
    var i: I32 = 1
    while i < d.len {
        var kind = ast_kind(sh, i - 1)
        if kind == "S" {
            acc.push(d[i])
        } else {
            if kind == "N" {
                if !pkg_refs_walk(d[i], ktags, kshapes, acc, depth + 1) { return false }
            } else {
                return false
            }
        }
        i += 1
    }
    return true
}

// done = 已合并模块路径集(菱形/共享依赖第二次引用时整体跳过,防 E5030 重复;
// stack 只承"展开中"路径 —— 菱形非环,E5020 仅真环)
fn pkg_load_use_done(file: List[Str], dir: Str, stack: List[Str], done: List[Str], diags: List[Str]) -> List[Str] {
    pkg_check_caps(file, dir, diags)
    if diags.len > 0 {
        return file
    }
    var out = file
    var i: I32 = 1
    while i < out.len {
        var d = out[i]
        if d[0] == "Use" {
            // 节点形态:[Use, Segs, Syms];std.* → 入口包旁的 std/ 目录(种子约定)
            var isstd = segs_std(d)
            var segs = d[1]
            var symsN = d[2]
            var syms = List[Str]()
            var k: I32 = 1
            while k < symsN.len {
                syms.push(symsN[k])
                k += 1
            }
            if syms.len == 0 {
                // 空组兜底:保持交替对不变式(name,alias 同名),下游步长 2 对读不越界
                syms.push(segs[segs.len - 1])
                syms.push(segs[segs.len - 1])
            }
            var mpath = ""
            if isstd {
                mpath = pkg_std_root(dir)
                var j2: I32 = 2
                while j2 < segs.len {
                    mpath = mpath + "/" + segs[j2]
                    j2 += 1
                }
                mpath = mpath + ".ct"
                if !fs_exists(mpath) {
                    if pkg_std_installed(dir) {
                        // W8901:装机/显式指路态下 std 模块缺失(驱动 W/E 同视 rc=1——
                        // use std.* 而 std 缺失本就无从编译,响亮失败;③回落缺失不在此列,维持静默)
                        diags.push("W8901: std 模块缺失:" + mpath + "(安装损坏或 CTRON_STDPATH 配错)")
                        return out
                    }
                }
            } else {
                var rel = ""
                var j2b: I32 = 2
                while j2b < segs.len {
                    rel = rel + "/" + segs[j2b]
                    j2b += 1
                }
                mpath = dir + rel + ".ct"
                // 域根(2026-09-23 顶层命名空间):libroot(= std 根父目录)下
                // <首段>[/<次段>…].ct 命中则用之(gui.* / net.* / http.* / tls.* /
                // db.*;段映射镜像 std 分支,门面 = 域同名 .ct)。目录相对优先、
                // ctart 仍保底——realdep/S2a 既有语义零扰动;未命中保持静默。
                if !fs_exists(mpath) {
                    var sroot = pkg_std_root(dir)
                    if sroot.len > 0 {
                        var cut: I32 = 0 - 1
                        var ci: I32 = sroot.len - 1
                        while ci >= 0 {
                            if byte_at(sroot, ci) == 47 {
                                cut = ci
                                break
                            }
                            ci -= 1
                        }
                        if cut > 0 {
                            var dpath = byte_slice(sroot, 0, cut)
                            var j2c: I32 = 1
                            while j2c < segs.len {
                                dpath = dpath + "/" + segs[j2c]
                                j2c += 1
                            }
                            dpath = dpath + ".ct"
                            if fs_exists(dpath) {
                                mpath = dpath
                            }
                        }
                    }
                }
                // S2a 闭源工件回落:源缺失时消费 deps/<pkg>.ctart/impl<rel>.ast
                // (spec §7.2 deps/ 布局;可见性/E5030 合并对加载后的 decl 同判)
                if !fs_exists(mpath) {
                    var apath = dir + "/deps/" + segs[1] + ".ctart/impl" + rel + ".ast"
                    if fs_exists(apath) {
                        mpath = apath
                    }
                }
            }
            if in_list(done, mpath) {
                // 已合并(菱形/共享):剔除本 Use 重扫,零重复
                var nm3 = mk("File")
                var j3: I32 = 1
                while j3 < out.len {
                    if j3 != i {
                        nm3.push(out[j3])
                    }
                    j3 += 1
                }
                out = nm3
                i = 1
                continue
            }
            if in_list(stack, mpath) {
                diag1(diags, "E5020.circ", "", mpath)
                return out
            }
            var src = read_file(mpath)
            match src {
                Some(ms) => {
                        var mf = List[Str]()
                        var is_ast = mpath.len >= 4
                        if is_ast {
                            if byte_at(mpath, mpath.len - 4) == 46 {
                                is_ast = byte_slice(mpath, mpath.len - 4, mpath.len) == ".ast"
                            } else {
                                is_ast = false
                            }
                        }
                        if is_ast {
                            // .ctast 工件模块:免 parse 直载(S2a;坏流显式越界失败)
                            var acur = Atomic[I32](0)
                            mf = ast_load_node(ms, acur)
                        } else {
                        var toks2 = List[Str]()
                        var lns2 = List[Str]()
                        var cols2 = List[Str]()
                        var pd2 = List[Str]()
                        scan4(ms, toks2, lns2, cols2, pd2)
                        var cur2 = Atomic[I32](0)
                        mf = p_file(toks2, cur2, lns2, cols2, pd2)
                        }
                        pkg_check_caps(mf, dir, diags)
                        // 可见性:请求符号必须存在且为 pub(v0:FnPub)。
                        // P1a:syms 为交替对(name,alias),步长 2 对读;可见性按本名 sn 判
                            var k3: I32 = 0
                            while k3 < syms.len {
                                var sn = syms[k3]
                                var _al = syms[k3 + 1]
                                var found = false
                                var vis = false
                                var m2: I32 = 1
                                while m2 < mf.len {
                                    var md = mf[m2]
                                    if md.len > 1 && md[1] == sn {
                                        found = true
                                        if md[0] == "FnPub" { vis = true }
                                        // SL-0.7:pub struct/enum/extern——解析器在节点
                                        // 尾槽追加 "pub"(镜像 fn 的 anm/stamp 尾槽模式)
                                        if md.len > 2 {
                                            if md[md.len - 1] == "pub" {
                                                if or2(md[0] == "Struct", or2(md[0] == "Enum", md[0] == "FnExt")) {
                                                    vis = true
                                                }
                                            }
                                        }
                                    }
                                    m2 += 1
                                }
                            if !found {
                                diag1(diags, "E2020.use.miss", "", sn)
                            } else if !vis {
                                diag1(diags, "E2020.use.priv", "", sn)
                            }
                            k3 += 2
                        }
                        // E5035:别名与本文件已有 decl 撞名(spec §4.4;P1a 先查入口面,
                        // 合并流内撞名由既有 E5030 兜底)
                        var k8: I32 = 0
                        while k8 < syms.len {
                            if syms[k8 + 1] != syms[k8] {
                                var m9: I32 = 1
                                while m9 < out.len {
                                    if out[m9].len > 1 && out[m9][1] == syms[k8 + 1] {
                                        diag1(diags, "E5035", "", syms[k8 + 1])
                                        return out
                                    }
                                    m9 += 1
                                }
                            }
                            k8 += 2
                        }
                        if diags.len > 0 {
                            return out
                        }
                        var stack2 = stack
                        stack2.push(mpath)
                        mf = pkg_load_use_done(mf, dir, stack2, done, diags)
                        if diags.len > 0 {
                            return out
                        }
                        // —— 选择性合并(spec §4.2):7-kind = 请求 ∪ 闭包;非 7-kind 恒随;
                        //    遍历失败/未知形态 → 保守整模块(= P1a 行为)——
                        var ktags = List[Str]()
                        var kshapes = List[Str]()
                        ast_tables(ktags, kshapes)
                        var keep = List[Str]()
                        var k9: I32 = 0
                        while k9 < syms.len {
                            keep.push(syms[k9])
                            k9 += 2
                        }
                        var refs_ok = true
                        var grow = true
                        while grow {
                            grow = false
                            var acc = List[Str]()
                            var j9: I32 = 1
                            while j9 < mf.len {
                                // 遍历面 = 将随合并走的 decl(非 Use;7-kind 须在 keep):
                                // Test/Impl/Method 恒随,其体引用的 decl 若不入 keep 即悬空
                                // (E2020;收紧审计第一轮:stdpkg/geom_str 实红),故一并收集
                                var carry = false
                                if mf[j9][0] != "Use" {
                                    carry = true
                                    if pkg_is_named_kind(mf[j9][0]) {
                                        carry = false
                                        var ka: I32 = 0
                                        while ka < keep.len {
                                            if keep[ka] == mf[j9][1] { carry = true }
                                            ka += 1
                                        }
                                    }
                                }
                                if carry {
                                    if !pkg_refs_walk(mf[j9], ktags, kshapes, acc, 0) { refs_ok = false }
                                }
                                j9 += 1
                            }
                            if !refs_ok { grow = false }
                            if refs_ok {
                                var j10: I32 = 1
                                while j10 < mf.len {
                                    if mf[j10].len > 1 && pkg_is_named_kind(mf[j10][0]) {
                                        var ink2 = false
                                        var kb: I32 = 0
                                        while kb < keep.len {
                                            if keep[kb] == mf[j10][1] { ink2 = true }
                                            kb += 1
                                        }
                                        if !ink2 {
                                            var kc: I32 = 0
                                            while kc < acc.len {
                                                if acc[kc] == mf[j10][1] {
                                                    keep.push(mf[j10][1])
                                                    grow = true
                                                }
                                                kc += 1
                                            }
                                        }
                                    }
                                    j10 += 1
                                }
                            }
                        }
                        // 合并:滤除当前 Use;保留其余未展开 Use(重启扫描处理);
                        // 同名 decl 首个胜出(eval find_decl 同口径)
                        var merged = mk("File")
                        var j3: I32 = 1
                        while j3 < out.len {
                            if j3 != i {
                                merged.push(out[j3])
                            }
                            j3 += 1
                        }
                        var j4: I32 = 1
                        while j4 < mf.len {
                            if mf[j4][0] != "Use" {
                                // 选择性合并跳过判定(spec §4.2):7-kind 不在 keep → 不并入
                                var named = pkg_is_named_kind(mf[j4][0])
                                if named && !refs_ok {
                                    // 保守回退:视为 keep(整模块合并)
                                } else if named {
                                    var ink3 = false
                                    var kd: I32 = 0
                                    while kd < keep.len {
                                        if keep[kd] == mf[j4][1] { ink3 = true }
                                        kd += 1
                                    }
                                    if !ink3 {
                                        j4 += 1
                                        continue
                                    }
                                }
                                // 改用名:本 Use 交替对里 name→alias 的映射(spec §4.3)
                                var rn = ""
                                var k6: I32 = 0
                                while k6 < syms.len {
                                    if mf[j4].len > 1 && syms[k6] == mf[j4][1] && syms[k6 + 1] != syms[k6] {
                                        rn = syms[k6 + 1]
                                    }
                                    k6 += 2
                                }
                                var iname = mf[j4][1]
                                if rn != "" { iname = rn }
                                var dup = false
                                var j5: I32 = 1
                                while j5 < merged.len {
                                    if pkg_is_named_kind(merged[j5][0]) {
                                        if pkg_is_named_kind(mf[j4][0]) {
                                            if mf[j4].len > 1 && merged[j5].len > 1 && merged[j5][1] == iname {
                                                dup = true
                                            }
                                        }
                                    }
                                    j5 += 1
                                }
                                if dup {
                                    // E5030:同名 decl 曾"首个胜出"静默遮蔽 → 现拦截(报名用改用名)
                                    diag1(diags, "E5030", "", iname)
                                    return out
                                }
                                if rn != "" {
                                    // 合并期重命名:浅拷贝顶层槽,子节点共享(spec §4.3)
                                    var nd = mk(mf[j4][0])
                                    nd.push(rn)
                                    var k7: I32 = 2
                                    while k7 < mf[j4].len {
                                        nd.push(mf[j4][k7])
                                        k7 += 1
                                    }
                                    merged.push(nd)
                                } else {
                                    merged.push(mf[j4])
                                }
                            }
                            j4 += 1
                        }
                        out = merged
                        i = 0
                        done.push(mpath)
                    }
                None => {
                    if !isstd {
                        diag1(diags, "E2020.use.read", "", mpath)
                        return out
                    }
                    // 前奏类文件缺失路径:带别名请求 = E2020.use.nat(spec §4.6)。
                    // 交替对步长 2 对读;k13+1 防越界(空组已兜底为同名对,奇数长理论
                    // 不可达但有兜底路径,守卫不越 P1a 交替对不变式)
                    var k13: I32 = 0
                    while k13 + 1 < syms.len {
                        if syms[k13 + 1] != syms[k13] {
                            // 变体码整键前缀 + 目录文案(sem_walk E1001@/W8901 手拼前缀同位;
                            // modules 套件按 //@ fail 整键子串判定,diag_render 只出基础码)
                            diags.push("E2020.use.nat: " + diag_text1("E2020.use.nat", syms[k13 + 1]))
                            return out
                        }
                        k13 += 2
                    }
                }
            }
        }
        i += 1
    }
    return out
}
