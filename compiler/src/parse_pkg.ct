// =====================================================================
// parse_pkg.ct —— 模块加载器 v0(§2):use 节点结构化 → pkg_dir_of 包路径展开
// 读取 src 下模块文件 → 整模块合并(滤除 Use)→ 可见性检查(E2020)→ 栈式循环
// 检测(E5020);pkg_check_caps/pkg_caps_allowed 能力声明核对(E4010)。
// =====================================================================
// ---------------- 模块加载器 v0(§2):use 解析 → 可见性 → 整模块合并 → 循环检测 ----------------
fn pkg_dir_of(path: Str) -> Str {
    var i = path.len - 1
    while i >= 0 {
        if byte_at(path, i) == 47 {
            return byte_slice(path, 0, i)
        }
        i -= 1
    }
    return "."
}

// std.* 导入:stdlib 未实现,跳过加载(§7 std 可用性 v0 口径)
fn segs_std(d: List[Str]) -> Bool {
    if d[0] != "Use" {
        return false
    }
    var segs = d[1]
    if segs.len < 2 {
        return false
    }
    return seq2(segs[1], "std")
}

fn pkg_check_caps(mf: List[Str], dir: Str, diags: List[Str]) {
    // E4010(§8.2):use std.<key>.<Name>(key ∈ {fs,time}) 且本文件有 &Name 参数,
    // 而 Ctron.toml [caps] 未声明该 key
    var i: I32 = 1
    while i < mf.len {
        var d = mf[i]
        if d[0] == "Use" {
            var segs = d[1]
            var symsN = d[2]
            if segs.len > 2 && seq2(segs[1], "std") {
                var cap = segs[2]
                if or2(seq2(cap, "fs"), seq2(cap, "time")) {
                    var name = ""
                    if symsN.len > 1 {
                        name = symsN[1]
                    } else {
                        if segs.len > 3 {
                            name = segs[3]
                        }
                    }
                    if name.len > 0 {
                        var hit = false
                        var j: I32 = 1
                        while j < mf.len && !hit {
                            var dd = mf[j]
                            if dd[0] == "Fn" {
                                var ps = dd[3]
                                var q: I32 = 1
                                while q < ps.len {
                                    var pr = ps[q]
                                    if pr[0] == "Param" {
                                        var pt = pr[3]
                                        if pt[0] == "Ref" {
                                            if pt[1][0] == "Named" {
                                                if seq2(pt[1][1], name) {
                                                    hit = true
                                                }
                                            }
                                        }
                                    }
                                    q += 1
                                }
                            }
                            j += 1
                        }
                        if hit && !pkg_caps_allowed(dir, cap) {
                            diags.push("E4010: 使用 " + cap + " 能力超出 manifest(caps) 声明:参数 &" + name)
                        }
                    }
                }
            }
        }
        i += 1
    }
}

fn pkg_caps_allowed(dir: Str, cap: Str) -> Bool {
    var toml = read_file(dir + "/../Ctron.toml")
    match toml {
        Some(t) => {
            var insec = false
            var i: I32 = 0
            while i < t.len {
                var c = byte_at(t, i)
                if c == 91 {
                    var sec = ""
                    i += 1
                    while i < t.len && byte_at(t, i) != 93 {
                        sec = sec + byte_slice(t, i, i + 1)
                        i += 1
                    }
                    insec = seq2(sec, "caps")
                } else if c == 10 {
                    i += 1
                } else {
                    var key = ""
                    var i0 = i
                    while i < t.len && byte_at(t, i) != 61 && byte_at(t, i) != 10 {
                        if byte_at(t, i) != 32 {
                            key = key + byte_slice(t, i, i + 1)
                        }
                        i += 1
                    }
                    if i == i0 {
                        i += 1
                    }
                    if insec && key.len > 0 && seq2(key, cap) {
                        return true
                    }
                }
            }
            return false
        }
        None => {
            return true
        }
    }
}

fn pkg_load_use(file: List[Str], dir: Str, stack: List[Str], diags: List[Str]) -> List[Str] {
    pkg_check_caps(file, dir, diags)
    if diags.len > 0 {
        return file
    }
    var out = file
    var i: I32 = 1
    while i < out.len {
        var d = out[i]
        if d[0] == "Use" {
            // 节点形态:[Use, Segs, Syms];std.* → 入口包旁的 std/ 目录(种子约定)
            var isstd = segs_std(d)
            var segs = d[1]
            var symsN = d[2]
            var syms = List[Str]()
            var k: I32 = 1
            while k < symsN.len {
                syms.push(symsN[k])
                k += 1
            }
            if syms.len == 0 {
                syms.push(segs[segs.len - 1])
            }
            var rel = ""
            if isstd { rel = "/../std" }
            var j2: I32 = 2
            while j2 < segs.len {
                rel = rel + "/" + segs[j2]
                j2 += 1
            }
            var mpath = dir + rel + ".ct"
            if in_list(stack, mpath) {
                diags.push("E5020: 模块循环导入(circular):" + mpath)
                return out
            }
            var src = read_file(mpath)
            match src {
                Some(ms) => {
                        var toks2 = List[Str]()
                        var lns2 = List[Str]()
                        scan(ms, toks2, lns2)
                        var cur2 = Atomic[I32](0)
                        var mf = p_file(toks2, cur2, lns2)
                        pkg_check_caps(mf, dir, diags)
                        // 可见性:请求符号必须存在且为 pub(v0:FnPub)
                        var k3: I32 = 0
                        while k3 < syms.len {
                            var sn = syms[k3]
                            var found = false
                            var vis = false
                            var m2: I32 = 1
                            while m2 < mf.len {
                                var md = mf[m2]
                                if md.len > 1 && md[1] == sn {
                                    found = true
                                    if md[0] == "FnPub" { vis = true }
                                }
                                m2 += 1
                            }
                            if !found {
                                diags.push("E2020: use 导入未找到符号:" + sn)
                            } else if !vis {
                                diags.push("E2020: use 导入的符号未公开(pub):" + sn)
                            }
                            k3 += 1
                        }
                        if diags.len > 0 {
                            return out
                        }
                        var stack2 = stack
                        stack2.push(mpath)
                        mf = pkg_load_use(mf, dir, stack2, diags)
                        if diags.len > 0 {
                            return out
                        }
                        // 合并:滤除当前 Use;保留其余未展开 Use(重启扫描处理);
                        // 同名 decl 首个胜出(eval find_decl 同口径)
                        var merged = mk("File")
                        var j3: I32 = 1
                        while j3 < out.len {
                            if j3 != i {
                                merged.push(out[j3])
                            }
                            j3 += 1
                        }
                        var j4: I32 = 1
                        while j4 < mf.len {
                            if mf[j4][0] != "Use" {
                                var dup = false
                                var j5: I32 = 1
                                while j5 < merged.len {
                                    if or2(merged[j5][0] == "Fn", or2(merged[j5][0] == "FnPub", or2(merged[j5][0] == "Struct", or2(merged[j5][0] == "Enum", merged[j5][0] == "FnExt")))) {
                                        if or2(mf[j4][0] == "Fn", or2(mf[j4][0] == "FnPub", or2(mf[j4][0] == "Struct", or2(mf[j4][0] == "Enum", mf[j4][0] == "FnExt")))) {
                                            if mf[j4].len > 1 && merged[j5].len > 1 && merged[j5][1] == mf[j4][1] {
                                                dup = true
                                            }
                                        }
                                    }
                                    j5 += 1
                                }
                                if !dup {
                                    merged.push(mf[j4])
                                }
                            }
                            j4 += 1
                        }
                        out = merged
                        i = 0
                    }
                None => {
                    if !isstd {
                        diags.push("E2020: use 模块文件不可读:" + mpath)
                        return out
                    }
                }
            }
        }
        i += 1
    }
    return out
}
