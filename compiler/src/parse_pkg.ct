// =====================================================================
// parse_pkg.ct —— 模块加载器 v0(§2):use 节点结构化 → pkg_dir_of 包路径展开
// 读取 src 下模块文件 → 整模块合并(滤除 Use)→ 可见性检查(E2020)→ 栈式循环
// 检测(E5020);pkg_check_caps/pkg_caps_allowed 能力声明核对(E4010)。
// =====================================================================
// ---------------- 模块加载器 v0(§2):use 解析 → 可见性 → 整模块合并 → 循环检测 ----------------
fn pkg_dir_of(path: Str) -> Str {
    var i = path.len - 1
    while i >= 0 {
        if byte_at(path, i) == 47 {
            return byte_slice(path, 0, i)
        }
        i -= 1
    }
    return "."
}

// std.*/stdweb.* 导入:stdlib 未实现跳过加载;stdweb 为内建命名空间,由 sem 按档位解析(§9.2)
fn segs_std(d: List[Str]) -> Bool {
    if d[0] != "Use" {
        return false
    }
    var segs = d[1]
    if segs.len < 2 {
        return false
    }
    return or2(seq2(segs[1], "std"), seq2(segs[1], "stdweb"))
}

// ---- T11 §11.1/§12.1 能力键细分 ----
// 门面符号 → 细键映射:net 域细分 listen/connect/resolve(§11.1 授予面);
// db 域统一 db.connect(§12.1)。粗键 net/db 不再授予(fail-closed 硬切,
// 在库清单同步升级)。能力对象名(Net/Net_probe/StdNet)=网络族任一细键即可
// (保持 &Net 引用检测兼容);fs/time 粗键维持。
fn cap_net_fine(sym: Str) -> Str {
    if or2(seq2(sym, "net_tcp_listen"), or2(seq2(sym, "net_unix_listen"), seq2(sym, "net_unix_accept"))) {
        return "net.listen"
    }
    if or2(seq2(sym, "net_tcp_connect"), or2(seq2(sym, "net_udp_socket"), or2(seq2(sym, "net_udp_bind"), or2(seq2(sym, "net_udp_sendto"), or2(seq2(sym, "net_udp_recvfrom"), seq2(sym, "net_unix_connect")))))) {
        return "net.connect"
    }
    if or2(seq2(sym, "net_resolve"), seq2(sym, "net_resolve_all")) {
        return "net.resolve"
    }
    return ""
}

// T17:前奏符号名判定(use 显式导入恒可见;§3.8 前奏隐式可用)
fn pkg_is_prelude_sym(nm: Str) -> Bool {
    if or2(seq2(nm, "parallel"), seq2(nm, "arena")) { return true }
    if or2(seq2(nm, "bit"), seq2(nm, "dom")) { return true }
    if or2(seq2(nm, "print"), or2(seq2(nm, "println"), or2(seq2(nm, "panic"), seq2(nm, "assert")))) { return true }
    if or2(seq2(nm, "assert_eq"), or2(seq2(nm, "assert_ne"), seq2(nm, "expect"))) { return true }
    if or2(seq2(nm, "fmt"), or2(seq2(nm, "byte_at"), or2(seq2(nm, "byte_slice"), seq2(nm, "char_len")))) { return true }
    if or2(seq2(nm, "read_file"), or2(seq2(nm, "read_dir"), or2(seq2(nm, "fs_exists"), or2(seq2(nm, "fs_write"), seq2(nm, "fs_delete"))))) { return true }
    if or2(seq2(nm, "now_ms"), or2(seq2(nm, "now_ms_text"), seq2(nm, "str_from_c"))) { return true }
    if seq2(nm, "Env") { return true }
    if or2(seq2(nm, "Some"), or2(seq2(nm, "None"), or2(seq2(nm, "Ok"), seq2(nm, "Err")))) { return true }
    return false
}

fn pkg_check_caps(mf: List[Str], dir: Str, diags: List[Str]) {
    // T48 fail-closed(§2.7 修订注兑现):遗留 TOML 清单 = 迁移诊断(TOML 面移除;
    // read_file 缺失回落 Some("") 故以非空判定存在性;三线消息逐字一致)
    match read_file(dir + "/../Ctron.toml") {
        Some(t0) => {
            if t0.len > 0 {
                diags.push("Ctron.toml: E5040 清单格式已硬切 CTCL(T48):检测到遗留 Ctron.toml——请迁移为 Ctron.ctcl:pkg \{ manifest_version = 1, ... }")
            }
        }
        None => {}
    }
    // E4010(§8.2):use std.<key>.<Name>(key ∈ {fs,time,net,db}) 且本文件有 &Name 参数,
    // 而 Ctron.toml [caps] 未声明该 key
    var i: I32 = 1
    while i < mf.len {
        var d = mf[i]
        if d[0] == "Use" {
            var segs = d[1]
            var symsN = d[2]
            // caps 键提取(2026-09-23 推广):std.<key> 取 segs[2];域顶层命名空间
            // (net/db 挂顶层)取 segs[1]。gui/http 无 cap 键,成员测试自然过滤。
            var cap = ""
            if segs.len > 2 && seq2(segs[1], "std") {
                cap = segs[2]
            } else if segs.len > 1 {
                cap = segs[1]
            }
            if cap.len > 0 {
                if or2(or2(seq2(cap, "fs"), seq2(cap, "time")), or2(seq2(cap, "net"), seq2(cap, "db"))) {
                    var name = ""
                    if symsN.len > 1 {
                        name = symsN[1]
                    } else {
                        if segs.len > 3 {
                            name = segs[3]
                        }
                    }
                    if name.len > 0 {
                        var hit = false
                        var j: I32 = 1
                        while j < mf.len && !hit {
                            var dd = mf[j]
                            if dd[0] == "Fn" {
                                var ps = dd[3]
                                var q: I32 = 1
                                while q < ps.len {
                                    var pr = ps[q]
                                    if pr[0] == "Param" {
                                        var pt = pr[3]
                                        if pt[0] == "Ref" {
                                            if pt[1][0] == "Named" {
                                                if seq2(pt[1][1], name) {
                                                    hit = true
                                                }
                                            }
                                        }
                                    }
                                    q += 1
                                }
                            }
                            j += 1
                        }
                        // 粗面(能力对象 &Net/&Db 参数):粗键或任一细键满足即过
                        var capok = pkg_caps_allowed(dir, cap)
                        if !capok && seq2(cap, "net") {
                            if or2(pkg_caps_allowed(dir, "net.listen"), or2(pkg_caps_allowed(dir, "net.connect"), pkg_caps_allowed(dir, "net.resolve"))) {
                                capok = true
                            }
                        }
                        if !capok && seq2(cap, "db") {
                            if pkg_caps_allowed(dir, "db.connect") {
                                capok = true
                            }
                        }
                        if hit && !capok {
                            diag2(diags, "E4010", "", cap, name)
                        }
                        // T11 细键:net 域逐导入符号映射;db 域统一 db.connect。
                        // 能力对象(Net/Net_probe/StdNet)走上方粗检测(任一细键
                        // 满足即过——pkg_caps_allowed 对 Net 名的 cap 仍是 "net",
                        // 细键清单下以三细键任一判)。此处理:净键检测。
                        var symsF = List[Str]()
                        var kf: I32 = 1
                        while kf < symsN.len {
                            symsF.push(symsN[kf])
                            kf += 1
                        }
                        if segs.len > 3 {
                            symsF.push(segs[3])
                        }
                        var sf: I32 = 0
                        while sf < symsF.len {
                            var fsym = symsF[sf]
                            var dupf = false
                            var df: I32 = 0
                            while df < sf {
                                if symsF[df] == fsym {
                                    dupf = true
                                }
                                df += 1
                            }
                            if dupf {
                                sf += 1
                                continue
                            }
                            if seq2(cap, "net") {
                                var fk = cap_net_fine(fsym)
                                if fk.len > 0 && !pkg_caps_allowed(dir, fk) {
                                    diag2(diags, "E4010", "", fk, fsym)
                                }
                            }
                            if seq2(cap, "db") {
                                if !pkg_caps_allowed(dir, "db.connect") {
                                    diag2(diags, "E4010", "", "db.connect", fsym)
                                }
                            }
                            sf += 1
                        }
                    }
                }
            }
        }
        i += 1
    }
}

// CTCL 清单 caps 提取(v1;规范 config-language-v1 §4/§5):
// 在 Ctron.ctcl 中定位 caps 键(键首词边界 + = [),收集引号词判定成员。
// 注:phase-1 仅面向规范形态清单(无块外干扰);fail-closed 诊断由 C/Rust 线与 tools 承担。
fn pkg_ctcl_at(t: Str, i: I32, key: Str) -> Bool {
    var k: I32 = 0
    while k < key.len {
        if or2(i + k >= t.len, byte_at(t, i + k) != byte_at(key, k)) {
            return false
        }
        k += 1
    }
    return true
}

fn pkg_ctcl_pre(t: Str, i: I32) -> Bool {
    if i == 0 {
        return true
    }
    var p = byte_at(t, i - 1)
    if or2(or2(p >= 97 && p <= 122, p == 95), p >= 48 && p <= 57) {
        return false
    }
    return true
}

fn pkg_caps_allowed(dir: Str, cap: Str) -> Bool {
    var t = ""
    match read_file(dir + "/../Ctron.ctcl") {
        Some(x) => {
            t = x
            // 空文本(缺失文件在发射语境回落 Some(""))= 无清单 → 不设限
            //(T11 细键检测以导入为触发面后暴露:此前粗检测 &Param 门槛掩盖)
            if t.len == 0 {
                return true
            }
        }
        None => {
            return true
        }
    }
    var i: I32 = 0
    while i < t.len {
        if pkg_ctcl_at(t, i, "caps") && pkg_ctcl_pre(t, i) {
            var j = i + 4
            while j < t.len && byte_at(t, j) == 32 {
                j += 1
            }
            if j < t.len && byte_at(t, j) == 61 {
                j += 1
                while j < t.len && byte_at(t, j) == 32 {
                    j += 1
                }
                if j < t.len && byte_at(t, j) == 91 {
                    j += 1
                    while j < t.len && byte_at(t, j) != 93 {
                        if byte_at(t, j) == 34 {
                            var nm = ""
                            j += 1
                            while j < t.len && byte_at(t, j) != 34 {
                                nm = nm + byte_slice(t, j, j + 1)
                                j += 1
                            }
                            j += 1
                            if seq2(nm, cap) {
                                return true
                            }
                        } else {
                            j += 1
                        }
                    }
                    return false
                }
            }
        }
        i += 1
    }
    return false
}

// ---- T35 分层 stdlib(§9 档位矩阵:core < alloc < std)----
// pkg_tier_rank —— 档位序;未识别值按 std(调用方已各自验证值域)
fn pkg_tier_rank(t: Str) -> I32 {
    if seq2(t, "core") { return 0 }
    if seq2(t, "alloc") { return 1 }
    return 2
}

// pkg_manifest_tier —— 清单 pkg 块 tier 键(消费方申报档):缺省 "std"(不设限,
// 渐进承诺);越域值 = E5040.tier fail-closed(T48 清单面硬切同族)。文本扫描
// 镜像 pkg_caps_allowed(键首词边界 + = " 引号值;phase-1 仅规范形态清单)。
fn pkg_manifest_tier(dir: Str, diags: List[Str]) -> Str {
    var t = ""
    match read_file(dir + "/../Ctron.ctcl") {
        Some(x) => { t = x }
        None => { return "std" }
    }
    var i: I32 = 0
    while i < t.len {
        if pkg_ctcl_at(t, i, "tier") && pkg_ctcl_pre(t, i) {
            var j = i + 4
            while j < t.len && byte_at(t, j) == 32 {
                j += 1
            }
            if j < t.len && byte_at(t, j) == 61 {
                j += 1
                while j < t.len && byte_at(t, j) == 32 {
                    j += 1
                }
                if j < t.len && byte_at(t, j) == 34 {
                    j += 1
                    var v = ""
                    while j < t.len && byte_at(t, j) != 34 && byte_at(t, j) != 10 {
                        v = v + byte_slice(t, j, j + 1)
                        j += 1
                    }
                    if or2(seq2(v, "core"), or2(seq2(v, "alloc"), seq2(v, "std"))) {
                        return v
                    }
                    diag1(diags, "E5040.tier", "", v)
                    return "std"
                }
            }
        }
        i += 1
    }
    return "std"
}

// pkg_manifest_gui_entry —— 清单 gui 块 entry 键(J18):UI 入口 ctml 相对路径,
// 构建期烘焙为运行锚默认值;缺省 ""(消费侧回落 "app.ctml" 存量口径)。
// 文本扫描镜像 pkg_manifest_tier(键首词边界 + = " 引号值;phase-1 规范形态清单)。
fn pkg_manifest_gui_entry(dir: Str) -> Str {
    match read_file(dir + "/../Ctron.ctcl") {
        Some(x) => {
            var i: I32 = 0
            while i < x.len {
                if pkg_ctcl_at(x, i, "entry") && pkg_ctcl_pre(x, i) {
                    var j = i + 5
                    while j < x.len && byte_at(x, j) == 32 {
                        j += 1
                    }
                    if j < x.len && byte_at(x, j) == 61 {
                        j += 1
                        while j < x.len && byte_at(x, j) == 32 {
                            j += 1
                        }
                        if j < x.len && byte_at(x, j) == 34 {
                            j += 1
                            var v = ""
                            while j < x.len && byte_at(x, j) != 34 && byte_at(x, j) != 10 {
                                v = v + byte_slice(x, j, j + 1)
                                j += 1
                            }
                            return v
                        }
                    }
                }
                i += 1
            }
            return ""
        }
        None => { return "" }
    }
}

// pkg_mod_tier —— std 模块头注档位提取:首注释块内 `//@ tier: core|alloc|std`;
// 缺标注/越域标注 = ""(不设门——渐进承诺,未标注模块不受档位面约束;
// 标注只认头部,首非注释行即止,空白行跳过不断链)。
fn pkg_mod_tier(src: Str) -> Str {
    var i: I32 = 0
    while i < src.len {
        var ls = i
        while ls < src.len && or2(byte_at(src, ls) == 32, byte_at(src, ls) == 9) {
            ls += 1
        }
        if ls >= src.len {
            return ""
        }
        var e = ls
        while e < src.len && byte_at(src, e) != 10 {
            e += 1
        }
        if ls + 1 < e && byte_at(src, ls) == 47 && byte_at(src, ls + 1) == 47 {
            // 注释行:"//" 后随 '@' 即标记形("//@ 词: 值")
            if ls + 2 < e && byte_at(src, ls + 2) == 64 {
                var w = ""
                var j = ls + 3
                while j < e && byte_at(src, j) == 32 {
                    j += 1
                }
                while j < e && byte_at(src, j) != 32 && byte_at(src, j) != 58 {
                    w = w + byte_slice(src, j, j + 1)
                    j += 1
                }
                if seq2(w, "tier") && j < e && byte_at(src, j) == 58 {
                    var j3 = j + 1
                    while j3 < e && byte_at(src, j3) == 32 {
                        j3 += 1
                    }
                    var v = ""
                    while j3 < e && byte_at(src, j3) != 32 && byte_at(src, j3) != 9 {
                        v = v + byte_slice(src, j3, j3 + 1)
                        j3 += 1
                    }
                    if or2(seq2(v, "core"), or2(seq2(v, "alloc"), seq2(v, "std"))) {
                        return v
                    }
                    return ""
                }
            }
            i = e + 1
        } else {
            if ls == e {
                // 空白行:跳过,注释块续扫
                i = e + 1
            } else {
                return ""
            }
        }
    }
    return ""
}

// pkg_exe_dir —— 取可执行文件所在目录(无分隔符则空串;与 pkg_dir_of 的 "." 缺省区分)
fn pkg_exe_dir(exe: Str) -> Str {
    var i = exe.len - 1
    while i >= 0 {
        if byte_at(exe, i) == 47 {
            return byte_slice(exe, 0, i)
        }
        i -= 1
    }
    return ""
}

// pkg_std_installed —— std 是否处于"装机/显式指路"态:①CTRON_STDPATH 已设,或
// ②exe 旁 ../lib/std 实存(探测 str.ct;2026-09-30 库根布局)。两者皆否(种子/源码树回落态)为 false,
// 使③回落路径缺失维持静默(种子语料兼容;std.iter/stdweb 等 sem 内建命名空间不误伤)。
fn pkg_std_installed(dir: Str) -> Bool {
    if env_get("CTRON_STDPATH").len > 0 {
        return true
    }
    var exe = ctron_exe_path()
    if exe.len > 0 {
        var root = pkg_exe_dir(exe) + "/../lib/std"
        if fs_exists(root + "/str.ct") {
            return true
        }
    }
    return false
}

// pkg_std_root —— std 根三级查找:①CTRON_STDPATH ②exe 旁 ../lib/std(2026-09-30 库根布局) ③回落 ../std(种子约定)
fn pkg_std_root(dir: Str) -> Str {
    var envp = env_get("CTRON_STDPATH")
    if envp.len > 0 {
        return envp
    }
    var exe = ctron_exe_path()
    if exe.len > 0 {
        var root = pkg_exe_dir(exe) + "/../lib/std"
        if fs_exists(root + "/str.ct") {
            return root
        }
    }
    return dir + "/../std"
}

fn pkg_load_use(file: List[Str], dir: Str, stack: List[Str], diags: List[Str]) -> List[Str] {
    // SL-8c-4②:gui.run 装配合成——预合并注入 use gui.{run_d} 请求,
    // 合并后改写 run(ViewCall) 调用点并拼写 __gui_bind/__gui_act/__gui_run
    var unit = List[Str]()
    var f2: List[Str] = gui_ds_premerge(file, unit)
    var out = pkg_load_use_t(f2, dir, stack, diags, List[Str](), "full")
    return gui_ds_postmerge(out, unit, diags)
}

// pkg_load_use_m —— pkg_load_use 带 miss 收集(W8902 带出路半面;独立 fn 避碰
// 在制 driver_emit.ct 调用点——emit 驱动 seam 待其落库后一行切换,2026-09-30 登记)
// T35:manifest-only 门(prof 恒 full;doc 驱动 5 参调用面保持零改动)
fn pkg_load_use_m(file: List[Str], dir: Str, stack: List[Str], diags: List[Str], misses: List[Str]) -> List[Str] {
    var unit = List[Str]()
    var f2: List[Str] = gui_ds_premerge(file, unit)
    var out = pkg_load_use_t(f2, dir, stack, diags, misses, "full")
    return gui_ds_postmerge(out, unit, diags)
}

// pkg_load_use_t —— T35 档位门入口(prof = sem_walk2 同源档位串;bare 钳 core
// 于 pkg_load_use_done 内)。独立 fn 避碰 driver_doc.ct 的 _m 5 参调用面
//(P1b「独立 fn 避碰」先例);check/run 两驱动先行接线,emit 随 seam 落库再切。
fn pkg_load_use_t(file: List[Str], dir: Str, stack: List[Str], diags: List[Str], misses: List[Str], prof: Str) -> List[Str] {
    var unit = List[Str]()
    var f2: List[Str] = gui_ds_premerge(file, unit)
    var out = pkg_load_use_done(f2, dir, stack, List[Str](), diags, true, misses, prof)
    return gui_ds_postmerge(out, unit, diags)
}

// 名槽 decl 种类(与 E5030 dup 检查面一致;spec §4.2 P1b 精化口径)
fn pkg_is_named_kind(t: Str) -> Bool {
    return or2(t == "Fn", or2(t == "FnPub", or2(t == "Struct", or2(t == "Enum", or2(t == "FnExt", or2(t == "Static", t == "Const"))))))
}

// 引用收集:形态表驱动,S 槽收集、N 槽递归;未知标签/非法槽/超深 → false(保守信号)
fn pkg_refs_walk(d: List[Str], ktags: List[Str], kshapes: List[Str], acc: List[Str], depth: I32) -> Bool {
    if depth > 4000 { return false }
    var sh = ast_shape(ktags, kshapes, d[0])
    if sh == "?" { return false }
    var i: I32 = 1
    while i < d.len {
        var kind = ast_kind(sh, i - 1)
        if kind == "S" {
            acc.push(d[i])
        } else {
            if kind == "N" {
                if !pkg_refs_walk(d[i], ktags, kshapes, acc, depth + 1) { return false }
            } else {
                return false
            }
        }
        i += 1
    }
    return true
}

// done = 已合并模块路径集(菱形/共享依赖第二次引用时整体跳过,防 E5030 重复;
// stack 只承"展开中"路径 —— 菱形非环,E5020 仅真环)
fn pkg_load_use_done(file: List[Str], dir: Str, stack: List[Str], done: List[Str], diags: List[Str], top: Bool, misses: List[Str], prof: Str) -> List[Str] {
    pkg_check_caps(file, dir, diags)
    if diags.len > 0 {
        return file
    }
    // T35:消费方有效档 = 清单 tier 键(缺省 std);bare 档钳到 core(§9:bare 目标
    // stdlib 层 = core)。E5040.tier 已推则加载即止(驱动对 ldiags 非空 rc=1)。
    var tier = pkg_manifest_tier(dir, diags)
    if diags.len > 0 {
        return file
    }
    if seq2(prof, "bare") && pkg_tier_rank(tier) > 0 {
        tier = "core"
    }
    var out = file
    var i: I32 = 1
    while i < out.len {
        var d = out[i]
        if d[0] == "Use" {
            // 节点形态:[Use, Segs, Syms];std.* → 入口包旁的 std/ 目录(种子约定)
            var isstd = segs_std(d)
            var segs = d[1]
            var symsN = d[2]
            var syms = List[Str]()
            var k: I32 = 1
            while k < symsN.len {
                syms.push(symsN[k])
                k += 1
            }
            if syms.len == 0 {
                // 空组兜底:保持交替对不变式(name,alias 同名),下游步长 2 对读不越界
                syms.push(segs[segs.len - 1])
                syms.push(segs[segs.len - 1])
            }
            var mpath = ""
            if isstd {
                mpath = pkg_std_root(dir)
                var j2: I32 = 2
                while j2 < segs.len {
                    mpath = mpath + "/" + segs[j2]
                    j2 += 1
                }
                mpath = mpath + ".ct"
                if !fs_exists(mpath) {
                    if pkg_std_installed(dir) {
                        // W8901:装机/显式指路态下 std 模块缺失(驱动 W/E 同视 rc=1——
                        // use std.* 而 std 缺失本就无从编译,响亮失败;③回落缺失不在此列,维持静默)
                        diags.push("W8901: std 模块缺失:" + mpath + "(安装损坏或 CTRON_STDPATH 配错)")
                        return out
                    }
                }
            } else {
                // 单段 use:rel 取首段本身(同目录兄弟文件形态 dir/<mod>.ct);
                // 多段:首段=域/包名,rel 取 seg2 起子路径(既有口径)
                var rel = ""
                if segs.len == 2 {
                    rel = "/" + segs[1]
                } else {
                    var j2b: I32 = 2
                    while j2b < segs.len {
                        rel = rel + "/" + segs[j2b]
                        j2b += 1
                    }
                }
                mpath = dir + rel + ".ct"
                // 域根(2026-09-23 顶层命名空间;2026-09-30 门面入域目录):libroot
                //(= std 根父目录)下 <首段>[/<次段>…].ct 命中则用之(gui.* / net.* /
                // http.* / tls.* / db.*);两段门面形映射 <域>/<域>.ct(统一 db 形态,
                // 容器只持目录)。目录相对优先、ctart 仍保底——realdep/S2a 既有语义
                // 零扰动;未命中保持静默。
                if !fs_exists(mpath) {
                    var sroot = pkg_std_root(dir)
                    if sroot.len > 0 {
                        var cut: I32 = 0 - 1
                        var ci: I32 = sroot.len - 1
                        while ci >= 0 {
                            if byte_at(sroot, ci) == 47 {
                                cut = ci
                                break
                            }
                            ci -= 1
                        }
                        if cut > 0 {
                            var dpath = byte_slice(sroot, 0, cut)
                            if segs.len == 2 {
                                dpath = dpath + "/" + segs[1] + "/" + segs[1]
                            } else {
                                var j2c: I32 = 1
                                while j2c < segs.len {
                                    dpath = dpath + "/" + segs[j2c]
                                    j2c += 1
                                }
                            }
                            dpath = dpath + ".ct"
                            if fs_exists(dpath) {
                                mpath = dpath
                            }
                        }
                    }
                }
                // site root(2026-09-30 库根布局):①CTRON_SITEPATH ②库根同级
                // ../pkgs(dirname(libroot)/pkgs)下 <首段>[/<次段>…].ct 命中则用之
                // ——libroot 探测后、ctart 保底前;段映射镜像域根分支;未命中保持静默。
                if !fs_exists(mpath) {
                    var spath = env_get("CTRON_SITEPATH")
                    if spath.len == 0 {
                        var sroot2 = pkg_std_root(dir)
                        if sroot2.len > 0 {
                            var cut2: I32 = 0 - 1
                            var ci2: I32 = sroot2.len - 1
                            while ci2 >= 0 {
                                if byte_at(sroot2, ci2) == 47 {
                                    cut2 = ci2
                                    break
                                }
                                ci2 -= 1
                            }
                            if cut2 > 0 {
                                var lroot2 = byte_slice(sroot2, 0, cut2)
                                var cut3: I32 = 0 - 1
                                var ci3: I32 = lroot2.len - 1
                                while ci3 >= 0 {
                                    if byte_at(lroot2, ci3) == 47 {
                                        cut3 = ci3
                                        break
                                    }
                                    ci3 -= 1
                                }
                                if cut3 > 0 {
                                    spath = byte_slice(lroot2, 0, cut3) + "/pkgs"
                                }
                            }
                        }
                    }
                    if spath.len > 0 {
                        var ppath = spath
                        if segs.len == 2 {
                            ppath = ppath + "/" + segs[1] + "/" + segs[1]
                        } else {
                            var j2d: I32 = 1
                            while j2d < segs.len {
                                ppath = ppath + "/" + segs[j2d]
                                j2d += 1
                            }
                        }
                        ppath = ppath + ".ct"
                        if fs_exists(ppath) {
                            mpath = ppath
                        }
                    }
                }
                // S2a 闭源工件回落:源缺失时消费 deps/<pkg>.ctart/impl<rel>.ast
                // (spec §7.2 deps/ 布局;可见性/E5030 合并对加载后的 decl 同判)
                if !fs_exists(mpath) {
                    var apath = dir + "/deps/" + segs[1] + ".ctart/impl" + rel + ".ast"
                    if fs_exists(apath) {
                        mpath = apath
                    }
                }
                // W8902 半面:全链未命中的包形 use(≥3 段)静默收集,驱动层在
                // 诊断输出时附加出路;单段=本地兄弟文件缺文件,维持旧口径不收集
                if !fs_exists(mpath) && segs.len >= 3 {
                    misses.push(segs[1])
                }
            }
            // 已合并模块重入,分两半(2026-09-23 P1b merge-through 收紧):
            // ① 递归展开内部:保持旧 done-skip —— 中层 mf 不需要已完成模块的声明
            //    (符号在消费级平面视图解析;补进 mf 反而在消费级 dup 撞名,smoke 3n 实证)
            // ② 顶层消费方 use:补并 —— done-skip 会把直连请求一并吞掉(门面先行合并
            //    同一模块时 keep 集不同 → 请求符号缺失:轻则 E2020,重则 emit 缺 extern
            //    声明);照常重载走选择性合并,已在视图的符号于 dup 处 redo 静默跳过
            var isdone = in_list(done, mpath)
            if isdone && !top {
                var nm3 = mk("File")
                var j3: I32 = 1
                while j3 < out.len {
                    if j3 != i {
                        nm3.push(out[j3])
                    }
                    j3 += 1
                }
                out = nm3
                i = 1
                continue
            }
            var redo = isdone && top
            if !isdone && in_list(stack, mpath) {
                // stack 为单调"曾展开集"(不弹栈);真环在首次展开(未 done)即被拦,
                // 已 done 者必为干净完成的合并,顶层重入补并不可能成环 → done 免检
                diag1(diags, "E5020.circ", "", mpath)
                return out
            }
            var src = read_file(mpath)
            match src {
                Some(ms) => {
                    // T35 档位门:std 模块头注 //@ tier 高于消费方有效档 → use 点
                    // 一次 E3040.tier,加载即止(替代 merge 后 bare 体检在 std 内部
                    // 的洪水;缺标注不设门)。注:门只可能命中真模块文件——退化形
                    // `use std`(segs.len==2)的 mpath 恒不存在,不入此分支。
                    var mt = pkg_mod_tier(ms)
                    if mt.len > 0 && pkg_tier_rank(mt) > pkg_tier_rank(tier) {
                        diag1(diags, "E3040.tier", "", segs[2] + "(" + mt + ")")
                        return out
                    }
                    var mf = List[Str]()
                        var is_ast = mpath.len >= 4
                        if is_ast {
                            if byte_at(mpath, mpath.len - 4) == 46 {
                                is_ast = byte_slice(mpath, mpath.len - 4, mpath.len) == ".ast"
                            } else {
                                is_ast = false
                            }
                        }
                        if is_ast {
                            // .ctast 工件模块:免 parse 直载(S2a;坏流显式越界失败)
                            var acur = Atomic[I32](0)
                            mf = ast_load_node(ms, acur)
                        } else {
                        var toks2 = List[Str]()
                        var lns2 = List[Str]()
                        var cols2 = List[Str]()
                        var pd2 = List[Str]()
                        scan4(ms, toks2, lns2, cols2, pd2)
                        var cur2 = Atomic[I32](0)
                        mf = p_file(toks2, cur2, lns2, cols2, pd2)
                        }
                        pkg_check_caps(mf, dir, diags)
                        // 可见性:请求符号必须存在且为 pub(v0:FnPub)。
                        // P1a:syms 为交替对(name,alias),步长 2 对读;可见性按本名 sn 判
                            var k3: I32 = 0
                            while k3 < syms.len {
                                var sn = syms[k3]
                                var _al = syms[k3 + 1]
                                var found = false
                                var vis = false
                                var m2: I32 = 1
                                while m2 < mf.len {
                                    var md = mf[m2]
                                    if md.len > 1 && md[1] == sn {
                                        found = true
                                        if md[0] == "FnPub" { vis = true }
                                        // SL-0.7:pub struct/enum/extern——解析器在节点
                                        // 尾槽追加 "pub"(镜像 fn 的 anm/stamp 尾槽模式)
                                        if md.len > 2 {
                                            if md[md.len - 1] == "pub" {
                                                if or2(md[0] == "Struct", or2(md[0] == "Enum", md[0] == "FnExt")) {
                                                    vis = true
                                                }
                                            }
                                        }
                                        // T26:trait 接口面恒可见(§3.4/§8.1 能力注入:
                                        // 跨模块 impl/参数引用须先可导入;无 pub trait 语法位)
                                        if md[0] == "Trait" {
                                            vis = true
                                        }
                                    }
                                    m2 += 1
                                }
                            // T17:前奏符号(§3.8 隐式可用)经 use 显式导入 = 文档化
                            // 冗余——恒可见(use std.iter.{parallel} 归位面)
                            if !found && pkg_is_prelude_sym(sn) {
                                found = true
                                vis = true
                            }
                            if !found {
                                diag1(diags, "E2020.use.miss", "", sn)
                            } else if !vis {
                                diag1(diags, "E2020.use.priv", "", sn)
                            }
                            k3 += 2
                        }
                        // E5035:别名与本文件已有 decl 撞名(spec §4.4;P1a 先查入口面,
                        // 合并流内撞名由既有 E5030 兜底)
                        var k8: I32 = 0
                        while k8 < syms.len {
                            if syms[k8 + 1] != syms[k8] {
                                var m9: I32 = 1
                                while m9 < out.len {
                                    if out[m9].len > 1 && out[m9][1] == syms[k8 + 1] {
                                        diag1(diags, "E5035", "", syms[k8 + 1])
                                        return out
                                    }
                                    m9 += 1
                                }
                            }
                            k8 += 2
                        }
                        if diags.len > 0 {
                            return out
                        }
                        var stack2 = stack
                        stack2.push(mpath)
                        mf = pkg_load_use_done(mf, dir, stack2, done, diags, false, misses, prof)
                        if diags.len > 0 {
                            return out
                        }
                        // —— 选择性合并(spec §4.2):7-kind = 请求 ∪ 闭包;非 7-kind 恒随;
                        //    遍历失败/未知形态 → 保守整模块(= P1a 行为)——
                        var ktags = List[Str]()
                        var kshapes = List[Str]()
                        ast_tables(ktags, kshapes)
                        var keep = List[Str]()
                        var k9: I32 = 0
                        while k9 < syms.len {
                            keep.push(syms[k9])
                            k9 += 2
                        }
                        var refs_ok = true
                        var grow = true
                        while grow {
                            grow = false
                            var acc = List[Str]()
                            var j9: I32 = 1
                            while j9 < mf.len {
                                // 遍历面 = 将随合并走的 decl(非 Use;7-kind 须在 keep):
                                // Test/Impl/Method 恒随,其体引用的 decl 若不入 keep 即悬空
                                // (E2020;收紧审计第一轮:stdpkg/geom_str 实红),故一并收集
                                var carry = false
                                if mf[j9][0] != "Use" {
                                    carry = true
                                    if pkg_is_named_kind(mf[j9][0]) {
                                        carry = false
                                        var ka: I32 = 0
                                        while ka < keep.len {
                                            if keep[ka] == mf[j9][1] { carry = true }
                                            ka += 1
                                        }
                                    }
                                }
                                if carry {
                                    if !pkg_refs_walk(mf[j9], ktags, kshapes, acc, 0) { refs_ok = false }
                                }
                                j9 += 1
                            }
                            if !refs_ok { grow = false }
                            if refs_ok {
                                var j10: I32 = 1
                                while j10 < mf.len {
                                    if mf[j10].len > 1 && pkg_is_named_kind(mf[j10][0]) {
                                        var ink2 = false
                                        var kb: I32 = 0
                                        while kb < keep.len {
                                            if keep[kb] == mf[j10][1] { ink2 = true }
                                            kb += 1
                                        }
                                        if !ink2 {
                                            var kc: I32 = 0
                                            while kc < acc.len {
                                                if acc[kc] == mf[j10][1] {
                                                    keep.push(mf[j10][1])
                                                    grow = true
                                                }
                                                kc += 1
                                            }
                                        }
                                    }
                                    j10 += 1
                                }
                            }
                        }
                        // 合并:滤除当前 Use;保留其余未展开 Use(重启扫描处理);
                        // 同名 decl 首个胜出(eval find_decl 同口径)
                        var merged = mk("File")
                        var j3: I32 = 1
                        while j3 < out.len {
                            if j3 != i {
                                merged.push(out[j3])
                            }
                            j3 += 1
                        }
                        var j4: I32 = 1
                        while j4 < mf.len {
                            if mf[j4][0] != "Use" {
                                // 选择性合并跳过判定(spec §4.2):7-kind 不在 keep → 不并入
                                var named = pkg_is_named_kind(mf[j4][0])
                                if named && !refs_ok {
                                    // 保守回退:视为 keep(整模块合并)
                                } else if named {
                                    var ink3 = false
                                    var kd: I32 = 0
                                    while kd < keep.len {
                                        if keep[kd] == mf[j4][1] { ink3 = true }
                                        kd += 1
                                    }
                                    if !ink3 {
                                        j4 += 1
                                        continue
                                    }
                                }
                                // 改用名:本 Use 交替对里 name→alias 的映射(spec §4.3)
                                var rn = ""
                                var k6: I32 = 0
                                while k6 < syms.len {
                                    if mf[j4].len > 1 && syms[k6] == mf[j4][1] && syms[k6 + 1] != syms[k6] {
                                        rn = syms[k6 + 1]
                                    }
                                    k6 += 2
                                }
                                var iname = mf[j4][1]
                                if rn != "" { iname = rn }
                                var dup = false
                                var j5: I32 = 1
                                while j5 < merged.len {
                                    if pkg_is_named_kind(merged[j5][0]) {
                                        if pkg_is_named_kind(mf[j4][0]) {
                                            if mf[j4].len > 1 && merged[j5].len > 1 && merged[j5][1] == iname {
                                                dup = true
                                            }
                                        }
                                    }
                                    j5 += 1
                                }
                                if dup {
                                    if redo {
                                        // 重入补并:符号已在视图(前次合并并入)→ 跳过即免重
                                        j4 += 1
                                        continue
                                    }
                                    // E5030:同名 decl 曾"首个胜出"静默遮蔽 → 现拦截(报名用改用名)
                                    diag1(diags, "E5030", "", iname)
                                    return out
                                }
                                if rn != "" {
                                    // 合并期重命名:浅拷贝顶层槽,子节点共享(spec §4.3)
                                    var nd = mk(mf[j4][0])
                                    nd.push(rn)
                                    var k7: I32 = 2
                                    while k7 < mf[j4].len {
                                        nd.push(mf[j4][k7])
                                        k7 += 1
                                    }
                                    merged.push(nd)
                                } else {
                                    merged.push(mf[j4])
                                }
                            }
                            j4 += 1
                        }
                        out = merged
                        i = 0
                        if !redo {
                            done.push(mpath)
                        }
                    }
                None => {
                    if !isstd {
                        diag1(diags, "E2020.use.read", "", mpath)
                        return out
                    }
                    // 前奏类文件缺失路径:带别名请求 = E2020.use.nat(spec §4.6)。
                    // 交替对步长 2 对读;k13+1 防越界(空组已兜底为同名对,奇数长理论
                    // 不可达但有兜底路径,守卫不越 P1a 交替对不变式)
                    var k13: I32 = 0
                    while k13 + 1 < syms.len {
                        if syms[k13 + 1] != syms[k13] {
                            // 变体码整键前缀 + 目录文案(sem_walk E1001@/W8901 手拼前缀同位;
                            // modules 套件按 //@ fail 整键子串判定,diag_render 只出基础码)
                            diags.push("E2020.use.nat: " + diag_text1("E2020.use.nat", syms[k13 + 1]))
                            return out
                        }
                        k13 += 2
                    }
                }
            }
        }
        i += 1
    }
    return out
}

// ---- T52 §2.1 插件注册表提取(plugin "kind.name" { path = …; codes = [...] }) ----
// 文本扫描式(同 pkg_caps_allowed 形):定位 plugin 键词 → 引号块名 → 块体字段。
// 返回平表每插件 3 槽 [fullkey, path, codesJoined(";")];derive 形 codesJoined=""。
// v1 诊断面最小:缺 path/块体残形不入表(CI ctcl_check fail-closed 兜底;
// 加载点以 fs_exists 失败 → E5060.load 收口)。
fn pkg_plugins(dir: Str) -> List[Str] {
    var out = List[Str]()
    var t = ""
    match read_file(dir + "/../Ctron.ctcl") {
        Some(x) => { t = x }
        None => { return out }
    }
    var i: I32 = 0
    while i < t.len {
        if pkg_ctcl_at(t, i, "plugin") && pkg_ctcl_pre(t, i) {
            var j = i + 6
            while j < t.len && byte_at(t, j) == 32 {
                j += 1
            }
            if j < t.len && byte_at(t, j) == 34 {
                var k = j + 1
                while k < t.len && byte_at(t, k) != 34 {
                    k += 1
                }
                if k < t.len {
                    var nm = byte_slice(t, j + 1, k)
                    var b = k + 1
                    while b < t.len && byte_at(t, b) != 123 {
                        b += 1
                    }
                    if b < t.len {
                        // 块体 [b+1, e):CTCL 深度恒 1,块内无嵌套花括号
                        var e = b + 1
                        while e < t.len && byte_at(t, e) != 125 {
                            e += 1
                        }
                        if e < t.len {
                            var body = byte_slice(t, b + 1, e)
                            out.push(nm)
                            out.push(pkg_plugin_field(body, "path"))
                            out.push(pkg_plugin_codes(body))
                        }
                    }
                }
                i = k
            }
        }
        i += 1
    }
    return out
}

// 块体内 "key = \"value\"" 引号值提取(行式;CTCL 值无转义,D4 死数据)
fn pkg_plugin_field(body: Str, key: Str) -> Str {
    var i: I32 = 0
    while i < body.len {
        if pkg_ctcl_at(body, i, key) && pkg_ctcl_pre(body, i) {
            var j = i + key.len
            while j < body.len && byte_at(body, j) == 32 {
                j += 1
            }
            if j < body.len && byte_at(body, j) == 61 {
                j += 1
                while j < body.len && byte_at(body, j) == 32 {
                    j += 1
                }
                if j < body.len && byte_at(body, j) == 34 {
                    var k = j + 1
                    while k < body.len && byte_at(body, k) != 34 {
                        k += 1
                    }
                    if k < body.len {
                        return byte_slice(body, j + 1, k)
                    }
                }
            }
        }
        i += 1
    }
    return ""
}

// 块体内 codes = ["W9xxx", ...] 引号词提取,分号拼接;缺省 = ""
fn pkg_plugin_codes(body: Str) -> Str {
    var i: I32 = 0
    while i < body.len {
        if pkg_ctcl_at(body, i, "codes") && pkg_ctcl_pre(body, i) {
            var j = i + 5
            while j < body.len && byte_at(body, j) == 32 {
                j += 1
            }
            if j < body.len && byte_at(body, j) == 61 {
                j += 1
                while j < body.len && byte_at(body, j) == 32 {
                    j += 1
                }
                if j < body.len && byte_at(body, j) == 91 {
                    j += 1
                    var out = ""
                    while j < body.len && byte_at(body, j) != 93 {
                        if byte_at(body, j) == 34 {
                            var k = j + 1
                            while k < body.len && byte_at(body, k) != 34 {
                                k += 1
                            }
                            if k < body.len {
                                if out.len > 0 {
                                    out = out + ";"
                                }
                                out = out + byte_slice(body, j + 1, k)
                                j = k
                            }
                        }
                        j += 1
                    }
                    return out
                }
            }
        }
        i += 1
    }
    return ""
}