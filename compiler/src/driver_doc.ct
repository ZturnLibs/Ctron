// =====================================================================
// driver_doc.ct —— 编译器入口(iface 投影模式,S0)
// 闭源包分发 S0(docs/superpowers/specs/2026-09-21-closed-pkg-distribution-design.md
// §10 S0 / §3.1):与 cc_check 同径(scan4 → p_file → pkg_load_use),在合并后
// 单一 AST 上按源序倾倒包的 iface 面:
//   pub 符号表  FnPub / pub Struct / pub Enum / pub FnExt(可见性裁决镜像
//               loader parse_pkg.ct:FnPub 按 tag;Struct/Enum/FnExt 按尾槽 "pub")
//   trait 面    trait 声明 + 方法/prop 签名(v0 无 pub trait 语法,整体列入,不入符号计数)
//   impl 面     impl T for X 一行 + 方法签名缩进列(类型 API 面的一部分)
// 头行 iface <entry> decls=N,尾行 iface symbols=M(M = 可 use 导入的 pub 符号数,
// 与 loader 可导入集同口径)。Const/Static/私有 fn/test/gui 不入 iface 体,仅计 decls。
// 输出为确定性文本(源序,逐字节可复现),供 ctron doc / agent 契约头消费;
// E5030/E5020/E4010/E2020 经 pkg_load_use 与源码路径同判(spec §4 对照表)。
// 输入锚:read_file("ANCHORINPUT") 中性锚(与 driver_check 同口径)。
// =====================================================================
fn doc_ty(t: List[Str]) -> Str {
    if t[0] == "None" {
        return ""
    }
    if t[0] == "Named" {
        var out = t[1]
        if t.len > 2 {
            var ta = t[2]
            if ta[0] == "TArgs" && ta.len > 1 {
                out = out + "["
                var j: I32 = 1
                while j < ta.len {
                    if j > 1 {
                        out = out + ", "
                    }
                    out = out + doc_ty(ta[j])
                    j += 1
                }
                out = out + "]"
            }
        }
        return out
    }
    if t[0] == "Ref" {
        return "&" + doc_ty(t[1])
    }
    if t[0] == "Optional" {
        return doc_ty(t[1]) + "?"
    }
    if t[0] == "TupleT" {
        var out = "("
        var j: I32 = 1
        while j < t.len {
            if j > 1 {
                out = out + ", "
            }
            out = out + doc_ty(t[j])
            j += 1
        }
        return out + ")"
    }
    if t[0] == "Slice" {
        return "[" + doc_ty(t[1]) + "]"
    }
    if t[0] == "ArrayT" {
        // 尺寸表达式以 ".." 占位(v0:iface 面确定性优先,不渲染表达式)
        return "[" + doc_ty(t[1]) + "; ..]"
    }
    if t[0] == "FnType" {
        var ps = t[1]
        var out = "fn("
        var j: I32 = 1
        while j < ps.len {
            if j > 1 {
                out = out + ", "
            }
            out = out + doc_ty(ps[j])
            j += 1
        }
        out = out + ")"
        if t[2][0] != "None" {
            out = out + " -> " + doc_ty(t[2])
        }
        return out
    }
    return t[0]
}

fn doc_tps(tp: List[Str]) -> Str {
    // [TPs, TPar[name, isc, Bounds]…];空泛型返回空串
    if tp[0] != "TPs" || tp.len < 2 {
        return ""
    }
    var out = "["
    var j: I32 = 1
    while j < tp.len {
        if j > 1 {
            out = out + ", "
        }
        var p = tp[j]
        if p[2] == "true" {
            out = out + "comptime "
        }
        out = out + p[1]
        var bd = p[3]
        if bd.len > 1 {
            out = out + ": "
            var k: I32 = 1
            while k < bd.len {
                if k > 1 {
                    out = out + " + "
                }
                out = out + bd[k]
                k += 1
            }
        }
        j += 1
    }
    return out + "]"
}

fn doc_ps(ps: List[Str]) -> Str {
    // [Ps, (Param[isv, name, ty] | VaArgs)…];ty 为 None 仅出名(self 可省型)
    var out = ""
    var j: I32 = 1
    while j < ps.len {
        if j > 1 {
            out = out + ", "
        }
        var p = ps[j]
        if p[0] == "VaArgs" {
            out = out + "..."
        } else {
            if p[1] == "true" {
                out = out + "var "
            }
            out = out + p[2]
            if p[3][0] != "None" {
                out = out + ": " + doc_ty(p[3])
            }
        }
        j += 1
    }
    return out
}

fn doc_fn_core(d: List[Str]) -> Str {
    // fn 形节点共用:[tag, name, TPs, Ps, ret, body, …]
    var out = d[1] + doc_tps(d[2]) + "(" + doc_ps(d[3]) + ")"
    if d[4][0] != "None" {
        out = out + " -> " + doc_ty(d[4])
    }
    return out
}

fn doc_is_pub(d: List[Str]) -> Bool {
    // 镜像 loader 可见性裁决(parse_pkg.ct):FnPub 按 tag;Struct/Enum/FnExt 按尾槽 "pub"
    if d[0] == "FnPub" {
        return true
    }
    if d.len > 2 {
        if d[d.len - 1] == "pub" {
            if or2(d[0] == "Struct", or2(d[0] == "Enum", d[0] == "FnExt")) {
                return true
            }
        }
    }
    return false
}

fn doc_fields(fs: List[Str]) -> Str {
    var out = ""
    var j: I32 = 1
    while j < fs.len {
        if j > 1 {
            out = out + ", "
        }
        var f = fs[j]
        if f[1] == "true" {
            out = out + "var "
        } else {
            out = out + "let "
        }
        out = out + f[2] + ": " + doc_ty(f[3])
        j += 1
    }
    return out
}

fn doc_struct(d: List[Str]) -> Str {
    return "pub struct " + d[1] + doc_tps(d[3]) + " \{ " + doc_fields(d[4]) + " }"
}

fn doc_enum(d: List[Str]) -> Str {
    var out = "pub enum " + d[1] + " \{ "
    var vs = d[3]
    var j: I32 = 1
    while j < vs.len {
        if j > 1 {
            out = out + ", "
        }
        var v = vs[j]
        out = out + v[1]
        var kind = v[2]
        if kind[0] == "KTuple" {
            out = out + "("
            var k: I32 = 1
            while k < kind.len {
                if k > 1 {
                    out = out + ", "
                }
                out = out + doc_ty(kind[k])
                k += 1
            }
            out = out + ")"
        } else if kind[0] == "KStruct" {
            out = out + " \{ " + doc_fields(kind) + " }"
        }
        j += 1
    }
    return out + " }"
}

fn doc_items(it: List[Str]) {
    // trait/impl 体:Method 与 fn 同形;PropSig/PropImpl 签名面
    var j: I32 = 1
    while j < it.len {
        var m = it[j]
        if m[0] == "Method" {
            println("  fn " + doc_fn_core(m))
        } else if or2(m[0] == "PropSig", m[0] == "PropImpl") {
            println("  prop " + m[1] + ": " + doc_ty(m[2]))
        }
        j += 1
    }
}

fn doc_trait(d: List[Str]) -> Str {
    // [Trait, name, TPs, Bounds, Items];返回头行,体由 doc_items 打印
    var out = "trait " + d[1] + doc_tps(d[2])
    var bd = d[3]
    if bd.len > 1 {
        out = out + ": "
        var k: I32 = 1
        while k < bd.len {
            if k > 1 {
                out = out + " + "
            }
            out = out + bd[k]
            k += 1
        }
    }
    return out
}

// ---------------- JSON 输出面(S0.5;--format=json|1 旗标优先,缺省回落 ANCHORFMT 锚)----------------
// schema v0(冻结):{"entry":..,"decls":N,"iface":[item…]},item 按源序:
//   fn/extern  {"kind","name","generics":[..],"params":[{"name","type","mutable"}|"vaargs"],"ret"}
//   struct     {"kind","name","generics","fields":[{"name","type","mutable"}]}
//   enum       {"kind","name","generics":[] ,"variants":[{"name","tuple":[..]}|"fields"]}
//   trait      {"kind","name","sigs":["fn .."|"prop .."]}
//   impl       {"kind":"impl","sig":"impl X for Y","sigs":[..]}
// 注:Ctron 字符串字面量内 JSON 花括号一律 \{ } 转义(插值语法,见 doc_struct 同因)。
fn doc_json_escape(s: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = s.len
    while j < n {
        var c = byte_at(s, j)
        if c == 34 {
            out = out + "\\\""
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else {
            out = out + byte_slice(s, j, j + 1)
        }
        j += 1
    }
    return out
}

fn doc_json_tps(tp: List[Str]) -> Str {
    if tp[0] != "TPs" || tp.len < 2 {
        return "[]"
    }
    var out = "["
    var j: I32 = 1
    while j < tp.len {
        if j > 1 {
            out = out + ","
        }
        out = out + "\"" + doc_json_escape(tp[j][1]) + "\""
        j += 1
    }
    return out + "]"
}

fn doc_json_params(ps: List[Str]) -> Str {
    var out = "["
    var j: I32 = 1
    while j < ps.len {
        if j > 1 {
            out = out + ","
        }
        var p = ps[j]
        if p[0] == "VaArgs" {
            out = out + "\{\"vaargs\":true}"
        } else {
            out = out + "\{\"name\":\"" + doc_json_escape(p[2]) + "\",\"type\":\"" + doc_json_escape(doc_ty(p[3])) + "\",\"mutable\":"
            if p[1] == "true" {
                out = out + "true"
            } else {
                out = out + "false"
            }
            out = out + "}"
        }
        j += 1
    }
    return out + "]"
}

fn doc_json_fnobj(d: List[Str], dc: Str) -> Str {
    // 返回不带外层花括号的字段串(供 doc_json_item 与 kind 键内联拼接)
    var out = "\"name\":\"" + doc_json_escape(d[1]) + "\",\"generics\":" + doc_json_tps(d[2]) + ",\"params\":" + doc_json_params(d[3])
    if d[4][0] == "None" {
        out = out + ",\"ret\":\"\""
    } else {
        out = out + ",\"ret\":\"" + doc_json_escape(doc_ty(d[4])) + "\""
    }
    out = out + ",\"doc\":\"" + doc_json_escape(dc) + "\""
    return out
}

fn doc_json_fields(fs: List[Str]) -> Str {
    var out = "["
    var j: I32 = 1
    while j < fs.len {
        if j > 1 {
            out = out + ","
        }
        var f = fs[j]
        out = out + "\{\"name\":\"" + doc_json_escape(f[2]) + "\",\"type\":\"" + doc_json_escape(doc_ty(f[3])) + "\",\"mutable\":"
        if f[1] == "true" {
            out = out + "true"
        } else {
            out = out + "false"
        }
        out = out + "}"
        j += 1
    }
    return out + "]"
}

fn doc_json_struct(d: List[Str], dc: Str) -> Str {
    return "\{\"kind\":\"struct\",\"name\":\"" + doc_json_escape(d[1]) + "\",\"generics\":" + doc_json_tps(d[3]) + ",\"fields\":" + doc_json_fields(d[4]) + ",\"doc\":\"" + doc_json_escape(dc) + "\"}"
}

fn doc_json_enum(d: List[Str], dc: Str) -> Str {
    var out = "\{\"kind\":\"enum\",\"name\":\"" + doc_json_escape(d[1]) + "\",\"generics\":[],\"variants\":["
    var vs = d[3]
    var j: I32 = 1
    while j < vs.len {
        if j > 1 {
            out = out + ","
        }
        var v = vs[j]
        out = out + "\{\"name\":\"" + doc_json_escape(v[1]) + "\""
        var kind = v[2]
        if kind[0] == "KTuple" {
            out = out + ",\"tuple\":["
            var k: I32 = 1
            while k < kind.len {
                if k > 1 {
                    out = out + ","
                }
                out = out + "\"" + doc_json_escape(doc_ty(kind[k])) + "\""
                k += 1
            }
            out = out + "]"
        } else if kind[0] == "KStruct" {
            out = out + ",\"fields\":" + doc_json_fields(kind)
        }
        out = out + "}"
        j += 1
    }
    return out + "],\"doc\":\"" + doc_json_escape(dc) + "\"}"
}

fn doc_json_sigs(it: List[Str]) -> Str {
    var out = "["
    var first = true
    var j: I32 = 1
    while j < it.len {
        var m = it[j]
        if m[0] == "Method" {
            if !first {
                out = out + ","
            }
            first = false
            out = out + "\"fn " + doc_json_escape(doc_fn_core(m)) + "\""
        } else if or2(m[0] == "PropSig", m[0] == "PropImpl") {
            if !first {
                out = out + ","
            }
            first = false
            out = out + "\"prop " + doc_json_escape(m[1]) + ": " + doc_json_escape(doc_ty(m[2])) + "\""
        }
        j += 1
    }
    return out + "]"
}

fn doc_json_item(d: List[Str], dc: Str) -> Str {
    if d[0] == "FnPub" {
        return "\{\"kind\":\"fn\"," + doc_json_fnobj(d, dc) + "}"
    }
    if d[0] == "FnExt" {
        return "\{\"kind\":\"extern\"," + doc_json_fnobj(d, dc) + "}"
    }
    if d[0] == "Struct" {
        return doc_json_struct(d, dc)
    }
    if d[0] == "Enum" {
        return doc_json_enum(d, dc)
    }
    if d[0] == "Trait" {
        return "\{\"kind\":\"trait\",\"name\":\"" + doc_json_escape(d[1]) + "\",\"sigs\":" + doc_json_sigs(d[4]) + "}"
    }
    return "\{\"kind\":\"impl\",\"sig\":\"impl " + doc_json_escape(doc_ty(d[2])) + " for " + doc_json_escape(doc_ty(d[3])) + "\",\"sigs\":" + doc_json_sigs(d[4]) + "}"
}

// ---------------- 契约注释抽取(§5.3 首片;入口源码行级,name-keyed,fmt 规范形态假设)----------------
// 模块头 = 入口源首个 // 块(第 1 行即 // 才计);per-fn = 紧邻 decl 行上方的连续 // 块,
// 仅匹配行首 pub 拼写(pub fn / pub struct / pub enum / pub extern)。空行断块;
// 私有 fn 不入账(行首无 pub 即不匹配,导入符号不被入口私有同名注释误附)。
fn doc_starts(s: Str, p: Str) -> Bool {
    if p.len > s.len {
        return false
    }
    var i: I32 = 0
    while i < p.len {
        if byte_at(s, i) != byte_at(p, i) {
            return false
        }
        i += 1
    }
    return true
}

fn doc_hmap_get(k: List[Str], v: List[Str], key: Str) -> Str {
    var i: I32 = 0
    while i < k.len {
        if k[i] == key {
            return v[i]
        }
        i += 1
    }
    return ""
}

fn doc_line_al(line: Str, from: I32) -> Str {
    // 从 from 起读标识符段(字符集同 lex is_al)
    var out = ""
    var j = from
    while j < line.len {
        var c = byte_at(line, j)
        if or2(or2(c >= 97 && c <= 122, c >= 65 && c <= 90), or2(c == 95, c >= 48 && c <= 57)) {
            out = out + byte_slice(line, j, j + 1)
            j += 1
        } else {
            return out
        }
    }
    return out
}

fn doc_com_text(line: Str) -> Str {
    // "// xxx" → "xxx";"//" → "";前缀必为 "//"(调用方已判)
    var body = byte_slice(line, 2, line.len)
    if body.len > 0 {
        if byte_at(body, 0) == 32 {
            return byte_slice(body, 1, body.len)
        }
    }
    return body
}

fn doc_scan_docs(s: Str, k: List[Str], v: List[Str]) {
    var com = ""
    var line = ""
    var i: I32 = 0
    var n = s.len
    // 模块头块整体跳过(头属模块,不附首个 decl;与 doc_module_doc 同判定)
    if n >= 2 && byte_at(s, 0) == 47 && byte_at(s, 1) == 47 {
        while i < n {
            var j2 = i
            while j2 < n && byte_at(s, j2) != 10 {
                j2 += 1
            }
            if j2 - i >= 2 && byte_at(s, i) == 47 && byte_at(s, i + 1) == 47 {
                i = j2 + 1
            } else {
                break
            }
        }
    }
    while i < n {
        var c = byte_at(s, i)
        if c == 10 {
            if line.len >= 2 && byte_at(line, 0) == 47 && byte_at(line, 1) == 47 {
                if com.len > 0 {
                    com = com + "\n"
                }
                com = com + doc_com_text(line)
            } else if line.len == 0 {
                // 空行:注释块与 decl 之间断开
                com = ""
            } else if com.len > 0 {
                // decl 行:按行首 pub 拼写落账
                var name = ""
                if doc_starts(line, "pub fn ") {
                    name = doc_line_al(line, 7)
                } else if doc_starts(line, "pub struct ") {
                    name = doc_line_al(line, 11)
                } else if doc_starts(line, "pub enum ") {
                    name = doc_line_al(line, 9)
                } else if doc_starts(line, "pub extern") {
                    // pub extern ["c"] fn <name>(
                    var q = 10
                    var fnpos: I32 = -1
                    while q + 4 <= line.len {
                        if or2(byte_at(line, q) != 32, or2(byte_at(line, q + 1) != 102, or2(byte_at(line, q + 2) != 110, byte_at(line, q + 3) != 32))) {
                            q += 1
                        } else {
                            fnpos = q + 4
                            q = line.len
                        }
                    }
                    if fnpos >= 0 {
                        name = doc_line_al(line, fnpos)
                    }
                }
                if name.len > 0 {
                    k.push(name)
                    v.push(com)
                }
                com = ""
            }
            line = ""
        } else {
            line = line + byte_slice(s, i, i + 1)
        }
        i += 1
    }
}

fn doc_module_doc(s: Str) -> Str {
    // 首个 // 块:第 1 行须以 // 开头,否则无模块头;连续 // 行收集,空行/非注释止
    var out = ""
    var i: I32 = 0
    var n = s.len
    if n < 2 || byte_at(s, 0) != 47 || byte_at(s, 1) != 47 {
        return ""
    }
    var first = true
    while i < n {
        var j = i
        while j < n && byte_at(s, j) != 10 {
            j += 1
        }
        var line = byte_slice(s, i, j)
        if line.len >= 2 && byte_at(line, 0) == 47 && byte_at(line, 1) == 47 {
            if !first {
                out = out + "\n"
            }
            first = false
            out = out + doc_com_text(line)
            i = j + 1
        } else {
            return out
        }
    }
    return out
}

fn doc_print_doc(t: Str) {
    // 文本面:// 前缀逐行还原;空串不出行
    if t.len == 0 {
        return
    }
    var cur = ""
    var i: I32 = 0
    var n = t.len
    while i < n {
        var c = byte_at(t, i)
        if c == 10 {
            if cur.len > 0 {
                println("// " + cur)
            } else {
                println("//")
            }
            cur = ""
        } else {
            cur = cur + byte_slice(t, i, i + 1)
        }
        i += 1
    }
    if cur.len > 0 {
        println("// " + cur)
    }
}


fn doc_std_mod(ep: Str) -> Str {
    // §5.3:"std.<module>" 形 → 实文件四级解析:①CTRON_STDPATH ②exe 旁 ../lib/ctron/std
    // ③cwd ./std(dev 仓库根)④cwd ../std(pkg_std_root 种子约定的 cwd 变体)
    var mod = byte_slice(ep, 4, ep.len)
    var envp = env_get("CTRON_STDPATH")
    if envp.len > 0 {
        if fs_exists(envp + "/" + mod + ".ct") {
            return envp + "/" + mod + ".ct"
        }
    }
    var exe = ctron_exe_path()
    if exe.len > 0 {
        var r = pkg_exe_dir(exe) + "/../lib/ctron/std"
        if fs_exists(r + "/" + mod + ".ct") {
            return r + "/" + mod + ".ct"
        }
    }
    if fs_exists("std/" + mod + ".ct") {
        return "std/" + mod + ".ct"
    }
    if fs_exists("../std/" + mod + ".ct") {
        return "../std/" + mod + ".ct"
    }
    return ""
}

fn main() -> I32 {
    var path = "ANCHORINPUT"
    var s = ""
    var have = false
    var epath = ctron_entry()
    if seq2(epath, "") {
        epath = path
    }
    match read_file("ANCHORINPUT") {
        Some(x) => {
            s = x
            have = true
        }
        None => {}
    }
    if !have {
        // §5.3:std.<module> 形(原生 CLI 直参;seed 面锚已 sed 换靶,不走此臂)
        if epath.len > 0 {
            if doc_starts(epath, "std.") {
                var mp = doc_std_mod(epath)
                if mp.len > 0 {
                    match read_file(mp) {
                        Some(x2) => {
                            s = x2
                            have = true
                            epath = mp
                        }
                        None => {}
                    }
                }
            }
        }
    }
    if !have {
        print("read-failed")
        return 1
    }
        var toks = List[Str]()
        var lns = List[Str]()
        var cols = List[Str]()
        var pdiags = List[Str]()
        scan4(s, toks, lns, cols, pdiags)
        var cur = Atomic[I32](0)
        var file = p_file(toks, cur, lns, cols, pdiags)
        if pdiags.len > 0 {
            var pi: I32 = 0
            while pi < pdiags.len {
                println(epath + ":" + pdiags[pi])
                pi += 1
            }
            return 1
        }
        var ldiags = List[Str]()
        var lstack = List[Str]()
        lstack.push(epath)
        file = pkg_load_use(file, pkg_dir_of(epath), lstack, ldiags)
        if ldiags.len > 0 {
            var li: I32 = 0
            while li < ldiags.len {
                println(ldiags[li])
                li += 1
            }
            return 1
        }
        var mdoc = doc_module_doc(s)
        var dk = List[Str]()
        var dv = List[Str]()
        doc_scan_docs(s, dk, dv)
        var dfmt = ctron_cli_flag("format")
        if dfmt.len == 0 {
            dfmt = "ANCHORFMT"
        }
        var isjson = or2(seq2(dfmt, "1"), seq2(dfmt, "json"))
        if isjson {
            print("\{\"entry\":\"" + doc_json_escape(epath) + "\",\"decls\":" + (file.len - 1).to_string() + ",\"doc\":\"" + doc_json_escape(mdoc) + "\",\"iface\":[")
        } else {
            println("iface " + epath + " decls=" + (file.len - 1).to_string())
            doc_print_doc(mdoc)
        }
        var syms: I32 = 0
        var first = true
        var i: I32 = 1
        while i < file.len {
            var d = file[i]
            var t = d[0]
            if doc_is_pub(d) {
                syms += 1
                var dc = doc_hmap_get(dk, dv, d[1])
                if isjson {
                    if !first {
                        print(",")
                    }
                    first = false
                    print(doc_json_item(d, dc))
                } else {
                    doc_print_doc(dc)
                    if t == "FnPub" {
                        println("pub fn " + doc_fn_core(d))
                    } else if t == "FnExt" {
                        println("pub extern " + doc_fn_core(d))
                    } else if t == "Struct" {
                        println(doc_struct(d))
                    } else if t == "Enum" {
                        println(doc_enum(d))
                    }
                }
            } else if t == "Trait" {
                if isjson {
                    if !first {
                        print(",")
                    }
                    first = false
                    print(doc_json_item(d, ""))
                } else {
                    println(doc_trait(d))
                    doc_items(d[4])
                }
            } else if t == "Impl" {
                if isjson {
                    if !first {
                        print(",")
                    }
                    first = false
                    print(doc_json_item(d, ""))
                } else {
                    println("impl " + doc_ty(d[2]) + " for " + doc_ty(d[3]))
                    doc_items(d[4])
                }
            }
            i += 1
        }
        if isjson {
            println("]}")
            return 0
        }
        println("iface symbols=" + syms.to_string())
    return 0
}
