// =====================================================================
// trans_ty.ct —— 发射器符号/类型基础:运算符表 ct_op·ct_aop、类型码 ct_ty_code·
// ct_ctype(i/s/b/f/L/A/N/a<v>/u:<名>)、fn 签名 ct_fn_ret·ct_fn_pcodes·ct_params_str、
// 发射期环境 env_bind·ct_env_ty·ct_typeof、C 字符串转义 ct_cstr·bsn。
// 约定:用户符号 t_ 前缀;运行时辅助 ctron_* 前缀;所有字符串模板中的 { 均写作
// \{(插值转义,镜像 C 词法器);\n 用 bs() 拼接。
// =====================================================================

fn bsn() -> Str {
    return "\\" + "n"
}

fn ct_op(op: Str) -> Str {
    if op == "Add" { return "+" }
    if op == "Sub" { return "-" }
    if op == "Mul" { return "*" }
    if op == "Div" { return "/" }
    if op == "Mod" { return "%" }
    if op == "Lt" { return "<" }
    if op == "Gt" { return ">" }
    if op == "Le" { return "<=" }
    if op == "Ge" { return ">=" }
    if op == "Eq" { return "==" }
    if op == "Ne" { return "!=" }
    if op == "AndAnd" { return "&&" }
    if op == "OrOr" { return "||" }
    panic("ct_op:" + op)
    return "?"
}

fn ct_aop(op: Str) -> Str {
    if op == "Eq" { return "=" }
    if op == "AddEq" { return "+=" }
    if op == "SubEq" { return "-=" }
    if op == "MulEq" { return "*=" }
    if op == "DivEq" { return "/=" }
    if op == "ModEq" { return "%=" }
    panic("ct_aop:" + op)
    return "?"
}

fn ct_env_has(env: List[Str], nm: Str) -> Bool {
    var key = nm + ":"
    var i: I32 = 0
    while i < env.len {
        if env[i].len >= key.len && byte_slice(env[i], 0, key.len) == key {
            return true
        }
        i += 1
    }
    return false
}

// 符号表: env 条目形如 "name:ty"(ty 为类型码);查找按 "name:" 前缀精确匹配,
// 新绑定插在表头 → 先命中(遮蔽语义)
fn ct_env_ty(env: List[Str], nm: Str) -> Str {
    var key = nm + ":"
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if en.len >= key.len && byte_slice(en, 0, key.len) == key {
            return byte_slice(en, key.len, en.len)
        }
        i += 1
    }
    return "i"
}

fn env_bind(env: List[Str], nm: Str, ty: Str) -> List[Str] {
    var out = List[Str]()
    out.push(nm + ":" + ty)
    var i: I32 = 0
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}

// 用户枚举查询:变体名 → 所属枚举名(未命中 → "");镜像 eval variant_arity 扫描
fn ct_enum_of_variant(file: List[Str], nm: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" {
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                if seq2(vs[j][1], nm) {
                    return d[1]
                }
                j += 1
            }
        }
        i += 1
    }
    return ""
}

// 变体在枚举内的序(构造字面量的 variant 下标)
fn ct_variant_index(file: List[Str], enm: Str, vnm: Str) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" && d[1] == enm {
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                if seq2(vs[j][1], vnm) {
                    return j - 1
                }
                j += 1
            }
        }
        i += 1
    }
    return 0 - 1
}

// T25:&Trait 虚表动态分发(§3.5);trait 名判定
fn ct_is_trait(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Trait" && d[1] == nm {
            return true
        }
        i += 1
    }
    return false
}

fn ct_is_enum(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" && d[1] == nm {
            return true
        }
        i += 1
    }
    return false
}

// 变体载荷槽类型码(KTuple 逐槽;KUnit → 空表)
fn ct_variant_pcodes(file: List[Str], enm: Str, vnm: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" && d[1] == enm {
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                if seq2(vs[j][1], vnm) {
                    var kd = vs[j][2]
                    if kd[0] == "KTuple" {
                        var k: I32 = 1
                        while k < kd.len {
                            out.push(ct_ty_code(kd[k], file))
                            k += 1
                        }
                    }
                    return out
                }
                j += 1
            }
        }
        i += 1
    }
    return out
}

// Named 类型节点 → 类型码;用户 struct → u:<名>(v4)
fn ct_ty_code(nt: List[Str], file: List[Str]) -> Str {
    if nt[0] == "FnType" {
        // F<arity>=返回标量;G<arity>=返回 fn 值(闭包)——返回型维度入码
        var fa = nt[1].len - 1
        // F0(零参)与 F1-F3 同族:ct_ctype 首字符泛化已认 F0,此前 fa<1 打回 "i"
        // 使 fn() -> T 形参/局部落 int32_t(发射缺口,p5_closures 探针实证)
        if or2(fa < 0, fa > 3) { return "i" }
        var fk = "F"
        if nt[2][0] == "FnType" { fk = "G" }
        return fk + fa.to_string()
    }
    if nt[0] == "Slice" {
        // §3.6 切片视图码:v<元素码>(单字符前缀,余串即元素码)
        return "v" + ct_ty_code(nt[1], file)
    }
    if nt[0] == "Ref" && nt[1].len > 1 && nt[1][0] == "Slice" {
        // &T[] 只读视图:v0 与可变视图同 C 表示(Send 区分在检查面)
        return "v" + ct_ty_code(nt[1][1], file)
    }
    // &Trait → t:<Trait>(T25;§3.5 trait 对象 = 胖指针 {data, vtable})
    if nt[0] == "Ref" && nt[1].len > 1 && nt[1][0] == "Named" {
        if ct_is_trait(file, nt[1][1]) {
            return "t:" + nt[1][1]
        }
        // &T 裸指针(v0.9·三 裁决:路径 1 选项 A——只过界,无取址/解引用语言面):
        // p<元素码> → C `T*`(ct_ctype 组合式:元素 C 型 + *)。此前无臂静默塌缩
        // int32(E4045 曾硬拦);内层 ArrayT(&T[N])不可表示,sem E4045 收窄保留
        return "p" + ct_ty_code(nt[1], file)
    }
    if nt[0] == "ArrayT" {
        // T[N] 定长注解 → 既有 a<N><ec> 内联码
        var an = "1"
        if nt[2].len > 1 && nt[2][0] == "Int" {
            an = num_text(nt[2][1])
        }
        return "a" + an + ct_ty_code(nt[1], file)
    }
    if nt[0] != "Named" { return "i" }
    // 泛型推断可产 2 槽裸 Named(无 TArgs 槽)——nt[2] 读取须先验 nt.len
    //(T45 探针实证:&T 字段单态化后 ct_ty_code OOB 读崩发射器)
    if nt[0] == "Named" && nt.len > 2 && nt[2].len > 1 {
        // Box[P] 注解 → B:P(堆单值指针;与构造点 typeof 同码);
        // 用户声明 Box struct 时走通用泛型实例路径
        if seq2(nt[1], "Box") {
            if ct_struct_tps(file, "Box").len == 0 {
                if nt[2][1][0] == "Named" {
                    return "B:" + nt[2][1][1]
                }
            }
        }
    }
    if nt[0] == "Named" && nt.len > 2 && nt[2].len > 1 {
        // 泛型 struct 实例化注解优先于具体 struct 分支
        if ct_struct_tps(file, nt[1]).len > 0 {
            var cs = List[Str]()
            var k1: I32 = 1
            while k1 < nt[2].len {
                cs.push(ct_ty_code(nt[2][k1], file))
                k1 += 1
            }
            return ct_struct_inst_code(nt[1], cs)
        }
    }
    if ct_is_struct(file, nt[1]) { return "u:" + nt[1] }
    if ct_is_enum(file, nt[1]) { return "E:" + nt[1] }
    if nt[1] == "Str" { return "s" }
    // String(§3.8.1 前奏类型表成员;§3.1 持有型):此前无臂静默塌缩 "i"
    //(int32_t)——注解位槽型/赋值/传参全错(p2 探针实证)。v1 口径:与 "s" 同
    // C 表示(const char*),独立面在 sem 键 n:String(E2010 单向门:String→Str
    // 隐式降格、Str→String 须 to_string 升格);独立码面(签名码/单态化键区分)
    // 登记债——"S" 已被 ct_inst_encode 的 Str 槽字母表占用,须连动两侧再立
    if nt[1] == "String" { return "s" }
    if nt[1] == "Bool" { return "b" }
    if nt[1] == "F64" { return "f" }
    // F32 独立码 "g"(v0.9 精度约定):此前折叠进 "f"(C double)致 extern
    // 边界 float/double ABI 错配(C 侧收 0);"g" → float,binary32 保真
    if nt[1] == "F32" { return "g" }
    if nt[1] == "I64" { return "6" }
    if nt[1] == "U8" { return "w8u" }
    if nt[1] == "I8" { return "w8s" }
    if nt[1] == "U16" { return "w16u" }
    if nt[1] == "I16" { return "w16s" }
    // USize 独立码 "z"(v0.7 §9.6):发射 size_t(target 真类型;U64 仍 uint64_t——
    // 二者宽度同但类型别名不同,直连 libc(size_t 形参/返回)不再重定义冲突;
    // eval 值域仍共享 "7",分层不动)
    if nt[1] == "USize" { return "z" }
    if nt[1] == "U64" { return "7" }
    if nt[1] == "ISize" { return "6" }
    if or2(nt[1] == "Result", nt[1] == "Option") { return "R" }
    if nt[0] == "Named" && nt.len > 2 && nt[2].len > 1 {
        // 泛型 struct 实例化注解:Pair[I32, Str] → u:Pair__I_S(实参限标量/Str)
        if ct_struct_tps(file, nt[1]).len > 0 {
            var cs = List[Str]()
            var k1: I32 = 1
            while k1 < nt[2].len {
                cs.push(ct_ty_code(nt[2][k1], file))
                k1 += 1
            }
            return ct_struct_inst_code(nt[1], cs)
        }
    }
    if nt[1] == "List" {
        // List[I32] → LI(元素槽 int);List[I64] → L6(T54:元素槽 int64 经 long 中转,
        // 消「List[I64] 索引读静默截断」在册债);List[<struct>] → Lu:<名>(T14-② 元素
        // 码贯通:push 装箱/索引取回按元素型);P0-A:元素为嵌套泛型实例(List[Route[S]]
        // 场,S 已具体化)→ Lu:名__尾缀 定型装箱槽(镜像 ct_typeof TypeArgs-List 臂,
        // 槽码缺臂时 Index 读落 "N"、Member 值位即 panic);其余维持 "L"(char* 槽)不动
        if nt.len > 2 && nt[2].len > 1 {
            if nt[2][1][0] == "Named" && nt[2][1][1] == "I32" { return "LI" }
            if nt[2][1][0] == "Named" && nt[2][1][1] == "I64" { return "L6" }
            // P0-A:List[fn(...)] → LF<签名码>(元素槽存 ct_clop 指针;签名段供
            // 闭包实参形参码 #clcodes 与 #fret 返回码——run_chain/not_found_h 链)
            if nt[2][1][0] == "FnType" {
                return "L" + ct_fsig_code(file, nt[2][1])
            }
            if nt[2][1][0] == "Named" && ct_is_struct(file, nt[2][1][1]) {
                if nt[2][1][2].len > 1 && ct_struct_tps(file, nt[2][1][1]).len > 0 {
                    var csL = List[Str]()
                    var qL: I32 = 1
                    while qL < nt[2][1][2].len {
                        csL.push(ct_ty_code(nt[2][1][2][qL], file))
                        qL += 1
                    }
                    return "L" + ct_struct_inst_code(nt[2][1][1], csL)
                }
                return "Lu:" + nt[2][1][1]
            }
        }
        return "L"
    }
    if or2(nt[1] == "Sender", or2(nt[1] == "Receiver", nt[1] == "Channel")) { return "h" }
    if nt[1] == "Atomic" { return "A" }
    // P0-A:Mutex[X] 注解 → m<X 码>(镜像 ct_typeof Call-TypeArgs 臂)。struct 字段
    // 注解位(App.todos: Mutex[List[Todo]])此前无臂落 "i"——槽型/布局/with 接收者
    // 三面全错
    if nt[1] == "Mutex" {
        if nt[2].len > 1 {
            return "m" + ct_ty_code(nt[2][1], file)
        }
        return "mi"
    }
    return "i"
}

// 类型码 → C 类型: i=I32 / s=Str / b=Bool / f=F64 / L=List / A=Atomic / N=节点引用 / 6=I64
// Phase 4 并发:g=ct_scope* / k=ct_task* / h=ct_chan* / R=ct_res(Result 值) /
//   m<内>=Mutex 单元(ct_mcell_<内>*)/ P<内>=内值指针伪码(with_mut 体内 Ident 解引用)
// List 码族:T14-② + T54 —— "L"(char* 槽)/"LI"(int 槽)/"L6"(int64 槽)/"Lu:<名>"(struct 装箱槽)
fn ct_is_lcode(code: Str) -> Bool {
    if code.len > 3 {
        if byte_slice(code, 0, 3) == "Lu:" {
            return true
        }
    }
    // P0-A:LF<签名码>(List[fn] 定型元素槽)同族——装箱/取回/列表 C 型共用
    if code.len > 2 {
        if byte_at(code, 0) == 76 && byte_at(code, 1) == 70 {
            return true
        }
    }
    return false
}

// T54:定型元素 List 码族(LI/L6/Lu:)——容器 C 型同为 ctron_list*,元素槽按码取回
fn ct_is_tlcode(code: Str) -> Bool {
    if code == "LI" { return true }
    if code == "L6" { return true }
    return ct_is_lcode(code)
}

fn ct_ctype(code: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        return "t_" + byte_slice(code, 2, code.len)
    }
    // T25:&Trait 胖指针(§3.5):{void* data; void* vtable}
    if code.len > 2 && byte_slice(code, 0, 2) == "t:" {
        return "ct_obj"
    }
    if code.len > 2 && byte_slice(code, 0, 2) == "B:" {
        // Box[T]:堆单值指针(t_P*);自动解引用由 Member/Assign 位处理
        return "t_" + byte_slice(code, 2, code.len) + "*"
    }
    if code == "s" { return "const char*" }
    if code == "N" { return "const char*" }
    if code == "b" { return "int" }
    if code == "f" { return "double" }
    if code == "g" { return "float" }
    if code.len > 1 && byte_at(code, 0) == 112 {
        // 裸指针码 p<ec>(v0.9·三 路径 1):C `T*` = 元素 C 型 + *(组合式,
        // 元素码任意合法型——标量/struct u:/Str s/嵌套 p 均自然成立)
        return ct_ctype(byte_slice(code, 1, code.len)) + "*"
    }
    if or2(code == "L", ct_is_tlcode(code)) { return "ctron_list*" }
    if code == "A" { return "ctron_cell*" }
    if code == "6" { return "int64_t" }
    if code == "7" { return "uint64_t" }
    if code == "z" { return "size_t" }
    if code == "w8u" { return "uint8_t" }
    if code == "w8s" { return "int8_t" }
    if code == "w16u" { return "uint16_t" }
    if code == "w16s" { return "int16_t" }
    if code == "v" { return "void" }
    if code.len > 1 && byte_at(code, 0) == 118 {
        // 视图码 v<ec>(§3.6 切片):typedef 名 = ctron_view_<元素码原文>(与 driver_emit 预发 typedef 对应)
        return "ctron_view_" + byte_slice(code, 1, code.len)
    }
    if code.len > 2 && byte_at(code, 0) == 113 {
        // SIMD 码 q<N><ec>(P1-C2 标量模拟):C 表示与视图同形
        var qi: I32 = 1
        while qi < code.len && is_digit(byte_at(code, qi)) { qi += 1 }
        return "ctron_view_" + byte_slice(code, qi, code.len)
    }
    if code.len > 2 && byte_slice(code, 0, 2) == "E:" {
        return "ct_enum_" + byte_slice(code, 2, code.len)
    }
    // fn 类型码 = F/G + 参数个数(十进制,任意位宽);F0(零参)/F4+ 与 F1-F3 同族,
    // 首字符判定——此前只枚举 1..3,fn()/fn() -> T 等落到默认 int32_t(发射缺口,
    // gui L1 注册表/零参钩子踩中,2026-09-19 SL-0 探针发现)
    if code.len > 1 {
        var fh: I32 = byte_at(code, 0)
        if or2(fh == 70, fh == 71) {
            var all_dg: Bool = true
            var di: I32 = 1
            while di < code.len {
                if !is_digit(byte_at(code, di)) {
                    // P0-A:签名尾段("F2{…}>r",LF 列表元素值码)同属 ct_clop 槽
                    if byte_at(code, di) == 123 {
                        di = code.len
                    } else {
                        all_dg = false
                        di = code.len
                    }
                }
                di += 1
            }
            if all_dg {
                return "ct_clop"
            }
        }
    }
    if code == "g" { return "ct_scope*" }
    if code == "k" { return "ct_task*" }
    if code == "h" { return "ct_chan*" }
    if code == "R" { return "ct_res" }
    if code.len > 1 && byte_at(code, 0) == 109 {
        var ir = byte_slice(code, 1, code.len)
        if ir.len > 2 && byte_slice(ir, 0, 2) == "u:" {
            ir = "u" + byte_slice(ir, 2, ir.len)
        }
        // P0-A:Lu: 内经同一 ct_mcell_tag 清洗(裸 "ct_mcell_Lu:X" 的冒号非法 C;
        // 与 ct_mcell_emit/with 锁面/cap_decl 三处同标签,约定一处)
        return "ct_mcell_" + ct_mcell_tag_inner(ir) + "*"
    }
    if code.len > 1 && byte_at(code, 0) == 80 {
        return ct_ctype(byte_slice(code, 1, code.len)) + "*"
    }
    return "int32_t"
}

// 枚举类型码剥前缀:E:<名> → <名>;非枚举码 → ""
fn ct_env_ename(code: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "E:" {
        return byte_slice(code, 2, code.len)
    }
    return ""
}

// 伪码归一:P<内> → 内(成员访问/字段域按内值型别解析)
fn ct_strip_p(code: Str) -> Str {
    if code.len > 1 && byte_at(code, 0) == 80 {
        return byte_slice(code, 1, code.len)
    }
    return code
}

// P0-A:fn 签名码拆解——"F2{u:Req__X;F1}>u:Resp" 形(LF 列表元素码的值码):
// ct_fsig_params → 花括号内 ';'-连接形参码串;ct_fsig_ret → '>' 后返回码。
// 无签名段(裸 F2/G1)→ ""(消费位按无提示回落)
fn ct_fsig_params(code: Str) -> Str {
    var b = -1
    var e = -1
    var i: I32 = 0
    while i < code.len {
        // 首枚 '{'(嵌套签名 F1{…} 作形参时,内层花括号不得覆盖外层起点);
        // 末枚 '}'(返回码在末枚之后)
        if b < 0 {
            if byte_at(code, i) == 123 {
                b = i
            }
        }
        if byte_at(code, i) == 125 {
            e = i
        }
        i += 1
    }
    if or2(b < 0, e <= b) {
        return ""
    }
    return byte_slice(code, b + 1, e)
}

fn ct_fsig_ret(code: Str) -> Str {
    // 从末枚 '}' 之后起扫 '>'——嵌套签名(F1{…}>r 作形参)内含 '>',首现即错
    var st: I32 = 0
    var i: I32 = 0
    while i < code.len {
        if byte_at(code, i) == 125 {
            st = i + 1
        }
        i += 1
    }
    while st < code.len {
        if byte_at(code, st) == 62 {
            return byte_slice(code, st + 1, code.len)
        }
        st += 1
    }
    return ""
}

// P0-A:签名段按位取("a;b;c" 第 k 段,0 基;越界 → "")——间接调用位闭包实参的
// #clcodes 源(trans_expr fn 值门)
fn ct_fseg_at(segs: Str, k: I32) -> Str {
    var cur: I32 = 0
    var si: I32 = 0
    var i: I32 = 0
    while i <= segs.len {
        // 边界序:先判 i==len 再取 byte_at(or2 不短路,OOB 读即脏)
        if i == segs.len {
            if cur == k {
                return byte_slice(segs, si, i)
            }
            return ""
        }
        if byte_at(segs, i) == 59 {
            if cur == k {
                return byte_slice(segs, si, i)
            }
            cur += 1
            si = i + 1
        }
        i += 1
    }
    return ""
}

// P0-A:FnType 节点 → 签名码("F2{u:Req__X;F1}>u:Resp";内参码 ';'-连接,
// 嵌套 fn 内参自带花括号不含 ';' 自然分段)
fn ct_fsig_code(file: List[Str], ft: List[Str]) -> Str {
    var fa = ft[1].len - 1
    var acc = ""
    var i: I32 = 1
    while i < ft[1].len {
        if i > 1 {
            acc = acc + ";"
        }
        // P0-A:fn 型内参递归签名码(续链形 fn(Req, fn(Req)->Resp)->Resp 的第二参
        // 须带自身签名,闭包实参 #clcodes 一层展开即得形参码;裸 ct_ty_code 落
        // "F1" 无签名段,展开空 → 形参退 int32)
        if ft[1][i][0] == "FnType" {
            acc = acc + ct_fsig_code(file, ft[1][i])
        } else {
            acc = acc + ct_ty_code(ft[1][i], file)
        }
        i += 1
    }
    // P0-A:返回面 fn 型递归签名(fn(…) -> fn(…) -> Resp 链;ret 尾 = 最内
    // 非 FnType 的返回码,ct_fsig_ret 末'}'后扫 '>' 即取)
    if ft[2][0] == "FnType" {
        return "F" + fa.to_string() + "\{" + acc + "}>" + ct_fsig_code(file, ft[2])
    }
    return "F" + fa.to_string() + "\{" + acc + "}>" + ct_ty_code(ft[2], file)
}

// P0-A:mcell C 标签清洗:冒号非法 C 标识符——u:X → uX(既有规则保形)、
// Lu:X → LuX;消费位 ct_ctype m 臂/trans_conc ct_mcell_tag(单一实现)
fn ct_mcell_tag_inner(inner: Str) -> Str {
    var acc = ""
    var i: I32 = 0
    while i < inner.len {
        if byte_at(inner, i) != 58 {
            acc = acc + byte_slice(inner, i, i + 1)
        }
        i += 1
    }
    return acc
}

// 用户 fn 返回类型码
fn ct_fn_ret(file: List[Str], nm: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) && d[1] == nm {
            var r = d[4]
            if r[0] == "None" { return "v" }
            if r[0] == "FnType" {
                // P0-A:值位返回码带签名(同 ct_generic_retcode 口径;闭包实参
                // 形参码/#fret 结构返回靠签名段)
                return ct_fsig_code(file, r)
            }
            // 守卫去除(v0.9·三):原 `!= Named → i` 把 Ref 返回(&T 裸指针,
            // p<ec> 码)塌成 int32;型节点统一交 ct_ty_code(各形态有臂)
            return ct_ty_code(r, file)
        }
        i += 1
    }
    return "i"
}

// fn 声明在案判定(四种 decl 均算;裸 fn 引用实参 fval 包装的判别位——
// 形参/局部持有的闭包值同名不在此列,旧 rfpcs.len>0 口径漏 0 参 fn)
fn ct_fn_decl_any(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) && d[1] == nm {
            return true
        }
        i += 1
    }
    return false
}

// 用户 fn 形参类型码表(按 Param 顺序)
fn ct_fn_pcodes(file: List[Str], nm: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) && d[1] == nm {
            var ps = d[3]
            var k: I32 = 1
            while k < ps.len {
                var pr = ps[k]
                if pr[0] == "Param" {
                    out.push(ct_ty_code(pr[3], file))
                }
                k += 1
            }
            return out
        }
        i += 1
    }
    return out
}

// fn 声明的 C 形参表(仅类型与名,用于原型前置与定义)
fn ct_params_str(d: List[Str], file: List[Str]) -> Str {
    var ps = d[3]
    var params = ""
    var k: I32 = 1
    var first = true
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            if !first { params = params + ", " }
            params = params + ct_ctype(ct_ty_code(pr[3], file)) + " t_" + pr[2]
            first = false
        }
        k += 1
    }
    return params
}

// extern "c" 边界 C 类型(§9.6 v0.6):fn 类型(F<arity>)映射裸 C 函数指针
// ct_fn1/2/3(Ctron 侧具名 fn 的地址零包装直传;捕获闭包已被 sem E4042 拦),
// 其余与内部表示一致(标量同宽;Str = char* 直通)
fn ct_abi_ctype(code: Str) -> Str {
    if code == "F0" { return "ct_fn0" }
    if code == "F1" { return "ct_fn1" }
    if code == "F2" { return "ct_fn2" }
    if code == "F3" { return "ct_fn3" }
    return ct_ctype(code)
}

// extern 声明的 C 形参表:fn 指针形参按边界映射(ct_fnK;区别于内部闭包对 ct_clop);
// VaArgs 尾标 → C "..."/.../ §9.6 v0.7 变参 extern
fn ct_params_str_ext(d: List[Str], file: List[Str]) -> Str {
    var ps = d[3]
    var params = ""
    var k: I32 = 1
    var first = true
    var hasva = false
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "VaArgs" {
            hasva = true
        }
        if pr[0] == "Param" {
            if !first { params = params + ", " }
            params = params + ct_abi_ctype(ct_ty_code(pr[3], file)) + " t_" + pr[2]
            first = false
        }
        k += 1
    }
    if hasva {
        if !first { params = params + ", " }
        params = params + "..."
    }
    return params
}

// 无名形参表(fn 指针 cast 用;C 抽象声明符不容形参名):"int64_t, int64_t" / 变参尾 "..."
fn ct_params_str_bare(d: List[Str], file: List[Str]) -> Str {
    var ps = d[3]
    var params = ""
    var k: I32 = 1
    var first = true
    var hasva = false
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "VaArgs" {
            hasva = true
        }
        if pr[0] == "Param" {
            if !first { params = params + ", " }
            params = params + ct_abi_ctype(ct_ty_code(pr[3], file))
            first = false
        }
        k += 1
    }
    if hasva {
        if !first { params = params + ", " }
        params = params + "..."
    }
    return params
}

// 空白trim(#[link] 实参清理用)
fn ct_trim(s: Str) -> Str {
    var a: I32 = 0
    var b = s.len
    while a < b && or2(or2(byte_at(s, a) == 32, byte_at(s, a) == 9), byte_at(s, a) == 10) {
        a += 1
    }
    while b > a {
        var d = byte_at(s, b - 1)
        if or2(d == 32, or2(d == 9, d == 10)) {
            b -= 1
        } else {
            return byte_slice(s, a, b)
        }
    }
    return ""
}

// 调用实参个数断言用(§四 #10):返回 "min|max"(max=-1 = 变参,实际须 ≥ min);未声明 → ""
// 十进制串 → I32(arity 串解析用;容负号)
fn ct_arity_parse(s: Str) -> I32 {
    var v: I32 = 0
    var i: I32 = 0
    var neg = false
    if s.len > 0 && byte_at(s, 0) == 45 {
        neg = true
        i = 1
    }
    while i < s.len {
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    }
    if neg {
        return 0 - v
    }
    return v
}

fn ct_arity_range(file: List[Str], nm: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(or2(d[0] == "Fn", d[0] == "FnPub"), or2(d[0] == "FnC", d[0] == "FnExt")) && d[1] == nm {
            var ps = d[3]
            var n: I32 = 0
            var va = false
            var k: I32 = 1
            while k < ps.len {
                if ps[k][0] == "VaArgs" {
                    va = true
                } else if ps[k][0] == "Param" {
                    n += 1
                }
                k += 1
            }
            if va {
                return n.to_string() + "|-1"
            }
            return n.to_string() + "|" + n.to_string()
        }
        i += 1
    }
    return ""
}

// extern 返回 Option[Str](§9.6 v0.8):C 侧真返回 const char*(NULL ↔ None),
// Ctron 侧落 ct_res 经既有 Option 机制消费
fn ct_ext_ret_optstr(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "FnExt" && d[1] == nm {
            var r = d[4]
            if r[0] == "Named" && seq2(r[1], "Option") {
                if r[2].len > 1 && r[2][1][0] == "Named" && seq2(r[2][1][1], "Str") {
                    return true
                }
            }
            return false
        }
        i += 1
    }
    return false
}

// extern "c" 声明的 C 符号名(v0.7 §9.6):默认裸名;#[link_name(x)] → x(符号重命名,
// 撞名/版本化免 c_src 垫片);#[dlsym] → 运行期解析 thunk ct_dyn_<名>(dlopen 面)
fn ct_ext_sym(file: List[Str], nm: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "FnExt" && d[1] == nm {
            if d.len > 7 {
                if attr_has(d[6], "link_name") {
                    return attr_arg(d[6])
                }
                if attr_has(d[6], "dlsym") {
                    return "ct_dyn_" + nm
                }
            }
            return nm
        }
        i += 1
    }
    return nm
}

// #[export] fn(v0.7 §9.6):导出包装的实参名串("t_a, t_b";调用直透 t_<名>)
fn ct_export_args(d: List[Str]) -> Str {
    var ps = d[3]
    var args = ""
    var k: I32 = 1
    var first = true
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            if !first { args = args + ", " }
            args = args + "t_" + pr[2]
            first = false
        }
        k += 1
    }
    return args
}

// #[repr(...)] 变体的 C 属性后缀(§9.6 v0.7):packed → __attribute__((packed));
// align(N) → __attribute__((aligned(N)));普通/无属性 → ""(声明序布局不受影响)
fn ct_struct_attr_suffix(sd: List[Str]) -> Str {
    if sd.len < 7 {
        return ""
    }
    if !attr_is(sd[5], "repr") {
        return ""
    }
    var rarg = attr_arg(sd[5])
    if seq2(rarg, "packed") {
        return "__attribute__((packed)) "
    }
    if rarg.len > 6 && seq2(byte_slice(rarg, 0, 6), "align(") {
        // align(N):取括号内数字串(N 可含嵌套前缀,此处仅收数字)
        var ai: I32 = 6
        var anum = ""
        while ai < rarg.len {
            var ac = byte_at(rarg, ai)
            if ac >= 48 && ac <= 57 {
                anum = anum + byte_slice(rarg, ai, ai + 1)
            }
            ai += 1
        }
        if anum.len > 0 {
            return "__attribute__((aligned(" + anum + "))) "
        }
    }
    return ""
}

// 实例化 struct 域类型:接收者码 u:<名>__<尾缀> 解码 + TPar 槽代入
fn ct_field_ty_inst(file: List[Str], inst: Str, fname: Str) -> Str {
    var info = ct_struct_inst_split(inst)
    var bar = 0
    var i: I32 = 0
    while i < info.len {
        if byte_at(info, i) == 124 { bar = i }
        i += 1
    }
    var snm = byte_slice(info, 0, bar)
    var codes = byte_slice(info, bar + 1, info.len)
    var tps = ct_struct_tps(file, snm)
    i = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == snm {
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len {
                var fd = fs[j]
                if fd[2] == fname {
                    return ct_field_code_inst(file, fd[3], snm, codes)
                }
                j += 1
            }
        }
        i += 1
    }
    return "i"
}

// 调用点实参转换:按形参类型码包转换(N→L/A 提升为指针,L→N/s 降为 char*)
// W 域位宽提取("w8u"→8,"w16s"→16;非 w 码 → 0)
fn w_bits_of(c: Str) -> I32 {
    if c.len > 1 && byte_at(c, 0) == 119 {
        if byte_at(c, 1) == 49 { return 16 }
        if byte_at(c, 1) == 56 { return 8 }
    }
    return 0
}

// 双操作数取较宽宽度域(镜像 eval w_arith 的 w_rank 规则)
fn w_code_wider(a: Str, b: Str) -> Str {
    if w_bits_of(b) > w_bits_of(a) { return b }
    return a
}

fn ct_arg_cast(ac: Str, pc: Str, x: Str) -> Str {
    if pc == "L" && ac != "L" { return "(ctron_list*)(" + x + ")" }
    // Lu: 族(T14-②):列表指针直通,同 L
    if ct_is_lcode(pc) && !ct_is_lcode(ac) { return "(ctron_list*)(" + x + ")" }
    // T25 &Trait(§3.5):具体型实参 → ct_obj 装箱(堆盒+vtable 常量取址)
    if pc.len > 2 && byte_slice(pc, 0, 2) == "t:" && ac.len > 2 && byte_slice(ac, 0, 2) == "u:" {
        var ttn25 = byte_slice(pc, 2, pc.len)
        var ctn25 = byte_slice(ac, 2, ac.len)
        var cty25 = ct_ctype(ac)
        return "(\{ ct_obj _o25; " + cty25 + "* _b25 = (" + cty25 + "*)ctron_amalloc(sizeof(" + cty25 + ")); *_b25 = " + x + "; _o25.data = _b25; _o25.vtable = (void*)&vt_" + ttn25 + "_for_" + ctn25 + "; _o25; })"
    }
    if pc == "A" && ac != "A" { return "(ctron_cell*)(" + x + ")" }
    if or2(pc == "s", pc == "N") && ac == "L" { return "(char*)(" + x + ")" }
    // §3.6 退化传参:内联定长数组实参 → 视图(首址+长度复合字面量,零拷贝)
    if pc.len > 1 && byte_at(pc, 0) == 118 && ac.len > 2 && byte_at(ac, 0) == 97 {
        return "(" + ct_ctype(pc) + ")\{ " + x + ", " + a_count(ac) + " }"
    }
    return x
}

// 表达式类型码: i/s/b/f/L/A/N;数组沿用 a<N><码> 编码
// StructLit 泛型实例化码:'#<名>' env 钉定优先(单态化体签名已钉);
// 否则场值码按"声明字段 → 型参槽"对齐推断槽码(裸 TPar 直取值码;
// List[TPar] 值码 LI→元素 i,其余→元素 s);非泛型 struct → ""
fn ct_structlit_inst(file: List[Str], e: List[Str], env: List[Str]) -> Str {
    if ct_struct_tps(file, e[1]).len == 0 { return "" }
    var inm7 = "#" + e[1]
    if ct_env_has(env, inm7) {
        return ct_env_ty(env, inm7)
    }
    var tpsg = ct_struct_tps(file, e[1])
    var lf = e[2]
    var slots = List[Str]()
    var zg: I32 = 0
    while zg < tpsg.len {
        slots.push("")
        zg += 1
    }
    var gj: I32 = 1
    while gj < lf.len {
        var vc = ct_typeof(lf[gj][2], env, file)
        var dj: I32 = 1
        while dj < file.len {
            var dd = file[dj]
            if dd[0] == "Struct" && dd[1] == e[1] {
                var fs3 = dd[4]
                var fj3: I32 = 1
                while fj3 < fs3.len {
                    if fs3[fj3][2] == lf[gj][1] {
                        var fty3 = fs3[fj3][3]
                        if fty3[0] == "Named" {
                            var k3: I32 = 0
                            while k3 < tpsg.len {
                                if seq2(fty3[1], tpsg[k3]) {
                                    slots[k3] = vc
                                }
                                k3 += 1
                            }
                            if fty3[1] == "List" && fty3[2].len > 1 && fty3[2][1][0] == "Named" {
                                var k4: I32 = 0
                                while k4 < tpsg.len {
                                    if seq2(fty3[2][1][1], tpsg[k4]) {
                                        if vc == "LI" {
                                            slots[k4] = "i"
                                        } else if vc == "L6" {
                                            slots[k4] = "6"
                                        } else if vc.len > 3 && byte_slice(vc, 0, 3) == "Lu:" {
                                            // P0-A:struct/实例元素槽 → 实参码回填(镜像 Lu: 定型)
                                            slots[k4] = "u:" + byte_slice(vc, 3, vc.len)
                                        } else {
                                            slots[k4] = "s"
                                        }
                                    }
                                    k4 += 1
                                }
                            }
                        } else if fty3[0] == "Ref" && fty3[1].len > 1 && fty3[1][0] == "Named" && fty3[1].len > 2 && fty3[1][2].len < 2 {
                            // T45:&T 字段槽推断(CBox 路径)——场值为指针(pu:<内层>)
                            // 剥 p 取内层码作槽(u:Thing/w8u 等);仅首层 Named 裸型参
                            var k5: I32 = 0
                            while k5 < tpsg.len {
                                if seq2(fty3[1][1], tpsg[k5]) {
                                    if vc.len > 1 && byte_at(vc, 0) == 112 {
                                        slots[k5] = byte_slice(vc, 1, vc.len)
                                    }
                                }
                                k5 += 1
                            }
                        }
                    }
                    fj3 += 1
                }
            }
            dj += 1
        }
        gj += 1
    }
    // P0-A:S 槽 env 兜底——单态化体 genv 绑「型参名→实参码」(trans_expr 特化位),
    // 型参仅嵌套现形(fn 型字段 Route.h: fn(Req[S]) -> Resp / List[Route[S]] 元素)时
    // 字面量值位推不出槽码,直接取 env 型参绑定;未绑仍 "" → ct_inst_encode 响亮
    // 失败(不静默错译)
    var zi2: I32 = 0
    while zi2 < tpsg.len {
        if slots[zi2].len == 0 {
            if ct_env_has(env, tpsg[zi2]) {
                slots[zi2] = ct_env_ty(env, tpsg[zi2])
            } else {
                panic("emit:实例槽未定:" + e[1] + " 型参" + tpsg[zi2] + " @" + nline(e))
            }
        }
        zi2 += 1
    }
    return ct_struct_inst_code(e[1], slots)
}

fn ct_typeof(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" {
        // 宽度后缀 → W 域码(P1-B2)
        if e[2].len == 3 {
            if seq2(e[2], "u8") { return "w8u" }
            if seq2(e[2], "i8") { return "w8s" }
            if seq2(e[2], "u16") { return "w16u" }
            if seq2(e[2], "i16") { return "w16s" }
        }
        if e[2].len == 0 {
            if lit_wide_i32(e[1]) {
                return "6"
            }
        }
        return "i"
    }
    if t == "Str" { return "s" }
    if t == "Bool" { return "b" }
    if t == "Float" { return "f" }
    if t == "Ident" {
        if seq2(e[1], "None") { return "R" }
        // T55:P<内> 是存储码非值型别码——值型别查询剥 P 按内值(不剥则闭包体内
        // `tag + ":"` 落裸 Ps+…分臂失败);裸存储消费方(Ident/Assign 发射走
        // ct_env_ty 原码)不受影响
        if ct_env_has(env, e[1]) { return ct_strip_p(ct_env_ty(env, e[1])) }
        // 全局 const:按注解型别(定义由 driver_emit 折叠直出)
        var ccn: I32 = 1
        while ccn < file.len {
            var cd = file[ccn]
            if cd[0] == "Const" && cd[1] == e[1] {
                return ct_ty_code(cd[2], file)
            }
            ccn += 1
        }
        var uen = ct_enum_of_variant(file, e[1])
        if uen.len > 0 { return "E:" + uen }
        // context-pointer 蹦床 fn 值(§9.6 v0.8)
        if seq2(e[1], "clo_cb2") { return "F2" }
        if seq2(e[1], "clo_cb3") { return "F3" }
        // 裸 fn 名值位置(§4.7):F<arity> 码——let 绑定/实参/间接调用全链类型化
        var fpc = ct_fn_pcodes(file, e[1])
        if or2(fpc.len == 1, or2(fpc.len == 2, fpc.len == 3)) {
            return "F" + fpc.len.to_string()
        }
        return "i"
    }
    if t == "Unary" {
        if e[1] == "Neg" { return ct_typeof(e[2], env, file) }
        return "b"
    }
    if t == "Binary" {
        // v0.8:or 取默认(§4.4)——结果类型随默认值(即载荷域);须在 Bool 兜底前拦截
        if e[1] == "Or" {
            return ct_typeof(e[3], env, file)
        }
        var arith = or2(e[1] == "Add", or3(e[1] == "Sub", or2(e[1] == "Mul", e[1] == "Div"), e[1] == "Mod"))
        if arith {
            // 算术:任一操作数为浮点 → f;任一为 Str/节点引用(仅 Add 拼接)→ s;否则 i
            var l = ct_typeof(e[2], env, file)
            var r = ct_typeof(e[3], env, file)
            if l.len > 1 && byte_at(l, 0) == 113 { return l }
            if r.len > 1 && byte_at(r, 0) == 113 { return r }
            if or2(l == "f", r == "f") { return "f" }
            if or2(l == "g", r == "g") { return "g" }
            if or2(l == "s", r == "s") { return "s" }
            if or2(l == "N", r == "N") { return "s" }
            if or2(l == "6", r == "6") { return "6" }
            return "i"
        }
        return "b"
    }
    if t == "StructLit" {
        var gi = ct_structlit_inst(file, e, env)
        if gi != "" { return gi }
        return "u:" + e[1]
    }
    if t == "Try" { return ct_try_elem(file, e, env) }
    if t == "Closure" {
        var cvn = e[1].len - 1
        // 零参闭包 || { } → F0(与 FnType 闸门同口径;此前落 "i" 使赋值目标丢 fn 型)
        if or2(cvn < 0, cvn > 3) { return "i" }
        return "F" + cvn.to_string()
    }
    if t == "If" {
        var th = e[2]
        if th.len == 2 && th[1][0] != "None" {
            return ct_typeof(th[1], env, file)
        }
        return "i"
    }
    if t == "Member" {
        if e[3] == "char_len" { return "i" }
        if e[3] == "len" { return "i" }
        if e[3] == "to_string" { return "s" }
        if e[3] == "lane" {
            var qrt = ct_typeof(e[1], env, file)
            if qrt.len > 1 && byte_at(qrt, 0) == 113 {
                // SIMD lane → 元素码(q<N><ec> 剥 N)
                var qi2: I32 = 1
                while qi2 < qrt.len && is_digit(byte_at(qrt, qi2)) { qi2 += 1 }
                return byte_slice(qrt, qi2, qrt.len)
            }
        }
        if e[3] == "splat" {
            var srt = ct_typeof(e[1], env, file)
            if srt.len > 1 && byte_at(srt, 0) == 113 { return srt }
        }
        if e[3] == "to_array" {
            var art = ct_typeof(e[1], env, file)
            if art.len > 1 && byte_at(art, 0) == 113 {
                // to_array → 视图码 v<ec>(发射恒等,标量模拟口径)
                var ai3: I32 = 1
                while ai3 < art.len && is_digit(byte_at(art, ai3)) { ai3 += 1 }
                return "v" + byte_slice(art, ai3, art.len)
            }
        }
        var oft0 = ct_typeof(e[1], env, file)
        var oft = ct_strip_p(oft0)
        // P0-A:&T 形参(pu: 码)字段读——解引用到 u: 查型(§4.9 借用语义)
        if oft.len > 3 && byte_slice(oft, 0, 3) == "pu:" {
            oft = "u:" + byte_slice(oft, 3, oft.len)
        }
        if oft.len > 2 && byte_slice(oft, 0, 2) == "u:" {
            if ct_struct_tps(file, ct_struct_name_of(oft)).len > 0 {
                return ct_field_ty_inst(file, oft, e[3])
            }
            return ct_field_ty(file, byte_slice(oft, 2, oft.len), e[3])
        }
        if oft.len > 2 && byte_slice(oft, 0, 2) == "B:" {
            // Box 自动解引用字段读:载荷 struct 的字段码
            return ct_field_ty(file, byte_slice(oft, 2, oft.len), e[3])
        }
        // Phase 4 并发成员
        if e[3] == "spawn" { return "k" }
        if e[3] == "join" { return "i" }
        if or2(e[3] == "join_or", or2(e[3] == "send", e[3] == "recv")) { return "R" }
        if e[3] == "fetch_add" { return "i" }
        if e[3] == "with_mut" { return "v" }
        if e[3] == "map" { return "L" }
        // T53:expect 静态型别=载荷码恢复(标量安全族直返)——旧硬编码 i 使
        // 推断 let 按 int32 消费(I64 载荷 >2^31 截断,F64 载荷错值);
        // Str/聚合码回落 i(裸槽按 int32 消费的 v0 行为不变,聚合消费走 match 臂)
        if e[3] == "expect" {
            var pecT = ct_opt_elem_expr(file, e[1], env)
            if or2(pecT == "f", or2(pecT == "6", or2(pecT == "7", or2(pecT == "z", pecT == "b")))) { return pecT }
            return "i"
        }
        if or2(e[3] == "reduce", or2(e[3] == "with", e[3] == "fetch_add")) { return "i" }
        if or2(e[3] == "is_err", e[3] == "is_ok") { return "b" }
    }
    if t == "TypeArgs" {
        // Simd[E,N](§9.5):q<N><ec> 向量码(P1-C2 标量模拟;C 表示复用 ctron_view_<ec>)
        if e[1].len > 1 && seq2(e[1][1], "Simd") && e[2].len > 2 {
            var qec = ct_ty_code(e[2][1], file)
            var qn = "4"
            if e[2][2].len > 1 {
                qn = num_text(e[2][2][1])
            }
            return "q" + qn + qec
        }
        return "i"
    }
    if t == "ArrLit" {
        var et = ct_typeof(e[1], env, file)
        return "a" + (e.len - 1).to_string() + et
    }
    if t == "Index" {
        var ot = ct_typeof(e[1], env, file)
        if ot.len >= 3 && byte_slice(ot, 0, 1) == "a" {
            return a_elem(ot)
        }
        if ot == "LI" { return "i" }
        // T54:List[I64] 索引产 I64(码 6;曾落 "N" 致 == 误走 strcmp 段错误)
        if ot == "L6" { return "6" }
        // Lu: 族(T14-②):索引产元素型(去 L 前缀)
        if ct_is_lcode(ot) { return byte_slice(ot, 1, ot.len) }
        if or2(ot == "L", ot == "N") { return "N" }
        return "i"
    }
    if t == "Call" {
        var cal = e[1]
        if cal[0] == "TypeArgs" {
            var base = cal[1]
            if base[0] == "Ident" {
                // 泛型实例化返回码:TPar 名 → 实参型别
                var gdecl2 = ct_fn_decl(file, base[1])
                if gdecl2.len > 0 && gdecl2[2].len > 1 {
                    var gtpsn = List[Str]()
                    var gtys = List[Str]()
                    var gg: I32 = 1
                    while gg < gdecl2[2].len {
                        gtpsn.push(gdecl2[2][gg][1])
                        gg += 1
                    }
                    gg = 1
                    while gg < cal[2].len {
                        // P0-A:实参节点经 env 代入(单态化体 genv 绑 型参→实参码;
                        // 裸 TPr 不代入则 Match[S] 落 TPar→"i" → u:Match__I 错实例)
                        gtys.push(ct_targ_env(cal[2][gg], env))
                        gg += 1
                    }
                    return ct_generic_retcode(file, base[1], gtpsn, gtys)
                }
            }
            if base[0] == "Ident" && base[1] == "Box" {
                // 用户声明了 Box struct(如 std 泛型化前探针)→ 走通用泛型实例路径
                if ct_struct_tps(file, "Box").len == 0 {
                    // Box[P](v) → B:P(堆单值指针;载荷 v0 限值类型)
                    if cal[2].len > 1 {
                        if cal[2][1][0] == "Named" {
                            return "B:" + cal[2][1][1]
                        }
                    }
                    return "B:V"
                }
            }
            if base[0] == "Ident" && base[1] == "List" {
                // List[I32] → LI(元素槽 int);List[I64] → L6(T54);List[<struct>] →
                // Lu:<名>(T14-②);型参实参经 env 替换码(单态化体;P0-A:struct/
                // 实例码同贯通);List[Inst[TPar]] 嵌套实例元素经 env 代入后取实例码;其余 → L
                // P0-A 序修正:嵌套实例元素臂前移——List[Route[I64]]() 场 Route 是
                // struct,旧序 ct_is_struct 臂短路 "Lu:Route"(无尾缀),push 位
                // "#名" 钉型与索引读解箱双双失据(Lu:Route 非实例码)
                if cal[2].len > 1 {
                    if cal[2][1][0] == "Named" {
                        if seq2(cal[2][1][1], "I32") { return "LI" }
                        if seq2(cal[2][1][1], "I64") { return "L6" }
                        // P0-A:List[fn(...)]() 构造 → LF<签名码>(与 ct_ty_code 注解臂同形)
                        if cal[2][1][0] == "FnType" {
                            return "L" + ct_fsig_code(file, cal[2][1])
                        }
                        if cal[2][1][2].len > 1 {
                            var sub8 = mk("Named")
                            sub8.push(cal[2][1][1])
                            var ta8 = mk("TArgs")
                            var t8: I32 = 1
                            while t8 < cal[2][1][2].len {
                                ta8.push(ct_targ_env(cal[2][1][2][t8], env))
                                t8 += 1
                            }
                            if ct_struct_tps(file, sub8[1]).len > 0 {
                                var cs8 = List[Str]()
                                var q8: I32 = 1
                                while q8 < sub8[2].len {
                                    cs8.push(ct_ty_code(sub8[2][q8], file))
                                    q8 += 1
                                }
                                return "L" + ct_struct_inst_code(sub8[1], cs8)
                            }
                        }
                        if ct_is_struct(file, cal[2][1][1]) { return "Lu:" + cal[2][1][1] }
                        if ct_env_has(env, cal[2][1][1]) {
                            var ec7 = ct_env_ty(env, cal[2][1][1])
                            if seq2(ec7, "i") { return "LI" }
                            if seq2(ec7, "6") { return "L6" }
                            if ec7.len > 2 && byte_slice(ec7, 0, 2) == "u:" { return "L" + ec7 }
                        }
                    }
                }
                return "L"
            }
            // arena.list[T]():与 List[T] 同型别(透明 arena,§5.3)
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "arena" && base[2] == "Nm" && base[3] == "list" {
                if cal[2].len > 1 {
                    if cal[2][1][0] == "Named" {
                        if seq2(cal[2][1][1], "I32") { return "LI" }
                        if seq2(cal[2][1][1], "I64") { return "L6" }
                    }
                }
                return "L"
            }
            if base[0] == "Ident" && base[1] == "Atomic" { return "A" }
            if base[0] == "Ident" && base[1] == "Channel" { return "h" }
            if base[0] == "Ident" && base[1] == "Global" { return "A" }
            if base[0] == "Ident" && base[1] == "Mutex" {
                var mit = "i"
                if e[2].len > 1 { mit = ct_typeof(e[2][1], env, file) }
                return "m" + mit
            }
            return "i"
        }
        if cal[0] == "Member" {
            var m = cal[3]
            if m == "or" {
                // .or(默认值)型别 = 默认实参型(P0-G)
                if e[2].len > 1 {
                    var oor = ct_typeof(e[2][1], env, file)
                    if oor.len > 0 {
                        return oor
                    }
                }
            }
            if m == "splat" {
                // Simd[F32,N].splat(v)(P1-C2):接收者为 TypeArgs-Simd → 同码传播
                var crt2 = ct_typeof(cal[1], env, file)
                if crt2.len > 1 && byte_at(crt2, 0) == 113 { return crt2 }
            }
            if m == "lane" {
                var lrt = ct_typeof(cal[1], env, file)
                if lrt.len > 1 && byte_at(lrt, 0) == 113 {
                    var li2: I32 = 1
                    while li2 < lrt.len && is_digit(byte_at(lrt, li2)) { li2 += 1 }
                    return byte_slice(lrt, li2, lrt.len)
                }
            }
            if m == "to_array" {
                var trt = ct_typeof(cal[1], env, file)
                if trt.len > 1 && byte_at(trt, 0) == 113 {
                    var ti3: I32 = 1
                    while ti3 < trt.len && is_digit(byte_at(trt, ti3)) { ti3 += 1 }
                    return "v" + byte_slice(trt, ti3, trt.len)
                }
            }
            if m == "load" { return "i" }
            if m == "to_string" { return "s" }
            if m == "title" { return "s" }
            if m == "set_title" { return "v" }
            if m == "show" {
                // @derive(Show)(§3d):结构接收者的 show 调用返回 Str(非结构仍走 UFCS 视角)
                var srt = ct_strip_p(ct_typeof(cal[1], env, file))
                if srt.len > 2 && byte_slice(srt, 0, 2) == "u:" { return "s" }
            }
            if m == "eq" {
                // @derive(Eq)(§3d):结构接收者的 eq 调用返回 Bool
                var crt = ct_strip_p(ct_typeof(cal[1], env, file))
                if crt.len > 2 && byte_slice(crt, 0, 2) == "u:" { return "b" }
            }
            if m == "push" { return "v" }
            if m == "store" { return "v" }
            if m == "spawn" { return "k" }
            if e[3] == "join" { return "i" }
            if or2(m == "join_or", or2(m == "send", m == "recv")) { return "R" }
            if m == "fetch_add" { return "i" }
            if m == "with_mut" { return "v" }
            if m == "map" { return "L" }
            // T53:expect 静态型别=载荷码恢复(与成员读位同口径;回落 i 同注)
            if m == "expect" {
                var pecC = ct_opt_elem_expr(file, cal[1], env)
                if or2(pecC == "f", or2(pecC == "6", or2(pecC == "7", or2(pecC == "z", pecC == "b")))) { return pecC }
                return "i"
            }
            if or2(m == "reduce", m == "with") { return "i" }
            if or2(m == "is_err", m == "is_ok") { return "b" }
            // P0-A:泛型成员调用(UFCS)返回实例化——.middleware(...) 链的接收者
            // 型别贯通:decl 首参 = 接收者型(Router[S])时,返回槽的 TPar 按接收者
            // 实例码尾缀具体化(Router[S] → Router__X);否则链式 .get/.post 的
            // 接收者落 TPar→"i" 错实例,特化面 __I/__L 劈叉无界增殖
            var gd29 = ct_fn_decl(file, m)
            if gd29.len > 0 && gd29[2].len > 1 {
                var rob29 = ct_strip_p(ct_typeof(cal[1], env, file))
                if rob29.len > 2 && byte_slice(rob29, 0, 2) == "u:" && ct_struct_inst_split(rob29).len > 1 {
                    var p0n29 = gd29[3][1][3]
                    var rt29 = gd29[4]
                    if p0n29[0] == "Named" && p0n29[2].len > 1 && rt29[0] == "Named" && rt29[2].len > 1 {
                        var info29 = ct_struct_inst_split(rob29)
                        var bar29: I32 = 0
                        var cq29: I32 = 0
                        while cq29 < info29.len {
                            if byte_at(info29, cq29) == 124 { bar29 = cq29 }
                            cq29 += 1
                        }
                        var codes29 = ct_inst_arg_codes(byte_slice(info29, bar29 + 1, info29.len))
                        var cs29 = List[Str]()
                        var w29: I32 = 1
                        var ok29 = true
                        while w29 < rt29[2].len {
                            var tpn29 = rt29[2][w29][1]
                            var found29 = "na"
                            var q29: I32 = 1
                            while q29 < p0n29[2].len {
                                if seq2(p0n29[2][q29][1], tpn29) {
                                    if q29 - 1 < codes29.len {
                                        found29 = codes29[q29 - 1]
                                    }
                                }
                                q29 += 1
                            }
                            if found29 == "na" {
                                ok29 = false
                                w29 = rt29[2].len
                            } else {
                                cs29.push(found29)
                            }
                            w29 += 1
                        }
                        if ok29 {
                            return ct_struct_inst_code(rt29[1], cs29)
                        }
                    }
                }
            }
            return ct_fn_ret(file, m)
        }
        if cal[0] == "Ident" {
            if or2(cal[1] == "Ok", or2(cal[1] == "Err", cal[1] == "Some")) { return "R" }
            var ten = ct_enum_of_variant(file, cal[1])
            if ten.len > 0 { return "E:" + ten }
            if cal[1] == "ctron_entry" { return "s" }
            if cal[1] == "utf8_enc" { return "s" }
            if cal[1] == "read_file" { return "s" }
            if cal[1] == "ctron_exe_path" { return "s" }
            if cal[1] == "env_get" { return "s" }
            if cal[1] == "ctron_cli_flag" { return "s" }
            if cal[1] == "read_dir" { return "s" }
            if or2(cal[1] == "fs_exists", or2(cal[1] == "fs_write", cal[1] == "fs_delete")) { return "b" }
            if cal[1] == "now_ms" { return "6" }
            if cal[1] == "now_ms_text" { return "s" }
            if cal[1] == "byte_at" { return "i" }
            if cal[1] == "byte_slice" { return "s" }
            if cal[1] == "str_from_c" { return "s" }
            // ptr_as_view(v0.9·五 裁决甲):&T 裸指针 → 只读视图;结果码 =
            // v<元素码>(p<ec> 剥壳);非 p 码实参回落 "i"(发射臂另响亮失败)
            if cal[1] == "ptr_as_view" {
                var pvc = ct_typeof(e[2][1], env, file)
                if pvc.len > 1 && byte_at(pvc, 0) == 112 {
                    return "v" + byte_slice(pvc, 1, pvc.len)
                }
                return "i"
            }
            // P0-3:fn 值调用(形参 env 命中 F/G 码)→ 返回型别取 #fret 侧条目
            //(ct_fn 绑定;聚合返回 → u:<名>,链上成员读/return 位全靠它);无条目 → 标量旧形态
            if ct_env_has(env, cal[1]) {
                // T55:fn 值捕获 P 绑(PF<arity>)同剥——否则体内 next(r) 的 #fret
                // 返回型解析漏臂(中间件形态)
                var cvt = ct_strip_p(ct_env_ty(env, cal[1]))
                if or2(byte_at(cvt, 0) == 70, byte_at(cvt, 0) == 71) {
                    var fk2 = "#fret:" + cal[1]
                    if ct_env_has(env, fk2) { return ct_env_ty(env, fk2) }
                    return "i"
                }
            }
            // T45:泛型直调返回码——推断单源回填槽后代入返回型(旧路径 TPar→"i"
            // 塌 CBox__I,与实发 __V 实例错型:CBox 式 let b = cbox_own(p) 即中)
            var gcd45 = ct_fn_decl(file, cal[1])
            if gcd45.len > 0 && gcd45[2].len > 1 {
                var gtpsn45 = List[Str]()
                var gq45: I32 = 1
                while gq45 < gcd45[2].len {
                    gtpsn45.push(gcd45[2][gq45][1])
                    gq45 += 1
                }
                var gtys45 = ct_call_infer_tys(file, env, e[2], cal[1])
                if gtys45.len == gtpsn45.len {
                    return ct_generic_retcode(file, cal[1], gtpsn45, gtys45)
                }
            }
            return ct_fn_ret(file, cal[1])
        }
    }
    return "i"
}

// Try 表达式的载荷型别码:被调声明的 Option/Result 首实参(Option[Str]→s;
// Result[I32,E]→i);泛型调用经替换后取;无法解析 → i(v0 载荷限标量/Str)
fn ct_opt_elem_strict(file: List[Str], nt: List[Str]) -> Str {
    if nt[0] == "Named" {
        if or2(seq2(nt[1], "Option"), seq2(nt[1], "Result")) {
            if nt[2].len > 1 {
                return ct_ty_code(nt[2][1], file)
            }
        }
    }
    return ""
}

fn ct_opt_elem_of(file: List[Str], nt: List[Str]) -> Str {
    if nt[0] == "Named" {
        if or2(seq2(nt[1], "Option"), seq2(nt[1], "Result")) {
            if nt[2].len > 1 {
                return ct_ty_code(nt[2][1], file)
            }
        }
        // 前奏泛型容器作载荷(P0-G):Result[List[…], E] → L 指针槽
        if seq2(nt[1], "List") {
            return "L"
        }
    }
    return "i"
}

fn ct_try_elem(file: List[Str], e: List[Str], env: List[Str]) -> Str {
    return ct_opt_elem_expr(file, e[1], env)
}

fn ct_opt_elem_expr(file: List[Str], inner: List[Str], env: List[Str]) -> Str {
    if inner[0] == "Ident" {
        // 参数/绑定:定义点绑定的 "#elem:<名>" 侧条目(Option/Result 实参元素码)
        var elv = "#elem:" + inner[1]
        if ct_env_has(env, elv) {
            return ct_env_ty(env, elv)
        }
        return "i"
    }
    if inner[0] == "Call" {
        var cal = inner[1]
        if cal[0] == "Ident" {
            var gd = ct_fn_decl(file, cal[1])
            if gd.len > 0 {
                return ct_opt_elem_of(file, gd[4])
            }
        }
        if cal[0] == "TypeArgs" {
            if cal[1][0] == "Ident" {
                var gd2 = ct_fn_decl(file, cal[1][1])
                if gd2.len > 0 && gd2[2].len > 1 && cal[2].len == gd2[2].len {
                    var tpsn = List[Str]()
                    var tys = List[Str]()
                    var g1: I32 = 1
                    while g1 < gd2[2].len {
                        tpsn.push(gd2[2][g1][1])
                        g1 += 1
                    }
                    var g2: I32 = 1
                    while g2 < cal[2].len {
                        tys.push(cal[2][g2])
                        g2 += 1
                    }
                    return ct_opt_elem_of(file, ct_mono_subst_ty(gd2[4], tpsn, tys))
                }
            }
        }
    }
    return "i"
}

// Text 载荷 → C 字符串字面量内容:转义序列逐字透传(\n/\t/\\" 在 C 同义),
// 仅 \{ 坍缩为 {、孤立 " 加反斜杠、真实换行转 \n(unesc 在此不可用:它会把
// \n 解析成真实换行打进 C 字面量,预处理直接断行)
fn ct_cstr(raw: Str) -> Str {
    var acc = ""
    var i: I32 = 0
    while i < raw.len {
        var b = byte_at(raw, i)
        if b == 34 {
            acc = acc + bs() + "\""
            i += 1
        } else if b == 92 {
            if i + 1 < raw.len {
                var nb = byte_at(raw, i + 1)
                if nb == 123 {
                    acc = acc + "\{"
                    i += 2
                } else {
                    acc = acc + bs() + byte_slice(raw, i + 1, i + 2)
                    i += 2
                }
            } else {
                acc = acc + bs()
                i += 1
            }
        } else if b == 10 {
            acc = acc + bs() + "n"
            i += 1
        } else {
            acc = acc + byte_slice(raw, i, i + 1)
            i += 1
        }
    }
    return acc
}

// 泛型 fn 声明查找(Fn/FnPub;未命中 → 空表)
fn ct_fn_decl(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", d[0] == "FnPub") && d[1] == nm {
            return d
        }
        i += 1
    }
    return List[Str]()
}

// 泛型实例化的返回类型码:ret 槽中 TPar 名 → 对应实参型别
fn ct_generic_retcode(file: List[Str], nm: Str, tpsn: List[Str], tys: List[Str]) -> Str {
    var gdecl = ct_fn_decl(file, nm)
    if gdecl.len == 0 { return "i" }
    var rt = ct_mono_subst_ty(gdecl[4], tpsn, tys)
    // P0-A:返回 fn 型 → 签名码(值位;闭包实参形参码/#fret 结构返回全靠签名段;
    // 槽位注解仍走 ct_ty_code 的裸 F<arity>)
    if rt[0] == "FnType" {
        return ct_fsig_code(file, rt)
    }
    return ct_ty_code(rt, file)
}

// 类型槽替换:Named(TPar 名) → 实参类型节点;容器注解(Map[K, V])实参递归下钻
// fn 型形参的内参码逗号串(A 块生产侧,§4 闭包 ABI):被调 callee 第 want 个
// 形参若为 FnType,返回内参码逗号串(如 "s" / "i,i");不适用 → ""。
// 防御口径:仅显式 FnType 形参参与;内参含未替换型参时按 ct_ty_code 兜底
// (通常落 "i",与旧行为一致);闭包实参之外的调用面永不触达
fn ct_fntype_pcodes(file: List[Str], callee: Str, want: I32) -> Str {
    return ct_fntype_pcodes_tg(file, callee, want, mk("None"))
}

// 带 TypeArgs 的变体:内参型参经调用点实参精确替换(泛型被调,§3.9.1)
fn ct_fntype_pcodes_tg(file: List[Str], callee: Str, want: I32, targs: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) && d[1] == callee {
            var ps = d[3]
            var k: I32 = 1
            var n: I32 = 0
            while k < ps.len {
                var pr = ps[k]
                if pr[0] == "Param" {
                    if n == want {
                        if pr[3][0] != "FnType" { return "" }
                        var ft = pr[3][1]
                        // 本被调的型参名表(d[2][0] 为头槽)与调用点实参节点表
                        var tpsn = List[Str]()
                        var g: I32 = 1
                        while g < d[2].len {
                            tpsn.push(d[2][g][1])
                            g += 1
                        }
                        // targs 剥头槽("TypeArgs")后的实参节点表,与 tpsn 对齐
                        var tys = List[Str]()
                        var g2: I32 = 1
                        while g2 < targs.len {
                            tys.push(targs[g2])
                            g2 += 1
                        }
                        var acc = ""
                        var j: I32 = 1
                        var first = true
                        while j < ft.len {
                            if !first { acc = acc + "," }
                            var inn = ft[j]
                            if targs.len > 1 {
                                if tys.len == tpsn.len {
                                    inn = ct_mono_subst_ty(inn, tpsn, tys)
                                }
                            }
                            if inn[0] == "FnType" {
                                acc = acc + ct_fsig_code(file, inn)
                            } else {
                                acc = acc + ct_ty_code(inn, file)
                            }
                            first = false
                            j += 1
                        }
                        return acc
                    }
                    n += 1
                }
                k += 1
            }
            return ""
        }
        i += 1
    }
    return ""
}

fn ct_mono_subst_ty(t: List[Str], tpsn: List[Str], tys: List[Str]) -> List[Str] {
    // P0-A:&T 透传下钻(&Req[S] 形参位的 S 槽代入;旧臂原样返回致 Req__I 错实例)
    if t[0] == "Ref" {
        var nr = mk("Ref")
        nr.push(ct_mono_subst_ty(t[1], tpsn, tys))
        return nr
    }
    if t[0] == "Named" {
        var k: I32 = 0
        while k < tpsn.len {
            if seq2(t[1], tpsn[k]) {
                return tys[k]
            }
            k += 1
        }
        if t[2].len > 1 {
            var nt = mk("Named")
            nt.push(t[1])
            var ta = mk("TArgs")
            var m2: I32 = 1
            while m2 < t[2].len {
                ta.push(ct_mono_subst_ty(t[2][m2], tpsn, tys))
                m2 += 1
            }
            nt.push(ta)
            return nt
        }
    }
    // P0-A:FnType 下钻——run_chain 型 List[fn(Req[S], …)] 形参的单态化,fn 内参
    // (Req[S]) 的 S 槽须随代入(旧臂原样返回,体内闭包形参码落 TPar→i 错实例)
    if t[0] == "FnType" {
        var nf = mk("FnType")
        var nps = mk("Ps")
        var p2: I32 = 1
        while p2 < t[1].len {
            nps.push(ct_mono_subst_ty(t[1][p2], tpsn, tys))
            p2 += 1
        }
        nf.push(nps)
        nf.push(ct_mono_subst_ty(t[2], tpsn, tys))
        return nf
    }
    return t
}

// 泛型 struct 型参名表(非泛型 → 空表)
fn ct_struct_tps(file: List[Str], nm: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == nm {
            var j: I32 = 1
            while j < d[3].len {
                out.push(d[3][j][1])
                j += 1
            }
            return out
        }
        i += 1
    }
    return out
}

// 实例化码 → 尾缀(P0-A 载荷扩位:标量/Str:i→I s→S b→B 6→L;
// struct 实参 u:<名>(具体或嵌套实例 u:名__尾缀)→ U<名长>_<名>,嵌入按值布局——
// 实例 typedef 字段槽即实参 C 型,与标量槽同构;长度前缀消歧名内下划线/尾缀字符。
// T45:标量字母表扩位 f/g/7/z/w8u/w8s/w16u/w16s(F/G/M/N/V/W/X/Y——大写单字符,
// 与 I/S/B/L 不撞;CBox[T]{var p:&T} 的 U8 槽即 V)——定长数组/F64 数组/List/fn 值/
// Result 载荷等仍 panic 登记债)
fn ct_inst_encode(code: Str) -> Str {
    if code == "i" { return "I" }
    if code == "s" { return "S" }
    if code == "b" { return "B" }
    if code == "6" { return "L" }
    if code == "f" { return "F" }
    if code == "g" { return "G" }
    if code == "7" { return "M" }
    if code == "z" { return "N" }
    if code == "w8u" { return "V" }
    if code == "w8s" { return "W" }
    if code == "w16u" { return "X" }
    if code == "w16s" { return "Y" }
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        var tail = byte_slice(code, 2, code.len)
        return "U" + tail.len.to_string() + "_" + tail
    }
    panic("emit:泛型 struct 载荷限标量/Str/struct:" + code)
    return ""
}

// 尾缀 → 码(标量单字符解码逆映射;变长 U 段经 ct_inst_arg_codes 位置解析)
fn ct_inst_decode(ch: Str) -> Str {
    if ch == "I" { return "i" }
    if ch == "S" { return "s" }
    if ch == "B" { return "b" }
    if ch == "L" { return "6" }
    if ch == "F" { return "f" }
    if ch == "G" { return "g" }
    if ch == "M" { return "7" }
    if ch == "N" { return "z" }
    if ch == "V" { return "w8u" }
    if ch == "W" { return "w8s" }
    if ch == "X" { return "w16u" }
    if ch == "Y" { return "w16s" }
    panic("emit:泛型 struct 尾缀不可解码:" + ch)
    return ""
}

// P0-A:实例化尾缀 → 实参码表(位置解析)。I/S/B/L 单字符;i/s/b/6 同旧;
// U<十进制长>_<名> → u:<名>(名可含下划线/嵌套实例尾缀,长度前缀定界)
fn ct_inst_arg_codes(encs: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 0
    while i < encs.len {
        var ch = byte_at(encs, i)
        if ch == 73 {
            out.push("i")
            i += 1
        } else if ch == 83 {
            out.push("s")
            i += 1
        } else if ch == 66 {
            out.push("b")
            i += 1
        } else if ch == 76 {
            out.push("6")
            i += 1
        } else if ch == 70 {
            out.push("f")
            i += 1
        } else if ch == 71 {
            out.push("g")
            i += 1
        } else if ch == 77 {
            out.push("7")
            i += 1
        } else if ch == 78 {
            out.push("z")
            i += 1
        } else if ch == 86 {
            out.push("w8u")
            i += 1
        } else if ch == 87 {
            out.push("w8s")
            i += 1
        } else if ch == 88 {
            out.push("w16u")
            i += 1
        } else if ch == 89 {
            out.push("w16s")
            i += 1
        } else if ch == 85 {
            var j = i + 1
            var nd = ""
            while j < encs.len && byte_at(encs, j) != 95 {
                nd = nd + byte_slice(encs, j, j + 1)
                j += 1
            }
            var nl = dvi(nd)
            out.push("u:" + byte_slice(encs, j + 1, j + 1 + nl))
            i = j + 1 + nl
        } else {
            panic("emit:泛型 struct 尾缀不可解析:" + byte_slice(encs, i, i + 1) + " @" + encs)
            return out
        }
    }
    return out
}

// P0-A:实例化码 → 具体型别节点(TPar 槽代入源;嵌套实例递归还原,
// 标量码还原 I32/Str/Bool/I64;ct_ty_code 对还原节点往返同码)
fn ct_inst_ty_node(code: Str) -> List[Str] {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        var nt = mk("Named")
        var ta = mk("TArgs")
        var info = ct_struct_inst_split(code)
        if info.len > 1 {
            var bar = 0
            var i: I32 = 0
            while i < info.len {
                if byte_at(info, i) == 124 { bar = i }
                i += 1
            }
            nt.push(byte_slice(info, 0, bar))
            var codes = ct_inst_arg_codes(byte_slice(info, bar + 1, info.len))
            var k: I32 = 0
            while k < codes.len {
                ta.push(ct_inst_ty_node(codes[k]))
                k += 1
            }
        } else {
            nt.push(ct_struct_name_of(code))
        }
        nt.push(ta)
        return nt
    }
    if code == "i" { return ct_scalar_ty("I32") }
    if code == "s" { return ct_scalar_ty("Str") }
    if code == "b" { return ct_scalar_ty("Bool") }
    if code == "6" { return ct_scalar_ty("I64") }
    // T45:标量字母表补全(镜像 ct_targ_env 还原臂;泛型直调 &T 形参推断经
    // "pu:<内层码>" 剥壳还原 w8u/f/g/7/z 等,否则响应亮 panic 堵 CBox 路径)
    if code == "f" { return ct_scalar_ty("F64") }
    if code == "g" { return ct_scalar_ty("F32") }
    if code == "7" { return ct_scalar_ty("U64") }
    if code == "z" { return ct_scalar_ty("USize") }
    if code == "w8u" { return ct_scalar_ty("U8") }
    if code == "w8s" { return ct_scalar_ty("I8") }
    if code == "w16u" { return ct_scalar_ty("U16") }
    if code == "w16s" { return ct_scalar_ty("I16") }
    panic("emit:实例码型别还原限标量/struct:" + code)
    return mk("Named")
}

// 实例化 struct 码:u:<名>__<尾缀>
fn ct_struct_inst_code(nm: Str, codes: List[Str]) -> Str {
    var suf = ""
    var i: I32 = 0
    while i < codes.len {
        suf = suf + ct_inst_encode(codes[i])
        i += 1
    }
    return "u:" + nm + "__" + suf
}

// 实例化码解码 → (名, 码表):u:Pair__I_S → Pair / [i, s]
fn ct_struct_inst_split(code: Str) -> Str {
    // 返回 "名|码1,码2" 复合串(单返回值约束)
    var head = 0
    var i: I32 = 2
    var nm = ""
    var sep = -1
    var done = false
    while i < code.len && !done {
        if byte_at(code, i) == 95 && i + 1 < code.len && byte_at(code, i + 1) == 95 {
            nm = byte_slice(code, 2, i)
            sep = i + 2
            done = true
        }
        i += 1
    }
    if sep < 0 { return "|" }
    return nm + "|" + byte_slice(code, sep, code.len)
}

// 实例化码 → struct 名(u:Pair__I_S → Pair;非实例化 u:X → X)
fn ct_struct_name_of(code: Str) -> Str {
    var i: I32 = 2
    while i + 1 < code.len {
        if byte_at(code, i) == 95 && byte_at(code, i + 1) == 95 {
            return byte_slice(code, 2, i)
        }
        i += 1
    }
    return byte_slice(code, 2, code.len)
}

// 实例化域字段码:P0-A 改写——实参码经 ct_inst_ty_node 还原型别节点,
// ct_mono_subst_ty 全树代入(裸 TPar/List[TPar]/List[Inst[TPar]]/嵌套实例一概贯通),
// 再 ct_ty_code 定槽码。此前仅手写两支(裸 TPar 单字符解码 + List[TPar] 下钻),
// struct 实参与嵌套实例无臂(泛型载荷扩位前不可达)
fn ct_field_code_inst(file: List[Str], ty: List[Str], snm: Str, encs: Str) -> Str {
    var tps = ct_struct_tps(file, snm)
    if tps.len == 0 {
        return ct_ty_code(ty, file)
    }
    var codes = ct_inst_arg_codes(encs)
    if codes.len != tps.len {
        panic("emit:泛型 struct 实参数与型参不符:" + snm + ":" + encs)
        return "i"
    }
    var tys = List[Str]()
    var k: I32 = 0
    while k < codes.len {
        tys.push(ct_inst_ty_node(codes[k]))
        k += 1
    }
    return ct_ty_code(ct_mono_subst_ty(ty, tps, tys), file)
}

// 嵌套泛型调用:型参实参经 env 解析(外层单态化点绑定的型参名 → 具体标量/Str 节点;
// 载荷限标量/Str 与实例码字母表同口径)
fn ct_scalar_ty(nm: Str) -> List[Str] {
    var nt = mk("Named")
    nt.push(nm)
    nt.push(mk("TArgs"))
    return nt
}

// P0-A′:List 型别节点构造(型参绑定容器码还原用)
fn ct_list_ty_node(el: List[Str]) -> List[Str] {
    var nt = mk("Named")
    nt.push("List")
    var ta = mk("TArgs")
    ta.push(el)
    nt.push(ta)
    return nt
}

// T45:泛型直调(无 TypeArgs 位)型参槽推断——trans_expr 发射位与 ct_typeof
// 返回码位共用的单源。种子 I32 节点(与 TPar→i 槽口径一致),三臂回填:
// ①裸 Named 型参直等 TP;②&T 型参剥 p 前缀取内层码(CBox 式 cbox_own[T](p:&T));
// ③带 TArgs 型参(CBox[T] 式)按实参实例尾缀解码回填同位槽。
fn ct_call_infer_tys(file: List[Str], env: List[Str], ag: List[Str], callee: Str) -> List[Str] {
    var pgd = ct_fn_decl(file, callee)
    var tpsn = List[Str]()
    var tys = List[Str]()
    if pgd.len == 0 || pgd[2].len < 2 {
        return tys
    }
    var gq: I32 = 1
    while gq < pgd[2].len {
        tpsn.push(pgd[2][gq][1])
        tys.push(ct_scalar_ty("I32"))
        gq += 1
    }
    var pj: I32 = 1
    while pj < pgd[3].len {
        if pj < ag.len {
            var pty = pgd[3][pj][3]
            if pty[0] == "Named" && pty.len > 2 && pty[2].len < 2 {
                var k0: I32 = 0
                while k0 < tpsn.len {
                    if seq2(pty[1], tpsn[k0]) {
                        tys[k0] = ct_inst_ty_node(ct_typeof(ag[pj], env, file))
                    }
                    k0 += 1
                }
            } else if pty[0] == "Ref" && pty[1].len > 1 && pty[1][0] == "Named" && pty[1].len > 2 && pty[1][2].len < 2 {
                var k1: I32 = 0
                while k1 < tpsn.len {
                    if seq2(pty[1][1], tpsn[k1]) {
                        var vc = ct_typeof(ag[pj], env, file)
                        if vc.len > 1 && byte_at(vc, 0) == 112 {
                            tys[k1] = ct_inst_ty_node(byte_slice(vc, 1, vc.len))
                        }
                    }
                    k1 += 1
                }
            } else if pty[0] == "Named" && pty.len > 2 && pty[2].len > 1 && ct_struct_tps(file, pty[1]).len > 0 {
                var vc2 = ct_typeof(ag[pj], env, file)
                if vc2.len > 2 && byte_slice(vc2, 0, 2) == "u:" {
                    var info2 = ct_struct_inst_split(vc2)
                    if info2.len > 1 && seq2(ct_struct_name_of(vc2), pty[1]) {
                        var bar2: I32 = 0
                        var q2: I32 = 0
                        while q2 < info2.len {
                            if byte_at(info2, q2) == 124 {
                                bar2 = q2
                            }
                            q2 += 1
                        }
                        var codes2 = ct_inst_arg_codes(byte_slice(info2, bar2 + 1, info2.len))
                        var stps = ct_struct_tps(file, pty[1])
                        var j2: I32 = 1
                        while j2 < pty[2].len {
                            if pty[2][j2][0] == "Named" {
                                var k2: I32 = 0
                                while k2 < tpsn.len {
                                    if seq2(pty[2][j2][1], tpsn[k2]) {
                                        var si: I32 = 0
                                        while si < stps.len {
                                            if seq2(stps[si], pty[2][j2][1]) {
                                                if si < codes2.len {
                                                    tys[k2] = ct_inst_ty_node(codes2[si])
                                                }
                                            }
                                            si += 1
                                        }
                                    }
                                    k2 += 1
                                }
                            }
                            j2 += 1
                        }
                    }
                }
            }
        }
        pj += 1
    }
    return tys
}

fn ct_targ_env(ty: List[Str], env: List[Str]) -> List[Str] {
    if ty[0] == "Named" {
        if ct_env_has(env, ty[1]) {
            var ec = ct_env_ty(env, ty[1])
            if seq2(ec, "i") { return ct_scalar_ty("I32") }
            if seq2(ec, "s") { return ct_scalar_ty("Str") }
            if seq2(ec, "b") { return ct_scalar_ty("Bool") }
            if seq2(ec, "6") { return ct_scalar_ty("I64") }
            // P0-A′:标量字母表补全(T↦f/g/7/z/w* 作裸实参)——此前无臂回落
            // TPar 节点,ct_ty_code 兜底塌 "i" → 跨特化同码误并(seen 集错码复用)
            if seq2(ec, "f") { return ct_scalar_ty("F64") }
            if seq2(ec, "g") { return ct_scalar_ty("F32") }
            if seq2(ec, "7") { return ct_scalar_ty("U64") }
            if seq2(ec, "z") { return ct_scalar_ty("USize") }
            if seq2(ec, "w8u") { return ct_scalar_ty("U8") }
            if seq2(ec, "w8s") { return ct_scalar_ty("I8") }
            if seq2(ec, "w16u") { return ct_scalar_ty("U16") }
            if seq2(ec, "w16s") { return ct_scalar_ty("I16") }
            // P0-A:型参绑定 struct/实例码 → 具体型别节点还原(泛型传型贯通)
            if ec.len > 2 && byte_slice(ec, 0, 2) == "u:" {
                return ct_inst_ty_node(ec)
            }
            // P0-A′:List 族码还原(T↦容器码作裸实参)——同上,塌 "i" 误并防堵;
            // "L" 素码元素不可知 → 空 TArgs 还原(ct_ty_code 回铸 "L",码忠实)
            if seq2(ec, "LI") { return ct_list_ty_node(ct_scalar_ty("I32")) }
            if seq2(ec, "L6") { return ct_list_ty_node(ct_scalar_ty("I64")) }
            if ec.len > 3 && byte_slice(ec, 0, 3) == "Lu:" {
                return ct_list_ty_node(ct_inst_ty_node("u:" + byte_slice(ec, 3, ec.len)))
            }
            if seq2(ec, "L") {
                // 素码 "L" 元素不可知 → 空 TArgs 还原(ct_ty_code 回铸 "L",码忠实)
                var nt9 = mk("Named")
                nt9.push("List")
                nt9.push(mk("TArgs"))
                return nt9
            }
        }
        // P0-A′:包装型实参深代入(Box2[T]/List[T] 等内含型参)——原样返回时内层
        // TPar 于 ct_ty_code 兜底塌 "i"(Box2[Box2[i]] 误铸 u:Box2__I 同码:seen 集
        // 在制复用即错码特化;发散新码链亦无法如实铸新)。逐槽递归重建,型参缺席
        // 时重建节点与原节点码等价(双调用点零扰动)
        if ty[2].len > 1 {
            var nps = mk("TArgs")
            var q2: I32 = 1
            while q2 < ty[2].len {
                nps.push(ct_targ_env(ty[2][q2], env))
                q2 += 1
            }
            var out = mk("Named")
            out.push(ty[1])
            out.push(nps)
            return out
        }
        // P0-A:TArgs 下钻——List[Route[S]] 型嵌套型参随 env 代入(注解位单态化;
        // 旧臂仅顶层替换,嵌套 TPar 落 ct_ty_code "i" → Lu:Route__I 错实例)
        if ty[2].len > 1 {
            var nt = mk("Named")
            nt.push(ty[1])
            var ta = mk("TArgs")
            var m3: I32 = 1
            while m3 < ty[2].len {
                ta.push(ct_targ_env(ty[2][m3], env))
                m3 += 1
            }
            nt.push(ta)
            return nt
        }
    }
    return ty
}

// P0-A:单态化链成员判定。chain 形如 ",t_a__i,t_b__u_App,"(首尾逗号卫兵),
// mg 为 C 标识符(含 _ 与字母数字,无逗号)→ 子串 ",mg," 即成员。
// 消费位:trans_expr 泛型特化 emit_def(链上同实例不再下钻,真递归收敛点)
fn ct_chain_has(chain: Str, mg: Str) -> Bool {
    var pat = "," + mg + ","
    if pat.len > chain.len {
        return false
    }
    var i: I32 = 0
    while i + pat.len <= chain.len {
        var ok = true
        var j: I32 = 0
        while j < pat.len {
            if byte_at(chain, i + j) != byte_at(pat, j) {
                ok = false
                j = pat.len
            }
            j += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}

// P0-A 扩位②:字段声明型别节点(具体 struct 场;未命中 → None 节点)。
// 消费位:StructLit 字段位闭包的形参码提示(#clcodes;fn 型字段载荷 T54/T55 面)
fn ct_field_ty_node(file: List[Str], snm: Str, fname: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == snm {
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len {
                if fs[j][2] == fname {
                    return fs[j][3]
                }
                j += 1
            }
        }
        i += 1
    }
    return mk("None")
}

// P0-A 扩位②:实例化场字段声明型别节点——型参经实例码还原节点全树代入
//(镜像 ct_field_code_inst,返回节点而非槽码;FnType 内参码须具体型才准)。
// 实参数不符 → 声明原样(与 ct_field_code_inst 的 panic 面分立:此处是提示位)
fn ct_field_ty_node_inst(file: List[Str], snm: Str, fname: Str, encs: Str) -> List[Str] {
    var ty = ct_field_ty_node(file, snm, fname)
    var tps = ct_struct_tps(file, snm)
    if or2(tps.len == 0, ty[0] != "FnType") {
        return ty
    }
    var codes = ct_inst_arg_codes(encs)
    if codes.len != tps.len {
        return ty
    }
    var tys = List[Str]()
    var k: I32 = 0
    while k < codes.len {
        tys.push(ct_inst_ty_node(codes[k]))
        k += 1
    }
    return ct_mono_subst_ty(ty, tps, tys)
}

// P0-A 扩位②:FnType 节点内参码串(逗号分隔,槽 1 起;非 FnType → "")。
// 消费位:StructLit 字段位闭包 #clcodes(ct_emit_clov 形参码提示;§4 闭包 ABI)
fn ct_fntype_inner(file: List[Str], ft: List[Str]) -> Str {
    if ft[0] != "FnType" {
        return ""
    }
    var acc = ""
    var i: I32 = 1
    while i < ft[1].len {
        if i > 1 {
            acc = acc + ","
        }
        // P0-A:fn 型内参带签名(续链形 fn(Req, fn(Req)->Resp)->Resp 的内参
        // 形参码须含返回面,#fret 才能原型化结构返回)
        if ft[1][i][0] == "FnType" {
            acc = acc + ct_fsig_code(file, ft[1][i])
        } else {
            acc = acc + ct_ty_code(ft[1][i], file)
        }
        i += 1
    }
    return acc
}
