// =====================================================================
// sem_type.ct —— E2020/E2010:名字解析与类型统一 v1(2026-09-09)
// seq2/prelude_ok/value_ok/prelude_arity/root_name/bind_pat 前奏助手;ty_kind/k_*/compat
// 类型域;ex_ty 表达式类型推导;tce/tcb 全文件下钻(E2010 保守统一:任一侧未知放行)。
// =====================================================================
fn seq2(a: Str, b: Str) -> Bool {
    if a.len != b.len { return false }
    var j: I32 = 0
    while j < a.len {
        if byte_at(a, j) != byte_at(b, j) { return false }
        j += 1
    }
    return true
}


// ---------------- E2020/E2010:名字解析与类型统一 v1(2026-09-09) ----------------
// 范围:bare 调用目标 + Ident 读解析 + 基础类型统一(let/return/实参/二元/条件/? )。
// 成员调用面(UFCS/方法表解析)与内建类型留 v2。保守可证:任一侧类型未知即放行;
// 字面量按期望整/浮自适应(§3.7);T→T?、String→Str、T[N]→T[] 按 §3.6 白名单放行。
// tc 打包:tc[0]=fns tc[1]=ars tc[2]=rets tc[3]=prms tc[4]=stN tc[5]=stT
//          tc[6]=vars tc[7]=varAr tc[8]=enums tc[9]=lets tc[10]=reads
//          tc[11]=isrc(插值原文) tc[12]=prel(前奏名,W8040) tc[13]=tpars(类型参数名)
fn prelude_ok(nm: Str) -> Bool {
    if or2(seq2(nm, "print"), or2(seq2(nm, "println"), seq2(nm, "panic"))) { return true }
    if or2(seq2(nm, "assert"), or2(seq2(nm, "assert_eq"), seq2(nm, "assert_ne"))) { return true }
    if or2(seq2(nm, "read_file"), or2(seq2(nm, "read_dir"), or2(seq2(nm, "fs_exists"), or2(seq2(nm, "fs_write"), seq2(nm, "fs_delete"))))) { return true }
    if or2(seq2(nm, "byte_at"), or2(seq2(nm, "byte_slice"), seq2(nm, "utf8_enc"))) { return true }
    if or2(seq2(nm, "now_ms"), seq2(nm, "now_ms_text")) { return true }
    if seq2(nm, "ctron_entry") { return true }
    if or2(seq2(nm, "Some"), or2(seq2(nm, "None"), or2(seq2(nm, "Ok"), seq2(nm, "Err")))) { return true }
    if or2(seq2(nm, "fmt"), or2(seq2(nm, "char_len"), or2(seq2(nm, "Box"), seq2(nm, "List")))) { return true }
    if or2(seq2(nm, "String"), or2(seq2(nm, "Channel"), or2(seq2(nm, "Mutex"), seq2(nm, "Atomic")))) { return true }
    if or2(seq2(nm, "Global"), or2(seq2(nm, "Task"), or2(seq2(nm, "Scope"), seq2(nm, "Simd")))) { return true }
    return or2(seq2(nm, "Option"), or2(seq2(nm, "Result"), seq2(nm, "AnyError")))
}

fn value_ok(nm: Str) -> Bool {
    if prelude_ok(nm) { return true }
    return or2(seq2(nm, "parallel"), seq2(nm, "arena"))
}

fn prelude_arity(nm: Str) -> I32 {
    if or2(seq2(nm, "Some"), or2(seq2(nm, "Ok"), seq2(nm, "Err"))) { return 1 }
    if seq2(nm, "None") { return 0 }
    return -1
}

fn root_name(e: List[Str]) -> Str {
    var t = e[0]
    if t == "Ident" { return e[1] }
    if t == "TypeArgs" { return root_name(e[1]) }
    return ""
}

fn bind_pat(pp: List[Str], loc: List[Str], envT: List[Str], tn: List[Str]) {
    var t = pp[0]
    if t == "PatId" {
        loc.push(pp[1])
        envT.push(tn)
    } else if t == "PatTup" {
        var i: I32 = 1
        while i < pp.len {
            bind_pat(pp[i], loc, envT, unk())
            i += 1
        }
    } else if t == "PatAgg" {
        if pp.len > 2 {
            var sub = pp[2]
            var j: I32 = 1
            while j < sub.len {
                var c = sub[j]
                if seq2(c[0], "PatFld") {
                    if c[2].len > 1 {
                        bind_pat(c[2], loc, envT, unk())
                    } else {
                        loc.push(c[1])
                        envT.push(unk())
                    }
                } else {
                    bind_pat(c, loc, envT, unk())
                }
                j += 1
            }
        }
    }
}

// 类型 kind(§3.1):n:<名> / opt:<内> / ref:<内> / slice / arr / tup / fn / ""=未知
fn ty_kind(ty: List[Str]) -> Str {
    var t = ty[0]
    if t == "Named" {
        return "n:" + ty[1]
    }
    if t == "Optional" {
        return "opt:" + ty_kind(ty[1])
    }
    if t == "Ref" {
        return "ref:" + ty_kind(ty[1])
    }
    if t == "Slice" {
        return "slice"
    }
    if t == "ArrayT" {
        return "arr"
    }
    if t == "TupleT" {
        return "tup"
    }
    if or2(t == "FnT", t == "FnType") {
        return "fn"
    }
    return ""
}

fn k_int5(k: Str) -> Bool {
    return or2(seq2(k, "n:I8"), or2(seq2(k, "n:I16"), or2(seq2(k, "n:I32"), or2(seq2(k, "n:I64"), seq2(k, "n:ISize")))))
}

fn k_uint5(k: Str) -> Bool {
    return or2(seq2(k, "n:U8"), or2(seq2(k, "n:U16"), or2(seq2(k, "n:U32"), or2(seq2(k, "n:U64"), seq2(k, "n:USize")))))
}

fn k_int(k: Str) -> Bool {
    return or2(k_int5(k), k_uint5(k))
}

fn k_num(k: Str) -> Bool {
    if k_int(k) {
        return true
    }
    return or2(seq2(k, "n:F32"), seq2(k, "n:F64"))
}

fn k_strish(k: Str) -> Bool {
    return or2(seq2(k, "n:Str"), seq2(k, "n:String"))
}

// 相容性:未知放行;相等放行;Int 字面量适配数值期望、Float 字面量适配浮期望(§3.7);
// T→T?、String→Str、T[N]→T[] 隐式(§3.6);其余不相容。
// 常量字面量折叠表达式(Int/一元负号/二元算术全字面量)——按 §3.7 自适应数值期望
fn all_int_lit(e: List[Str]) -> Bool {
    var t = e[0]
    if t == "Int" {
        return true
    }
    if t == "Unary" {
        return all_int_lit(e[2])
    }
    if seq2(t, "Binary") {
        var op = e[1]
        if or2(seq2(op, "Add"), or2(seq2(op, "Sub"), or2(seq2(op, "Mul"), or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "WrapAdd"), seq2(op, "WrapSub"))))))) {
            return all_int_lit(e[2]) && all_int_lit(e[3])
        }
    }
    return false
}

// E2040 字面量宽度门(§3.7 自适应的宽度约束):Int/一元负 Int 字面量须落在
// 期望整数类型界内。v0 口径:仅纯十进制、无后缀字面量;二进制折叠表达式、
// 0x/0o/0b、comptime 域不查(§3.1.1)。
fn lit_fit_gate(expk: Str, e: List[Str], ln: Str, diags: List[Str]) {
    if expk.len < 3 {
        return
    }
    if !seq2(byte_slice(expk, 0, 2), "n:") {
        return
    }
    var tn = byte_slice(expk, 2, expk.len)
    var neg = false
    var lit = e
    if seq2(e[0], "Unary") {
        if or2(!seq2(e[1], "Neg"), e.len < 3) {
            return
        }
        neg = true
        lit = e[2]
    }
    if !seq2(lit[0], "Int") {
        return
    }
    // Int 节点恒为 ["Int", 文本, 后缀];带后缀字面量 v0 不查
    if lit[2].len > 0 {
        return
    }
    if !lit_is_dec(lit[1]) {
        return
    }
    var bound = ""
    if k_int5(expk) {
        // 有符号:正界 2^(w-1)-1,负字面量幅度界 2^(w-1)
        if seq2(tn, "I8") {
            bound = "127"
            if neg {
                bound = "128"
            }
        }
        if seq2(tn, "I16") {
            bound = "32767"
            if neg {
                bound = "32768"
            }
        }
        if seq2(tn, "I32") {
            bound = "2147483647"
            if neg {
                bound = "2147483648"
            }
        }
        if seq2(tn, "I64") {
            bound = "9223372036854775807"
            if neg {
                bound = "9223372036854775808"
            }
        }
        if seq2(tn, "ISize") {
            bound = "9223372036854775807"
            if neg {
                bound = "9223372036854775808"
            }
        }
    }
    if k_uint5(expk) {
        // 无符号:单一上界;负字面量 v0 不查(放行)
        if seq2(tn, "U8") {
            bound = "255"
        }
        if seq2(tn, "U16") {
            bound = "65535"
        }
        if seq2(tn, "U32") {
            bound = "4294967295"
        }
        if or2(seq2(tn, "U64"), seq2(tn, "USize")) {
            bound = "18446744073709551615"
        }
        if neg {
            bound = ""
        }
    }
    if bound.len == 0 {
        return
    }
    if c6abscmp(lit_digits(lit[1]), bound) <= 0 {
        return
    }
    diags.push("E2040@" + ln + ": 字面量超出期望整数类型宽度(期望 " + expk + "):" + lit[1])
}

fn compat(exp: Str, act: Str, e: List[Str], file: List[Str], tc: List[Str]) -> Bool {
    if exp.len == 0 {
        return true
    }
    if act.len == 0 {
        return true
    }
    if seq2(exp, act) {
        return true
    }
    // 泛型类型参数期望(单态化前不可证)放行
    if in_list(tc[13], exp) {
        return true
    }
    if exp.len > 4 && seq2(byte_slice(exp, 0, 4), "ref:") {
        var tn = byte_slice(exp, 4, exp.len)
        if seq2(byte_slice(tn, 0, 2), "n:") {
            if is_trait(file, byte_slice(tn, 2, tn.len)) {
                return true
            }
        }
    }
    if seq2(byte_slice(exp, 0, 2), "n:") {
        if is_trait(file, byte_slice(exp, 2, exp.len)) {
            return true
        }
    }
    if all_int_lit(e) {
        return k_num(exp)
    }
    var t = e[0]
    if t == "Int" {
        return k_num(exp)
    }
    if t == "Float" {
        return or2(seq2(exp, "n:F32"), seq2(exp, "n:F64"))
    }
    if exp.len >= 4 && seq2(byte_slice(exp, 0, 4), "opt:") {
        return seq2(exp, "opt:" + act)
    }
    if seq2(exp, "n:Str") {
        return seq2(act, "n:String")
    }
    if seq2(exp, "slice") {
        return seq2(act, "arr")
    }
    if seq2(exp, "ref:slice") {
        return or2(seq2(act, "slice"), seq2(act, "arr"))
    }
    return false
}

// 节点行号(解析器 span 标注:末槽十进制数字串;无/非法 → "0" 由驱动回退探针)
fn nline(n: List[Str]) -> Str {
    if n.len == 0 {
        return "0"
    }
    var last = n[n.len - 1]
    var i: I32 = 0
    while i < last.len {
        var c = byte_at(last, i)
        var dig = true
        if c < 48 {
            dig = false
        }
        if c > 57 {
            dig = false
        }
        if !dig {
            return "0"
        }
        i += 1
    }
    if last.len == 0 {
        return "0"
    }
    return last
}

// "已知局部、类型未知"哨兵:阻断 Ident 解析穿透到 fn 名集(同名遮蔽语义)
fn unk() -> List[Str] {
    var u = List[Str]()
    u.push("Unknown")
    return u
}

fn kind_node(k: Str) -> List[Str] {
    if k.len >= 2 && seq2(byte_slice(k, 0, 2), "n:") {
        var nt = List[Str]()
        nt.push("Named")
        nt.push(byte_slice(k, 2, k.len))
        nt.push(List[Str]())
        return nt
    }
    return unk()
}

fn idx_of(ls: List[Str], nm: Str) -> I32 {
    var i: I32 = 0
    while i < ls.len {
        if seq2(ls[i], nm) {
            return i
        }
        i += 1
    }
    return -1
}

fn fn_ret_of(tc: List[Str], nm: Str) -> List[Str] {
    var g: I32 = 0
    while g < tc[0].len {
        if seq2(tc[0][g], nm) {
            return tc[2][g]
        }
        g += 1
    }
    return List[Str]()
}

fn ex_ty(e: List[Str], tc: List[Str], loc: List[Str], envT: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" {
        return "n:I32"
    }
    if t == "Float" {
        return "n:F64"
    }
    if t == "Str" {
        return "n:Str"
    }
    if t == "Bool" {
        return "n:Bool"
    }
    if t == "Void" {
        return "void"
    }
    if t == "Range" {
        return "range"
    }
    if t == "Ident" {
        var nm = e[1]
        var b = env_ty(loc, envT, nm)
        if b.len > 0 {
            return ty_kind(b)
        }
        var g = env_ty(tc[4], tc[5], nm)
        if g.len > 0 {
            return ty_kind(g)
        }
        if in_list(tc[0], nm) {
            return "fn"
        }
        return ""
    }
    if t == "Closure" {
        return "fn"
    }
    if t == "StructLit" {
        return "n:" + e[1]
    }
    if t == "Call" {
        var rt = root_name(e[1])
        if rt.len > 0 {
            var r = fn_ret_of(tc, rt)
            if r.len > 0 {
                return ty_kind(r)
            }
        }
        return ""
    }
    if t == "Unary" {
        if seq2(e[1], "Not") {
            return "n:Bool"
        }
        return ex_ty(e[2], tc, loc, envT)
    }
    if t == "If" {
        var a = ex_ty(e[2], tc, loc, envT)
        var b2 = ex_ty(e[3], tc, loc, envT)
        if seq2(a, b2) {
            return a
        }
        return ""
    }
    if t == "Binary" {
        var op = e[1]
        if is_cmp_op(op) {
            return "n:Bool"
        }
        if seq2(op, "AndAnd") {
            return "n:Bool"
        }
        if seq2(op, "OrOr") {
            return "n:Bool"
        }
        var lt = ex_ty(e[2], tc, loc, envT)
        var rt2 = ex_ty(e[3], tc, loc, envT)
        if seq2(op, "Add") && k_strish(lt) && k_strish(rt2) {
            return "n:Str"
        }
        if k_num(lt) && k_num(rt2) {
            if seq2(lt, rt2) {
                return lt
            }
            return ""
        }
        if seq2(lt, rt2) {
            return lt
        }
        return ""
    }
    return ""
}

fn tce(file: List[Str], e: List[Str], tc: List[Str], loc: List[Str], envT: List[Str], retK: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        var rt = root_name(cal)
        var ag = e[2]
        var got = ag.len - 1
        if rt.len > 0 && !in_list(loc, rt) && !in_list(diags, "E2020@" + nline(e) + ": 未解析的名称(unresolved):" + rt) {
            if !in_list(tc[0], rt) && !prelude_ok(rt) && !in_list(tc[6], rt) {
                diags.push("E2020@" + nline(e) + ": 未解析的名称(unresolved):" + rt)
            } else {
                var g: I32 = 0
                while g < tc[0].len {
                    if seq2(tc[0][g], rt) && tc[1][g].len > 0 {
                        if got != dvi(tc[1][g]) {
                            diags.push("E2010@" + nline(e) + ": 调用实参数不匹配(arity):" + rt + " 期望 " + tc[1][g] + " 实得 " + got.to_string())
                        }
                        var ps = tc[3][g]
                        var i: I32 = 1
                        while i < ps.len && i <= got {
                            var prm = ps[i]
                            if prm[0] == "Param" {
                                var pk = ty_kind(prm[3])
                                var ak = ex_ty(ag[i], tc, loc, envT)
                                if !compat(pk, ak, ag[i], file, tc) {
                                    diags.push("E2010@" + nline(ag[i]) + ": 实参类型不匹配(type):" + rt + " 第 " + i.to_string() + " 实参 " + root_name(ag[i]) + " 期望 " + pk + " 实得 " + ak)
                                }
                                lit_fit_gate(pk, ag[i], "0", diags)
                            }
                            i += 1
                        }
                    }
                    g += 1
                }
                if cal[0] == "TypeArgs" {
                    // bound 强制检查(E2050):显式 TypeArgs 调用点逐型参核对
                    check_tpar_bounds(file, e, cal, rt, diags)
                }
                if cal[0] == "Ident" {
                    // v0.7 修订三:省略 TypeArgs 的泛型调用——裸型参位按实参名级型别推断
                    // (Go 式仅实参;E2060 仅当有具体实参信息;bound 核对 v1 放行,同 R 线口径;
                    //  结构化推断 List[V] 形态待型别串保留实参后启用)
                    var gd2 = find_gdecl(file, rt)
                    if gd2.len > 0 && gd2[2].len >= 2 {
                        var tps2 = gd2[2]
                        var ps2 = gd2[3]
                        var binds: List[Str] = List[Str]()
                        var bvals: List[Str] = List[Str]()
                        var amb2 = false
                        var sawc = false
                        var pi2: I32 = 1
                        while pi2 < ps2.len && pi2 <= got {
                            var prm2 = ps2[pi2]
                            if prm2[0] == "Param" {
                                var ft = prm2[3]
                                var ak2 = ex_ty(ag[pi2], tc, loc, envT)
                                if ak2.len > 0 {
                                    sawc = true
                                }
                                var tn = ""
                                if or2(ft[0] == "Ident", ft[0] == "Named") {
                                    // 裸型参位:V 解析为 Ident 或单段 Named,按名匹配型参表
                                    var k2: I32 = 1
                                    while k2 < tps2.len {
                                        if seq2(tps2[k2][1], ft[1]) {
                                            tn = ft[1]
                                        }
                                        k2 += 1
                                    }
                                }
                                if tn.len > 0 && ak2.len > 0 {
                                    if in_list(binds, tn) {
                                        var hit2: I32 = 0
                                        var bi2: I32 = 0
                                        while bi2 < binds.len {
                                            if seq2(binds[bi2], tn) { hit2 = bi2 }
                                            bi2 += 1
                                        }
                                        if !seq2(bvals[hit2], ak2) {
                                            amb2 = true
                                        }
                                    } else {
                                        binds.push(tn)
                                        bvals.push(ak2)
                                    }
                                }
                            }
                            pi2 += 1
                        }
                        if amb2 {
                            diags.push("E2061@" + nline(e) + ": 无法唯一推断类型实参(候选冲突);请显式标注 " + rt + "[类型](…)")
                        } else {
                            var miss = ""
                            var k3: I32 = 1
                            while k3 < tps2.len {
                                if !in_list(binds, tps2[k3][1]) {
                                    if miss.len > 0 { miss = miss + ", " }
                                    miss = miss + tps2[k3][1]
                                }
                                k3 += 1
                            }
                            if miss.len > 0 && sawc {
                                diags.push("E2060@" + nline(e) + ": 无法推断类型实参 `" + miss + "`(未出现于实参位);请显式标注,如 " + rt + "[类型](…)")
                            }
                        }
                    }
                }
                if !in_list(tc[0], rt) {
                    var pa = prelude_arity(rt)
                    if pa >= 0 && got != pa {
                        diags.push("E2010@" + nline(e) + ": 调用实参数不匹配(arity):" + rt + " 期望 " + pa.to_string() + " 实得 " + got.to_string())
                    }
                    var vi = idx_of(tc[6], rt)
                    if vi >= 0 {
                        if got != dvi(tc[7][vi]) {
                            diags.push("E2010@" + nline(e) + ": 调用实参数不匹配(arity):" + rt + " 期望 " + tc[7][vi] + " 实得 " + got.to_string())
                        }
                    }
                }
            }
        }
        // callee 为 Ident 时已在上方作为调用目标检查,不再按读取重复上报;但计入 reads(W8030)
        if cal[0] == "Ident" {
            tc[10].push(cal[1])
        } else {
            tce(file, cal, tc, loc, envT, retK, diags)
        }
        var i2: I32 = 1
        while i2 < ag.len {
            tce(file, ag[i2], tc, loc, envT, retK, diags)
            i2 += 1
        }
        return
    }
    if t == "Ident" {
        var nm = e[1]
        tc[10].push(nm)
        if !in_list(loc, nm) && !in_list(tc[0], nm) && !in_list(tc[4], nm) && !in_list(tc[6], nm) && !in_list(tc[8], nm) && !value_ok(nm) {
            var m = "E2020@" + nline(e) + ": 未解析的名称(unresolved):" + nm
            if !in_list(diags, m) {
                diags.push(m)
            }
        }
        return
    }
    if t == "Member" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if t == "Binary" {
        var op = e[1]
        var lt = ex_ty(e[2], tc, loc, envT)
        var rt2 = ex_ty(e[3], tc, loc, envT)
        var bad = false
        var m = ""
        if or2(seq2(op, "Sub"), or2(seq2(op, "Mul"), or2(seq2(op, "Div"), or2(seq2(op, "Mod"), seq2(op, "WrapSub"))))) {
            if or2(k_strish(lt), k_strish(rt2)) {
                bad = true
                m = "E2010@" + nline(e) + ": 算术运算遇 Str(type):" + op
            }
        }
        if seq2(op, "Add") {
            var lunk = seq2(lt, "")
            var runk = seq2(rt2, "")
            if !lunk && !runk {
                if k_strish(lt) != k_strish(rt2) {
                    bad = true
                    m = "E2010@" + nline(e) + ": Str 拼接需两侧皆 Str(type):+"
                }
            }
        }
        if or2(seq2(op, "Add"), or2(seq2(op, "Sub"), or2(seq2(op, "Mul"), or2(seq2(op, "Div"), seq2(op, "Mod"))))) {
            if or2(seq2(lt, "n:Bool"), seq2(rt2, "n:Bool")) {
                bad = true
                m = "E2010@" + nline(e) + ": 算术运算遇 Bool(type):" + op
            }
        }
        if seq2(op, "AndAnd") {
            if or2(seq2(lt, "n:Str"), or2(seq2(rt2, "n:Str"), or2(k_int(lt), k_int(rt2)))) {
                bad = true
                m = "E2010@" + nline(e) + ": 逻辑与需 Bool 操作数(type):&&"
            }
        }
        if seq2(op, "OrOr") {
            if or2(seq2(lt, "n:Str"), or2(seq2(rt2, "n:Str"), or2(k_int(lt), k_int(rt2)))) {
                bad = true
                m = "E2010@" + nline(e) + ": 逻辑或需 Bool 操作数(type):||"
            }
        }
        if bad {
            diags.push(m)
        }
        tce(file, e[2], tc, loc, envT, retK, diags)
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Unary" {
        tce(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "Range" {
        tce(file, e[2], tc, loc, envT, retK, diags)
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Index" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        tce(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "TypeArgs" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if t == "Try" {
        if retK.len > 0 {
            var rk = ty_kind(retK)
            if rk.len > 0 {
                var okr = false
                if rk.len >= 4 {
                    okr = seq2(byte_slice(rk, 0, 4), "opt:")
                }
                okr = or2(okr, or2(seq2(rk, "n:Result"), or2(seq2(rk, "n:AnyError"), seq2(rk, "n:Option"))))
                if !okr {
                    diags.push("E2010@" + nline(e) + ": ? 传播用于非 Option/Result 返回(type):" + rk)
                }
            }
        }
        tce(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i3: I32 = 1
        while i3 < e.len {
            tce(file, e[i3], tc, loc, envT, retK, diags)
            i3 += 1
        }
        return
    }
    if t == "BlockExpr" {
        tcb(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if t == "If" {
        var ck = ex_ty(e[1], tc, loc, envT)
        if ck.len > 0 && !seq2(ck, "n:Bool") {
            diags.push("E2010@" + nline(e) + ": 条件需 Bool(type):if")
        }
        tce(file, e[1], tc, loc, envT, retK, diags)
        tcb(file, e[2], tc, loc, envT, retK, diags)
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Match" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        var arms = e[2]
        var i4: I32 = 1
        while i4 < arms.len {
            var a = arms[i4]
            bind_pat(a[1], loc, envT, unk())
            tce(file, a[2], tc, loc, envT, retK, diags)
            i4 += 1
        }
        return
    }
    if t == "Closure" {
        var cp = e[1]
        var i5: I32 = 1
        while i5 < cp.len {
            loc.push(cp[i5][2])
            envT.push(unk())
            i5 += 1
        }
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Own" {
        loc.push(e[1])
        envT.push(unk())
        tcb(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "Scope" {
        loc.push(e[1])
        envT.push(unk())
        tcb(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "StructLit" {
        var lf = e[2]
        var i6: I32 = 1
        while i6 < lf.len {
            var c = lf[i6]
            if seq2(c[0], "LField") {
                tce(file, c[2], tc, loc, envT, retK, diags)
            }
            i6 += 1
        }
        return
    }
    if t == "Str" {
        var pts = e[1]
        var i7: I32 = 1
        while i7 < pts.len {
            var pt = pts[i7]
            if seq2(pt[0], "Interp") && pt[1].len > 0 {
                tc[11].push(pt[1])
            }
            i7 += 1
        }
        return
    }
    // Str(含 Parts/Interp 原始文本)、字面量、成员名等:无进一步下钻
}

fn tcb(file: List[Str], b: List[Str], tc: List[Str], loc: List[Str], envT: List[Str], retK: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len {
        var s = b[i]
        var t = s[0]
        if t == "Let" {
            var ann = s[3]
            var hasann = ann.len > 0 && !seq2(ann[0], "None")
            if hasann {
                var act = ex_ty(s[4], tc, loc, envT)
                if !compat(ty_kind(ann), act, s[4], file, tc) {
                    diags.push("E2010@" + nline(s) + ": let 初始化类型不匹配(type):期望 " + ty_kind(ann) + " 实得 " + act)
                }
                lit_fit_gate(ty_kind(ann), s[4], nline(s), diags)
            }
            tce(file, s[4], tc, loc, envT, retK, diags)
            var tn = List[Str]()
            if hasann {
                tn = ann
            } else {
                tn = kind_node(ex_ty(s[4], tc, loc, envT))
            }
            if seq2(s[2][0], "PatId") {
                var vn = s[2][1]
                tc[9].push(vn)
                if in_list(tc[12], vn) {
                    diags.push("W8040@" + nline(s) + ": 遮蔽前奏符号(shadow prelude):" + vn)
                }
            }
            bind_pat(s[2], loc, envT, tn)
        } else if t == "Own" {
            tcb(file, s[2], tc, loc, envT, retK, diags)
        } else if t == "While" {
            var ck = ex_ty(s[1], tc, loc, envT)
            if ck.len > 0 && !seq2(ck, "n:Bool") {
                diags.push("E2010@" + nline(s) + ": 条件需 Bool(type):while")
            }
            tce(file, s[1], tc, loc, envT, retK, diags)
            tcb(file, s[2], tc, loc, envT, retK, diags)
        } else if t == "For" {
            bind_pat(s[1], loc, envT, unk())
            tce(file, s[2], tc, loc, envT, retK, diags)
            tcb(file, s[3], tc, loc, envT, retK, diags)
        } else if t == "Return" {
            if s[1].len > 1 {
                if retK.len > 0 && !seq2(retK[0], "None") {
                    var act = ex_ty(s[1], tc, loc, envT)
                    if !compat(ty_kind(retK), act, s[1], file, tc) {
                        diags.push("E2010@" + nline(s) + ": 返回类型不匹配(type):期望 " + ty_kind(retK) + " 实得 " + act)
                    }
                    lit_fit_gate(ty_kind(retK), s[1], nline(s), diags)
                }
                tce(file, s[1], tc, loc, envT, retK, diags)
            }
        } else if t == "Assign" {
            var tk = ex_ty(s[1], tc, loc, envT)
            var vk = ex_ty(s[3], tc, loc, envT)
            if !compat(tk, vk, s[3], file, tc) {
                diags.push("E2010@" + nline(s) + ": 赋值类型不匹配(type):目标 " + tk + " 实得 " + vk)
            }
            lit_fit_gate(tk, s[3], nline(s), diags)
            tce(file, s[1], tc, loc, envT, retK, diags)
            tce(file, s[3], tc, loc, envT, retK, diags)
        } else if t == "Expr" {
            tce(file, s[1], tc, loc, envT, retK, diags)
        } else if seq2(t, "None") && s.len == 1 {
            // 块尾值标记
        } else {
            tce(file, s, tc, loc, envT, retK, diags)
        }
        i += 1
    }
}

fn fn_params_push(ps: List[Str], loc: List[Str], envT: List[Str]) {
    var i: I32 = 1
    while i < ps.len {
        var p = ps[i]
        if p[0] == "Param" {
            loc.push(p[2])
            envT.push(p[3])
        } else if p[0] == "Receiver" {
            loc.push("self")
            envT.push(unk())
        }
        i += 1
    }
}

// ---- bound 强制检查(§3d bound/derive,E2050)----
// 结构化谓词:Show/Eq 由"字段全可比较的结构体"满足(与 .show()/.eq() 派生能力面
// 一致);原语/枚举/类不满足。AST 空间实现(sem 属 CORE,不可依赖 trans 型别码)。
fn find_sdecl(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && seq2(d[1], nm) {
            return d
        }
        i += 1
    }
    return List[Str]()
}

fn find_gdecl(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", d[0] == "FnPub") {
            if seq2(d[1], nm) {
                return d
            }
        }
        i += 1
    }
    return List[Str]()
}

// TPar 名 → 实参型别按声明序对位替换;嵌套实例化实参递归下钻
fn subst_tpar_ty(ty: List[Str], tps: List[Str], args: List[Str]) -> List[Str] {
    if ty[0] == "Named" {
        var k: I32 = 1
        while k < tps.len {
            if seq2(ty[1], tps[k][1]) {
                return args[k]
            }
            k += 1
        }
        if ty[2].len > 1 {
            var nt = mk("Named")
            nt.push(ty[1])
            var ta = mk("TArgs")
            var m: I32 = 1
            while m < ty[2].len {
                ta.push(subst_tpar_ty(ty[2][m], tps, args))
                m += 1
            }
            nt.push(ta)
            return nt
        }
    }
    return ty
}

// 型别满足 Show/Eq bound:结构体且全部字段为标量/Str/可满足的结构体(递归,深度限 6)。
// 型参(TPar)实参即嵌套泛型体的传递场景,v0 放行由外层 bound 负责。
fn bound_sat(file: List[Str], ty: List[Str], tr: Str, dp: I32) -> Bool {
    if dp > 6 {
        return false
    }
    if ty[0] != "Named" {
        return false
    }
    // Eq 的标量面:数值/Bool/Str 原生可 ==(Show 无此面:.show() 仅结构体派生)
    if seq2(tr, "Eq") {
        var nm0 = ty[1]
        if or2(seq2(nm0, "I32"), or2(seq2(nm0, "I64"), or2(seq2(nm0, "Bool"), seq2(nm0, "Str")))) {
            return true
        }
    }
    var sd = find_sdecl(file, ty[1])
    if sd.len == 0 {
        // 顶层无声明名:原语不满足;枚举/类不派生;其余视为外层型参(TPar)→ 传递放行,
        // 由实参处的外层 bound 负责(嵌套字段位无 TPar 语境,仍不满足)
        if dp == 0 {
            var nm9 = ty[1]
            var isprim = or2(seq2(nm9, "I32"), or2(seq2(nm9, "I64"), or2(seq2(nm9, "Bool"), or2(seq2(nm9, "Str"), or2(seq2(nm9, "F64"), seq2(nm9, "F32"))))))
            if !isprim {
                var i9: I32 = 1
                var isdecl = false
                while i9 < file.len {
                    var d9 = file[i9]
                    if or2(d9[0] == "Enum", d9[0] == "Class") {
                        if seq2(d9[1], nm9) {
                            isdecl = true
                        }
                    }
                    i9 += 1
                }
                if !isdecl {
                    return true
                }
            }
        }
        return false
    }
    var tps = sd[3]
    var args = ty[2]
    if tps.len > 1 && args.len != tps.len {
        return false
    }
    var fs = sd[4]
    var j: I32 = 1
    while j < fs.len {
        var ft = fs[j][3]
        if tps.len > 1 {
            ft = subst_tpar_ty(ft, tps, args)
        }
        if ft[0] != "Named" {
            return false
        }
        var prim = or2(seq2(ft[1], "I32"), or2(seq2(ft[1], "I64"), or2(seq2(ft[1], "Bool"), seq2(ft[1], "Str"))))
        if !prim {
            if !bound_sat(file, ft, tr, dp + 1) {
                return false
            }
        }
        j += 1
    }
    return true
}

// 显式 TypeArgs 调用点:逐型参核对 Bounds(Show/Eq;未知 bound 名 v0 不查)
fn check_tpar_bounds(file: List[Str], e: List[Str], cal: List[Str], rt: Str, diags: List[Str]) {
    var gd = find_gdecl(file, rt)
    // 注意:or2/&& 均为急切求值,空表守卫必须拆嵌套(血泪清单)
    if gd.len == 0 {
        return
    }
    if gd[2].len < 2 {
        return
    }
    var tps = gd[2]
    var tas = cal[2]
    if tas.len != tps.len {
        return
    }
    var k: I32 = 1
    while k < tps.len {
        var bds = tps[k][3]
        var bi: I32 = 1
        while bi < bds.len {
            if or2(seq2(bds[bi], "Show"), seq2(bds[bi], "Eq")) {
                if !bound_sat(file, tas[k], bds[bi], 0) {
                    var anm = "?"
                    if tas[k][0] == "Named" {
                        anm = tas[k][1]
                    }
                    diags.push("E2050@" + nline(e) + ": bound 不满足(bound):" + rt + " 型参 " + tps[k][1] + " 需 " + bds[bi] + " 实参 " + anm)
                }
            }
            bi += 1
        }
        k += 1
    }
}
