                        panic("emit:eq 缺实参")
                        return ""
                    }
                    var b0t = ct_typeof(ag[1], env, file)
                    if !seq2(b0t, objt) {
                        panic("emit:eq 实参型别:" + b0t)
                        return ""
                    }
                    return ct_eq_expr_dp(obj, ct_expr(ag[1], env, file), objt, env, file, 0)
                }
                panic("emit:eq 非结构接收者")
                return ""
            }
            // UFCS:文件自由 fn 首参调用(接收者填充首参;实参对位 pcs[1..]。
            // T09 修:旧码 ct_call_args(ag, 2,…) 把 ag 当作含接收者的实参表——
            // 成员调用的 ag 只有实参(接收者在 cal[1]),from=2 恒漏首实参且
            // 个数核对错位(04g 发射臂 rc=1 即此);主套件从不发射故长期隐形)
            // P0-A:泛型方法位(UFCS)——`r.query("q")` 形(Req[S] 族收口缝)。
            // 旧臂裸 t_<m> 直落:泛型被调无单态化后缀 → 定义缺位,C 未定义
            // 函数(t_query/t_cookie/t_param 全族)。接收者实例码供型参实参:
            // 首参注解剥 & 层后基名对位接收者实例(u:<基>__<尾缀>),TArgs 槽
            // 裸 TPar 按位绑接收者实参码(Req[I64] 接收者 → S="6");余型参
            // 回落实参位首层命中(镜像泛型直调臂),未中落 "i"(__i 家族自洽,
            // 定义/调用两侧同码不漂)。单态化定义/链/原型/调用串组装全走
            // ct_spec_call_emit(recvx = 接收者按首参槽形:p<内> 已指针直传、
            // u: 值取址/装盒,镜像 req_set_session__u_App(t_req) 既有约定)。
            var ugd = ct_fn_decl(file, m)
            if ugd.len > 0 && ugd[2].len > 1 && ugd[3].len > 1 {
                var utpsn = List[Str]()
                var utys = List[Str]()
                var uq: I32 = 1
                while uq < ugd[2].len {
                    utpsn.push(ugd[2][uq][1])
                    utys.push("i")
                    uq += 1
                }
                var uft = ugd[3][1][3]
                if uft.len > 0 && uft[0] == "Ref" { uft = uft[1] }
                var urc = objt
                if urc.len > 1 && byte_at(urc, 0) == 112 { urc = byte_slice(urc, 1, urc.len) }
                if uft[0] == "Named" && uft[2].len > 1 && urc.len > 2 && byte_slice(urc, 0, 2) == "u:" {
                    var uinfo = ct_struct_inst_split(urc)
                    if uinfo.len > 1 {
                        var ubar: I32 = 0
                        var uci: I32 = 0
                        while uci < uinfo.len {
                            if byte_at(uinfo, uci) == 124 { ubar = uci }
                            uci += 1
                        }
                        // 首参基名 == 接收者基名才按位绑(异基不妄绑)
                        if seq2(uft[1], byte_slice(uinfo, 0, ubar)) {
                            var ucodes = ct_inst_arg_codes(byte_slice(uinfo, ubar + 1, uinfo.len))
                            var uslot: I32 = 1
                            while uslot < uft[2].len {
                                if uslot - 1 < ucodes.len {
                                    var utn = uft[2][uslot]
                                    if utn[0] == "Named" && utn[2].len < 2 {
                                        var uk: I32 = 0
                                        while uk < utpsn.len {
                                            if seq2(utn[1], utpsn[uk]) {
                                                utys[uk] = ct_inst_ty_node(ucodes[uslot - 1])
                                            }
                                            uk += 1
                                        }
                                    }
                                }
                                uslot += 1
                            }
                        }
                    }
                }
                // 余型参:实参位首层裸 TPar 命中(形参 j ↔ 实参 ag[j-1],j≥2)
                var upi: I32 = 2
                while upi < ugd[3].len {
                    if upi - 1 < ag.len {
                        var upt = ugd[3][upi][3]
                        if upt[0] == "Named" && upt[2].len < 2 {
                            var uk2: I32 = 0
                            while uk2 < utpsn.len {
                                if seq2(upt[1], utpsn[uk2]) {
                                    utys[uk2] = ct_inst_ty_node(ct_typeof(ag[upi - 1], env, file))
                                }
                                uk2 += 1
                            }
                        }
                    }
                    upi += 1
                }
                // 接收者按首参槽形:p<内> 码直传(已是指针)/u: 值码取址/装盒
                // T31 S4②:接收者槽族先落帧池临时(_cur),后续取址/装盒/cast 皆对已根槽
                var ureg = ct_reg_line_c("_cur", objt)
                var upre = ""
                if ureg != "" {
                    upre = ct_ctype(objt) + " _cur = " + obj + "; " + ureg
                    obj = "_cur"
                }
                var upc0 = ct_ty_code(ct_mono_subst_ty(ugd[3][1][3], utpsn, utys), file)
                var urx = ""
                if upc0.len > 1 && byte_at(upc0, 0) == 112 {
                    if objt.len > 1 && byte_at(objt, 0) == 112 {
                        urx = obj
                    } else {
                        urx = "(&(" + obj + "))"
                    }
                } else if upc0.len > 2 && byte_slice(upc0, 0, 2) == "u:" {
                    urx = ct_arg_cast("6", "6", ct_wrap_i(objt, obj))
                } else {
                    urx = ct_arg_cast(objt, upc0, obj)
                }
                var ures = ct_spec_call_emit(file, env, ag, m, mk("None"), utpsn, utys, ugd, urx)
                if upre != "" {
                    return "(\{ " + upre + " " + ures + "; })"
                }
                return ures
            }
            var pcs = ct_fn_pcodes(file, m)
            var p0 = "i"
            if pcs.len > 0 { p0 = pcs[0] }
            // T31 S4②:实参文本一次收集;接收者/槽族实参经帧池提升注册
            var utexts = List[Str]()
            var ucodes = List[Str]()
            var ui: I32 = 1
            while ui < ag.len {
                ucodes.push(ct_typeof(ag[ui], env, file))
                utexts.push(ct_expr(ag[ui], env, file))
                ui += 1
            }
            var mregs = ct_reg_line_c("_cmr", objt)
            var mhas = mregs != ""
            var ui2: I32 = 0
            while ui2 < ucodes.len {
                if ct_reg_line_c("_cm" + (ui2 + 1).to_string(), ucodes[ui2]) != "" { mhas = true }
                ui2 += 1
            }
            var ufargs = ""
            var ui3: I32 = 0
            while ui3 < utexts.len {
                var pcu3 = "i"
                if ui3 + 1 < pcs.len { pcu3 = pcs[ui3 + 1] }
                if ui3 > 0 { ufargs = ufargs + ", " }
                ufargs = ufargs + ct_arg_cast(ucodes[ui3], pcu3, utexts[ui3])
                ui3 += 1
            }
            if mhas {
                var mpre = ct_ctype(objt) + " _cmr = " + obj + "; " + mregs
                var mcall = ct_arg_cast(objt, p0, "_cmr")
                var ui4: I32 = 0
                while ui4 < utexts.len {
                    var msx = "_cm" + (ui4 + 1).to_string()
                    mpre = mpre + " " + ct_ctype(ucodes[ui4]) + " " + msx + " = " + utexts[ui4] + "; " + ct_reg_line_c(msx, ucodes[ui4])
                    var pcu4 = "i"
                    if ui4 + 1 < pcs.len { pcu4 = pcs[ui4 + 1] }
                    mcall = mcall + ", " + ct_arg_cast(ucodes[ui4], pcu4, msx)
                    ui4 += 1
                }
                return "(\{ " + mpre + " t_" + m + "(" + mcall + "); })"
            }
            if ufargs.len > 0 {
                return "t_" + m + "(" + ct_arg_cast(objt, p0, obj) + ", " + ufargs + ")"
            }
            return "t_" + m + "(" + ct_arg_cast(objt, p0, obj) + ")"
        }
        var callee = cal[1]
        if callee == "println" {
            var at = ct_typeof(ag[1], env, file)
            if at.len > 2 && byte_slice(at, 0, 2) == "u:" {
                panic("emit:print struct")
                return ""
            }
            if at == "s" { return "printf(\"%s" + bs() + "n\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            if at == "b" { return "printf(\"%s" + bs() + "n\", (" + ct_call_args(ag, 1, env, file, "") + ") ? \"true\" : \"false\")" }
            if at == "6" { return "printf(\"%lld" + bs() + "n\", (long long)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            return "printf(\"%d" + bs() + "n\", (int)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "print" {
            var at2 = ct_typeof(ag[1], env, file)
            if at2.len > 2 && byte_slice(at2, 0, 2) == "u:" {
                panic("emit:print struct")
                return ""
            }
            if at2 == "s" { return "printf(\"%s\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            if at2 == "6" { return "printf(\"%lld\", (long long)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            return "printf(\"%d\", (int)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "eprint" {
            // §9 stderr 面:Str 直写宿主 stderr(无换行,调用方拼 "\n");与 interp
            // eprint 内建同语义——panic 流分离双臂对齐的唯一发射口
            var at5 = ct_typeof(ag[1], env, file)
            if at5.len > 2 && byte_slice(at5, 0, 2) == "u:" {
                panic("emit:eprint struct")
                return ""
            }
            return "fprintf(stderr, \"%s\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "ctron_entry" { return "ctron_entry()" }
        if callee == "ctron_exe_path" { return "ctron_exe_path()" }
        if callee == "ctron_cli_flag" { return "ctron_cli_flag(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "env_get" { return "ctron_env_get(" + ct_call_args(ag, 1, env, file, "") + ")" }
        // T26 进程参数底座(§8.1 Env.args):发射模板同形助手
        if callee == "ctron_prog_args_n" { return "ctron_prog_args_n()" }
        // T29 GC 观测口(泄漏锚;发射运行时模板定义)
        if callee == "ct_gc_live_bytes" { return "ct_gc_live_bytes()" }
        if callee == "ct_gc_collect" { return "ct_gc_collect()" }
        if callee == "ctron_prog_args_at" { return "ctron_prog_args_at(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "ctron_embedded" { return "ctron_embedded()" }
        // J18:清单 gui.entry 烘焙常量(运行锚默认值;prelude 恒定义)
        if callee == "ctron_gui_entry" { return "ctron_gui_entry()" }
        if callee == "gui_sk_load" { return "gui_sk_load()" }

        if callee == "read_file" {
            if ag.len > 1 && ag[1][0] == "Str" && ct_str_payload(ag[1]) == "CTRONCLIINPUT" {
                // main 输入锚:CLI `run <file>` 可覆盖(ctron_anchor 默认 = 烘焙字面量)
                return "ctron_read_file_cli(ctron_anchor)"
            }
            return "ctron_read_file(" + ct_call_args(ag, 1, env, file, "") + ")"
        }
        if callee == "read_dir" { return "ctron_read_dir(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "fs_exists" { return "(ctron_fs_exists(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        if callee == "fs_write" { return "(ctron_fs_write(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        if callee == "fs_mkdir" { return "(ctron_fs_mkdir_p(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        if callee == "fs_delete" { return "(ctron_fs_delete(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        // L4-③:Bytes 族(emit 面;ctron_bytes* 堆结构,rt 模板见 driver_emit)
        if callee == "read_file_bytes" { return "ctron_read_file_bytes(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "bytes_len" { return "ctron_bytes_len(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "bytes_at" { return "ctron_bytes_at(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "bytes_slice" { return "ctron_bytes_slice(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "bytes_to_str" { return "ctron_bytes_to_str(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "read_bytes_len" { return "ctron_read_bytes_len(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "read_bytes_at" { return "ctron_read_bytes_at(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "now_ms" { return "ctron_now_ms()" }
        if callee == "now_ms_text" { return "ctron_now_ms_text()" }
        if callee == "byte_at" { return "ctron_byte_at(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "byte_slice" { return "ctron_byte_slice(" + ct_call_args(ag, 1, env, file, "") + ")" }
        // Str 编组(§9.6 v0.6):C 侧 char* 深拷入 arena(Ctron-owned;解释器侧恒等)
        if callee == "str_from_c" { return "ctron_str_from_c(" + ct_call_args(ag, 1, env, file, "") + ")" }
        // errno(§9.6 v0.8 错误传播):最近一次系统调用/库调用的错误码(线程局域)
        if callee == "errno" { return "(int32_t)errno" }
        // ptr_as_view(v0.9·五 裁决甲:路径 1 读侧):p<ec> → ctron_view_<ec>
        // { (elem*)p, n };#[trusted] 所在 fn 由 sem E4047 前置把关
        if callee == "ptr_as_view" {
            var pvac = ct_typeof(ag[1], env, file)
            if !(pvac.len > 1 && byte_at(pvac, 0) == 112) {
                panic("emit:ptr_as_view 实参须为 &T 裸指针(p 码)")
                return ""
            }
            var pec = byte_slice(pvac, 1, pvac.len)
            var pvex = ct_expr(ag[1], env, file)
            var pvn = ct_expr(ag[2], env, file)
            return "(ctron_view_" + pec + ")\{ (" + ct_ctype(pec) + "*)(" + pvex + "), (int64_t)(" + pvn + ") }"
        }
        // context-pointer 闭包糖(§9.6 v0.8):闭包装箱句柄(void* 语义)
        if callee == "clo_handle" {
            if ag.len < 2 || ag[1][0] != "Closure" {
                panic("emit:clo_handle 实参须闭包字面量")
                return ""
            }
            return "(ct_i)(long)(" + ct_emit_clov(ag[1], ag[1], env, file) + ")"
        }
        // 动态链接面(§9.6 v0.7):句柄为 ct_i 载荷;dlopen 固定 RTLD_NOW
        if callee == "dlopen" {
            var dp = ct_expr(ag[1], env, file)
            return "(ct_i)(long)dlopen(" + dp + ", RTLD_NOW)"
        }
        if callee == "dlclose" { return "(int32_t)dlclose((void*)(long)(" + ct_expr(ag[1], env, file) + "))" }
        if callee == "dlsym" {
            var dh = ct_expr(ag[1], env, file)
            var dn = ct_expr(ag[2], env, file)
            return "(ct_i)(long)dlsym((void*)(long)(" + dh + "), " + dn + ")"
        }
        if callee == "utf8_enc" {
            var u0 = "0"
            if ag.len > 1 { u0 = ct_expr(ag[1], env, file) }
            return "ctron_utf8_enc((int)(" + u0 + "))"
        }
        if callee == "panic" { return "ctron_panic(" + ct_call_args(ag, 1, env, file, "") + ")" }
        // Option/Result 构造(Phase 5):Ok/Err/Some(expr) → ct_res(载荷按型别包装)
        if cal[0] == "Ident" {
            if or2(cal[1] == "Ok", or2(cal[1] == "Err", cal[1] == "Some")) {
                if ag.len < 2 {
                    panic("emit:" + cal[1] + " 需载荷")
                    return ""
                }
                var rcode = ct_typeof(ag[1], env, file)
                if rcode.len > 2 && byte_slice(rcode, 0, 2) == "E:" {
                    if ag[1][0] != "Call" && ag[1][0] != "Ident" {
                        panic("emit:枚举载荷需变体构造")
                        return ""
                    }
                }
                var vx = ct_res_wrap(rcode, ct_expr(ag[1], env, file))
                var vr = "0"
                if cal[1] == "Err" { vr = "1" }
                return "(\{ ct_res _r; _r.variant = " + vr + "; _r.v = " + vx + "; _r; })"
            }
        }
        // fn 值间接调用(env 命中 F<arity>):( (ct_fnK)t_f )( 实参... )
        // P0-A:N 槽臂——List[fn] 索引读落 "N"(char* 槽,元素即 ct_clop 指针);
        // 调用位 env 命中 N 时按调用点实参个数定 arity,#fret:<名>(返回位注入,
        // trans_stmt Return 臂)供结构返回原型化。run_chain 中间件平铺链即此形
        if cal[0] == "Ident" && ct_env_has(env, cal[1]) {
            // T55:fvt 剥 P——捕获 fn 值绑 P<F…>;P 绑名 fv = "(*t_nm)"(格解引取 ct_clop)
            var fvraw = ct_env_ty(env, cal[1])
            var fvt = ct_strip_p(fvraw)
            var ncall = seq2(fvt, "N")
            if or2(fvt.len > 1 && byte_at(fvt, 0) == 70, ncall) {
                var far: I32 = ag.len - 1
                if !ncall {
                    far = byte_at(fvt, 1) - 48
                }
                // P0-A:签名段形参码 → 闭包实参 #clcodes("F2{u:Req__X;F1}>r" 拆段,
                // 第 k 实参位闭包取第 k-1 段;run_chain 续链闭包的 rq 形参码源)
                var fsegs = ct_fsig_params(fvt)
                var fv = "(t_" + cal[1] + ")"
                if fvraw.len > 1 && byte_at(fvraw, 0) == 80 {
                    fv = "(*t_" + cal[1] + ")"
                }
                var fargs = "((ct_clop)" + fv + ")->env"
                if ag.len > 1 { fargs = fargs + ", " + ct_wrap_i(ct_typeof(ag[1], env, file), ct_expr(ag[1], env, file)) }
                var fk: I32 = 2
                while fk <= far {
                    if ag.len > fk {
                        var faenv = env
                        if ag[fk][0] == "Closure" {
                            var fseg = ct_fseg_at(fsegs, fk - 1)
                            // P0-A:段本身为 fn 签名码("F1{…}>r"——续链闭包实参)时,
                            // 闭包形参码取其内参段(一层展开;#clcodes 消费位按逗号
                            // 分段,签名形参 ';'-连接不含逗号,展开后即纯码串)
                            if fseg.len > 1 && byte_at(fseg, 0) == 70 {
                                var fseg2 = ct_fsig_params(fseg)
                                if fseg2.len > 0 {
                                    fseg = fseg2
                                }
                            }
                            if fseg.len > 0 {
                                faenv = env_bind(env, "#clcodes", fseg)
                            }
                        }
                        fargs = fargs + ", " + ct_wrap_i(ct_typeof(ag[fk], faenv, file), ct_expr(ag[fk], faenv, file))
                    } else { fargs = fargs + ", 0" }
                    fk += 1
                }
                var fhead = "((ct_cfn" + far.to_string() + ")(((ct_clop)" + fv + ")->fn))"
                var fcast = ""
                if byte_at(fvt, 0) == 71 { fcast = "(ct_clop)" }
                // 双路径(v0.7 §9.6):env==(void*)1 = 裸 C 函数指针哨兵(extern 返回的
                // 回调装箱)→ ct_fnK 直调不传 env;否则闭包 shim(env-first)原路径
                var rargs = ""
                var rk: I32 = 2
                while rk <= far {
                    if ag.len > rk { rargs = rargs + ", " + ct_wrap_i(ct_typeof(ag[rk], env, file), ct_expr(ag[rk], env, file)) } else { rargs = rargs + ", 0" }
                    rk += 1
                }
                // far==0(零参 fn 值):ct_fn0 是 (void) 签名,实参表必须为空——
                // 此前兜底 "(ct_i)0" 使零参直调多传一参(cc 报 too many arguments)
                if far == 0 { rargs = "" } else { if ag.len > 1 { rargs = "(ct_i)(" + ct_wrap_i(ct_typeof(ag[1], env, file), ct_expr(ag[1], env, file)) + ")" + rargs } else { rargs = "(ct_i)0" + rargs } }
                var rhead = "((ct_fn" + far.to_string() + ")(((ct_clop)" + fv + ")->fn))"
                // P0-3:返回型别取 fn(T)->R(#fret 侧条目,ct_fn 绑定)——返回经
                // 返回类型原型化指针调用(ct_i 统一 ABI 装不下 struct,链上成员读全靠它)。
                // P0-2/seam② 收窄:标量/Str R(s/b/f/g/6/7/u:/…;v/i 除外)同式入码——
                // i 维持 ct_fnK 旧形态(语义无差),v 无值。
                // 头部原型须带实参 ABI(rhead=ct_i×far;fhead=void*+ct_i×(far-1));
                // 此前 (*)() 恒零参,Task 1 仅零参 struct 返回(03k)踩不到,seam② 放宽后即炸
                var frk = "#fret:" + cal[1]
                if ct_env_has(env, frk) {
                    var fretc = ct_env_ty(env, frk)
                    if fretc.len > 0 {
                        if fretc != "i" {
                            if fretc != "v" {
                                // P0-A:u:-返回 → 堆盒指针约定——原型 ct_i(*)(…),调用后
                                // 按返回型解盒(双侧同约定:shim/cbtr 尾 = 盒指针;旧
                                // union 低 8 字节式对 >8B struct 即截断)
                                var boxed26 = fretc.len > 2 && byte_slice(fretc, 0, 2) == "u:"
                                var frt = "ct_i"
                                if !boxed26 {
                                    frt = ct_ctype(fretc)
                                }
                                var rp = "void"
                                if far > 0 {
                                    rp = "ct_i"
                                    var pk: I32 = 2
                                    while pk <= far {
                                        rp = rp + ", ct_i"
                                        pk += 1
                                    }
                                }
                                var fp2 = "void*"
                                var pk2: I32 = 1
                                while pk2 <= far {
                                    fp2 = fp2 + ", ct_i"
                                    pk2 += 1
                                }
                                fhead = "((" + frt + "(*)(" + fp2 + "))(((ct_clop)" + fv + ")->fn))"
                                rhead = "((" + frt + "(*)(" + rp + "))(((ct_clop)" + fv + ")->fn))"
                                if boxed26 {
                                    var dual26 = "(((ct_clop)" + fv + ")->env == (void*)1 ? " + rhead + "(" + rargs + ") : " + fhead + "(" + fargs + "))"
                                    return "(*(" + ct_ctype(fretc) + "*)(long)(" + dual26 + "))"
                                }
                            }
                        }
                    }
                }
                return fcast + "(((ct_clop)" + fv + ")->env == (void*)1 ? " + rhead + "(" + rargs + ") : " + fhead + "(" + fargs + "))"
            }
        }
        // 用户枚举变体构造(Phase 5):(ct_enum_E){ idx, { p0, p1 } }
        var ven = ct_enum_of_variant(file, callee)
        if ven.len > 0 {
            var vidx = ct_variant_index(file, ven, callee)
            var vpcs = ct_variant_pcodes(file, ven, callee)
            var nargs = ag.len - 1
            if nargs != vpcs.len {
                panic("emit:variant arity:" + callee)
                return ""
            }
            if nargs > 2 {
                panic("emit:变体载荷>2")
                return ""
            }
            var lit = "(ct_enum_" + ven + ")\{ " + vidx.to_string() + ", \{ "
            var pk: I32 = 0
            var firstv = true
            while pk < 2 {
                if !firstv { lit = lit + ", " }
                firstv = false
                if pk < nargs {
                    lit = lit + ct_wrap_i(vpcs[pk], ct_expr(ag[pk + 1], env, file))
                } else {
                    lit = lit + "0"
                }
                pk += 1
            }
            lit = lit + " } }"
            return lit
        }
        // extern "c" 声明:C 侧符号无 t_ 前缀(§9.6);fn 指针形参按边界映射强转
        // (裸 fn 名取 C 地址零包装;fn 值摘 ct_clop.fn 槽;捕获闭包 emit 级硬拦——
        // ctron-emit 不跑语义,双保险防错误码静默过 C 编译)
        var isext = false
        var ie: I32 = 1
        while ie < file.len {
            var dd = file[ie]
            if dd[0] == "FnExt" && dd[1] == callee {
                isext = true
            }
            ie += 1
        }
        if isext {
            var ear = ct_arity_range(file, callee)
            if ear.len > 0 {
                var ebar = -1
                var eq: I32 = 0
                while eq < ear.len {
                    if byte_at(ear, eq) == 124 {
                        ebar = eq
                    }
                    eq += 1
                }
                var emin = byte_slice(ear, 0, ebar)
                var emax = byte_slice(ear, ebar + 1, ear.len)
                var egot = ag.len - 1
                var ebad = false
                if emax == "-1" {
                    if egot < ct_arity_parse(emin) { ebad = true }
                } else if egot != ct_arity_parse(emin) {
                    ebad = true
                }
                if ebad {
                    panic("emit:调用实参个数不符:" + callee + " 期望 " + emin + " 实得 " + egot.to_string())
                }
            }
            var epcs = ct_fn_pcodes(file, callee)
            var eargs = ""
            var ei: I32 = 1
            while ei < ag.len {
                if ei > 1 { eargs = eargs + ", " }
                var eac = ct_typeof(ag[ei], env, file)
                var epc = "i"
                if ei - 1 < epcs.len { epc = epcs[ei - 1] }
                var eex = ct_expr(ag[ei], env, file)
                if epc.len > 1 && byte_at(epc, 0) == 112 {
                    // 裸指针形参 p<ec>(v0.9·三 路径 1 选项 A):只传不解。
                    // 实参已是指针值(另一 extern 的 &T 返回,切片 2 passthrough)
                    // → 直传;左值形态(Ident/成员链)→ 取址;其余响亮失败
                    if eac.len > 1 && byte_at(eac, 0) == 112 {
                        eargs = eargs + "(" + ct_abi_ctype(epc) + ")(" + eex + ")"
                    } else if eac.len > 1 && byte_at(eac, 0) == 66 {
                        // Box[T] 实参(码 B:*)在 C 层已是指针(t_Box64* 句柄)
                        // → 直传;取址即双重指针,垫片写出入参槽对调用方不可见
                        //(T46:client_listen lfd=-1 实证,net e2e 族同源红)
                        eargs = eargs + "(" + ct_abi_ctype(epc) + ")(" + eex + ")"
                    } else if or2(ag[ei][0] == "Ident", ag[ei][0] == "Member") {
                        eargs = eargs + "(" + ct_abi_ctype(epc) + ")(&(" + eex + "))"
                    } else {
                        panic("emit:裸指针实参限左值(Ident/成员链):" + callee)
                        return ""
                    }
                } else if or2(epc == "F1", or2(epc == "F2", epc == "F3")) {
                    eargs = eargs + "(" + ct_abi_ctype(epc) + ")" + ct_cb_ref(file, ag[ei], eac, eex, epc)
                } else {
                    eargs = eargs + ct_arg_cast(eac, epc, eex)
                }
                ei += 1
            }
            var miss2 = epcs.len - (ag.len - 1)
            while miss2 > 0 {
                eargs = eargs + ", 0"
                miss2 -= 1
            }
            // 符号解析(§9.6 v0.7):#[link_name(x)] → x;#[dlsym] → ct_dyn_<名> thunk
            // Option[Str] 返回(§9.6 v0.8):const char* → ct_res 包装(NULL ↔ None)
            var esym2 = ct_ext_sym(file, callee)
            var ecall = esym2 + "(" + eargs + ")"
            if ct_ext_ret_optstr(file, callee) {
                var eo = "t_exto" + nline(e)
                return "(\{ ct_res " + eo + "; const char* _ep = " + ecall + "; " + eo + ".variant = (_ep == 0); " + eo + ".v = (ct_i)(long)_ep; " + eo + "; })"
            }
            return ecall
        }
        // P0-A:泛型直调(无 TypeArgs 位,sem 隐式推断形)——core.ct 测试的
        // req_full("GET", …, 0) 即此形。型参槽推断单源 ct_call_infer_tys
        //(T45:种子槽原推码串 "i" 与命中臂节点异型——串被当节点解引用 SEGV
        // 实证;&T 形参此前永不命中 → CBox 式 cbox_own[T](p: &T) 直调即崩)
        var pgd30 = ct_fn_decl(file, callee)
        if pgd30.len > 0 && pgd30[2].len > 1 {
            var tpsn30 = List[Str]()
            var gq40: I32 = 1
            while gq40 < pgd30[2].len {
                tpsn30.push(pgd30[2][gq40][1])
                gq40 += 1
            }
            var tys30 = ct_call_infer_tys(file, env, ag, callee)
            return ct_spec_call_emit(file, env, ag, callee, mk("None"), tpsn30, tys30, pgd30, "")
        }
        return "t_" + callee + "(" + ct_call_args(ag, 1, env, file, callee) + ")"
    }
    if t == "Try" {
        // 表达式位 ?(§5 NULL 模型):ct_res 解包,Err/None 短路 return,载荷按元素码转型;
        // T53:f 载荷位型双关回读(旧 (double) 直转双向失真)
        var ec = ct_try_elem(file, e, env)
        var qv = "t_q" + nline(e)
        if ec == "f" {
            return "(\{ ct_res " + qv + " = " + ct_expr(e[1], env, file) + "; if (" + qv + ".variant != 0) \{ return " + qv + "; } ((union \{ double _d; ct_i _i; })\{ ._i = (ct_i)(" + qv + ".v) })._d; })"
        }
        return "(\{ ct_res " + qv + " = " + ct_expr(e[1], env, file) + "; if (" + qv + ".variant != 0) \{ return " + qv + "; } (" + ct_ctype(ec) + ")(" + qv + ".v); })"
    }
    if t == "BlockExpr" {
        // 裸块值位(§4.6;R 线 trans.rs 同口径):临时变量在花括号外声明,
        // 尾值先落临时,块内 drops 先于使用点执行。
        // 站点名:尾表达式属带行号戳节点族(批次九 10 类)时取行号,否则 "0"
        // (未带戳兄弟裸块同 C 作用域的极端重名由 gcc 响亮拦截,不静默错译)
        var bl = e[1]
        var tl2 = bl[bl.len - 1]
        var tcode = ct_typeof(tl2, env, file)
        if tcode == "" {
            panic("ct_expr:BlockExpr 尾值无型")
            return ""
        }
        var site = "0"
        var t0 = tl2[0]
        if or2(t0 == "Call", t0 == "Match") { site = nline(tl2) }
        if or2(t0 == "StructLit", t0 == "Try") { site = nline(tl2) }
        if t0 == "Member" { site = nline(tl2) }
        var tmp = "t_blk" + site
        eln(ct_ctype(tcode) + " " + tmp + ";", env)
        eln("\{", env)
        var denv = dls_push(env)
        var env2 = ct_stmts(bl, denv, file, "", List[Str]())
        if tl2[0] != "None" {
            eln(tmp + " = " + ct_expr(tl2, env2, file) + ";", env)
        }
        dls_pop_emit(env2, file)
        eln("}", env)
        return tmp
    }
    // stash(三线 WIP)侧改动并入:兜底 panic 携带行号(诊断面增强)
    panic("ct_expr:" + t + "@" + nline(e))
    return ""
}

// C-ABI 回调实参发射(§9.6 v0.6):裸 fn 名 → 其 C 地址零包装(元数须与 fn 指针
// 形参一致,emit 级守卫);fn 值(局部绑定,ct_clop 装箱)→ 摘 fn 槽(裸 fn 名装箱
// env 恒 0,签名即 ct_fnK);捕获闭包/其余表达式 → 硬失败(语义面 E4042 之外的
// emit 级双保险——ctron-emit 不跑语义检查)
fn ct_cb_ref(file: List[Str], ae: List[Str], ac: Str, ex: Str, pc: Str) -> Str {
    var want = byte_at(pc, 1) - 48
    if ac.len > 0 && byte_at(ac, 0) == 71 {
        panic("emit:捕获闭包不可作 C-ABI 回调(E4042;无 env 槽)")
        return ""
    }
    if ae[0] == "Ident" {
        var nm = ae[1]
        // context-pointer 蹦床 fn 值(§9.6 v0.8):直接以蹦床地址过界(无 fn 槽可摘)
        if nm == "clo_cb2" { return "ctron_clo_tramp2" }
        if nm == "clo_cb3" { return "ctron_clo_tramp3" }
        var di: I32 = 1
        while di < file.len {
            var d = file[di]
            if or2(d[0] == "Fn", or2(d[0] == "FnPub", d[0] == "FnC")) && d[1] == nm {
                if ct_fn_pcodes(file, nm).len != want {
                    panic("emit:回调实参元数不符:" + nm)
                    return ""
                }
                // C→Ctron 回调入口蹦床(§9.6 v0.8):入口置 ctron_cb_depth,ctron_panic
                // 据此判定语境——回调内 panic = 消息 + exit(1),不越 C 帧 longjmp
                //(Rust "extern fn 内 panic = abort" 同款约定;非 task 态行为不变)
                var ps9 = ct_fn_pcodes(file, nm)
                var asig9 = ""
                var aargs9 = ""
                var ai9: I32 = 0
                var first9 = true
                while ai9 < ps9.len {
                    if !first9 {
                        asig9 = asig9 + ", "
                        aargs9 = aargs9 + ", "
                    }
                    asig9 = asig9 + "ct_i _cbp" + ai9.to_string()
                    // 实参按被调形参边界型 cast(v0.9·五):标量隐式收窄本可通过,
                    // 指针形参(&T → p<ec>)ct_i → T* 须显式 cast
                    aargs9 = aargs9 + "(" + ct_abi_ctype(ps9[ai9]) + ")_cbp" + ai9.to_string()
                    first9 = false
                    ai9 += 1
                }
                println("#ifndef CT_CBTR_" + nm)
                println("#define CT_CBTR_" + nm)
                println("static ct_i ct_cbtr_" + nm + "(" + asig9 + ") \{ ctron_cb_depth++; ct_i _r = t_" + nm + "(" + aargs9 + "); ctron_cb_depth--; return _r; }")
                println("#endif")
                return "(ct_cbtr_" + nm + ")"
            }
            if d[0] == "FnExt" && d[1] == nm {
                panic("emit:extern 声明无函数体,不可作回调值:" + nm)
                return ""
            }
            di += 1
        }
        return "((void*)((ct_clop)(" + ex + "))->fn)"
    }
    panic("emit:C-ABI 回调实参需裸 fn 名或 fn 值")
    return ""
}

// 实参串:从 ag[from] 起逐个发射,用户 fn 时按形参码插转换;
// 实参不足按 0 补齐到形参数(镜像 cc.ct 潜伏的缺参调用,如 ty_head 的 2 参 or3 —— 种子
// 一旦执行即 panic,补 0 仅保证产物可编译,崩路无差分意义)
fn ct_call_args(ag: List[Str], from: I32, env: List[Str], file: List[Str], callee: Str) -> Str {
    return ct_call_args_tg(ag, from, env, file, callee, mk("None"))
}

// 带 TypeArgs 变体:fn 型形参 + 闭包实参时,内参码经调用点实参精确替换
// (泛型被调,§3.9.1;闭包 ABI §4)
fn ct_call_args_tg(ag: List[Str], from: I32, env: List[Str], file: List[Str], callee: Str, targs: List[Str]) -> Str {
    var pcs = ct_fn_pcodes(file, callee)
    // 实参个数断言(§四 #10):声明在案的被调,个数不符 = 发射期硬失败
    //(旧"补 0"垫片会把缺参洗成合法 C,静默垃圾);内建/未声明被调不查
    if callee != "" {
        var ar = ct_arity_range(file, callee)
        if ar.len > 0 {
            var bar9 = -1
            var q9: I32 = 0
            while q9 < ar.len {
                if byte_at(ar, q9) == 124 {
                    bar9 = q9
                }
                q9 += 1
            }
            var min9 = byte_slice(ar, 0, bar9)
            var max9 = byte_slice(ar, bar9 + 1, ar.len)
            var got9 = ag.len - from
            var bad9 = false
            if max9 == "-1" {
                if got9 < ct_arity_parse(min9) { bad9 = true }
            } else if got9 != ct_arity_parse(min9) {
                bad9 = true
            }
            if bad9 {
                panic("emit:调用实参个数不符:" + callee + " 期望 " + min9 + " 实得 " + got9.to_string())
            }
        }
    }
    var args = ""
    var i: I32 = from
    while i < ag.len {
        if i > from { args = args + ", " }
        var ac = ct_typeof(ag[i], env, file)
        var pc = "i"
        if callee != "" && i - 1 < pcs.len { pc = pcs[i - 1] }
        var aenv = env
        // P0-A:裸 fn 引用实参(F 型形参位)→ env-first 解箱 shim(旧裸地址直填)
        if callee != "" {
            if pc.len > 0 {
                if byte_at(pc, 0) == 70 {
                    if ag[i][0] == "Ident" {
                        // P0-A:判别位移 decl 在案(旧 rfpcs.len>0 漏 0 参 fn——
                        // clk_fix/clk_unix 形裸地址直填 ct_clop,env=邻接码字节
                        // ≠哨兵 → 调 fn 槽=代码字节即 SIGSEGV);形参/局部闭包
                        // 值(非 decl)恒直传不过包装。env 先行判别:域包体内
                        // 同名形参撞用户全局 fn 时 decl 查找误包装(六红 s33 族根因)
                        if !ct_env_has(env, ag[i][1]) {
                            if ct_fn_decl_any(file, ag[i][1]) {
                                var rfpcs = ct_fn_pcodes(file, ag[i][1])
                                if rfpcs.len == byte_at(pc, 1) - 48 {
                                    aenv = env_bind(env, "#fval", ct_fval_emit(file, ag[i][1], "C" + nline(ag[i])))
                                }
                            }
                        }
                    }
                }
            }
        }
        // P0-A:泛型 struct 字面量实参钉型——被调形参(显式 TypeArgs 位经型参代入)
        // 为实例码时,以 "#名" env 钉实例(ct_structlit_inst pin 优先);测试体裸形
        // `has_conflict[I64](Router { ... })`(state: 0 直槽值位误推 i)即此面
        if ag[i][0] == "StructLit" {
            var pinned = "#" + ag[i][1]
            if !ct_env_has(env, pinned) {
                if ct_struct_tps(file, ag[i][1]).len > 0 {
                    if targs.len > 1 {
                        var gd28 = ct_fn_decl(file, callee)
                        if gd28.len > 0 && gd28[2].len > 1 {
                            if i - 1 < gd28[3].len - 1 + 1 {
                                var pi28 = i
                                if pi28 < gd28[3].len {
                                    if gd28[3][pi28][0] == "Param" {
                                        var tpsn28 = List[Str]()
                                        var gq28: I32 = 1
                                        while gq28 < gd28[2].len {
                                            tpsn28.push(gd28[2][gq28][1])
                                            gq28 += 1
                                        }
                                        var tys28 = List[Str]()
                                        var gq29: I32 = 1
                                        while gq29 < targs.len {
                                            tys28.push(targs[gq29])
                                            gq29 += 1
                                        }
                                        if tpsn28.len == tys28.len {
                                            var sub28 = ct_mono_subst_ty(gd28[3][pi28][3], tpsn28, tys28)
                                            var pc28 = ct_ty_code(sub28, file)
                                            if pc28.len > 2 && byte_slice(pc28, 0, 2) == "u:" {
                                                if ct_struct_inst_split(pc28).len > 1 {
                                                    aenv = env_bind(env, pinned, pc28)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // fn 型形参 + 闭包字面量实参:绑 '#clcodes'(shim 形参码提示,§4 闭包 ABI;
        // 防御口径:仅 'F'/'G' 码 + Closure 实参触发,内参码取不到则不绑,回落注解/"i")
        if callee != "" {
            if pc.len > 0 {
                if byte_at(pc, 0) == 70 {
                    if ag[i][0] == "Closure" {
                        var cc = ct_fntype_pcodes_tg(file, callee, i - 1, targs)
                        if cc != "" {
                            aenv = env_bind(env, "#clcodes", cc)
                        }
                    }
                }
            }
        }
        var ax = ct_expr(ag[i], aenv, file)
        // FB-8/F5:T[N] 实参值语义——调用位栈拷贝(形参 elem*,直传=别名);
        // 仅形参码同为 a 码时包裹(视图借用面 &T[]/T[]=v 码不拷,复合字面量
        // 内语句表达式会产生悬垂数组尾,fx_slice 实证);实参限 Ident,右值形债在册
        if ac.len > 1 && byte_at(ac, 0) == 97 && pc.len > 1 && byte_at(pc, 0) == 97 && ag[i][0] == "Ident" {
            // 嵌套 ac(a2a2i)= 全维链声明+整块拷贝(旧顶层单维=截断拷贝+指针数组解引用 SEGV)
            var dims8 = ""
            var rc8 = ac
            while rc8.len >= 3 && byte_slice(rc8, 0, 1) == "a" {
                dims8 = dims8 + "[" + a_count(rc8) + "]"
                rc8 = a_elem(rc8)
            }
            var ace8 = ct_ctype(rc8)
            ax = "(\{ " + ace8 + " t_acp" + i.to_string() + dims8 + "; memcpy(t_acp" + i.to_string() + ", " + ax + ", sizeof(" + ace8 + dims8 + ")); t_acp" + i.to_string() + "; })"
        }
        if ct_env_has(aenv, "#fval") {
            ax = ct_env_ty(aenv, "#fval")
        } else if seq2("", "1") {
            // T31 M1.5(S2d):实参 ANF 提升+GC 槽注册——多实参调用求值悬窗
            //(先求值实参仅存 C 临时,继后实参表达式内 GC → 精确根集盲区 UAF)。
            // 提升为具名临时(语句表达式局部=当前帧栈_extent)后,借用/包装链
            // 皆对纯标识符做串手术,合法 C。槽节点死 extent 后读旧值=可读过标记。
            var hnm = "_ca" + i.to_string()
            var hrl = ct_reg_line_c(hnm, ac)
            if hrl.len > 0 {
                ax = "(\{ " + ct_ctype(ac) + " " + hnm + " = " + ax + "; " + hrl + " " + hnm + "; })"
            }
        }
        // P0-A:&T 形参(§4.9 值→&T 自动借用)——实参已为指针(pu:)直传;
        // 左值(Ident/成员)取址;右值(调用结果)堆盒取指针
        if pc.len > 1 && byte_at(pc, 0) == 112 {
            // P0-A:&T 形参借用(§4.9)——cast 型按型参代入后型别(Raw TPar 位
            // Req[S]→Req__I 与特化定义 __U3_App 劈叉即错型)
            var pty32 = mk("None")
            if callee != "" {
                var gd32 = ct_fn_decl(file, callee)
                if gd32.len > 0 {
                    if i < gd32[3].len {
                        if gd32[2].len > 1 && targs.len > 1 {
                            var tp32 = List[Str]()
                            var ty32 = List[Str]()
                            var gq32: I32 = 1
                            while gq32 < gd32[2].len {
                                tp32.push(gd32[2][gq32][1])
                                gq32 += 1
                            }
                            var gq33: I32 = 1
                            while gq33 < targs.len {
                                ty32.push(targs[gq33])
                                gq33 += 1
                            }
                            if tp32.len == ty32.len {
                                pty32 = ct_mono_subst_ty(gd32[3][i][3], tp32, ty32)
                            }
                        } else {
                            pty32 = gd32[3][i][3]
                        }
                    }
                }
            }
            var pc32 = pc
            if pty32[0] != "None" {
                pc32 = ct_ty_code(pty32, file)
            }
            var isptr31 = ac.len > 1 && byte_at(ac, 0) == 112
            if !isptr31 {
                if or2(ag[i][0] == "Ident", ag[i][0] == "Member") {
                    ax = "(" + ct_ctype(pc32) + ")(&(" + ax + "))"
                } else {
                    var inner31 = byte_slice(pc32, 1, pc32.len)
                    ax = "(" + ct_ctype(pc32) + ")(long)" + ct_wrap_i(inner31, ax)
                }
                // 借用后实参即指针(下游 u:-盒槽跳过)
                ac = pc32
            }
        }
        // P0-A Param 面:泛型特化被调 + u:-码实参 → ct_wrap_i 堆盒(特化形参
        // 槽 = int64 盒指针,帧序言解盒;非泛型被调保持 by-value 原样)
        var boxed30 = false
        if callee != "" {
            if ac.len > 2 && byte_slice(ac, 0, 2) == "u:" {
                var pgd30 = ct_fn_decl(file, callee)
                if pgd30.len > 0 && pgd30[2].len > 1 {
                    // P0-A:盒型按钉定后 env 的实参型别(字面量槽推断与 #名 钉型一致)
                    var acb30 = ct_typeof(ag[i], aenv, file)
                    if acb30.len > 2 && byte_slice(acb30, 0, 2) == "u:" {
                        ac = acb30
                    }
                    ax = ct_wrap_i(ac, ax)
                    boxed30 = true
                }
            }
        }
        if boxed30 {
            args = args + ct_arg_cast("6", "6", ax)
        } else {
            args = args + ct_arg_cast(ac, pc, ax)
        }
        i += 1
    }
    if callee != "" {
        var miss = pcs.len - (ag.len - from) - (from - 1)
        while miss > 0 {
            args = args + ", 0"
            miss -= 1
        }
    }
    return args
}

// 块语句序列(不含花括号与尾槽)
// 体内是否存在对该名的 Assign(递归所有子块)
// P0-A:泛型特化发射 + 调用串组装(自 TypeArgs 位抽出;UFCS 泛型位复用)。
// tpsn/tys 为型参名/实参节点表(0 基 push 形); callee 为被调名; targs 为调用点
// TypeArgs 节点表(实参 cast/闭包形参码 #clcodes 的代入源)。
fn ct_spec_call_emit(file: List[Str], env: List[Str], ag: List[Str], callee: Str, targs: List[Str], tpsn: List[Str], tys: List[Str], gdecl: List[Str], recvx: Str) -> Str {
                    var mg = "t_" + callee + "__"
                    var gk = 0
                    while gk < tys.len {
                        var tc = ct_ty_code(tys[gk], file)
                        var ms = ""
                        var mb: I32 = 0
                        while mb < tc.len {
                            var bc = byte_at(tc, mb)
                            if bc == 58 { ms = ms + "_" } else { ms = ms + byte_slice(tc, mb, mb + 1) }
                            mb += 1
                        }
                        mg = mg + ms
                        if gk < tys.len - 1 { mg = mg + "_" }
                        gk += 1
                    }

                // 定义发射判定:非特化体内,且(预提升模式 或 pass1)。
                // "#ph<深度>" 递增计数(预提升 phenv 的 "#p"=1 不走 pass1 分支)。
                // P0-A 单态化链("#phchain"):本 descent 已在发射(链上)的同实例
                // 不重下钻——run_chain 型闭包自递归与 web.* serve→limit→dispatch_h
                // →route_match→dummy_route 五层泛型嵌套,旧深度帽 3 必撞真语料;
                // 链断即收敛(每个实例每次 descent 至多全发一次),深度帽仍留(24)
                // 拦真·新实例无界递归(如 f[T]→f[List[T]] 逐层新码)。链上命中仅
                // 出块域前置原型(自/互递归 C 前向声明),定义在其祖先发射位。
                var emit_def = false
                var phd: I32 = 0
                var pk9: I32 = 1
                while pk9 <= 8 {
                    if ct_env_has(env, "#ph" + pk9.to_string()) {
                        phd = pk9
                    }
                    pk9 += 1
                }
                var chainx = ","
                if ct_env_has(env, "#phchain") {
                    chainx = ct_env_ty(env, "#phchain")
                }
                if phd > 0 {
                    if phd >= 8 {
                        panic("emit:泛型特化递归超限:" + mg)
                        return ""
                    }
                    if !ct_chain_has(chainx, mg) {
                        emit_def = true
                    }
                } else {
                    if !ct_env_has(env, "#spec") {
                        if seq2(ct_pass(env), "1") {
                            emit_def = true
                        }
                    }
                }
                if emit_def {
                    var spec = mk("Fn")
                    spec.push(mg)
                    spec.push(mk("TPs"))
                    var ps2 = mk("Ps")
                    // P0-A:subst 型别节点/原名平行表(u:-形参盒槽化后 genv/引脚仍按
                    // 原名+subst 型别绑定;签名槽 = int64 盒指针)
                    var substnodes = List[Str]()
                    var orignames = List[Str]()
                    var upnames = List[Str]()
                    var upcodes = List[Str]()
                    var pk: I32 = 1
                    while pk < gdecl[3].len {
                        var pr = gdecl[3][pk]
                        if pr[0] == "Param" {
                            var subst26 = ct_mono_subst_ty(pr[3], tpsn, tys)
                            var pc26 = ct_ty_code(subst26, file)
                            substnodes.push(subst26)
                            orignames.push(pr[2])
                            var np = mk("Param")
                            np.push(pr[1])
                            if pc26.len > 2 && byte_slice(pc26, 0, 2) == "u:" {
                                // P0-A Param 面:struct 形参过 ct_i 边界 = int64 盒槽
                                // + 帧序言 T54 式解盒(续体/首跳/递归自跳三面同约定)
                                np.push(pr[2] + "_s")
                                np.push(ct_scalar_ty("I64"))
                                upnames.push(pr[2])
                                upcodes.push(pc26)
                            } else {
                                np.push(pr[2])
                                np.push(subst26)
                            }
                            ps2.push(np)
                        } else {
                            substnodes.push(mk("None"))
                            ps2.push(pr)
                        }
                        pk += 1
                    }
                    spec.push(ps2)
                    spec.push(ct_mono_subst_ty(gdecl[4], tpsn, tys))
                    spec.push(gdecl[5])
                    // T45:void 泛型特化——None 返回节点 ct_ty_code 无臂落 "i",
                    // 特化头发 int32_t 且尾调用被捕值(t_rv),尾为 void 外调即
                    // int32_t=void 编译错(cbox_free[T] 首证);对齐 ct_fn_ret 的
                    // None→"v" 口径
                    var rcs = "i"
                    if spec[4].len > 0 && spec[4][0] == "None" {
                        rcs = "v"
                    } else {
                        rcs = ct_ty_code(spec[4], file)
                    }
                    // 形参 env:按原名绑替换后型别码(盒槽形参解盒后即原 struct 值,
                    // 体内 Member/字段访问/F-gate 包裹全部沿用)
                    var genv = List[Str]()
                    var gk2: I32 = 1
                    while gk2 < ps2.len {
                        var gr2 = ps2[gk2]
                        var sn2 = substnodes[gk2 - 1]
                        if gr2[0] == "Param" {
                            var onm2 = orignames[gk2 - 1]
                            genv = env_bind(genv, onm2, ct_ty_code(sn2, file))
                            var elc9 = ct_opt_elem_strict(file, sn2)
                            if elc9.len > 0 {
                                genv = env_bind(genv, "#elem:" + onm2, elc9)
                            }
                            // P0-A:FnType 形参 #fret 侧条目(镜像 ct_fn 绑定)——
                            // run_chain 的 h(req) 结构返回经 #fret 原型化,缺臂落
                            // ct_i 返回槽(>8B struct 即错型)
                            if sn2[0] == "FnType" {
                                var frc10 = ct_ty_code(sn2[2], file)
                                if frc10 != "v" {
                                    if frc10 != "i" {
                                        genv = env_bind(genv, "#fret:" + onm2, frc10)
                                    }
                                }
                            }
                        }
                        gk2 += 1
                    }
                    // P0-A:闭包命名前缀——特化体 genv 旧无 #clofn,体内闭包 shim
                    // 取 ct_env_ty 默认 "i" → ct_clo_i_L<行> 跨特化撞名重定义
                    genv = env_bind(genv, "#clofn", mg)
                    // P0-A:返回 fn 型特化的 #retfn 侧条目(镜像 ct_fn;返回位闭包
                    // 形参码经型参代入——with_sessions 型 fn(Req[S], fn)->Resp 即此)
                    if spec[4][0] == "FnType" {
                        var racc26 = ""
                        var rpi26: I32 = 1
                        while rpi26 < spec[4][1].len {
                            if rpi26 > 1 {
                                racc26 = racc26 + ","
                            }
                            if spec[4][1][rpi26][0] == "FnType" {
                                racc26 = racc26 + ct_fsig_code(file, spec[4][1][rpi26])
                            } else {
                                racc26 = racc26 + ct_ty_code(spec[4][1][rpi26], file)
                            }
                            rpi26 += 1
                        }
                        if racc26.len > 0 {
                            genv = env_bind(genv, "#retfn", racc26)
                        }
                    }
                    // 型参名 → 实参码(体内 List[K] 等 typeof 依据;tpsn/tys 为 push 构建 0 基!)
                    var tk2: I32 = 0
                    while tk2 < tpsn.len {
                        genv = env_bind(genv, tpsn[tk2], ct_ty_code(tys[tk2], file))
                        tk2 += 1
                    }
                    var pk3: I32 = 1
                    while pk3 < ps2.len {
                        if ps2[pk3][0] == "Param" {
                            var ic5 = ct_inst_of_ty(file, substnodes[pk3 - 1])
                            if ic5.len > 0 {
                                genv = env_bind(genv, "#" + ct_struct_name_of(ic5), ic5)
                            }
                        }
                        pk3 += 1
                    }
                    var ic6 = ct_inst_of_ty(file, spec[4])
                    if ic6.len > 0 {
                        genv = env_bind(genv, "#" + ct_struct_name_of(ic6), ic6)
                    }
                    // P0-A:单态化链入 env——本 def 的 prewalk 带祖先链,链上同实例
                    // 不重下钻(真递归收敛点;run_chain 闭包自递归即此形)
                    genv = env_bind(genv, "#phchain", chainx + mg + ",")
                    // 嵌套预提升:#p=1 静默遍历特化体,体内嵌套单态化的定义直出文件作用域
                    ct_body(spec[5], env_bind(env_bind(genv, "#p", "1"), "#ph" + (phd + 1).to_string(), "1"), file, rcs)
                    // 实例 typedef 先于特化签名(同实参多调用点:#ifndef 卫兵去重)
                    pk3 = 1
                    while pk3 < ps2.len {
                        if ps2[pk3][0] == "Param" {
                            ct_emit_inst_typedef(file, substnodes[pk3 - 1])
                        }
                        pk3 += 1
                    }
                    ct_emit_inst_typedef(file, spec[4])
                    println("//DD2:" + mg + " phd=" + phd.to_string())
                    println("#ifndef CT_SPEC_" + mg)
                    println("#define CT_SPEC_" + mg)
                    // P9 栈面全量:特化位序言机器(盒槽形参特化跳过——桶捕 _s 槽名
                    // 与解盒序言纠缠,v1 登记面;margin 兜底)。mg 前置原型:thunk
                    // 先于定义引用 mg(特化无 up-front 原型区)。
                    var mspro26 = ""
                    if upnames.len == 0 {
                        println(ct_ctype(rcs) + " " + mg + "(" + ct_params_str(spec, file) + ");")
                        mspro26 = ct_ms_pre(mg, spec, file, rcs)
                    }
                    println(ct_ctype(rcs) + " " + mg + "(" + ct_params_str(spec, file) + ") ")
                    // P0-A Param 面:盒槽形参帧序言 T54 式解盒(u:-形参 → int64 盒槽,
                    // 调用位 ct_wrap_i 堆盒;解盒即原 struct 值,体内三面调用全沿用)。
                    // "#nobrace":花括号由此处自带(ct_body 位跳过)
                    genv = env_bind(genv, "#nobrace", "1")
                    println("\{")
                    if mspro26.len > 0 {
                        println(mspro26)
                    }
                    var upi26: I32 = 0
                    // T31 M1.5:spec 帧节点+解盒形参注册(#nobrace 面,直出不经 ct_body)
                    var spfr26 = ct_fr_prologue()
                    while upi26 < upnames.len {
                        var upc26 = upcodes[upi26]
                        println("t_" + byte_slice(upc26, 2, upc26.len) + " t_" + upnames[upi26] + " = *(t_" + byte_slice(upc26, 2, upc26.len) + "*)(long)t_" + upnames[upi26] + "_s;")
                        var srl26 = ct_reg_line(upnames[upi26], upc26)
                        if srl26.len > 0 {
                            spfr26 = spfr26 + " " + srl26
                        }
                        upi26 += 1
                    }
                    println(spfr26)
                    // 真实体:#p=2(eln 直出)+ #spec=1(嵌套单态化只发调用)+ #frpro(帧在,提升门)
                    ct_body(spec[5], env_bind(env_bind(env_bind(genv, "#p", "2"), "#spec", "1"), "#frpro", "1"), file, rcs)
                    println("#endif")
                }
                if phd > 0 {
                    if ct_chain_has(chainx, mg) {
                        // P0-A:链上同实例——仅块域前置原型(定义在其祖先发射位,
                        // 文本后置:C 前向声明补齐自/互递归面),不再下钻
                        var fret26 = ct_mono_subst_ty(gdecl[4], tpsn, tys)
                        var prt26 = ct_ctype(ct_ty_code(fret26, file))
                        var prp26 = ""
                        var pk26: I32 = 1
                        while pk26 < gdecl[3].len {
                            var pr26 = gdecl[3][pk26]
                            if pr26[0] == "Param" {
                                var pc28 = ct_ty_code(ct_mono_subst_ty(pr26[3], tpsn, tys), file)
                                if pc28.len > 2 && byte_slice(pc28, 0, 2) == "u:" {
                                    prp26 = prp26 + ", int64_t"
                                } else {
                                    prp26 = prp26 + ", " + ct_ctype(pc28)
                                }
                            }
                            pk26 += 1
                        }
                        var pra26 = ""
                        if prp26.len > 2 {
                            pra26 = byte_slice(prp26, 2, prp26.len)
                        }
                        // 块域原型不带 static(C 禁块域 static 存储类;定义位
                        // 本就无 static 外链,声明一致)
                        println(prt26 + " " + mg + "(" + pra26 + ");")
                    }
                }
                // TypeArgs 调用实参自槽 1 起;UFCS 位(recvx 非空)接收者即
                // 首参(已按 p0 cast),实参对位 pcs[1..],闭包实参 #clcodes 经
                // targs(推断层)代入
                var gargs = ""
                if recvx.len > 0 {
                    gargs = recvx
                    var pcs9 = ct_fn_pcodes(file, callee)
                    var gi9: I32 = 1
                    while gi9 < ag.len {
                        var pc9 = "i"
                        if gi9 < pcs9.len { pc9 = pcs9[gi9] }
                        var aenv9 = env
                        if ag[gi9][0] == "Ident" {
                            if pc9.len > 0 {
                                if byte_at(pc9, 0) == 70 {
                                    // P0-A:同 ct_call_args_tg——decl 在案判别位
                                    //(0 参 fn 补包装);env 先行:形参/局部闭包值
                                    // 直传(域包体内同名形参撞用户全局 fn 误包装同根)
                                    if !ct_env_has(env, ag[gi9][1]) {
                                        if ct_fn_decl_any(file, ag[gi9][1]) {
                                            var rfpcs9 = ct_fn_pcodes(file, ag[gi9][1])
                                            if rfpcs9.len == byte_at(pc9, 1) - 48 {
                                                var fv9 = ct_fval_emit(file, ag[gi9][1], "C" + nline(ag[gi9]))
                                                gargs = gargs + ", " + fv9
                                                gi9 += 1
                                                continue
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if ag[gi9][0] == "Closure" {
                            if pc9.len > 0 {
                                if byte_at(pc9, 0) == 70 {
                                    var cc9 = ct_fntype_pcodes_tg(file, callee, gi9, targs)
                                    if cc9.len > 0 {
                                        aenv9 = env_bind(env, "#clcodes", cc9)
                                    }
                                }
                            }
                        }
                        var ac9 = ct_typeof(ag[gi9], aenv9, file)
                        var ax9 = ct_expr(ag[gi9], aenv9, file)
                        if ac9.len > 2 && byte_slice(ac9, 0, 2) == "u:" {
                            ax9 = ct_wrap_i(ac9, ax9)
                            gargs = gargs + ", " + ct_arg_cast("6", "6", ax9)
                        } else {
                            gargs = gargs + ", " + ct_arg_cast(ac9, pc9, ax9)
                        }
                        gi9 += 1
                    }
                } else {
                    gargs = ct_call_args_tg(ag, 1, env, file, callee, targs)
                }
                var grc = ct_generic_retcode(file, callee, tpsn, tys)
                var gcall = mg + "(" + gargs + ")"
                if or2(grc == "L", ct_is_tlcode(grc)) { gcall = "(ctron_list*)(" + gcall + ")" }
                return gcall
}

// P0-A:裸 fn 引用 → env-first 解箱 shim(ct_clop;env ≠ 哨兵)——T55 闭包 ABI
// 同约定:u:-形参解盒、u:/fn-返回盒化;旧裸地址直填 fn 槽(env=邻接内存垃圾,
// fhead env-first 首参即烂)——with_sessions 的 now 捕获、post(..., h_login) 即此面
fn ct_fval_emit(file: List[Str], nm: Str, tag: Str) -> Str {
    var pcs31 = ct_fn_pcodes(file, nm)
    var anm31 = "ct_fval_" + nm + "_" + tag
    var far31 = pcs31.len
    var ret31 = ct_fn_ret(file, nm)
    {
        var asig31 = "void* _cp"
        var ai31: I32 = 0
        while ai31 < far31 {
            asig31 = asig31 + ", ct_i _p" + ai31.to_string()
            ai31 += 1
        }
        println("#ifndef CT_FVAL_" + anm31)
        println("#define CT_FVAL_" + anm31)
        println("static ct_i " + anm31 + "(" + asig31 + ") \{")
        var aargs31 = ""
        ai31 = 0
        while ai31 < far31 {
            var pc31 = "i"
            if ai31 < pcs31.len { pc31 = pcs31[ai31] }
            var acc31 = "(int32_t)_p" + ai31.to_string()
            if pc31.len > 2 && byte_slice(pc31, 0, 2) == "u:" {
                acc31 = "*(t_" + byte_slice(pc31, 2, pc31.len) + "*)(long)_p" + ai31.to_string()
            } else {
                if pc31.len > 2 && byte_slice(pc31, 0, 2) == "B:" {
                    // Box[T] 形参 = 堆单值指针直传(t_P*;与 u: 按值解引用异构)
                    acc31 = "(t_" + byte_slice(pc31, 2, pc31.len) + "*)(long)_p" + ai31.to_string()
                } else {
                    if pc31.len > 1 && byte_at(pc31, 0) == 112 {
                        // P0-A:&T 形参(pu: 码)——ct_i 槽指针直传
                        acc31 = "(" + ct_ctype(pc31) + ")(long)_p" + ai31.to_string()
                    } else {
                        if or2(seq2(pc31, "s"), seq2(pc31, "N")) {
                            acc31 = "(const char*)(long)_p" + ai31.to_string()
                        } else {
                            if or2(seq2(pc31, "6"), or2(seq2(pc31, "7"), seq2(pc31, "z"))) {
                                acc31 = "(int64_t)(long)_p" + ai31.to_string()
                            } else {
                                if pc31.len > 1 && or2(byte_at(pc31, 0) == 70, byte_at(pc31, 0) == 71) {
                                    acc31 = "(ct_clop)(long)_p" + ai31.to_string()
                                }
                            }
                        }
                    }
                }
            }
            if ai31 > 0 { aargs31 = aargs31 + ", " }
            aargs31 = aargs31 + acc31
            ai31 += 1
        }
        if ret31.len > 2 && byte_slice(ret31, 0, 2) == "u:" {
            println("return (\{ " + ct_ctype(ret31) + "* _rb = (" + ct_ctype(ret31) + "*)ctron_amalloc(sizeof(" + ct_ctype(ret31) + ")); *_rb = t_" + nm + "(" + aargs31 + "); (ct_i)(long)_rb; });")
        } else {
            if ret31.len > 1 && or2(byte_at(ret31, 0) == 70, byte_at(ret31, 0) == 71) {
                println("return (ct_i)(long)t_" + nm + "(" + aargs31 + ");")
            } else {
                if or2(seq2(ret31, "s"), seq2(ret31, "N")) {
                    println("return (ct_i)(long)t_" + nm + "(" + aargs31 + ");")
                } else {
                    if seq2(ret31, "v") {
                        // void 返回:调用后回 0((ct_i) 作用于 void 调用为非法 C,六红 s33 族病灶)
                        println("t_" + nm + "(" + aargs31 + "); return 0;")
                    } else {
                        println("return (ct_i)t_" + nm + "(" + aargs31 + ");")
                    }
                }
            }
        }
        println("}")
        println("#endif")
    }
    return "(\{ ct_clop _cfv = (ct_clop)ctron_amalloc(sizeof(ct_clo)); _cfv->fn = (void*)" + anm31 + "; _cfv->env = (void*)0; _cfv; })"
}

fn ct_assigned(nm: Str, b: List[Str]) -> Bool {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Assign" {
            if st[1][0] == "Ident" && st[1][1] == nm {
                return true
            }
            if st[1][0] == "Index" && st[1][1][0] == "Ident" && st[1][1][1] == nm {
                return true
            }
        }
        // 递归子块/子表达式容器
        if t == "While" {
            if ct_assigned(nm, st[2]) {
                return true
            }
        }
        if t == "For" {
            if ct_assigned(nm, st[3]) {
                return true
            }
        }
        if t == "If" {
            if ct_assigned(nm, st[2]) {
                return true
            }
            if st[3][0] == "If" {
                if ct_assigned(nm, st[3]) {
                    return true
                }
            } else {
                if st[3][0] == "BlockExpr" {
                    if ct_assigned(nm, st[3][1]) {
                        return true
                    }
                }
            }
        }
        if t == "Match" {
            var arms = st[2]
            var mi: I32 = 1
            while mi < arms.len {
                var be = arms[mi][2]
                if be[0] == "BlockExpr" {
                    if ct_assigned(nm, be[1]) {
                        return true
                    }
                }
                mi += 1
            }
        }
        i += 1
    }
    return false
}

// while 体顶层 let 名单(提升声明用):简单模式 + 标量/指针码 + 体内零赋值
// (数组 init 花括号不提升;有赋值的动态型变量不提升 —— 静态型别保不住)。
// 候选按序绑定到不断增长的 ew:后候选的 init 可见先候选的型别(如 ty = f[3] 需 f:N)
fn ct_hoists(b: List[Str], env: List[Str], file: List[Str]) -> List[Str] {
    var out = List[Str]()
    var ew = env
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        if st[0] == "Let" {
            var pat = st[2]
            if or2(pat[0] == "PatId", pat[0] == "PatAgg" && pat[2][0] == "SubUnit") {
                if !ct_assigned(pat[1], b) {
                    var ty = "i"
                    if st[3][0] != "None" {
                        ty = ct_ty_code(st[3], file)
                    } else {
                        ty = ct_typeof(st[4], ew, file)
                    }
                    if ty != "L" && !ct_is_tlcode(ty) && ty != "A" && ty != "R" && ty != "g" && ty != "k" && ty != "h" && !(ty.len > 1 && or2(byte_at(ty, 0) == 109, byte_at(ty, 0) == 80)) && !(ty.len >= 3 && byte_slice(ty, 0, 1) == "a") && !(ty.len > 1 && or2(or3(byte_at(ty, 0) == 117, byte_at(ty, 0) == 66, byte_at(ty, 0) == 69), byte_at(ty, 0) == 119)) {
                        out.push(pat[1] + ":" + ty)
                        ew = env_bind(ew, pat[1], ty)
                    }
                }
            }
        }
        i += 1
    }
    return out
}

// FB-9:TP 码第 idx 段元素码(浅切分;嵌套元组段=登记债)
fn ct_tp_elem(code: Str, idx: Str) -> Str {
    var seg5 = byte_slice(code, 3, code.len)
    var ci5: I32 = 0
    var cur5 = ""
    var hit5 = ""
    var q5: I32 = 0
    while q5 < seg5.len {
        if byte_at(seg5, q5) == 44 {
            if ci5.to_string() == idx { hit5 = cur5 }
            ci5 += 1
            cur5 = ""
        } else {
            cur5 = cur5 + byte_slice(seg5, q5, q5 + 1)
        }
        q5 += 1
    }
    if ci5.to_string() == idx { hit5 = cur5 }
    return hit5
}

// 嵌套数组字面 → C 嵌套花括号(FB-8 嵌套面;元素 ArrLit 递归,余 ct_expr)
fn ct_arr_lit_braces(al: List[Str], env: List[Str], file: List[Str]) -> Str {
    var out = "\{"
    var k: I32 = 1
    while k < al.len {
        if k > 1 { out = out + ", " }
        if al[k][0] == "ArrLit" {
            out = out + ct_arr_lit_braces(al[k], env, file)
        } else {
            out = out + ct_expr(al[k], env, file)
        }
        k += 1
    }
    return out + "}"
}

fn ct_zero(code: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        return "(t_" + byte_slice(code, 2, code.len) + ")\{0}"
    }
    if code == "f" { return "0.0" }
    if code == "g" { return "0.0" }
    return "0"
}

// 定长数组码 a<N><元素码> 拆分(§四 #7 修复):元素码可为数字形态(6=I64/7=U64),
// 旧贪心数字解析把 a36(3×I64)读成 36×I32 且元素回落 i。现回溯式:计数取最长
// 数字前缀,余下须以合法元素码首字符开头;合法首字符全集 = 单字符码 + 多字符码首字
fn a_split(code: Str) -> I32 {
    var d = code.len
    var k = d - 1
    while k > 1 {
        var c = byte_at(code, k)
        var ok = false
        var set = "isbgf67NghRALvuwBEmP"
        var t: I32 = 0
        while t < set.len {
            if byte_at(set, t) == c {
                ok = true
            }
            t += 1
        }
        if ok {
            var alldig = true
            var u: I32 = 1
            while u < k {
                var cc = byte_at(code, u)
                if cc < 48 || cc > 57 {
                    alldig = false
                }
                u += 1
            }
            if alldig {
                return k
            }
        }
        k -= 1
    }
    return 2
}

fn a_count(code: Str) -> Str {
    if code.len < 2 {
        return "0"
    }
    return byte_slice(code, 1, a_split(code))
}

fn a_elem(code: Str) -> Str {
    if code.len < 2 {
        return "i"
    }
    return byte_slice(code, a_split(code), code.len)
}

// @derive(Show) 合成(§3d):值 C 表达式 x(静态码 ty)→ 显示文本 C 表达式。
// 标量/Str 按插值同型转换;struct 按声明序递归展开字段 —— 串接链
// "Name(" + ("f=<v>",)*n + ")" 与 eval 侧 fmt_struct 逐字对齐。深度限 6(镜像宿主)。
fn ct_show_frag_dp(x: Str, ty: Str, env: List[Str], file: List[Str], dp: I32) -> Str {
    if or2(ty == "s", ty == "N") { return "(" + x + ")" }
    if ty == "i" { return "ctron_i32_to_string((int32_t)(" + x + "))" }
    if ty == "6" { return "ctron_i64_to_string((int64_t)(" + x + "))" }
    if ty == "b" { return "((" + x + ") ? \"true\" : \"false\")" }
    if dp < 6 {
        if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
            var snm = ct_struct_name_of(ty)
            var gen = false
            if ct_struct_tps(file, snm).len > 0 {
                gen = true
            }
            var fs = List[Str]()
            var i: I32 = 1
            while i < file.len {
                var d = file[i]
                if d[0] == "Struct" && d[1] == snm {
                    fs = d[4]
                }
                i += 1
            }
            var acc = "\"" + ct_cstr(snm) + "(\""
            var j: I32 = 1
            var first = true
            while j < fs.len {
                var fd = fs[j]
                var fty = ""
                if gen {
                    fty = ct_field_ty_inst(file, ty, fd[2])
                } else {
                    fty = ct_field_ty(file, snm, fd[2])
                }
                var fx = ct_show_frag_dp("(" + x + ")." + fd[2], fty, env, file, dp + 1)
                if first {
                    first = false
                } else {
                    acc = "ctron_str_concat(" + acc + ", \",\")"
                }
                acc = "ctron_str_concat(" + acc + ", \"" + ct_cstr(fd[2]) + "=\")"
                acc = "ctron_str_concat(" + acc + ", " + fx + ")"
                j += 1
            }
            acc = "ctron_str_concat(" + acc + ", \")\")"
            return acc
        }
    }
    panic("emit:show 字段型别:" + ty)
    return ""
}

// @derive(Eq) 合成(§3d):a/b 的 C 表达式(静态码 ty)→ 逐字段相等 C 布尔式。
// 标量 ==、Str strcmp、嵌套 struct 递归展开;"&&" 为 C 输出文本,
// 与 eval 侧 eq_val 逐字对齐。深度限 6(镜像 show)。
fn ct_eq_expr_dp(a: Str, b: Str, ty: Str, env: List[Str], file: List[Str], dp: I32) -> Str {
    if ty == "s" { return "(strcmp((const char*)(" + a + "), (const char*)(" + b + ")) == 0)" }
    if or2(ty == "i", or2(ty == "6", ty == "b")) { return "((" + a + ") == (" + b + "))" }
    if dp < 6 {
        if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
            var snm = ct_struct_name_of(ty)
            var gen = false
            if ct_struct_tps(file, snm).len > 0 {
                gen = true
            }
            var fs = List[Str]()
            var i: I32 = 1
            while i < file.len {
                var d = file[i]
                if d[0] == "Struct" && d[1] == snm {
                    fs = d[4]
                }
                i += 1
            }
            var acc = ""
            var j: I32 = 1
            while j < fs.len {
                var fd = fs[j]
                var fty = ""
                if gen {
                    fty = ct_field_ty_inst(file, ty, fd[2])
                } else {
                    fty = ct_field_ty(file, snm, fd[2])
                }
                var fc = ct_eq_expr_dp("(" + a + ")." + fd[2], "(" + b + ")." + fd[2], fty, env, file, dp + 1)
                if acc == "" {
                    acc = fc
                } else {
                    acc = "(" + acc + " && " + fc + ")"
                }
                j += 1
            }
            if acc == "" {
                return "1"
            }
            return acc
        }
    }
    panic("emit:eq 字段型别:" + ty)
    return ""
}

// 单态化支撑:具体实例型别节点 → 实例码(非实例/无实参 → "")
fn ct_inst_of_ty(file: List[Str], nt: List[Str]) -> Str {
    // P0-A:&T 实参(pu: 码)透过 Ref 收集实例 typedef(&Req[S] 形参位)
    if nt[0] == "Ref" {
        return ct_inst_of_ty(file, nt[1])
    }
    if nt[0] == "Named" {
        if nt[2].len > 1 {
            if ct_struct_tps(file, nt[1]).len > 0 {
                var cs = List[Str]()
                var q: I32 = 1
                while q < nt[2].len {
                    cs.push(ct_ty_code(nt[2][q], file))
                    q += 1
                }
                return ct_struct_inst_code(nt[1], cs)
            }
        }
    }
    return ""
}

// 单态化点实例 typedef 直出(C 重复 typedef 合法,免去去重状态);
// 实参为嵌套实例时递归。pass1 内调用,先于 pass2 引用。
fn ct_emit_inst_typedef(file: List[Str], nt: List[Str]) {
    // P0-A:&T 透传(&Req[S] 形参位的实例 typedef)
    if nt[0] == "Ref" {
        ct_emit_inst_typedef(file, nt[1])
        return
    }
    if nt[0] != "Named" {
        return
    }
    if nt[2].len > 1 {
        var q2: I32 = 1
        while q2 < nt[2].len {
            ct_emit_inst_typedef(file, nt[2][q2])
            q2 += 1
        }
    }
    var ic = ct_inst_of_ty(file, nt)
    if ic.len == 0 {
        return
    }
    // 匿名 struct 重复 typedef 亦是重定义 → 预处理卫兵去重(同型多调用点)
    var tn = ct_ctype(ic)
    println("#ifndef CT_TDEF_" + tn)
    println("#define CT_TDEF_" + tn)
    var info = ct_struct_inst_split(ic)
    var bar = 0
    var ci: I32 = 0
    while ci < info.len {
        if byte_at(info, ci) == 124 { bar = ci }
        ci += 1
    }
    var snm = byte_slice(info, 0, bar)
    var encs = byte_slice(info, bar + 1, info.len)
    var ii: I32 = 1
    while ii < file.len {
        var sd = file[ii]
        if sd[0] == "Struct" && sd[1] == snm {
            var fs = sd[4]
            var line = "typedef struct \{ "
            var fj: I32 = 1
            while fj < fs.len {
                var fd = fs[fj]
                var dc = ct_field_code_inst(file, fd[3], snm, encs)
                // P0-A:字段引用嵌套实例(u:X__尾缀)先出其 typedef(C 依序完整型);
                // Lu: 装箱槽 ctron_list* 自足,无需 typedef
                if dc.len > 2 && byte_slice(dc, 0, 2) == "u:" && ct_struct_inst_split(dc).len > 1 {
                    var dnt = ct_inst_ty_node(dc)
                    ct_emit_inst_typedef(file, dnt)
                }
                line = line + ct_ctype(dc) + " " + fd[2] + "; "
                fj += 1
            }
            line = line + "} " + tn + ";"
            println(line)
            println("#endif")
        }
        ii += 1
    }
}
