                var x1 = ct_expr(ag[1], env, file)
                var x2 = ct_expr(ag[2], env, file)
                if seq2(m, "and_i32") { return "(int32_t)(((uint32_t)(" + x1 + ")) & ((uint32_t)(" + x2 + ")))" }
                if seq2(m, "and_u32") { return "(uint32_t)(((uint32_t)(" + x1 + ")) & ((uint32_t)(" + x2 + ")))" }
                if seq2(m, "and_i64") { return "(int64_t)(((uint64_t)(" + x1 + ")) & ((uint64_t)(" + x2 + ")))" }
                if seq2(m, "and_u64") { return "(uint64_t)(((uint64_t)(" + x1 + ")) & ((uint64_t)(" + x2 + ")))" }
                if seq2(m, "or_i32") { return "(int32_t)(((uint32_t)(" + x1 + ")) | ((uint32_t)(" + x2 + ")))" }
                if seq2(m, "or_u32") { return "(uint32_t)(((uint32_t)(" + x1 + ")) | ((uint32_t)(" + x2 + ")))" }
                if seq2(m, "or_i64") { return "(int64_t)(((uint64_t)(" + x1 + ")) | ((uint64_t)(" + x2 + ")))" }
                if seq2(m, "or_u64") { return "(uint64_t)(((uint64_t)(" + x1 + ")) | ((uint64_t)(" + x2 + ")))" }
                if seq2(m, "xor_i32") { return "(int32_t)(((uint32_t)(" + x1 + ")) ^ ((uint32_t)(" + x2 + ")))" }
                if seq2(m, "xor_u32") { return "(uint32_t)(((uint32_t)(" + x1 + ")) ^ ((uint32_t)(" + x2 + ")))" }
                if seq2(m, "xor_i64") { return "(int64_t)(((uint64_t)(" + x1 + ")) ^ ((uint64_t)(" + x2 + ")))" }
                if seq2(m, "xor_u64") { return "(uint64_t)(((uint64_t)(" + x1 + ")) ^ ((uint64_t)(" + x2 + ")))" }
                if seq2(m, "shl_i32") { return "ct_bit_shl_i32((int32_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
                if seq2(m, "shl_u32") { return "ct_bit_shl_u32((uint32_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
                if seq2(m, "shl_i64") { return "ct_bit_shl_i64((int64_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
                if seq2(m, "shl_u64") { return "ct_bit_shl_u64((uint64_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
                if seq2(m, "shr_i32") { return "ct_bit_shr_i32((int32_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
                if seq2(m, "shr_u32") { return "ct_bit_shr_u32((uint32_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
                if seq2(m, "shr_i64") { return "ct_bit_shr_i64((int64_t)(" + x1 + "), (int32_t)(" + x2 + "))" }
