// =====================================================================
// trans_expr.ct —— 表达式发射:ct_expr 节点→C 表达式(字面量/运算/调用/成员/
// 索引/插值串 ctron_str_concat 链接)、ct_call_args 实参(形参类型码插转换 L↔N/A)、
// ct_assigned/ct_hoists 声明提升、ct_zero 零值、a_count/a_elem 定长数组码解析。
// =====================================================================
fn ct_expr(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" {
        // 宽字面量(I32 装不下,§3.1.1)转十进制加 LL 后缀——sem E2040 已保证
        // 窄类型语境不达此;仅无后缀(C 进制常量超宽 ill-formed)
        if e[2].len == 0 {
            if lit_wide_i32(e[1]) {
                return lit_to_dec(e[1]) + "LL"
            }
        }
        return e[1]
    }
    if t == "Float" { return e[1] }
    if t == "NParg" {
        // P2:命名实参值透传(ViewCall 载荷;desugar 未达面防御)
        return ct_expr(e[2], env, file)
    }
    if t == "Str" {
        var parts = e[1]
        var acc = ""
        var j: I32 = 1
        while j < parts.len {
            var p = parts[j]
            var frag = ""
            if p[0] == "Text" {
                frag = "\"" + ct_cstr(p[1]) + "\""
            } else {
                // 插值(§4.11):发射器内联解析片段 → 按类型转 C 串
                var toks2 = List[Str]()
                var lns2 = List[Str]()
                scan(p[1], toks2, lns2)
                var cur2 = Atomic[I32](0)
                var ie = p_stmt_expr(toks2, cur2, lns2, "1")
                var ik = ct_typeof(ie, env, file)
                var core = ct_expr(ie, env, file)
                if or2(ik == "s", ik == "N") {
                    frag = "(" + core + ")"
                } else if ik == "i" {
                    frag = "ctron_i32_to_string((int32_t)(" + core + "))"
                } else if ik == "6" {
                    frag = "ctron_i64_to_string((int64_t)(" + core + "))"
                } else if ik == "b" {
                    frag = "((" + core + ") ? \"true\" : \"false\")"
                } else if ik.len > 2 && byte_slice(ik, 0, 2) == "u:" {
                    // struct 插值:合成 Name(f=v,...)(eval fmt_struct 同族)
                    frag = ct_show_frag_dp(core, ik, env, file, 0)
                } else {
                    panic("ct_expr:interp 类型")
                    return ""
                }
            }
            if acc == "" {
                acc = frag
            } else {
                acc = "ctron_str_concat(" + acc + ", " + frag + ")"
            }
            j += 1
        }
        if acc == "" {
            return "\"\""
        }
        return acc
    }
    if t == "Bool" {
        if e[1] == "true" { return "1" }
        return "0"
    }
    if t == "NParg" {
        // P2 二次攻坚:组件实参值表达式透传(trans 侧无专属形态——NParg 仅是
        // 带 prop 名的包裹,值语义即子表达式)
        return ct_expr(e[2], env, file)
    }
    if t == "Ident" {
        if ct_env_has(env, e[1]) {
            var icd = ct_env_ty(env, e[1])
            if icd.len > 1 && byte_at(icd, 0) == 80 {
                // P<内> 伪码:with_mut 体内参数 = 内值指针 → 解引用
                return "(*t_" + e[1] + ")"
            }
            return "t_" + e[1]
        }
        if seq2(e[1], "None") {
            return "(\{ ct_res _r; _r.variant = 1; _r.v = 0; _r; })"
        }
        var ien = ct_enum_of_variant(file, e[1])
        if ien.len > 0 {
            var iidx = ct_variant_index(file, ien, e[1])
            return "(ct_enum_" + ien + ")\{ " + iidx.to_string() + ", \{ 0, 0 } }"
        }
        if e[1] == "clo_cb2" { return "(ct_fn2)ctron_clo_tramp2" }
        if e[1] == "clo_cb3" { return "(ct_fn3)ctron_clo_tramp3" }
        var pcs5 = ct_fn_pcodes(file, e[1])
        if pcs5.len > 0 {
            if pcs5.len > 3 {
                panic("emit:fn 值 arity>3")
                return ""
            }
            // 裸 fn 值装箱(v0.8 锐边收口):fn 槽存 C-ABI 蹦床 ct_cbtr_<名>
            //(全宽 ct_i 实参,替代旧 ct_ad shim 的 int32 截断),env = (void*)1
            // 哨兵——Ctron 侧间接调用走哨兵直路,再传 C 边界自带蹦床
            //(task 态 panic 策略全覆盖)
            var anm = "ct_cbtr_" + e[1]
            if seq2(ct_pass(env), "1") {
                var asig = ""
                var ai: I32 = 0
                var first9 = true
                while ai < pcs5.len {
                    if !first9 { asig = asig + ", " }
                    asig = asig + "ct_i _cbp" + ai.to_string()
                    first9 = false
                    ai += 1
                }
                println("#ifndef CT_CBTR_" + e[1])
                println("#define CT_CBTR_" + e[1])
                println("static ct_i " + anm + "(" + asig + ") \{")
                var acall = ""
                ai = 0
                while ai < pcs5.len {
                    if ai > 0 { acall = acall + ", " }
                    // T54:struct 形参解盒——#fret 间接调用位 ct_wrap_i 对 u: 码传堆盒
                    // 指针(trans_conc ct_wrap_i),蹦床按声明型解引用值拷贝;裸 ct_i
                    // 直传 struct 按值形参为非法 C(探针 p3:incompatible type t_Req)
                    var cbp5 = pcs5[ai]
                    if cbp5.len > 2 && byte_slice(cbp5, 0, 2) == "u:" {
                        acall = acall + "*(t_" + byte_slice(cbp5, 2, cbp5.len) + "*)(long)_cbp" + ai.to_string()
                    } else if cbp5.len > 2 && byte_slice(cbp5, 0, 2) == "B:" {
                        // Box[T] 形参 = 堆单值指针直传(t_P*;与 u: 按值解引用异构)
                        acall = acall + "(t_" + byte_slice(cbp5, 2, cbp5.len) + "*)(long)_cbp" + ai.to_string()
                    } else if cbp5.len > 1 && byte_at(cbp5, 0) == 112 {
                        // 裸指针形参(v0.9·五):ct_i → T* 显式 cast(同 ct_cb_ref 侧)
                        acall = acall + "(" + ct_abi_ctype(cbp5) + ")_cbp" + ai.to_string()
                    } else if cbp5.len > 1 && or2(byte_at(cbp5, 0) == 70, byte_at(cbp5, 0) == 71) {
                        // P0-A:fn 型形参——ct_i 槽 → ct_clop 显式 cast(need_x 型
                        // fn(Req, fn(Req)->Resp)->Resp 的裸值装箱蹦床;旧裸传 _cbpK
                        // 为 ct_i,被调形参 ct_clop 即非法转换)
                        acall = acall + "(ct_clop)(long)_cbp" + ai.to_string()
                    } else {
                        acall = acall + "_cbp" + ai.to_string()
                    }
                    ai += 1
                }
                var aret = ct_fn_ret(file, e[1])
                if aret.len > 2 && byte_slice(aret, 0, 2) == "u:" {
                    // P0-A:u:-返回 = 堆盒指针(ct_i;双侧同约定,调用位 #fret 解盒)
                    println("return (\{ " + ct_ctype(aret) + "* _rb = (" + ct_ctype(aret) + "*)ctron_amalloc(sizeof(" + ct_ctype(aret) + ")); *_rb = t_" + e[1] + "(" + acall + "); (ct_i)(long)_rb; });")
                } else if aret.len > 1 && byte_at(aret, 0) == 71 {
                    println("return (ct_i)(long)t_" + e[1] + "(" + acall + ");")
                } else if seq2(aret, "v") {
                    // void 返回:调用后回 0((ct_i) 作用于 void 调用为非法 C)
                    println("t_" + e[1] + "(" + acall + "); return 0;")
                } else {
                    println("return (ct_i)t_" + e[1] + "(" + acall + ");")
                }
                println("}")
                println("#endif")
            }
            return "(\{ ct_clop _c = (ct_clop)ctron_amalloc(sizeof(ct_clo)); _c->fn = (void*)" + anm + "; _c->env = (void*)1; _c; })"
        }
        // P0-A:裸 fn 引用值位 → env-first 解箱 shim(旧裸地址直填 fn 槽,env=垃圾)
        var fpcs26 = ct_fn_pcodes(file, e[1])
        if or2(fpcs26.len == 1, or2(fpcs26.len == 2, fpcs26.len == 3)) {
            return ct_fval_emit(file, e[1], "L" + nline(e))
        }
        return "t_" + e[1]
    }
    if t == "Unary" {
        if e[1] == "Neg" {
            // -Int 宽字面量:恰为 2^63 时是 I64 MIN,用 C 惯用法直出(常量本身超 LLONG_MAX)
            var nd = e[2]
            if nd[0] == "Int" && nd[2].len == 0 {
                if lit_to_dec(nd[1]) == "9223372036854775808" {
                    return "(-9223372036854775807LL - 1)"
                }
            }
            if ct_typeof(nd, env, file) == "6" {
                return "ctron_i64_neg((int64_t)(" + ct_expr(nd, env, file) + "))"
            }
            return "(-" + ct_expr(nd, env, file) + ")"
        }
        return "(!" + ct_expr(e[2], env, file) + ")"
    }
    if t == "Binary" {
        // v0.8:or 中缀取默认(§4.4)——与 .or(默认) 方法同形(variant 0 取载荷,否则默认);
        // 非 Option/Result 左侧对齐 eval/rt 宽松口径:求值后回落默认。须在 ct_op 前拦截(Or 无 C 符号)
        if e[1] == "Or" {
            var olo = ct_expr(e[2], env, file)
            var olot = ct_typeof(e[2], env, file)
            if olot != "R" {
                return "((void)(" + olo + "), (" + ct_expr(e[3], env, file) + "))"
            }
            var od = ct_expr(e[3], env, file)
            var odt = ct_typeof(e[3], env, file)
            var odct = ct_ctype(odt)
            // d 载荷位型双关回读(与 ct_res_wrap 的 F64 入槽配对;旧 (long) 直转
            // 双向截断——Some(2.5) 入槽即 2)
            if odt == "f" {
                return "(((" + olo + ").variant == 0) ? ((union \{ double _d; ct_i _i; })\{ ._i = (ct_i)(" + olo + ").v })._d : (" + od + "))"
            }
            return "(" + odct + ")((" + olo + ").variant == 0 ? (ct_i)(long)(" + olo + ").v : (ct_i)(long)(" + od + "))"
        }
        var op = ct_op(e[1])
        var lt = ct_typeof(e[2], env, file)
        if e[1] == "Add" && or2(lt == "s", lt == "N") {
            return "ctron_str_concat((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
        }
        if or2(e[1] == "Eq", e[1] == "Ne") && or2(lt == "s", lt == "N") {
            var c = "strcmp((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
            if e[1] == "Eq" { return "(" + c + " == 0)" }
            return "(" + c + " != 0)"
        }
        if or2(e[1] == "Lt", or2(e[1] == "Gt", or2(e[1] == "Le", e[1] == "Ge"))) && or2(lt == "s", lt == "N") {
            // Str 关系运算:strcmp 字节序(镜像 eval vcmp/scmp;裸 < 是指针比较)
            var c2 = "strcmp((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
            if e[1] == "Lt" { return "(" + c2 + " < 0)" }
            if e[1] == "Gt" { return "(" + c2 + " > 0)" }
            if e[1] == "Le" { return "(" + c2 + " <= 0)" }
            return "(" + c2 + " >= 0)"
        }
        // SIMD 元素级白名单算术(§9.5;P1-C2 标量模拟):逐元素循环,q 前缀域
        if lt.len > 1 && byte_at(lt, 0) == 113 {
            if or2(or3(e[1] == "Add", e[1] == "Sub", e[1] == "Mul"), or2(e[1] == "Div", e[1] == "Mod")) {
                var qct = ct_ctype(lt)
                var qec = lt
                var qi3: I32 = 1
                while qi3 < qec.len && is_digit(byte_at(qec, qi3)) { qi3 += 1 }
                qec = byte_slice(qec, qi3, qec.len)
                var qsct = ct_ctype(qec)
                return "(\{ " + qct + " t_ql = " + ct_expr(e[2], env, file) + "; " + qct + " t_qr = " + ct_expr(e[3], env, file) + "; " + qct + " t_qo; t_qo.n = t_ql.n; t_qo.d = (" + qsct + "*)ctron_amalloc(sizeof(" + qsct + ") * t_ql.n); \{ int64_t t_qi; for (t_qi = 0; t_qi < t_ql.n; t_qi++) \{ t_qo.d[t_qi] = t_ql.d[t_qi] " + ct_op(e[1]) + " t_qr.d[t_qi]; } } t_qo; })"
            }
            panic("emit:Simd 算术白名单外:" + e[1])
            return ""
        }
        // W 域定宽检查算术(§3.1/§4.5;P1-B2):宽者定界,界门 panic 镜像 w_arith
        if lt.len > 2 && byte_at(lt, 0) == 119 {
            var wl = w_code_wider(lt, ct_typeof(e[3], env, file))
            var wlo = "0"
            var whi = "255"
            if wl == "w8s" {
                wlo = "-128"
                whi = "127"
            }
            if wl == "w16u" {
                wlo = "0"
                whi = "65535"
            }
            if wl == "w16s" {
                wlo = "-32768"
                whi = "32767"
            }
            var a9 = "(int32_t)(" + ct_expr(e[2], env, file) + ")"
            var b9 = "(int32_t)(" + ct_expr(e[3], env, file) + ")"
            if e[1] == "Add" { return "ctron_w_add(" + a9 + ", " + b9 + ", " + wlo + ", " + whi + ")" }
            if e[1] == "Sub" { return "ctron_w_sub(" + a9 + ", " + b9 + ", " + wlo + ", " + whi + ")" }
            if e[1] == "Mul" { return "ctron_w_mul(" + a9 + ", " + b9 + ", " + wlo + ", " + whi + ")" }
            if e[1] == "Div" { return "ctron_w_div(" + a9 + ", " + b9 + ")" }
            if e[1] == "Mod" { return "ctron_w_mod(" + a9 + ", " + b9 + ")" }
        }
        // U64/USize 域(P1-B):uint64_t 检查帮手(镜像 eval 界门,panic 消息同宿主);
        // "z"(USize→size_t,v0.7)同宽,经隐式转换走同一帮手
        if or3(lt == "7", lt == "z", or2(ct_typeof(e[3], env, file) == "7", ct_typeof(e[3], env, file) == "z")) {
            var a7 = "(uint64_t)(" + ct_expr(e[2], env, file) + ")"
            var b7 = "(uint64_t)(" + ct_expr(e[3], env, file) + ")"
            if e[1] == "Add" { return "ctron_u64_add(" + a7 + ", " + b7 + ")" }
            if e[1] == "Sub" { return "ctron_u64_sub(" + a7 + ", " + b7 + ")" }
            if e[1] == "Mul" { return "ctron_u64_mul(" + a7 + ", " + b7 + ")" }
            if e[1] == "Div" { return "ctron_u64_div(" + a7 + ", " + b7 + ")" }
            if e[1] == "Mod" { return "ctron_u64_mod(" + a7 + ", " + b7 + ")" }
        }
        // 6 域算术:溢出检查帮手(镜像 eval 界门,§4.5 检查算术)
        var rt6 = ct_typeof(e[3], env, file)
        if or2(lt == "6", rt6 == "6") {
            var a6 = "(int64_t)(" + ct_expr(e[2], env, file) + ")"
            var b6 = "(int64_t)(" + ct_expr(e[3], env, file) + ")"
            if e[1] == "Add" { return "ctron_i64_add(" + a6 + ", " + b6 + ")" }
            if e[1] == "Sub" { return "ctron_i64_sub(" + a6 + ", " + b6 + ")" }
            if e[1] == "Mul" { return "ctron_i64_mul(" + a6 + ", " + b6 + ")" }
            if e[1] == "Div" { return "ctron_i64_div(" + a6 + ", " + b6 + ")" }
            if e[1] == "Mod" { return "ctron_i64_mod(" + a6 + ", " + b6 + ")" }
        }
        return "(" + ct_expr(e[2], env, file) + " " + op + " " + ct_expr(e[3], env, file) + ")"
    }
    if t == "Index" {
        var ot = ct_typeof(e[1], env, file)
        if ot.len >= 3 && byte_slice(ot, 0, 1) == "a" {
            if e[1][0] == "Ident" {
                // 嵌套 ac(a2a2i):参数 ABI=elem*(线性),访问位转型行指针
                var md8 = ""
                var rc11 = ot
                while rc11.len >= 3 && byte_slice(rc11, 0, 1) == "a" {
                    md8 = md8 + "[" + a_count(rc11) + "]"
                    rc11 = a_elem(rc11)
                }
                if md8.len > byte_slice(md8, 0, 0).len && md8.contains("[") {
                    var c11 = -1
                    var q11: I32 = 0
                    while q11 < md8.len {
                        if byte_at(md8, q11) == 93 {
                            c11 = q11
                            break
                        }
                        q11 += 1
                    }
                    if c11 + 1 < md8.len {
                        var tail11 = byte_slice(md8, c11 + 1, md8.len)
                        return "((" + ct_ctype(rc11) + " (*)" + tail11 + ")(t_" + e[1][1] + "))[" + ct_expr(e[2], env, file) + "]"
                    }
                }
                return "t_" + e[1][1] + "[" + ct_expr(e[2], env, file) + "]"
            }
            // 成员/链式接收者(v0.9 定长数组字段):C 成员表达式直下标
            // (t_p.buf 局部链形态,镜像 Ident 臂口径)
            return "(" + ct_expr(e[1], env, file) + ")[" + ct_expr(e[2], env, file) + "]"
        }
        if ot.len > 1 && byte_at(ot, 0) == 118 {
            // 切片视图索引(§4.5):越界 panic 镜像 eval("index out of bounds");
            // GNU 语句表达式(Try 分支同款),固定名 t_vx 靠语句表达式作用域隔离,接收者限 Ident
            if e[1][0] != "Ident" {
                panic("ct_expr:视图索引接收者限 Ident")
                return ""
            }
            return "(\{ int64_t t_vx = " + ct_expr(e[2], env, file) + "; if (t_vx < 0 || t_vx >= t_" + e[1][1] + ".n) \{ ctron_panic(\"index out of bounds\"); } (" + ct_ctype(byte_slice(ot, 1, ot.len)) + ")(t_" + e[1][1] + ".d[t_vx]); })"
        }
        if ct_is_lcode(ot) {
            // Lu: 族索引(T14-②):槽为堆盒指针,解引用取回 struct 值拷贝(§3.2 值语义)
            var ity = ct_ctype(byte_slice(ot, 1, ot.len))
            return "(*(" + ity + "*)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }
        if ot == "LI" {
            // List[I32] 索引:槽经 long 取回标量
            return "((int32_t)(long)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }
        if ot == "L6" {
            // T54:List[I64] 索引:槽经 long 全宽取回(消「索引读静默截断」在册债)
            return "((int64_t)(long)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }
        if or2(ot == "L", ot == "N") {
            // List/节点索引:元素槽即 char*(节点 = 动态转型的 ctron_list*)
            return "((const char*)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }

        panic("ct_expr:index 目标非 List/数组:" + ot + " 名:" + e[1][1] + " 下标:" + e[2][1] + " 节点元数:" + e.len.to_string() + " 尾槽tag:" + e[e.len - 1][0])
        return ""
    }
    if t == "TupleE" {
        // FB-9:元组构造——amalloc 异构 list(整型经 long 装箱、Str 直存、
        // u: 堆盒 ct_wrap_i;浮点槽 fail-closed 债;嵌套元组债)
        var tp9 = "(\{ ctron_list* t_tpl = ctron_list_new();"
        var k9: I32 = 1
        while k9 < e.len {
            var ec9 = ct_typeof(e[k9], env, file)
            var ex9 = ct_expr(e[k9], env, file)
            if ec9 == "s" {
                tp9 = tp9 + " ctron_list_push(t_tpl, " + ex9 + ");"
            } else if ec9.len > 2 && byte_slice(ec9, 0, 2) == "u:" {
                tp9 = tp9 + " ctron_list_push(t_tpl, (const char*)(long)" + ct_wrap_i(ec9, ex9) + ");"
            } else if or2(ec9 == "f", ec9 == "g") {
                panic("emit:元组浮点槽未支持(登记债)")
                return ""
            } else {
                tp9 = tp9 + " ctron_list_push(t_tpl, (const char*)(long)(" + ex9 + "));"
            }
            k9 += 1
        }
        return tp9 + " t_tpl; })"
    }
    if t == "Member" {
        // FB-9:元组数字成员(t.0)——TP 码静态元素型解箱(镜像 LI/L6 惯例)
        var otr9 = ct_typeof(e[1], env, file)
        if otr9.len > 2 && byte_slice(otr9, 0, 3) == "TP:" && e[3].len > 0 && byte_at(e[3], 0) >= 48 && byte_at(e[3], 0) <= 57 {
            var want9 = e[3]
            var hit9 = ct_tp_elem(otr9, want9)
            var rcv9 = ct_expr(e[1], env, file)
            if hit9 == "s" {
                return "((const char*)((ctron_list*)(" + rcv9 + "))->items[" + want9 + "])"
            }
            if hit9.len > 2 && byte_slice(hit9, 0, 2) == "u:" {
                return "(*(" + ct_ctype(hit9) + "*)((ctron_list*)(" + rcv9 + "))->items[" + want9 + "])"
            }
            if or2(hit9 == "f", hit9 == "g") {
                panic("emit:元组浮点槽未支持(登记债)")
                return ""
            }
            return "(" + ct_ctype(hit9) + ")(long)((ctron_list*)(" + rcv9 + "))->items[" + want9 + "]"
        }
        if e[3] == "char_len" {
            // §3.1.1 前奏 Str API:UTF-8 首字节计数(非续字节)
            return "ctron_char_len((const char*)(" + ct_expr(e[1], env, file) + "))"
        }
        if e[3] == "len" {
            // 定长数组:len 编码在 env 类型码里(a<N><码> → N)
            if e[1][0] == "Ident" {
                var ot2 = ct_env_ty(env, e[1][1])
                if ot2.len > 1 && byte_at(ot2, 0) == 118 {
                    // 切片视图:len = .n(镜像 eval I32 域)
                    return "(int32_t)(t_" + e[1][1] + ".n)"
                }
                if ot2.len >= 3 && byte_slice(ot2, 0, 1) == "a" {
                    return a_count(ot2)
                }
            }
            // 定长数组字段成员接收者(v0.9):p.buf.len → N
            var ot4 = ct_typeof(e[1], env, file)
            if ot4.len >= 3 && byte_slice(ot4, 0, 1) == "a" {
                return a_count(ot4)
            }
            var ot3 = ct_typeof(e[1], env, file)
            if or2(ot3 == "L", ct_is_tlcode(ot3)) {
                return "((ctron_list*)(" + ct_expr(e[1], env, file) + "))->n"
            }
            if ot3 == "N" {
                // N 值二义:真串或节点皆有 .len(env 表元素是串,AST 槽是节点)→ 动态分派镜像 rt
                return "ctron_len((const void*)(" + ct_expr(e[1], env, file) + "))"
            }
            return "strlen((const char*)(" + ct_expr(e[1], env, file) + "))"
        }
        var oft = ct_strip_p(ct_typeof(e[1], env, file))
        // P0-A:&T 形参(pu: 码)字段读 → 解引用成员
        if oft.len > 3 && byte_slice(oft, 0, 3) == "pu:" {
            return "(*" + ct_expr(e[1], env, file) + ")." + e[3]
        }
        if oft.len > 2 && byte_slice(oft, 0, 2) == "u:" {
            // struct 字段读取(§6.1 值类型;P<内> 解引用后同型)
            return "(" + ct_expr(e[1], env, file) + ")." + e[3]
        }
        if oft.len > 2 && byte_slice(oft, 0, 2) == "B:" {
            // Box 自动解引用字段读(§6.1)
            return "(" + ct_expr(e[1], env, file) + ")->" + e[3]
        }
    }
    if t == "Scope" {
        panic("ct_expr:scope 仅语句位(let/Expr)")
        return ""
    }
    if t == "Own" {
        panic("ct_expr:own 仅语句位(let/Expr)")
        return ""
    }
    if t == "Closure" {
        var cvv = ct_emit_clov(e, e, env, file)
        return cvv
    }
    if t == "StructLit" {
        if !ct_is_struct(file, e[1]) {
            
            panic("ct_expr:StructLit 非值类型")
            return ""
        }
        var lf = e[2]
        // 泛型 struct 实例化:实例码优先取 env "#名"(单态化体:签名已钉实例),
        // 否则场值型别按声明序推断(调用点具体上下文)
        if ct_struct_tps(file, e[1]).len > 0 {
            var inst = ct_structlit_inst(file, e, env)
            var gj: I32 = 1
            var gacc = "(t_" + byte_slice(inst, 2, inst.len) + ")\{"
            gj = 1
            var firstg = true
            while gj < lf.len {
                if !firstg { gacc = gacc + ", " }
                firstg = false
                // P0-A 扩位②:fn 型字段 + 闭包字面量 → 绑 '#clcodes'(shim 形参码
                // 提示,§4 闭包 ABI;镜像调用点 ct_call_args_tg 位)。字段声明型别
                // 节点经实例码代入(泛型字段 fn(Req[S]) -> Resp 的 S 槽具体化)。
                // 防御口径:仅 FnType 字段 + Closure 实参触发;内参码取不到不绑,
                // 回落 ClosureParam 注解/"i"
                var gfenv = env
                if lf[gj][2][0] == "Closure" {
                    var ginfo26 = ct_struct_inst_split(inst)
                    if ginfo26.len > 1 {
                        var gbar26: I32 = 0
                        var gq26: I32 = 0
                        while gq26 < ginfo26.len {
                            if byte_at(ginfo26, gq26) == 124 { gbar26 = gq26 }
                            gq26 += 1
                        }
                        var gcc26 = ct_fntype_inner(file, ct_field_ty_node_inst(file, e[1], lf[gj][1], byte_slice(ginfo26, gbar26 + 1, ginfo26.len)))
                        if gcc26.len > 0 {
                            gfenv = env_bind(env, "#clcodes", gcc26)
                        }
                    }
                }
                // 定长数组字段构造(v0.9·四):字段位 ArrLit → C 数组初始化器
                if lf[gj][2][0] == "ArrLit" {
                    var ga = ""
                    var gj2: I32 = 1
                    while gj2 < lf[gj][2].len {
                        if gj2 > 1 { ga = ga + ", " }
                        ga = ga + ct_expr(lf[gj][2][gj2], gfenv, file)
                        gj2 += 1
                    }
                    gacc = gacc + "." + lf[gj][1] + " = \{" + ga + "}"
                } else {
                    gacc = gacc + "." + lf[gj][1] + " = " + ct_expr(lf[gj][2], gfenv, file)
                }
                gj += 1
            }
            return gacc + "}"
        }
        var acc = "(t_" + e[1] + ")\{"
        var j: I32 = 1
        while j < lf.len {
            var c = lf[j]
            if j > 1 {
                acc = acc + ", "
            }
            // P0-A 扩位②:fn 型字段 + 闭包字面量 → 绑 '#clcodes'(具体 struct 场,
            // SrvIo 五件 listen/accept/read/write/close 即此形;声明 FnType 内参码直取)
            var cfenv = env
            if c[2][0] == "Closure" {
                var ccc26 = ct_fntype_inner(file, ct_field_ty_node(file, e[1], c[1]))
                if ccc26.len > 0 {
                    cfenv = env_bind(env, "#clcodes", ccc26)
                }
            }
            // 定长数组字段构造(v0.9·四):字段位 ArrLit → C 数组初始化器
            //(此前 ArrLit 仅 let 初值位,struct 字面量构造数组字段不可达)
            if c[2][0] == "ArrLit" {
                var aa = ""
                var aj: I32 = 1
                while aj < c[2].len {
                    if aj > 1 { aa = aa + ", " }
                    aa = aa + ct_expr(c[2][aj], cfenv, file)
                    aj += 1
                }
                acc = acc + "." + c[1] + " = \{" + aa + "}"
            } else {
                acc = acc + "." + c[1] + " = " + ct_expr(c[2], cfenv, file)
            }
            j += 1
        }
        return acc + "}"
    }
    if t == "If" {
        return ct_if_value(e, env, file)
    }
    if t == "ArrLit" {
        panic("ct_expr:ArrLit 仅 let 初值位")
        return ""
    }
    if t == "Call" {
        var cal = e[1]
        var ag = e[2]
        if cal[0] == "TypeArgs" {
            var base = cal[1]
            // as[T]() 显式转换(P1-B;§3.6 窄化=截断):C 强转,镜像 eval TypeArgs 位拦截
            if base[0] == "Member" && seq2(base[3], "as") {
                var aobj = ct_expr(base[1], env, file)
                var tgtc = "i"
                if cal[2].len > 1 {
                    tgtc = ct_ty_code(cal[2][1], file)
                }
                // FB 批 P0:Str 源 as 数值 = 解析(镜像 conv_as 6 域;旧裸 cast
                // 把指针当数值——"42".to_string().as[I64]() emit=指针低位实证)
                var sc12 = ct_typeof(base[1], env, file)
                if sc12 == "s" || sc12 == "N" {
                    if tgtc == "7" { return "(uint64_t)ctron_str_to_i64(" + aobj + ")" }
                    if tgtc == "z" { return "(size_t)ctron_str_to_i64(" + aobj + ")" }
                    if tgtc == "6" { return "ctron_str_to_i64(" + aobj + ")" }
                    if tgtc == "i" { return "(int32_t)ctron_str_to_i64(" + aobj + ")" }
                    if tgtc.len > 2 && byte_at(tgtc, 0) == 119 {
                        return "(" + ct_ctype(tgtc) + ")ctron_str_to_i64(" + aobj + ")"
                    }
                }
                if tgtc == "7" { return "(uint64_t)(" + aobj + ")" }
                if tgtc == "6" { return "(int64_t)(" + aobj + ")" }
                if tgtc == "i" { return "(int32_t)(" + aobj + ")" }
                if tgtc == "b" { return "(int)(" + aobj + ")" }
                if tgtc == "f" { return "(double)(" + aobj + ")" }
                if tgtc == "g" { return "(float)(" + aobj + ")" }
                if tgtc.len > 2 && byte_at(tgtc, 0) == 119 {
                    return "(" + ct_ctype(tgtc) + ")(" + aobj + ")"
                }
                panic("emit:as 目标:" + tgtc)
                return ""
            }
            if base[0] == "Ident" && base[1] == "List" { return "ctron_list_new()" }
            // T41 §6.6:Arena.fixed(n)——n 字节栈上驻留(alloca 不得驻 helper:
            // helper 返回即释放;statement 表达式在调用者帧分配)
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "Arena" && base[2] == "Nm" && base[3] == "fixed" {
                var asz = "0"
                if ag.len > 1 { asz = ct_expr(ag[1], env, file) }
                return "(\{ ct_arena t_a; t_a.base = (void*)(__builtin_alloca((size_t)(" + asz + "))); t_a.off = 0; t_a.cap = (int64_t)(" + asz + "); t_a; })"
            }
            // T41 余债:Region.fixed(n)——嵌套区段分配器,值面与 Arena 同构
            //(mark/reset 区段面见 Member 臂;ct_arena_reset 守卫回卷界)
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "Region" && base[2] == "Nm" && base[3] == "fixed" {
                var rsz = "0"
                if ag.len > 1 { rsz = ct_expr(ag[1], env, file) }
                return "(\{ ct_arena t_a; t_a.base = (void*)(__builtin_alloca((size_t)(" + rsz + "))); t_a.off = 0; t_a.cap = (int64_t)(" + rsz + "); t_a; })"
            }
            // T41 余债:Static.zeros[T](n)——编译期静态数组(.bss 零初始化)视图面,
            // 声明面 MVP:n 须编译期整常量(C 静态数组长度语法约束,运行期值=cc 拦);
            // 块域 static 各展开点独立实体,同函数多处不撞名
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "Static" && base[2] == "Nm" && base[3] == "zeros" {
                var sec = "i"
                if cal[2].len > 1 && cal[2][1].len > 1 { sec = ct_ty_code(cal[2][1], file) }
                var scp = ct_ctype(sec)
                var ssn = "1"
                if ag.len > 1 { ssn = ct_expr(ag[1], env, file) }
                return "(\{ static " + scp + " t_sb[" + ssn + "]; ctron_view_" + sec + " t_sv; t_sv.d = t_sb; t_sv.n = (int64_t)(" + ssn + "); t_sv; })"
            }
            // T41 余债:Pool.fixed[T](n)——定长对象池(帧上 alloca 槽位+空闲链,
            // esz 8 字节下限承链域;alloc 用尽 panic "pool exhausted",free 后 LIFO 复用)
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "Pool" && base[2] == "Nm" && base[3] == "fixed" {
                var pec = "i"
                if cal[2].len > 1 && cal[2][1].len > 1 { pec = ct_ty_code(cal[2][1], file) }
                var pcp = ct_ctype(pec)
                var pnn = "0"
                if ag.len > 1 { pnn = ct_expr(ag[1], env, file) }
                return "(\{ int64_t t_pn = (int64_t)(" + pnn + "); int64_t t_pe = ((int64_t)sizeof(" + pcp + ") < 8 ? 8 : (int64_t)sizeof(" + pcp + ")); ct_pool t_p; t_p.base = (void*)(__builtin_alloca((size_t)(t_pn * t_pe))); ct_pool_init(&t_p, t_p.base, t_pe, t_pn); t_p; })"
            }
            // T41 §6.6:arena.zeros[T](n)——显式分配器零填充切片(view {d,n};
            // 走 ct_arena_bump 前进,零 GC 分配)
            if base[0] == "Member" && base[2] == "Nm" && base[3] == "zeros" {
                var aro = ct_expr(base[1], env, file)
                var ecc = "i"
                if cal[2].len > 1 && cal[2][1].len > 1 { ecc = ct_ty_code(cal[2][1], file) }
                var an2 = "0"
                if ag.len > 1 { an2 = ct_expr(ag[1], env, file) }
                var ctp = ct_ctype(ecc)
                if ctp.len > 2 && byte_slice(ctp, 0, 2) == "u:" { ctp = "t_" + byte_slice(ctp, 2, ctp.len) }
                return "(\{ ctron_view_" + ecc + " t_av; int64_t t_an = (int64_t)(" + an2 + "); t_av.d = (" + ctp + "*)ct_arena_bump(&(" + aro + "), t_an * (int64_t)sizeof(" + ctp + ")); memset(t_av.d, 0, (size_t)(t_an * sizeof(" + ctp + "))); t_av.n = t_an; t_av; })"
            }
            // arena.list[T]():镜像 eval(arena 透明,List 即 GC 堆表)
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "arena" && base[2] == "Nm" && base[3] == "list" {
                return "ctron_list_new()"
            }
            if base[0] == "Ident" && base[1] == "Atomic" {
                var init = "0"
                if ag.len > 1 { init = ct_expr(ag[1], env, file) }
                return "ctron_cell_new(" + init + ")"
            }
            if base[0] == "Ident" && base[1] == "Global" {
                // Global[T](name, init):init 取第二实参(镜像 eval vals[1])
                var ginit = "0"
                if ag.len > 2 { ginit = ct_expr(ag[2], env, file) }
                return "ctron_cell_new(" + ginit + ")"
            }
            if base[0] == "Ident" && base[1] == "Box" && ct_struct_tps(file, "Box").len == 0 {
                // Box[P](v)(§6.1):GC 堆单值 cell,赋值/传参共享引用(别名可见);
                // 用户声明 Box struct 时走通用泛型实例路径
                if ag.len < 2 {
                    panic("emit:Box 需载荷")
                    return ""
                }
                var bxt = ct_typeof(ag[1], env, file)
                if bxt.len > 2 && byte_slice(bxt, 0, 2) == "u:" {
                    var btn = "t_" + byte_slice(bxt, 2, bxt.len)
                    return "(\{ " + btn + "* _b = (" + btn + "*)ctron_amalloc(sizeof(" + btn + ")); *_b = " + ct_expr(ag[1], env, file) + "; _b; })"
                }
                panic("emit:Box 载荷限值类型")
                return ""
            }
            if base[0] == "Ident" && base[1] == "Channel" {
                var cap = "64"
                if ag.len > 1 { cap = ct_expr(ag[1], env, file) }
                return "((ct_chan*)ct_ch_make((int)(" + cap + ")))"
            }
            if base[0] == "Ident" {
                // 泛型实例化(Phase 5):显式 TypeArgs 调用 → 按型别单态特化
                var gdecl = ct_fn_decl(file, base[1])
                if gdecl.len > 0 && gdecl[2].len > 1 {
                    var tpsn = List[Str]()
                    var tys = List[Str]()
                    var gk: I32 = 1
                    while gk < gdecl[2].len {
                        tpsn.push(gdecl[2][gk][1])
                        gk += 1
                    }
                    gk = 1
                    while gk < cal[2].len {
                        // 嵌套泛型调用:型参实参经 env 解析为具体型别(外层单态化绑定)
                        tys.push(ct_targ_env(cal[2][gk], env))
                        gk += 1
                    }
                    if tpsn.len != tys.len {
                        panic("emit:泛型实参数")
                        return ""
                    }
                    var targsr = List[Str]()
                    targsr.push("TArgs")
                    var gk4: I32 = 0
                    while gk4 < tys.len {
                        targsr.push(tys[gk4])
                        gk4 += 1
                    }
                    return ct_spec_call_emit(file, env, ag, base[1], targsr, tpsn, tys, gdecl, "")
                }
            }
            if base[0] == "Ident" && base[1] == "Mutex" {
                var minit = "0"
                if ag.len > 1 { minit = ct_expr(ag[1], env, file) }
                var mi = "i"
                if ag.len > 1 { mi = ct_typeof(ag[1], env, file) }
                if seq2(ct_pass(env), "1") {
                    ct_mcell_emit(mi)
                }
                var mtg = ct_mcell_tag(mi)
                return "(\{ ct_mcell_" + mtg + "* _p = (ct_mcell_" + mtg + "*)malloc(sizeof(ct_mcell_" + mtg + ")); pthread_mutex_init(&_p->mu, 0); _p->v = " + minit + "; ct_mcreg_add((void*)_p, sizeof(*_p) / 8 + 2); _p; })"
            }
            // P0-A:非泛型被调 + TypeArgs 位——chain_append 形(S 仅 fn 内参自由现形,
            // 源无 [S];sem 隐式型参)——发射侧 TypeArgs 即恒等,按声明形参码直调。
            // 旧无此臂:落入 callee=cal[1](TypeArgs 基节点,类型混淆)拼出 t_<乱码>
            if base[0] == "Ident" {
                var ngdecl = ct_fn_decl(file, base[1])
                if ngdecl.len > 0 {
                    if ngdecl[2].len < 2 {
                        return "t_" + base[1] + "(" + ct_call_args_tg(ag, 1, env, file, base[1], cal[2]) + ")"
                    }
                }
            }
        }
        if cal[0] == "Member" {
            var m = cal[3]
            // T41 §6.6:Arena.fixed(n)(无类型实参面,callee=纯 Member)——
            // n 字节栈上驻留(alloca 不得驻 helper,statement 表达式调用者帧分配)
            if cal[1][0] == "Ident" && cal[1][1] == "Arena" && m == "fixed" {
                var asz2 = "0"
                if ag.len > 1 { asz2 = ct_expr(ag[1], env, file) }
                return "(\{ ct_arena t_a; t_a.base = (void*)(__builtin_alloca((size_t)(" + asz2 + "))); t_a.off = 0; t_a.cap = (int64_t)(" + asz2 + "); t_a; })"
            }
            // T41 余债:Region.fixed(n)(无类型实参面)——同 Arena.fixed 帧上驻留
            if cal[1][0] == "Ident" && cal[1][1] == "Region" && m == "fixed" {
                var rsz2 = "0"
                if ag.len > 1 { rsz2 = ct_expr(ag[1], env, file) }
                return "(\{ ct_arena t_a; t_a.base = (void*)(__builtin_alloca((size_t)(" + rsz2 + "))); t_a.off = 0; t_a.cap = (int64_t)(" + rsz2 + "); t_a; })"
            }
            // T41 余债:Region 区段面 mark()/reset(m)——接收者码 K 门控(不遮同名方法):
            // mark=off 快照;reset=ct_arena_reset 守卫回卷(负值/超前 panic)
            if or2(m == "mark", m == "reset") {
                var rkt = ct_typeof(cal[1], env, file)
                if rkt == "K" {
                    var rob = ct_expr(cal[1], env, file)
                    if m == "mark" { return "((int64_t)(" + rob + ").off)" }
                    var rmk = "0"
                    if ag.len > 1 { rmk = ct_expr(ag[1], env, file) }
                    return "ct_arena_reset(&(" + rob + "), (int64_t)(" + rmk + "))"
                }
            }
            // T41 余债:Pool 对象面 alloc()/free(i)/get(i)/set(i,v)——接收者码 J<ec>
            // 门控;alloc=空闲链头出链(用尽 panic),free=头插回链(LIFO),get/set=槽位直读直写
            if or2(m == "alloc", or2(m == "free", or2(m == "get", m == "set"))) {
                var pjt = ct_typeof(cal[1], env, file)
                if pjt.len > 0 && byte_at(pjt, 0) == 74 {
                    var pob = ct_expr(cal[1], env, file)
                    if m == "alloc" { return "ct_pool_alloc(&(" + pob + "))" }
                    if m == "free" {
                        var frz = "0"
                        if ag.len > 1 { frz = ct_expr(ag[1], env, file) }
                        return "ct_pool_free(&(" + pob + "), (int64_t)(" + frz + "))"
                    }
                    var gix = "0"
                    if ag.len > 1 { gix = ct_expr(ag[1], env, file) }
                    var gcp = ct_ctype(byte_slice(pjt, 1, pjt.len))
                    if m == "get" {
                        return "(*(" + gcp + "*)((char*)(" + pob + ").base + (int64_t)(" + gix + ") * (" + pob + ").esz))"
                    }
                    var gv = "0"
                    if ag.len > 2 { gv = ct_expr(ag[2], env, file) }
                    return "(*(" + gcp + "*)((char*)(" + pob + ").base + (int64_t)(" + gix + ") * (" + pob + ").esz) = " + gv + ")"
