// =====================================================================
// trans_expr.ct —— 表达式发射:ct_expr 节点→C 表达式(字面量/运算/调用/成员/
// 索引/插值串 ctron_str_concat 链接)、ct_call_args 实参(形参类型码插转换 L↔N/A)、
// ct_assigned/ct_hoists 声明提升、ct_zero 零值、a_count/a_elem 定长数组码解析。
// =====================================================================
fn ct_expr(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" {
        // 宽字面量(I32 装不下,§3.1.1)转十进制加 LL 后缀——sem E2040 已保证
        // 窄类型语境不达此;仅无后缀(C 进制常量超宽 ill-formed)
        if e[2].len == 0 {
            if lit_wide_i32(e[1]) {
                return lit_to_dec(e[1]) + "LL"
            }
        }
        return e[1]
    }
    if t == "Float" { return e[1] }
    if t == "Str" {
        var parts = e[1]
        var acc = ""
        var j: I32 = 1
        while j < parts.len {
            var p = parts[j]
            var frag = ""
            if p[0] == "Text" {
                frag = "\"" + ct_cstr(p[1]) + "\""
            } else {
                // 插值(§4.11):发射器内联解析片段 → 按类型转 C 串
                var toks2 = List[Str]()
                var lns2 = List[Str]()
                scan(p[1], toks2, lns2)
                var cur2 = Atomic[I32](0)
                var ie = p_stmt_expr(toks2, cur2, lns2, "1")
                var ik = ct_typeof(ie, env, file)
                var core = ct_expr(ie, env, file)
                if or2(ik == "s", ik == "N") {
                    frag = "(" + core + ")"
                } else if ik == "i" {
                    frag = "ctron_i32_to_string((int32_t)(" + core + "))"
                } else if ik == "6" {
                    frag = "ctron_i64_to_string((int64_t)(" + core + "))"
                } else if ik == "b" {
                    frag = "((" + core + ") ? \"true\" : \"false\")"
                } else if ik.len > 2 && byte_slice(ik, 0, 2) == "u:" {
                    // struct 插值:合成 Name(f=v,...)(eval fmt_struct 同族)
                    frag = ct_show_frag_dp(core, ik, env, file, 0)
                } else {
                    panic("ct_expr:interp 类型")
                    return ""
                }
            }
            if acc == "" {
                acc = frag
            } else {
                acc = "ctron_str_concat(" + acc + ", " + frag + ")"
            }
            j += 1
        }
        if acc == "" {
            return "\"\""
        }
        return acc
    }
    if t == "Bool" {
        if e[1] == "true" { return "1" }
        return "0"
    }
    if t == "Ident" {
        if ct_env_has(env, e[1]) {
            var icd = ct_env_ty(env, e[1])
            if icd.len > 1 && byte_at(icd, 0) == 80 {
                // P<内> 伪码:with_mut 体内参数 = 内值指针 → 解引用
                return "(*t_" + e[1] + ")"
            }
            return "t_" + e[1]
        }
        if seq2(e[1], "None") {
            return "(\{ ct_res _r; _r.variant = 1; _r.v = 0; _r; })"
        }
        var ien = ct_enum_of_variant(file, e[1])
        if ien.len > 0 {
            var iidx = ct_variant_index(file, ien, e[1])
            return "(ct_enum_" + ien + ")\{ " + iidx.to_string() + ", \{ 0, 0 } }"
        }
        var pcs5 = ct_fn_pcodes(file, e[1])
        if pcs5.len > 0 {
            if pcs5.len > 3 {
                panic("emit:fn 值 arity>3")
                return ""
            }
            var anm = "ct_ad_L" + nline(e)
            if seq2(ct_pass(env), "1") {
                var asig = "void* _cp"
                var ai: I32 = 0
                while ai < pcs5.len {
                    asig = asig + ", ct_i _p" + ai.to_string()
                    ai += 1
                }
                println("static ct_i " + anm + "(" + asig + ") \{")
                var acall = ""
                ai = 0
                while ai < pcs5.len {
                    if ai > 0 { acall = acall + ", " }
                    acall = acall + "(int32_t)_p" + ai.to_string()
                    ai += 1
                }
                var aret = ct_fn_ret(file, e[1])
                if aret.len > 1 && byte_at(aret, 0) == 71 {
                    println("return (ct_i)(long)t_" + e[1] + "(" + acall + ");")
                } else {
                    println("return (ct_i)t_" + e[1] + "(" + acall + ");")
                }
                println("}")
            }
            return "(\{ ct_clop _c = (ct_clop)ctron_amalloc(sizeof(ct_clo)); _c->fn = (void*)" + anm + "; _c->env = 0; _c; })"
        }
        return "t_" + e[1]
    }
    if t == "Unary" {
        if e[1] == "Neg" {
            // -Int 宽字面量:恰为 2^63 时是 I64 MIN,用 C 惯用法直出(常量本身超 LLONG_MAX)
            var nd = e[2]
            if nd[0] == "Int" && nd[2].len == 0 {
                if lit_to_dec(nd[1]) == "9223372036854775808" {
                    return "(-9223372036854775807LL - 1)"
                }
            }
            if ct_typeof(nd, env, file) == "6" {
                return "ctron_i64_neg((int64_t)(" + ct_expr(nd, env, file) + "))"
            }
            return "(-" + ct_expr(nd, env, file) + ")"
        }
        return "(!" + ct_expr(e[2], env, file) + ")"
    }
    if t == "Binary" {
        var op = ct_op(e[1])
        var lt = ct_typeof(e[2], env, file)
        if e[1] == "Add" && or2(lt == "s", lt == "N") {
            return "ctron_str_concat((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
        }
        if or2(e[1] == "Eq", e[1] == "Ne") && or2(lt == "s", lt == "N") {
            var c = "strcmp((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
            if e[1] == "Eq" { return "(" + c + " == 0)" }
            return "(" + c + " != 0)"
        }
        if or2(e[1] == "Lt", or2(e[1] == "Gt", or2(e[1] == "Le", e[1] == "Ge"))) && or2(lt == "s", lt == "N") {
            // Str 关系运算:strcmp 字节序(镜像 eval vcmp/scmp;裸 < 是指针比较)
            var c2 = "strcmp((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
            if e[1] == "Lt" { return "(" + c2 + " < 0)" }
            if e[1] == "Gt" { return "(" + c2 + " > 0)" }
            if e[1] == "Le" { return "(" + c2 + " <= 0)" }
            return "(" + c2 + " >= 0)"
        }
        // 6 域算术:溢出检查帮手(镜像 eval 界门,§4.5 检查算术)
        var rt6 = ct_typeof(e[3], env, file)
        if or2(lt == "6", rt6 == "6") {
            var a6 = "(int64_t)(" + ct_expr(e[2], env, file) + ")"
            var b6 = "(int64_t)(" + ct_expr(e[3], env, file) + ")"
            if e[1] == "Add" { return "ctron_i64_add(" + a6 + ", " + b6 + ")" }
            if e[1] == "Sub" { return "ctron_i64_sub(" + a6 + ", " + b6 + ")" }
            if e[1] == "Mul" { return "ctron_i64_mul(" + a6 + ", " + b6 + ")" }
            if e[1] == "Div" { return "ctron_i64_div(" + a6 + ", " + b6 + ")" }
            if e[1] == "Mod" { return "ctron_i64_mod(" + a6 + ", " + b6 + ")" }
        }
        return "(" + ct_expr(e[2], env, file) + " " + op + " " + ct_expr(e[3], env, file) + ")"
    }
    if t == "Index" {
        var ot = ct_typeof(e[1], env, file)
        if ot.len >= 3 && byte_slice(ot, 0, 1) == "a" {
            if e[1][0] == "Ident" { return "t_" + e[1][1] + "[" + ct_expr(e[2], env, file) + "]" }
        }
        if ot == "LI" {
            // List[I32] 索引:槽经 long 取回标量
            return "((int32_t)(long)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }
        if or2(ot == "L", ot == "N") {
            // List/节点索引:元素槽即 char*(节点 = 动态转型的 ctron_list*)
            return "((const char*)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }

        panic("ct_expr:index 目标非 List/数组:" + ot + " @行" + nline(e))
        return ""
    }
    if t == "Member" {
        if e[3] == "len" {
            // 定长数组:len 编码在 env 类型码里(a<N><码> → N)
            if e[1][0] == "Ident" {
                var ot2 = ct_env_ty(env, e[1][1])
                if ot2.len >= 3 && byte_slice(ot2, 0, 1) == "a" {
                    return a_count(ot2)
                }
            }
            var ot3 = ct_typeof(e[1], env, file)
            if or2(ot3 == "L", ot3 == "LI") {
                return "((ctron_list*)(" + ct_expr(e[1], env, file) + "))->n"
            }
            if ot3 == "N" {
                // N 值二义:真串或节点皆有 .len(env 表元素是串,AST 槽是节点)→ 动态分派镜像 rt
                return "ctron_len((const void*)(" + ct_expr(e[1], env, file) + "))"
            }
            return "strlen((const char*)(" + ct_expr(e[1], env, file) + "))"
        }
        var oft = ct_strip_p(ct_typeof(e[1], env, file))
        if oft.len > 2 && byte_slice(oft, 0, 2) == "u:" {
            // struct 字段读取(§6.1 值类型;P<内> 解引用后同型)
            return "(" + ct_expr(e[1], env, file) + ")." + e[3]
        }
        if oft.len > 2 && byte_slice(oft, 0, 2) == "B:" {
            // Box 自动解引用字段读(§6.1)
            return "(" + ct_expr(e[1], env, file) + ")->" + e[3]
        }
    }
    if t == "Scope" {
        panic("ct_expr:scope 仅语句位(let/Expr)")
        return ""
    }
    if t == "Own" {
        panic("ct_expr:own 仅语句位(let/Expr)")
        return ""
    }
    if t == "Closure" {
        var cvv = ct_emit_clov(e, e, env, file)
        return cvv
    }
    if t == "StructLit" {
        if !ct_is_struct(file, e[1]) {
            panic("ct_expr:StructLit 非值类型")
            return ""
        }
        var lf = e[2]
        // 泛型 struct 实例化:实例码优先取 env "#名"(单态化体:签名已钉实例),
        // 否则场值型别按声明序推断(调用点具体上下文)
        if ct_struct_tps(file, e[1]).len > 0 {
            var inst = ct_structlit_inst(file, e, env)
            var gj: I32 = 1
            var gacc = "(t_" + byte_slice(inst, 2, inst.len) + ")\{"
            gj = 1
            var firstg = true
            while gj < lf.len {
                if !firstg { gacc = gacc + ", " }
                firstg = false
                gacc = gacc + "." + lf[gj][1] + " = " + ct_expr(lf[gj][2], env, file)
                gj += 1
            }
            return gacc + "}"
        }
        var acc = "(t_" + e[1] + ")\{"
        var j: I32 = 1
        while j < lf.len {
            var c = lf[j]
            if j > 1 {
                acc = acc + ", "
            }
            acc = acc + "." + c[1] + " = " + ct_expr(c[2], env, file)
            j += 1
        }
        return acc + "}"
    }
    if t == "If" {
        return ct_if_value(e, env, file)
    }
    if t == "ArrLit" {
        panic("ct_expr:ArrLit 仅 let 初值位")
        return ""
    }
    if t == "Call" {
        var cal = e[1]
        var ag = e[2]
        if cal[0] == "TypeArgs" {
            var base = cal[1]
            if base[0] == "Ident" && base[1] == "List" { return "ctron_list_new()" }
            // arena.list[T]():镜像 eval(arena 透明,List 即 GC 堆表)
            if base[0] == "Member" && base[1][0] == "Ident" && base[1][1] == "arena" && base[2] == "Nm" && base[3] == "list" {
                return "ctron_list_new()"
            }
            if base[0] == "Ident" && base[1] == "Atomic" {
                var init = "0"
                if ag.len > 1 { init = ct_expr(ag[1], env, file) }
                return "ctron_cell_new(" + init + ")"
            }
            if base[0] == "Ident" && base[1] == "Global" {
                // Global[T](name, init):init 取第二实参(镜像 eval vals[1])
                var ginit = "0"
                if ag.len > 2 { ginit = ct_expr(ag[2], env, file) }
                return "ctron_cell_new(" + ginit + ")"
            }
            if base[0] == "Ident" && base[1] == "Box" && ct_struct_tps(file, "Box").len == 0 {
                // Box[P](v)(§6.1):GC 堆单值 cell,赋值/传参共享引用(别名可见);
                // 用户声明 Box struct 时走通用泛型实例路径
                if ag.len < 2 {
                    panic("emit:Box 需载荷")
                    return ""
                }
                var bxt = ct_typeof(ag[1], env, file)
                if bxt.len > 2 && byte_slice(bxt, 0, 2) == "u:" {
                    var btn = "t_" + byte_slice(bxt, 2, bxt.len)
                    return "(\{ " + btn + "* _b = (" + btn + "*)ctron_amalloc(sizeof(" + btn + ")); *_b = " + ct_expr(ag[1], env, file) + "; _b; })"
                }
                panic("emit:Box 载荷限值类型")
                return ""
            }
            if base[0] == "Ident" && base[1] == "Channel" {
                var cap = "64"
                if ag.len > 1 { cap = ct_expr(ag[1], env, file) }
                return "((ct_chan*)ct_ch_make((int)(" + cap + ")))"
            }
            if base[0] == "Ident" {
                // 泛型实例化(Phase 5):显式 TypeArgs 调用 → 按型别单态特化
                var gdecl = ct_fn_decl(file, base[1])
                if gdecl.len > 0 && gdecl[2].len > 1 {
                    var tpsn = List[Str]()
                    var tys = List[Str]()
                    var gk: I32 = 1
                    while gk < gdecl[2].len {
                        tpsn.push(gdecl[2][gk][1])
                        gk += 1
                    }
                    gk = 1
                    while gk < cal[2].len {
                        // 嵌套泛型调用:型参实参经 env 解析为具体型别(外层单态化绑定)
                        tys.push(ct_targ_env(cal[2][gk], env))
                        gk += 1
                    }
                    if tpsn.len != tys.len {
                        panic("emit:泛型实参数")
                        return ""
                    }
                    var mg = "t_" + base[1] + "__"
                    gk = 0
                    while gk < tys.len {
                        var tc = ct_ty_code(tys[gk], file)
                        var ms = ""
                        var mb: I32 = 0
                        while mb < tc.len {
                            var bc = byte_at(tc, mb)
                            if bc == 58 { ms = ms + "_" } else { ms = ms + byte_slice(tc, mb, mb + 1) }
                            mb += 1
                        }
                        mg = mg + ms
                        if gk < tys.len - 1 { mg = mg + "_" }
                        gk += 1
                    }
                    // 定义发射判定:非特化体内,且(预提升模式 或 pass1)。
                    // "#ph<深度>" 递增计数(预提升 phenv 的 "#p"=1 不走 pass1 分支),
                    // 超限 = 递归泛型(无 seen 集,预提升不设终点)→ 显式拦截
                    var emit_def = false
                    var phd: I32 = 0
                    var pk9: I32 = 1
                    while pk9 <= 3 {
                        if ct_env_has(env, "#ph" + pk9.to_string()) {
                            phd = pk9
                        }
                        pk9 += 1
                    }
                    if phd > 0 {
                        if phd >= 3 {
                            panic("emit:泛型特化递归超限:" + mg)
                            return ""
                        }
                        emit_def = true
                    } else {
                        if !ct_env_has(env, "#spec") {
                            if seq2(ct_pass(env), "1") {
                                emit_def = true
                            }
                        }
                    }
                    if emit_def {
                        var spec = mk("Fn")
                        spec.push(mg)
                        spec.push(mk("TPs"))
                        var ps2 = mk("Ps")
                        var pk: I32 = 1
                        while pk < gdecl[3].len {
                            var pr = gdecl[3][pk]
                            if pr[0] == "Param" {
                                var np = mk("Param")
                                np.push(pr[1])
                                np.push(pr[2])
                                np.push(ct_mono_subst_ty(pr[3], tpsn, tys))
                                ps2.push(np)
                            } else {
                                ps2.push(pr)
                            }
                            pk += 1
                        }
                        spec.push(ps2)
                        spec.push(ct_mono_subst_ty(gdecl[4], tpsn, tys))
                        spec.push(gdecl[5])
                        var rcs = ct_ty_code(spec[4], file)
                        // 形参 env:替换后型别码绑定(镜像 ct_fn),体内 Member/字段访问按静态型别分派
                        var genv = List[Str]()
                        var gk2: I32 = 1
                        while gk2 < ps2.len {
                            var gr2 = ps2[gk2]
                            if gr2[0] == "Param" {
                                genv = env_bind(genv, gr2[2], ct_ty_code(gr2[3], file))
                                var elc9 = ct_opt_elem_strict(file, gr2[3])
                                if elc9.len > 0 {
                                    genv = env_bind(genv, "#elem:" + gr2[2], elc9)
                                }
                            }
                            gk2 += 1
                        }
                        // 型参名 → 实参码(体内 List[K] 等 typeof 依据;tpsn/tys 为 push 构建 0 基!)
                        var tk2: I32 = 0
                        while tk2 < tpsn.len {
                            genv = env_bind(genv, tpsn[tk2], ct_ty_code(tys[tk2], file))
                            tk2 += 1
                        }
                        var pk3: I32 = 1
                        while pk3 < ps2.len {
                            if ps2[pk3][0] == "Param" {
                                var ic5 = ct_inst_of_ty(file, ps2[pk3][3])
                                if ic5.len > 0 {
                                    genv = env_bind(genv, "#" + ct_struct_name_of(ic5), ic5)
                                }
                            }
                            pk3 += 1
                        }
                        var ic6 = ct_inst_of_ty(file, spec[4])
                        if ic6.len > 0 {
                            genv = env_bind(genv, "#" + ct_struct_name_of(ic6), ic6)
                        }
                        // 嵌套预提升:#p=1 静默遍历特化体,体内嵌套单态化的定义直出文件作用域
                        ct_body(spec[5], env_bind(env_bind(genv, "#p", "1"), "#ph" + (phd + 1).to_string(), "1"), file, rcs)
                        // 实例 typedef 先于特化签名(同实参多调用点:#ifndef 卫兵去重)
                        pk3 = 1
                        while pk3 < ps2.len {
                            if ps2[pk3][0] == "Param" {
                                ct_emit_inst_typedef(file, ps2[pk3][3])
                            }
                            pk3 += 1
                        }
                        ct_emit_inst_typedef(file, spec[4])
                        println("//DD2:" + mg + " phd=" + phd.to_string())
                        println("#ifndef CT_SPEC_" + mg)
                        println("#define CT_SPEC_" + mg)
                        println(ct_ctype(rcs) + " " + mg + "(" + ct_params_str(spec, file) + ") ")
                        // 真实体:#p=2(eln 直出)+ #spec=1(嵌套单态化只发调用)
                        ct_body(spec[5], env_bind(env_bind(genv, "#p", "2"), "#spec", "1"), file, rcs)
                        println("#endif")
                    }
                    // TypeArgs 调用实参自槽 1 起(成员调用槽 1 为接收者,此处无)
                    var gargs = ct_call_args(ag, 1, env, file, base[1])
                    var grc = ct_generic_retcode(file, base[1], tpsn, tys)
                    var gcall = mg + "(" + gargs + ")"
                    if or2(grc == "L", grc == "LI") { gcall = "(ctron_list*)(" + gcall + ")" }
                    return gcall
                }
            }
            if base[0] == "Ident" && base[1] == "Mutex" {
                var minit = "0"
                if ag.len > 1 { minit = ct_expr(ag[1], env, file) }
                var mi = "i"
                if ag.len > 1 { mi = ct_typeof(ag[1], env, file) }
                if seq2(ct_pass(env), "1") {
                    ct_mcell_emit(mi)
                }
                var mtg = ct_mcell_tag(mi)
                return "(\{ ct_mcell_" + mtg + "* _p = (ct_mcell_" + mtg + "*)malloc(sizeof(ct_mcell_" + mtg + ")); pthread_mutex_init(&_p->mu, 0); _p->v = " + minit + "; _p; })"
            }
        }
        if cal[0] == "Member" {
            var m = cal[3]
            if cal[1][0] == "Ident" && cal[1][1] == "parallel" {
                // parallel 命名空间:map(arr, clo1) / reduce(arr, init, clo2) —— 串行逐元素(镜像 eval)
                if m == "map" {
                    if ag.len < 3 {
                        panic("emit:parallel.map 实参")
                        return ""
                    }
                    var marr = ct_expr(ag[1], env, file)
                    var mart = ct_typeof(ag[1], env, file)
                    if or2(mart == "L", mart == "LI") {
                    } else {
                        panic("emit:parallel 目标限 List")
                        return ""
                    }
                    var mclo = ct_emit_clo(e, ag[2], env, file, 1)
                    return "ct_parallel_mapL((ctron_list*)(" + marr + "), " + mclo + ")"
                }
                if m == "reduce" {
                    if ag.len < 4 {
                        panic("emit:parallel.reduce 实参")
                        return ""
                    }
                    var rarr = ct_expr(ag[1], env, file)
                    var rinit = ct_expr(ag[2], env, file)
                    var rclo = ct_emit_clo(e, ag[3], env, file, 2)
                    return "ct_parallel_reduceL((ctron_list*)(" + rarr + "), (ct_i)(" + rinit + "), " + rclo + ")"
                }
                panic("emit:parallel." + m)
                return ""
            }
            var obj = ct_expr(cal[1], env, file)
            var objt = ct_typeof(cal[1], env, file)
            if m == "spawn" {
                if objt != "g" {
                    panic("emit:spawn 需 scope 接收者")
                    return ""
                }
                if ag.len < 2 {
                    panic("emit:spawn 需闭包字面量")
                    return ""
                }
                if ag[1][0] != "Closure" {
                    panic("emit:spawn 需闭包字面量")
                    return ""
                }
                return ct_emit_spawn(cal, obj, ag[1], env, file)
            }
            if m == "join" { return "(int32_t)ct_join((ct_task*)(" + obj + "))" }
            if m == "join_or" { return "ct_join_or((ct_task*)(" + obj + "))" }
            if m == "send" {
                if ag.len < 2 {
                    panic("emit:send 实参")
                    return ""
                }
                var s0t = ct_typeof(ag[1], env, file)
                return "ct_ch_send((ct_chan*)(" + obj + "), " + ct_wrap_i(s0t, ct_expr(ag[1], env, file)) + ")"
            }
            if m == "recv" { return "ct_ch_recv((ct_chan*)(" + obj + "))" }
            if m == "fetch_add" {
                var f0 = "0"
                if ag.len > 1 { f0 = ct_expr(ag[1], env, file) }
                return "(\{ ctron_cell* _p = (ctron_cell*)(" + obj + "); ct_glock(); int32_t _o = _p->v; _p->v = (int32_t)((int64_t)_o + (int64_t)(" + f0 + ")); ct_gunlock(); _o; })"
            }
            if m == "expect" {
                var emsg = "\"expect failed\""
                if ag.len > 1 { emsg = ct_expr(ag[1], env, file) }
                return "(\{ ct_res _r = " + obj + "; if (_r.variant) \{ ctron_panic(" + emsg + "); } _r.v; })"
            }
            if or2(m == "is_err", m == "is_ok") {
                var neg = ""
                if m == "is_ok" { neg = "!" }
                return "(" + neg + "(" + obj + ").variant)"
            }
            if or2(m == "with", m == "with_mut") {
                panic("emit:with 仅语句位(let/Expr)")
                return ""
            }
            if m == "into_gc" {
                // arena 数据出块唯一入口(§5.3);发射侧 List 恒在 GC 堆 → 恒等(镜像 eval)
                return "(" + obj + ")"
            }
            if m == "push" {
                var a0 = ""
                if ag.len > 1 { a0 = ct_expr(ag[1], env, file) }
                var a0t = "i"
                if ag.len > 1 { a0t = ct_typeof(ag[1], env, file) }
                var objt6 = ct_typeof(cal[1], env, file)
                var pv = ct_arg_cast(a0t, "s", a0)
                if or2(objt6 == "LI", !or2(or2(a0t == "s", a0t == "N"), or2(a0t == "L", or2(a0t == "A", or2(a0t == "g", or2(a0t == "k", or2(a0t == "h", a0t == "R"))))))) {
                    // 标量元素:槽为 char*,经 long 中转(镜像 List 元素槽模型)
                    pv = "(const char*)(long)(" + a0 + ")"
                }
                return "ctron_list_push((ctron_list*)(" + obj + "), " + pv + ")"
            }
            if m == "load" { return "((ctron_cell*)(" + obj + "))->v" }
            if m == "store" {
                var s0 = ""
                if ag.len > 1 { s0 = ct_expr(ag[1], env, file) }
                return "(((ctron_cell*)(" + obj + "))->v = " + s0 + ")"
            }
            if m == "to_string" {
                if objt.len > 2 && byte_slice(objt, 0, 2) == "u:" {
                    panic("emit:struct to_string")
                    return ""
                }
                if objt == "b" { return "((" + obj + ") ? \"true\" : \"false\")" }
                if or2(objt == "s", objt == "N") { return "(const char*)(" + obj + ")" }
                if objt == "6" { return "ctron_i64_to_string(" + obj + ")" }
                return "ctron_i32_to_string((int32_t)(" + obj + "))"
            }
            if or2(m == "set_title", m == "title") {
                // web 档(§9.2)stdweb.dom 最小 API → C stub(真实 WasmGC 后端经 JS 桥替换)
                if cal[1][0] == "Ident" && cal[1][1] == "dom" {
                    if m == "set_title" {
                        if ag.len < 2 {
                            panic("emit:dom.set_title 实参")
                            return ""
                        }
                        return "ctron_dom_set_title(" + ct_call_args(ag, 1, env, file, "") + ")"
                    }
                    return "ctron_dom_title()"
                }
            }
            if m == "show" {
                // @derive(Show)(§3d):结构接收者 → 合成 Name(f=v,...) 串接链(eval fmt_struct 逐字对齐)
                if objt.len > 2 && byte_slice(objt, 0, 2) == "u:" {
                    return ct_show_frag_dp(obj, objt, env, file, 0)
                }
                panic("emit:show 非结构接收者")
                return ""
            }
            if m == "eq" {
                // @derive(Eq)(§3d):结构接收者逐字段相等;实参须同静态型别(eval eq_val 对齐)
                if objt.len > 2 && byte_slice(objt, 0, 2) == "u:" {
                    if ag.len < 2 {
                        panic("emit:eq 缺实参")
                        return ""
                    }
                    var b0t = ct_typeof(ag[1], env, file)
                    if !seq2(b0t, objt) {
                        panic("emit:eq 实参型别:" + b0t)
                        return ""
                    }
                    return ct_eq_expr_dp(obj, ct_expr(ag[1], env, file), objt, env, file, 0)
                }
                panic("emit:eq 非结构接收者")
                return ""
            }
            // UFCS:文件自由 fn 首参调用
            var pcs = ct_fn_pcodes(file, m)
            var p0 = "i"
            if pcs.len > 0 { p0 = pcs[0] }
            return "t_" + m + "(" + ct_arg_cast(objt, p0, obj) + ", " + ct_call_args(ag, 2, env, file, m) + ")"
        }
        var callee = cal[1]
        if callee == "println" {
            var at = ct_typeof(ag[1], env, file)
            if at.len > 2 && byte_slice(at, 0, 2) == "u:" {
                panic("emit:print struct")
                return ""
            }
            if at == "s" { return "printf(\"%s" + bs() + "n\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            if at == "b" { return "printf(\"%s" + bs() + "n\", (" + ct_call_args(ag, 1, env, file, "") + ") ? \"true\" : \"false\")" }
            if at == "6" { return "printf(\"%lld" + bs() + "n\", (long long)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            return "printf(\"%d" + bs() + "n\", (int)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "print" {
            var at2 = ct_typeof(ag[1], env, file)
            if at2.len > 2 && byte_slice(at2, 0, 2) == "u:" {
                panic("emit:print struct")
                return ""
            }
            if at2 == "s" { return "printf(\"%s\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + "));" }
            if at2 == "6" { return "printf(\"%lld\", (long long)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            return "printf(\"%d\", (int)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "ctron_entry" { return "ctron_entry()" }

        if callee == "read_file" {
            if ag.len > 1 && ag[1][0] == "Str" && ct_str_payload(ag[1]) == "CTRONCLIINPUT" {
                // main 输入锚:CLI `run <file>` 可覆盖(ctron_anchor 默认 = 烘焙字面量)
                return "ctron_read_file_cli(ctron_anchor)"
            }
            return "ctron_read_file(" + ct_call_args(ag, 1, env, file, "") + ")"
        }
        if callee == "read_dir" { return "ctron_read_dir(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "fs_exists" { return "(ctron_fs_exists(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        if callee == "fs_write" { return "(ctron_fs_write(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        if callee == "fs_delete" { return "(ctron_fs_delete(" + ct_call_args(ag, 1, env, file, "") + ")?1:0)" }
        if callee == "now_ms" { return "ctron_now_ms()" }
        if callee == "now_ms_text" { return "ctron_now_ms_text()" }
        if callee == "byte_at" { return "ctron_byte_at(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "byte_slice" { return "ctron_byte_slice(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "utf8_enc" {
            var u0 = "0"
            if ag.len > 1 { u0 = ct_expr(ag[1], env, file) }
            return "ctron_utf8_enc((int)(" + u0 + "))"
        }
        if callee == "panic" { return "ctron_panic(" + ct_call_args(ag, 1, env, file, "") + ")" }
        // Option/Result 构造(Phase 5):Ok/Err/Some(expr) → ct_res(载荷按型别包装)
        if cal[0] == "Ident" {
            if or2(cal[1] == "Ok", or2(cal[1] == "Err", cal[1] == "Some")) {
                if ag.len < 2 {
                    panic("emit:" + cal[1] + " 需载荷")
                    return ""
                }
                var rcode = ct_typeof(ag[1], env, file)
                if rcode.len > 2 && byte_slice(rcode, 0, 2) == "E:" {
                    if ag[1][0] != "Call" && ag[1][0] != "Ident" {
                        panic("emit:枚举载荷需变体构造")
                        return ""
                    }
                }
                var vx = ct_res_wrap(rcode, ct_expr(ag[1], env, file))
                var vr = "0"
                if cal[1] == "Err" { vr = "1" }
                return "(\{ ct_res _r; _r.variant = " + vr + "; _r.v = " + vx + "; _r; })"
            }
        }
        // fn 值间接调用(env 命中 F<arity>):( (ct_fnK)t_f )( 实参... )
        if cal[0] == "Ident" && ct_env_has(env, cal[1]) {
            var fvt = ct_env_ty(env, cal[1])
            if fvt.len > 1 && byte_at(fvt, 0) == 70 {
                var far = byte_at(fvt, 1) - 48
                var fv = "(t_" + cal[1] + ")"
                var fargs = "((ct_clop)" + fv + ")->env"
                if ag.len > 1 { fargs = fargs + ", " + ct_wrap_i(ct_typeof(ag[1], env, file), ct_expr(ag[1], env, file)) }
                var fk: I32 = 2
                while fk <= far {
                    if ag.len > fk { fargs = fargs + ", " + ct_wrap_i(ct_typeof(ag[fk], env, file), ct_expr(ag[fk], env, file)) } else { fargs = fargs + ", 0" }
                    fk += 1
                }
                var fhead = "((ct_cfn" + far.to_string() + ")(((ct_clop)" + fv + ")->fn))"
                var fcast = ""
                if byte_at(fvt, 0) == 71 { fcast = "(ct_clop)" }
                return fcast + fhead + "(" + fargs + ")"
            }
        }
        // 用户枚举变体构造(Phase 5):(ct_enum_E){ idx, { p0, p1 } }
        var ven = ct_enum_of_variant(file, callee)
        if ven.len > 0 {
            var vidx = ct_variant_index(file, ven, callee)
            var vpcs = ct_variant_pcodes(file, ven, callee)
            var nargs = ag.len - 1
            if nargs != vpcs.len {
                panic("emit:variant arity:" + callee)
                return ""
            }
            if nargs > 2 {
                panic("emit:变体载荷>2")
                return ""
            }
            var lit = "(ct_enum_" + ven + ")\{ " + vidx.to_string() + ", \{ "
            var pk: I32 = 0
            var firstv = true
            while pk < 2 {
                if !firstv { lit = lit + ", " }
                firstv = false
                if pk < nargs {
                    lit = lit + ct_wrap_i(vpcs[pk], ct_expr(ag[pk + 1], env, file))
                } else {
                    lit = lit + "0"
                }
                pk += 1
            }
            lit = lit + " } }"
            return lit
        }
        // extern "c" 声明:C 侧符号无 t_ 前缀(§9.6)
        var isext = false
        var ie: I32 = 1
        while ie < file.len {
            var dd = file[ie]
            if dd[0] == "FnExt" && dd[1] == callee {
                isext = true
            }
            ie += 1
        }
        if isext {
            return callee + "(" + ct_call_args(ag, 1, env, file, callee) + ")"
        }
        return "t_" + callee + "(" + ct_call_args(ag, 1, env, file, callee) + ")"
    }
    if t == "Try" {
        // 表达式位 ?(§5 NULL 模型):ct_res 解包,Err/None 短路 return,载荷按元素码转型
        var ec = ct_try_elem(file, e, env)
        var qv = "t_q" + nline(e)
        return "(\{ ct_res " + qv + " = " + ct_expr(e[1], env, file) + "; if (" + qv + ".variant != 0) \{ return " + qv + "; } (" + ct_ctype(ec) + ")(" + qv + ".v); })"
    }
    panic("ct_expr:" + t)
    return ""
}

// 实参串:从 ag[from] 起逐个发射,用户 fn 时按形参码插转换;
// 实参不足按 0 补齐到形参数(镜像 cc.ct 潜伏的缺参调用,如 ty_head 的 2 参 or3 —— 种子
// 一旦执行即 panic,补 0 仅保证产物可编译,崩路无差分意义)
fn ct_call_args(ag: List[Str], from: I32, env: List[Str], file: List[Str], callee: Str) -> Str {
    var pcs = ct_fn_pcodes(file, callee)
    var args = ""
    var i: I32 = from
    while i < ag.len {
        if i > from { args = args + ", " }
        var ac = ct_typeof(ag[i], env, file)
        var pc = "i"
        if callee != "" && i - 1 < pcs.len { pc = pcs[i - 1] }
        args = args + ct_arg_cast(ac, pc, ct_expr(ag[i], env, file))
        i += 1
    }
    if callee != "" {
        var miss = pcs.len - (ag.len - from) - (from - 1)
        while miss > 0 {
            args = args + ", 0"
            miss -= 1
        }
    }
    return args
}

// 块语句序列(不含花括号与尾槽)
// 体内是否存在对该名的 Assign(递归所有子块)
fn ct_assigned(nm: Str, b: List[Str]) -> Bool {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Assign" {
            if st[1][0] == "Ident" && st[1][1] == nm {
                return true
            }
            if st[1][0] == "Index" && st[1][1][0] == "Ident" && st[1][1][1] == nm {
                return true
            }
        }
        // 递归子块/子表达式容器
        if t == "While" {
            if ct_assigned(nm, st[2]) {
                return true
            }
        }
        if t == "For" {
            if ct_assigned(nm, st[3]) {
                return true
            }
        }
        if t == "If" {
            if ct_assigned(nm, st[2]) {
                return true
            }
            if st[3][0] == "If" {
                if ct_assigned(nm, st[3]) {
                    return true
                }
            } else {
                if st[3][0] == "BlockExpr" {
                    if ct_assigned(nm, st[3][1]) {
                        return true
                    }
                }
            }
        }
        if t == "Match" {
            var arms = st[2]
            var mi: I32 = 1
            while mi < arms.len {
                var be = arms[mi][2]
                if be[0] == "BlockExpr" {
                    if ct_assigned(nm, be[1]) {
                        return true
                    }
                }
                mi += 1
            }
        }
        i += 1
    }
    return false
}

// while 体顶层 let 名单(提升声明用):简单模式 + 标量/指针码 + 体内零赋值
// (数组 init 花括号不提升;有赋值的动态型变量不提升 —— 静态型别保不住)。
// 候选按序绑定到不断增长的 ew:后候选的 init 可见先候选的型别(如 ty = f[3] 需 f:N)
fn ct_hoists(b: List[Str], env: List[Str], file: List[Str]) -> List[Str] {
    var out = List[Str]()
    var ew = env
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        if st[0] == "Let" {
            var pat = st[2]
            if or2(pat[0] == "PatId", pat[0] == "PatAgg" && pat[2][0] == "SubUnit") {
                if !ct_assigned(pat[1], b) {
                    var ty = "i"
                    if st[3][0] != "None" {
                        ty = ct_ty_code(st[3], file)
                    } else {
                        ty = ct_typeof(st[4], ew, file)
                    }
                    if ty != "L" && ty != "LI" && ty != "A" && ty != "R" && ty != "g" && ty != "k" && ty != "h" && !(ty.len > 1 && or2(byte_at(ty, 0) == 109, byte_at(ty, 0) == 80)) && !(ty.len >= 3 && byte_slice(ty, 0, 1) == "a") {
                        out.push(pat[1] + ":" + ty)
                        ew = env_bind(ew, pat[1], ty)
                    }
                }
            }
        }
        i += 1
    }
    return out
}

fn ct_zero(code: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        return "(t_" + byte_slice(code, 2, code.len) + ")\{0}"
    }
    if code == "f" { return "0.0" }
    return "0"
}

// 定长数组码 a<N><元素码>:元素码自 v4 起可多字符(如 u:Point)
fn a_count(code: Str) -> Str {
    var i: I32 = 1
    while i < code.len {
        var c = byte_at(code, i)
        var dig = true
        if c < 48 {
            dig = false
        }
        if c > 57 {
            dig = false
        }
        if !dig {
            return byte_slice(code, 1, i)
        }
        i += 1
    }
    return byte_slice(code, 1, code.len)
}

fn a_elem(code: Str) -> Str {
    var i: I32 = 1
    while i < code.len {
        var c = byte_at(code, i)
        var dig = true
        if c < 48 {
            dig = false
        }
        if c > 57 {
            dig = false
        }
        if !dig {
            return byte_slice(code, i, code.len)
        }
        i += 1
    }
    return "i"
}

// @derive(Show) 合成(§3d):值 C 表达式 x(静态码 ty)→ 显示文本 C 表达式。
// 标量/Str 按插值同型转换;struct 按声明序递归展开字段 —— 串接链
// "Name(" + ("f=<v>",)*n + ")" 与 eval 侧 fmt_struct 逐字对齐。深度限 6(镜像宿主)。
fn ct_show_frag_dp(x: Str, ty: Str, env: List[Str], file: List[Str], dp: I32) -> Str {
    if or2(ty == "s", ty == "N") { return "(" + x + ")" }
    if ty == "i" { return "ctron_i32_to_string((int32_t)(" + x + "))" }
    if ty == "6" { return "ctron_i64_to_string((int64_t)(" + x + "))" }
    if ty == "b" { return "((" + x + ") ? \"true\" : \"false\")" }
    if dp < 6 {
        if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
            var snm = ct_struct_name_of(ty)
            var gen = false
            if ct_struct_tps(file, snm).len > 0 {
                gen = true
            }
            var fs = List[Str]()
            var i: I32 = 1
            while i < file.len {
                var d = file[i]
                if d[0] == "Struct" && d[1] == snm {
                    fs = d[4]
                }
                i += 1
            }
            var acc = "\"" + ct_cstr(snm) + "(\""
            var j: I32 = 1
            var first = true
            while j < fs.len {
                var fd = fs[j]
                var fty = ""
                if gen {
                    fty = ct_field_ty_inst(file, ty, fd[2])
                } else {
                    fty = ct_field_ty(file, snm, fd[2])
                }
                var fx = ct_show_frag_dp("(" + x + ")." + fd[2], fty, env, file, dp + 1)
                if first {
                    first = false
                } else {
                    acc = "ctron_str_concat(" + acc + ", \",\")"
                }
                acc = "ctron_str_concat(" + acc + ", \"" + ct_cstr(fd[2]) + "=\")"
                acc = "ctron_str_concat(" + acc + ", " + fx + ")"
                j += 1
            }
            acc = "ctron_str_concat(" + acc + ", \")\")"
            return acc
        }
    }
    panic("emit:show 字段型别:" + ty)
    return ""
}

// @derive(Eq) 合成(§3d):a/b 的 C 表达式(静态码 ty)→ 逐字段相等 C 布尔式。
// 标量 ==、Str strcmp、嵌套 struct 递归展开;"&&" 为 C 输出文本,
// 与 eval 侧 eq_val 逐字对齐。深度限 6(镜像 show)。
fn ct_eq_expr_dp(a: Str, b: Str, ty: Str, env: List[Str], file: List[Str], dp: I32) -> Str {
    if ty == "s" { return "(strcmp((const char*)(" + a + "), (const char*)(" + b + ")) == 0)" }
    if or2(ty == "i", or2(ty == "6", ty == "b")) { return "((" + a + ") == (" + b + "))" }
    if dp < 6 {
        if ty.len > 2 && byte_slice(ty, 0, 2) == "u:" {
            var snm = ct_struct_name_of(ty)
            var gen = false
            if ct_struct_tps(file, snm).len > 0 {
                gen = true
            }
            var fs = List[Str]()
            var i: I32 = 1
            while i < file.len {
                var d = file[i]
                if d[0] == "Struct" && d[1] == snm {
                    fs = d[4]
                }
                i += 1
            }
            var acc = ""
            var j: I32 = 1
            while j < fs.len {
                var fd = fs[j]
                var fty = ""
                if gen {
                    fty = ct_field_ty_inst(file, ty, fd[2])
                } else {
                    fty = ct_field_ty(file, snm, fd[2])
                }
                var fc = ct_eq_expr_dp("(" + a + ")." + fd[2], "(" + b + ")." + fd[2], fty, env, file, dp + 1)
                if acc == "" {
                    acc = fc
                } else {
                    acc = "(" + acc + " && " + fc + ")"
                }
                j += 1
            }
            if acc == "" {
                return "1"
            }
            return acc
        }
    }
    panic("emit:eq 字段型别:" + ty)
    return ""
}

// 单态化支撑:具体实例型别节点 → 实例码(非实例/无实参 → "")
fn ct_inst_of_ty(file: List[Str], nt: List[Str]) -> Str {
    if nt[0] == "Named" {
        if nt[2].len > 1 {
            if ct_struct_tps(file, nt[1]).len > 0 {
                var cs = List[Str]()
                var q: I32 = 1
                while q < nt[2].len {
                    cs.push(ct_ty_code(nt[2][q], file))
                    q += 1
                }
                return ct_struct_inst_code(nt[1], cs)
            }
        }
    }
    return ""
}

// 单态化点实例 typedef 直出(C 重复 typedef 合法,免去去重状态);
// 实参为嵌套实例时递归。pass1 内调用,先于 pass2 引用。
fn ct_emit_inst_typedef(file: List[Str], nt: List[Str]) {
    if nt[0] != "Named" {
        return
    }
    if nt[2].len > 1 {
        var q2: I32 = 1
        while q2 < nt[2].len {
            ct_emit_inst_typedef(file, nt[2][q2])
            q2 += 1
        }
    }
    var ic = ct_inst_of_ty(file, nt)
    if ic.len == 0 {
        return
    }
    // 匿名 struct 重复 typedef 亦是重定义 → 预处理卫兵去重(同型多调用点)
    var tn = ct_ctype(ic)
    println("#ifndef CT_TDEF_" + tn)
    println("#define CT_TDEF_" + tn)
    var info = ct_struct_inst_split(ic)
    var bar = 0
    var ci: I32 = 0
    while ci < info.len {
        if byte_at(info, ci) == 124 { bar = ci }
        ci += 1
    }
    var snm = byte_slice(info, 0, bar)
    var encs = byte_slice(info, bar + 1, info.len)
    var ii: I32 = 1
    while ii < file.len {
        var sd = file[ii]
        if sd[0] == "Struct" && sd[1] == snm {
            var fs = sd[4]
            var line = "typedef struct \{ "
            var fj: I32 = 1
            while fj < fs.len {
                var fd = fs[fj]
                var dc = ct_field_code_inst(file, fd[3], snm, encs)
                line = line + ct_ctype(dc) + " " + fd[2] + "; "
                fj += 1
            }
            line = line + "} " + tn + ";"
            println(line)
            println("#endif")
        }
        ii += 1
    }
}
