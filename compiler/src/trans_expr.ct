                    if seq2(m, "not_u32") { return "(uint32_t)(~((uint32_t)(" + ua + ")))" }
                    if seq2(m, "not_i64") { return "(int64_t)(~((uint64_t)(" + ua + ")))" }
                    return "(uint64_t)(~((uint64_t)(" + ua + ")))"
