// =====================================================================
// sem_closure.ct —— E3070:闭包可变捕获未显式 Mutex 包装(§4.7 v0.6,两遍式)
// 第一遍 cscan/cscan_b 全文件 var 绑定名;第二遍 mblock/mexpr/mblock2/cassign_names/
// cblock2 收集闭包赋值目标,交集即违规(诊断含机械修复建议;嵌套闭包独立;自身参数不标记)。
// =====================================================================
// ---------------- E3070:闭包可变捕获未显式 Mutex 包装(§4.7 v0.6,两遍式) ----------------
// 第一遍收集全文件 var 绑定名;第二遍对每个闭包收集其赋值目标,交集即违规。
// 遍历器必须全下钻(Block/BlockExpr 双形态都有分派)。
fn mblock(file: List[Str], b: List[Str], out: List[Str]) {
    var i: I32 = 1
    while i < b.len {
        var st = b[i]
        var t = st[0]
        if t == "Let" {
            if seq2(st[1], "true") && st[2][0] == "PatId" {
                out.push(st[2][1])
            }
            mexpr(file, st[4], out)
        } else if t == "While" {
            mexpr(file, st[1], out)
            mblock(file, st[2], out)
        } else if t == "For" {
            mexpr(file, st[2], out)
            mblock(file, st[3], out)
        } else if t == "Return" {
            if st[1].len > 1 {
                mexpr(file, st[1], out)
            }
        } else if t == "Assign" {
            mexpr(file, st[1], out)
            mexpr(file, st[3], out)
        } else if t == "Expr" {
            mexpr(file, st[1], out)
        } else if seq2(t, "None") && st.len == 1 {
            // 块尾标记
        } else {
            mexpr(file, st, out)
        }
        i += 1
    }
}

fn mexpr(file: List[Str], e: List[Str], out: List[Str]) {
    var t = e[0]
    if t == "If" {
        mexpr(file, e[1], out)
        mblock(file, e[2], out)
        mexpr(file, e[3], out)
        return
    }
    if t == "Match" {
        mexpr(file, e[1], out)
        var arms = e[2]
        var i2: I32 = 1
        while i2 < arms.len {
            mexpr(file, arms[i2][2], out)
            i2 += 1
        }
        return
    }
    if t == "Closure" {
        mexpr(file, e[3], out)
        return
    }
    if t == "Call" {
        mexpr(file, e[1], out)
        var ag = e[2]
        var i3: I32 = 1
        while i3 < ag.len {
            mexpr(file, ag[i3], out)
            i3 += 1
        }
        return
    }
    if t == "Member" {
        mexpr(file, e[1], out)
        return
    }
    if t == "Binary" {
        mexpr(file, e[2], out)
        mexpr(file, e[3], out)
        return
    }
    if t == "Unary" {
        mexpr(file, e[2], out)
        return
    }
    if t == "Range" {
        mexpr(file, e[2], out)
        mexpr(file, e[3], out)
        return
    }
    if t == "Index" {
        mexpr(file, e[1], out)
        mexpr(file, e[2], out)
        return
    }
    if t == "TypeArgs" {
        mexpr(file, e[1], out)
        return
    }
    if t == "Try" {
        mexpr(file, e[1], out)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i4: I32 = 1
        while i4 < e.len {
            mexpr(file, e[i4], out)
            i4 += 1
        }
        return
    }
    if t == "BlockExpr" {
        mblock(file, e[1], out)
        return
    }
    if or2(t == "Own", t == "Scope") {
        mblock(file, e[2], out)
        return
    }
    if t == "StructLit" {
        var lf = e[2]
        var i5: I32 = 1
        while i5 < lf.len {
            var c = lf[i5]
            if seq2(c[0], "LField") {
                mexpr(file, c[2], out)
            }
            i5 += 1
        }
        return
    }
}

fn mblock2(file: List[Str], out: List[Str]) {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) {
            mblock(file, d[5], out)
        } else if d[0] == "Impl" {
            var its = d[4]
            var mi: I32 = 1
            while mi < its.len {
                var md = its[mi]
                if md[0] == "Method" {
                    mblock(file, md[5], out)
                }
                mi += 1
            }
        } else if d[0] == "Test" {
            mblock(file, d[2], out)
        }
        i += 1
    }
}

fn cassign_names(e: List[Str], out: List[Str]) {
    var t = e[0]
    if t == "Block" {
        cblock2(e, out)
        return
    }
    if t == "BlockExpr" {
        cblock2(e[1], out)
        return
    }
    if t == "Closure" {
        return
    }
    if t == "Assign" {
        if e[1][0] == "Ident" {
            out.push(e[1][1])
        }
        cassign_names(e[3], out)
        return
    }
    if t == "Call" {
        cassign_names(e[1], out)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            cassign_names(ag[i], out)
            i += 1
        }
        return
    }
    if t == "Member" {
        cassign_names(e[1], out)
        return
    }
    if t == "Binary" {
        cassign_names(e[2], out)
        cassign_names(e[3], out)
        return
    }
    if t == "Unary" {
        cassign_names(e[2], out)
        return
    }
    if t == "Range" {
        cassign_names(e[2], out)
        cassign_names(e[3], out)
        return
    }
    if t == "Index" {
        cassign_names(e[1], out)
        cassign_names(e[2], out)
        return
    }
    if t == "TypeArgs" {
        cassign_names(e[1], out)
        return
    }
    if t == "Try" {
        cassign_names(e[1], out)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            cassign_names(e[i2], out)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr2" {
        return
    }
    if t == "If" {
        cassign_names(e[1], out)
        cblock2(e[2], out)
        cassign_names(e[3], out)
        return
    }
    if t == "Match" {
        cassign_names(e[1], out)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            cassign_names(arms[i3][2], out)
            i3 += 1
        }
        return
    }
    if or2(t == "Own", t == "Scope") {
        cblock2(e[2], out)
        return
    }
    if t == "StructLit" {
        var lf = e[2]
        var i4: I32 = 1
        while i4 < lf.len {
            var c = lf[i4]
            if seq2(c[0], "LField") {
                cassign_names(c[2], out)
            }
            i4 += 1
        }
        return
    }
}

fn cblock2(b: List[Str], out: List[Str]) {
    var i: I32 = 1
    while i < b.len {
        var st = b[i]
        var t = st[0]
        if t == "Let" {
            cassign_names(st[4], out)
        } else if t == "While" {
            cassign_names(st[1], out)
            cblock2(st[2], out)
        } else if t == "For" {
            cassign_names(st[2], out)
            cblock2(st[3], out)
        } else if t == "Return" {
            if st[1].len > 1 {
                cassign_names(st[1], out)
            }
        } else if t == "Assign" {
            if st[1][0] == "Ident" {
                out.push(st[1][1])
            }
            cassign_names(st[1], out)
            cassign_names(st[3], out)
        } else if t == "Expr" {
            cassign_names(st[1], out)
        } else if seq2(t, "None") && st.len == 1 {
            // 尾标记
        } else {
            cassign_names(st, out)
        }
        i += 1
    }
}

fn cscan(node: List[Str], muts: List[Str], diags: List[Str]) {
    var t = node[0]
    if t == "Closure" {
        var names = List[Str]()
        cassign_names(node[3], names)
        var i: I32 = 0
        while i < names.len {
            var nm = names[i]
            var m = "E3070: 闭包可变捕获未显式 Mutex[T] 包装:" + nm + "(建议:改用 Mutex[T].with_mut)"
            if in_list(muts, nm) && !in_list(diags, m) {
                diags.push(m)
            }
            i += 1
        }
        cscan(node[3], muts, diags)
        return
    }
    if t == "Call" {
        cscan(node[1], muts, diags)
        var ag = node[2]
        var i: I32 = 1
        while i < ag.len {
            cscan(ag[i], muts, diags)
            i += 1
        }
        return
    }
    if t == "Member" {
        cscan(node[1], muts, diags)
        return
    }
    if t == "Binary" {
        cscan(node[2], muts, diags)
        cscan(node[3], muts, diags)
        return
    }
    if t == "Unary" {
        cscan(node[2], muts, diags)
        return
    }
    if t == "Range" {
        cscan(node[2], muts, diags)
        cscan(node[3], muts, diags)
        return
    }
    if t == "Index" {
        cscan(node[1], muts, diags)
        cscan(node[2], muts, diags)
        return
    }
    if t == "TypeArgs" {
        cscan(node[1], muts, diags)
        return
    }
    if t == "Try" {
        cscan(node[1], muts, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < node.len {
            cscan(node[i2], muts, diags)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        cscan_b(node[1], muts, diags)
        return
    }
    if t == "Block" {
        cscan_b(node, muts, diags)
        return
    }
    if t == "Let" {
        cscan(node[4], muts, diags)
        return
    }
    if t == "While" {
        cscan(node[1], muts, diags)
        cscan_b(node[2], muts, diags)
        return
    }
    if t == "For" {
        cscan(node[2], muts, diags)
        cscan_b(node[3], muts, diags)
        return
    }
    if t == "Return" {
        if node[1].len > 1 {
            cscan(node[1], muts, diags)
        }
        return
    }
    if t == "Assign" {
        cscan(node[1], muts, diags)
        cscan(node[3], muts, diags)
        return
    }
    if t == "If" {
        cscan(node[1], muts, diags)
        cscan_b(node[2], muts, diags)
        cscan(node[3], muts, diags)
        return
    }
    if t == "Match" {
        cscan(node[1], muts, diags)
        var arms = node[2]
        var i3: I32 = 1
        while i3 < arms.len {
            cscan(arms[i3][2], muts, diags)
            i3 += 1
        }
        return
    }
    if or2(t == "Own", t == "Scope") {
        cscan_b(node[2], muts, diags)
        return
    }
    if t == "StructLit" {
        var lf = node[2]
        var i4: I32 = 1
        while i4 < lf.len {
            var c = lf[i4]
            if seq2(c[0], "LField") {
                cscan(c[2], muts, diags)
            }
            i4 += 1
        }
        return
    }
}

fn cscan_b(b: List[Str], muts: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len {
        cscan(b[i], muts, diags)
        i += 1
    }
}

fn sem_closures(file: List[Str], diags: List[Str]) {
    var muts = List[Str]()
    mblock2(file, muts)
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", or2(d[0] == "FnPub", d[0] == "FnExt"))) {
            cscan_b(d[5], muts, diags)
        } else if d[0] == "Impl" {
            var its = d[4]
            var mi: I32 = 1
            while mi < its.len {
                var md = its[mi]
                if md[0] == "Method" {
                    cscan_b(md[5], muts, diags)
                }
                mi += 1
            }
        } else if d[0] == "Test" {
            cscan_b(d[2], muts, diags)
        }
        i += 1
    }
}
