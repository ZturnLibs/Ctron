// fs_mkdir 宿主实现(FB-2):extern 同 TU runtime helper(单文件发射;用户程序走 trans_expr 映射,同 helper)
#[trusted]
extern "c" fn ctron_fs_mkdir_p(path: Str) -> I32

fn fs_mkdir(path: Str) -> Bool {
    let rc = ctron_fs_mkdir_p(path)
    if rc == 1 { return true }
    return false
}

// =====================================================================
// eval_call.ct —— 调用域:fn 值/声明调用(call_decl_vals/call_cv/call_id)、
// 成员与内建方法分派 call_mem(List/String/Option/Result/Scope/Channel/Mutex/
// Atomic/parallel/Simd…)、eval_call 入口、variant_arity/conv_as 显式转换、
// ns_map_reduce、utf8_cont/str_contains。
// S1 Val 换代:实参表 vals 为 box 位面(复合恒等/标量旧编码),消费点 v_unbox。
// =====================================================================

// W4 E1:解释口径 extern 直调桥宿主口(实现在发射运行时 boilerplate,
// driver_emit.ct 侧 ctron_ext_dispatch;dlsym 直调宿主链接的 vendored 符号)。
// T45 float 帧:返回 I64(long 传输,消 int 截断=close(-1) 回转缺口);浮返
// 值经 ctron_ext_fret() 文本缓冲("%.17g" 往返零损)二次取回。
// 注:参数表必须单行——C 宿主解析器不支持跨行参数表(2026-09-19 实证)
#[trusted]
extern "c" fn ctron_ext_dispatch(nm: Str, a0: Str, a1: Str, a2: Str, a3: Str, a4: Str, a5: Str, a6: Str, a7: Str, a8: Str, a9: Str, a10: Str, a11: Str) -> I64

#[trusted]
extern "c" fn ctron_ext_fret() -> Str

// T26 进程参数底座(§8.1 Env.args):发射运行时模板定义(driver_emit.ct
// main 入口寄存 argc/argv),自举解释器经 extern 直调(同 ctron_ext_dispatch 形)
#[trusted]
extern "c" fn ctron_prog_args_n() -> I64

#[trusted]
extern "c" fn ctron_prog_args_at(i: I64) -> Str

// FB-8/F5:T[N] 形参值语义——A 记录(数组值)递归深拷(镜像发射位调用点栈拷贝;
// 旧直传共享记录,被调改元即污染调用方,静默错值)
fn arr_copy_val(v: Val) -> Val {
    if v.tag == 8 && cx_of(v).len > 0 && seq2(cx_of(v)[0], "A") {
        var out = List[Str]()
        out.push("A")
        var i: I32 = 1
        while i < cx_of(v).len {
            out.push(v_box(arr_copy_val(v_unbox(cx_of(v)[i]))))
            i += 1
        }
        return Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(out) }
    }
    return v
}

fn call_decl_vals(file: List[Str], env: List[Str], out: Str, d: List[Str], vals: List[Str]) -> Flow {
    var ps = d[3]
    var nenv = List[Str]()
    var k: I32 = 1
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            var pv8 = v_unbox(vals[k - 1])
            if pr.len > 3 && pr[3][0] == "ArrayT" {
                pv8 = arr_copy_val(pv8)
            }
            nenv = env_add(nenv, pr[2], bind_of(file, pv8))
        }
        k += 1
    }
    var br = run_block(file, nenv, out, d[5], false)
    var fl = "k"
    if br.kind == "a" {
        fl = "a"
    }
    return e4(fl, env, br.v, br.out)
}
fn call_cv(file: List[Str], env: List[Str], out: Str, v: Val, vals: List[Str]) -> Flow {
    if v.tag == 8 {
        if seq2(cx_of(v)[0], "F") {
            var d = find_decl(file, cx_of(v)[1])
            if d.len == 0 {
                panic("no fn:" + cx_of(v)[1])
                return e4("a", env, vV2(), out)
            }
            return call_decl_vals(file, env, out, d, vals)
        }
        if seq2(cx_of(v)[0], "C") {
            var cap = cx_of(v)[3]
            var cp = cx_of(v)[1]
            var nenv = cap
            var k: I32 = 1
            while k < cp.len {
                nenv = env_add(nenv, cp[k][2], v_unbox(vals[k - 1]))
                k += 1
            }
            var br = eval_expr(file, nenv, out, cx_of(v)[2])
            // 调用边界收编流(镜像 call_decl_vals):闭包体内 return 的 "r" 流
            // 此前裸传——裸调用表达式位直穿到外层语句流,fn main 静默吞掉其余体
            //(rc=0 零输出,`let g = || \{ return 41 \}` 实证;spawn 位点本就吸收,
            // Rust 宿主 Ok(v) 同口径)。break/continue 越界闭包=sem E2071/72 域,
            // 与具名 fn 同式收编为 k
            var cfl = "k"
            if br.kind == "a" {
                cfl = "a"
            }
            return e4(cfl, env, br.v, br.out)
        }
    }
    panic("call value")
    return e4("a", env, vV2(), out)
}
fn call_id(file: List[Str], env: List[Str], out: Str, nm: Str, vals: List[Str]) -> Flow {
    if seq2(nm, "StringBuilder") {
        // StringBuilder()(§3.8.2;T03):值 = SB 复合(段表挂 cx),push_str 原地变
        if vals.len == 0 {
            var sbv = List[Str]()
            sbv.push("SB")
            return e4("k", env, cx_val(sbv), out)
        }
        panic("StringBuilder arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "print") {
        if vals.len == 1 {
            return e4("k", env, vV2(), out + fmt(v_unbox(vals[0])))
        }
        panic("print arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "println") {
        if vals.len == 1 {
            return e4("k", env, vV2(), out + fmt(v_unbox(vals[0])) + "\n")
        }
        panic("println arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert") {
        if vals.len == 1 {
            if truth(v_unbox(vals[0])) {
                return e4("k", env, vV2(), out)
            }
            // §6.4 对齐:消息在失败点入 out(时序同 native ctron_panic)
            return e4("a", env, vV2(), out + "assert failed\n")
        }
        panic("assert arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert_eq") {
        if vals.len == 2 {
            if veq(v_unbox(vals[0]), v_unbox(vals[1])) {
                return e4("k", env, vV2(), out)
            }
            // §6.4 对齐:同上,消息带操作数值
            return e4("a", env, vV2(), out + "assert_eq failed: " + fmt(v_unbox(vals[0])) + " != " + fmt(v_unbox(vals[1])) + "\n")
        }
        panic("assert_eq arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert_ne") {
        if vals.len == 2 {
            if !veq(v_unbox(vals[0]), v_unbox(vals[1])) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert_ne failed: " + fmt(v_unbox(vals[0])) + " != " + fmt(v_unbox(vals[1]))), out)
        }
        panic("assert_ne arity")
        return e4("a", env, vV2(), out)
    }
    // L4-③:Bytes 族 interp(read_bytes 降级=C 串域 NUL 截断,宿主字节原语=L4-②;
    // Y 记录=box U8 字节表)
    if seq2(nm, "read_bytes") {
        if vals.len == 1 {
            var r0 = v_unbox(vals[0])
            if r0.tag == 5 {
                var rr = read_file(r0.s)
                var src = ""
                match rr {
                    Some(s2) => {
                        src = s2
                    }
                    None => {
                        src = ""
                    }
                }
                var bv = List[Str]()
                bv.push("Y")
                var kb: I32 = 0
                while kb < src.len {
                    bv.push(v_box(vI(byte_at(src, kb))))
                    kb += 1
                }
                return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(bv) }, out)
            }
        }
        panic("read_bytes args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "bytes_len") {
        if vals.len == 1 {
            var b0 = v_unbox(vals[0])
            if b0.tag == 8 && cx_of(b0).len > 0 && seq2(cx_of(b0)[0], "Y") {
                return e4("k", env, vI(cx_of(b0).len - 1), out)
            }
        }
        panic("bytes_len args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "bytes_at") {
        if vals.len == 2 {
            var b1 = v_unbox(vals[0])
            var i1 = v_unbox(vals[1])
            if b1.tag == 8 && cx_of(b1).len > 0 && seq2(cx_of(b1)[0], "Y") {
                var ix = i1.iv.as[I32]()
                if ix < 0 || ix >= cx_of(b1).len - 1 {
                    panic("bytes index out of bounds")
                    return e4("a", env, vV2(), out)
                }
                return e4("k", env, v_unbox(cx_of(b1)[ix + 1]), out)
            }
        }
        panic("bytes_at args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "bytes_slice") {
        if vals.len == 3 {
            var b2 = v_unbox(vals[0])
            var a2v = v_unbox(vals[1])
            var n2v = v_unbox(vals[2])
            if b2.tag == 8 && cx_of(b2).len > 0 && seq2(cx_of(b2)[0], "Y") {
                var st2 = a2v.iv.as[I32]()
                var nn2 = n2v.iv.as[I32]()
                var tot2 = cx_of(b2).len - 1
                if st2 < 0 || nn2 < 0 || st2 + nn2 > tot2 {
                    panic("bytes slice range")
                    return e4("a", env, vV2(), out)
                }
                var nb = List[Str]()
                nb.push("Y")
                var k2: I32 = 0
                while k2 < nn2 {
                    nb.push(cx_of(b2)[st2 + k2 + 1])
                    k2 += 1
                }
                return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(nb) }, out)
            }
        }
        panic("bytes_slice args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "bytes_to_str") {
        if vals.len == 1 {
            var b3 = v_unbox(vals[0])
            if b3.tag == 8 && cx_of(b3).len > 0 && seq2(cx_of(b3)[0], "Y") {
                var s3 = ""
                var k3: I32 = 1
                while k3 < cx_of(b3).len {
                    var e3 = v_unbox(cx_of(b3)[k3])
                    var by3 = e3.iv.as[I32]()
                    if by3 == 0 { break }
                    s3 = s3 + utf8_enc(by3)
                    k3 += 1
                }
                return e4("k", env, vS(s3), out)
            }
        }
        panic("bytes_to_str args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "read_file") {
        if vals.len == 1 {
            var r0 = v_unbox(vals[0])
            if r0.tag == 5 {
                // 直返 Str(缺失 → 空串)——与原生发射口径对齐(SL-0.6 ⑯:此前返回
                // T/Some 包装,解释口径 var s: Str = read_file(...) 直用 .len 即 panic,
                // 同代码两口径语义分裂;rf.ct 最小复现 2026-09-20)
                var rr = read_file(r0.s)
                match rr {
                    Some(s) => {
                        return e4("k", env, vS(s), out)
                    }
                    None => {
                        return e4("k", env, vS(""), out)
                    }
                }
            }
        }
        panic("read_file args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "read_dir") {
        if vals.len == 1 {
            var r1 = v_unbox(vals[0])
            if r1.tag == 5 {
                var rd = read_dir(r1.s)
                match rd {
                    Some(s2) => {
                        var tv2 = List[Str]()
                        tv2.push("T")
                        tv2.push("Some")
                        tv2.push(v_box(vS(s2)))
                        return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tv2) }, out)
                    }
                    None => {
                        var tw2 = List[Str]()
                        tw2.push("T")
                        tw2.push("None")
                        return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tw2) }, out)
                    }
                }
            }
        }
        panic("read_dir args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "fs_exists") {
        if vals.len == 1 {
            var r2 = v_unbox(vals[0])
            if r2.tag == 5 {
                if fs_exists(r2.s) {
                    return e4("k", env, vB(true), out)
                }
                return e4("k", env, vB(false), out)
            }
        }
        panic("fs_exists args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "fs_write") {
        if vals.len == 2 {
            var r3 = v_unbox(vals[0])
            var r4 = v_unbox(vals[1])
            if r3.tag == 5 && r4.tag == 5 {
                if fs_write(r3.s, r4.s) {
                    return e4("k", env, vB(true), out)
                }
                return e4("k", env, vB(false), out)
            }
        }
        panic("fs_write args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "fs_mkdir") {
        if vals.len == 1 {
            var r5 = v_unbox(vals[0])
            if r5.tag == 5 {
                if fs_mkdir(r5.s) {
                    return e4("k", env, vB(true), out)
                }
                return e4("k", env, vB(false), out)
            }
        }
        panic("fs_mkdir args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "fs_delete") {
        if vals.len == 1 {
            var r5 = v_unbox(vals[0])
            if r5.tag == 5 {
                if fs_delete(r5.s) {
                    return e4("k", env, vB(true), out)
                }
                return e4("k", env, vB(false), out)
            }
        }
        panic("fs_delete args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "now_ms") {
        if vals.len != 0 {
            panic("now_ms arity")
            return e4("a", env, vV2(), out)
        }
        return e4("k", env, v6(now_ms_text()), out)
    }
    if seq2(nm, "ctron_entry") {
        if vals.len != 0 {
            panic("ctron_entry arity")
            return e4("a", env, vV2(), out)
        }
        return e4("k", env, vS(ctron_entry()), out)
    }
    if seq2(nm, "ctron_embedded") {
        // SL-7α:程序自身 GuiBlock 重建 CTML(内嵌形态数据源;file = 合并后整文件,
        // 主源 GuiBlock 与域包声明同节点,调用点在哪个模块都能取到)
        if vals.len != 0 {
            panic("ctron_embedded arity")
            return e4("a", env, vV2(), out)
        }
        return e4("k", env, vS(gui_blocks_src(file)), out)
    }
    if seq2(nm, "ctron_gui_entry") {
        // J18:清单 gui.entry(interp 口径现读清单;发射口径烘焙常量,双口径
        // 同语义)。无清单/无键 = "app.ctml" 存量默认
        var gent = pkg_manifest_gui_entry(pkg_dir_of(ctron_entry()))
        if seq2(gent, "") {
            gent = "app.ctml"
        }
        return e4("k", env, vS(gent), out)
    }
    if seq2(nm, "gui_sk_load") {
        // SL-7β2:编译期骨架 → GuiTree U 值(解释口径换源)。表以 vS/vI 节点包裹,
        // 与 gt_parse 解释执行的值形态同构(β3 发射口径 = 同名 C 静态构造,双口径同函数名)
        if vals.len != 0 {
            panic("gui_sk_load arity")
            return e4("a", env, vV2(), out)
        }
        var ntag = List[Str]()
        var nflag = List[Str]()
        var ncls = List[Str]()
        var npre = List[Str]()
        var nbid = List[Str]()
        var npost = List[Str]()
        var nfc = List[I32]()
        var ns = List[I32]()
        var nes = List[I32]()
        var nec = List[I32]()
        var ev_name = List[Str]()
        var ev_fn = List[Str]()
        var btns = List[I32]()
        var sk = List[Str]()
        var sv = List[Str]()
        var sk_props = List[Str]()
        gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, sk, sv, sk_props)
        var u = List[Str]()
        u.push("U")
        u.push("GuiTree")
        u.push("ntag")
        u.push(gui_sk_wrap_s(ntag))
        u.push("nflag")
        u.push(gui_sk_wrap_s(nflag))
        u.push("ncls")
        u.push(gui_sk_wrap_s(ncls))
        u.push("npre")
        u.push(gui_sk_wrap_s(npre))
        u.push("nbid")
        u.push(gui_sk_wrap_s(nbid))
        u.push("npost")
        u.push(gui_sk_wrap_s(npost))
        u.push("nfc")
        u.push(gui_sk_wrap_i(nfc))
        u.push("ns")
        u.push(gui_sk_wrap_i(ns))
        u.push("nes")
        u.push(gui_sk_wrap_i(nes))
        u.push("nec")
        u.push(gui_sk_wrap_i(nec))
        u.push("ev_name")
        u.push(gui_sk_wrap_s(ev_name))
        u.push("ev_fn")
        u.push(gui_sk_wrap_s(ev_fn))
        u.push("btns")
        u.push(gui_sk_wrap_i(btns))
        u.push("sk")
        u.push(gui_sk_wrap_s(sk))
        u.push("sv")
        u.push(gui_sk_wrap_s(sv))
        u.push("props")
        u.push(gui_sk_wrap_s(sk_props))
        return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(u) }, out)
    }
    if seq2(nm, "ctron_exe_path") {
        if vals.len != 0 {
            panic("ctron_exe_path arity")
            return e4("a", env, vV2(), out)
        }
        return e4("k", env, vS(ctron_exe_path()), out)
    }
    if seq2(nm, "env_get") {
        if vals.len == 1 {
            var r6 = v_unbox(vals[0])
            if r6.tag == 5 {
                return e4("k", env, vS(env_get(r6.s)), out)
            }
        }
        panic("env_get args")
        return e4("k", env, vS(""), out)
    }
    if seq2(nm, "ctron_cli_flag") {
        if vals.len == 1 {
            var r7 = v_unbox(vals[0])
            if r7.tag == 5 {
                return e4("k", env, vS(ctron_cli_flag(r7.s)), out)
            }
        }
        panic("ctron_cli_flag args")
        return e4("k", env, vS(""), out)
    }
    if seq2(nm, "utf8_enc") {
        if vals.len == 1 {
            var r8 = v_unbox(vals[0])
            if r8.tag == 1 {
                return e4("k", env, vS(utf8_enc(dvi_str(r8.iv.as[I32]()))), out)
            }
        }
        panic("utf8_enc arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "byte_at") {
        if vals.len == 2 {
            var r9 = v_unbox(vals[0])
            var r10 = v_unbox(vals[1])
            if r9.tag == 5 && r10.tag == 1 {
                return e4("k", env, vI(byte_at(r9.s, r10.iv.as[I32]())), out)
            }
        }
        panic("byte_at arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "byte_slice") {
        if vals.len == 3 {
            var r11 = v_unbox(vals[0])
            var r12 = v_unbox(vals[1])
            var r13 = v_unbox(vals[2])
            if r11.tag == 5 && r12.tag == 1 && r13.tag == 1 {
                var a2: I32 = r12.iv.as[I32]()
                var b2: I32 = r13.iv.as[I32]()
                if b2 < a2 {
                    panic("byte_slice: range out of bounds")
                }
                if a2 < 0 {
                    panic("byte_slice: range out of bounds")
                }
                return e4("k", env, vS(byte_slice(r11.s, a2, b2)), out)
            }
        }
        panic("byte_slice arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "ptr_as_view") {
        // 裸指针读(v0.9·五 ptr_as_view)解释口径响亮拒绝:解释器的值地址
        // 非 C ABI 对象地址;与指针形参同族口径,读通道走编译
        panic("ptr_as_view 解释口径:裸指针读不支持(编译通道)")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "str_from_c") {
        // Str 编组(§9.6 v0.6):解释域无 C 堆,编组为恒等;发射面为 arena 深拷
        if vals.len == 1 {
            var r14 = v_unbox(vals[0])
            if r14.tag == 5 {
                return e4("k", env, vS(r14.s), out)
            }
        }
        panic("str_from_c arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "errno") {
        if vals.len != 0 {
            panic("errno arity")
            return e4("a", env, vV2(), out)
        }
        return e4("i", env, vI(errno()), out)
    }
    if or2(seq2(nm, "clo_handle"), or2(seq2(nm, "clo_cb2"), seq2(nm, "clo_cb3"))) {
        // context-pointer 闭包糖(§9.6 v0.8):解释器口径拒绝(仅发射面)
        panic("clo_handle/clo_cb 仅原生口径可用(经 ctron-emit + cc 链接后运行)")
        return e4("a", env, vV2(), out)
    }
    if or2(seq2(nm, "dlopen"), or2(seq2(nm, "dlclose"), seq2(nm, "dlsym"))) {
        // 动态链接面(§9.6 v0.7):解释器口径拒绝(镜像 extern;经 ctron-emit + cc 后运行)
        panic("dlopen/dlsym 仅原生口径可用(经 ctron-emit + cc 链接后运行)")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "panic") {
        if vals.len == 1 {
            // §6.4 对齐:native ctron_panic 先印消息后展开——消息在 panic 点入 out
            //(流内位置一致);val 置空防 driver 末尾重印
            return e4("a", env, vV2(), out + fmt(v_unbox(vals[0])) + "\n")
        }
        panic("panic arity")
        return e4("a", env, vV2(), out)
    }
    if or2(seq2(nm, "Some"), or2(seq2(nm, "None"), or2(seq2(nm, "Ok"), seq2(nm, "Err")))) {
        var tv = List[Str]()
        tv.push("T")
        tv.push(nm)
        var qq: I32 = 0
        while qq < vals.len {
            tv.push(vals[qq])
            qq += 1
        }
        return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tv) }, out)
    }
    var evb = env_at(env, nm)
    if evb.len > 0 {
        var kv = v_unbox(evb[1])
        if kv.tag == 8 {
            if or2(seq2(cx_of(kv)[0], "C"), seq2(cx_of(kv)[0], "F")) {
                return call_cv(file, env, out, kv, vals)
            }
        }
    }
    var d = find_decl(file, nm)
    if d.len == 0 {
        var va = variant_arity(file, nm)
        if va >= 0 {
            if va == vals.len {
                var tv3 = List[Str]()
                tv3.push("T")
                tv3.push(nm)
                var q3: I32 = 0
                while q3 < vals.len {
                    tv3.push(vals[q3])
                    q3 += 1
                }
                return e4("k", env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tv3) }, out)
            }
            panic("variant arity:" + nm)
            return e4("a", env, vV2(), out)
        }
        // extern "c" 声明:W4 E1 解释口径直调桥(§11.5;I32/Bool/Str 标量子集,
        // 帧 "i:<int>"/"s:<str>";仅前 12 参;Void 返回 0;Str 返回暂缺随 E3 登记)。
        // dlsym 直调宿主进程链接符号(bin/ctron-cc 链 vendored 库;C 宿主未链 → 符号缺失错)
        if decl_node(file, "FnExt", nm).len > 0 {
            // 裸指针形参(v0.9·三 p<ec>)解释口径响亮拒绝:解释器的值地址不是
            // C ABI 对象地址,取址传过界不成立;指针通道走编译(run.sh 行为夹具
            // 的 bin run = 编译执行,不经此桥)
            var xdecl = decl_node(file, "FnExt", nm)
            var xk: I32 = 1
            while xk < xdecl[3].len {
                var xp = xdecl[3][xk]
                if xp[0] == "Param" && xp[3].len > 1 && xp[3][0] == "Ref" && xp[3][1].len > 0 && xp[3][1][0] != "Slice" {
                    panic("extern 解释口径:裸指针形参 &T 不支持(编译通道)")
                    return e4("i", env, vV2(), out)
                }
                xk += 1
            }
            var f0: Str = ""
            var f1: Str = ""
            var f2: Str = ""
            var f3: Str = ""
            var f4: Str = ""
            var f5: Str = ""
            var f6: Str = ""
            var f7: Str = ""
            var f8: Str = ""
            var f9: Str = ""
            var f10: Str = ""
            var f11: Str = ""
            var q: I32 = 0
            while q < vals.len {
                var xv = v_unbox(vals[q])
                var pl: Str = ""
                // T45 float 帧:浮形参按声明型驱动(F64→"f:"/F32→"g:",载荷 =
                // 解释器浮值文本,strtod/strtof 按声明位取近,边界语义与解释
                // 折叠一致);整型域新增 I64/U64 i 帧(long 传输,旧仅 I32)
                var ptn = xdecl[3][q + 1][3]
                if ptn[0] == "Named" && ptn[1] == "F64" {
                    if xv.tag != 6 {
                        panic("extern 解释口径:F64 形参须浮值")
                        return e4("i", env, vV2(), out)
                    }
                    pl = "f:" + xv.s
                } else {
                    if ptn[0] == "Named" && ptn[1] == "F32" {
                        if xv.tag != 6 {
                            panic("extern 解释口径:F32 形参须浮值")
                            return e4("i", env, vV2(), out)
                        }
                        pl = "g:" + xv.s
                    } else {
                        if xv.tag == 5 {
                            pl = "s:" + xv.s
                        } else {
                            if xv.tag == 4 {
                                if xv.b {
                                    pl = "i:1"
                                } else {
                                    pl = "i:0"
                                }
                            } else {
                                if xv.tag == 1 {
                                    pl = "i:" + dvi_str(xv.iv.as[I32]())
                                } else {
                                    if xv.tag == 2 {
                                        pl = "i:" + v6t(xv)
                                    } else {
                                        if xv.tag == 3 {
                                            pl = "i:" + v7t(xv)
                                        } else {
                                            panic("extern 解释口径:不支持参数类型 " + xv.tag.to_string())
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if q == 0 {
                    f0 = pl
                }
                if q == 1 {
                    f1 = pl
                }
                if q == 2 {
                    f2 = pl
                }
                if q == 3 {
                    f3 = pl
                }
                if q == 4 {
                    f4 = pl
                }
                if q == 5 {
                    f5 = pl
                }
                if q == 6 {
                    f6 = pl
                }
                if q == 7 {
                    f7 = pl
                }
                if q == 8 {
                    f8 = pl
                }
                if q == 9 {
                    f9 = pl
                }
                if q == 10 {
                    f10 = pl
                }
                if q == 11 {
                    f11 = pl
                }
                if q > 11 {
                    panic("extern 解释口径:参数超 12")
                }
                q += 1
            }
            // T45:返回别前缀(Ri:/Rf:/Rg:)按声明返回型;浮返 = fret 文本缓冲
            // 二次取回(D 码文本 Val);I64 返回升 long 全宽(旧 int 截断消)
            var rtn = xdecl[4]
            var retc = "i"
            if rtn[0] == "Named" && rtn[1] == "F64" {
                retc = "f"
            }
            if rtn[0] == "Named" && rtn[1] == "F32" {
                retc = "g"
            }
            var rr: I64 = ctron_ext_dispatch("R" + retc + ":" + nm, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11)
            if retc == "f" {
                return e4("k", env, Val { tag: 6, iv: 0, b: false, s: ctron_ext_fret() }, out)
            }
            if retc == "g" {
                return e4("k", env, Val { tag: 6, iv: 0, b: false, s: ctron_ext_fret() }, out)
            }
            if rtn[0] == "Named" && rtn[1] == "I64" {
                return e4("k", env, v6i(rr), out)
            }
            return e4("k", env, vI(rr.as[I32]()), out)
        }
        panic("no fn:" + nm)
        return e4("a", env, vV2(), out)
    }
    return call_decl_vals(file, env, out, d, vals)
}
// 变体载荷元数:非变体 → -1;KUnit → 0;KTuple → 类型个数
fn variant_arity(file: List[Str], nm: Str) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" {
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                var vt = vs[j]
                if seq2(vt[1], nm) {
                    var kd = vt[2]
                    if kd[0] == "KTuple" {
                        return kd.len - 1
                    }
                    return 0
                }
                j += 1
            }
        }
        i += 1
    }
    return 0 - 1
}
// T 快捷构造(枚举变体/Option/Result 值)
fn vT(vt: Str, p: Val) -> Val {
    var v = List[Str]()
    v.push("T")
    v.push(vt)
    v.push(v_box(p))
    return Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(v) }
}
// as[T]() 显式转换:浮转整截断;整窄化按宽度回绕;宽整型维持 I32 域
// 6 域显式转换(§3.6 窄化=截断):二补截断 = v mod 2^N(负数取数学模),
// 有符号目标再调回符号区间;8/16 位落 W 域,32 位落 I 域(镜像自举 U32=I32
// 存储口径,与编译侧回绕语义一致),64 位留在 6 域
fn conv_as_6(v: Val, tgt: Str) -> Val {
    var mag = c6can(v6t(v))
    var neg = false
    if mag.len > 0 {
        if byte_at(mag, 0) == 45 {
            neg = true
            mag = byte_slice(mag, 1, mag.len)
        }
    }
    var modv = ""
    var smax = ""
    var wl = ""
    if or2(tgt == "U8", tgt == "I8") {
        modv = "256"
        wl = "u8"
        if tgt == "I8" {
            wl = "i8"
            smax = "127"
        }
    }
    if or2(tgt == "U16", tgt == "I16") {
        modv = "65536"
        wl = "u16"
        if tgt == "I16" {
            wl = "i16"
            smax = "32767"
        }
    }
    if or2(tgt == "U32", tgt == "I32") {
        modv = "4294967296"
        wl = "i"
        if tgt == "I32" {
            smax = "2147483647"
        }
    }
    if or2(tgt == "I64", or2(tgt == "U64", or2(tgt == "ISize", tgt == "USize"))) {
        modv = "18446744073709551616"
        wl = "6"
        if or2(tgt == "I64", tgt == "ISize") {
            smax = "9223372036854775807"
        }
    }
    if modv.len == 0 {
        if or2(tgt == "F64", tgt == "F32") {
            return vD(df_can(v6t(v)))
        }
        return v
    }
    var qr = c6divmod(mag, modv)
    var bar = 0
    var ci = 0
    while ci < qr.len {
        if byte_at(qr, ci) == 124 {
            bar = ci
        }
        ci += 1
    }
    var m = byte_slice(qr, bar + 1, qr.len)
    if neg {
        if m != "0" {
            m = c6sub(modv, m)
        }
    }
    if smax.len > 0 {
        if c6abscmp(m, smax) > 0 {
            m = c6sub(m, modv)
        }
    }
    if wl == "i" {
        return vI(dvi(m))
    }
    if wl == "6" {
        // U64/USize 目标(P1-B):产 "7" 无符号域;I64/ISize 仍 "6"
        if or2(tgt == "U64", tgt == "USize") {
            return v7(c6can(m))
        }
        return v6(c6can(m))
    }
    return vW(wl, dvi(m))
}

fn conv_as(v: Val, tgt: Str) -> Val {
    if or2(v.tag == 2, v.tag == 3) {
        return conv_as_6(v, tgt)
    }
    if or2(tgt == "U64", tgt == "USize") {
        // X.as[U64]/as[USize]:任意源经 6 域模 2^64 路径(P1-B)
        return conv_as_6(v, tgt)
    }
    if or2(tgt == "F64", tgt == "F32") {
        if or2(v.tag == 1, v.tag == 7) {
            return vD(df_can(dvi_str(v.iv.as[I32]())))
        }
        return v
    }
    if or2(tgt == "U8", or2(tgt == "I8", or2(tgt == "U16", tgt == "I16"))) {
        var wl = "u8"
        if tgt == "I8" {
            wl = "i8"
        }
        if tgt == "U16" {
            wl = "u16"
        }
        if tgt == "I16" {
            wl = "i16"
        }
        var iv = 0
        if v.tag == 6 {
            iv = d_intpart(v.s)
        } else {
            iv = v.iv.as[I32]()
        }
        var s: I32 = 1
        var k: I32 = 0
        while k < w_bits(wl) {
            s = s * 2
            k += 1
        }
        var m = iv % s
        if m < 0 {
            m += s
        }
        if w_signed(wl) && m > w_max(wl) {
            m -= s
        }
        return vW(wl, m)
    }
    if v.tag == 6 {
        return vI(d_intpart(v.s))
    }
    if v.tag == 7 {
        return vI(v.iv.as[I32]())
    }
    return v
}
// 十进制定点文本 → 截断整数(取小数点前)
fn d_intpart(t: Str) -> I32 {
    var i: I32 = 0
    var n = t.len
    while i < n {
        if byte_at(t, i) == 46 {
            n = i
        }
        i += 1
    }
    return dvi(byte_slice(t, 0, n))
}
// parallel.map/reduce(顺序化:闭包逐元素即刻执行)
fn ns_map_reduce(file: List[Str], ob: Flow, vals: List[Str], ismap: Bool) -> Flow {
    var av = v_unbox(vals[0])
    if !(av.tag == 8) {
        panic("parallel target")
        return e4("a", ob.env, vV2(), ob.out)
    }
    if !or2(seq2(cx_of(av)[0], "A"), seq2(cx_of(av)[0], "L")) {
        panic("parallel target")
        return e4("a", ob.env, vV2(), ob.out)
    }
    if ismap {
        var outv = List[Str]()
        outv.push(cx_of(av)[0])
        var i: I32 = 1
        while i < cx_of(av).len {
            var fa = List[Str]()
            fa.push(cx_of(av)[i])
            var er = call_cv(file, ob.env, ob.out, v_unbox(vals[1]), fa)
            if er.kind != "k" {
                return er
            }
            outv.push(v_box(er.v))
            i += 1
        }
        return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(outv) }, ob.out)
    }
    var acc = v_unbox(vals[1])
    var i2: I32 = 1
    while i2 < cx_of(av).len {
        var fa2 = List[Str]()
        fa2.push(v_box(acc))
        fa2.push(cx_of(av)[i2])
        var er2 = call_cv(file, ob.env, ob.out, v_unbox(vals[2]), fa2)
        if er2.kind != "k" {
            return er2
        }
        acc = er2.v
        i2 += 1
    }
    return e4("k", ob.env, acc, ob.out)
}
// UTF-8 续字节:0x80..0xBF
fn utf8_cont(s: Str, k: I32) -> Bool {
    var c = byte_at(s, k)
    return c >= 128 && c < 192
}
// 子串包含(朴素匹配)
fn str_contains(s: Str, sub: Str) -> Bool {
    var n = s.len
    var m = sub.len
    if m == 0 {
        return true
    }
    var i: I32 = 0
    while i + m <= n {
        var j: I32 = 0
        var ok = true
        while j < m && ok {
            if byte_at(s, i + j) != byte_at(sub, j) {
                ok = false
            }
            j += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}
// Option/Result 组合子(recv = T 复合值;cx 位面 ["T", 变体, 载荷?])
fn call_mem(file: List[Str], env: List[Str], out: Str, cal: List[Str], vals: List[Str]) -> Flow {
    var ob = eval_expr(file, env, out, cal[1])
    if ob.kind != "k" {
        return ob
    }
    var recv = ob.v
    var m = cal[3]
    // StringBuilder(§3.8.2;T03):须先于通用 to_string 分支
    if recv.tag == 8 {
        if seq2(cx_of(recv)[0], "SB") {
            if seq2(m, "push_str") && vals.len == 1 {
                var sv = v_unbox(vals[0])
                if sv.tag != 5 {
                    panic("push_str 需 Str")
                }
                cx_of(recv).push(sv.s)
                return e4("k", ob.env, vV2(), ob.out)
            }
            if seq2(m, "to_string") && vals.len == 0 {
                var acc = ""
                var si: I32 = 1
                while si < cx_of(recv).len {
                    acc = acc + cx_of(recv)[si]
                    si += 1
                }
                return e4("k", ob.env, vS(acc), ob.out)
            }
            panic("StringBuilder 方法:" + m)
            return e4("a", ob.env, vV2(), ob.out)
        }
    }
    if seq2(m, "to_string") {
        if vals.len == 0 {
            return e4("k", ob.env, vS(fmt(recv)), ob.out)
        }
        panic("to_string arity")
        return e4("a", env, vV2(), out)
    }
    // T26 Env 进程环境能力对象(§8.1;R-P2b 锚 07b):Env.system() 构造宿主
    // 环境句柄;get 缺失=None;args=进程参数表(ctron_prog_args_* 运行时底座)
    if recv.tag == 8 {
        var erc26 = cx_of(recv)
        if seq2(erc26[0], "NS") && seq2(erc26[1], "Env") && seq2(m, "system") && vals.len == 0 {
            var ehv26 = List[Str]()
            ehv26.push("NS")
            ehv26.push("EnvHandle")
            return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(ehv26) }, ob.out)
        }
        if seq2(erc26[0], "NS") && seq2(erc26[1], "EnvHandle") {
            if seq2(m, "get") && vals.len == 1 {
                var gkv26 = v_unbox(vals[0])
                if gkv26.tag != 5 {
                    panic("Env.get 需 Str")
                }
                var gev26 = env_get(gkv26.s)
                if gev26.len == 0 {
                    var gnv26 = List[Str]()
                    gnv26.push("T")
                    gnv26.push("None")
                    return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(gnv26) }, ob.out)
                }
                var gsv26 = List[Str]()
                gsv26.push("T")
                gsv26.push("Some")
                var gpl26 = vS(gev26)
                gsv26.push(v_box(gpl26))
                return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(gsv26) }, ob.out)
            }
            if seq2(m, "args") && vals.len == 0 {
                // List 值:L 记录 + 逐项 boxed(元素面=v_box(vS(...)))
                var gav26 = List[Str]()
                gav26.push("L")
                var gna26: I64 = ctron_prog_args_n()
                var gai26: I64 = 0
                while gai26 < gna26 {
                    var giv26 = vS(ctron_prog_args_at(gai26))
                    gav26.push(v_box(giv26))
                    gai26 += 1
                }
                return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(gav26) }, ob.out)
            }
            panic("Env 方法:" + m)
            return e4("a", ob.env, vV2(), ob.out)
        }
    }
    // 并发域(顺序化模拟:spawn 即刻完整执行;结果与调度无关的测试面)
    if recv.tag == 8 {
        if seq2(cx_of(recv)[0], "SCOPE") && seq2(m, "spawn") && vals.len == 1 {
            var noargs = List[Str]()
            var sr = call_cv(file, ob.env, ob.out, v_unbox(vals[0]), noargs)
            // sr.out 已含 ob.out(out 累加器透传),不得再拼 ob.out(曾致前置输出重放)
            var tk = List[Str]()
            tk.push("TASK")
            if sr.kind == "a" {
                tk.push("P")
                tk.push(v_box(sr.v))
            } else {
                tk.push("K")
                tk.push(v_box(sr.v))
            }
            return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tk) }, sr.out)
        }
        if seq2(cx_of(recv)[0], "TASK") && seq2(m, "join") && vals.len == 0 {
            if seq2(cx_of(recv)[1], "P") {
                return e4("a", ob.env, v_unbox(cx_of(recv)[2]), ob.out)
            }
            return e4("k", ob.env, v_unbox(cx_of(recv)[2]), ob.out)
        }
        if seq2(cx_of(recv)[0], "TASK") && seq2(m, "join_or") && vals.len == 0 {
            var jr = List[Str]()
            jr.push("T")
            if seq2(cx_of(recv)[1], "P") {
                jr.push("Err")
                jr.push(v_box(vS("task panic")))
            } else {
                jr.push("Ok")
                jr.push(cx_of(recv)[2])
            }
            return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(jr) }, ob.out)
        }
        if or2(seq2(cx_of(recv)[0], "MUX"), seq2(cx_of(recv)[0], "M")) && or2(seq2(m, "with_mut"), seq2(m, "with")) && vals.len == 1 {
            var fa2 = List[Str]()
            if seq2(cx_of(recv)[0], "M") && seq2(m, "with_mut") {
                fa2.push(v_box(recv))
                return call_cv(file, ob.env, ob.out, v_unbox(vals[0]), fa2)
            }
            fa2.push(cx_of(recv)[1])
            // MUX with_mut 写回=Rust 宿主对齐语义(interp.rs MutexInst:拷入+终值回写)。
            // 旧径直调 call_cv 丢 cenv,形参终值不可达——标量内值复合赋值走 Assign
            // 重绑路径,共享内值盒不换槽,写即丢(main 树 Mutex[I32] 直读丢写实证,
            // emit *t_c+=7 同形可见=双臂分歧)。此处内联闭包调用取 cenv 终值回写
            // MUX 载荷槽;struct 内值既有 u_set_ip 原地写穿面不变(回写同盒=恒等)
            if seq2(m, "with") {
                return call_cv(file, ob.env, ob.out, v_unbox(vals[0]), fa2)
            }
            var wcv = v_unbox(vals[0])
            if !(wcv.tag == 8 && seq2(cx_of(wcv)[0], "C")) {
                return call_cv(file, ob.env, ob.out, wcv, fa2)
            }
            var wc = cx_of(wcv)
            var wnenv = wc[3]
            var wps = wc[1]
            if wps.len > 1 {
                wnenv = env_add(wnenv, wps[1][2], v_unbox(fa2[0]))
            }
            var wbr = eval_expr(file, wnenv, ob.out, wc[2])
            if seq2(wbr.kind, "k") && wps.len > 1 {
                var wpe = env_at(wbr.env, wps[1][2])
                if wpe.len > 1 && cal[1][0] == "Ident" {
                    // 写回双路并施(引擎语义劈叉实证):①env_at 绑定盒槽原地换=
                    // native 双形态(直用+捕获共享 cap)传播路;②env_set 流换绑=
                    // seed×cc_run 直用形唯一传播路(seed 的 Flow struct 拷贝深克
                    // 隆 cx 列表,槽写落克隆体=S1 在册「cx 包装表」同族;捕获形
                    // seed 不可达=cap 在调用间不回写,旧账维持登记)。env_set 换
                    // 绑时未触条目按对象共享,双写幂等一致
                    var wnm = cal[1][1]
                    var wen = env_at(env, wnm)
                    if wen.len > 1 {
                        wen[1][1] = wpe[1]
                    }
                    var wmx = List[Str]()
                    wmx.push("MUX")
                    wmx.push(wpe[1])
                    var wfl = "k"
                    if wbr.kind == "a" {
                        wfl = "a"
                    }
                    return e4(wfl, env_set(env, wnm, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(wmx) }), wbr.v, wbr.out)
                }
            }
            var wfl2 = "k"
            if wbr.kind == "a" {
                wfl2 = "a"
            }
            return e4(wfl2, ob.env, wbr.v, wbr.out)
        }
        if seq2(cx_of(recv)[0], "M") && seq2(m, "fetch_add") && vals.len == 1 {
            var oldm = v_unbox(cx_of(recv)[1])
            var rcx = cx_of(recv)
            rcx[1] = v_box(val_arith("Add", oldm, v_unbox(vals[0])))
            return e4("k", ob.env, oldm, ob.out)
        }
        if seq2(cx_of(recv)[0], "NS") && seq2(cx_of(recv)[1], "dom") {
            // web 档(§9.2)stdweb.dom 最小 API;标题/体存 env 保留名(运行态无全局通道)
            if seq2(m, "set_title") && vals.len == 1 {
                // upsert:env_set 只换已存在键,首写须 env_add
                var dk = env_at(env, "#dom:title")
                var denv = env
                if dk.len > 0 {
                    denv = env_set(env, "#dom:title", v_unbox(vals[0]))
                } else {
                    denv = env_add(env, "#dom:title", v_unbox(vals[0]))
                }
                return e4("k", denv, vV2(), out)
            }
            if seq2(m, "title") && vals.len == 0 {
                var te = env_at(env, "#dom:title")
                var tv = vS("")
                if te.len > 1 {
                    tv = v_unbox(te[1])
                }
                return e4("k", env, tv, out)
            }
            // T39 第二面:dom.set_body/body(与 title 同构,env 键 "#dom:body")
            if seq2(m, "set_body") && vals.len == 1 {
                var bk = env_at(env, "#dom:body")
                var benv = env
                if bk.len > 0 {
                    benv = env_set(env, "#dom:body", v_unbox(vals[0]))
                } else {
                    benv = env_add(env, "#dom:body", v_unbox(vals[0]))
                }
                return e4("k", benv, vV2(), out)
            }
            if seq2(m, "body") && vals.len == 0 {
                var be = env_at(env, "#dom:body")
                var bv = vS("")
                if be.len > 1 {
                    bv = v_unbox(be[1])
                }
                return e4("k", env, bv, out)
            }
            panic("dom 方法:" + m)
            return e4("a", env, vV2(), out)
        }
        if seq2(cx_of(recv)[0], "NS") && seq2(cx_of(recv)[1], "bit") {
            // T01 bit.* 域:ob 适配旧 e4 形(ns_bit 内部读 ob[1]/ob[3]);ns_bit 内部
            // 调用的 vI/v6/vB/e4 在 S1 后类型自洽,返回即 Flow
            var obold = List[Str]()
            obold.push(ob.kind)
            obold.push(ob.env)
            obold.push(v_box(ob.v))
            obold.push(ob.out)
            return ns_bit(m, vals, obold)
        }
        if seq2(cx_of(recv)[0], "NS") && seq2(m, "map") && vals.len == 2 {
            return ns_map_reduce(file, ob, vals, true)
        }
        if seq2(cx_of(recv)[0], "NS") && seq2(m, "reduce") && vals.len == 3 {
            return ns_map_reduce(file, ob, vals, false)
        }
        if seq2(cx_of(recv)[0], "CH") && seq2(m, "send") && vals.len == 1 {
            var capn = v_unbox(cx_of(recv)[3]).iv.as[I32]()
            var chq = cx_of(recv)[1]
            if capn >= 0 && chq.len >= capn {
                return e4("k", ob.env, vT("Err", vS("ScopeCancelled")), ob.out)
            }
            // T14②:struct 值语义=入箱即克隆(镜像 bind_of;发射臂 send 点堆盒拷贝
            // 同判),源端改后接收端不变;List/M/类保持引用(bind_of 同口径)
            chq.push(v_box(bind_of(file, v_unbox(vals[0]))))
            return e4("k", ob.env, vT("Ok", vV2()), ob.out)
        }
        if seq2(cx_of(recv)[0], "CH") && seq2(m, "recv") && vals.len == 0 {
            var cur = cx_of(recv)[2]
            var q2 = cx_of(recv)[1]
            var idx = dvi(cur[1])
            if idx >= q2.len {
                return e4("k", ob.env, vT("Err", vS("ScopeCancelled")), ob.out)
            }
            cur[1] = (idx + 1).to_string()
            return e4("k", ob.env, vT("Ok", v_unbox(q2[idx])), ob.out)
        }
        if seq2(cx_of(recv)[0], "SIMD") && seq2(m, "splat") && vals.len == 1 {
            var vc = List[Str]()
            vc.push("VEC")
            var n = dvi(cx_of(recv)[2])
            var vi: I32 = 0
            while vi < n {
                vc.push(v_box(v_unbox(vals[0])))
                vi += 1
            }
            return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(vc) }, ob.out)
        }
        if seq2(cx_of(recv)[0], "VEC") && seq2(m, "lane") && vals.len == 1 {
            var li = v_unbox(vals[0]).iv.as[I32]()
            return e4("k", ob.env, v_unbox(cx_of(recv)[li + 1]), ob.out)
        }
        if seq2(cx_of(recv)[0], "VEC") && seq2(m, "to_array") && vals.len == 0 {
            var arr2 = List[Str]()
            arr2.push("A")
            var ai: I32 = 1
            while ai < cx_of(recv).len {
                arr2.push(cx_of(recv)[ai])
                ai += 1
            }
            return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(arr2) }, ob.out)
        }
        if seq2(cx_of(recv)[0], "T") {
            if seq2(m, "or") && vals.len == 1 {
                if or2(seq2(cx_of(recv)[1], "Some"), seq2(cx_of(recv)[1], "Ok")) {
                    if cx_of(recv).len == 3 {
                        return e4("k", ob.env, v_unbox(cx_of(recv)[2]), ob.out)
                    }
                    return e4("k", ob.env, recv, ob.out)
                }
                return e4("k", ob.env, v_unbox(vals[0]), ob.out)
            }
            if seq2(m, "expect") && vals.len == 1 {
                var ev = v_unbox(vals[0])
                if ev.tag == 5 {
                    if or2(seq2(cx_of(recv)[1], "Some"), seq2(cx_of(recv)[1], "Ok")) {
                        if cx_of(recv).len == 3 {
                            return e4("k", ob.env, v_unbox(cx_of(recv)[2]), ob.out)
                        }
                        return e4("k", ob.env, recv, ob.out)
                    }
                    return e4("a", ob.env, vS(ev.s), ob.out)
                }
            }
            if seq2(m, "is_some") && vals.len == 0 {
                return e4("k", ob.env, vB(or2(seq2(cx_of(recv)[1], "Some"), seq2(cx_of(recv)[1], "Ok"))), ob.out)
            }
            if seq2(m, "map") && vals.len == 1 {
                if seq2(cx_of(recv)[1], "Some") && cx_of(recv).len == 3 {
                    var fa = List[Str]()
                    fa.push(cx_of(recv)[2])
                    var mr = call_cv(file, ob.env, ob.out, v_unbox(vals[0]), fa)
                    if mr.kind != "k" {
                        return mr
                    }
                    var tv = List[Str]()
                    tv.push("T")
                    tv.push("Some")
                    tv.push(v_box(mr.v))
                    return e4("k", mr.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tv) }, mr.out)
                }
                return e4("k", ob.env, recv, ob.out)
            }
            if seq2(m, "context") && vals.len == 1 {
                var ev2 = v_unbox(vals[0])
                if ev2.tag == 5 {
                    if seq2(cx_of(recv)[1], "Err") {
                        var p = recv
                        if cx_of(recv).len == 3 {
                            p = v_unbox(cx_of(recv)[2])
                        }
                        var cs = List[Str]()
                        cs.push("T")
                        cs.push("Some")
                        cs.push(v_box(p))
                        var eb = List[Str]()
                        eb.push("U")
                        eb.push("AnyError")
                        eb.push("message")
                        eb.push(v_box(vS(ev2.s)))
                        eb.push("cause")
                        eb.push(v_box(Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(cs) }))
                        eb.push("trace")
                        var trl = List[Str]()
                        trl.push("L")
                        trl.push(v_box(vS("ctx:" + ev2.s)))
                        eb.push(v_box(Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(trl) }))
                        var te = List[Str]()
                        te.push("T")
                        te.push("Err")
                        te.push(v_box(Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(eb) }))
                        return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(te) }, ob.out)
                    }
                    return e4("k", ob.env, recv, ob.out)
                }
            }
        }
        if seq2(cx_of(recv)[0], "U") && seq2(m, "eq") {
            // @derive(Eq)(§3d):结构接收者逐字段相等(守卫拆嵌套:索引不得入急切复合条件)
            if vals.len == 1 {
                var ov2 = v_unbox(vals[0])
                if ov2.tag == 8 {
                    if seq2(cx_of(ov2)[0], "U") {
                        return e4("k", ob.env, vB(eq_val(recv, ov2)), ob.out)
                    }
                }
            }
            panic("eq 需同型结构实参")
            return e4("a", env, vV2(), out)
        }
        if seq2(cx_of(recv)[0], "U") && seq2(m, "show") && vals.len == 0 {
            return e4("k", ob.env, vS(fmt(recv)), ob.out)
        }
        // C9f②:类实例方法/trait 默认方法(镜像 rt.c V_STRUCT&&is_class 先于 UFCS;
        // 类找不到方法直接 panic,不落 UFCS)
        if seq2(cx_of(recv)[0], "U") {
            // impl 方法:类实例与 struct 值统一走 impl 分派(§4.8;struct 曾漏,
            // 落 UFCS 找不到 impl 内方法即运行期失败)
            var mth = find_impl_method(file, cx_of(recv)[1], m)
            if mth.len > 0 {
                return call_method_vals(file, ob.env, ob.out, mth, cx_of(recv), vals)
            }
            if is_class(file, cx_of(recv)[1]) {
                panic("unknown method:" + m)
                return e4("a", env, vV2(), out)
            }
        }
    }
    if seq2(m, "slice") {
        if vals.len == 1 && recv.tag == 5 {
            var rv = v_unbox(vals[0])
            if rv.tag == 8 && seq2(cx_of(rv)[0], "R") {
                var lo = v_unbox(cx_of(rv)[2]).iv.as[I32]()
                var hi = v_unbox(cx_of(rv)[3]).iv.as[I32]()
                if seq2(cx_of(rv)[1], "true") {
                    hi += 1
                }
                var ln = recv.s.len
                // UTF-8 边界(§3.3):切点不得落在续字节上
                if lo > 0 && lo < ln && utf8_cont(recv.s, lo) {
                    return e4("a", ob.env, vS("invalid utf8 boundary"), ob.out)
                }
                if hi > 0 && hi < ln && utf8_cont(recv.s, hi) {
                    return e4("a", ob.env, vS("invalid utf8 boundary"), ob.out)
                }
                if lo < 0 {
                    lo = 0
                }
                if hi > ln {
                    hi = ln
                }
                if hi < lo {
                    hi = lo
                }
                return e4("k", ob.env, vS(byte_slice(recv.s, lo, hi)), ob.out)
            }
        }
        panic("slice args")
        return e4("a", env, vV2(), out)
    }
        if seq2(m, "contains") && recv.tag == 5 && vals.len == 1 {
            // §3.8.2 Str.contains(T09 夹具踩中补齐;此前仅 List.contains)
            var sv2 = v_unbox(vals[0])
            if sv2.tag != 5 {
                panic("contains 需 Str")
            }
            return e4("k", ob.env, vB(str_contains(recv.s, sv2.s)), ob.out)
        }
    if recv.tag == 8 {
        if seq2(m, "load") {
            if seq2(cx_of(recv)[0], "M") && vals.len == 0 {
                return e4("k", ob.env, v_unbox(cx_of(recv)[1]), ob.out)
            }
        }
        if seq2(m, "store") {
            if seq2(cx_of(recv)[0], "M") && vals.len == 1 {
                var srcx = cx_of(recv)
                srcx[1] = v_box(v_unbox(vals[0]))
                return e4("k", ob.env, vV2(), ob.out)
            }
        }
        if seq2(m, "push") {
            if seq2(cx_of(recv)[0], "L") && vals.len == 1 {
                cx_of(recv).push(v_box(v_unbox(vals[0])))
                return e4("k", ob.env, vV2(), ob.out)
            }
        }
        if seq2(m, "into_gc") {
            if seq2(cx_of(recv)[0], "L") && vals.len == 0 {
                return e4("k", ob.env, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(vdeep(cx_of(recv))) }, ob.out)
            }
        }
        if seq2(m, "contains") && seq2(cx_of(recv)[0], "L") && vals.len == 1 {
            var fnd2 = false
            var li: I32 = 1
            var ov3 = v_unbox(vals[0])
            while li < cx_of(recv).len && !fnd2 {
                var el = v_unbox(cx_of(recv)[li])
                if el.tag == 5 {
                    if str_contains(el.s, fmt(ov3)) {
                        fnd2 = true
                    }
                } else {
                    if el.tag == 8 {
                        if seq2(cx_of(el)[0], "L") {
                            if str_contains(fmt(el), fmt(ov3)) {
                                fnd2 = true
                            }
                        } else {
                            if veq(el, ov3) {
                                fnd2 = true
                            }
                        }
                    } else {
                        if veq(el, ov3) {
                            fnd2 = true
                        }
                    }
                }
                li += 1
            }
            return e4("k", ob.env, vB(fnd2), ob.out)
        }
    }
    var ddx = find_decl(file, m)
    if ddx.len > 0 {
        var fvv = List[Str]()
        fvv.push(v_box(recv))
        var qq: I32 = 0
        while qq < vals.len {
            fvv.push(vals[qq])
            qq += 1
        }
        return call_decl_vals(file, ob.env, ob.out, ddx, fvv)
    }
    panic("method:" + m)
    return e4("a", env, vV2(), out)
}
fn eval_call(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> Flow {
    var ag = e[2]
    var vals = List[Str]()
    var env2 = env
    var out2 = out
    var i: I32 = 1
    while i < ag.len {
        var ar = eval_expr(file, env2, out2, ag[i])
        if ar.kind != "k" {
            return ar
        }
        env2 = ar.env
        out2 = ar.out
        vals.push(v_box(ar.v))
        i += 1
    }
    var cal = e[1]
    if cal[0] == "Ident" {
        return call_id(file, env2, out2, cal[1], vals)
    }
    if cal[0] == "Member" {
        return call_mem(file, env2, out2, cal, vals)
    }
    // C9f①:List 构造 List[T]()(rt.c:同参忽略,恒空表;arena.list[T]() 同)
    if cal[0] == "TypeArgs" {
        var base = cal[1]
        // as[T]() 显式转换(窄化截断,浮转整截断)
        if base[0] == "Member" && seq2(base[3], "as") {
            var ar = eval_expr(file, env2, out2, base[1])
            if ar.kind != "k" {
                return ar
            }
            var tgt = ""
            if cal[2].len > 1 {
                tgt = ty_head(cal[2][1])
            }
            return e4("k", ar.env, conv_as(ar.v, tgt), ar.out)
        }
        if base[0] == "Ident" && seq2(base[1], "Channel") {
            var cap = vals[0]
            var q = List[Str]()
            var cur = List[Str]()
            cur.push("M")
            cur.push("0")
            var tx = List[Str]()
            tx.push("CH")
            tx.push(q)
            tx.push(cur)
            tx.push(cap)
            var rx = List[Str]()
            rx.push("CH")
            rx.push(q)
            rx.push(cur)
            rx.push(cap)
            var pr = List[Str]()
            pr.push("P")
            pr.push(v_box(Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(tx) }))
            pr.push(v_box(Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(rx) }))
            return e4("k", env2, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(pr) }, out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Global") {
            var gv = List[Str]()
            gv.push("M")
            if vals.len > 1 {
                gv.push(vals[1])
            } else {
                gv.push(v_box(vV2()))
            }
            return e4("k", env2, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(gv) }, out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Box") {
            var bv = List[Str]()
            bv.push("BOX")
            if vals.len > 0 {
                bv.push(vals[0])
            } else {
                bv.push(v_box(vV2()))
            }
            return e4("k", env2, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(bv) }, out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Mutex") {
            var mx = List[Str]()
            mx.push("MUX")
            if vals.len > 0 {
                mx.push(vals[0])
            } else {
                mx.push(v_box(vV2()))
            }
            return e4("k", env2, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(mx) }, out2)
        }
        var islist = false
        if base[0] == "Ident" && seq2(base[1], "List") {
            islist = true
        }
        if base[0] == "Member" && seq2(base[2], "Nm") && seq2(base[3], "list") && base[1][0] == "Ident" && seq2(base[1][1], "arena") {
            islist = true
        }
        if islist {
            return e4("k", env2, vL(), out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Atomic") {
            var mv = List[Str]()
            mv.push("M")
            if vals.len > 0 {
                mv.push(vals[0])
            } else {
                mv.push(v_box(vV2()))
            }
            return e4("k", env2, Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(mv) }, out2)
        }
        // 泛型 fn 调用(显式 TypeArgs):擦除型参,按名动态派发
        if base[0] == "Ident" {
            return call_id(file, env, out, base[1], vals)
        }
    }
    panic("call target")
    return e4("a", env, vV2(), out)
}

// ---------------- bit.* 位运算内建命名空间(§4.5;T01) ----------------
// 文本域按位组合:and/or/xor/not 补码语义、shl 回绕、shr 有符号算术/无符号逻辑;
// 移位数越界 [0, 宽度) → panic "bit shift range"(检查哲学与索引/溢出一致)。
// 2^k 文本(k ≤ 64)
fn bit_p2(k: I32) -> Str {
    var r = "1"
    var i: I32 = 0
    while i < k {
        r = c6add(r, r)
        i += 1
    }
    return r
}
// c6divmod 输出 "q|r" 拆解(取商/取余)
fn bit_quot(qr: Str) -> Str {
    var i: I32 = 0
    while i < qr.len {
        if byte_at(qr, i) == 124 {
            return c6can(byte_slice(qr, 0, i))
        }
        i += 1
    }
    return "0"
}
fn bit_rest(qr: Str) -> Str {
    var i: I32 = 0
    while i < qr.len {
        if byte_at(qr, i) == 124 {
            return c6can(byte_slice(qr, i + 1, qr.len))
        }
        i += 1
    }
    return "0"
}
// 值文本 → 宽度 bits 无符号量级文本(负数按 2^bits 补;越界 mod 折)
fn bit_umag(t: Str, bits: I32) -> Str {
    var neg = false
    var m = t
    if t.len > 0 && byte_at(t, 0) == 45 {
        neg = true
        m = byte_slice(t, 1, t.len)
    }
    var qr = c6divmod(c6can(m), bit_p2(bits))
    m = bit_rest(qr)
    if neg && m != "0" {
        m = c6sub(bit_p2(bits), m)
    }
    return m
}
// 无符号量级 → 按符号折叠回值文本(有符号高位 → 负)
fn bit_sfold(u: Str, bits: I32, signed: Bool) -> Str {
    if signed && c6abscmp(u, bit_p2(bits - 1)) >= 0 {
        return c6sub(u, bit_p2(bits))
    }
    return u
}
// 逐位组合:a/b 非负文本(< 2^bits);mode 0=and 1=or 2=xor
fn bit_comb(bits: I32, a: Str, b: Str, mode: I32) -> Str {
    var aa = a
    var bb = b
    var acc = "0"
    var pw = "1"
    var i: I32 = 0
    while i < bits {
        if aa == "0" {
            if mode == 0 {
                // and:剩余位恒 0,直接累计完毕
                return acc
            }
            if aa == "0" && bb == "0" {
                // or/xor:双方剩余位全 0,直接完成(高位零值早退,省满 64 轮)
                return acc
            }
        }
        var qa = c6divmod(aa, "2")
        var qb = c6divmod(bb, "2")
        var on = false
        var b1 = bit_rest(qa) == "1"
        var b2 = bit_rest(qb) == "1"
        if mode == 0 {
            on = b1 && b2
        }
        if mode == 1 {
            on = b1 || b2
        }
        if mode == 2 {
            on = b1 != b2
        }
        if on {
            acc = c6add(acc, pw)
        }
        aa = bit_quot(qa)
        bb = bit_quot(qb)
        pw = c6add(pw, pw)
        i += 1
    }
    return acc
}
fn bit_width(w: Str) -> I32 {
    if w == "i32" || w == "u32" {
        return 32
    }
    return 64
}
fn bit_signed(w: Str) -> Bool {
    return w == "i32" || w == "i64"
}
// 结果构造:入参 t 对有符号宽(i32/i64)为已折叠有符号文本,u32 为无符号幅值
// (此处折有符号 32 表示——解释器 u32 惯例:4294967295 存 -1),u64 为无符号幅值(7 域)
fn bit_ret(w: Str, u: Str, ob: List[Str]) -> Flow {
    if seq2(w, "i32") {
        return e4("k", ob[1], vI(dvi(u)), ob[3])
    }
    if seq2(w, "u32") {
        return e4("k", ob[1], v6(bit_sfold(u, 32, true)), ob[3])
    }
    if seq2(w, "i64") {
        return e4("k", ob[1], v6(u), ob[3])
    }
    return e4("k", ob[1], v7(u), ob[3])
}
// bit.* 入口:方法名 = op_width;and/or/xor/not/shl/shr × i32/u32/i64/u64
fn ns_bit(m: Str, vals: List[Str], ob: List[Str]) -> Flow {
    if vals.len < 1 {
        panic("bit 实参")
    }
    if or2(vals[0][0] == "I", or2(vals[0][0] == "6", or2(vals[0][0] == "7", vals[0][0] == "W"))) {
    } else {
        panic("bit 数值:" + vals[0][0])
    }
    var us = m.len
    var ui: I32 = 0
    while ui < m.len {
        if byte_at(m, ui) == 95 {
            us = ui
            break
        }
        ui += 1
    }
    var op = byte_slice(m, 0, us)
    var w = byte_slice(m, us + 1, m.len)
    if or2(w == "i32", or2(w == "u32", or2(w == "i64", w == "u64"))) {
    } else {
        panic("bit 宽度:" + w)
    }
    var bits = bit_width(w)
    var sgn = bit_signed(w)
    var t1 = vals[0][1]
    if or2(seq2(op, "and"), or2(seq2(op, "or"), seq2(op, "xor"))) {
        if vals.len < 2 {
            panic("bit 实参")
        }
        var md: I32 = 2
        if seq2(op, "and") {
            md = 0
        }
        if seq2(op, "or") {
            md = 1
        }
        var uc = bit_comb(bits, bit_umag(t1, bits), bit_umag(vals[1][1], bits), md)
        return bit_ret(w, bit_sfold(uc, bits, sgn), ob)
    }
    if seq2(op, "not") {
        var un = bit_comb(bits, bit_umag(t1, bits), c6sub(bit_p2(bits), "1"), 2)
        return bit_ret(w, bit_sfold(un, bits, sgn), ob)
    }
    if or2(seq2(op, "shl"), seq2(op, "shr")) {
        if vals.len < 2 {
            panic("bit 实参")
        }
        var n = dvi(vals[1][1])
        if n < 0 || n >= bits {
            panic("bit shift range")
        }
        var txt2 = ""
        if seq2(op, "shl") {
            var u2 = c6mul(bit_umag(t1, bits), bit_p2(n))
            var qsh = c6divmod(u2, bit_p2(bits))
            txt2 = bit_sfold(bit_rest(qsh), bits, sgn)
        }
        if seq2(op, "shr") {
            if !sgn {
                var ql = c6divmod(bit_umag(t1, bits), bit_p2(n))
                txt2 = bit_quot(ql)
            }
            if sgn {
                var neg2 = t1.len > 0 && byte_at(t1, 0) == 45
                var mg = t1
                if neg2 {
                    mg = byte_slice(t1, 1, t1.len)
                }
                var qs = c6divmod(c6can(mg), bit_p2(n))
                txt2 = bit_quot(qs)
                if neg2 {
                    // 算术右移:floor(负 / 2^n) = -ceil(幅值 / 2^n)
                    var qc = c6divmod(c6add(c6can(mg), c6sub(bit_p2(n), "1")), bit_p2(n))
                    txt2 = "-" + bit_quot(qc)
                }
            }
        }
        return bit_ret(w, txt2, ob)
    }
    panic("bit 方法:" + m)
    return e4("a", ob[1], vV2(), ob[3])
}
