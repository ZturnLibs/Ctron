// =====================================================================
// parse_expr.ct —— 表达式与类型解析(递归下降优先级链)
// p_or(最低)→ p_and → p_cmp → p_rng → p_add → p_mul → p_una → p_post → p_pri
// (原子:字面量/Ident/Call/Member/Index/括号/struct 字面量,allow_struct 门控);
// p_tpars/p_typ 类型;p_* 均携带 lns 做 span 行号戳。
// =====================================================================
fn p_and(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_cmp(toks, cur, lns, al)
    var go = true
    while go {
        if tok(toks, cur) == "&&" {
            adv(cur)
            var r = p_cmp(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push("AndAnd")
            nb.push(l)
            nb.push(r)
            l = nb
        } else { go = false }
    }
    return l
}

fn p_cmp(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_rng(toks, cur, lns, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "==" { op = "Eq" }
        if t == "!=" { op = "Ne" }
        if t == "<" { op = "Lt" }
        if t == ">" { op = "Gt" }
        if t == "<=" { op = "Le" }
        if t == ">=" { op = "Ge" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_rng(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_rng(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var f = p_add(toks, cur, lns, al)
    var t = tok(toks, cur)
    if or2(t == "..", t == "..=") {
        adv(cur)
        var to = p_add(toks, cur, lns, al)
        var nb = mk("Range")
        if t == "..=" {
            nb.push("true")
        } else {
            nb.push("false")
        }
        nb.push(f)
        nb.push(to)
        return nb
    }
    return f
}

fn p_add(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_mul(toks, cur, lns, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "+" { op = "Add" }
        if t == "-" { op = "Sub" }
        if t == "+%" { op = "WrapAdd" }
        if t == "-%" { op = "WrapSub" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_mul(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_mul(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_una(toks, cur, lns, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "*" { op = "Mul" }
        if t == "/" { op = "Div" }
        if t == "%" { op = "Mod" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_una(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_una(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var t = tok(toks, cur)
    if t == "-" {
        adv(cur)
        var e = p_una(toks, cur, lns, al)
        var nu = mk("Unary")
        nu.push("Neg")
        nu.push(e)
        return nu
    }
    if t == "!" {
        adv(cur)
        var e = p_una(toks, cur, lns, al)
        var nu = mk("Unary")
        nu.push("Not")
        nu.push(e)
        return nu
    }
    return p_post(toks, cur, lns, al)
}

fn p_post(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var e = p_pri(toks, cur, lns, al)
    var go = true
    while go {
        while tok(toks, cur) == "NL" && toks[cur.load() + 1] == "." {
            adv(cur)
        }
        var t = tok(toks, cur)
        var ln0 = lns[cur.load()]
        if t == "(" {
            adv(cur)
            var ag = mk("Args")
            var more = true
            while more {
                if tok(toks, cur) == ")" {
                    more = false
                } else {
                    ag.push(p_stmt_expr(toks, cur, lns, "1"))
                    if tok(toks, cur) == "," {
                        adv(cur)
                    } else {
                        more = false
                    }
                }
            }
            adv(cur)
            var cl = mk("Call")
            cl.push(e)
            cl.push(ag)
            nstamp(cl, ln0)
            e = cl
        } else if t == "." {
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            var mb = mk("Member")
            mb.push(e)
            var mbline = ln0
            if is_digit(byte_at(nm, 0)) {
                mb.push("TIdx")
                mb.push(num_text(nm))
            } else {
                mb.push("Nm")
                mb.push(nm)
            }
            nstamp(mb, mbline)
            e = mb
        } else if t == "[" {
            var d: I32 = 1
            var q = cur.load() + 1
            var hascom = false
            while d > 0 {
                var tk2 = toks[q]
                if tk2 == "[" { d += 1 }
                if tk2 == "]" { d -= 1 }
                if tk2 == "," && d == 1 { hascom = true }
                q += 1
            }
            var nx = toks[q]
            var ta = false
            if nx == "(" { ta = true }
            if or2(al == "1", false) && nx == "\{" { ta = true }
            if nx == "." && hascom { ta = true }
            if ta {
                adv(cur)
                var ag = mk("TArgs2")
                var more = true
                while more {
                    if tok(toks, cur) == "]" { more = false } else {
                        var at = tok(toks, cur)
                        if is_digit(byte_at(at, 0)) {
                            var cv = mk("ComptimeVal")
                            cv.push(num_text(at))
                            ag.push(cv)
                            adv(cur)
                        } else {
                            ag.push(p_typ(toks, cur, lns))
                        }
                        if tok(toks, cur) == "," { adv(cur) } else { more = false }
                    }
                }
                adv(cur)
                var tg = mk("TypeArgs")
                tg.push(e)
                tg.push(ag)
                e = tg
            } else {
                adv(cur)
                var ix = p_stmt_expr(toks, cur, lns, "1")
                adv(cur)
                var inode = mk("Index")
                inode.push(e)
                inode.push(ix)
                e = inode
            }
        } else if t == "?" {
            adv(cur)
            var tr = mk("Try")
            tr.push(e)
            nstamp(tr, ln0)
            e = tr
        } else {
            go = false
        }
    }
    return e
}

fn p_pri(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var t = tok(toks, cur)
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        var nb = mk("Int")
        var isf = false
        var tx = num_text(t)
        var jj: I32 = 0
        while jj < tx.len {
            var cc = byte_at(tx, jj)
            if or2(cc == 46, or2(cc == 101, cc == 69)) { isf = true }
            jj += 1
        }
        if isf { nb = mk("Float") }
        nb.push(num_text(t))
        nb.push(num_sfx(t))
        return nb
    }
    if t == "if" {
        return p_if(toks, cur, lns)
    }
    if t == "match" {
        return p_match(toks, cur, lns)
    }
    if t == "void" {
        adv(cur)
        return mk("Void")
    }
    if t == "true" {
        adv(cur)
        var bt = mk("Bool")
        bt.push("true")
        return bt
    }
    if t == "false" {
        adv(cur)
        var bf = mk("Bool")
        bf.push("false")
        return bf
    }
    if t == "own" {
        adv(cur)
        adv(cur)
        var an = tok(toks, cur)
        adv(cur)
        adv(cur)
        adv(cur)
        var ow = mk("Own")
        ow.push(an)
        ow.push(p_block(toks, cur, lns))
        return ow
    }
    if t == "|" {
        adv(cur)
        var cl = mk("Closure")
        var cp = mk("CPs")
        var more = true
        while more {
            if tok(toks, cur) == "|" { more = false } else {
                var isv = "false"
                var t0 = tok(toks, cur)
                if t0 == "var" { isv = "true" }
                if or2(t0 == "var", t0 == "let") { adv(cur) }
                var cn = tok(toks, cur)
                adv(cur)
                var cpar = mk("ClosureParam")
                cpar.push(isv)
                cpar.push(cn)
                var ty = mk("None")
                if tok(toks, cur) == ":" {
                    adv(cur)
                    ty = p_typ(toks, cur, lns)
                }
                cpar.push(ty)
                cp.push(cpar)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        var ret = mk("None")
        if tok(toks, cur) == "->" {
            adv(cur)
            ret = p_typ(toks, cur, lns)
        }
        cl.push(cp)
        cl.push(ret)
        cl.push(p_stmt_expr(toks, cur, lns, "1"))
        return cl
    }
    if t == "scope" {
        adv(cur)
        adv(cur)
        adv(cur)
        var pn = tok(toks, cur)
        adv(cur)
        adv(cur)
        var sc = mk("Scope")
        sc.push(pn)
        sc.push(p_block(toks, cur, lns))
        return sc
    }
    if b0 == 34 {
        adv(cur)
        var ns = mk("Str")
        ns.push(parts_of(byte_slice(t, 1, t.len - 1)))
        return ns
    }
    if t == "\{" {
        adv(cur)
        var be = mk("BlockExpr")
        be.push(p_block(toks, cur, lns))
        return be
    }
    if t == "[" {
        adv(cur)
        var al = mk("ArrLit")
        var more = true
        while more {
            if tok(toks, cur) == "]" { more = false } else {
                al.push(p_stmt_expr(toks, cur, lns, "1"))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return al
    }
    if t == "(" {
        adv(cur)
        var e0 = p_or(toks, cur, lns, "1")
        if tok(toks, cur) == "," {
            var tn = mk("TupleE")
            tn.push(e0)
            var more = true
            while more {
                if tok(toks, cur) == "," {
                    adv(cur)
                    tn.push(p_and(toks, cur, lns, "1"))
                } else {
                    more = false
                }
            }
            adv(cur)
            return tn
        }
        adv(cur)
        return e0
    }
    if al == "1" && b0 >= 65 && b0 <= 90 && toks[cur.load() + 1] == "\{" {
        var nm = t
        adv(cur)
        adv(cur)
        var sl = mk("StructLit")
        sl.push(nm)
        var lf = mk("LitFs")
        var more = true
        while more {
            if or2(tok(toks, cur) == "}", tok(toks, cur) == "#EOF") {
                more = false
            } else if tok(toks, cur) == "NL" {
                adv(cur)
            } else {
                var fnm = tok(toks, cur)
                adv(cur)
                adv(cur)
                var fv = mk("LField")
                fv.push(fnm)
                fv.push(p_stmt_expr(toks, cur, lns, "1"))
                lf.push(fv)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        sl.push(lf)
        nstamp(sl, lns[cur.load()])
        return sl
    }
    adv(cur)
    var ni = mk("Ident")
    ni.push(t)
    return ni
}

fn p_tpars(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var tp = mk("TPs")
    var more = true
    while more {
        if tok(toks, cur) == "]" { more = false } else {
            var isc = "false"
            if tok(toks, cur) == "comptime" {
                isc = "true"
                adv(cur)
            }
            var nm = tok(toks, cur)
            adv(cur)
            var tp1 = mk("TPar")
            tp1.push(nm)
            tp1.push(isc)
            var bd = mk("Bounds")
            if tok(toks, cur) == ":" {
                adv(cur)
                var more2 = true
                while more2 {
                    bd.push(tok(toks, cur))
                    adv(cur)
                    if tok(toks, cur) == "+" { adv(cur) } else { more2 = false }
                }
            }
            tp1.push(bd)
            tp.push(tp1)
            if tok(toks, cur) == "," { adv(cur) } else { more = false }
        }
    }
    adv(cur)
    return tp
}

fn p_typ(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var t = tok(toks, cur)
    if t == "(" {
        adv(cur)
        var tt = mk("TupleT")
        var more = true
        while more {
            if tok(toks, cur) == ")" { more = false } else {
                tt.push(p_typ(toks, cur, lns))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return tt
    }
    if t == "&" {
        adv(cur)
        var rf = mk("Ref")
        rf.push(p_typ(toks, cur, lns))
        if tok(toks, cur) == "?" {
            adv(cur)
            var op = mk("Optional")
            op.push(rf)
            return op
        }
        return rf
    }
    if t == "fn" {
        adv(cur)
        var ft = mk("FnT")
        adv(cur)
        var more2 = true
        while more2 {
            if tok(toks, cur) == ")" { more2 = false } else {
                ft.push(p_typ(toks, cur, lns))
                if tok(toks, cur) == "," { adv(cur) } else { more2 = false }
            }
        }
        adv(cur)
        var fret = mk("None")
        if tok(toks, cur) == "->" {
            adv(cur)
            fret = p_typ(toks, cur, lns)
        }
        var ftn = mk("FnType")
        ftn.push(ft)
        ftn.push(fret)
        if tok(toks, cur) == "?" {
            adv(cur)
            var op2 = mk("Optional")
            op2.push(ftn)
            return op2
        }
        return ftn
    }
    var nm = tok(toks, cur)
    adv(cur)
    var nt = mk("Named")
    nt.push(nm)
    var ta = mk("TArgs")
    if tok(toks, cur) == "[" {
        var nx1 = toks[cur.load() + 1]
        var isempty = false
        var single = false
        if nx1 == "]" { isempty = true }
        if !isempty && nx1 != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx1, 0)) { single = true }
        if !isempty && !single {
            adv(cur)
            var more = true
            while more {
                if tok(toks, cur) == "]" { more = false } else {
                    ta.push(p_typ(toks, cur, lns))
                    if tok(toks, cur) == "," { adv(cur) } else { more = false }
                }
            }
            adv(cur)
        }
    }
    nt.push(ta)
    var base = nt
    if tok(toks, cur) == "[" {
        var nx2 = toks[cur.load() + 1]
        var isarr = false
        if nx2 == "]" { isarr = true }
        if nx2 != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx2, 0)) { isarr = true }
        if isarr {
            adv(cur)
            if tok(toks, cur) == "]" {
                adv(cur)
                var sl = mk("Slice")
                sl.push(base)
                base = sl
            } else {
                var sz = p_stmt_expr(toks, cur, lns, "1")
                adv(cur)
                var ar = mk("ArrayT")
                ar.push(base)
                ar.push(sz)
                base = ar
            }
        }
    }
    if tok(toks, cur) == "?" {
        adv(cur)
        var op3 = mk("Optional")
        op3.push(base)
        base = op3
    }
    return base
}

fn p_or(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_and(toks, cur, lns, al)
    var go = true
    while go {
        if tok(toks, cur) == "or" {
            adv(cur)
            var r = p_and(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push("Or")
            nb.push(l)
            nb.push(r)
            l = nb
        } else {
            go = false
        }
    }
    return l
}
