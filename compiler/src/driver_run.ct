// =====================================================================
// driver_run.ct —— 编译器入口(解释执行模式)
// parse → 单文件语义 12 项;有诊断 "CODE: msg" 打印并止(rc=1);
// 干净则解释执行:文件含 fn main → 解释 main,否则解释 test 块(rc=0)。
// 输入锚:main 内 read_file("../selfhosted/input_cc.ct"),构建/运行脚本换靶。
// =====================================================================
// ---------------- 驱动:parse → 语义 12 项 → 运行 ----------------
// 语义阶段:sems != "(Ctron sem_walk2 逐条 "CODE: msg")→ 打印并止(编译失败)
// 运行阶段:文件含 fn main → 解释 main;否则解释 test 块(全过返回 0)
// 快照说明:解释器段随 ev2.ct 演进刷新(C9d 系列:match/数组/Option/struct/enum)。
// 文本面剥离 span 标注:码后 "@<数字>"(诊断内部携带行号,JSON 面消费)
fn strip_at(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        var drop = false
        if c == 64 {
            var j = i + 1
            var nd = 0
            while j < s.len && byte_at(s, j) >= 48 && byte_at(s, j) <= 57 {
                j += 1
                nd += 1
            }
            if nd > 0 && j < s.len && byte_at(s, j) == 58 {
                drop = true
                out = out + ":"
                i = j + 1
            }
        }
        if !drop {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}
fn main() -> I32 {
    let path = "../selfhosted/input_cc.ct"
    let src = read_file("../selfhosted/input_cc.ct")
    match src {
        Some(s) => {
            var toks = List[Str]()
            var lns = List[Str]()
            scan(s, toks, lns)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur, lns)
            // 模块加载器(§2):use 解析 → 可见性 → 合并;无 use 时为无感直通
            var ldiags = List[Str]()
            var lstack = List[Str]()
            var epath = ctron_entry()
            if seq2(epath, "") {
                epath = path
            }
            lstack.push(epath)
            file = pkg_load_use(file, pkg_dir_of(epath), lstack, ldiags)
            if ldiags.len > 0 {
                var li: I32 = 0
                while li < ldiags.len {
                    println(ldiags[li])
                    li += 1
                }
                return 1
            }
            var sems = sem_walk2(file, "ANCHORPROFILE")
            if !seq2(sems, "") {
                print(strip_at(sems))
                return 1
            }
            var d = find_decl(file, "main")
            if d.len > 0 {
                var br = run_block(file, statics_env(file), "", d[5], false)
                if br[0] == "a" {
                    print(fmt(br[3]))
                    return 1
                }
                print(br[2])
                return 0
            }
            var tr = run_tests(file)
            if tr[0] == "a" {
                print(tr[2])
                print(fmt(tr[3]))
                return 1
            }
            print(tr[2])
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
