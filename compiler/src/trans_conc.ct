// =====================================================================
// trans_conc.ct —— 并发/闭包发射(Phase 4):双遍发射 + spawn 捕获闭包(env 数组 +
// shim)+ with/with_mut(Mutex/Atomic 内值锁定)+ parallel(fnptr 串行)。
// 双遍协议:ct_fn 以 env 绑定 "#p"=1/1 跑两遍;第一遍 eln 全门控(不产出行),
// 仅 spawn/闭包站点直出文件作用域件(shim/typedef);第二遍正常发射函数体。
// 语义锚 = eval 顺序化模拟的可观察行为;取消传播 = 任务 panic → scope cancelled
// → 阻塞 send/recv 得 Err(ScopeCancelled)。类型码:g=ct_scope* k=ct_task*
// h=ct_chan* R=ct_res m<内>=Mutex 单元 P<内>=内值指针伪码。
// =====================================================================

// 行发射:pass1("#p"=1)丢弃,pass2 原样 println(与历史发射流逐字一致)
fn eln(s: Str, env: List[Str]) {
    if seq2(ct_env_ty(env, "#p"), "1") {
        return
    }
    println(s)
}

// 串字节累积和(闭包 shim 判别位):同源码行多闭包(嵌套 |rq| g(|r2| h(r2)))
// 旧共用 L<行> 名,#ifndef 卫兵留首枚——内层先出时守卫适配体被静默丢弃
//(mw.ct with_sessions 集成 bad 臂 200 实证)。判别位 = 参名/捕获/自由名累积和;
// 判别位相同 ⇔ shim 文本相同(体内只引参/捕获/自由名)⇔ 可互换,无碰撞面
fn ct_str_bsum(s: Str, h: I32) -> I32 {
    var i: I32 = 0
    while i < s.len {
        h = (h % 69000000) * 31 + byte_at(s, i)
        i += 1
    }
    return h
}

fn ct_pass(env: List[Str]) -> Str {
    return ct_env_ty(env, "#p")
}

// mcell C 标签:类型码内冒号非法 → 逐字清洗(u:X → uX、Lu:X → LuX;实现单一化
// 于 trans_ty ct_mcell_tag_inner,与 ct_ctype m 臂同标签)
fn ct_mcell_tag(inner: Str) -> Str {
    return ct_mcell_tag_inner(inner)
}

// Mutex 单元 typedef:仅在 pass1 于构造站点发射一次(C11 下重复亦合法,此处去重
// 交由站点唯一性;跨 fn 顺序由"全部 pass1 先于全部 pass2"保证)
fn ct_mcell_emit(inner: Str) {
    var tg = ct_mcell_tag(inner)
    // P0-A:#ifndef 卫兵——匿名 struct 重复 typedef 亦为重定义(C11 的同形豁免
    // 只对具名 typedef 成立;Mutex 字段前置 + 构造点双发即撞)
    println("#ifndef CT_MCELL_" + tg)
    println("#define CT_MCELL_" + tg)
    println("typedef struct ct_mcell_" + tg + " \{ pthread_mutex_t mu; " + ct_ctype(inner) + " v; } ct_mcell_" + tg + ";")
    println("#endif")
}

// 捕获/回传值包 ct_i:指针域经 long 中转;struct 值/Mutex 不入本片
fn ct_wrap_i(code: Str, x: Str) -> Str {
    if or2(code == "s", code == "N") {
        return "(ct_i)(long)(" + x + ")"
    }
    if or2(code == "L", or2(ct_is_tlcode(code), or2(code == "A", or2(code == "g", or2(code == "k", or2(code == "h", code == "R")))))) {
        return "(ct_i)(long)(" + x + ")"
    }
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        // T14-③:struct 值入通道 = 堆盒值拷贝(send 装箱;match Ok 臂按 hR 码解引用)
        var bt = ct_ctype(code)
        return "(\{ " + bt + "* _cb = (" + bt + "*)ctron_amalloc(sizeof(" + bt + ")); *_cb = (" + x + "); (ct_i)(long)_cb; })"
    }
    return "(ct_i)(" + x + ")"
}

// shim 内捕获解包声明
fn ct_cap_decl(code: Str, nm: Str, i: I32) -> Str {
    var ct = ct_ctype(code)
    if or2(code == "s", code == "N") {
        return ct + " t_" + nm + " = (" + ct + ")(long)_e[" + i.to_string() + "];"
    }
    if or2(code == "L", or2(ct_is_tlcode(code), or2(code == "A", or2(code == "g", or2(code == "k", or2(code == "h", code == "R")))))) {
        return ct + " t_" + nm + " = (" + ct + ")(long)_e[" + i.to_string() + "];"
    }
    if code.len > 1 && byte_at(code, 0) == 109 {
        return "ct_mcell_" + ct_mcell_tag(byte_slice(code, 1, code.len)) + "* t_" + nm + " = (ct_mcell_" + ct_mcell_tag(byte_slice(code, 1, code.len)) + "*)(long)_e[" + i.to_string() + "];"
    }
    // Box[T] 捕获:ct_ctype 已是指针(t_X*),经 long 中转解 env 槽;
    // 此前落默认分支窄化为 int32_t(指针截断,gui L1 model 捕获踩中,SL-0 探针发现)
    if code.len > 2 && byte_slice(code, 0, 2) == "B:" {
        return ct + " t_" + nm + " = (" + ct + ")(long)_e[" + i.to_string() + "];"
    }
    // fn 值捕获(ct_clop 指针,同指针宽度中转)
    if code.len > 1 {
        var ch: I32 = byte_at(code, 0)
        if or2(ch == 70, ch == 71) {
            return ct + " t_" + nm + " = (" + ct + ")(long)_e[" + i.to_string() + "];"
        }
    }
    if code == "6" {
        return ct + " t_" + nm + " = (int64_t)_e[" + i.to_string() + "];"
    }
    return ct + " t_" + nm + " = (int32_t)_e[" + i.to_string() + "];"
}

// spawn:捕获闭包 → env 数组 + shim。pass1:直出 shim(命名取站点行号,跨遍确定);
// pass2:仅返回调用表达式。捕获按值浅拷贝(ct_i 逐槽;struct 值不在本片)。
// shim 体内 return → 写任务结果 + return 0("#shim"=1);嵌套 spawn 不支持(v0 挂账)。
// 预扫尾表达式:Match/If 走语句发射(门控),BlockExpr 递归进内层块,其余走表达式
fn ct_prescan_tail(tl: List[Str], penv: List[Str], file: List[Str]) {
    if tl[0] == "None" { return }
    if or2(tl[0] == "Match", tl[0] == "If") {
        ct_stmt(tl, penv, file, List[Str]())
        return
    }
    if tl[0] == "BlockExpr" {
        ct_stmts(tl[1], penv, file, "", List[Str]())
        var itl = tl[1][tl[1].len - 1]
        ct_prescan_tail(itl, penv, file)
        return
    }
    // 尾位 with/with_mut:走 ANF 助手通路面(penv 下 eln 全门控=零输出),
    // 兜底 ct_expr 恒拒 with(仅语句位)——r3a bump 尾值形实证
    if tl[0] == "Call" {
        if tl[1][0] == "Member" {
            if or2(tl[1][3] == "with", tl[1][3] == "with_mut") {
                var pt6 = ct_typeof(tl[1][1], penv, file)
                if or2(pt6 == "A", pt6.len > 1 && byte_at(pt6, 0) == 109) {
                    ct_clo_with_tail(tl, penv, file)
                    return
                }
            }
        }
    }
    ct_expr(tl, penv, file)
}

fn ct_emit_spawn(site: List[Str], obj: Str, clo: List[Str], env: List[Str], file: List[Str]) -> Str {
    var body = clo[3]
    var cps = clo[1]
    if cps.len != 1 {
        panic("emit:spawn 闭包零参")
        return ""
    }
    if body[0] == "BlockExpr" {
        body = body[1]
    }
    var raw = List[Str]()
    if body[0] == "Block" {
        clb(file, body, raw)
    } else {
        cle(file, body, raw)
    }
    var caps = List[Str]()
    var codes = List[Str]()
    var qi: I32 = 0
    while qi < raw.len {
        var nm = raw[qi]
        if !in_list(caps, nm) && ct_env_has(env, nm) {
            caps.push(nm)
            codes.push(ct_env_ty(env, nm))
        }
        qi += 1
    }
    if caps.len > 8 {
        panic("emit:spawn 捕获>8")
        return ""
    }
    var ix = nline(site)
    var shim = "ct_shim_L" + ix
    if seq2(ct_pass(env), "1") {
        // 嵌套闭包支持:预扫(#p=1 门控体内输出,内层闭包 shim 先行直出)后冲刷
        var qlines = List[Str]()
        qlines.push("static void* " + shim + "(void* _ep) \{")
        // T31 M1.5:spawn shim 帧(任务线程 GC 退避,帧纯为体内 with/let 注册行编译通过)
        qlines.push(ct_fr_prologue())
        qlines.push("ct_i* _e = (ct_i*)_ep;")
        var ci2: I32 = 0
        while ci2 < caps.len {
            qlines.push(ct_cap_decl(codes[ci2], caps[ci2], ci2))
            ci2 += 1
        }
        var senvp = env_bind(env_bind(env, "#p", "1"), "#prescan", "1")
        if body[0] == "Block" {
            ct_stmts(body, senvp, file, "", List[Str]())
            ct_prescan_tail(body[body.len - 1], senvp, file)
        } else {
            ct_expr(body, senvp, file)
        }
        var qw: I32 = 0
        // P0-A:shim 定义 #ifndef 卫兵(同 ct_emit_clov;prewalk 重跑面)——
        // 卫兵罩全 shim(头+体+}),旧中途 #endif 与尾 #endif 双闭致 C
        // "#endif without #if"(ffi/cb_panic_task 探针)
        println("#ifndef CT_SHIM_" + shim)
        println("#define CT_SHIM_" + shim)
        while qw < qlines.len {
            println(qlines[qw])
            qw += 1
        }
        var senv = env_bind(env_bind(env, "#p", "2"), "#shim", "1")
        if body[0] == "Block" {
            var senv2 = ct_stmts(body, senv, file, "", List[Str]())
            var stl = body[body.len - 1]
            if stl[0] != "None" {
                if or2(stl[0] == "Match", stl[0] == "If") {
                    ct_stmt(stl, senv2, file, List[Str]())
                } else {
                    var stt = ct_typeof(stl, senv2, file)
                    var stx = ct_expr(stl, senv2, file)
                    if or2(stt == "s", stt == "N") {
                        println("ct_task_self()->result = (ct_i)(long)(" + stx + ");")
                    } else {
                        println("ct_task_self()->result = (ct_i)(" + stx + ");")
                    }
                }
            }
        } else {
            var bx = ct_expr(body, senv, file)
            var bt = ct_typeof(body, senv, file)
            if or2(bt == "s", bt == "N") {
                println("ct_task_self()->result = (ct_i)(long)(" + bx + ");")
            } else {
                println("ct_task_self()->result = (ct_i)(" + bx + ");")
            }
            println("return 0;")
        }
        println("}")
        println("#endif")
        return "0"
    }
    var acc = "(\{ ct_i* _e" + ix + " = (ct_i*)ctron_amalloc(sizeof(ct_i) * " + caps.len.to_string() + ");"
    var ci3: I32 = 0
    while ci3 < caps.len {
        acc = acc + " _e" + ix + "[" + ci3.to_string() + "] = " + ct_wrap_i(codes[ci3], "t_" + caps[ci3]) + ";"
        ci3 += 1
    }
    acc = acc + " (ct_task*)ct_spawn(" + shim + ", _e" + ix + ", " + obj + "); })"
    return acc
}

// 非捕获闭包 → 静态 fn(fnptr;捕获 → panic,一等闭包值挂账)。命名取站点行号。
// "#shim"=2:体内 return → return (ct_i)(expr)
fn ct_emit_clo(site: List[Str], clo: List[Str], env: List[Str], file: List[Str], np: I32) -> Str {
    var cps = clo[1]
    if cps.len != np + 1 {
        panic("emit:closure 参数个数:" + cps.len.to_string() + "/np=" + np.to_string())
        return ""
    }
    var cbody = clo[3]
    if cbody[0] == "BlockExpr" {
        cbody = cbody[1]
    }
    var raw = List[Str]()
    if cbody[0] == "Block" {
        clb(file, cbody, raw)
    } else {
        cle(file, cbody, raw)
    }
    var qi: I32 = 0
    while qi < raw.len {
        if ct_env_has(env, raw[qi]) {
            panic("emit:非捕获闭包含捕获")
            return ""
        }
        qi += 1
    }
    var ix = nline(site)
    // P0-A:同行列闭包判别位(参名 + 自由名;见 ct_str_bsum 注)
    var dsx: I32 = 7919
    var qi4: I32 = 0
    while qi4 < cps.len {
        dsx = ct_str_bsum(cps[qi4 + 1][2], dsx)
        qi4 += 1
    }
    qi4 = 0
    while qi4 < raw.len {
        dsx = ct_str_bsum(raw[qi4], dsx)
        qi4 += 1
    }
    var dss = dsx.to_string()
    if byte_at(dss, 0) == 45 {
        dss = "n" + byte_slice(dss, 1, dss.len)
    }
    var cname = "ct_clo_" + ct_env_ty(env, "#clofn") + "_L" + ix + "x" + dss
    if seq2(ct_pass(env), "1") {
        var sig0 = ""
        var pi0: I32 = 0
        while pi0 < np {
            if pi0 > 0 { sig0 = sig0 + ", " }
            sig0 = sig0 + "ct_i _p" + pi0.to_string()
            pi0 += 1
        }
        // 嵌套闭包支持:预扫(内层 shim 先行直出)后冲刷头部/形参行(同捕获 shim)
        var qlines0 = List[Str]()
        qlines0.push("static ct_i " + cname + "(" + sig0 + ") \{")
        // T31 M1.5:闭包 shim 帧(体内 let 注册经 ct_stmt;形参槽此处直注)
        qlines0.push(ct_fr_prologue())
        var pj2: I32 = 0
        var env2 = env
        while pj2 < np {
            var pn = cps[pj2 + 1][2]
            // ClosureParam 注解优先(§4.7):Str/List 形参经 64 位槽位透明传递
            var pc0 = "i"
            var pty0 = cps[pj2 + 1][3]
            if pty0[0] != "None" {
                pc0 = ct_ty_code(pty0, file)
            }
            if pc0.len > 2 && byte_slice(pc0, 0, 2) == "u:" {
                // T54:struct 内参解盒——调用位 ct_wrap_i 对 u: 码传堆盒指针
                //(与裸 fn 蹦床同口径);旧 "(t_X)(long)_p" 长整转 struct 为非法 C
                qlines0.push(ct_ctype(pc0) + " t_" + pn + " = *(t_" + byte_slice(pc0, 2, pc0.len) + "*)(long)_p" + pj2.to_string() + ";")
            } else if pc0 == "i" {
                qlines0.push("int32_t t_" + pn + " = (int32_t)_p" + pj2.to_string() + ";")
            } else {
                qlines0.push(ct_ctype(pc0) + " t_" + pn + " = (" + ct_ctype(pc0) + ")(long)_p" + pj2.to_string() + ";")
            }
            var rlc0 = ct_reg_line(pn, pc0)
            if rlc0.len > 0 {
                qlines0.push(rlc0)
            }
            env2 = env_bind(env2, pn, pc0)
            pj2 += 1
        }
        var penv0 = env_bind(env2, "#p", "1")
        if cbody[0] == "Block" {
            ct_stmts(cbody, penv0, file, "", List[Str]())
            ct_prescan_tail(cbody[cbody.len - 1], penv0, file)
        } else {
            ct_expr(cbody, penv0, file)
        }
        var qi0: I32 = 0
        // P0-A:shim 定义 #ifndef 卫兵(同 ct_emit_clov;prewalk 重跑面)
        println("#ifndef CT_CLO_" + cname)
        println("#define CT_CLO_" + cname)
        while qi0 < qlines0.len {
            println(qlines0[qi0])
            qi0 += 1
        }
        println("#endif")
        var renv0 = env_bind(env_bind(env2, "#p", "2"), "#shim", "2")
        if cbody[0] == "Block" {
            var renv2 = ct_stmts(cbody, renv0, file, "", List[Str]())
            var ctl = cbody[cbody.len - 1]
            if ctl[0] != "None" {
                if or2(ctl[0] == "Match", ctl[0] == "If") {
                    ct_stmt(ctl, renv2, file, List[Str]())
                } else {
                    var ctx = ct_expr(ctl, renv2, file)
                    println("return (ct_i)(" + ctx + ");")
                }
            }
        } else {
            var bx2 = ct_expr(cbody, renv0, file)
            println("return (ct_i)(" + bx2 + ");")
        }
        println("}")
        println("#endif")
        return "0"
    }
    return cname
}

// 闭包值 shim 返回行(T55):struct 值(u:)经 union 低 8 字节过 ct_i 返回槽
//(T54 同式,镜像 ct_cbtr 返回位);调用位 #fret 原型化指针按返回型读回同 8 字节
//(>8 字节返回超 ct_i 单槽,沿 T54 既有挂账);其余标量/指针直包 (ct_i)(…)
fn ct_clo_ret_line(code: Str, x: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        // P0-A:u:-尾返回 = 堆盒指针(ct_i)——旧 union 低 8 字节式对 >8B struct
        //(Resp/Req 链)即截断,调用位 #fret 按指针解盒(双侧同约定)
        return "return (\{ " + ct_ctype(code) + "* _rb = (" + ct_ctype(code) + "*)ctron_amalloc(sizeof(" + ct_ctype(code) + ")); *_rb = " + x + "; (ct_i)(long)_rb; });"
    }
    return "return (ct_i)(" + x + ");"
}

// 闭包体尾/单表达式位的 with/with_mut ANF 前置:命中则落临时并返回整条返回线文本
//(调用方原样 println),未命中返回 ""(走原 ct_expr 路径)。eval 尾位合法,
// ct_expr 恒拒 with(仅语句位)——r3a bump 尾值形实证漏接
fn ct_clo_with_tail(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    if e[0] != "Call" {
        return ""
    }
    if e[1][0] != "Member" {
        return ""
    }
    if !or2(e[1][3] == "with", e[1][3] == "with_mut") {
        return ""
    }
    var objt = ct_typeof(e[1][1], env, file)
    if !or2(objt == "A", objt.len > 1 && byte_at(objt, 0) == 109) {
        return ""
    }
    var ismut = e[1][3] == "with_mut"
    var inner = "i"
    if objt.len > 1 && byte_at(objt, 0) == 109 {
        inner = byte_slice(objt, 1, objt.len)
    }
    var rc = "t_wtl" + nline(e)
    var obj = ct_expr(e[1][1], env, file)
    ct_emit_with_stmt(e, obj, objt, e[2][1], env, file, ismut, rc, List[Str](), "1")
    return ct_clo_ret_line(inner, rc)
}

// with/with_mut 语句位发射(ANF:值落在 rc 变量;with_mut 无值)。
// Mutex(m<内>):pthread 锁;Atomic/Global(A):glock。with 值拷贝(写不可见),
// with_mut 指针绑定 P<内>(写可见)——镜像 eval recv[1] 语义。
fn ct_emit_with_stmt(site: List[Str], obj: Str, objt: Str, clo: List[Str], env: List[Str], file: List[Str], ismut: Bool, rc: Str, hreg: List[Str], rcdecl: Str) -> List[Str] {
    var inner = "i"
    var acc = ""
    var lockL = ""
    var unlockL = ""
    var uq = nline(site)
    if objt.len > 1 && byte_at(objt, 0) == 109 {
        inner = byte_slice(objt, 1, objt.len)
        var mtg = ct_mcell_tag(inner)
        lockL = "ct_mcell_" + mtg + "* _p" + uq + " = (ct_mcell_" + mtg + "*)(" + obj + "); pthread_mutex_lock(&_p" + uq + "->mu);"
        unlockL = "pthread_mutex_unlock(&_p" + uq + "->mu);"
        acc = "_p" + uq + "->v"
    } else if objt == "A" {
        lockL = "ctron_cell* _p" + uq + " = (ctron_cell*)(" + obj + "); ct_glock();"
        unlockL = "ct_gunlock();"
        acc = "_p" + uq + "->v"
    } else {
        panic("emit:with 接收者")
        return env
    }
    var cps = clo[1]
    if cps.len != 2 {
        panic("emit:with 闭包单参")
        return env
    }
    var pname = cps[1][2]
    var cbody = clo[3]
    if cbody[0] == "BlockExpr" {
        cbody = cbody[1]
    }
    var env2 = env
    if ismut {
        env2 = env_bind(env, pname, "P" + inner)
    } else {
        env2 = env_bind(env, pname, inner)
    }
    if rc != "" {
        if seq2(rcdecl, "1") {
            // P0-A:声明型 = 闭包尾值型——旧 ct_ctype(rc) 对名取型恒落 int32_t,
            // Str/struct 载荷的 with 值(let/返回位)声明即错型;尾 None 保底 i
            var wty = "i"
            if cbody[0] == "Block" {
                var wtl = cbody[cbody.len - 1]
                if wtl[0] != "None" {
                    wty = ct_typeof(wtl, env2, file)
                }
            } else {
                wty = ct_typeof(cbody, env2, file)
            }
            if wty == "v" {
                wty = "i"
            }
            eln(ct_ctype(wty) + " " + rc + ";", env)
            var rwr = ct_reg_line_c(rc, wty)
            if rwr.len > 0 { eln(rwr, env) }
        }
    }
    // C 作用域括号:with 体整体成块——同 fn 多 with 的同名形参/局部(t_c 等)
    // 在 C 顶层重定义即 cc 错(r3a bump with_mut+with 双连实证);eval 侧本就
    // 逐 with 作用域,括号对齐语义。rc 声明位在块外(存活到语句位消费点)
    eln("\{", env)
    eln(lockL, env)
    if ismut {
        eln(ct_ctype(inner) + "* t_" + pname + " = &" + acc + ";", env)
        var rwm = ct_reg_line(pname, "P" + inner)
        if rwm.len > 0 { eln(rwm, env) }
    } else {
        eln(ct_ctype(inner) + " t_" + pname + " = " + acc + ";", env)
        var rwi = ct_reg_line(pname, inner)
        if rwi.len > 0 { eln(rwi, env) }
    }
    if cbody[0] == "Block" {
        var renv = ct_stmts(cbody, env2, file, "", hreg)
        var tl = cbody[cbody.len - 1]
        if rc != "" {
            var tail = ct_zero(rc)
            if tl[0] != "None" {
                tail = ct_expr(tl, renv, file)
            }
            eln(rc + " = " + tail + ";", env)
        } else {
            if tl[0] != "None" {
                var tx = ct_expr(tl, renv, file)
                eln(tx + ";", env)
            }
        }
    } else {
        var vx = ct_expr(cbody, env2, file)
        if rc != "" {
            eln(rc + " = " + vx + ";", env)
        } else {
            eln(vx + ";", env)
        }
    }
    eln(unlockL, env)
    eln("}", env)
    return env
}

// scope 块语句位发射(ANF):ct_scope_new + s 绑 g;块值落在 rc(可空)
fn ct_emit_scope_stmt(site: List[Str], env: List[Str], file: List[Str], rc: Str, hreg: List[Str]) -> List[Str] {
    var sn = site[1]
    var scb = site[2]
    eln("ct_scope* t_" + sn + " = ct_scope_new();", env)
    var senv = env_bind(env, sn, "g")
    if rc != "" {
        eln(ct_ctype(rc) + " " + rc + ";", env)
    }
    var senv2 = ct_stmts(scb, senv, file, "", hreg)
    var tl = scb[scb.len - 1]
    // 尾槽为 with 调用 → 递归 ANF(值直接落 rc)
    if tl[0] == "Call" {
        if tl[1][0] == "Member" {
            if tl[1][3] == "with" {
                var ot6 = ct_typeof(tl[1][1], senv2, file)
                if or2(ot6 == "A", ot6.len > 1 && byte_at(ot6, 0) == 109) {
                    var ob6 = ct_expr(tl[1][1], senv2, file)
                    ct_emit_with_stmt(tl, ob6, ot6, tl[2][1], senv2, file, false, rc, hreg, "0")
                    return env
                }
            }
        }
    }
    if rc != "" {
        var tail = ct_zero(rc)
        if tl[0] != "None" {
            tail = ct_expr(tl, senv2, file)
        }
        eln(rc + " = " + tail + ";", env)
    } else {
        if tl[0] != "None" {
            var tx = ct_expr(tl, senv2, file)
            eln(tx + ";", env)
        }
    }
    return env
}

// 一等闭包值(带捕获):值 = ct_clop(fn+env 装箱对)。pass1 直出静态 fn
// (首参 _cp = 捕获数组);pass2 返回构造表达式。捕获 = 创建时快照(镜像 eval env 引用)。
fn ct_emit_clov(site: List[Str], clo: List[Str], env: List[Str], file: List[Str]) -> Str {
    var body = clo[3]
    if body[0] == "BlockExpr" {
        body = body[1]
    }
    var cps = clo[1]
    var np = cps.len - 1
    // np==0(零参闭包 || { }) 与 1-3 同族:shim 签名本就按 np 拼接(void* _cp 单参),
    // 此前 <1 闸门 panic,gui 注册表/回调踩中(SL-0.6-⑰ 探针)
    if or2(np < 0, np > 3) {
        panic("emit:闭包值 arity")
        return ""
    }
    var raw = List[Str]()
    if body[0] == "Block" {
        clb(file, body, raw)
    } else {
        cle(file, body, raw)
    }
    var caps = List[Str]()
    var codes = List[Str]()
    // chains 旁表(T55):源名已 P 绑(嵌套闭包/with_mut)→ "1";codes 同步存剥后码
    var chains = List[Str]()
    var pnames = List[Str]()
    var qi: I32 = 1
    while qi < cps.len {
        pnames.push(cps[qi][2])
        qi += 1
    }
    qi = 0
    while qi < raw.len {
        var nm = raw[qi]
        if !in_list(caps, nm) && !in_list(pnames, nm) && ct_env_has(env, nm) {
            var cd = ct_env_ty(env, nm)
            caps.push(nm)
            if cd.len > 1 && byte_at(cd, 0) == 80 {
                chains.push("1")
                codes.push(ct_strip_p(cd))
            } else {
                chains.push("0")
                codes.push(cd)
            }
        }
        qi += 1
    }
    if caps.len > 8 {
        panic("emit:闭包值捕获>8")
        return ""
    }
    var ix = nline(site)
    // P0-A:同行列闭包判别位(参名 + 捕获名/码;见 ct_str_bsum 注)
    var dsx: I32 = 7919
    var qi5: I32 = 0
    while qi5 < pnames.len {
        dsx = ct_str_bsum(pnames[qi5], dsx)
        qi5 += 1
    }
    qi5 = 0
    while qi5 < caps.len {
        dsx = ct_str_bsum(caps[qi5], dsx)
        dsx = ct_str_bsum(codes[qi5], dsx)
        qi5 += 1
    }
    var dss2 = dsx.to_string()
    if byte_at(dss2, 0) == 45 {
        dss2 = "n" + byte_slice(dss2, 1, dss2.len)
    }
    var shim = "ct_clo_" + ct_env_ty(env, "#clofn") + "_L" + ix + "x" + dss2
    if seq2(ct_pass(env), "1") {
        var sig = "void* _cp"
        var pi: I32 = 0
        while pi < np {
            sig = sig + ", ct_i _p" + pi.to_string()
            pi += 1
        }
        // 嵌套闭包支持:先构建形参环境,再以 #p=1 预扫体内(eln 全门控丢弃,
        // 而内层闭包发射器见 pass1 直出 shim)——内层定义先于本 shim 落盘
        // (C 先声明后用),之后才冲刷本 shim 头部/形参行
        var qlines = List[Str]()
        qlines.push("static ct_i " + shim + "(" + sig + ") \{")
        // T31 M1.5:捕获闭包 shim 帧(体内 let 注册经 ct_stmt;捕获格驻 arena=根扫覆盖)
        qlines.push(ct_fr_prologue())
        qlines.push("ct_i* _e = (ct_i*)_cp;")
        // T55 捕获 decl:格指针 `T* t_nm = (T*)(long)_e[i]`——env 槽存 arena 格址,
        // 体名 P 绑每处引用活解引用(by-reference v0;spawn 共用的 ct_cap_decl 未动)
        var ci2: I32 = 0
        while ci2 < caps.len {
            var cd2 = ct_ctype(codes[ci2])
            qlines.push(cd2 + "* t_" + caps[ci2] + " = (" + cd2 + "*)(long)_e[" + ci2.to_string() + "];")
            ci2 += 1
        }
        var env2 = env
        var clcodes = ""
        if ct_env_has(env, "#clcodes") {
            clcodes = ct_env_ty(env, "#clcodes")
        }
        var pj: I32 = 0
        while pj < np {
            var pn = cps[pj + 1][2]
            var pc = "i"
            if clcodes.len > 0 {
                // '#clcodes' 第 pj 段(逗号分隔);指针码经 long 中转(ct_i 64 位)
                // 注意 or2 不短路:边界迭代须先判 k==len 再取 byte_at
                var si: I32 = 0
                var cur: I32 = 0
                var k: I32 = 0
                while k <= clcodes.len {
                    if k == clcodes.len {
                        if cur == pj {
                            pc = byte_slice(clcodes, si, k)
                        }
                        k = clcodes.len + 1
                    } else {
                        if byte_at(clcodes, k) == 44 {
                            if cur == pj {
                                pc = byte_slice(clcodes, si, k)
                                k = clcodes.len + 1
                            } else {
                                cur += 1
                                si = k + 1
                                k += 1
                            }
                        } else {
                            k += 1
                        }
                    }
                }
            }
            // 无调用点提示时回落 ClosureParam 注解(§4.7;形参 ABI 64 位槽位)
            if pc == "i" {
                var pty1 = cps[pj + 1][3]
                if pty1[0] != "None" {
                    pc = ct_ty_code(pty1, file)
                }
            }
            if pc.len > 2 && byte_slice(pc, 0, 2) == "u:" {
                // T54:struct 内参解盒——调用位 ct_wrap_i 对 u: 码传堆盒指针
                //(ct_emit_clo 同式);旧 "(t_X)(long)_p" 长整转 struct 为非法 C
                qlines.push(ct_ctype(pc) + " t_" + pn + " = *(t_" + byte_slice(pc, 2, pc.len) + "*)(long)_p" + pj.to_string() + ";")
            } else if pc == "i" {
                qlines.push("int32_t t_" + pn + " = (int32_t)_p" + pj.to_string() + ";")
            } else {
                qlines.push(ct_ctype(pc) + " t_" + pn + " = (" + ct_ctype(pc) + ")(long)_p" + pj.to_string() + ";")
            }
            var rlc1 = ct_reg_line(pn, pc)
            if rlc1.len > 0 {
                qlines.push(rlc1)
            }
            env2 = env_bind(env2, pn, pc)
            // P0-A:fn 型形参(F 签名码)挂 #fret——体内 <名>(…) 间接调用的
            // 结构返回原型化源(flash_sweep 的 next(req) 即此形)
            if pc.len > 1 {
                if byte_at(pc, 0) == 70 {
                    var pfret = ct_fsig_ret(pc)
                    if pfret.len > 0 {
                        if pfret != "v" {
                            if pfret != "i" {
                                env2 = env_bind(env2, "#fret:" + pn, pfret)
                            }
                        }
                    }
                }
            }
            pj += 1
        }
        // T55:捕获绑 P<码>(penv/benv 同源;Ident/Assign 既有 P 臂活解引用;
        // 体位 let 重绑表头插入自然遮蔽)
        var cj: I32 = 0
        while cj < caps.len {
            env2 = env_bind(env2, caps[cj], "P" + codes[cj])
            cj += 1
        }
        var penv = env_bind(env2, "#p", "1")
        if body[0] == "Block" {
            ct_stmts(body, penv, file, "", List[Str]())
            ct_prescan_tail(body[body.len - 1], penv, file)
        } else {
            // 单表达式体 with 尾:同一 ANF 助手通路面(penv 下零输出),ct_expr 恒拒 with
            var wtp = ct_clo_with_tail(body, penv, file)
            if wtp == "" {
                ct_expr(body, penv, file)
            }
        }
        var qi: I32 = 0
        // P0-A:shim 定义 #ifndef 卫兵——同一特化的 def 文本由 CT_SPEC_ 去重,但其
        // prewalk 每个调用点重跑,体内闭包 shim(行号命名)随重跑重复定义
        println("#ifndef CT_CLO_" + shim)
        println("#define CT_CLO_" + shim)
        while qi < qlines.len {
            println(qlines[qi])
            qi += 1
        }
        var benv = env_bind(env2, "#p", "2")
        benv = env_bind(benv, "#shim", "2")
        if body[0] == "Block" {
            var renv = ct_stmts(body, benv, file, "", List[Str]())
            var tl = body[body.len - 1]
            if tl[0] != "None" {
                if or2(tl[0] == "Match", tl[0] == "If") {
                    ct_stmt(tl, renv, file, List[Str]())
                } else {
                    // 尾槽 with/with_mut:ANF 前置(值落临时再按返回线包)——eval 口径
                    // 尾位合法,ct_expr 恒拒(仅语句位);r3a bump 尾值形
                    var wt = ct_clo_with_tail(tl, renv, file)
                    if wt != "" {
                        println(wt)
                    } else {
                        var tyc = ct_typeof(tl, renv, file)
                        var tx = ct_expr(tl, renv, file)
                        // Void 体(如 list.push 调用)不包 return——(ct_i)(void 表达式)
                        // 是非法 C;此前无条件包裹,gui L1 绑定钩子踩中(SL-0 探针发现)
                        if tyc == "v" {
                            println(tx + ";")
                        } else {
                            // T55:u: 尾表达式走 union 低 8 字节式(T54 同口径)
                            println(ct_clo_ret_line(tyc, tx))
                        }
                    }
                }
            } else {
                println("return 0;")
            }
        } else {
            var wt2 = ct_clo_with_tail(body, benv, file)
            if wt2 != "" {
                println(wt2)
            } else {
                var vty = ct_typeof(body, benv, file)
                var vx = ct_expr(body, benv, file)
                if vty == "v" {
                    println(vx + ";")
                } else {
                    println(ct_clo_ret_line(vty, vx))
                }
            }
        }
        println("}")
        println("#endif")
        return "0"
    }
    var acc = "(\{ ct_i* _e" + ix + " = (ct_i*)ctron_amalloc(sizeof(ct_i) * " + caps.len.to_string() + ");"
    // T55 创建位:每捕获一 arena 格(ctron_amalloc,地址稳定永不释放)——值入格、
    // 槽存格址;链式源(P 绑)已是格指针,直传同一格址(内外层共格)
    var ci3: I32 = 0
    while ci3 < caps.len {
        if chains[ci3] == "1" {
            acc = acc + " _e" + ix + "[" + ci3.to_string() + "] = (ct_i)(long)t_" + caps[ci3] + ";"
        } else {
            var cd3 = ct_ctype(codes[ci3])
            acc = acc + " _e" + ix + "[" + ci3.to_string() + "] = (ct_i)(long)(\{ " + cd3 + "* _g" + ci3.to_string() + " = (" + cd3 + "*)ctron_amalloc(sizeof(" + cd3 + ")); *_g" + ci3.to_string() + " = t_" + caps[ci3] + "; _g" + ci3.to_string() + "; });"
        }
        ci3 += 1
    }
    acc = acc + " ct_clop _c" + ix + " = (ct_clop)ctron_amalloc(sizeof(ct_clo)); _c" + ix + "->fn = (void*)" + shim + "; _c" + ix + "->env = _e" + ix + "; _c" + ix + "; })"
    return acc
}

// Result/Option 载荷入 ct_res.v:用户枚举装箱(amalloc),指针/标量直入;
// F64 载荷位型双关(union 复合字面量)——旧 (ct_i) 直转截断小数
//(param_f64.or(0.0)==2.5 探针;interp v_value D 位原生双精度的发射等价)
fn ct_res_wrap(code: Str, x: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "E:" {
        var ct = ct_ctype(code)
        return "(\{ " + ct + "* _b = (" + ct + "*)ctron_amalloc(sizeof(" + ct + ")); *_b = " + x + "; (ct_i)(long)_b; })"
    }
    if or2(code == "s", code == "N") {
        return "(ct_i)(long)(" + x + ")"
    }
    if code == "f" {
        return "((union \{ double _d; ct_i _i; })\{ ._d = (" + x + ") })._i"
    }
    return "(ct_i)(" + x + ")"
}
