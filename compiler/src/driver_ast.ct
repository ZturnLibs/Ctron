// =====================================================================
// driver_ast.ct —— .ctast 序列化/回读驱动(S1a-i)
// 格式 v1(docs/superpowers/plans/2026-09-21-closed-pkg-s0-iface.md S1a 底座):
//   N <tag> <nchildren>\n          节点开记录,后随 nchildren 条子记录
//   S <bytelen>\n<payload>\n       字符串载荷(字节长前缀,载荷任意字节含换行)
// 先序遍历;确定性 = 遍历序 + 记录结构零自由度。
// 子槽种类由形态表驱动(shape_of,tag → 形态串):S=串槽 N=节点槽,
// 末位 `*` = 自该槽起其余子项皆同种(Fn 系尾部变长串槽 anm/stamp/"pub")。
// 未知标签/子项越形态 = fail-closed(E-AST-UNKNOWN/E-AST-SHAPE,缓存失效口径)。
// 模式(ctron_cli_flag("ast")):dump = AST→.ctast 到 stdout;
//   roundtrip = dump → load → redump 逐字节自比(往返固定点验收)。
// 输入锚:read_file("ANCHORINPUT")(与 driver_check 同口径;seed 面由 ctc.sh 换靶)。
// =====================================================================
fn ast_emit_str(sv: Str, out: List[Str]) {
    out.push("S " + (sv.len).to_string() + "\n")
    out.push(sv)
    out.push("\n")
}

fn ast_emit_node(d: List[Str], k: List[Str], v: List[Str], out: List[Str], depth: I32) -> I32 {
    if depth > 4000 {
        return -4
    }
    var tag = d[0]
    var sh = ast_shape(k, v, tag)
    if sh == "?" {
        println("E-AST-UNKNOWN: 形态表缺标签 " + tag)
        return -2
    }
    var nc = d.len - 1
    if nc < sh.len {
        if byte_slice(sh, sh.len - 1, sh.len) != "*" {
            println("E-AST-SHAPE: " + tag + " 子项 " + (nc).to_string() + " 不足形态 " + sh)
            return -3
        }
    }
    out.push("N " + tag + " " + (nc).to_string() + "\n")
    var i: I32 = 1
    while i < d.len {
        var kind = ast_kind(sh, i - 1)
        if kind == "S" {
            ast_emit_str(d[i], out)
        } else {
            if kind == "N" {
                var r = ast_emit_node(d[i], k, v, out, depth + 1)
                if r != 0 {
                    return r
                }
            } else {
                println("E-AST-SHAPE: " + tag + " 槽 " + (i - 1).to_string() + " 非法")
                return -3
            }
        }
        i += 1
    }
    return 0
}

fn main() -> I32 {
    var path = "ANCHORINPUT"
    var s = ""
    var have = false
    var epath = ctron_entry()
    if seq2(epath, "") {
        epath = path
    }
    match read_file("ANCHORINPUT") {
        Some(x) => {
            s = x
            have = true
        }
        None => {}
    }
    if !have {
        print("read-failed")
        return 1
    }
    var toks = List[Str]()
    var lns = List[Str]()
    var cols = List[Str]()
    var pdiags = List[Str]()
    scan4(s, toks, lns, cols, pdiags)
    var cur = Atomic[I32](0)
    var file = p_file(toks, cur, lns, cols, pdiags)
    if pdiags.len > 0 {
        var pi: I32 = 0
        while pi < pdiags.len {
            println(epath + ":" + pdiags[pi])
            pi += 1
        }
        return 1
    }
    var mode = ctron_cli_flag("ast")
    if mode.len == 0 {
        mode = "ANCHORAST"
    }
    // 形态表迁 CORE parse_node.ct:ast_tables 与 pkg 加载器(选择性合并引用收集)共用
    var ktags = List[Str]()
    var kshapes = List[Str]()
    ast_tables(ktags, kshapes)
    var out = List[Str]()
    var r = ast_emit_node(file, ktags, kshapes, out, 0)
    if r == -2 {
        return 1
    }
    if r != 0 {
        println("E-AST-DEEP")
        return 1
    }
    var ser = ""
    var sj: I32 = 0
    while sj < out.len {
        ser = ser + out[sj]
        sj += 1
    }
    if seq2(mode, "seal") {
        var outdir = ctron_cli_flag("astout")
        if outdir.len == 0 {
            outdir = "ANCHOROUT"
        }
        var name = ctron_cli_flag("astname")
        if name.len == 0 {
            name = "ANCHORNAME"
        }
        var st0 = epath.len - 1
        while st0 >= 0 {
            if byte_at(epath, st0) == 47 {
                break
            }
            st0 -= 1
        }
        var stem = byte_slice(epath, st0 + 1, epath.len)
        if stem.len > 3 {
            if byte_slice(stem, stem.len - 3, stem.len) == ".ct" {
                stem = byte_slice(stem, 0, stem.len - 3)
            }
        }
        var w1 = fs_write(outdir + "/impl/" + stem + ".ast", ser)
        var meta = "artifact \"" + name + "\" \{\n  manifest_version = 1\n}\nmodule \"" + stem + "\" \{\n  decls = " + (file.len - 1).to_string() + "\n  bytes = " + (ser.len).to_string() + "\n}\n"
        var w2 = fs_write(outdir + "/meta.ctcl", meta)
        if or2(!w1, !w2) {
            println("E-AST-SEAL: 写出失败(目录须先建:" + outdir + ")")
            return 1
        }
        println("ast seal OK module=" + stem + " bytes=" + (ser.len).to_string())
        return 0
    }
    if seq2(mode, "dump") {
        var i: I32 = 0
        while i < out.len {
            print(out[i])
            i += 1
        }
        return 0
    }
    var cur2 = Atomic[I32](0)
    var file2 = ast_load_node(ser, cur2)
    var out2 = List[Str]()
    var r2 = ast_emit_node(file2, ktags, kshapes, out2, 0)
    if r2 != 0 {
        println("E-AST-REEMIT rc=" + (r2).to_string())
        return 1
    }
    var ser2 = ""
    var j: I32 = 0
    while j < out2.len {
        ser2 = ser2 + out2[j]
        j += 1
    }
    if seq2(ser, ser2) {
        println("ast roundtrip OK bytes=" + (ser.len).to_string())
        return 0
    }
    var p: I32 = 0
    while p < ser.len && p < ser2.len {
        if byte_at(ser, p) != byte_at(ser2, p) {
            break
        }
        p += 1
    }
    println("ast roundtrip DIFF at " + (p).to_string())
    return 1
}
