// =====================================================================
// driver_ast.ct —— .ctast 序列化/回读驱动(S1a-i)
// 格式 v1(docs/superpowers/plans/2026-09-21-closed-pkg-s0-iface.md S1a 底座):
//   N <tag> <nchildren>\n          节点开记录,后随 nchildren 条子记录
//   S <bytelen>\n<payload>\n       字符串载荷(字节长前缀,载荷任意字节含换行)
// 先序遍历;确定性 = 遍历序 + 记录结构零自由度。
// 子槽种类由形态表驱动(shape_of,tag → 形态串):S=串槽 N=节点槽,
// 末位 `*` = 自该槽起其余子项皆同种(Fn 系尾部变长串槽 anm/stamp/"pub")。
// 未知标签/子项越形态 = fail-closed(E-AST-UNKNOWN/E-AST-SHAPE,缓存失效口径)。
// 模式(ctron_cli_flag("ast")):dump = AST→.ctast 到 stdout;
//   roundtrip = dump → load → redump 逐字节自比(往返固定点验收)。
// 输入锚:read_file("ANCHORINPUT")(与 driver_check 同口径;seed 面由 ctc.sh 换靶)。
// =====================================================================
fn ast_put(k: List[Str], v: List[Str], key: Str, val: Str) {
    k.push(key)
    v.push(val)
}

fn ast_shape(k: List[Str], v: List[Str], tag: Str) -> Str {
    var i: I32 = 0
    while i < k.len {
        if k[i] == tag {
            return v[i]
        }
        i += 1
    }
    return "?"
}

fn ast_kind(sh: Str, si: I32) -> Str {
    if sh.len == 0 {
        return "?"
    }
    var star = byte_slice(sh, sh.len - 1, sh.len) == "*"
    var n = sh.len
    if star {
        n = n - 1
    }
    if n == 0 {
        return "?"
    }
    var idx = si
    if idx >= n {
        if !star {
            return "?"
        }
        idx = n - 1
    }
    return byte_slice(sh, idx, idx + 1)
}

fn ast_emit_str(sv: Str, out: List[Str]) {
    out.push("S " + (sv.len).to_string() + "\n")
    out.push(sv)
    out.push("\n")
}

fn ast_emit_node(d: List[Str], k: List[Str], v: List[Str], out: List[Str], depth: I32) -> I32 {
    if depth > 4000 {
        return -4
    }
    var tag = d[0]
    var sh = ast_shape(k, v, tag)
    if sh == "?" {
        println("E-AST-UNKNOWN: 形态表缺标签 " + tag)
        return -2
    }
    var nc = d.len - 1
    if nc < sh.len {
        if byte_slice(sh, sh.len - 1, sh.len) != "*" {
            println("E-AST-SHAPE: " + tag + " 子项 " + (nc).to_string() + " 不足形态 " + sh)
            return -3
        }
    }
    out.push("N " + tag + " " + (nc).to_string() + "\n")
    var i: I32 = 1
    while i < d.len {
        var kind = ast_kind(sh, i - 1)
        if kind == "S" {
            ast_emit_str(d[i], out)
        } else {
            if kind == "N" {
                var r = ast_emit_node(d[i], k, v, out, depth + 1)
                if r != 0 {
                    return r
                }
            } else {
                println("E-AST-SHAPE: " + tag + " 槽 " + (i - 1).to_string() + " 非法")
                return -3
            }
        }
        i += 1
    }
    return 0
}

fn ast_read_line(ser: Str, cur: Atomic[I32]) -> Str {
    var out = ""
    var i = cur.load()
    while i < ser.len && byte_at(ser, i) != 10 {
        out = out + byte_slice(ser, i, i + 1)
        i += 1
    }
    cur.store(i + 1)
    return out
}

fn ast_load_node(ser: Str, cur: Atomic[I32]) -> List[Str] {
    var line = ast_read_line(ser, cur)
    var sp: I32 = 2
    while sp < line.len {
        if byte_at(line, sp) == 32 {
            break
        }
        sp += 1
    }
    var tag = byte_slice(line, 2, sp)
    var n = dvi(byte_slice(line, sp + 1, line.len))
    var node = mk(tag)
    var i: I32 = 0
    while i < n {
        var rec = ast_read_line(ser, cur)
        if byte_at(rec, 0) == 83 {
            var len = dvi(byte_slice(rec, 2, rec.len))
            var p0 = cur.load()
            node.push(byte_slice(ser, p0, p0 + len))
            cur.store(p0 + len + 1)
        } else {
            cur.store(cur.load() - rec.len - 1)
            node.push(ast_load_node(ser, cur))
        }
        i += 1
    }
    return node
}

fn main() -> I32 {
    var path = "ANCHORINPUT"
    var s = ""
    var have = false
    var epath = ctron_entry()
    if seq2(epath, "") {
        epath = path
    }
    match read_file("ANCHORINPUT") {
        Some(x) => {
            s = x
            have = true
        }
        None => {}
    }
    if !have {
        print("read-failed")
        return 1
    }
    var toks = List[Str]()
    var lns = List[Str]()
    var cols = List[Str]()
    var pdiags = List[Str]()
    scan4(s, toks, lns, cols, pdiags)
    var cur = Atomic[I32](0)
    var file = p_file(toks, cur, lns, cols, pdiags)
    if pdiags.len > 0 {
        var pi: I32 = 0
        while pi < pdiags.len {
            println(epath + ":" + pdiags[pi])
            pi += 1
        }
        return 1
    }
    var mode = ctron_cli_flag("ast")
    if mode.len == 0 {
        mode = "ANCHORAST"
    }
    // 形态表(语料驱动增量;未知标签 fail-closed → 加表再验)
    var ktags = List[Str]()
    var kshapes = List[Str]()
    ast_put(ktags, kshapes, "File", "N*")
    ast_put(ktags, kshapes, "Expr", "N")
    ast_put(ktags, kshapes, "None", "")
    ast_put(ktags, kshapes, "Fn", "SNNNNS*")
    ast_put(ktags, kshapes, "FnPub", "SNNNNS*")
    ast_put(ktags, kshapes, "Method", "SNNNNS*")
    ast_put(ktags, kshapes, "FnExt", "SNNNNS*")
    ast_put(ktags, kshapes, "FnC", "SNNNNS*")
    ast_put(ktags, kshapes, "Struct", "SNNNS*")
    ast_put(ktags, kshapes, "Enum", "SNNS*")
    ast_put(ktags, kshapes, "Trait", "SNNN")
    ast_put(ktags, kshapes, "Impl", "NNNN")
    ast_put(ktags, kshapes, "Const", "SNN")
    ast_put(ktags, kshapes, "Static", "SSNN")
    ast_put(ktags, kshapes, "Use", "NN")
    ast_put(ktags, kshapes, "Test", "SN")
    ast_put(ktags, kshapes, "Ps", "N*")
    ast_put(ktags, kshapes, "Param", "SSN")
    ast_put(ktags, kshapes, "VaArgs", "")
    ast_put(ktags, kshapes, "Fields", "N*")
    ast_put(ktags, kshapes, "Field", "SSNS*")
    ast_put(ktags, kshapes, "Drvs", "S*")
    ast_put(ktags, kshapes, "TPs", "N*")
    ast_put(ktags, kshapes, "TPar", "SSN")
    ast_put(ktags, kshapes, "Bounds", "S*")
    ast_put(ktags, kshapes, "Vars", "N*")
    ast_put(ktags, kshapes, "Variant", "SN")
    ast_put(ktags, kshapes, "KUnit", "N*")
    ast_put(ktags, kshapes, "KTuple", "N*")
    ast_put(ktags, kshapes, "KStruct", "N*")
    ast_put(ktags, kshapes, "Items", "N*")
    ast_put(ktags, kshapes, "Segs", "S*")
    ast_put(ktags, kshapes, "Syms", "S*")
    ast_put(ktags, kshapes, "Named", "SN")
    ast_put(ktags, kshapes, "TArgs", "N*")
    ast_put(ktags, kshapes, "TArgs2", "N*")
    ast_put(ktags, kshapes, "Ref", "N")
    ast_put(ktags, kshapes, "Optional", "N")
    ast_put(ktags, kshapes, "TupleT", "N*")
    ast_put(ktags, kshapes, "Slice", "N")
    ast_put(ktags, kshapes, "ArrayT", "NN")
    ast_put(ktags, kshapes, "FnType", "NN")
    ast_put(ktags, kshapes, "FnT", "N*")
    ast_put(ktags, kshapes, "Block", "N*")
    ast_put(ktags, kshapes, "BlockExpr", "N")
    ast_put(ktags, kshapes, "Let", "SNNNS")
    ast_put(ktags, kshapes, "Return", "NS*")
    ast_put(ktags, kshapes, "If", "NNN")
    ast_put(ktags, kshapes, "While", "NN")
    ast_put(ktags, kshapes, "Match", "NNS")
    ast_put(ktags, kshapes, "Arms", "N*")
    ast_put(ktags, kshapes, "Arm", "NNNS*")
    ast_put(ktags, kshapes, "Call", "NNS*")
    ast_put(ktags, kshapes, "Args", "N*")
    ast_put(ktags, kshapes, "Unary", "SN")
    ast_put(ktags, kshapes, "Binary", "SNNS*")
    ast_put(ktags, kshapes, "Ident", "S")
    ast_put(ktags, kshapes, "Int", "SS*")
    ast_put(ktags, kshapes, "Str", "N")
    ast_put(ktags, kshapes, "Parts", "N*")
    ast_put(ktags, kshapes, "Text", "S")
    ast_put(ktags, kshapes, "PatWild", "")
    ast_put(ktags, kshapes, "PatId", "S")
    ast_put(ktags, kshapes, "PatLitB", "S")
    ast_put(ktags, kshapes, "PatTup", "N*")
    ast_put(ktags, kshapes, "PatAgg", "SN")
    ast_put(ktags, kshapes, "SubTup", "N*")
    ast_put(ktags, kshapes, "SubSt", "N*")
    ast_put(ktags, kshapes, "SubUnit", "")
    ast_put(ktags, kshapes, "PatFld", "SN")
    ast_put(ktags, kshapes, "TypeArgs", "NN")
    ast_put(ktags, kshapes, "Index", "NN")
    ast_put(ktags, kshapes, "Try", "NS*")
    ast_put(ktags, kshapes, "Closure", "NNNS*")
    ast_put(ktags, kshapes, "CPs", "N*")
    ast_put(ktags, kshapes, "TupleE", "N*")
    ast_put(ktags, kshapes, "StructLit", "SNS")
    ast_put(ktags, kshapes, "LitFs", "N*")
    ast_put(ktags, kshapes, "Bool", "S")
    ast_put(ktags, kshapes, "Range", "SNN")
    ast_put(ktags, kshapes, "ComptimeVal", "S")
    ast_put(ktags, kshapes, "Float", "SS*")
    ast_put(ktags, kshapes, "Own", "SN")
    ast_put(ktags, kshapes, "ClosureParam", "SSN")
    ast_put(ktags, kshapes, "Scope", "SN")
    ast_put(ktags, kshapes, "ArrLit", "N*")
    ast_put(ktags, kshapes, "Class", "SNN")
    ast_put(ktags, kshapes, "LField", "SN")
    ast_put(ktags, kshapes, "Interp", "S")
    ast_put(ktags, kshapes, "Member", "NSSS*")
    ast_put(ktags, kshapes, "For", "NNN")
    ast_put(ktags, kshapes, "Assign", "NSNS*")
    var out = List[Str]()
    var r = ast_emit_node(file, ktags, kshapes, out, 0)
    if r == -2 {
        return 1
    }
    if r != 0 {
        println("E-AST-DEEP")
        return 1
    }
    var ser = ""
    var i: I32 = 0
    while i < out.len {
        ser = ser + out[i]
        i += 1
    }
    if seq2(mode, "dump") {
        print(ser)
        return 0
    }
    var cur2 = Atomic[I32](0)
    var file2 = ast_load_node(ser, cur2)
    var out2 = List[Str]()
    var r2 = ast_emit_node(file2, ktags, kshapes, out2, 0)
    if r2 != 0 {
        println("E-AST-REEMIT rc=" + (r2).to_string())
        return 1
    }
    var ser2 = ""
    var j: I32 = 0
    while j < out2.len {
        ser2 = ser2 + out2[j]
        j += 1
    }
    if seq2(ser, ser2) {
        println("ast roundtrip OK bytes=" + (ser.len).to_string())
        return 0
    }
    var p: I32 = 0
    while p < ser.len && p < ser2.len {
        if byte_at(ser, p) != byte_at(ser2, p) {
            break
        }
        p += 1
    }
    println("ast roundtrip DIFF at " + (p).to_string())
    return 1
}
