// =====================================================================
// pkg_dep.ct —— T49 依赖解析(§2.7):清单 dep 块扫描(三互斥 E5049,文案镜像
// C/Rust 线)+ semver 约束工具 + sha256(内容寻址;自包含移植 std/crypto.ct
// 12-504 行,前缀 pkg_ 避撞;phase-1 文本扫描口径同 pkg_plugins/pkg_caps_allowed
// ——规范形态清单,fail-closed 全量清单诊断由四线解析面承担)。
// =====================================================================

// 宽域零播种(strconv 同款):I64 变量以大字面量差分构造,值标签落在 6 域,
// 避免自举口径对小值按 I32 界假阳(乘 2 跨 2 的 31 次方即误报)
fn pkg_z64() -> I64 {
    var w: I64 = 4294967296
    return w - w
}

// 2 的 k 次幂(k ∈ 0..31;I64 承载)
fn pkg_p2(k: I32) -> I64 {
    var r: I64 = pkg_z64() + 1
    var i: I32 = 0
    while i < k {
        r = r * 2
        i += 1
    }
    return r
}

// 32 位异或(值域恒 0 到 4294967295;载荷恒 <2^32,i32 截断语义即所需)
fn xor32(a: I64, b: I64) -> I64 {
    return bit.xor_i64(a, b)
}

// 32 位与
fn and32(a: I64, b: I64) -> I64 {
    return bit.and_i64(a, b)
}

// 32 位取反(xor 0xFFFFFFFF 掩码——not_i64 会翻满 64 位,不可用)
fn not32(a: I64) -> I64 {
    var mask: I64 = pkg_z64() + 4294967295
    return bit.xor_i64(a, mask)
}

// 循环右移:低 32-n 位左移拼接高 n 位(拆分走算术,拼接走 bit;载荷 <2^32 无回绕差)
fn rotr32(v: I64, n: I32) -> I64 {
    var pn: I64 = pkg_p2(n)
    var high = v / pn
    var low = v - high * pn
    return bit.or_i64(bit.shl_i64(low, 32 - n), high)
}

// 逻辑右移(载荷非负,算术右移即逻辑右移)
fn shr32(v: I64, n: I32) -> I64 {
    return bit.shr_i64(v, n)
}

// 消息字节入 64 位域(自举口径无隐式拓宽,经 I64 加法中转)
fn pkg_msgb(msg: Str, g: I32) -> I64 {
    var t: I64 = pkg_z64()
    t = t + byte_at(msg, g)
    return t
}

// 十六进制小写数位
fn pkg_hexch(v: I64) -> Str {
    if v == 0 {
        return "0"
    }
    if v == 1 {
        return "1"
    }
    if v == 2 {
        return "2"
    }
    if v == 3 {
        return "3"
    }
    if v == 4 {
        return "4"
    }
    if v == 5 {
        return "5"
    }
    if v == 6 {
        return "6"
    }
    if v == 7 {
        return "7"
    }
    if v == 8 {
        return "8"
    }
    if v == 9 {
        return "9"
    }
    if v == 10 {
        return "a"
    }
    if v == 11 {
        return "b"
    }
    if v == 12 {
        return "c"
    }
    if v == 13 {
        return "d"
    }
    if v == 14 {
        return "e"
    }
    return "f"
}

// 32 位词转 8 位十六进制小写串
fn pkg_hex_word(h: I64) -> Str {
    var out = ""
    var pw: I64 = pkg_z64() + 268435456
    var k7: I32 = 0
    while k7 < 8 {
        out = out + pkg_hexch(h / pw % 16)
        pw = pw / 16
        k7 += 1
    }
    return out
}

// 轮常量(前 64 素数立方根小数部分前 32 位;FIPS 180-4 4.2.2)
