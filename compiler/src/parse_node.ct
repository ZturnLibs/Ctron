    ast_put(ktags, kshapes, "Syms", "S*")
    ast_put(ktags, kshapes, "Named", "SN")
    ast_put(ktags, kshapes, "TArgs", "N*")
    ast_put(ktags, kshapes, "TArgs2", "N*")
    ast_put(ktags, kshapes, "Ref", "N")
