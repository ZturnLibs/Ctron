    ast_put(ktags, kshapes, "For", "NNN")
    ast_put(ktags, kshapes, "Assign", "NSNS*")
}

// ---------------- 解析(建树):p_file(toks, cur, lns) → 文件节点树 ----------------
fn qtext(raw: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = raw.len
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 117 {
            // \u{HEX} 通用解码(1-6 位;经 utf8_enc 内建出 UTF-8 字节)
            var hx = ""
            var cp: I32 = 0
            var pp = j + 2
            var mapped = false
            if pp < n && byte_at(raw, pp) == 123 {
                pp += 1
                while pp < n && byte_at(raw, pp) != 125 {
                    var hc = byte_at(raw, pp)
                    if is_hex(hc) {
                        hx = hx + byte_slice(raw, pp, pp + 1)
                        cp = cp * 16 + digit_of(hc)
                    }
                    pp += 1
                }
                if hx.len > 0 {
                    out = out + utf8_enc(cp)
                    mapped = true
                }
            }
            if mapped {
                j = pp + 1
            } else {
                out = out + byte_slice(raw, j, j + 2)
                j += 2
            }
        } else if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 123 {
            out = out + "\{"
            j += 2
        } else {
            out = out + byte_slice(raw, j, j + 1)
            j += 1
        }
    }
    return out
}

fn parts_of(raw: Str) -> List[Str] {
    var np = mk("Parts")
    var k: I32 = 0
    var n = raw.len
    var j: I32 = 0
    var ts: I32 = 0
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 2 <= n {
            if j + 3 < n && byte_at(raw, j + 1) == 117 && byte_at(raw, j + 2) == 123 {
                var q = j + 3
                while q < n && byte_at(raw, q) != 125 { q += 1 }
                if q < n { j = q + 1 } else { j += 2 }
            } else {
                j += 2
            }
        } else if c == 123 {
            if j > ts {
                var tx = mk("Text")
                tx.push(qtext(byte_slice(raw, ts, j)))
                np.push(tx)
                k += 1
            }
            var d: I32 = 1
            var p = j + 1
            while d > 0 && p < n {
                var cp = byte_at(raw, p)
                if cp == 123 { d += 1 }
                if cp == 125 { d -= 1 }
                p += 1
            }
            var ix = mk("Interp")
            ix.push(qtext(byte_slice(raw, j + 1, p - 1)))
            np.push(ix)
            k += 1
            j = p
            ts = p
        } else {
            j += 1
        }
    }
    if n > ts {
        var ty = mk("Text")
        ty.push(qtext(byte_slice(raw, ts, n)))
        np.push(ty)
        k += 1
    }
    return np
}
