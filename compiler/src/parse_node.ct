// =====================================================================
// parse_node.ct —— 解析器树节点助手 + 字符串基础
// mk 建节点/nstamp 行号戳;qtext 引号原文还原;parts_of 插值片段切分
// ({expr} → Text/Interp 序列)。节点模型:child[0] = tag 的 List[Str]。
// =====================================================================
// ---------------- 树节点 ----------------
fn mk(t: Str) -> List[Str] {
    var n = List[Str]()
    n.push(t)
    return n
}

// 行号戳(lns 与 toks 平行,scan 产出):把行号串追加为节点末槽
fn nstamp(n: List[Str], line: Str) {
    n.push(line)
}

// ---------------- 形态表(S1a:tag → 槽位形状串;S=串槽 N=节点槽,末位 * = 变长) ----------------
fn ast_put(k: List[Str], v: List[Str], key: Str, val: Str) {
    k.push(key)
    v.push(val)
}

fn ast_shape(k: List[Str], v: List[Str], tag: Str) -> Str {
    var i: I32 = 0
    while i < k.len {
        if k[i] == tag {
            return v[i]
        }
        i += 1
    }
    return "?"
}

fn ast_kind(sh: Str, si: I32) -> Str {
    if sh.len == 0 {
        return "?"
    }
    var star = byte_slice(sh, sh.len - 1, sh.len) == "*"
    var n = sh.len
    if star {
        n = n - 1
    }
    if n == 0 {
        return "?"
    }
    var idx = si
    if idx >= n {
        if !star {
            return "?"
        }
        idx = n - 1
    }
    return byte_slice(sh, idx, idx + 1)
}

// 形态表(语料驱动增量;未知标签 fail-closed → 加表再验)——cc_ast(driver_ast)与
// pkg 加载器(选择性合并引用收集)共用;迁自 driver_ast.ct,逐字不变
fn ast_tables(ktags: List[Str], kshapes: List[Str]) {
    ast_put(ktags, kshapes, "File", "N*")
