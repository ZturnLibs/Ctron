// =====================================================================
// sem.ct —— 单文件语义检查(12 项全集,与 C 版 ctronc 逐字差分)
// 项:W8010 浅拷贝 / W8020 must-use / E4030 no_spawn / E3020 跨线程 Send /
//     E3031 spawn 形参 / E3060 own 内 GC 可变写 / E4020·E6020 pure·comptime
//     能力 / E3010 spawn 闭包捕获非 Send / E3050 own 内 arena
//     use-after-move / E2030 match 穷尽 / E3040 分配效果
// 接口:sem_walk2(file) → 诊断串(空串 = 通过),逐条 "CODE: msg\n"。
// =====================================================================
// ---------------- W8020 must-use / E4030 no_spawn(树上行走) ----------------
fn is_opt_ret(ty: List[Str]) -> Bool {
    if ty[0] == "Optional" { return true }
    if ty[0] == "Named" {
        var h = ty[1]
        if or2(h == "Option", h == "Result") { return true }
    }
    return false
}

// walk_block/Expr:返回诊断行;ns = no_spawn 上下文
fn is_cmp_op(op: Str) -> Bool {
    return or2(op == "Lt", or2(op == "Gt", or2(op == "Le", or2(op == "Ge", or2(op == "Eq", op == "Ne")))))
}
fn walk_e(file: List[Str], e: List[Str], ns: Bool, fns: List[Str], rets: List[Str], out: List[Str]) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        // E4030:.spawn 调用
        if ns && cal[0] == "Member" && cal[3] == "spawn" {
            out.push("E4030@" + nline(e) + ": no_spawn 上下文中的 spawn")
        }
        // W8020:丢弃 Option/Result 返回值(仅 Expr 语句层,见 stmt)
        if cal[0] == "TypeArgs" && cal[1].len > 0 && cal[1][0] == "Ident" && cal[1][1] == "Channel" {
            var ag2 = cal[2]
            if ag2.len > 1 {
                var el = ag2[1]
                if !send_of(file, el, 0) {
                    out.push("E3020@" + nline(e) + ": channel 元素非 Send(Send):Channel 元素类型")
                }
            }
        }
        walk_e(file, cal, ns, fns, rets, out)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            walk_e(file, ag[i], ns, fns, rets, out)
            i += 1
        }
        return
    }
    if t == "Member" {
        walk_e(file, e[1], ns, fns, rets, out)
        return
    }
    if t == "Binary" {
        // E1001:比较运算符不可链(a < b < c;钉子 §2,镜像 C 词法同款拦截)
        if is_cmp_op(e[1]) && e[2][0] == "Binary" && is_cmp_op(e[2][1]) {
            out.push("E1001@" + nline(e) + "(parse): 比较运算符不可链:写 a < b && b < c")
        }
        walk_e(file, e[2], ns, fns, rets, out)
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Unary" {
        walk_e(file, e[2], ns, fns, rets, out)
        return
    }
    if t == "Range" {
        walk_e(file, e[2], ns, fns, rets, out)
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Index" {
        walk_e(file, e[1], ns, fns, rets, out)
        walk_e(file, e[2], ns, fns, rets, out)
        return
    }
    if t == "TypeArgs" {
        walk_e(file, e[1], ns, fns, rets, out)
        return
    }
    if t == "Try" {
        walk_e(file, e[1], ns, fns, rets, out)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            walk_e(file, e[i2], ns, fns, rets, out)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        walk_b(file, e[1], ns, fns, rets, out)
        return
    }
    if t == "If" {
        walk_e(file, e[1], ns, fns, rets, out)
        walk_b(file, e[2], ns, fns, rets, out)
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Match" {
        walk_e(file, e[1], ns, fns, rets, out)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            var a = arms[i3]
            walk_e(file, a[2], ns, fns, rets, out)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Own" {
        walk_b(file, e[2], ns, fns, rets, out)
        return
    }
    if t == "Scope" {
        walk_b(file, e[2], ns, fns, rets, out)
        return
    }
}

fn walk_b(file: List[Str], b: List[Str], ns: Bool, fns: List[Str], rets: List[Str], out: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            walk_e(file, st[1], ns, fns, rets, out)
        } else if t == "Let" {
            walk_e(file, st[4], ns, fns, rets, out)
        } else if t == "While" {
            walk_e(file, st[1], ns, fns, rets, out)
            walk_b(file, st[2], ns, fns, rets, out)
        } else if t == "For" {
            walk_e(file, st[2], ns, fns, rets, out)
            walk_b(file, st[3], ns, fns, rets, out)
        } else if t == "Assign" {
            walk_e(file, st[3], ns, fns, rets, out)
        } else if t == "Expr" {
            // W8020:丢弃 Option/Result 返回值
            var ce = st[1]
            if ce[0] == "Call" {
                var cal2 = ce[1]
                if cal2[0] == "Ident" {
                    var nm2 = cal2[1]
                    var k: I32 = 0
                    var hit = false
                    while k < fns.len && !hit {
                        if fns[k] == nm2 {
                            hit = true
                            if is_opt_ret(rets[k]) {
                                out.push("W8020@" + nline(ce) + ": 结果被丢弃(must-use):" + nm2 + " 返回 Option/Result")
                            }
                        }
                        k += 1
                    }
                }
            }
            walk_e(file, ce, ns, fns, rets, out)
        }
        i += 1
    }
    walk_e(file, b[b.len - 1], ns, fns, rets, out)
}

// ---------------- Send 内核(照 C ty_send;未知保守 Send) ----------------
fn s_prim(n: Str) -> Bool {
    if n == "I8" { return true }
    if n == "I16" { return true }
    if n == "I32" { return true }
    if n == "I64" { return true }
    if n == "ISize" { return true }
    if n == "U8" { return true }
    if n == "U16" { return true }
    if n == "U32" { return true }
    if n == "U64" { return true }
    if n == "USize" { return true }
    if n == "F32" { return true }
    if n == "F64" { return true }
    if n == "Bool" { return true }
    if n == "Str" { return true }
    if n == "Void" { return true }
    return false
}
fn s_special(n: Str) -> Bool {
    if n == "Mutex" { return true }
    if n == "Atomic" { return true }
    if n == "Global" { return true }
    if n == "Sender" { return true }
    if n == "Receiver" { return true }
    if n == "Task" { return true }
    if n == "String" { return true }
    if n == "Box" { return true }
    if n == "Never" { return true }
    if n == "Option" { return true }
    if n == "Result" { return true }
    return false
}
fn decl_node(file: List[Str], tag: Str, name: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == tag && d[1] == name {
            return d
        }
        i += 1
    }
    return List[Str]()
}
fn send_of(file: List[Str], ty: List[Str], depth: I32) -> Bool {
    if depth > 16 { return true }
    if ty.len == 0 { return true }
    var t = ty[0]
    if t == "Named" {
        var n = ty[1]
        if s_prim(n) { return true }
        if s_special(n) { return true }
        var c = decl_node(file, "Class", n)
        if c.len > 0 {
            var items = c[3]
            var j: I32 = 1
            while j < items.len {
                var it = items[j]
                if it[0] == "Field" {
                    if it[1] == "true" { return false }
                    if !send_of(file, it[3], depth + 1) { return false }
                }
                j += 1
            }
            return true
        }
        var st = decl_node(file, "Struct", n)
        if st.len > 0 {
            var fs = st[4]
            var k: I32 = 1
            while k < fs.len {
                if !send_of(file, fs[k][3], depth + 1) { return false }
                k += 1
            }
            return true
        }
        var en = decl_node(file, "Enum", n)
        if en.len > 0 {
            var vs = en[3]
            var m: I32 = 1
            while m < vs.len {
                var v = vs[m]
                var kind = v[2]
                if kind[0] == "KTuple" {
                    var q: I32 = 1
                    while q < kind.len {
                        if !send_of(file, kind[q], depth + 1) { return false }
                        q += 1
                    }
                }
                if kind[0] == "KStruct" {
                    var q2: I32 = 1
                    while q2 < kind.len {
                        if !send_of(file, kind[q2][3], depth + 1) { return false }
                        q2 += 1
                    }
                }
                m += 1
            }
            return true
        }
        return true
    }
    if t == "Ref" {
        var sub = ty[1]
        if sub.len > 0 && sub[0] == "Named" {
            var n2 = sub[1]
            var tr = decl_node(file, "Trait", n2)
            if tr.len > 0 { return false }
        }
        if sub.len > 0 && sub[0] == "Slice" {
            return send_of(file, sub[1], depth + 1)
        }
        return send_of(file, sub, depth + 1)
    }
    if t == "Slice" { return false }
    if t == "ArrayT" { return send_of(file, ty[1], depth + 1) }
    if t == "Optional" { return send_of(file, ty[1], depth + 1) }
    if t == "TupleT" {
        var z: I32 = 1
        while z < ty.len {
            if !send_of(file, ty[z], depth + 1) { return false }
            z += 1
        }
        return true
    }
    return true
}

// ---- E3060:own 内对 GC 值可变写(env 近似;形参/let 注解或类构造字面量) ----
fn env_lookup(envN: List[Str], envC: List[Str], nm: Str) -> Str {
    var i = envN.len - 1
    while i >= 0 {
        if envN[i] == nm { return envC[i] }
        i -= 1
    }
    return ""
}
fn ch_of_type(file: List[Str], ty: List[Str]) -> Str {
    if ty.len == 0 { return "" }
    if ty[0] == "Named" {
        var n = ty[1]
        var c = decl_node(file, "Class", n)
        if c.len > 0 { return n }
    }
    return ""
}
fn walk6e(file: List[Str], e: List[Str], ow: Bool, envN: List[Str], envC: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Own" {
        walk6b(file, e[2], true, envN, envC, diags)
        return
    }
    if t == "If" {
        walk6e(file, e[1], ow, envN, envC, diags)
        walk6b(file, e[2], ow, envN, envC, diags)
        walk6e(file, e[3], ow, envN, envC, diags)
        return
    }
    if t == "BlockExpr" {
        walk6b(file, e[1], ow, envN, envC, diags)
        return
    }
    if t == "Match" {
        walk6e(file, e[1], ow, envN, envC, diags)
        var arms = e[2]
        var i2: I32 = 1
        while i2 < arms.len {
            walk6e(file, arms[i2][2], ow, envN, envC, diags)
            i2 += 1
        }
        return
    }
    if t == "Closure" {
        walk6e(file, e[3], ow, envN, envC, diags)
        return
    }
    if t == "Scope" {
        walk6b(file, e[2], ow, envN, envC, diags)
        return
    }
}
fn walk6b(file: List[Str], b: List[Str], ow: Bool, envN: List[Str], envC: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Let" {
            var ch = ""
            var ty0 = st[3]
            ch = ch_of_type(file, ty0)
            if ch == "" {
                var ex = st[4]
                if ex[0] == "StructLit" {
                    var cn = ex[1]
                    if decl_node(file, "Class", cn).len > 0 {
                        ch = cn
                    }
                }
            }
            var pat = st[2]
            if pat[0] == "PatId" && ch != "" {
                envN.push(pat[1])
                envC.push(ch)
            } else if pat[0] == "PatId" {
                envN.push(pat[1])
                envC.push("")
            }
        } else if t == "Assign" {
            if ow {
                var tgt = st[1]
                if tgt[0] == "Member" {
                    var obj = tgt[1]
                    if obj[0] == "Ident" {
                        var nm = obj[1]
                        var ch2 = env_lookup(envN, envC, nm)
                        if ch2 != "" {
                            diags.push("E3060@" + nline(st) + ": own 块内对 GC 值可变写(mutable):" + nm)
                        }
                    }
                }
            }
            walk6e(file, st[3], ow, envN, envC, diags)
        } else if t == "Return" {
            walk6e(file, st[1], ow, envN, envC, diags)
        } else if t == "Expr" {
            walk6e(file, st[1], ow, envN, envC, diags)
        } else if t == "While" {
            walk6e(file, st[1], ow, envN, envC, diags)
            walk6b(file, st[2], ow, envN, envC, diags)
        } else if t == "For" {
            walk6e(file, st[2], ow, envN, envC, diags)
            walk6b(file, st[3], ow, envN, envC, diags)
        }
        i += 1
    }
    walk6e(file, b[b.len - 1], ow, envN, envC, diags)
}
fn sem_e3060(file: List[Str], d: List[Str], tag: Str) -> Str {
    var out = ""
    var diags = List[Str]()
    var envN = List[Str]()
    var envC = List[Str]()
    var body = d[2]
    if tag != "Test" {
        body = d[5]
    }
    // 形参绑定(仅 Param;Receiver 跳过)
    var ps = List[Str]()
    if tag != "Test" {
        ps = d[3]
    }
    var k: I32 = 1
    while k < ps.len {
        var p = ps[k]
        if p[0] == "Param" {
            envN.push(p[2])
            envC.push(ch_of_type(file, p[3]))
        }
        k += 1
    }
    walk6b(file, body, false, envN, envC, diags)
    var q: I32 = 0
    while q < diags.len {
        out = out + diags[q] + "\n"
        q += 1
    }
    return out
}

// ---- E4020/E6020:pure/comptime 函数内 &Trait 接收者能力调用 ----
fn is_trait(file: List[Str], nm: Str) -> Bool {
    return decl_node(file, "Trait", nm).len > 0
}
fn env_ty(envN: List[Str], envT: List[Str], nm: Str) -> List[Str] {
    var i = envN.len - 1
    while i >= 0 {
        if envN[i] == nm { return envT[i] }
        i -= 1
    }
    return List[Str]()
}
fn cap_ty(file: List[Str], ty: List[Str]) -> Bool {
    if ty.len > 0 && ty[0] == "Ref" {
        var sub = ty[1]
        if sub.len > 0 && sub[0] == "Named" && is_trait(file, sub[1]) {
            return true
        }
    }
    return false
}
fn pwalk_e(file: List[Str], e: List[Str], code: Str, envN: List[Str], envT: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        if cal[0] == "Member" {
            var obj = cal[1]
            if obj[0] == "Ident" {
                var ty = env_ty(envN, envT, obj[1])
                if cap_ty(file, ty) {
                    diags.push(code + "@" + nline(e))
                }
            }
            pwalk_e(file, cal[1], code, envN, envT, diags)
        }
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            pwalk_e(file, ag[i], code, envN, envT, diags)
            i += 1
        }
        return
    }
    if t == "Member" {
        pwalk_e(file, e[1], code, envN, envT, diags)
        return
    }
    if t == "Binary" {
        pwalk_e(file, e[2], code, envN, envT, diags)
        pwalk_e(file, e[3], code, envN, envT, diags)
        return
    }
    if t == "Unary" {
        pwalk_e(file, e[2], code, envN, envT, diags)
        return
    }
    if t == "Range" {
        pwalk_e(file, e[2], code, envN, envT, diags)
        pwalk_e(file, e[3], code, envN, envT, diags)
        return
    }
    if t == "Index" {
        pwalk_e(file, e[1], code, envN, envT, diags)
        pwalk_e(file, e[2], code, envN, envT, diags)
        return
    }
    if t == "TypeArgs" {
        pwalk_e(file, e[1], code, envN, envT, diags)
        return
    }
    if t == "Try" {
        pwalk_e(file, e[1], code, envN, envT, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            pwalk_e(file, e[i2], code, envN, envT, diags)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        pwalk_b(file, e[1], code, envN, envT, diags)
        return
    }
    if t == "If" {
        pwalk_e(file, e[1], code, envN, envT, diags)
        pwalk_b(file, e[2], code, envN, envT, diags)
        pwalk_e(file, e[3], code, envN, envT, diags)
        return
    }
    if t == "Match" {
        pwalk_e(file, e[1], code, envN, envT, diags)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            pwalk_e(file, arms[i3][2], code, envN, envT, diags)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        pwalk_e(file, e[3], code, envN, envT, diags)
        return
    }
    if t == "Own" {
        pwalk_b(file, e[2], code, envN, envT, diags)
        return
    }
    if t == "Scope" {
        pwalk_b(file, e[2], code, envN, envT, diags)
        return
    }
}
fn pwalk_b(file: List[Str], b: List[Str], code: Str, envN: List[Str], envT: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            pwalk_e(file, st[1], code, envN, envT, diags)
        } else if t == "Expr" {
            pwalk_e(file, st[1], code, envN, envT, diags)
        } else if t == "While" {
            pwalk_e(file, st[1], code, envN, envT, diags)
            pwalk_b(file, st[2], code, envN, envT, diags)
        } else if t == "For" {
            pwalk_e(file, st[2], code, envN, envT, diags)
            pwalk_b(file, st[3], code, envN, envT, diags)
        } else if t == "Let" {
            var ex = st[4]
            if ex.len > 0 && ex[0] == "Closure" {
                pwalk_e(file, ex, code, envN, envT, diags)
            }
        }
        i += 1
    }
    pwalk_e(file, b[b.len - 1], code, envN, envT, diags)
}
fn sem_cap(file: List[Str], d: List[Str], kind: Str) -> Str {
    var diags = List[Str]()
    var envN = List[Str]()
    var envT = List[Str]()
    var body = d[5]
    var ps = d[3]
    var k: I32 = 1
    while k < ps.len {
        var p = ps[k]
        if p[0] == "Param" {
            envN.push(p[2])
            envT.push(p[3])
        }
        k += 1
    }
    pwalk_b(file, body, kind, envN, envT, diags)
    var out = ""
    var q: I32 = 0
    while q < diags.len {
        out = out + diags[q] + "\n"
        q += 1
    }
    return out
}

// ---- E3010:spawn 闭包捕获非 Send ----

// 捕获收集:闭包体内全部标识符(不区分作用域;env 命中才有效)
fn cle(file: List[Str], e: List[Str], names: List[Str]) {
    var t = e[0]
    if t == "Ident" {
        names.push(e[1])
        return
    }
    if t == "Call" {
        cle(file, e[1], names)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            cle(file, ag[i], names)
            i += 1
        }
        return
    }
    if t == "Member" {
        cle(file, e[1], names)
        return
    }
    if t == "Binary" {
        cle(file, e[2], names)
        cle(file, e[3], names)
        return
    }
    if t == "Unary" {
        cle(file, e[2], names)
        return
    }
    if t == "Range" {
        cle(file, e[2], names)
        cle(file, e[3], names)
        return
    }
    if t == "Index" {
        cle(file, e[1], names)
        cle(file, e[2], names)
        return
    }
    if t == "TypeArgs" {
        cle(file, e[1], names)
        return
    }
    if t == "Try" {
        cle(file, e[1], names)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            cle(file, e[i2], names)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        clb(file, e[1], names)
        return
    }
    if t == "If" {
        cle(file, e[1], names)
        clb(file, e[2], names)
        cle(file, e[3], names)
        return
    }
    if t == "Match" {
        cle(file, e[1], names)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            cle(file, arms[i3][2], names)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        cle(file, e[3], names)
        return
    }
    if t == "Own" {
        clb(file, e[2], names)
        return
    }
    if t == "Scope" {
        clb(file, e[2], names)
        return
    }
}
fn clb(file: List[Str], b: List[Str], names: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            cle(file, st[1], names)
        } else if t == "Expr" {
            cle(file, st[1], names)
        } else if t == "Let" {
            cle(file, st[4], names)
        } else if t == "While" {
            cle(file, st[1], names)
            clb(file, st[2], names)
        } else if t == "For" {
            cle(file, st[2], names)
            clb(file, st[3], names)
        } else if t == "Assign" {
            cle(file, st[3], names)
        }
        i += 1
    }
    cle(file, b[b.len - 1], names)
}
fn send_env(file: List[Str], nm: Str, envN: List[Str], envT: List[Str]) -> Bool {
    var i = envN.len - 1
    while i >= 0 {
        if envN[i] == nm {
            return send_of(file, envT[i], 0)
        }
        i -= 1
    }
    return true
}
fn let_ty(file: List[Str], st: List[Str]) -> List[Str] {
    var ann = st[3]
    if ann.len > 0 && ann[0] != "None" {
        return ann
    }
    var ex = st[4]
    if ex.len > 0 && ex[0] == "StructLit" {
        var cn = ex[1]
        if decl_node(file, "Class", cn).len > 0 {
            var nt = mk("Named")
            nt.push(cn)
            return nt
        }
    }
    return List[Str]()
}
fn wse(file: List[Str], e: List[Str], envN: List[Str], envT: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        if cal[0] == "Member" && cal[3] == "spawn" && e[2].len > 1 {
            var arg0 = e[2][1]
            if arg0[0] == "Closure" {
                var caps = List[Str]()
                cle(file, arg0[3], caps)
                var ci: I32 = 0
                var done = false
                while ci < caps.len && !done {
                    var nm = caps[ci]
                    if !send_env(file, nm, envN, envT) {
                        diags.push("E3010@" + nline(e) + ": spawn 捕获非 Send(Send):" + nm)
                        done = true
                    }
                    ci += 1
                }
            }
        }
        wse(file, cal, envN, envT, diags)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            wse(file, ag[i], envN, envT, diags)
            i += 1
        }
        return
    }
    if t == "Member" {
        wse(file, e[1], envN, envT, diags)
        return
    }
    if t == "Binary" {
        wse(file, e[2], envN, envT, diags)
        wse(file, e[3], envN, envT, diags)
        return
    }
    if t == "Unary" {
        wse(file, e[2], envN, envT, diags)
        return
    }
    if t == "Range" {
        wse(file, e[2], envN, envT, diags)
        wse(file, e[3], envN, envT, diags)
        return
    }
    if t == "Index" {
        wse(file, e[1], envN, envT, diags)
        wse(file, e[2], envN, envT, diags)
        return
    }
    if t == "TypeArgs" {
        wse(file, e[1], envN, envT, diags)
        return
    }
    if t == "Try" {
        wse(file, e[1], envN, envT, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            wse(file, e[i2], envN, envT, diags)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        wsb(file, e[1], envN, envT, diags)
        return
    }
    if t == "If" {
        wse(file, e[1], envN, envT, diags)
        wsb(file, e[2], envN, envT, diags)
        wse(file, e[3], envN, envT, diags)
        return
    }
    if t == "Match" {
        wse(file, e[1], envN, envT, diags)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            wse(file, arms[i3][2], envN, envT, diags)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        wse(file, e[3], envN, envT, diags)
        return
    }
    if t == "Own" {
        wsb(file, e[2], envN, envT, diags)
        return
    }
    if t == "Scope" {
        wsb(file, e[2], envN, envT, diags)
        return
    }
}
fn wsb(file: List[Str], b: List[Str], envN: List[Str], envT: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            wse(file, st[1], envN, envT, diags)
        } else if t == "Expr" {
            wse(file, st[1], envN, envT, diags)
        } else if t == "Let" {
            var ty = let_ty(file, st)
            var pat = st[2]
            if pat[0] == "PatId" {
                envN.push(pat[1])
                envT.push(ty)
            }
            wse(file, st[4], envN, envT, diags)
        } else if t == "While" {
            wse(file, st[1], envN, envT, diags)
            wsb(file, st[2], envN, envT, diags)
        } else if t == "For" {
            wse(file, st[2], envN, envT, diags)
            wsb(file, st[3], envN, envT, diags)
        } else if t == "Assign" {
            wse(file, st[3], envN, envT, diags)
        }
        i += 1
    }
    wse(file, b[b.len - 1], envN, envT, diags)
}
fn sem_spawn2(file: List[Str], d: List[Str], tag: Str) -> Str {
    var diags = List[Str]()
    var envN = List[Str]()
    var envT = List[Str]()
    var body = d[2]
    var ps = List[Str]()
    if tag != "Test" {
        body = d[5]
        ps = d[3]
    }
    var k: I32 = 1
    while k < ps.len {
        var p = ps[k]
        if p[0] == "Param" {
            envN.push(p[2])
            envT.push(p[3])
        }
        k += 1
    }
    wsb(file, body, envN, envT, diags)
    var out = ""
    var q: I32 = 0
    while q < diags.len {
        out = out + diags[q] + "\n"
        q += 1
    }
    return out
}

// ---- E3050:own 内 arena 句柄 use-after-move(arena_binds/moved 集) ----
fn in_list(ls: List[Str], nm: Str) -> Bool {
    var i: I32 = 0
    while i < ls.len {
        if ls[i] == nm { return true }
        i += 1
    }
    return false
}
fn rm_name(ls: List[Str], nm: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 0
    while i < ls.len {
        if ls[i] != nm {
            out.push(ls[i])
        }
        i += 1
    }
    return out
}
fn call_root_arena(e: List[Str]) -> Bool {
    if e.len > 0 && e[0] == "Call" {
        var cal = e[1]
        while cal.len > 0 && cal[0] == "TypeArgs" {
            cal = cal[1]
        }
        if cal.len > 0 && cal[0] == "Member" && cal[1].len > 0 && cal[1][0] == "Ident" && cal[1][1] == "arena" {
            return true
        }
    }
    return false
}

fn me(file: List[Str], e: List[Str], moved: List[Str], arenaB: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Ident" {
        if in_list(moved, e[1]) {
            diags.push("E3050@" + nline(e) + ": use-after-move(moved):arena 句柄 " + e[1])
        }
        return
    }
    if t == "Call" {
        me(file, e[1], moved, arenaB, diags)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            me(file, ag[i], moved, arenaB, diags)
            i += 1
        }
        return
    }
    if t == "Member" {
        me(file, e[1], moved, arenaB, diags)
        return
    }
    if t == "Index" {
        me(file, e[1], moved, arenaB, diags)
        me(file, e[2], moved, arenaB, diags)
        return
    }
    if t == "Binary" {
        me(file, e[2], moved, arenaB, diags)
        me(file, e[3], moved, arenaB, diags)
        return
    }
    if t == "Unary" {
        me(file, e[2], moved, arenaB, diags)
        return
    }
    if t == "Range" {
        me(file, e[2], moved, arenaB, diags)
        me(file, e[3], moved, arenaB, diags)
        return
    }
    if t == "TypeArgs" {
        me(file, e[1], moved, arenaB, diags)
        return
    }
    if t == "Try" {
        me(file, e[1], moved, arenaB, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            me(file, e[i2], moved, arenaB, diags)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        mb(file, e[1], moved, arenaB, diags)
        return
    }
    if t == "If" {
        me(file, e[1], moved, arenaB, diags)
        mb(file, e[2], moved, arenaB, diags)
        me(file, e[3], moved, arenaB, diags)
        return
    }
    if t == "Match" {
        me(file, e[1], moved, arenaB, diags)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            me(file, arms[i3][2], moved, arenaB, diags)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        me(file, e[3], moved, arenaB, diags)
        return
    }
    if t == "Own" {
        if e.len > 1 && !in_list(arenaB, e[1]) {
            arenaB.push(e[1])
        }
        mb(file, e[2], moved, arenaB, diags)
        return
    }
    if t == "Scope" {
        mb(file, e[2], moved, arenaB, diags)
        return
    }
}
fn mb(file: List[Str], b: List[Str], moved: List[Str], arenaB: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            me(file, st[1], moved, arenaB, diags)
        } else if t == "Expr" {
            me(file, st[1], moved, arenaB, diags)
        } else if t == "While" {
            me(file, st[1], moved, arenaB, diags)
            mb(file, st[2], moved, arenaB, diags)
        } else if t == "For" {
            me(file, st[2], moved, arenaB, diags)
            mb(file, st[3], moved, arenaB, diags)
        } else if t == "Let" {
            var pat = st[2]
            var init = st[4]
            var handled = false
            if init.len > 0 && init[0] == "Ident" {
                var src = init[1]
                if in_list(arenaB, src) {
                    moved.push(src)
                    arenaB = rm_name(arenaB, src)
                    if pat[0] == "PatId" {
                        arenaB.push(pat[1])
                    }
                    handled = true
                } else if in_list(moved, src) {
                    diags.push("E3050: use-after-move(moved):arena 句柄 " + src)
                    handled = true
                }
            }
            if !handled {
                if init.len > 0 && init[0] == "Call" && call_root_arena(init) {
                    if pat[0] == "PatId" && !in_list(arenaB, pat[1]) {
                        arenaB.push(pat[1])
                    }
                }
                me(file, init, moved, arenaB, diags)
            }
        } else if t == "Assign" {
            me(file, st[1], moved, arenaB, diags)
            me(file, st[3], moved, arenaB, diags)
        }
        i += 1
    }
    me(file, b[b.len - 1], moved, arenaB, diags)
}
fn sem_mv(file: List[Str], d: List[Str], tag: Str) -> Str {
    var diags = List[Str]()
    var moved = List[Str]()
    var arenaB = List[Str]()
    var body = d[2]
    var ps = List[Str]()
    if tag != "Test" {
        body = d[5]
        ps = d[3]
    }
    mb(file, body, moved, arenaB, diags)
    var out = ""
    var q: I32 = 0
    while q < diags.len {
        out = out + diags[q] + "\n"
        q += 1
    }
    return out
}

// ---- E2030:match 穷尽(scrutinee 类型→枚举/Option/Result 变体表;臂覆盖) ----
fn seq(a: Str, b: Str) -> Bool {
    if a.len != b.len { return false }
    var j: I32 = 0
    while j < a.len {
        if byte_at(a, j) != byte_at(b, j) { return false }
        j += 1
    }
    return true
}
fn variants_of(file: List[Str], ty: List[Str]) -> List[Str] {
    var vs = List[Str]()
    if ty.len == 0 { return vs }
    var t = ty[0]
    if t == "Optional" {
        vs.push("Some")
        vs.push("None")
        return vs
    }
    if t == "Named" {
        var n = ty[1]
        if or2(n == "Option", n == "Result") {
            if n == "Option" {
                vs.push("Some")
                vs.push("None")
            } else {
                vs.push("Ok")
                vs.push("Err")
            }
            return vs
        }
        var en = decl_node(file, "Enum", n)
        if en.len > 0 {
            var vars = en[3]
            var i: I32 = 1
            while i < vars.len {
                vs.push(vars[i][1])
                i += 1
            }
        }
    }
    return vs
}
fn ex_resolve(file: List[Str], scrut: List[Str], envN: List[Str], envT: List[Str]) -> List[Str] {
    if scrut.len > 0 && scrut[0] == "Ident" {
        var i = envN.len - 1
        while i >= 0 {
            if seq(envN[i], scrut[1]) {
                return envT[i]
            }
            i -= 1
        }
    }
    return List[Str]()
}
fn xe(file: List[Str], e: List[Str], envN: List[Str], envT: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Match" {
        var ty = ex_resolve(file, e[1], envN, envT)
        var vs = variants_of(file, ty)
        if vs.len > 0 {
            var covered = List[Str]()
            var whole = false
            var arms = e[2]
            var ai: I32 = 1
            while ai < arms.len && !whole {
                var arm = arms[ai]
                var pat = arm[1]
                if or2(pat[0] == "PatWild", pat[0] == "PatId") {
                    whole = true
                } else if pat[0] == "PatAgg" {
                    covered.push(pat[1])
                }
                ai += 1
            }
            if !whole {
                var miss = List[Str]()
                var vi: I32 = 0
                while vi < vs.len {
                    var hit = false
                    var ci: I32 = 0
                    while ci < covered.len {
                        if seq(covered[ci], vs[vi]) { hit = true }
                        ci += 1
                    }
                    if !hit { miss.push(vs[vi]) }
                    vi += 1
                }
                if miss.len > 0 {
                    var buf = ""
                    var mi: I32 = 0
                    while mi < miss.len {
                        if mi > 0 { buf = buf + " " }
                        buf = buf + miss[mi]
                        mi += 1
                    }
                    diags.push("E2030@" + nline(e) + ": match 不穷尽(not exhaustive):缺变体 " + buf)
                }
            }
        }
        // 继续递归
        xe(file, e[1], envN, envT, diags)
        var arms2 = e[2]
        var aj: I32 = 1
        while aj < arms2.len {
            xe(file, arms2[aj][2], envN, envT, diags)
            aj += 1
        }
        return
    }
    if t == "Call" {
        xe(file, e[1], envN, envT, diags)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            xe(file, ag[i], envN, envT, diags)
            i += 1
        }
        return
    }
    if t == "Member" {
        xe(file, e[1], envN, envT, diags)
        return
    }
    if t == "Binary" {
        xe(file, e[2], envN, envT, diags)
        xe(file, e[3], envN, envT, diags)
        return
    }
    if t == "Unary" {
        xe(file, e[2], envN, envT, diags)
        return
    }
    if t == "Index" {
        xe(file, e[1], envN, envT, diags)
        xe(file, e[2], envN, envT, diags)
        return
    }
    if t == "TypeArgs" {
        xe(file, e[1], envN, envT, diags)
        return
    }
    if t == "Try" {
        xe(file, e[1], envN, envT, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            xe(file, e[i2], envN, envT, diags)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        xb(file, e[1], envN, envT, diags)
        return
    }
    if t == "If" {
        xe(file, e[1], envN, envT, diags)
        xb(file, e[2], envN, envT, diags)
        xe(file, e[3], envN, envT, diags)
        return
    }
    if t == "Closure" {
        xe(file, e[3], envN, envT, diags)
        return
    }
    if t == "Own" {
        xb(file, e[2], envN, envT, diags)
        return
    }
    if t == "Scope" {
        xb(file, e[2], envN, envT, diags)
        return
    }
}
fn xb(file: List[Str], b: List[Str], envN: List[Str], envT: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            xe(file, st[1], envN, envT, diags)
        } else if t == "Expr" {
            xe(file, st[1], envN, envT, diags)
        } else if t == "Let" {
            var ann = st[3]
            var pat = st[2]
            if pat[0] == "PatId" {
                if ann.len > 0 && ann[0] != "None" {
                    envN.push(pat[1])
                    envT.push(ann)
                } else {
                    envN.push(pat[1])
                    envT.push(unk())
                }
            }
            xe(file, st[4], envN, envT, diags)
        } else if t == "While" {
            xe(file, st[1], envN, envT, diags)
            xb(file, st[2], envN, envT, diags)
        } else if t == "For" {
            xe(file, st[2], envN, envT, diags)
            xb(file, st[3], envN, envT, diags)
        } else if t == "Assign" {
            xe(file, st[3], envN, envT, diags)
        }
        i += 1
    }
    xe(file, b[b.len - 1], envN, envT, diags)
}
fn sem_exh(file: List[Str], d: List[Str], tag: Str) -> Str {
    var diags = List[Str]()
    var envN = List[Str]()
    var envT = List[Str]()
    var body = d[2]
    var ps = List[Str]()
    if tag != "Test" {
        body = d[5]
        ps = d[3]
    }
    var k: I32 = 1
    while k < ps.len {
        var p = ps[k]
        if p[0] == "Param" {
            envN.push(p[2])
            envT.push(p[3])
        }
        k += 1
    }
    xb(file, body, envN, envT, diags)
    var out = ""
    var q: I32 = 0
    while q < diags.len {
        out = out + diags[q] + "\n"
        q += 1
    }
    return out
}

// ---------------- E3040:分配效果(own/#[no_alloc]/契约 内 GC 分配) ----------------
fn has_noalloc(node: List[Str]) -> Bool {
    return node.len >= 7 && node[6] == "no_alloc"
}
fn mem_target(m: List[Str]) -> Str {
    // Member: [Member,obj,kind,name]
    if m.len > 3 { return m[3] }
    return ""
}
fn fn_alloc_sum(file: List[Str], nm: Str, vis: List[Str]) -> Bool {
    // 环防:vis 含 nm → 保守分配
    var i: I32 = 0
    while i < vis.len {
        if seq(vis[i], nm) { return true }
        i += 1
    }
    var d = decl_node(file, "Fn", nm)
    if d.len == 0 {
        return false
    }
    if has_noalloc(d) { return false }
    if d.len >= 7 && d[6] == "no_spawn" { } // 与分配无关
    vis.push(nm)
    var body = d[5]
    var r = scan_alloc(file, body, vis)
    // pop 近似:不需要
    return r
}
fn scan_alloc(file: List[Str], b: List[Str], vis: List[Str]) -> Bool {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            if sc_e(file, st[1], vis) { return true }
        } else if t == "Expr" {
            if sc_e(file, st[1], vis) { return true }
        } else if t == "Let" {
            if sc_e(file, st[4], vis) { return true }
        } else if t == "While" {
            if sc_e(file, st[1], vis) { return true }
            if scan_alloc(file, st[2], vis) { return true }
        } else if t == "For" {
            if sc_e(file, st[2], vis) { return true }
            if scan_alloc(file, st[3], vis) { return true }
        } else if t == "Assign" {
            if sc_e(file, st[3], vis) { return true }
        }
        i += 1
    }
    if sc_e(file, b[b.len - 1], vis) { return true }
    return false
}
fn sc_e(file: List[Str], e: List[Str], vis: List[Str]) -> Bool {
    var t = e[0]
    if t == "Call" {
        if call_allocish(file, e, vis) { return true }
        if sc_e(file, e[1], vis) { return true }
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            if sc_e(file, ag[i], vis) { return true }
            i += 1
        }
        return false
    }
    if t == "Member" {
        return sc_e(file, e[1], vis)
    }
    if t == "Index" {
        if sc_e(file, e[1], vis) { return true }
        if sc_e(file, e[2], vis) { return true }
        return false
    }
    if t == "Binary" {
        if sc_e(file, e[2], vis) { return true }
        if sc_e(file, e[3], vis) { return true }
        return false
    }
    if t == "Unary" {
        return sc_e(file, e[2], vis)
    }
    if t == "Range" {
        if sc_e(file, e[2], vis) { return true }
        if sc_e(file, e[3], vis) { return true }
        return false
    }
    if t == "TypeArgs" {
        return sc_e(file, e[1], vis)
    }
    if t == "Try" {
        return sc_e(file, e[1], vis)
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            if sc_e(file, e[i2], vis) { return true }
            i2 += 1
        }
        return false
    }
    if t == "StructLit" {
        var cn = e[1]
        if decl_node(file, "Class", cn).len > 0 { return true }
        var lf = e[2]
        var j: I32 = 1
        while j < lf.len {
            if sc_e(file, lf[j][2], vis) { return true }
            j += 1
        }
        return false
    }
    if t == "BlockExpr" {
        return scan_alloc(file, e[1], vis)
    }
    if t == "If" {
        if sc_e(file, e[1], vis) { return true }
        if scan_alloc(file, e[2], vis) { return true }
        if sc_e(file, e[3], vis) { return true }
        return false
    }
    if t == "Match" {
        if sc_e(file, e[1], vis) { return true }
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            if sc_e(file, arms[i3][2], vis) { return true }
            i3 += 1
        }
        return false
    }
    if t == "Closure" {
        return sc_e(file, e[3], vis)
    }
    if t == "Own" {
        return scan_alloc(file, e[2], vis)
    }
    if t == "Scope" {
        return scan_alloc(file, e[2], vis)
    }
    return false
}
fn call_allocish(file: List[Str], e: List[Str], vis: List[Str]) -> Bool {
    var cal = e[1]
    if cal[0] == "Member" {
        var m = mem_target(cal)
        if seq(m, "to_string") { return true }
        if seq(m, "into_gc") { return true }
        if seq(m, "push") { return true }
        // arena.list/array/zeros 且 root arena → 非分配
        if or3(seq(m, "list"), seq(m, "array"), seq(m, "zeros")) {
            var obj = cal[1]
            if obj[0] == "Ident" && seq(obj[1], "arena") { return false }
            return false
        }
        return false
    }
    if cal[0] == "TypeArgs" && cal[1][0] == "Ident" {
        var n = cal[1][1]
        if or2(or2(seq(n, "Box"), seq(n, "List")), or2(seq(n, "Map"), seq(n, "String"))) {
            return true
        }
        return false
    }
    if cal[0] == "Ident" {
        return fn_alloc_sum(file, cal[1], vis)
    }
    return false
}

fn member_root(m: List[Str]) -> Str {
    var c = m
    while c.len > 0 && c[0] == "Member" && c[1].len > 0 && c[1][0] == "Member" {
        c = c[1]
    }
    if c.len > 0 && c[0] == "Member" && c[1].len > 0 && c[1][0] == "Ident" {
        return c[1][1]
    }
    if c.len > 0 && c[0] == "Ident" {
        return c[1]
    }
    return ""
}
fn al_e(file: List[Str], e: List[Str], ow: Bool, na: Bool, arenaB: List[Str], gcL: List[Str], diags: List[Str]) {
    var restricted = or2(ow, na)
    var t = e[0]
    if t == "Call" && restricted {
        var cal = e[1]
        var alloc = false
        var kind = "调用"
        if cal[0] == "Member" {
            var m = mem_target(cal)
            if seq(m, "to_string") {
                alloc = true
                kind = member_root(cal)
            } else if seq(m, "into_gc") {
                alloc = !ow
                kind = member_root(cal)
            } else if seq(m, "push") {
                if ow {
                    var obj = cal[1]
                    var allow = false
                    if obj.len > 0 && obj[0] == "Ident" {
                        if in_list(arenaB, obj[1]) { allow = true }
                        if in_list(gcL, obj[1]) { allow = true }
                    }
                    if !allow { alloc = true }
                } else {
                    alloc = true
                }
                kind = member_root(cal)
            }
        } else if cal[0] == "TypeArgs" && cal[1].len > 0 && cal[1][0] == "Ident" {
            var n = cal[1][1]
            if or2(or2(seq(n, "Box"), seq(n, "List")), or2(seq(n, "Map"), seq(n, "String"))) {
                alloc = true
                kind = n
            }
        } else if cal[0] == "Ident" {
            if fn_alloc_sum(file, cal[1], List[Str]()) {
                alloc = true
                kind = cal[1]
            }
        }
        if alloc {
            if ow {
                diags.push("E3040@" + nline(e) + ": own 块内 GC 分配(allocation):" + kind)
            } else {
                diags.push("E3040@" + nline(e) + ": no_alloc 上下文 GC 分配(allocation):" + kind)
            }
            return
        }
        // 不是分配则继续递归(arena op 等在允许/不判断路径照常)
    }
    if t == "StructLit" && restricted {
        var cn = e[1]
        if decl_node(file, "Class", cn).len > 0 {
            if ow {
                diags.push("E3040@" + nline(e) + ": own 块内 GC 分配(allocation):类构造")
            } else {
                diags.push("E3040@" + nline(e) + ": no_alloc 上下文 GC 分配(allocation):类构造")
            }
            return
        }
    }
    if t == "Call" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            al_e(file, ag[i], ow, na, arenaB, gcL, diags)
            i += 1
        }
        return
    }
    if t == "Member" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Index" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        al_e(file, e[2], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Binary" {
        al_e(file, e[2], ow, na, arenaB, gcL, diags)
        al_e(file, e[3], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Unary" {
        al_e(file, e[2], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Range" {
        al_e(file, e[2], ow, na, arenaB, gcL, diags)
        al_e(file, e[3], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "TypeArgs" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Try" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            al_e(file, e[i2], ow, na, arenaB, gcL, diags)
            i2 += 1
        }
        return
    }
    if t == "StructLit" {
        var lf = e[2]
        var j: I32 = 1
        while j < lf.len {
            al_e(file, lf[j][2], ow, na, arenaB, gcL, diags)
            j += 1
        }
        return
    }
    if t == "BlockExpr" {
        al_b(file, e[1], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "If" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        al_b(file, e[2], ow, na, arenaB, gcL, diags)
        al_e(file, e[3], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Match" {
        al_e(file, e[1], ow, na, arenaB, gcL, diags)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            al_e(file, arms[i3][2], ow, na, arenaB, gcL, diags)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        al_e(file, e[3], ow, na, arenaB, gcL, diags)
        return
    }
    if t == "Own" {
        if e.len > 1 && !in_list(arenaB, e[1]) {
            arenaB.push(e[1])
        }
        al_b(file, e[2], true, na, arenaB, gcL, diags)
        return
    }
    if t == "Scope" {
        al_b(file, e[2], ow, na, arenaB, gcL, diags)
        return
    }
}
fn al_b(file: List[Str], b: List[Str], ow: Bool, na: Bool, arenaB: List[Str], gcL: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            al_e(file, st[1], ow, na, arenaB, gcL, diags)
        } else if t == "Expr" {
            al_e(file, st[1], ow, na, arenaB, gcL, diags)
        } else if t == "Let" {
            var pat = st[2]
            var init = st[4]
            if ow {
                var handled = false
                if init.len > 0 && init[0] == "Ident" {
                    var src = init[1]
                    if in_list(arenaB, src) {
                        arenaB = rm_name(arenaB, src)
                        if pat[0] == "PatId" {
                            arenaB.push(pat[1])
                        }
                        handled = true
                    }
                }
                if !handled && init.len > 0 && init[0] == "Call" {
                    var cal = init[1]
                    if cal.len > 0 && cal[0] == "Member" && seq(mem_target(cal), "into_gc") {
                        if pat[0] == "PatId" && !in_list(gcL, pat[1]) {
                            gcL.push(pat[1])
                        }
                    } else if cal.len > 0 && cal[0] == "TypeArgs" && cal[1].len > 0 && cal[1][0] == "Member"
                        && cal[1][1].len > 0 && cal[1][1][0] == "Ident" && seq(cal[1][1][1], "arena") {
                        if pat[0] == "PatId" && !in_list(arenaB, pat[1]) {
                            arenaB.push(pat[1])
                        }
                    }
                }
            }
            al_e(file, init, ow, na, arenaB, gcL, diags)
        } else if t == "While" {
            al_e(file, st[1], ow, na, arenaB, gcL, diags)
            al_b(file, st[2], ow, na, arenaB, gcL, diags)
        } else if t == "For" {
            al_e(file, st[2], ow, na, arenaB, gcL, diags)
            al_b(file, st[3], ow, na, arenaB, gcL, diags)
        } else if t == "Assign" {
            al_e(file, st[1], ow, na, arenaB, gcL, diags)
            al_e(file, st[3], ow, na, arenaB, gcL, diags)
        }
        i += 1
    }
    al_e(file, b[b.len - 1], ow, na, arenaB, gcL, diags)
}
fn sem_alloc(file: List[Str], d: List[Str], tag: Str) -> Str {
    var diags = List[Str]()
    var arenaB = List[Str]()
    var gcL = List[Str]()
    var body = d[2]
    var na = false
    if tag != "Test" {
        body = d[5]
        if has_noalloc(d) { na = true }
    }
    al_b(file, body, false, na, arenaB, gcL, diags)
    var out = ""
    var q: I32 = 0
    while q < diags.len {
        out = out + diags[q] + "\n"
        q += 1
    }
    return out
}
fn trait_method_noalloc(file: List[Str], tr: Str, mnm: Str) -> Bool {
    var td = decl_node(file, "Trait", tr)
    if td.len > 0 {
        var items = td[4]
        var i: I32 = 1
        while i < items.len {
            var it = items[i]
            if it[0] == "Method" && seq(it[1], mnm) && has_noalloc(it) {
                return true
            }
            i += 1
        }
    }
    return false
}
fn sem_walk2(file: List[Str]) -> Str {
    var out = ""
    var diags = List[Str]()
    // 预扫描:class 名、fn 名+ret、attr
    var cls = List[Str]()
    var fns = List[Str]()
    var rets = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if t == "Class" {
            cls.push(d[1])
        } else if or2(t == "Fn", or2(t == "FnC", or2(t == "FnPub", t == "FnExt"))) {
            fns.push(d[1])
            rets.push(d[4])
        } else if t == "Method" {
            fns.push(d[1])
            rets.push(d[4])
        } else if t == "Static" && d[2] == "true" {
            diags.push("E3030@" + nline(d) + ": static var 不存在;用 static let 或 Global[T]:" + d[1])
        }
        i += 1
    }
    // 声明序遍历
    i = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if t == "Struct" {
            var nm = d[1]
            var hit = false
            var hn = ""
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len && !hit {
                var f = fs[j]
                var ty = f[3]
                if ty[0] == "Named" {
                    var h = ty[1]
                    var k: I32 = 0
                    while k < cls.len && !hit {
                        if cls[k] == h {
                            hit = true
                            hn = f[2]
                        }
                        k += 1
                    }
                }
                j += 1
            }
            if hit {
                diags.push("W8010@" + nline(d) + ": struct 含类引用字段(浅拷贝):" + nm + "." + hn)
            }
        } else if or2(t == "Fn", or2(t == "FnC", t == "FnPub")) {
            var ns = false
            if d.len >= 7 && d[6] == "no_spawn" {
                ns = true
            }
            walk_b(file, d[5], ns, fns, rets, diags)
            var e6 = sem_e3060(file, d, t)
            if e6 != "" {
                diags.push(byte_slice(e6, 0, e6.len - 1))
            }
            var ckind = ""
            if d.len >= 7 && d[6] == "pure" {
                ckind = "E4020: pure 函数含能力调用(pure)"
            } else if t == "FnC" {
                ckind = "E6020: comptime 函数含能力调用(comptime)"
            }
            if ckind != "" {
                var ec = sem_cap(file, d, ckind)
                if ec != "" {
                    diags.push(byte_slice(ec, 0, ec.len - 1))
                }
            }
            if !(d.len >= 7 && d[6] == "no_spawn") {
                var es = sem_spawn2(file, d, t)
                if es != "" {
                    diags.push(byte_slice(es, 0, es.len - 1))
                }
            }
            var mv = sem_mv(file, d, t)
            if mv != "" {
                diags.push(byte_slice(mv, 0, mv.len - 1))
            }
            var ex = sem_exh(file, d, t)
            if ex != "" {
                diags.push(byte_slice(ex, 0, ex.len - 1))
            }
            var ac = sem_alloc(file, d, t)
            if ac != "" {
                diags.push(byte_slice(ac, 0, ac.len - 1))
            }
        } else if t == "Test" {
            walk_b(file, d[2], false, fns, rets, diags)
            var e6b = sem_e3060(file, d, "Test")
            if e6b != "" {
                diags.push(byte_slice(e6b, 0, e6b.len - 1))
            }
            var es2 = sem_spawn2(file, d, "Test")
            if es2 != "" {
                diags.push(byte_slice(es2, 0, es2.len - 1))
            }
            var mv2 = sem_mv(file, d, "Test")
            if mv2 != "" {
                diags.push(byte_slice(mv2, 0, mv2.len - 1))
            }
            var ex2 = sem_exh(file, d, "Test")
            if ex2 != "" {
                diags.push(byte_slice(ex2, 0, ex2.len - 1))
            }
            var ac2 = sem_alloc(file, d, "Test")
            if ac2 != "" {
                diags.push(byte_slice(ac2, 0, ac2.len - 1))
            }
        } else if t == "Static" {
            if !send_of(file, d[3], 0) {
                diags.push("E3031@" + nline(d) + ": static 存储非 Send(Send):" + d[1])
            }
        } else if t == "Impl" {
            var tr = d[2]
            var trname = ""
            if tr.len > 0 && tr[0] == "Named" {
                trname = tr[1]
            }
            var its = d[4]
            var mi: I32 = 1
            while mi < its.len {
                var md = its[mi]
                if md[0] == "Method" {
                    var mna = or2(has_noalloc(md), trait_method_noalloc(file, trname, md[1]))
                    if mna {
                        var dl = List[Str]()
                        var ab = List[Str]()
                        var gl = List[Str]()
                        al_b(file, md[5], false, true, ab, gl, dl)
                        var qq: I32 = 0
                        while qq < dl.len {
                            diags.push(dl[qq])
                            qq += 1
                        }
                    }
                }
                mi += 1
            }
        }
        i += 1
    }
    // E2020/E2010:名字解析与类型统一 v1(见文件尾新节)
    sem_calls_all(file, diags)
    // E6020/E6010:comptime 副作用扫描 + const/static-let 编译期试求值(见文件尾新节)
    sem_comp(file, diags)
    var kk: I32 = 0
    while kk < diags.len {
        out = out + diags[kk] + "\n"
        kk += 1
    }
    return out
}
fn seq2(a: Str, b: Str) -> Bool {
    if a.len != b.len { return false }
    var j: I32 = 0
    while j < a.len {
        if byte_at(a, j) != byte_at(b, j) { return false }
        j += 1
    }
    return true
}


// ---------------- E2020/E2010:名字解析与类型统一 v1(2026-09-09) ----------------
// 范围:bare 调用目标 + Ident 读解析 + 基础类型统一(let/return/实参/二元/条件/? )。
// 成员调用面(UFCS/方法表解析)与内建类型留 v2。保守可证:任一侧类型未知即放行;
// 字面量按期望整/浮自适应(§3.7);T→T?、String→Str、T[N]→T[] 按 §3.6 白名单放行。
// tc 打包:tc[0]=fns tc[1]=ars tc[2]=rets tc[3]=prms tc[4]=stN tc[5]=stT
//          tc[6]=vars tc[7]=varAr tc[8]=enums tc[9]=lets tc[10]=reads
//          tc[11]=isrc(插值原文) tc[12]=prel(前奏名,W8040) tc[13]=tpars(类型参数名)
fn prelude_ok(nm: Str) -> Bool {
    if or2(seq2(nm, "print"), or2(seq2(nm, "println"), seq2(nm, "panic"))) { return true }
    if or2(seq2(nm, "assert"), or2(seq2(nm, "assert_eq"), seq2(nm, "assert_ne"))) { return true }
    if or2(seq2(nm, "read_file"), or2(seq2(nm, "read_dir"), or2(seq2(nm, "byte_at"), seq2(nm, "byte_slice")))) { return true }
    if seq2(nm, "ctron_entry") { return true }
    if or2(seq2(nm, "Some"), or2(seq2(nm, "None"), or2(seq2(nm, "Ok"), seq2(nm, "Err")))) { return true }
    if or2(seq2(nm, "fmt"), or2(seq2(nm, "char_len"), or2(seq2(nm, "Box"), seq2(nm, "List")))) { return true }
    if or2(seq2(nm, "String"), or2(seq2(nm, "Channel"), or2(seq2(nm, "Mutex"), seq2(nm, "Atomic")))) { return true }
    if or2(seq2(nm, "Global"), or2(seq2(nm, "Task"), or2(seq2(nm, "Scope"), seq2(nm, "Simd")))) { return true }
    return or2(seq2(nm, "Option"), or2(seq2(nm, "Result"), seq2(nm, "AnyError")))
}

fn value_ok(nm: Str) -> Bool {
    if prelude_ok(nm) { return true }
    return or2(seq2(nm, "parallel"), seq2(nm, "arena"))
}

fn prelude_arity(nm: Str) -> I32 {
    if or2(seq2(nm, "Some"), or2(seq2(nm, "Ok"), seq2(nm, "Err"))) { return 1 }
    if seq2(nm, "None") { return 0 }
    return -1
}

fn root_name(e: List[Str]) -> Str {
    var t = e[0]
    if t == "Ident" { return e[1] }
    if t == "TypeArgs" { return root_name(e[1]) }
    return ""
}

fn bind_pat(pp: List[Str], loc: List[Str], envT: List[Str], tn: List[Str]) {
    var t = pp[0]
    if t == "PatId" {
        loc.push(pp[1])
        envT.push(tn)
    } else if t == "PatTup" {
        var i: I32 = 1
        while i < pp.len {
            bind_pat(pp[i], loc, envT, unk())
            i += 1
        }
    } else if t == "PatAgg" {
        if pp.len > 2 {
            var sub = pp[2]
            var j: I32 = 1
            while j < sub.len {
                var c = sub[j]
                if seq2(c[0], "PatFld") {
                    if c[2].len > 1 {
                        bind_pat(c[2], loc, envT, unk())
                    } else {
                        loc.push(c[1])
                        envT.push(unk())
                    }
                } else {
                    bind_pat(c, loc, envT, unk())
                }
                j += 1
            }
        }
    }
}

// 类型 kind(§3.1):n:<名> / opt:<内> / ref:<内> / slice / arr / tup / fn / ""=未知
fn ty_kind(ty: List[Str]) -> Str {
    var t = ty[0]
    if t == "Named" {
        return "n:" + ty[1]
    }
    if t == "Optional" {
        return "opt:" + ty_kind(ty[1])
    }
    if t == "Ref" {
        return "ref:" + ty_kind(ty[1])
    }
    if t == "Slice" {
        return "slice"
    }
    if t == "ArrayT" {
        return "arr"
    }
    if t == "TupleT" {
        return "tup"
    }
    if or2(t == "FnT", t == "FnType") {
        return "fn"
    }
    return ""
}

fn k_int5(k: Str) -> Bool {
    return or2(seq2(k, "n:I8"), or2(seq2(k, "n:I16"), or2(seq2(k, "n:I32"), or2(seq2(k, "n:I64"), seq2(k, "n:ISize")))))
}

fn k_uint5(k: Str) -> Bool {
    return or2(seq2(k, "n:U8"), or2(seq2(k, "n:U16"), or2(seq2(k, "n:U32"), or2(seq2(k, "n:U64"), seq2(k, "n:USize")))))
}

fn k_int(k: Str) -> Bool {
    return or2(k_int5(k), k_uint5(k))
}

fn k_num(k: Str) -> Bool {
    if k_int(k) {
        return true
    }
    return or2(seq2(k, "n:F32"), seq2(k, "n:F64"))
}

fn k_strish(k: Str) -> Bool {
    return or2(seq2(k, "n:Str"), seq2(k, "n:String"))
}

// 相容性:未知放行;相等放行;Int 字面量适配数值期望、Float 字面量适配浮期望(§3.7);
// T→T?、String→Str、T[N]→T[] 隐式(§3.6);其余不相容。
// 常量字面量折叠表达式(Int/一元负号/二元算术全字面量)——按 §3.7 自适应数值期望
fn all_int_lit(e: List[Str]) -> Bool {
    var t = e[0]
    if t == "Int" {
        return true
    }
    if t == "Unary" {
        return all_int_lit(e[2])
    }
    if seq2(t, "Binary") {
        var op = e[1]
        if or2(seq2(op, "Add"), or2(seq2(op, "Sub"), or2(seq2(op, "Mul"), or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "WrapAdd"), seq2(op, "WrapSub"))))))) {
            return all_int_lit(e[2]) && all_int_lit(e[3])
        }
    }
    return false
}

fn compat(exp: Str, act: Str, e: List[Str], file: List[Str], tc: List[Str]) -> Bool {
    if exp.len == 0 {
        return true
    }
    if act.len == 0 {
        return true
    }
    if seq2(exp, act) {
        return true
    }
    // 泛型类型参数期望(单态化前不可证)放行
    if in_list(tc[13], exp) {
        return true
    }
    if exp.len > 4 && seq2(byte_slice(exp, 0, 4), "ref:") {
        var tn = byte_slice(exp, 4, exp.len)
        if seq2(byte_slice(tn, 0, 2), "n:") {
            if is_trait(file, byte_slice(tn, 2, tn.len)) {
                return true
            }
        }
    }
    if seq2(byte_slice(exp, 0, 2), "n:") {
        if is_trait(file, byte_slice(exp, 2, exp.len)) {
            return true
        }
    }
    if all_int_lit(e) {
        return k_num(exp)
    }
    var t = e[0]
    if t == "Int" {
        return k_num(exp)
    }
    if t == "Float" {
        return or2(seq2(exp, "n:F32"), seq2(exp, "n:F64"))
    }
    if exp.len >= 4 && seq2(byte_slice(exp, 0, 4), "opt:") {
        return seq2(exp, "opt:" + act)
    }
    if seq2(exp, "n:Str") {
        return seq2(act, "n:String")
    }
    if seq2(exp, "slice") {
        return seq2(act, "arr")
    }
    if seq2(exp, "ref:slice") {
        return or2(seq2(act, "slice"), seq2(act, "arr"))
    }
    return false
}

// 节点行号(解析器 span 标注:末槽十进制数字串;无/非法 → "0" 由驱动回退探针)
fn nline(n: List[Str]) -> Str {
    if n.len == 0 {
        return "0"
    }
    var last = n[n.len - 1]
    var i: I32 = 0
    while i < last.len {
        var c = byte_at(last, i)
        var dig = true
        if c < 48 {
            dig = false
        }
        if c > 57 {
            dig = false
        }
        if !dig {
            return "0"
        }
        i += 1
    }
    if last.len == 0 {
        return "0"
    }
    return last
}

// "已知局部、类型未知"哨兵:阻断 Ident 解析穿透到 fn 名集(同名遮蔽语义)
fn unk() -> List[Str] {
    var u = List[Str]()
    u.push("Unknown")
    return u
}

fn kind_node(k: Str) -> List[Str] {
    if k.len >= 2 && seq2(byte_slice(k, 0, 2), "n:") {
        var nt = List[Str]()
        nt.push("Named")
        nt.push(byte_slice(k, 2, k.len))
        nt.push(List[Str]())
        return nt
    }
    return unk()
}

fn idx_of(ls: List[Str], nm: Str) -> I32 {
    var i: I32 = 0
    while i < ls.len {
        if seq2(ls[i], nm) {
            return i
        }
        i += 1
    }
    return -1
}

fn fn_ret_of(tc: List[Str], nm: Str) -> List[Str] {
    var g: I32 = 0
    while g < tc[0].len {
        if seq2(tc[0][g], nm) {
            return tc[2][g]
        }
        g += 1
    }
    return List[Str]()
}

fn ex_ty(e: List[Str], tc: List[Str], loc: List[Str], envT: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" {
        return "n:I32"
    }
    if t == "Float" {
        return "n:F64"
    }
    if t == "Str" {
        return "n:Str"
    }
    if t == "Bool" {
        return "n:Bool"
    }
    if t == "Void" {
        return "void"
    }
    if t == "Range" {
        return "range"
    }
    if t == "Ident" {
        var nm = e[1]
        var b = env_ty(loc, envT, nm)
        if b.len > 0 {
            return ty_kind(b)
        }
        var g = env_ty(tc[4], tc[5], nm)
        if g.len > 0 {
            return ty_kind(g)
        }
        if in_list(tc[0], nm) {
            return "fn"
        }
        return ""
    }
    if t == "Closure" {
        return "fn"
    }
    if t == "StructLit" {
        return "n:" + e[1]
    }
    if t == "Call" {
        var rt = root_name(e[1])
        if rt.len > 0 {
            var r = fn_ret_of(tc, rt)
            if r.len > 0 {
                return ty_kind(r)
            }
        }
        return ""
    }
    if t == "Unary" {
        if seq2(e[1], "Not") {
            return "n:Bool"
        }
        return ex_ty(e[2], tc, loc, envT)
    }
    if t == "If" {
        var a = ex_ty(e[2], tc, loc, envT)
        var b2 = ex_ty(e[3], tc, loc, envT)
        if seq2(a, b2) {
            return a
        }
        return ""
    }
    if t == "Binary" {
        var op = e[1]
        if is_cmp_op(op) {
            return "n:Bool"
        }
        if seq2(op, "AndAnd") {
            return "n:Bool"
        }
        var lt = ex_ty(e[2], tc, loc, envT)
        var rt2 = ex_ty(e[3], tc, loc, envT)
        if seq2(op, "Add") && k_strish(lt) && k_strish(rt2) {
            return "n:Str"
        }
        if k_num(lt) && k_num(rt2) {
            if seq2(lt, rt2) {
                return lt
            }
            return ""
        }
        if seq2(lt, rt2) {
            return lt
        }
        return ""
    }
    return ""
}

fn tce(file: List[Str], e: List[Str], tc: List[Str], loc: List[Str], envT: List[Str], retK: List[Str], diags: List[Str]) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        var rt = root_name(cal)
        var ag = e[2]
        var got = ag.len - 1
        if rt.len > 0 && !in_list(loc, rt) && !in_list(diags, "E2020@" + nline(e) + ": 未解析的名称(unresolved):" + rt) {
            if !in_list(tc[0], rt) && !prelude_ok(rt) && !in_list(tc[6], rt) {
                diags.push("E2020@" + nline(e) + ": 未解析的名称(unresolved):" + rt)
            } else {
                var g: I32 = 0
                while g < tc[0].len {
                    if seq2(tc[0][g], rt) && tc[1][g].len > 0 {
                        if got != dvi(tc[1][g]) {
                            diags.push("E2010@" + nline(e) + ": 调用实参数不匹配(arity):" + rt + " 期望 " + tc[1][g] + " 实得 " + got.to_string())
                        }
                        var ps = tc[3][g]
                        var i: I32 = 1
                        while i < ps.len && i <= got {
                            var prm = ps[i]
                            if prm[0] == "Param" {
                                var pk = ty_kind(prm[3])
                                var ak = ex_ty(ag[i], tc, loc, envT)
                                if !compat(pk, ak, ag[i], file, tc) {
                                    diags.push("E2010@" + nline(ag[i]) + ": 实参类型不匹配(type):" + rt + " 第 " + i.to_string() + " 实参 " + root_name(ag[i]) + " 期望 " + pk + " 实得 " + ak)
                                }
                            }
                            i += 1
                        }
                    }
                    g += 1
                }
                if !in_list(tc[0], rt) {
                    var pa = prelude_arity(rt)
                    if pa >= 0 && got != pa {
                        diags.push("E2010@" + nline(e) + ": 调用实参数不匹配(arity):" + rt + " 期望 " + pa.to_string() + " 实得 " + got.to_string())
                    }
                    var vi = idx_of(tc[6], rt)
                    if vi >= 0 {
                        if got != dvi(tc[7][vi]) {
                            diags.push("E2010@" + nline(e) + ": 调用实参数不匹配(arity):" + rt + " 期望 " + tc[7][vi] + " 实得 " + got.to_string())
                        }
                    }
                }
            }
        }
        // callee 为 Ident 时已在上方作为调用目标检查,不再按读取重复上报
        if cal[0] != "Ident" {
            tce(file, cal, tc, loc, envT, retK, diags)
        }
        var i2: I32 = 1
        while i2 < ag.len {
            tce(file, ag[i2], tc, loc, envT, retK, diags)
            i2 += 1
        }
        return
    }
    if t == "Ident" {
        var nm = e[1]
        tc[10].push(nm)
        if !in_list(loc, nm) && !in_list(tc[0], nm) && !in_list(tc[4], nm) && !in_list(tc[6], nm) && !in_list(tc[8], nm) && !value_ok(nm) {
            var m = "E2020@" + nline(e) + ": 未解析的名称(unresolved):" + nm
            if !in_list(diags, m) {
                diags.push(m)
            }
        }
        return
    }
    if t == "Member" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if t == "Binary" {
        var op = e[1]
        var lt = ex_ty(e[2], tc, loc, envT)
        var rt2 = ex_ty(e[3], tc, loc, envT)
        var bad = false
        var m = ""
        if or2(seq2(op, "Sub"), or2(seq2(op, "Mul"), or2(seq2(op, "Div"), or2(seq2(op, "Mod"), seq2(op, "WrapSub"))))) {
            if or2(k_strish(lt), k_strish(rt2)) {
                bad = true
                m = "E2010@" + nline(e) + ": 算术运算遇 Str(type):" + op
            }
        }
        if seq2(op, "Add") {
            var lunk = seq2(lt, "")
            var runk = seq2(rt2, "")
            if !lunk && !runk {
                if k_strish(lt) != k_strish(rt2) {
                    bad = true
                    m = "E2010@" + nline(e) + ": Str 拼接需两侧皆 Str(type):+"
                }
            }
        }
        if or2(seq2(op, "Add"), or2(seq2(op, "Sub"), or2(seq2(op, "Mul"), or2(seq2(op, "Div"), seq2(op, "Mod"))))) {
            if or2(seq2(lt, "n:Bool"), seq2(rt2, "n:Bool")) {
                bad = true
                m = "E2010@" + nline(e) + ": 算术运算遇 Bool(type):" + op
            }
        }
        if seq2(op, "AndAnd") {
            if or2(seq2(lt, "n:Str"), or2(seq2(rt2, "n:Str"), or2(k_int(lt), k_int(rt2)))) {
                bad = true
                m = "E2010@" + nline(e) + ": 逻辑与需 Bool 操作数(type):&&"
            }
        }
        if bad {
            diags.push(m)
        }
        tce(file, e[2], tc, loc, envT, retK, diags)
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Unary" {
        tce(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "Range" {
        tce(file, e[2], tc, loc, envT, retK, diags)
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Index" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        tce(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "TypeArgs" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if t == "Try" {
        if retK.len > 0 {
            var rk = ty_kind(retK)
            if rk.len > 0 {
                var okr = false
                if rk.len >= 4 {
                    okr = seq2(byte_slice(rk, 0, 4), "opt:")
                }
                okr = or2(okr, or2(seq2(rk, "n:Result"), or2(seq2(rk, "n:AnyError"), seq2(rk, "n:Option"))))
                if !okr {
                    diags.push("E2010@" + nline(e) + ": ? 传播用于非 Option/Result 返回(type):" + rk)
                }
            }
        }
        tce(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i3: I32 = 1
        while i3 < e.len {
            tce(file, e[i3], tc, loc, envT, retK, diags)
            i3 += 1
        }
        return
    }
    if t == "BlockExpr" {
        tcb(file, e[1], tc, loc, envT, retK, diags)
        return
    }
    if t == "If" {
        var ck = ex_ty(e[1], tc, loc, envT)
        if ck.len > 0 && !seq2(ck, "n:Bool") {
            diags.push("E2010@" + nline(e) + ": 条件需 Bool(type):if")
        }
        tce(file, e[1], tc, loc, envT, retK, diags)
        tcb(file, e[2], tc, loc, envT, retK, diags)
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Match" {
        tce(file, e[1], tc, loc, envT, retK, diags)
        var arms = e[2]
        var i4: I32 = 1
        while i4 < arms.len {
            var a = arms[i4]
            bind_pat(a[1], loc, envT, unk())
            tce(file, a[2], tc, loc, envT, retK, diags)
            i4 += 1
        }
        return
    }
    if t == "Closure" {
        var cp = e[1]
        var i5: I32 = 1
        while i5 < cp.len {
            loc.push(cp[i5][2])
            envT.push(unk())
            i5 += 1
        }
        tce(file, e[3], tc, loc, envT, retK, diags)
        return
    }
    if t == "Own" {
        loc.push(e[1])
        envT.push(unk())
        tcb(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "Scope" {
        loc.push(e[1])
        envT.push(unk())
        tcb(file, e[2], tc, loc, envT, retK, diags)
        return
    }
    if t == "StructLit" {
        var lf = e[2]
        var i6: I32 = 1
        while i6 < lf.len {
            var c = lf[i6]
            if seq2(c[0], "LField") {
                tce(file, c[2], tc, loc, envT, retK, diags)
            }
            i6 += 1
        }
        return
    }
    if t == "Str" {
        var pts = e[1]
        var i7: I32 = 1
        while i7 < pts.len {
            var pt = pts[i7]
            if seq2(pt[0], "Interp") && pt[1].len > 0 {
                tc[11].push(pt[1])
            }
            i7 += 1
        }
        return
    }
    // Str(含 Parts/Interp 原始文本)、字面量、成员名等:无进一步下钻
}

fn tcb(file: List[Str], b: List[Str], tc: List[Str], loc: List[Str], envT: List[Str], retK: List[Str], diags: List[Str]) {
    var i: I32 = 1
    while i < b.len {
        var s = b[i]
        var t = s[0]
        if t == "Let" {
            var ann = s[3]
            var hasann = ann.len > 0 && !seq2(ann[0], "None")
            if hasann {
                var act = ex_ty(s[4], tc, loc, envT)
                if !compat(ty_kind(ann), act, s[4], file, tc) {
                    diags.push("E2010@" + nline(s) + ": let 初始化类型不匹配(type):期望 " + ty_kind(ann) + " 实得 " + act)
                }
            }
            tce(file, s[4], tc, loc, envT, retK, diags)
            var tn = List[Str]()
            if hasann {
                tn = ann
            } else {
                tn = kind_node(ex_ty(s[4], tc, loc, envT))
            }
            if seq2(s[2][0], "PatId") {
                var vn = s[2][1]
                tc[9].push(vn)
                if in_list(tc[12], vn) {
                    diags.push("W8040@" + nline(s) + ": 遮蔽前奏符号(shadow prelude):" + vn)
                }
            }
            bind_pat(s[2], loc, envT, tn)
        } else if t == "While" {
            var ck = ex_ty(s[1], tc, loc, envT)
            if ck.len > 0 && !seq2(ck, "n:Bool") {
                diags.push("E2010@" + nline(s) + ": 条件需 Bool(type):while")
            }
            tce(file, s[1], tc, loc, envT, retK, diags)
            tcb(file, s[2], tc, loc, envT, retK, diags)
        } else if t == "For" {
            bind_pat(s[1], loc, envT, unk())
            tce(file, s[2], tc, loc, envT, retK, diags)
            tcb(file, s[3], tc, loc, envT, retK, diags)
        } else if t == "Return" {
            if s[1].len > 1 {
                if retK.len > 0 && !seq2(retK[0], "None") {
                    var act = ex_ty(s[1], tc, loc, envT)
                    if !compat(ty_kind(retK), act, s[1], file, tc) {
                        diags.push("E2010@" + nline(s) + ": 返回类型不匹配(type):期望 " + ty_kind(retK) + " 实得 " + act)
                    }
                }
                tce(file, s[1], tc, loc, envT, retK, diags)
            }
        } else if t == "Assign" {
            var tk = ex_ty(s[1], tc, loc, envT)
            var vk = ex_ty(s[3], tc, loc, envT)
            if !compat(tk, vk, s[3], file, tc) {
                diags.push("E2010@" + nline(s) + ": 赋值类型不匹配(type):目标 " + tk + " 实得 " + vk)
            }
            tce(file, s[1], tc, loc, envT, retK, diags)
            tce(file, s[3], tc, loc, envT, retK, diags)
        } else if t == "Expr" {
            tce(file, s[1], tc, loc, envT, retK, diags)
        } else if seq2(t, "None") && s.len == 1 {
            // 块尾值标记
        } else {
            tce(file, s, tc, loc, envT, retK, diags)
        }
        i += 1
    }
}

fn fn_params_push(ps: List[Str], loc: List[Str], envT: List[Str]) {
    var i: I32 = 1
    while i < ps.len {
        var p = ps[i]
        if p[0] == "Param" {
            loc.push(p[2])
            envT.push(p[3])
        } else if p[0] == "Receiver" {
            loc.push("self")
            envT.push(unk())
        }
        i += 1
    }
}

// 插值原文是否引用绑定名(粗粒度:子串命中即算使用)
fn interp_hit(txt: Str, nm: Str) -> Bool {
    var nn = nm.len
    if nn == 0 {
        return false
    }
    var hn = txt.len
    var i: I32 = 0
    while i + nn <= hn {
        var k: I32 = 0
        var ok = true
        while k < nn {
            if byte_at(txt, i + k) != byte_at(nm, k) {
                ok = false
            }
            k += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}

fn sem_calls_all(file: List[Str], diags: List[Str]) {
    var fns = List[Str]()
    var ars = List[Str]()
    var rets = List[Str]()
    var prms = List[Str]()
    var stN = List[Str]()
    var stT = List[Str]()
    var vars = List[Str]()
    var varAr = List[Str]()
    var enums = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if or2(t == "Fn", or2(t == "FnC", or2(t == "FnPub", or2(t == "Method", t == "FnExt")))) {
            fns.push(d[1])
            ars.push((d[3].len - 1).to_string())
            rets.push(d[4])
            prms.push(d[3])
        } else if t == "Static" {
            stN.push(d[1])
            stT.push(d[3])
        } else if t == "Const" {
            stN.push(d[1])
            stT.push(d[2])
        } else if t == "Enum" {
            enums.push(d[1])
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                var v = vs[j]
                vars.push(v[1])
                varAr.push((v[2].len - 1).to_string())
                j += 1
            }
        }
        i += 1
    }
    var tpars = List[Str]()
    var i0: I32 = 1
    while i0 < file.len {
        var d0 = file[i0]
        if or2(d0[0] == "Fn", or2(d0[0] == "FnC", or2(d0[0] == "FnPub", or2(d0[0] == "Method", d0[0] == "Class")))) {
            var tps = d0[2]
            var q0: I32 = 1
            while q0 < tps.len {
                tpars.push("n:" + tps[q0][1])
                q0 += 1
            }
        }
        i0 += 1
    }
    var prel = List[Str]()
    prel.push("print")
    prel.push("println")
    prel.push("panic")
    prel.push("assert")
    prel.push("assert_eq")
    prel.push("assert_ne")
    prel.push("read_file")
    prel.push("read_dir")
    prel.push("byte_at")
    prel.push("byte_slice")
    prel.push("Some")
    prel.push("None")
    prel.push("Ok")
    prel.push("Err")
    prel.push("fmt")
    prel.push("char_len")
    prel.push("Box")
    prel.push("List")
    prel.push("String")
    prel.push("Channel")
    prel.push("Mutex")
    prel.push("Atomic")
    prel.push("Global")
    prel.push("Task")
    prel.push("Scope")
    prel.push("Simd")
    prel.push("Option")
    prel.push("Result")
    prel.push("AnyError")
    prel.push("Show")
    prel.push("Eq")
    prel.push("Error")
    prel.push("Cap")
    prel.push("Clone")
    prel.push("Hash")
    prel.push("Iter")
    prel.push("parallel")
    prel.push("arena")
    var lets = List[Str]()
    var reads = List[Str]()
    var isrc = List[Str]()
    var tc = List[Str]()
    tc.push(fns)
    tc.push(ars)
    tc.push(rets)
    tc.push(prms)
    tc.push(stN)
    tc.push(stT)
    tc.push(vars)
    tc.push(varAr)
    tc.push(enums)
    tc.push(lets)
    tc.push(reads)
    tc.push(isrc)
    tc.push(prel)
    tc.push(tpars)
    i = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if or2(t == "Fn", or2(t == "FnC", or2(t == "FnPub", or2(t == "Method", t == "FnExt")))) {
            var loc = List[Str]()
            var envT = List[Str]()
            fn_params_push(d[3], loc, envT)
            var wlets = List[Str]()
            var wreads = List[Str]()
            var wisrc = List[Str]()
            var tcw = List[Str]()
            var q: I32 = 0
            while q < 9 {
                tcw.push(tc[q])
                q += 1
            }
            tcw.push(wlets)
            tcw.push(wreads)
            tcw.push(wisrc)
            tcw.push(prel)
            tcw.push(tpars)
            tcb(file, d[5], tcw, loc, envT, d[4], diags)
            var u: I32 = 0
            while u < wlets.len {
                var un = wlets[u]
                if !in_list(wreads, un) {
                    var hit = false
                    var w: I32 = 0
                    while w < wisrc.len && !hit {
                        if interp_hit(wisrc[w], un) {
                            hit = true
                        }
                        w += 1
                    }
                    if !hit {
                        var isu = false
                        if un.len > 0 && byte_at(un, 0) == 95 {
                            isu = true
                        }
                        if !isu {
                            diags.push("W8030: 未使用绑定(unused):" + un)
                        }
                    }
                }
                u += 1
            }
        } else if t == "Impl" {
            var its = d[4]
            var mi: I32 = 1
            while mi < its.len {
                var md = its[mi]
                if md[0] == "Method" {
                    var mloc = List[Str]()
                    var menv = List[Str]()
                    fn_params_push(md[3], mloc, menv)
                    tcb(file, md[5], tc, mloc, menv, md[4], diags)
                }
                mi += 1
            }
        } else if t == "Test" {
            tcb(file, d[2], tc, List[Str](), List[Str](), List[Str](), diags)
        }
        i += 1
    }
}

// ---------------- E6020/E6010:comptime 副作用扫描 + 编译期试求值(v0,2026-09-09) ----------------
// v0 限制:无步数预算——comptime fn 内死循环会挂起 check(真预算留 v1);
// 仅当其余诊断为零才试求值(先名字/类型,后求值,不级联)。
fn comp_banned_call(nm: Str) -> Bool {
    return or2(seq2(nm, "print"), or2(seq2(nm, "println"), or2(seq2(nm, "read_file"), seq2(nm, "read_dir"))))
}

fn comp_banned_mem(nm: Str) -> Bool {
    return or2(seq2(nm, "spawn"), or2(seq2(nm, "send"), or2(seq2(nm, "recv"), or2(seq2(nm, "store"), or2(seq2(nm, "fetch_add"), or2(seq2(nm, "with"), seq2(nm, "with_mut")))))))
}

fn scan_comp(file: List[Str], e: List[Str], diags: List[Str], fnm: Str) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        var rt = root_name(cal)
        if comp_banned_call(rt) && !in_list(diags, "E6020: comptime 函数含副作用(effect):" + rt) {
            diags.push("E6020@" + nline(e) + ": comptime 函数含副作用(effect):" + fnm + " 调用 " + rt)
        }
        if cal[0] == "Member" && cal[2] == "Nm" && comp_banned_mem(cal[3]) {
            var mn = "E6020@" + nline(e) + ": comptime 函数含副作用(effect):" + fnm + " 调用 ." + cal[3]
            if !in_list(diags, mn) {
                diags.push(mn)
            }
        }
        scan_comp(file, cal, diags, fnm)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            scan_comp(file, ag[i], diags, fnm)
            i += 1
        }
        return
    }
    if t == "Member" {
        scan_comp(file, e[1], diags, fnm)
        return
    }
    if t == "Binary" {
        scan_comp(file, e[2], diags, fnm)
        scan_comp(file, e[3], diags, fnm)
        return
    }
    if t == "Unary" {
        scan_comp(file, e[2], diags, fnm)
        return
    }
    if t == "Range" {
        scan_comp(file, e[2], diags, fnm)
        scan_comp(file, e[3], diags, fnm)
        return
    }
    if t == "Index" {
        scan_comp(file, e[1], diags, fnm)
        scan_comp(file, e[2], diags, fnm)
        return
    }
    if t == "TypeArgs" {
        scan_comp(file, e[1], diags, fnm)
        return
    }
    if t == "Try" {
        scan_comp(file, e[1], diags, fnm)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            scan_comp(file, e[i2], diags, fnm)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        scb(file, e[1], diags, fnm)
        return
    }
    if t == "If" {
        scan_comp(file, e[1], diags, fnm)
        scb(file, e[2], diags, fnm)
        scan_comp(file, e[3], diags, fnm)
        return
    }
    if t == "Match" {
        scan_comp(file, e[1], diags, fnm)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            scan_comp(file, arms[i3][2], diags, fnm)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        scan_comp(file, e[3], diags, fnm)
        return
    }
    if or2(t == "Own", t == "Scope") {
        scb(file, e[2], diags, fnm)
        return
    }
    if t == "StructLit" {
        var lf = e[2]
        var i4: I32 = 1
        while i4 < lf.len {
            var c = lf[i4]
            if seq2(c[0], "LField") {
                scan_comp(file, c[2], diags, fnm)
            }
            i4 += 1
        }
        return
    }
}

fn scb(file: List[Str], b: List[Str], diags: List[Str], fnm: Str) {
    var i: I32 = 1
    while i < b.len {
        var st = b[i]
        var t = st[0]
        if t == "Let" {
            scan_comp(file, st[4], diags, fnm)
        } else if t == "While" {
            scan_comp(file, st[1], diags, fnm)
            scb(file, st[2], diags, fnm)
        } else if t == "For" {
            scan_comp(file, st[2], diags, fnm)
            scb(file, st[3], diags, fnm)
        } else if t == "Return" {
            if st[1].len > 1 {
                scan_comp(file, st[1], diags, fnm)
            }
        } else if t == "Assign" {
            scan_comp(file, st[1], diags, fnm)
            scan_comp(file, st[3], diags, fnm)
        } else if t == "Expr" {
            scan_comp(file, st[1], diags, fnm)
        } else if seq2(t, "None") && st.len == 1 {
            // 块尾标记
        } else {
            scan_comp(file, st, diags, fnm)
        }
        i += 1
    }
}

// 值标签 vs 注解 kind(标量族;命名/未知 v0 放行)
fn vtag_ok(k: Str, vt: Str) -> Bool {
    if k_int(k) {
        return or2(seq2(vt, "I"), seq2(vt, "W"))
    }
    if or2(seq2(k, "n:Str"), seq2(k, "n:String")) {
        return seq2(vt, "S")
    }
    if seq2(k, "n:Bool") {
        return seq2(vt, "B")
    }
    if or2(seq2(k, "n:F32"), seq2(k, "n:F64")) {
        return seq2(vt, "D")
    }
    if seq2(k, "void") {
        return seq2(vt, "V")
    }
    return true
}

fn sem_comp(file: List[Str], diags: List[Str]) {
    // E5010 孤儿规则(§2.5):impl 的 trait 与 for 类型均非本包声明
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" {
            var tn = ty_head(d[2])
            var tyn = ty_head(d[3])
            if tn.len > 0 && tyn.len > 0 {
                if !local_type_or_trait(file, tn) && !local_type_or_trait(file, tyn) {
                    diags.push("E5010: 孤儿 impl(orphan):" + tn + " for " + tyn + " 的 trait 与类型均不属本包")
                }
            }
        }
        i += 1
    }
    if diags.len > 0 {
        return
    }
    i = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "FnC" {
            scb(file, d[5], diags, d[1])
        }
        i += 1
    }
    if diags.len > 0 {
        return
    }
    var env = List[Str]()
    i = 1
    while i < file.len {
        var d = file[i]
        var nm = ""
        var expr = List[Str]()
        var knd = ""
        if d[0] == "Const" {
            nm = d[1]
            expr = d[3]
            knd = ty_kind(d[2])
        } else if d[0] == "Static" && seq2(d[2], "false") {
            nm = d[1]
            expr = d[4]
            knd = ty_kind(d[3])
        }
        if nm.len > 0 {
            // 步数预算求值(E6010):超限 → 诊断;不支持 → 静默回退全量求值(运行期同口径)
            var st = List[Str]()
            st.push("0")
            var cenvN = List[Str]()
            var cenvV = List[Str]()
            var vr = ceval_expr(file, expr, cenvN, cenvV, st)
            if seq2(vr[0], "over") {
                diags.push("E6010: comptime 预算超限(budget):" + nm)
                return
            }
            var done = false
            if seq2(vr[0], "k") {
                if knd.len > 0 && !vtag_ok(knd, vr[2][0]) {
                    diags.push("E2010: const 类型不匹配(type):" + nm + " 期望 " + knd + " 实得 " + vr[2][0])
                    return
                }
                env = env_add(env, nm, vr[2])
                done = true
            }
            if !done {
                // ceval 不支持:回退全量求值(与 statics_env 同口径)
                var vr2 = eval_expr(file, env, "", expr)
                if vr2[0] != "k" {
                    return
                }
                if knd.len > 0 && !vtag_ok(knd, vr2[2][0]) {
                    diags.push("E2010: const 类型不匹配(type):" + nm + " 期望 " + knd + " 实得 " + vr2[2][0])
                    return
                }
                env = env_add(env, nm, vr2[2])
            }
        }
        i += 1
    }
}

// ---------------- E5010/E6010 助手(模块检查 v0) ----------------
fn local_type_or_trait(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if or2(t == "Trait", or2(t == "Struct", or2(t == "Enum", t == "Class"))) {
            if seq2(d[1], nm) {
                return true
            }
        }
        i += 1
    }
    return false
}

// comptime fn 体内是否存在直呼自身的调用
// ---------------- comptime 步数预算求值器(E6010,镜像宿主 pkg ceval) ----------------
// v0 支持:I 域整型字面量/const 引用/一元负号/算术(ari,静默回绕)/比较/逻辑与;
// comptime fn 单表达式体调用。不支持 → "u"(静默回退全量求值);步数超限 → "over"。
fn ce_budget(st: List[Str]) -> Bool {
    var used = dvi(st[0])
    if used > 1200 {
        return false
    }
    st[0] = (used + 1).to_string()
    return true
}

fn ceval_expr(file: List[Str], e: List[Str], cenvN: List[Str], cenvV: List[Str], st: List[Str]) -> List[Str] {
    if !ce_budget(st) {
        return cover()
    }
    var t = e[0]
    if t == "Int" {
        return cok(vI(dvi(num_text(e[1]))))
    }
    if t == "Ident" {
        var i: I32 = 0
        while i < cenvN.len {
            if seq2(cenvN[i], e[1]) {
                return cok(cenvV[i])
            }
            i += 1
        }
        return cun()
    }
    if t == "Unary" {
        var x = ceval_expr(file, e[2], cenvN, cenvV, st)
        if x[0] != "k" {
            if seq2(x[0], "over") { return x }
            return x
        }
        if x[2][0] != "I" { return cun() }
        return cok(vI(0 - dvi(x[2][1])))
    }
    if t == "Binary" {
        var op = e[1]
        if seq2(op, "AndAnd") { return cun() }
        var l = ceval_expr(file, e[2], cenvN, cenvV, st)
        if l[0] != "k" { return l }
        var r = ceval_expr(file, e[3], cenvN, cenvV, st)
        if r[0] != "k" { return r }
        if or2(l[2][0] != "I", r[2][0] != "I") { return cun() }
        var a = dvi(l[2][1])
        var b2 = dvi(r[2][1])
        if is_cmp_op(op) {
            var rb = false
            if seq2(op, "Lt") { rb = a < b2 }
            if seq2(op, "Gt") { rb = a > b2 }
            if seq2(op, "Le") { rb = a <= b2 }
            if seq2(op, "Ge") { rb = a >= b2 }
            if seq2(op, "Eq") { rb = a == b2 }
            if seq2(op, "Ne") { rb = a != b2 }
            return cok(vB(rb))
        }
        if seq2(op, "Add") { return cok(vI(a + b2)) }
        if seq2(op, "Sub") { return cok(vI(a - b2)) }
        if seq2(op, "Mul") { return cok(vI(a * b2)) }
        if seq2(op, "Div") {
            if b2 == 0 {
                return cun()
            }
            return cok(vI(a / b2))
        }
        return cun()
    }
    if t == "Call" {
        var cal = e[1]
        if cal[0] != "Ident" { return cun() }
        var fnm = cal[1]
        var d = find_decl(file, fnm)
                var known = d.len > 0
        if known {
            known = d[0] == "FnC"
        }
        if !known {
            return cun()
        }
        var ag = e[2]
        var cenvN2 = List[Str]()
        var cenvV2 = List[Str]()
        var ps = d[3]
        var i: I32 = 1
        var ai: I32 = 1
        while i < ps.len {
            var pr = ps[i]
            if pr[0] == "Param" {
                if ai >= ag.len { return cun() }
                var av = ceval_expr(file, ag[ai], cenvN, cenvV, st)
                if av[0] != "k" { return av }
                if av[2][0] != "I" { return cun() }
                cenvN2.push(pr[2])
                cenvV2.push(av[2])
            } else {
                return cun()
            }
            i += 1
            ai += 1
        }
        return ceval_block(file, d[5], cenvN2, cenvV2, st)
    }
    return cun()
}

fn ceval_block(file: List[Str], b: List[Str], cenvN: List[Str], cenvV: List[Str], st: List[Str]) -> List[Str] {
    // "k"+值 = return/尾值;"u" = 无返回(块贯通);"over" = 预算超限(向上传播)
    var n = b.len
    var i: I32 = 1
    while i < n - 1 {
        var st2 = b[i]
        var t = st2[0]
        if t == "Return" {
            if st2[1].len > 1 {
                return ceval_expr(file, st2[1], cenvN, cenvV, st)
            }
            return cun()
        }
        if t == "Expr" {
            var v = ceval_expr(file, st2[1], cenvN, cenvV, st)
            if v[0] != "k" {
                return v
            }
        } else if t == "If" {
            var cv = ceval_expr(file, st2[1], cenvN, cenvV, st)
            if cv[0] != "k" {
                return cv
            }
            var target = st2[2]
            if !truth(cv[2]) {
                target = st2[3]
            }
            if target[0] == "BlockExpr" {
                target = target[1]
            }
            var br = ceval_block(file, target, cenvN, cenvV, st)
            if br[0] != "u" {
                return br
            }
        } else {
            return cun()
        }
        i += 1
    }
    var tl = b[n - 1]
    if seq2(tl[0], "None") && tl.len == 1 {
        return cun()
    }
    return ceval_expr(file, tl, cenvN, cenvV, st)
}

fn cok(v: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push("k")
    r.push("")
    r.push(v)
    return r
}

fn cun() -> List[Str] {
    var r = List[Str]()
    r.push("u")
    return r
}

fn cover() -> List[Str] {
    var r = List[Str]()
    r.push("over")
    return r
}
