// =====================================================================
// trans.ct —— C 代码生成器 v3(自举发射:Ctron 源 → 等价 C,stdout)
// v3 覆盖:List[Str](引用语义 ctron_list*)/Atomic[I32](ctron_cell*)/
//   节点引用码 N/函数原型前置(前向引用·递归)/按形参类型码插转换(L↔N/A)/
//   尾值返回/match Option[Str](Some 绑定·None;read_file → char* NULL 模型)/
//   read_file·byte_at·byte_slice·to_string。
// v2:for-in-range·定长数组·F64/F32(rt fmt 同款 %.1f / %g)·assert·算术类型修正。
// v1:Str(字面量·参数·返回·let)·==/!= strcmp·Str+Str 拼接·print 按类型分发·类型推导。
// 约定:用户符号 t_ 前缀;运行时辅助 ctron_* 前缀;
//   类型码(env "name:ty"):i=I32 s=Str b=Bool f=F64/F32 L=List[Str]
//   A=Atomic[I32] N=节点引用 a<N><码>=定长数组 v=void。
// 注意:本文件字符串中的 { 均写作 \{(插值转义,镜像 C 词法器);\n 用 bs() 拼接。
// =====================================================================

fn bsn() -> Str {
    return "\\" + "n"
}

fn ct_op(op: Str) -> Str {
    if op == "Add" { return "+" }
    if op == "Sub" { return "-" }
    if op == "Mul" { return "*" }
    if op == "Div" { return "/" }
    if op == "Mod" { return "%" }
    if op == "Lt" { return "<" }
    if op == "Gt" { return ">" }
    if op == "Le" { return "<=" }
    if op == "Ge" { return ">=" }
    if op == "Eq" { return "==" }
    if op == "Ne" { return "!=" }
    if op == "AndAnd" { return "&&" }
    panic("ct_op:" + op)
    return "?"
}

fn ct_aop(op: Str) -> Str {
    if op == "Eq" { return "=" }
    if op == "AddEq" { return "+=" }
    if op == "SubEq" { return "-=" }
    if op == "MulEq" { return "*=" }
    if op == "DivEq" { return "/=" }
    if op == "ModEq" { return "%=" }
    panic("ct_aop:" + op)
    return "?"
}

// 符号表: env 条目形如 "name:ty"(ty 为类型码);查找按 "name:" 前缀精确匹配,
// 新绑定插在表头 → 先命中(遮蔽语义)
fn ct_env_ty(env: List[Str], nm: Str) -> Str {
    var key = nm + ":"
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if en.len >= key.len && byte_slice(en, 0, key.len) == key {
            return byte_slice(en, key.len, en.len)
        }
        i += 1
    }
    return "i"
}

fn env_bind(env: List[Str], nm: Str, ty: Str) -> List[Str] {
    var out = List[Str]()
    out.push(nm + ":" + ty)
    var i: I32 = 0
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}

// Named 类型节点 → 类型码;用户 struct → u:<名>(v4)
fn ct_ty_code(nt: List[Str], file: List[Str]) -> Str {
    if nt[0] != "Named" { return "i" }
    if ct_is_struct(file, nt[1]) { return "u:" + nt[1] }
    if nt[1] == "Str" { return "s" }
    if nt[1] == "Bool" { return "b" }
    if or2(nt[1] == "F64", nt[1] == "F32") { return "f" }
    if nt[1] == "I64" { return "6" }
    if nt[1] == "List" { return "L" }
    if nt[1] == "Atomic" { return "A" }
    return "i"
}

// 类型码 → C 类型: i=I32 / s=Str / b=Bool / f=F64 / L=List / A=Atomic / N=节点引用 / 6=I64
fn ct_ctype(code: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        return "t_" + byte_slice(code, 2, code.len)
    }
    if code == "s" { return "const char*" }
    if code == "N" { return "const char*" }
    if code == "b" { return "int" }
    if code == "f" { return "double" }
    if code == "L" { return "ctron_list*" }
    if code == "A" { return "ctron_cell*" }
    if code == "6" { return "int64_t" }
    if code == "v" { return "void" }
    return "int32_t"
}

// 用户 fn 返回类型码
fn ct_fn_ret(file: List[Str], nm: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", d[0] == "FnPub")) && d[1] == nm {
            var r = d[4]
            if r[0] == "None" { return "v" }
            if r[0] != "Named" { return "i" }
            return ct_ty_code(r, file)
        }
        i += 1
    }
    return "i"
}

// 用户 fn 形参类型码表(按 Param 顺序)
fn ct_fn_pcodes(file: List[Str], nm: Str) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnC", d[0] == "FnPub")) && d[1] == nm {
            var ps = d[3]
            var k: I32 = 1
            while k < ps.len {
                var pr = ps[k]
                if pr[0] == "Param" {
                    out.push(ct_ty_code(pr[3], file))
                }
                k += 1
            }
            return out
        }
        i += 1
    }
    return out
}

// fn 声明的 C 形参表(仅类型与名,用于原型前置与定义)
fn ct_params_str(d: List[Str], file: List[Str]) -> Str {
    var ps = d[3]
    var params = ""
    var k: I32 = 1
    var first = true
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            if !first { params = params + ", " }
            params = params + ct_ctype(ct_ty_code(pr[3], file)) + " t_" + pr[2]
            first = false
        }
        k += 1
    }
    return params
}

// 调用点实参转换:按形参类型码包转换(N→L/A 提升为指针,L→N/s 降为 char*)
fn ct_arg_cast(ac: Str, pc: Str, x: Str) -> Str {
    if pc == "L" && ac != "L" { return "(ctron_list*)(" + x + ")" }
    if pc == "A" && ac != "A" { return "(ctron_cell*)(" + x + ")" }
    if or2(pc == "s", pc == "N") && ac == "L" { return "(char*)(" + x + ")" }
    return x
}

// 表达式类型码: i/s/b/f/L/A/N;数组沿用 a<N><码> 编码
fn ct_typeof(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" { return "i" }
    if t == "Str" { return "s" }
    if t == "Bool" { return "b" }
    if t == "Float" { return "f" }
    if t == "Ident" { return ct_env_ty(env, e[1]) }
    if t == "Unary" {
        if e[1] == "Neg" { return ct_typeof(e[2], env, file) }
        return "b"
    }
    if t == "Binary" {
        var arith = or2(e[1] == "Add", or3(e[1] == "Sub", or2(e[1] == "Mul", e[1] == "Div"), e[1] == "Mod"))
        if arith {
            // 算术:任一操作数为浮点 → f;任一为 Str/节点引用(仅 Add 拼接)→ s;否则 i
            var l = ct_typeof(e[2], env, file)
            var r = ct_typeof(e[3], env, file)
            if or2(l == "f", r == "f") { return "f" }
            if or2(l == "s", r == "s") { return "s" }
            if or2(l == "N", r == "N") { return "s" }
            return "i"
        }
        return "b"
    }
    if t == "StructLit" {
        return "u:" + e[1]
    }
    if t == "If" {
        var th = e[2]
        if th.len == 2 && th[1][0] != "None" {
            return ct_typeof(th[1], env, file)
        }
        return "i"
    }
    if t == "Member" {
        if e[3] == "len" { return "i" }
        if e[3] == "to_string" { return "s" }
        var oft = ct_typeof(e[1], env, file)
        if oft.len > 2 && byte_slice(oft, 0, 2) == "u:" {
            return ct_field_ty(file, byte_slice(oft, 2, oft.len), e[3])
        }
    }
    if t == "ArrLit" {
        var et = ct_typeof(e[1], env, file)
        return "a" + (e.len - 1).to_string() + et
    }
    if t == "Index" {
        var ot = ct_typeof(e[1], env, file)
        if ot.len >= 3 && byte_slice(ot, 0, 1) == "a" {
            return a_elem(ot)
        }
        if or2(ot == "L", ot == "N") { return "N" }
        return "i"
    }
    if t == "Call" {
        var cal = e[1]
        if cal[0] == "TypeArgs" {
            var base = cal[1]
            if base[0] == "Ident" && base[1] == "List" { return "L" }
            if base[0] == "Ident" && base[1] == "Atomic" { return "A" }
            return "i"
        }
        if cal[0] == "Member" {
            var m = cal[3]
            if m == "load" { return "i" }
            if m == "to_string" { return "s" }
            if m == "push" { return "v" }
            if m == "store" { return "v" }
            return ct_fn_ret(file, m)
        }
        if cal[0] == "Ident" {
            if cal[1] == "ctron_entry" { return "s" }
            if cal[1] == "read_file" { return "s" }
            if cal[1] == "read_dir" { return "s" }
            if cal[1] == "byte_at" { return "i" }
            if cal[1] == "byte_slice" { return "s" }
            return ct_fn_ret(file, cal[1])
        }
    }
    return "i"
}

// Text 载荷 → C 字符串字面量内容:转义序列逐字透传(\n/\t/\\" 在 C 同义),
// 仅 \{ 坍缩为 {、孤立 " 加反斜杠、真实换行转 \n(unesc 在此不可用:它会把
// \n 解析成真实换行打进 C 字面量,预处理直接断行)
fn ct_cstr(raw: Str) -> Str {
    var acc = ""
    var i: I32 = 0
    while i < raw.len {
        var b = byte_at(raw, i)
        if b == 34 {
            acc = acc + bs() + "\""
            i += 1
        } else if b == 92 {
            if i + 1 < raw.len {
                var nb = byte_at(raw, i + 1)
                if nb == 123 {
                    acc = acc + "\{"
                    i += 2
                } else {
                    acc = acc + bs() + byte_slice(raw, i + 1, i + 2)
                    i += 2
                }
            } else {
                acc = acc + bs()
                i += 1
            }
        } else if b == 10 {
            acc = acc + bs() + "n"
            i += 1
        } else {
            acc = acc + byte_slice(raw, i, i + 1)
            i += 1
        }
    }
    return acc
}

fn ct_expr(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t = e[0]
    if t == "Int" { return e[1] }
    if t == "Float" { return e[1] }
    if t == "Str" {
        var parts = e[1]
        var acc = ""
        var j: I32 = 1
        while j < parts.len {
            var p = parts[j]
            var frag = ""
            if p[0] == "Text" {
                frag = "\"" + ct_cstr(p[1]) + "\""
            } else {
                // 插值(§4.11):发射器内联解析片段 → 按类型转 C 串
                var toks2 = List[Str]()
                var lns2 = List[Str]()
                scan(p[1], toks2, lns2)
                var cur2 = Atomic[I32](0)
                var ie = p_stmt_expr(toks2, cur2, lns2, "1")
                var ik = ct_typeof(ie, env, file)
                var core = ct_expr(ie, env, file)
                if or2(ik == "s", ik == "N") {
                    frag = "(" + core + ")"
                } else if ik == "i" {
                    frag = "ctron_i32_to_string((int32_t)(" + core + "))"
                } else if ik == "6" {
                    frag = "ctron_i64_to_string((int64_t)(" + core + "))"
                } else if ik == "b" {
                    frag = "((" + core + ") ? \"true\" : \"false\")"
                } else {
                    panic("ct_expr:interp 类型")
                    return ""
                }
            }
            if acc == "" {
                acc = frag
            } else {
                acc = "ctron_str_concat(" + acc + ", " + frag + ")"
            }
            j += 1
        }
        if acc == "" {
            return "\"\""
        }
        return acc
    }
    if t == "Bool" {
        if e[1] == "true" { return "1" }
        return "0"
    }
    if t == "Ident" { return "t_" + e[1] }
    if t == "Unary" {
        if e[1] == "Neg" { return "(-" + ct_expr(e[2], env, file) + ")" }
        return "(!" + ct_expr(e[2], env, file) + ")"
    }
    if t == "Binary" {
        var op = ct_op(e[1])
        var lt = ct_typeof(e[2], env, file)
        if e[1] == "Add" && or2(lt == "s", lt == "N") {
            return "ctron_str_concat((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
        }
        if or2(e[1] == "Eq", e[1] == "Ne") && or2(lt == "s", lt == "N") {
            var c = "strcmp((const char*)(" + ct_expr(e[2], env, file) + "), (const char*)(" + ct_expr(e[3], env, file) + "))"
            if e[1] == "Eq" { return "(" + c + " == 0)" }
            return "(" + c + " != 0)"
        }
        return "(" + ct_expr(e[2], env, file) + " " + op + " " + ct_expr(e[3], env, file) + ")"
    }
    if t == "Index" {
        var ot = ct_typeof(e[1], env, file)
        if ot.len >= 3 && byte_slice(ot, 0, 1) == "a" {
            if e[1][0] == "Ident" { return "t_" + e[1][1] + "[" + ct_expr(e[2], env, file) + "]" }
        }
        if or2(ot == "L", ot == "N") {
            // List/节点索引:元素槽即 char*(节点 = 动态转型的 ctron_list*)
            return "((const char*)((ctron_list*)(" + ct_expr(e[1], env, file) + "))->items[" + ct_expr(e[2], env, file) + "])"
        }

        panic("ct_expr:index 目标非 List/数组")
        return ""
    }
    if t == "Member" {
        if e[3] == "len" {
            // 定长数组:len 编码在 env 类型码里(a<N><码> → N)
            if e[1][0] == "Ident" {
                var ot2 = ct_env_ty(env, e[1][1])
                if ot2.len >= 3 && byte_slice(ot2, 0, 1) == "a" {
                    return a_count(ot2)
                }
            }
            var ot3 = ct_typeof(e[1], env, file)
            if ot3 == "L" {
                return "((ctron_list*)(" + ct_expr(e[1], env, file) + "))->n"
            }
            if ot3 == "N" {
                // N 值二义:真串或节点皆有 .len(env 表元素是串,AST 槽是节点)→ 动态分派镜像 rt
                return "ctron_len((const void*)(" + ct_expr(e[1], env, file) + "))"
            }
            return "strlen((const char*)(" + ct_expr(e[1], env, file) + "))"
        }
        var oft = ct_typeof(e[1], env, file)
        if oft.len > 2 && byte_slice(oft, 0, 2) == "u:" {
            // struct 字段读取(§6.1 值类型)
            return "(" + ct_expr(e[1], env, file) + ")." + e[3]
        }
    }
    if t == "StructLit" {
        if !ct_is_struct(file, e[1]) {
            panic("ct_expr:StructLit 非值类型")
            return ""
        }
        var lf = e[2]
        var acc = "(t_" + e[1] + ")\{"
        var j: I32 = 1
        while j < lf.len {
            var c = lf[j]
            if j > 1 {
                acc = acc + ", "
            }
            acc = acc + "." + c[1] + " = " + ct_expr(c[2], env, file)
            j += 1
        }
        return acc + "}"
    }
    if t == "If" {
        return ct_if_value(e, env, file)
    }
    if t == "ArrLit" {
        panic("ct_expr:ArrLit 仅 let 初值位")
        return ""
    }
    if t == "Call" {
        var cal = e[1]
        var ag = e[2]
        if cal[0] == "TypeArgs" {
            var base = cal[1]
            if base[0] == "Ident" && base[1] == "List" { return "ctron_list_new()" }
            if base[0] == "Ident" && base[1] == "Atomic" {
                var init = "0"
                if ag.len > 1 { init = ct_expr(ag[1], env, file) }
                return "ctron_cell_new(" + init + ")"
            }
        }
        if cal[0] == "Member" {
            var obj = ct_expr(cal[1], env, file)
            var objt = ct_typeof(cal[1], env, file)
            var m = cal[3]
            if m == "push" {
                var a0 = ""
                if ag.len > 1 { a0 = ct_expr(ag[1], env, file) }
                var a0t = "i"
                if ag.len > 1 { a0t = ct_typeof(ag[1], env, file) }
                return "ctron_list_push((ctron_list*)(" + obj + "), " + ct_arg_cast(a0t, "s", a0) + ")"
            }
            if m == "load" { return "((ctron_cell*)(" + obj + "))->v" }
            if m == "store" {
                var s0 = ""
                if ag.len > 1 { s0 = ct_expr(ag[1], env, file) }
                return "(((ctron_cell*)(" + obj + "))->v = " + s0 + ")"
            }
            if m == "to_string" {
                if objt.len > 2 && byte_slice(objt, 0, 2) == "u:" {
                    panic("emit:struct to_string")
                    return ""
                }
                if objt == "6" { return "ctron_i64_to_string(" + obj + ")" }
                return "ctron_i32_to_string((int32_t)(" + obj + "))"
            }
            // UFCS:文件自由 fn 首参调用
            var pcs = ct_fn_pcodes(file, m)
            var p0 = "i"
            if pcs.len > 0 { p0 = pcs[0] }
            return "t_" + m + "(" + ct_arg_cast(objt, p0, obj) + ", " + ct_call_args(ag, 2, env, file, m) + ")"
        }
        var callee = cal[1]
        if callee == "println" {
            var at = ct_typeof(ag[1], env, file)
            if at.len > 2 && byte_slice(at, 0, 2) == "u:" {
                panic("emit:print struct")
                return ""
            }
            if at == "s" { return "printf(\"%s" + bs() + "n\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            if at == "b" { return "printf(\"%s" + bs() + "n\", (" + ct_call_args(ag, 1, env, file, "") + ") ? \"true\" : \"false\")" }
            if at == "6" { return "printf(\"%lld" + bs() + "n\", (long long)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            return "printf(\"%d" + bs() + "n\", (int)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "print" {
            var at2 = ct_typeof(ag[1], env, file)
            if at2.len > 2 && byte_slice(at2, 0, 2) == "u:" {
                panic("emit:print struct")
                return ""
            }
            if at2 == "s" { return "printf(\"%s\", (const char*)(" + ct_call_args(ag, 1, env, file, "") + ");" }
            if at2 == "6" { return "printf(\"%lld\", (long long)(" + ct_call_args(ag, 1, env, file, "") + "))" }
            return "printf(\"%d\", (int)(" + ct_call_args(ag, 1, env, file, "") + "))"
        }
        if callee == "ctron_entry" { return "ctron_entry()" }
        if callee == "read_file" {
            if ag.len > 1 && ag[1][0] == "Str" && ct_str_payload(ag[1]) == "CTRONCLIINPUT" {
                // main 输入锚:CLI `run <file>` 可覆盖(ctron_anchor 默认 = 烘焙字面量)
                return "ctron_read_file_cli(ctron_anchor)"
            }
            return "ctron_read_file(" + ct_call_args(ag, 1, env, file, "") + ")"
        }
        if callee == "read_dir" { return "ctron_read_dir(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "byte_at" { return "ctron_byte_at(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "byte_slice" { return "ctron_byte_slice(" + ct_call_args(ag, 1, env, file, "") + ")" }
        if callee == "panic" { return "ctron_panic(" + ct_call_args(ag, 1, env, file, "") + ")" }
        return "t_" + callee + "(" + ct_call_args(ag, 1, env, file, callee) + ")"
    }
    panic("ct_expr:" + t)
    return ""
}

// 实参串:从 ag[from] 起逐个发射,用户 fn 时按形参码插转换;
// 实参不足按 0 补齐到形参数(镜像 cc.ct 潜伏的缺参调用,如 ty_head 的 2 参 or3 —— 种子
// 一旦执行即 panic,补 0 仅保证产物可编译,崩路无差分意义)
fn ct_call_args(ag: List[Str], from: I32, env: List[Str], file: List[Str], callee: Str) -> Str {
    var pcs = ct_fn_pcodes(file, callee)
    var args = ""
    var i: I32 = from
    while i < ag.len {
        if i > from { args = args + ", " }
        var ac = ct_typeof(ag[i], env, file)
        var pc = "i"
        if callee != "" && i - 1 < pcs.len { pc = pcs[i - 1] }
        args = args + ct_arg_cast(ac, pc, ct_expr(ag[i], env, file))
        i += 1
    }
    if callee != "" {
        var miss = pcs.len - (ag.len - from) - (from - 1)
        while miss > 0 {
            args = args + ", 0"
            miss -= 1
        }
    }
    return args
}

// 块语句序列(不含花括号与尾槽)
// 体内是否存在对该名的 Assign(递归所有子块)
fn ct_assigned(nm: Str, b: List[Str]) -> Bool {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Assign" {
            if st[1][0] == "Ident" && st[1][1] == nm {
                return true
            }
            if st[1][0] == "Index" && st[1][1][0] == "Ident" && st[1][1][1] == nm {
                return true
            }
        }
        // 递归子块/子表达式容器
        if t == "While" {
            if ct_assigned(nm, st[2]) {
                return true
            }
        }
        if t == "For" {
            if ct_assigned(nm, st[3]) {
                return true
            }
        }
        if t == "If" {
            if ct_assigned(nm, st[2]) {
                return true
            }
            if st[3][0] == "If" {
                if ct_assigned(nm, st[3]) {
                    return true
                }
            } else {
                if st[3][0] == "BlockExpr" {
                    if ct_assigned(nm, st[3][1]) {
                        return true
                    }
                }
            }
        }
        if t == "Match" {
            var arms = st[2]
            var mi: I32 = 1
            while mi < arms.len {
                var be = arms[mi][2]
                if be[0] == "BlockExpr" {
                    if ct_assigned(nm, be[1]) {
                        return true
                    }
                }
                mi += 1
            }
        }
        i += 1
    }
    return false
}

// while 体顶层 let 名单(提升声明用):简单模式 + 标量/指针码 + 体内零赋值
// (数组 init 花括号不提升;有赋值的动态型变量不提升 —— 静态型别保不住)。
// 候选按序绑定到不断增长的 ew:后候选的 init 可见先候选的型别(如 ty = f[3] 需 f:N)
fn ct_hoists(b: List[Str], env: List[Str], file: List[Str]) -> List[Str] {
    var out = List[Str]()
    var ew = env
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        if st[0] == "Let" {
            var pat = st[2]
            if or2(pat[0] == "PatId", pat[0] == "PatAgg" && pat[2][0] == "SubUnit") {
                if !ct_assigned(pat[1], b) {
                    var ty = "i"
                    if st[3][0] != "None" {
                        ty = ct_ty_code(st[3], file)
                    } else {
                        ty = ct_typeof(st[4], ew, file)
                    }
                    if ty != "L" && ty != "A" && !(ty.len >= 3 && byte_slice(ty, 0, 1) == "a") {
                        out.push(pat[1] + ":" + ty)
                        ew = env_bind(ew, pat[1], ty)
                    }
                }
            }
        }
        i += 1
    }
    return out
}

fn ct_zero(code: Str) -> Str {
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        return "(t_" + byte_slice(code, 2, code.len) + ")\{0}"
    }
    if code == "f" { return "0.0" }
    return "0"
}

// 定长数组码 a<N><元素码>:元素码自 v4 起可多字符(如 u:Point)
fn a_count(code: Str) -> Str {
    var i: I32 = 1
    while i < code.len {
        var c = byte_at(code, i)
        var dig = true
        if c < 48 {
            dig = false
        }
        if c > 57 {
            dig = false
        }
        if !dig {
            return byte_slice(code, 1, i)
        }
        i += 1
    }
    return byte_slice(code, 1, code.len)
}

fn a_elem(code: Str) -> Str {
    var i: I32 = 1
    while i < code.len {
        var c = byte_at(code, i)
        var dig = true
        if c < 48 {
            dig = false
        }
        if c > 57 {
            dig = false
        }
        if !dig {
            return byte_slice(code, i, code.len)
        }
        i += 1
    }
    return "i"
}

fn ct_structs(file: List[Str]) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" {
            out.push(d[1])
        }
        i += 1
    }
    return out
}

fn ct_is_struct(file: List[Str], nm: Str) -> Bool {
    return in_list(ct_structs(file), nm)
}

fn ct_field_ty(file: List[Str], sname: Str, fname: Str) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" && d[1] == sname {
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len {
                var f = fs[j]
                if f[2] == fname {
                    return ct_ty_code(f[3], file)
                }
                j += 1
            }
        }
        i += 1
    }
    return "i"
}

fn ct_stmts(b: List[Str], env: List[Str], file: List[Str], hl: List[Str], hreg: List[Str]) -> List[Str] {
    var i: I32 = 1
    var env2 = env
    while i < b.len - 1 {
        var st = b[i]
        var skip = false
        if hl != "" && st[0] == "Let" {
            // 提升名:Let 重写为 Assign(声明已提至循环前)
            var pat = st[2]
            var nm = ""
            if pat[0] == "PatId" { nm = pat[1] }
            if pat[0] == "PatAgg" && pat[2][0] == "SubUnit" { nm = pat[1] }
            var hit = false
            var k: I32 = 0
            while k < hl.len {
                var en = hl[k]
                if en.len > nm.len + 1 && byte_slice(en, 0, nm.len) == nm && byte_at(en, nm.len) == 58 {
                    hit = true
                }
                k += 1
            }
            if hit && nm != "" {
                var na = List[Str]()
                na.push("Ident")
                na.push(nm)
                var nas = List[Str]()
                nas.push("Assign")
                nas.push(na)
                nas.push("Eq")
                nas.push(st[4])
                env2 = ct_stmt(nas, env2, file, hreg)
                skip = true
            }
        }
        if !skip {
            env2 = ct_stmt(st, env2, file, hreg)
        }
        i += 1
    }
    return env2
}

// match 作值(当前仅 fn 体尾槽位):Option[Str] 两臂,结果写入 t_mr(<rc> 型)
fn ct_match_value(e: List[Str], env: List[Str], file: List[Str], rc: Str, hreg: List[Str]) -> List[Str] {
    println("const char* t_mv = (const char*)(" + ct_expr(e[1], env, file) + ");")
    println(ct_ctype(rc) + " t_mr;")
    var arms = e[2]
    var someIx: I32 = -1
    var noneIx: I32 = -1
    var mi: I32 = 1
    while mi < arms.len {
        var arm = arms[mi]
        var pt = arm[1]
        if pt[0] == "PatAgg" && pt[1] == "Some" { someIx = mi }
        if pt[0] == "PatAgg" && pt[1] == "None" { noneIx = mi }
        mi += 1
    }
    if someIx < 0 && noneIx < 0 {
        panic("ct_match_value:pat")
        return env
    }
    if someIx >= 0 {
        var armS = arms[someIx]
        var pt = armS[1]
        var be = armS[2]
        println("if (t_mv != NULL) \{")
        var env3 = env
        if pt[2][0] == "SubTup" {
            var b0 = pt[2][1]
            if b0[0] == "PatId" {
                println("const char* t_" + b0[1] + " = t_mv;")
                env3 = env_bind(env3, b0[1], "s")
            }
        }
        if be[0] == "BlockExpr" {
            var bl = be[1]
            env3 = ct_stmts(bl, env3, file, "", hreg)
            var tl = bl[bl.len - 1]
            if tl[0] == "None" {
                panic("ct_match_value:arm 无值")
                return env
            }
            println("t_mr = " + ct_expr(tl, env3, file) + ";")
        } else {
            println("t_mr = " + ct_expr(be, env3, file) + ";")
        }
        println("}")
    }
    if noneIx >= 0 {
        var armN = arms[noneIx]
        var be2 = armN[2]
        if someIx >= 0 {
            println("else \{")
        } else {
            println("if (t_mv == NULL) \{")
        }
        if be2[0] == "BlockExpr" {
            var bl2 = be2[1]
            var env4 = ct_stmts(bl2, env, file, "", hreg)
            var tl2 = bl2[bl2.len - 1]
            if tl2[0] == "None" {
                panic("ct_match_value:arm 无值")
                return env
            }
            println("t_mr = " + ct_expr(tl2, env4, file) + ";")
        } else {
            println("t_mr = " + ct_expr(be2, env, file) + ";")
        }
        println("}")
    }
    return env
}

fn ct_block(b: List[Str], env: List[Str], file: List[Str], hreg: List[Str]) -> List[Str] {
    println("\{")
    var env2 = ct_stmts(b, env, file, "", hreg)
    // 尾槽:p_block 末元素为裸尾表达式(无 "None" 哨兵时),按语句发射
    var tl = b[b.len - 1]
    if tl[0] != "None" {
        var es = List[Str]()
        es.push("Expr")
        es.push(tl)
        env2 = ct_stmt(es, env2, file, hreg)
    }
    println("}")
    return env2
}

// fn 体:语句同 ct_block,但尾表达式在非 void fn 中是返回值(Ctron Block 尾值语义;
// 尾槽 match 作值经 t_mr 中转)
// 尾槽是否为值形态(语句类黑名单;Match/If 尾按语句发射 —— 值位 match 仅 fn 尾特判,
// 值位 if 尾挂账)
// 值位 if(§4.6 if 是表达式):两分支均为纯表达式块 → C 三元;否则 panic(文档化)
fn ct_simple(b: List[Str], env: List[Str], file: List[Str]) -> Str {
    if b.len > 2 {
        return ""
    }
    var tl = b[b.len - 1]
    if tl[0] == "None" {
        return ""
    }
    return ct_expr(tl, env, file)
}

fn ct_if_value(e: List[Str], env: List[Str], file: List[Str]) -> Str {
    var t1 = ct_simple(e[2], env, file)
    if t1 == "" {
        panic("ct_expr:if 值位需纯表达式分支")
        return ""
    }
    var t2 = ""
    if e[3][0] == "If" {
        t2 = ct_if_value(e[3], env, file)
    } else if e[3][0] == "BlockExpr" {
        // p_if 的 else 分支包 BlockExpr(与 then 的裸 Block 不对称)
        t2 = ct_simple(e[3][1], env, file)
    } else {
        t2 = ct_simple(e[3], env, file)
    }
    if t2 == "" {
        panic("ct_expr:if 值位需纯表达式分支")
        return ""
    }
    return "(" + ct_expr(e[1], env, file) + " ? " + t1 + " : " + t2 + ")"
}

fn ct_is_value(tg: Str) -> Bool {
    if tg == "Match" { return false }
    if tg == "If" { return false }
    if tg == "While" { return false }
    if tg == "For" { return false }
    if tg == "Let" { return false }
    if tg == "Assign" { return false }
    if tg == "Return" { return false }
    if tg == "Expr" { return false }
    if tg == "Block" { return false }
    return true
}

fn ct_body(b: List[Str], env: List[Str], file: List[Str], rc: Str) -> List[Str] {
    var hreg = List[Str]()
    println("\{")
    var env2 = ct_stmts(b, env, file, "", hreg)
    var tl = b[b.len - 1]
    if tl[0] != "None" {
        // p_block 尾槽 = NL 折叠后紧跟 } 的表达式 —— 完整语句后跟空行也入尾槽,
        // 故语句类尾槽(如末位 match)仍按语句发射(臂内 return 负责退出)
        if or2(rc == "v", !ct_is_value(tl[0])) {
            var es = List[Str]()
            es.push("Expr")
            es.push(tl)
            env2 = ct_stmt(es, env2, file, hreg)
        } else if tl[0] == "Match" {
            ct_match_value(tl, env2, file, rc, hreg)
            println("return t_mr;")
        } else if tl[0] == "If" {
            println("return " + ct_if_value(tl, env2, file) + ";")
        } else {
            println("return " + ct_expr(tl, env2, file) + ";")
        }
    }
    println("}")
    return env2
}

fn ct_if_stmt(e: List[Str], env: List[Str], file: List[Str], hreg: List[Str]) {
    println("if (" + ct_expr(e[1], env, file) + ") \{")
    ct_block(e[2], env, file, hreg)
    println("}")
    var els = e[3]
    if els[0] != "None" {
        println("else \{")
        if els[0] == "If" {
            ct_if_stmt(els, env, file, hreg)
        } else {
            ct_block(els[1], env, file, hreg)
        }
        println("}")
    }
}

fn ct_stmt(st: List[Str], env: List[Str], file: List[Str], hreg: List[Str]) -> List[Str] {
    var t = st[0]
    if t == "Let" {
        var pat = st[2]
        // PatId 或 PatAgg-SubUnit(单大写标识符如 var L,解析器按变体模式收,rt 动态当绑定)
        if or2(pat[0] == "PatId", pat[0] == "PatAgg" && pat[2][0] == "SubUnit") {
            var ty = "i"
            if st[3][0] != "None" {
                ty = ct_ty_code(st[3], file)
            } else {
                ty = ct_typeof(st[4], env, file)
            }
            if ty.len >= 3 && byte_slice(ty, 0, 1) == "a" {
                // 定长数组 let:<elem C 类型> t_<名>[<N>] = { elems };
                var n = a_count(ty)
                var ec = a_elem(ty)
                var al = st[4]
                var acc = ""
                var j: I32 = 1
                while j < al.len {
                    if j > 1 { acc = acc + ", " }
                    acc = acc + ct_expr(al[j], env, file)
                    j += 1
                }
                println(ct_ctype(ec) + " t_" + pat[1] + "[" + n + "] = \{" + acc + "};")
                return env_bind(env, pat[1], ty)
            }
            var rhs = ct_expr(st[4], env, file)
            if ty == "L" { rhs = "(ctron_list*)(" + rhs + ")" }
            if ty == "A" { rhs = "(ctron_cell*)(" + rhs + ")" }
            println(ct_ctype(ty) + " t_" + pat[1] + " = " + rhs + ";")
            return env_bind(env, pat[1], ty)
        }
        panic("ct_stmt:let pat:" + pat[0])
        return env
    }
    if t == "Assign" {
        var tgt = st[1]
        if tgt[0] == "Index" {
            // 索引赋值:目标 List/节点,元素槽 char*
            if st[2] != "Eq" {
                panic("ct_stmt:index 复合赋值")
                return env
            }
            var tv = ct_expr(tgt[1], env, file)
            var vt = ct_typeof(st[3], env, file)
            println("((ctron_list*)(" + tv + "))->items[" + ct_expr(tgt[2], env, file) + "] = " + ct_arg_cast(vt, "s", ct_expr(st[3], env, file)) + ";")
            return env
        }
        if tgt[0] == "Member" {
            panic("ct_stmt:struct 字段赋值未支持")
            return env
        }
        var tt = ct_env_ty(env, tgt[1])
        var rhs2 = ct_expr(st[3], env, file)
        if tt == "L" { rhs2 = "(ctron_list*)(" + rhs2 + ")" }
        if tt == "A" { rhs2 = "(ctron_cell*)(" + rhs2 + ")" }
        println("t_" + tgt[1] + " " + ct_aop(st[2]) + " " + rhs2 + ";")
        return env
    }
    if t == "While" {
        // 顶层 let 提升到循环前声明(零初始化),块内改赋值 —— 兼容语料中
        // "循环外读循环内绑定"的写法(parsetree/sem_chk p_block 尾 guard),
        // 使发射产物可编译;rt 语义下该读路径本不应执行(执行即宿主 abort)。
        // hreg = fn 级已提升登记:同名同型复用声明,异型放弃提升(块内原样声明)
        var body = st[2]
        var cand = ct_hoists(body, env, file)
        var hl = List[Str]()
        var envw = env
        var hi: I32 = 0
        while hi < cand.len {
            var en = cand[hi]
            var colon = 0
            var k2: I32 = 0
            while k2 < en.len {
                if byte_at(en, k2) == 58 { colon = k2 }
                k2 += 1
            }
            var nm = byte_slice(en, 0, colon)
            var ty = byte_slice(en, colon + 1, en.len)
            var prev = ""
            var reg: I32 = 0
            while reg < hreg.len {
                var rn = hreg[reg]
                if rn.len > colon && byte_slice(rn, 0, colon) == nm && byte_at(rn, colon) == 58 {
                    prev = byte_slice(rn, colon + 1, rn.len)
                }
                reg += 1
            }
            if prev == "" {
                println(ct_ctype(ty) + " t_" + nm + " = " + ct_zero(ty) + ";")
                hreg.push(nm + ":" + ty)
                hl.push(nm + ":" + ty)
                envw = env_bind(envw, nm, ty)
            } else {
                if prev == ty {
                    hl.push(nm + ":" + ty)
                    envw = env_bind(envw, nm, ty)
                }
                // 异型:不提升,块内保持原声明(独立 C 作用域,无冲突)
            }
            hi += 1
        }
        println("while (" + ct_expr(st[1], envw, file) + ") \{")
        var benv = ct_stmts(body, envw, file, hl, hreg)
        var tl = body[body.len - 1]
        if tl[0] != "None" {
            var es = List[Str]()
            es.push("Expr")
            es.push(tl)
            ct_stmt(es, benv, file, hreg)
        }
        println("}")
        return envw
    }
    if t == "Match" {
        // Option[Str] 模型:read_file → char*(NULL=None);单 match 每函数(t_mv)
        println("const char* t_mv = (const char*)(" + ct_expr(st[1], env, file) + ");")
        var arms = st[2]
        var someIx: I32 = -1
        var noneIx: I32 = -1
        var mi: I32 = 1
        while mi < arms.len {
            var arm = arms[mi]
            var pt = arm[1]
            if pt[0] == "PatAgg" && pt[1] == "Some" { someIx = mi }
            if pt[0] == "PatAgg" && pt[1] == "None" { noneIx = mi }
            mi += 1
        }
        if someIx < 0 && noneIx < 0 {
            panic("ct_stmt:match pat")
            return env
        }
        if someIx >= 0 {
            var armS = arms[someIx]
            var pt = armS[1]
            var be = armS[2]
            println("if (t_mv != NULL) \{")
            var env3 = env
            if pt[2][0] == "SubTup" {
                var b0 = pt[2][1]
                if b0[0] == "PatId" {
                    println("const char* t_" + b0[1] + " = t_mv;")
                    env3 = env_bind(env3, b0[1], "s")
                }
            }
            if be[0] == "BlockExpr" {
                ct_block(be[1], env3, file, hreg)
            } else {
                panic("ct_stmt:match arm body")
                return env
            }
            println("}")
        }
        if noneIx >= 0 {
            var armN = arms[noneIx]
            var be2 = armN[2]
            if someIx >= 0 {
                println("else \{")
            } else {
                println("if (t_mv == NULL) \{")
            }
            if be2[0] == "BlockExpr" {
                ct_block(be2[1], env, file, hreg)
            } else {
                panic("ct_stmt:match arm body")
                return env
            }
            println("}")
        }
        return env
    }
    if t == "For" {
        var pat = st[1]
        var it = st[2]
        var body = st[3]
        if pat[0] != "PatId" {
            panic("ct_stmt:for pat:" + pat[0])
            return env
        }
        var v0 = pat[1]
        if it[0] == "Range" {
            // for x in lo..hi / lo..=hi:循环变量 int64_t(rt 同宽语义)
            var incl = it[1]
            var lo = ct_expr(it[2], env, file)
            var hi = ct_expr(it[3], env, file)
            var op2 = " < "
            if incl == "true" { op2 = " <= " }
            println("for (int64_t t_" + v0 + " = " + lo + "; t_" + v0 + op2 + hi + "; t_" + v0 + "++) \{")
            ct_block(body, env_bind(env, v0, "i"), file, hreg)
            println("}")
            return env
        }
        var ity = ct_typeof(it, env, file)
        if ity.len >= 3 && byte_slice(ity, 0, 1) == "a" {
            // for x in <定长数组>:按 env 长度编码展开
            var n = byte_slice(ity, 1, ity.len - 1)
            var ec = byte_slice(ity, ity.len - 1, ity.len)
            var arr = ct_expr(it, env, file)
            println("for (int64_t ctron_i = 0; ctron_i < " + n + "; ctron_i++) \{")
            println("    " + ct_ctype(ec) + " t_" + v0 + " = " + arr + "[ctron_i];")
            ct_block(body, env_bind(env, v0, ec), file, hreg)
            println("}")
            return env
        }
        panic("ct_stmt:for iter:" + it[0])
        return env
    }
    if t == "Return" {
        if st[1][0] == "None" {
            println("return;")
            return env
        }
        println("return " + ct_expr(st[1], env, file) + ";")
        return env
    }
    if t == "Expr" {
        var e = st[1]
        if e[0] == "If" {
            ct_if_stmt(e, env, file, hreg)
            return env
        }
        if e[0] == "Match" {
            ct_stmt(e, env, file, hreg)
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "assert" && e[2].len == 2 {
            // rt assert 失败 panic 退出;生成码失败即 return 1(stdout 面 fixture 全过,逐字等价)
            println("if (!(" + ct_expr(e[2][1], env, file) + ")) \{ return 1; }")
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "assert_eq" && e[2].len == 3 {
            var a0 = e[2][1]
            var a1 = e[2][2]
            var cmp = ""
            var at0 = ct_typeof(a0, env, file)
            if or2(at0 == "s", at0 == "N") {
                cmp = "(strcmp((const char*)(" + ct_expr(a0, env, file) + "), (const char*)(" + ct_expr(a1, env, file) + ")) == 0)"
            } else {
                cmp = "((" + ct_expr(a0, env, file) + ") == (" + ct_expr(a1, env, file) + "))"
            }
            println("if (!" + cmp + ") \{ return 1; }")
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "println" {
            var at = ct_typeof(e[2][1], env, file)
            if or2(at == "s", at == "N") {
                println("printf(\"%s" + bs() + "n\", (const char*)(" + ct_expr(e[2][1], env, file) + "));")
                return env
            }
            if at == "b" {
                println("printf(\"%s" + bs() + "n\", " + ct_expr(e[2][1], env, file) + " ? \"true\" : \"false\");")
                return env
            }
            if at == "f" {
                // rt fmt_val:整值 %.1f,否则 %g(实参三次文本展开,仅限简单表达式)
                var fx = ct_expr(e[2][1], env, file)
                println("printf((" + fx + " == (double)(long long)(" + fx + ")) ? \"%.1f" + bs() + "n\" : \"%g" + bs() + "n\", " + fx + ");")
                return env
            }
            if at == "6" {
                println("printf(\"%lld" + bs() + "n\", (long long)(" + ct_expr(e[2][1], env, file) + "));")
                return env
            }
            println("printf(\"%d" + bs() + "n\", (int)(" + ct_expr(e[2][1], env, file) + "));")
            return env
        }
        if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "print" {
            var at = ct_typeof(e[2][1], env, file)
            if or2(at == "s", at == "N") {
                println("printf(\"%s\", (const char*)(" + ct_expr(e[2][1], env, file) + "));")
                return env
            }
            if at == "b" {
                println("printf(\"%s\", " + ct_expr(e[2][1], env, file) + " ? \"true\" : \"false\");")
                return env
            }
            println("printf(\"%d\", (int)(" + ct_expr(e[2][1], env, file) + "));")
            return env
        }
        println(ct_expr(e, env, file) + ";")
        return env
    }
    panic("ct_stmt:" + t)
    return env
}

fn ct_fn(d: List[Str], file: List[Str]) {
    var ps = d[3]
    var k: I32 = 1
    var env = List[Str]()
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            env = env_bind(env, pr[2], ct_ty_code(pr[3], file))
        }
        k += 1
    }
    var rc = ct_fn_ret(file, d[1])
    println(ct_ctype(rc) + " t_" + d[1] + "(" + ct_params_str(d, file) + ") ")
    ct_body(d[5], env, file, rc)
}

// Str 节点 Text 载荷原样拼接(不做转义还原)
fn ct_str_payload(e: List[Str]) -> Str {
    var parts = e[1]
    var acc = ""
    var j: I32 = 1
    while j < parts.len {
        var p = parts[j]
        if p[0] == "Text" { acc = acc + p[1] }
        j += 1
    }
    return acc
}

// 输入 main 首个 let read_file(Str 字面量) 的载荷(cc/selfcomp 模块的输入锚);未命中返回 ""
fn ct_find_main_anchor(file: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Fn" && d[1] == "main" {
            var b = d[5]
            var k: I32 = 1
            while k < b.len {
                var st = b[k]
                if st[0] == "Let" {
                    var e = st[4]
                    if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "read_file" {
                        if e[2].len > 1 && e[2][1][0] == "Str" {
                            return ct_str_payload(e[2][1])
                        }
                    }
                }
                k += 1
            }
        }
        i += 1
    }
    return ""
}

// 把 main 首个 read_file(Str 字面量) 载荷换为 CLI 标记(发射时改走 ctron_anchor);
// 未命中返回原 file。纯 List 重建:Str→Args→Call→Let→Block→Fn→File。
fn ct_swap_anchor(file: List[Str]) -> List[Str] {
    var mi: I32 = 1
    while mi < file.len {
        var d = file[mi]
        if d[0] == "Fn" && d[1] == "main" {
            var b = d[5]
            var k: I32 = 1
            while k < b.len {
                var st = b[k]
                if st[0] == "Let" {
                    var e = st[4]
                    if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "read_file" {
                        if e[2].len > 1 && e[2][1][0] == "Str" {
                            var np = List[Str]()
                            np.push("Text")
                            np.push("CTRONCLIINPUT")
                            var nps = List[Str]()
                            nps.push("Parts")
                            nps.push(np)
                            var ns = List[Str]()
                            ns.push("Str")
                            ns.push(nps)
                            var na = List[Str]()
                            na.push("Args")
                            na.push(ns)
                            var nc = List[Str]()
                            nc.push("Call")
                            nc.push(e[1])
                            nc.push(na)
                            var nl = List[Str]()
                            nl.push("Let")
                            nl.push(st[1])
                            nl.push(st[2])
                            nl.push(st[3])
                            nl.push(nc)
                            var nb = List[Str]()
                            nb.push("Block")
                            var j: I32 = 1
                            while j < b.len {
                                if j == k { nb.push(nl) } else { nb.push(b[j]) }
                                j += 1
                            }
                            var nd = List[Str]()
                            nd.push("Fn")
                            nd.push(d[1])
                            nd.push(d[2])
                            nd.push(d[3])
                            nd.push(d[4])
                            nd.push(nb)
                            var nf = List[Str]()
                            nf.push("File")
                            var j2: I32 = 1
                            while j2 < file.len {
                                if j2 == mi { nf.push(nd) } else { nf.push(file[j2]) }
                                j2 += 1
                            }
                            return nf
                        }
                    }
                }
                k += 1
            }
        }
        mi += 1
    }
    return file
}

fn bs() -> Str {
    return "\\"
}
