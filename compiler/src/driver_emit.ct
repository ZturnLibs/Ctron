            println("static ct_i ctron_clo_tramp2(ct_i _e, void* _u) \{ ct_clop _b = (ct_clop)_u; return ((ct_cfn1)(_b->fn))(_b->env, _e); }")
            println("static ct_i ctron_clo_tramp3(ct_i _e, ct_i _x, void* _u) \{ ct_clop _b = (ct_clop)_u; return ((ct_cfn2)(_b->fn))(_b->env, _e, _x); }")
            println("static ctron_list* ct_parallel_mapL(ctron_list* a, ct_fn1 f) \{ ctron_list* r = ctron_list_new(); int i; for (i = 0; i < a->n; i++) \{ ctron_list_push(r, (const char*)(long)f((ct_i)(long)a->items[i])); } return r; }")
                        // T33 真并行(§7.7):K=8 定长分块 fork-join(pthread/join;分块序固定=确定性),
            // reduce 按分块序合并(跳过空块);闭包=裸 fn 指针(ct_emit_clo 捕获即 panic=纯度结构门)
            println("typedef struct \{ ctron_list* src; ctron_list* dst; ct_fn1 f; int lo, hi; } ct_pmap_arg;")
            println("static void* ct_pmap_work(void* p) \{ ct_pmap_arg* a = (ct_pmap_arg*)p; for (int i = a->lo; i < a->hi; i++) a->dst->items[i] = (char*)(long)a->f((ct_i)(long)a->src->items[i]); return 0; }")
            println("typedef struct \{ void* base; int w64; ctron_list* dst; ct_fn1 f; int lo, hi; } ct_pmap_arga;")
            println("static void* ct_pmap_work_a(void* p) \{ ct_pmap_arga* a = (ct_pmap_arga*)p; for (int i = a->lo; i < a->hi; i++) \{ ct_i v = a->w64 ? ((int64_t*)a->base)[i] : (ct_i)((int32_t*)a->base)[i]; a->dst->items[i] = (char*)(long)a->f(v); } return 0; }")
            println("typedef struct \{ void* base; int w64; ct_fn2 f; ct_i init; int lo, hi; ct_i out; } ct_pred_arga;")
            println("static void* ct_pred_work_a(void* p) \{ ct_pred_arga* a = (ct_pred_arga*)p; ct_i acc = a->init; for (int i = a->lo; i < a->hi; i++) \{ ct_i v = a->w64 ? ((int64_t*)a->base)[i] : (ct_i)((int32_t*)a->base)[i]; acc = a->f(acc, v); } a->out = acc; return 0; }")
            println("static ctron_list* ct_pmap_par(ctron_list* a, ct_fn1 f) \{ ctron_list* r = ctron_list_new(); if (a->n <= 0) return r; r->items = (char**)ct_gc_alloc(sizeof(char*) * (size_t)a->n); r->cap = a->n; int K = a->n < 8 ? a->n : 8; pthread_t th[8]; ct_pmap_arg ag[8]; int per = (a->n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].src = a; ag[k].dst = r; ag[k].f = f; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > a->n) ag[k].hi = a->n; if (ag[k].lo >= ag[k].hi) \{ ag[k].hi = ag[k].lo; } pthread_create(&th[k], 0, ct_pmap_work, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); r->n = a->n; return r; }")
            println("typedef struct \{ ctron_list* src; ct_fn2 f; ct_i init; int lo, hi; ct_i out; } ct_pred_arg;")
            println("static void* ct_pred_work(void* p) \{ ct_pred_arg* a = (ct_pred_arg*)p; ct_i acc = a->init; for (int i = a->lo; i < a->hi; i++) acc = a->f(acc, (ct_i)(long)a->src->items[i]); a->out = acc; return 0; }")
            println("static ct_i ct_pred_par(ctron_list* a, ct_i init, ct_fn2 f) \{ if (a->n <= 0) return init; int K = a->n < 8 ? a->n : 8; pthread_t th[8]; ct_pred_arg ag[8]; int per = (a->n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].src = a; ag[k].f = f; ag[k].init = init; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > a->n) ag[k].hi = a->n; if (ag[k].lo > ag[k].hi) ag[k].lo = ag[k].hi; pthread_create(&th[k], 0, ct_pred_work, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); ct_i acc = init; int first = 1; for (int k = 0; k < K; k++) \{ if (ag[k].lo >= ag[k].hi) continue; if (first) \{ acc = ag[k].out; first = 0; } else \{ acc = f(acc, ag[k].out); } } return acc; }")
            println("static ctron_list* ct_pmap_par_a(void* base, int n, int w64, ct_fn1 f) \{ ctron_list* r = ctron_list_new(); if (n <= 0) return r; r->items = (char**)ct_gc_alloc(sizeof(char*) * (size_t)n); r->cap = n; int K = n < 8 ? n : 8; pthread_t th[8]; ct_pmap_arga ag[8]; int per = (n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].base = base; ag[k].w64 = w64; ag[k].dst = r; ag[k].f = f; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > n) ag[k].hi = n; if (ag[k].lo > ag[k].hi) ag[k].lo = ag[k].hi; if (ag[k].lo >= ag[k].hi) ag[k].hi = ag[k].lo; pthread_create(&th[k], 0, ct_pmap_work_a, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); r->n = n; return r; }")
            println("static ct_i ct_pred_par_a(void* base, int n, int w64, ct_fn2 f, ct_i init) \{ if (n <= 0) return init; int K = n < 8 ? n : 8; pthread_t th[8]; ct_pred_arga ag[8]; int per = (n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].base = base; ag[k].w64 = w64; ag[k].f = f; ag[k].init = init; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > n) ag[k].hi = n; if (ag[k].lo > ag[k].hi) ag[k].lo = ag[k].hi; pthread_create(&th[k], 0, ct_pred_work_a, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); ct_i acc = init; int first = 1; for (int k = 0; k < K; k++) \{ if (ag[k].lo >= ag[k].hi) continue; if (first) \{ acc = ag[k].out; first = 0; } else \{ acc = f(acc, ag[k].out); } } return acc; }")
println("static ct_i ct_parallel_reduceL(ctron_list* a, ct_i init, ct_fn2 f) \{ ct_i acc = init; int i; for (i = 0; i < a->n; i++) \{ acc = f(acc, (ct_i)(long)a->items[i]); } return acc; }")
            println("static ct_i ct_clop_call1(ct_clop f, ct_i x) \{ if (f->env == (void*)1) \{ return ((ct_i(*)(ct_i))(f->fn))(x); } return ((ct_i(*)(void*, ct_i))(f->fn))(f->env, x); }")
            println("static ct_i ct_clop_call2(ct_clop f, ct_i a, ct_i b) \{ if (f->env == (void*)1) \{ return ((ct_i(*)(ct_i, ct_i))(f->fn))(a, b); } return ((ct_i(*)(void*, ct_i, ct_i))(f->fn))(f->env, a, b); }")
