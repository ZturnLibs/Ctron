            println("static ctron_list* ct_pmap_par_c(ctron_list* a, ct_clop f) \{ ctron_list* r = ctron_list_new(); if (a->n <= 0) return r; r->items = (char**)ct_gc_alloc(sizeof(char*) * (size_t)a->n); r->cap = a->n; int K = a->n < 8 ? a->n : 8; pthread_t th[8]; ct_pmap_argc ag[8]; int per = (a->n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].src = a; ag[k].dst = r; ag[k].f = f; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > a->n) ag[k].hi = a->n; pthread_create(&th[k], 0, ct_pmap_work_c, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); r->n = a->n; return r; }")
            println("typedef struct \{ ctron_list* src; ct_clop f; ct_i init; ct_i out; int lo, hi; } ct_pred_argc;")
            println("static void* ct_pred_work_c(void* p) \{ ct_pred_argc* a = (ct_pred_argc*)p; ct_i acc = a->init; for (int i = a->lo; i < a->hi; i++) acc = ct_clop_call2(a->f, acc, (ct_i)(long)a->src->items[i]); a->out = acc; return 0; }")
            println("static ct_i ct_pred_par_c(ctron_list* a, ct_i init, ct_clop f) \{ if (a->n <= 0) return init; int K = a->n < 8 ? a->n : 8; pthread_t th[8]; ct_pred_argc ag[8]; int per = (a->n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].src = a; ag[k].f = f; ag[k].init = init; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; pthread_create(&th[k], 0, ct_pred_work_c, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); ct_i acc = init; for (int k = 0; k < K; k++) acc = ct_clop_call2(f, acc, ag[k].out); return acc; }")
