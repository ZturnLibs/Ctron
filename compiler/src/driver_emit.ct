            println("static ctron_list* ct_pmap_par_ac(void* base, int n, int w64, ct_clop f) \{ ctron_list* r = ctron_list_new(); if (n <= 0) return r; r->items = (char**)ct_gc_alloc(sizeof(char*) * (size_t)n); r->cap = n; int K = n < 8 ? n : 8; pthread_t th[8]; ct_pmap_argac ag[8]; int per = (n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].base = base; ag[k].w64 = w64; ag[k].dst = r; ag[k].f = f; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > n) ag[k].hi = n; pthread_create(&th[k], 0, ct_pmap_work_ac, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); r->n = n; return r; }")
            println("typedef struct \{ void* base; ct_clop f; ct_i init; ct_i out; int w64, lo, hi; } ct_pred_argac;")
            println("static void* ct_pred_work_ac(void* p) \{ ct_pred_argac* a = (ct_pred_argac*)p; ct_i acc = a->init; for (int i = a->lo; i < a->hi; i++) \{ ct_i v = a->w64 ? ((int64_t*)a->base)[i] : (ct_i)((int32_t*)a->base)[i]; acc = ct_clop_call2(a->f, acc, v); } a->out = acc; return 0; }")
            println("static ct_i ct_pred_par_ac(void* base, int n, int w64, ct_clop f, ct_i init) \{ if (n <= 0) return init; int K = n < 8 ? n : 8; pthread_t th[8]; ct_pred_argac ag[8]; int per = (n + K - 1) / K; for (int k = 0; k < K; k++) \{ ag[k].base = base; ag[k].w64 = w64; ag[k].f = f; ag[k].init = init; ag[k].lo = k * per; ag[k].hi = (k + 1) * per; if (ag[k].hi > n) ag[k].hi = n; pthread_create(&th[k], 0, ct_pred_work_ac, &ag[k]); } for (int k = 0; k < K; k++) pthread_join(th[k], 0); ct_i acc = init; int first = 1; for (int k = 0; k < K; k++) \{ if (ag[k].lo >= ag[k].hi) continue; if (first) \{ acc = ag[k].out; first = 0; } else \{ acc = ct_clop_call2(f, acc, ag[k].out); } } return acc; }")
