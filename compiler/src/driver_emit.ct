            // 切片视图 typedef(§3.6,P1-D):标量元素码全集无条件前置(宿主 ctron_arr_*/R 线 ct_arr 同形)
            println("typedef struct \{ int32_t* d; int64_t n; } ctron_view_i;")
            println("typedef struct \{ int64_t* d; int64_t n; } ctron_view_6;")
            println("typedef struct \{ void* base; int64_t off; int64_t cap; } ct_arena;")
            println("typedef struct \{ unsigned char* d; int64_t n; } ctron_bytes;")
            println("static ctron_bytes* ctron_read_file_bytes(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return NULL; } fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET); ctron_bytes* b = (ctron_bytes*)ctron_amalloc(sizeof(ctron_bytes)); b->d = (unsigned char*)ctron_amalloc((size_t)(n > 0 ? n : 1)); size_t rd = n > 0 ? fread(b->d, 1, (size_t)n, f) : 0; b->n = (int64_t)rd; fclose(f); return b; }")
            println("static int64_t ctron_bytes_len(ctron_bytes* b) \{ return b ? b->n : 0; }")
            println("static int32_t ctron_bytes_at(ctron_bytes* b, int64_t i) \{ if (!b || i < 0 || i >= b->n) \{ ctron_panic(\"bytes index out of bounds\"); } return (int32_t)b->d[i]; }")
            println("static ctron_bytes* ctron_bytes_slice(ctron_bytes* b, int64_t a, int64_t n) \{ if (!b || a < 0 || n < 0 || a + n > b->n) \{ ctron_panic(\"bytes slice range\"); } ctron_bytes* r = (ctron_bytes*)ctron_amalloc(sizeof(ctron_bytes)); r->d = (unsigned char*)ctron_amalloc((size_t)(n > 0 ? n : 1)); memcpy(r->d, b->d + a, (size_t)n); r->n = n; return r; }")
                        // CC3(2026-10-17):u8s_str 内建宿主口——U8 平面区间批量转 Str(O(n) 一次构造;
            // cas/prolly 大对象路径的 O(n²) 拼接税清偿件;置于 ctron_bytes typedef 后
            println("static const char* ctron_u8s_str(const uint8_t* p, int from, int len) \{ if (len < 0 || from < 0) \{ ctron_panic(\"u8s_str: range\"); } char* r = (char*)ct_gc_alloc((size_t)len + 1); if (p && len > 0) \{ memcpy(r, p + from, (size_t)len); } r[len] = 0; return r; }")
println("static const char* ctron_bytes_to_str(ctron_bytes* b) \{ int64_t n = 0; if (b) \{ n = b->n; for (int64_t i = 0; i < n; i++) \{ if (b->d[i] == 0) \{ n = i; break; } } } char* r = (char*)ctron_amalloc((size_t)(n + 1)); memcpy(r, b ? (const void*)b->d : (const void*)r, (size_t)n); r[n] = 0; return r; }")
            println("static long ctron_rbn_g = 0;")
            println("static unsigned char* ctron_rb_g = NULL;")
            println("static int64_t ctron_read_bytes_len(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return -1; } fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET); if (ctron_rb_g) free(ctron_rb_g); ctron_rb_g = (unsigned char*)ctron_amalloc((size_t)(sz > 0 ? sz : 1)); size_t rd = sz > 0 ? fread(ctron_rb_g, 1, (size_t)sz, f) : 0; fclose(f); ctron_rbn_g = (long)rd; return (int64_t)rd; }")
            println("static int32_t ctron_read_bytes_at(int64_t i) \{ if (!ctron_rb_g || i < 0 || i >= (int64_t)ctron_rbn_g) \{ return 0; } return (int32_t)ctron_rb_g[i]; }")
            // T41 余债:bump 前进溢出守卫——旧判式 a->off + n 有符号溢出 UB(负 n/
            // 回绕 n 溜过检查),改差式无符号比较(cap-off 恒在 [0,cap] 不回绕)
            println("static void* ct_arena_bump(ct_arena* a, long long n) \{ if (n < 0 || (unsigned long long)n > (unsigned long long)(a->cap - a->off)) \{ ctron_panic(\"arena exhausted\"); } void* p = (char*)a->base + a->off; a->off += n; return p; }")
            // T41 余债:Region 区段回卷(mark 快照 → reset 守卫回卷;负值/超前=panic)
            println("static void ct_arena_reset(ct_arena* a, long long m) \{ if (m < 0 || m > a->off) \{ ctron_panic(\"arena exhausted\"); } a->off = m; }")
            // G1-T4:Region.heap()——线程段锚定手动分段(LIFO 纪律,专家工具)。
            // 堆形视图 base=当前线程竞技场(任务=私有段,主=全局)现块数据址;
            // mark/reset 按视图 base dispatch:命中线程竞技场=堆形(回卷真实 off,
            // 跨增长块=panic),否则栈形落回 ct_arena_reset。栈形 base=alloca 帧址,
            // 与堆块数据址不相交,dispatch 无歧义。
            println("static ct_arn* ct_region_cur(void) \{ return ct_tls_arn ? ct_tls_arn : &ctron_aglobal; }")
            println("static ct_arena ct_region_heap(void) \{ ct_arn* a = ct_region_cur(); ct_arena v; v.base = a->cur ? (void*)(a->cur + 1) : (void*)0; v.off = (long long)a->off; v.cap = a->cur ? (long long)a->cur->cap : 0; return v; }")
            println("static long long ct_region_mark(ct_arena* v) \{ ct_arn* a = ct_region_cur(); if (a->cur && (char*)(a->cur + 1) == (char*)v->base) \{ return (long long)a->off; } return v->off; }")
            println("static void ct_region_reset(ct_arena* v, long long m) \{ ct_arn* a = ct_region_cur(); if (a->cur && (char*)(a->cur + 1) == (char*)v->base) \{ if (m < 0 || m > (long long)a->off) \{ ctron_panic(\"region reset across growth\"); } a->off = (size_t)m; return; } ct_arena_reset(v, m); }")
            // T41 余债:Pool 定长对象池——空闲链头插法(esz 8 字节下限承链域;
            // 链终止符=cap,free_head>=cap 即池尽;free 后 LIFO 复用)
            println("typedef struct \{ void* base; int64_t esz; int64_t cap; int64_t free_head; } ct_pool;")
            println("static void ct_pool_init(ct_pool* p, void* base, long long esz, long long n) \{ if (esz < 8) \{ esz = 8; } p->base = base; p->esz = esz; p->cap = n; p->free_head = 0; \{ long long i = 0; while (i < n) \{ *(long long*)((char*)base + i * esz) = i + 1; i += 1; } } }")
            println("static long long ct_pool_alloc(ct_pool* p) \{ if (p->free_head >= p->cap) \{ ctron_panic(\"pool exhausted\"); } long long i = p->free_head; p->free_head = *(long long*)((char*)p->base + i * p->esz); return i; }")
            println("static void ct_pool_free(ct_pool* p, long long i) \{ *(long long*)((char*)p->base + i * p->esz) = p->free_head; p->free_head = i; }")
            println("static ctron_view_i ct_arena_zeros_i(ct_arena* a, long long n) \{ ctron_view_i v; v.d = (int32_t*)ct_arena_bump(a, n * 4); memset(v.d, 0, (size_t)(n * 4)); v.n = n; return v; }")
            println("typedef struct \{ int* d; int64_t n; } ctron_view_b;")
            println("typedef struct \{ const char** d; int64_t n; } ctron_view_s;")
            println("typedef struct \{ double* d; int64_t n; } ctron_view_f;")
            println("typedef struct \{ float* d; int64_t n; } ctron_view_g;")
            // 标量全集(ptr_as_view v0.9·五:裸指针读覆盖全部定宽标量)
            println("typedef struct \{ uint64_t* d; int64_t n; } ctron_view_7;")
            println("typedef struct \{ uint8_t* d; int64_t n; } ctron_view_w8u;")
            println("typedef struct \{ int8_t* d; int64_t n; } ctron_view_w8s;")
            println("typedef struct \{ uint16_t* d; int64_t n; } ctron_view_w16u;")
            println("typedef struct \{ int16_t* d; int64_t n; } ctron_view_w16s;")
            println("typedef struct \{ size_t* d; int64_t n; } ctron_view_z;")
            // 用户 struct 值类型(§6.1):typedef 先于原型与函数体;#[repr(...)] 变体
            // (packed/align(N),v0.7 §9.6)直出 GNU 属性(声明序布局不变)
            // P0-A 泛型 struct 实例化 typedef 预扫(载荷扩位):fn 参数/返回注解 +
            // 具体 struct 字段注解 + 体面 let/var 注解(Fn/FnPub/Test),再按实例
            // 字段嵌套传递闭包(Route[App] 经 Router[App] 字段可达)
            var insts = List[Str]()
            var ii: I32 = 1
            while ii < file.len {
                var gd = file[ii]
                if or2(gd[0] == "Fn", gd[0] == "FnPub") {
                    var gk: I32 = 1
                    while gk < gd[3].len {
                        var pr = gd[3][gk]
                        if pr[0] == "Param" {
                            if pr[3][0] == "Named" {
                                if ct_struct_tps(file, pr[3][1]).len > 0 {
                                    if pr[3][2].len > 1 {
                                        var cs2 = List[Str]()
                                        var q2: I32 = 1
                                        while q2 < pr[3][2].len {
                                            cs2.push(ct_ty_code(pr[3][2][q2], file))
                                            q2 += 1
                                        }
                                        inst_try_collect(insts, ct_struct_inst_code(pr[3][1], cs2))
                                    }
                                }
                            }
                            if pr[3][0] == "FnType" {
                                ct_ty_node_insts(file, pr[3], insts)
                            }
                        }
                        gk += 1
                    }
                    if gd[4][0] == "Named" {
                        if ct_struct_tps(file, gd[4][1]).len > 0 {
                            if gd[4][2].len > 1 {
                                var cs3 = List[Str]()
                                var q3: I32 = 1
                                while q3 < gd[4][2].len {
                                    cs3.push(ct_ty_code(gd[4][2][q3], file))
                                    q3 += 1
                                }
                                inst_try_collect(insts, ct_struct_inst_code(gd[4][1], cs3))
                            }
                        }
                    } else if gd[4][0] == "FnType" {
                        ct_ty_node_insts(file, gd[4], insts)
                    }
                    // 体面 let/var 注解(非泛型体;泛型体无具体码)
                    if gd[2].len < 2 {
                        ct_let_insts_b(gd[5], file, insts)
                    }
                } else if gd[0] == "Test" {
                    ct_let_insts_b(gd[2], file, insts)
                } else if gd[0] == "Struct" {
                    // 具体 struct 字段注解(实例字段嵌用:P0-A 前漏出致 C 未定义型)
                    var fk: I32 = 1
                    while fk < gd[4].len {
                        inst_try_collect(insts, ct_ty_code(gd[4][fk][3], file))
                        fk += 1
                    }
                }
                ii += 1
            }
            // 嵌套传递闭包:实例字段引用的实例(u:/Lu: 槽)逐层入表至不动点
            var expanded = true
            while expanded {
                expanded = false
                var px: I32 = 0
                while px < insts.len {
                    var infox = ct_struct_inst_split(insts[px])
                    var barx = 0
                    var cx: I32 = 0
                    while cx < infox.len {
                        if byte_at(infox, cx) == 124 { barx = cx }
                        cx += 1
                    }
                    var snmx = byte_slice(infox, 0, barx)
                    var encsx = byte_slice(infox, barx + 1, infox.len)
                    var iy: I32 = 1
                    while iy < file.len {
                        var sdy = file[iy]
                        if sdy[0] == "Struct" && sdy[1] == snmx {
                            var fy: I32 = 1
                            while fy < sdy[4].len {
                                var before = insts.len
                                inst_try_collect(insts, ct_field_code_inst(file, sdy[4][fy][3], snmx, encsx))
                                if insts.len > before {
                                    expanded = true
                                }
                                fy += 1
                            }
                        }
                        iy += 1
                    }
                    px += 1
                }
            }

            // §8.5 单态化实例预算(E6040;T07):显式 TypeArgs 泛型 fn 特化去重计数 +
            // 泛型 struct 实例(insts),超限建议 &Trait 化;CTRON_MONO_BUDGET 可调(默认 8192)。
            // v0 计显式位;推断特化随 §3.9.1 ex_ty 保留实参登记并入
            var mokeys = List[Str]()
            var mi2: I32 = 1
            while mi2 < file.len {
                var md2 = file[mi2]
                if or2(md2[0] == "Fn", or2(md2[0] == "FnPub", md2[0] == "Test")) {
                    if md2[0] == "Test" {
                        mono_b(md2[2], file, mokeys)
                    } else {
                        if md2[2].len < 2 {
                            mono_b(md2[5], file, mokeys)
                        }
                    }
                }
                mi2 += 1
            }
            // P0-A:&T 形参(pu: 码)实例 typedef 预扫——非泛型 fn 的 &Req[S] 形参
            // 的实例 typedef 须先于原型前置区(t_Req__X* 原型位)
            var pi7: I32 = 1
            while pi7 < file.len {
                var pd7 = file[pi7]
                if or2(pd7[0] == "Fn", or2(pd7[0] == "FnPub", pd7[0] == "FnC")) {
                    var pk7: I32 = 1
                    while pk7 < pd7[3].len {
                        if pd7[3][pk7][0] == "Param" {
                            inst_try_collect(insts, ct_ty_code(pd7[3][pk7][3], file))
                        }
                        if pd7[3][pk7][3][0] == "FnType" {
                            ct_ty_node_insts(file, pd7[3][pk7][3], insts)
                        }
                        pk7 += 1
                    }
                }
                pi7 += 1
            }
            var mobud = 8192
            var mbe = env_get("CTRON_MONO_BUDGET")
            if mbe.len > 0 {
                mobud = dvi(mbe)
            }
            if mokeys.len + insts.len > mobud {
                println("E6040: 单态化实例预算超限(mono budget): " + (mokeys.len + insts.len).to_string() + " > " + mobud.to_string() + "(显式特化 " + mokeys.len.to_string() + " + struct 实例 " + insts.len.to_string() + ";建议 &Trait 化,CTRON_MONO_BUDGET 可调)")
                return 1
            }
            // P0-A 发射序:具体 struct 按声明序直出,字段引用实例先出其 typedef
            //(嵌套依序;实例嵌入实参 struct,声明序即拓扑序前提与语料一致);
            // 枚举同旧。余下实例(仅 fn 签名/体注解可达)随后统一直出。
            var td_done = List[Str]()
            // P0-A:Mutex 字段 mcell 前置(App.todos: Mutex[List[Todo]] 即此形)——
            // mcell typedef 旧仅构造点 pass1 直出,struct typedef 先于一切 fn 体,
            // 字段槽 ct_mcell_<tag> 无定义即 C 未声明型
            var mcdone = List[Str]()
            var si0: I32 = 1
            while si0 < file.len {
                var sd0 = file[si0]
                if sd0[0] == "Struct" {
                    var fj00: I32 = 1
                    while fj00 < sd0[4].len {
                        var fc00 = ct_ty_code(sd0[4][fj00][3], file)
                        if fc00.len > 1 && byte_at(fc00, 0) == 109 {
                            if !in_list(mcdone, fc00) {
                                mcdone.push(fc00)
                                ct_mcell_emit(byte_slice(fc00, 1, fc00.len))
                            }
                        }
                        fj00 += 1
                    }
                }
                si0 += 1
            }
            var si: I32 = 1
            while si < file.len {
                var sd = file[si]
                if sd[0] == "Struct" {
                    var fs = sd[4]
                    var fj0: I32 = 1
                    while fj0 < fs.len {
                        var fc0 = ct_ty_code(fs[fj0][3], file)
                        if fc0.len > 2 && byte_slice(fc0, 0, 2) == "u:" && ct_struct_inst_split(fc0).len > 1 {
                            ct_inst_td_emit(file, fc0, td_done)
                        }
                        fj0 += 1
                    }
                    var line = "typedef struct \{ "
                    var fj: I32 = 1
                    while fj < fs.len {
                        var fd = fs[fj]
                        var fc = ct_ty_code(fd[3], file)
                        // 定长数组字段(v0.9 §二·七 登记面):a<N><ec> → <ctype(ec)> <名>[N]
                        // (此前无臂落 int32_t 兜底,布局错)
                        if fc.len >= 3 && byte_at(fc, 0) == 97 {
                            line = line + ct_ctype(a_elem(fc)) + " " + fd[2] + "[" + a_count(fc) + "]; "
                        } else {
                            line = line + ct_ctype(fc) + " " + fd[2] + "; "
                        }
                        fj += 1
                    }
                    line = line + "} " + ct_struct_attr_suffix(sd) + "t_" + sd[1] + ";"
                    println(line)
                } else if sd[0] == "Enum" {
                    println("typedef struct \{ int variant; ct_i p[2]; } ct_enum_" + sd[1] + ";")
                    // IP-01 W2:变体名表(AnyError 物化 code=变体名,与解释臂 v0 对齐)
                    var vn = "static const char* ct_vnames_" + sd[1] + "[] = \{"
                    var vi2: I32 = 1
                    var vfirst = true
                    while vi2 < sd[3].len {
                        if !vfirst {
                            vn = vn + ","
                        }
                        vn = vn + "\"" + sd[3][vi2][1] + "\""
                        vfirst = false
                        vi2 += 1
                    }
                    vn = vn + ", 0};"
                    println(vn)
                }
                si += 1
            }
            var pi3: I32 = 0
            while pi3 < insts.len {
                ct_inst_td_emit(file, insts[pi3], td_done)
                pi3 += 1
            }
            // 文件级 static let(Phase 4 自举闭环:发射层缓冲静态自身也需要被发射):
            // 零初始化声明 + ctron_statics_init() 运行期赋值(文件域函数调用初始化非法)
            var stq: I32 = 1
            var sinit = ""
            var ccN = List[Str]()
            var ccV = List[Str]()
            while stq < file.len {
                var st = file[stq]
                if st[0] == "Static" && st[2] == "false" {
                    var scode = ct_ty_code(st[3], file)
                    println("static " + ct_ctype(scode) + " t_" + st[1] + " = 0;")
                    sinit = sinit + " t_" + st[1] + " = " + ct_expr(st[4], List[Str](), file) + ";"
                }
                // const 穿发射(§8.4 comptime):ceval 折叠值直出 C 常量定义
                // (const 环境跨 decl 累积,镜像 sem_comptime;v0 数值域 I/6/B)
                if st[0] == "Const" {
                    var cst2 = List[Str]()
                    cst2.push("0")
                    var cvr = ceval_expr(file, st[3], ccN, ccV, cst2)
                    // G1-T8(W4①):ceval v0 数值域失手(u)→ CVM 回退——check 侧
                    // sem_comptime 已以预算试求值放行,发射侧同机器补折叠(cc_emit
                    // 含 CORE=eval 机器);数组注解位直落静态聚合声明
                    if cvr[0] != "k" {
                        if st[2].len > 1 && seq2(st[2][0], "ArrayT") {
                            var evr = eval_expr(file, statics_env(file), "", st[3])
                            if evr.kind == "k" && evr.v.tag == 8 {
                                var acode = ct_ty_code(st[2], file)
                                var aec = ct_ctype(a_elem(acode))
                                var acc5 = ""
                                var q5: I32 = 1
                                var first5 = true
                                while q5 < cx_of(evr.v).len {
                                    if !first5 { acc5 = acc5 + ", " }
                                    first5 = false
                                    var ev5 = v_unbox(cx_of(evr.v)[q5])
                                    var et5 = vtag_str(ev5)
                                    if et5 == "I" {
                                        acc5 = acc5 + dvi_str(ev5.iv.as[I32]())
                                    } else if et5 == "6" {
                                        acc5 = acc5 + v6t(ev5) + "LL"
                                    } else if et5 == "B" {
                                        if ev5.b { acc5 = acc5 + "1" } else { acc5 = acc5 + "0" }
                                    } else if et5 == "S" {
                                        acc5 = acc5 + ct_str_cquote(ev5.s)
                                    } else if et5 == "D" {
                                        acc5 = acc5 + ev5.s
                                    } else {
                                        acc5 = acc5 + "0"
                                    }
                                    q5 += 1
                                }
                                println("static " + aec + " t_" + st[1] + "[" + (cx_of(evr.v).len - 1).to_string() + "] = \{" + acc5 + "};")
                                // 链式 const 引用(后续 const 呼名本件)不登记=ceval 域
                                // 未知名,后续波次;v1 直落声明即达所辖
                                println("//CV:" + st[1] + ":arr")
                                stq += 1
                                continue
                            }
                        }
                    }
                    println("//CV:" + st[1] + ":" + cvr[0])
                    if cvr[0] == "k" {
                        var cvv = v_unbox(cvr[2])
                        var vt = vtag_str(cvv)
                        ccN.push(st[1])
                        ccV.push(cvr[2])
                        if vt == "I" {
                            println("static int32_t t_" + st[1] + " = " + dvi_str(cvv.iv.as[I32]()) + ";")
                        }
                        if vt == "6" {
                            println("static int64_t t_" + st[1] + " = " + v6t(cvv) + "LL;")
                        }
                        if vt == "B" {
                            var bv = "0"
                            if cvv.b { bv = "1" }
                            println("static int32_t t_" + st[1] + " = " + bv + ";")
                        }
                        if vt == "S" {
                            println("static const char* t_" + st[1] + " = " + ct_str_cquote(cvv.s) + ";")
                        }
                        if vt == "D" {
                            println("static double t_" + st[1] + " = " + cvv.s + ";")
                        }
                    }
                }
                stq += 1
            }
            if sinit != "" {
                println("static void ctron_statics_init(void) \{" + sinit + " }")
                println("static int ctron_exp_init = 0;")
            }
            // #[link(name = "x")](§9.6 v0.8):链接依赖以 ctron:link 注释落产物,
            // 驱动层读取后传 cc(发射器职责止于 C 文本,不直接调用链接器)
            var lq2: I32 = 1
            while lq2 < file.len {
                var ld2 = file[lq2]
                if ld2[0] == "FnExt" && ld2.len > 7 && attr_has(ld2[6], "link") {
                    var larg = attr_arg(ld2[6])
                    var eqp2 = -1
                    var q4: I32 = 0
                    while q4 < larg.len {
                        if byte_at(larg, q4) == 61 {
                            eqp2 = q4
                        }
                        q4 += 1
                    }
                    if eqp2 > 0 {
                        var lkey = ct_trim(byte_slice(larg, 0, eqp2))
                        var lval = ct_trim(byte_slice(larg, eqp2 + 1, larg.len))
                        if lval.len > 1 && byte_at(lval, 0) == 34 {
                            lval = byte_slice(lval, 1, lval.len - 1)
                        }
                        // G2-W3:link 三形态——name → -l / search → -L / framework(darwin)
                        if lkey == "name" {
                            println("// ctron:link -l" + lval)
                        } else if lkey == "search" {
                            println("// ctron:ldflag -L" + lval)
                        } else if lkey == "framework" {
                            println("// ctron:ldflag -framework " + lval)
                        } else {
                            println("// ctron:link -l" + lval)
                        }
                    }
                }
                lq2 += 1
            }
            // 原型前置:C 需先声明后用(语料存在前向引用/递归);extern 声明仅原型(§9.6)
            var pj: I32 = 1
            while pj < file.len {
                var pd = file[pj]
                if pd[0] == "FnExt" {
                    var isdls = false
                    var lsym = ""
                    if pd.len > 7 {
                        if attr_has(pd[6], "dlsym") { isdls = true }
                        if attr_has(pd[6], "link_name") { lsym = attr_arg(pd[6]) }
                    }
                    if isdls {
                        // #[dlsym] thunk(§9.6 v0.7):静态链接改运行期解析——dlsym(RTLD_DEFAULT)
                        // 首调缓存,缺符号 ctron_panic;经 fn 指针按边界类型直调(变参表自然透传)
                        var tret = ct_abi_ctype(ct_fn_ret(file, pd[1]))
                        var tps = ct_params_str_ext(pd, file)
                        var targs = ct_export_args(pd)
                        var tcall = "((" + tret + "(*)(" + ct_params_str_bare(pd, file) + "))ct_dls)(" + targs + ");"
                        var tbody = "return " + tcall
                        if seq2(tret, "void") { tbody = tcall }
                        // G2-W2:from_handle 变体——首参=句柄,逐调 dlsym((void*)h)
                        //(不缓存:句柄可失效/多库同名;失效响亮);调用实参剥首参
                        // G2-W2:from_handle 变体——首参=句柄,逐调 dlsym(不缓存,失效响亮)
                        var darg = attr_arg(pd[6])
                        if darg != "from_handle" {
                            // 叠 attr 首括号语义抗性:dlsym(from_handle) 子串直扫
                            var a6 = pd[6]
                            var si: I32 = 0
                            var found: I32 = 0
                            while si < a6.len {
                                if si + 18 <= a6.len && byte_slice(a6, si, si + 18) == "dlsym(from_handle)" {
                                    found = 1
                                    si = a6.len
                                }
                                si += 1
                            }
                            if found == 1 { darg = "from_handle" }
                        }
                        if darg == "from_handle" {
                            var hname = "t_" + pd[3][1][2]
                            var sym2 = lsym
                            if sym2 == "" { sym2 = pd[1] }
                            var targs2 = ct_export_args_from(pd, 2)
                            var tproto2 = ct_params_str_bare_from(pd, file, 2)
                            var tcall2 = "((" + tret + "(*)(" + tproto2 + "))ct_dls)(" + targs2 + ");"
                            var tbody2 = "return " + tcall2
                            if seq2(tret, "void") { tbody2 = tcall2 }
                            println("static " + tret + " ct_dyn_" + pd[1] + "(" + tps + ") \{ void* ct_dls = dlsym((void*)(intptr_t)(" + hname + "), \"" + sym2 + "\"); if (ct_dls == 0) \{ ctron_panic(\"dlsym 句柄未解析符号: " + sym2 + "\"); } " + tbody2 + " }")
                        } else {
                        println("static " + tret + " ct_dyn_" + pd[1] + "(" + tps + ") \{ static void* ct_dls = 0; if (ct_dls == 0) \{ ct_dls = dlsym(RTLD_DEFAULT, \"" + pd[1] + "\"); if (ct_dls == 0) \{ ctron_panic(\"dlsym 未解析符号: " + pd[1] + "\"); } } " + tbody + " }")
                        }
                    } else {
                        // extern 声明(§9.6):外部链接原型(裸符号,定义在 C 侧/c_src);
                        // static 会把符号钉在本 TU 内——跨 TU 链接是未定义行为,旧实现靠
                        // 链接器宽容才可用;形参按边界映射(fn 指针 ct_fnK);
                        // #[link_name(x)] → 以 x 出原型(v0.7 符号重命名)
                        var esym = pd[1]
                        if lsym != "" { esym = lsym }
                        var eret = ct_abi_ctype(ct_fn_ret(file, pd[1]))
                        if ct_ext_ret_optstr(file, pd[1]) {
                            eret = "const char*"
                        }
                        println("extern " + eret + " " + esym + "(" + ct_params_str_ext(pd, file) + ");")
                    }
                } else if or2(pd[0] == "Fn", pd[0] == "FnPub") {
                    // 泛型 fn 无具体原型;特化定义在 pass1 直出且先于引用
                    if pd[2].len < 2 {
                        println("static " + ct_ctype(ct_fn_ret(file, pd[1])) + " t_" + pd[1] + "(" + ct_params_str(pd, file) + ");")
                    }
                }
                pj += 1
            }
            // SL-7β3:骨架 C 静态构造(gui 程序专用;此刻 t_<Struct> typedef 已发射,
            // 先于用户函数体——调用点前向可见)。编译期 gui_sk_build 的表 → 静态数组
            // → gui_sk_load() 组装 t_GuiTree 返回,运行时零 CTML 解析
            var has_gui: Bool = false
            var gg: I32 = 1
            while gg < file.len {
                if file[gg][0] == "GuiBlock" {
                    has_gui = true
                }
                gg += 1
            }
            if has_gui {
                var ntag = List[Str]()
                var nflag = List[Str]()
                var ncls = List[Str]()
                var npre = List[Str]()
                var nbid = List[Str]()
                var npost = List[Str]()
                var nfc = List[I32]()
                var ns = List[I32]()
                var nes = List[I32]()
                var nec = List[I32]()
                var ev_name = List[Str]()
                var ev_fn = List[Str]()
                var btns = List[I32]()
                var sk = List[Str]()
                var sv = List[Str]()
                var sk_props = List[Str]()
                gui_sk_build(file, ntag, nflag, ncls, npre, nbid, npost, nfc, ns, nes, nec, ev_name, ev_fn, btns, sk, sv, sk_props)
                println("static ctron_list* gui_sk_ls(int n, const char** v) \{ ctron_list* l = ctron_list_new(); int i; for (i = 0; i < n; i++) \{ ctron_list_push(l, v[i]); } return l; }")
                println("static ctron_list* gui_sk_li(int n, const int32_t* v) \{ ctron_list* l = ctron_list_new(); int i; for (i = 0; i < n; i++) \{ ctron_list_push(l, (const char*)(long)v[i]); } return l; }")
                println("static t_GuiTree gui_sk_load(void) \{")
                // 全零初始化:骨架树只填 SoA 16 槽,vreg_*/vc_*/props_dflt/env_* 等
                // 字段本契约=NULL(消费端 gui_list_ns/ni NULL 门控)——此前裸声明
                // 未赋槽返回栈垃圾,s23_sk_native gui_list_ni 段错误实证
                println("t_GuiTree t; memset(&t, 0, sizeof(t));")
                println(gui_sk_emit_str_arr(0, ntag))
                println(gui_sk_emit_str_arr(1, nflag))
                println(gui_sk_emit_str_arr(2, ncls))
                println(gui_sk_emit_str_arr(3, npre))
                println(gui_sk_emit_str_arr(4, nbid))
                println(gui_sk_emit_str_arr(5, npost))
                println(gui_sk_emit_int_arr(6, nfc))
                println(gui_sk_emit_int_arr(7, ns))
                println(gui_sk_emit_int_arr(8, nes))
                println(gui_sk_emit_int_arr(9, nec))
                println(gui_sk_emit_str_arr(10, ev_name))
                println(gui_sk_emit_str_arr(11, ev_fn))
                println(gui_sk_emit_int_arr(12, btns))
                println(gui_sk_emit_str_arr(13, sk))
                println(gui_sk_emit_str_arr(14, sv))
                println("t.ntag = gui_sk_ls(" + ntag.len.to_string() + ", sk_t0);")
                println("t.nflag = gui_sk_ls(" + nflag.len.to_string() + ", sk_t1);")
                println("t.ncls = gui_sk_ls(" + ncls.len.to_string() + ", sk_t2);")
                println("t.npre = gui_sk_ls(" + npre.len.to_string() + ", sk_t3);")
                println("t.nbid = gui_sk_ls(" + nbid.len.to_string() + ", sk_t4);")
                println("t.npost = gui_sk_ls(" + npost.len.to_string() + ", sk_t5);")
                println("t.nfc = gui_sk_li(" + nfc.len.to_string() + ", sk_t6);")
                println("t.ns = gui_sk_li(" + ns.len.to_string() + ", sk_t7);")
                println("t.nes = gui_sk_li(" + nes.len.to_string() + ", sk_t8);")
                println("t.nec = gui_sk_li(" + nec.len.to_string() + ", sk_t9);")
                println("t.ev_name = gui_sk_ls(" + ev_name.len.to_string() + ", sk_t10);")
                println("t.ev_fn = gui_sk_ls(" + ev_fn.len.to_string() + ", sk_t11);")
                println("t.btns = gui_sk_li(" + btns.len.to_string() + ", sk_t12);")
                println("t.sk = gui_sk_ls(" + sk.len.to_string() + ", sk_t13);")
                println("t.sv = gui_sk_ls(" + sv.len.to_string() + ", sk_t14);")
                println(gui_sk_emit_str_arr(15, sk_props))
                println("t.props = gui_sk_ls(" + sk_props.len.to_string() + ", sk_t15);")
                println("return t;")
                println("}")
            }
            // Drop 方法原型(§6.4):impl Drop for T → t_<T>__drop 前置声明
            var dq: I32 = 1
            while dq < file.len {
                var qd = file[dq]
                if qd[0] == "Impl" && seq2(ty_head(qd[2]), "Drop") {
                    var qf = ty_head(qd[3])
                    if qd[1].len < 2 {
                        println("static void t_" + qf + "__drop(t_" + qf + " t_self);")
                        println("static void ctron_dth_" + qf + "(void* p) \{ t_" + qf + "__drop(*((t_" + qf + "*)p)); }")
                    }
                }
                dq += 1
            }
            var di: I32 = 1
            var hasmain = false
            var ntest: I32 = 0
            var testcalls = ""
            // T25:&Trait vtable + thunk + 常量发射(§3.5)
            ct_vtable_emit(file)
            // pass1:shim/typedef 发现与直出(函数体不发射,eln 门控丢弃)
            di = 1
            while di < file.len {
                var d1 = file[di]
                if d1[0] == "Fn" {
                    if d1[2].len < 2 {
                        ct_fn(d1, file, "1")
                    }
                } else if d1[0] == "FnPub" {
                    if d1[2].len < 2 {
                        ct_fn(d1, file, "1")
                    }
                } else if d1[0] == "Test" {
                    var penv1 = env_bind(List[Str](), "#p", "1")
                    var tenv1 = ct_stmts(d1[2], penv1, file, "", List[Str]())
                    var tl1 = d1[2][d1[2].len - 1]
                    if tl1[0] != "None" {
                        var es1 = List[Str]()
                        es1.push("Expr")
                        es1.push(tl1)
                        ct_stmt(es1, tenv1, file, List[Str]())
                    }
                } else if d1[0] == "Impl" {
                    ct_drop_fn(d1, file, "1")
                }
                di += 1
            }
            // pass2:函数体发射
            di = 1
            while di < file.len {
                var d = file[di]
                if or2(d[0] == "Fn", d[0] == "FnPub") {
                    if d[1] == "main" {
                        hasmain = true
                    }
                    // 泛型 fn(TPs 非空)不按具体 fn 发射:型参无实型别码,
                    // 只经调用点 TypeArgs 单态化特化(4cb9809)存在
                    if d[2].len < 2 {
                        ct_fn(d, file, "2")
                        // #[export](§9.6 v0.7):非静态 C 符号包装——C 工程直链 Ctron 函数
                        //(嵌入面);直透 t_<名>,文件有 static let 时首调过初始化守卫
                        if d.len > 6 && seq2(d[6], "export") {
                            var wret = ct_abi_ctype(ct_fn_ret(file, d[1]))
                            var wcall = "t_" + d[1] + "(" + ct_export_args(d) + ");"
                            var wbody = wcall
                            if !seq2(wret, "void") { wbody = "return " + wcall }
                            var wguard = ""
                            if sinit != "" {
                                wguard = "if (ctron_exp_init == 0) \{ ctron_exp_init = 1; ctron_statics_init(); } "
                            }
                            println(wret + " " + d[1] + "(" + ct_params_str(d, file) + ") \{ " + wguard + wbody + " }")
                        }
                    }
                } else if d[0] == "Test" {
                    // test 块 → int fn:断言失败 return 1(语句位 assert 发射),成功 return 0
                    var penv2 = env_bind(List[Str](), "#p", "2")
                    penv2 = env_bind(penv2, "#intest", "1")
                    penv2 = dls_push(penv2)
                    eln("static int32_t t_test_" + ntest.to_string() + "(void) \{", penv2)
                    // T31 M1.5:test 块帧(体内 let 注册行需 ct_frn 在 scope)
                    eln(ct_fr_prologue(), penv2)
                    var tenv = ct_stmts(d[2], penv2, file, "", List[Str]())
                    var tl = d[2][d[2].len - 1]
                    if tl[0] != "None" {
                        var es = List[Str]()
                        es.push("Expr")
                        es.push(tl)
                        ct_stmt(es, tenv, file, List[Str]())
                    }
                    dls_pop_emit(tenv, file)
                    eln("return 0;", penv2)
                    eln("}", penv2)
                    testcalls = testcalls + "if (t_test_" + ntest.to_string() + "()) \{ return 1; } "
                    ntest += 1
                } else if d[0] == "Impl" {
                    ct_drop_fn(d, file, "2")
                }
                di += 1
            }
            var scall = ""
            if sinit != "" {
                scall = "ctron_statics_init(); "
            }
            if hasmain {
                // 裸 fn main()(无 -> I32)返回 void:包装不得 cast void(C 约束违规,
                // emit 面对裸 main 直接 cc 不过)——与 export 包装同口径:void 直呼 + return 0
                var mret = ct_abi_ctype(ct_fn_ret(file, "main"))
                var mcall = "return (int)t_main(); }"
                if seq2(mret, "void") { mcall = "t_main(); return 0; }" }
                println("int main(int argc, char** argv) \{ ctron_argc_g = argc; ctron_argv_g = argv; ct_gc_stack_base = (char*)&argc; " + scall + "if (argc >= 2 && !strcmp(argv[1], \"--version\")) \{ puts(ctron_version); return 0; } \{ int ctron_ai; for (ctron_ai = 3; ctron_ai < argc; ctron_ai++) \{ if (!strncmp(argv[ctron_ai], \"--format=\", 9)) \{ ctron_cli_fmt = argv[ctron_ai] + 9; } else if (!strncmp(argv[ctron_ai], \"--profile=\", 10)) \{ ctron_cli_prof = argv[ctron_ai] + 10; } else if (!strcmp(argv[ctron_ai], \"--trusted\")) \{ ctron_cli_trusted = \"1\"; } else if (!strcmp(argv[ctron_ai], \"--dump-gui\")) \{ ctron_cli_dumpgui = \"1\"; } } } \u{0A}#if defined(_WIN32) \u{0A}SetConsoleOutputCP(CP_UTF8); \u{0A}_setmode(_fileno(stdout), _O_BINARY); \u{0A}#endif\u{0A} if (argc >= 3 && strcmp(argv[1], \"run\") == 0) \{ ctron_cli_input = argv[2]; ctron_argv_off = 3; } " + testcalls + mcall)
            } else {
                println("int main(int argc, char** argv) \{ ctron_argc_g = argc; ctron_argv_g = argv; ct_gc_stack_base = (char*)&argc; " + scall + "if (argc >= 2 && !strcmp(argv[1], \"--version\")) \{ puts(ctron_version); return 0; } \{ int ctron_ai; for (ctron_ai = 3; ctron_ai < argc; ctron_ai++) \{ if (!strncmp(argv[ctron_ai], \"--format=\", 9)) \{ ctron_cli_fmt = argv[ctron_ai] + 9; } else if (!strncmp(argv[ctron_ai], \"--profile=\", 10)) \{ ctron_cli_prof = argv[ctron_ai] + 10; } else if (!strcmp(argv[ctron_ai], \"--trusted\")) \{ ctron_cli_trusted = \"1\"; } else if (!strcmp(argv[ctron_ai], \"--dump-gui\")) \{ ctron_cli_dumpgui = \"1\"; } } } \u{0A}#if defined(_WIN32) \u{0A}SetConsoleOutputCP(CP_UTF8); \u{0A}_setmode(_fileno(stdout), _O_BINARY); \u{0A}#endif\u{0A} if (argc >= 3 && strcmp(argv[1], \"run\") == 0) \{ ctron_cli_input = argv[2]; ctron_argv_off = 3; } " + testcalls + "return 0; " + "}")
            }
            return 0
        }
        None => {
            println("read-failed")
            return 1
        }
    }
}

// ---------------- §8.5 单态化实例计数走查(T07;E6040) ----------------
// 显式 TypeArgs 泛型调用去重键收集(形状镜像 sem_walk 走查)
fn mono_key(file: List[Str], cal: List[Str], keys: List[Str]) {
    if cal.len < 3 {
        return
    }
    if cal[0] != "TypeArgs" {
        return
    }
    if cal[1].len < 2 {
        return
    }
    if cal[1][0] != "Ident" {
        return
    }
    var nm = cal[1][1]
    var gd = find_decl(file, nm)
    if gd.len == 0 {
        return
    }
    if gd[2].len < 2 {
        return
    }
    var tag = nm
    var ta = cal[2]
    var ti: I32 = 1
    while ti < ta.len {
        tag = tag + "|" + ct_ty_code(ta[ti], file)
        ti += 1
    }
    if !in_list(keys, tag) {
        keys.push(tag)
    }
}

fn mono_e(e: List[Str], file: List[Str], keys: List[Str]) {
    var t = e[0]
    if t == "Call" {
        mono_key(file, e[1], keys)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            mono_e(ag[i], file, keys)
            i += 1
        }
        return
    }
    if or2(t == "Member", t == "TypeArgs") {
        mono_e(e[1], file, keys)
        return
    }
    if t == "Binary" {
        mono_e(e[2], file, keys)
        mono_e(e[3], file, keys)
        return
    }
    if t == "Unary" {
        mono_e(e[2], file, keys)
        return
    }
    if t == "Range" {
        mono_e(e[2], file, keys)
        mono_e(e[3], file, keys)
        return
    }
    if t == "Index" {
        mono_e(e[1], file, keys)
        mono_e(e[2], file, keys)
        return
    }
    if t == "If" {
        mono_e(e[1], file, keys)
        mono_b(e[2], file, keys)
        if e[3][0] != "None" {
            mono_e(e[3], file, keys)
        }
        return
    }
    if t == "Match" {
        mono_e(e[1], file, keys)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            mono_e(arms[i3][2], file, keys)
            if arms[i3].len > 3 {
                mono_e(arms[i3][3], file, keys)
            }
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        mono_e(e[3], file, keys)
        return
    }
}

fn mono_b(b: List[Str], file: List[Str], keys: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            if st[1][0] != "None" {
                mono_e(st[1], file, keys)
            }
        } else if t == "Let" {
            mono_e(st[4], file, keys)
        } else if t == "While" {
            mono_e(st[1], file, keys)
            mono_b(st[2], file, keys)
        } else if t == "For" {
            mono_e(st[2], file, keys)
            mono_b(st[3], file, keys)
        } else if t == "Assign" {
            mono_e(st[3], file, keys)
        } else if t == "Expr" {
            mono_e(st[1], file, keys)
        }
        i += 1
    }
    if b.len > 1 {
        if b[b.len - 1][0] != "None" {
            mono_e(b[b.len - 1], file, keys)
        }
    }
}

// P0-A 预扫:体面 let/var 注解的实例码收集(镜像 mono_b/mono_e 遍历形;
// 补 If 语句/BlockExpr/StructLit/Match 臂体。仅注解位 Named 型入表)
fn ct_let_insts_e(e: List[Str], file: List[Str], out: List[Str]) {
    var t = e[0]
    if t == "Closure" {
        // 体为表达式位(BlockExpr 装块;非块直表达式)
        ct_let_insts_e(e[3], file, out)
        return
    }
    if t == "BlockExpr" {
        ct_let_insts_b(e[1], file, out)
        return
    }
    if t == "Binary" {
        ct_let_insts_e(e[2], file, out)
        ct_let_insts_e(e[3], file, out)
        return
    }
    if t == "Unary" {
        ct_let_insts_e(e[2], file, out)
        return
    }
    if t == "Index" {
        ct_let_insts_e(e[1], file, out)
        ct_let_insts_e(e[2], file, out)
        return
    }
    if t == "Member" {
        ct_let_insts_e(e[1], file, out)
        return
    }
    if t == "Try" {
        ct_let_insts_e(e[1], file, out)
        return
    }
    if t == "Range" {
        ct_let_insts_e(e[2], file, out)
        ct_let_insts_e(e[3], file, out)
        return
    }
    if t == "Call" {
        ct_let_insts_e(e[1], file, out)
        var k: I32 = 1
        while k < e[2].len {
            ct_let_insts_e(e[2][k], file, out)
            k += 1
        }
        return
    }
    if t == "StructLit" {
        var k2: I32 = 1
        while k2 < e[2].len {
            ct_let_insts_e(e[2][k2][2], file, out)
            k2 += 1
        }
        return
    }
    if t == "If" {
        ct_let_insts_e(e[1], file, out)
        // then 臂:语句位为裸 Block(值位 BlockExpr 包装),双形 fallback
        if e[2].len > 1 && e[2][0] == "BlockExpr" {
            ct_let_insts_b(e[2][1], file, out)
        } else {
            ct_let_insts_b(e[2], file, out)
        }
        // else 臂:BlockExpr(p_if 现行形)/ If 链 / 裸 Block fallback(与 then 臂
        // 同防;裸 Block 形若在,注解 let 不再漏预扫——P0-A 复验 Important 项)
        if e[3][0] == "If" {
            ct_let_insts_e(e[3], file, out)
        } else if e[3][0] == "BlockExpr" {
            ct_let_insts_b(e[3][1], file, out)
        } else if e[3].len > 1 && e[3][0] == "Block" {
            ct_let_insts_b(e[3], file, out)
        }
        return
    }
}

fn ct_let_insts_b(b: List[Str], file: List[Str], out: List[Str]) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Let" {
            if st[3][0] == "Named" {
                inst_try_collect(out, ct_ty_code(st[3], file))
            }
            if st[3][0] == "FnType" {
                ct_ty_node_insts(file, st[3], out)
            }
            ct_let_insts_e(st[4], file, out)
        } else if t == "While" {
            ct_let_insts_e(st[1], file, out)
            ct_let_insts_b(st[2], file, out)
        } else if t == "For" {
            ct_let_insts_e(st[2], file, out)
            ct_let_insts_b(st[3], file, out)
        } else if t == "Assign" {
            ct_let_insts_e(st[3], file, out)
        } else if t == "Expr" {
            ct_let_insts_e(st[1], file, out)
        } else if t == "Return" {
            if st[1][0] != "None" {
                ct_let_insts_e(st[1], file, out)
            }
        } else if t == "Match" {
            ct_let_insts_e(st[1], file, out)
            var mi: I32 = 1
            while mi < st[2].len {
                ct_let_insts_e(st[2][mi][2], file, out)
                if st[2][mi].len > 3 {
                    ct_let_insts_e(st[2][mi][3], file, out)
                }
                mi += 1
            }
        } else if t == "If" {
            ct_let_insts_e(st, file, out)
        }
        i += 1
    }
    // 尾表达式位守卫:退化树(如畸形合成签名解析产物)块尾可能是裸串——
    // 无守卫即 items 越界读,emit 面堆损坏延迟引爆(gui_contacts 立案 2026-10-07)
    if b.len > 1 {
        if b[b.len - 1][0] != "None" {
            ct_let_insts_e(b[b.len - 1], file, out)
        }
    }
}

// W4 残余/批C-3 收口:FnType 签名内实例下钻——fn 值形参/返回/let 注解携
// Box[泛型struct]/u: 实例时,原型前置区引用 t_X__Y* 而预扫只认顶层 Named
// → typedef 晚到(spec 点惰性直出)= C 未声明型(探针实证:t_run_script
// 原型先于 CT_TDEF_t_TuiTest__S)。递归钻 FnType 形参/返回;W1 B: 码携全
// 内码,B:u:X__Y 载荷实例同须前置。
fn ct_ty_node_insts(file: List[Str], tn: List[Str], out: List[Str]) {
    if tn[0] == "FnType" {
        var di: I32 = 1
        while di < tn[1].len {
            ct_ty_node_insts(file, tn[1][di], out)
            di += 1
        }
        ct_ty_node_insts(file, tn[2], out)
        return
    }
    var c = ct_ty_code(tn, file)
    inst_try_collect(out, c)
    if c.len > 2 && byte_slice(c, 0, 2) == "B:" {
        inst_try_collect(out, byte_slice(c, 2, c.len))
    }
}
// P0-A 预扫收集:实例码(u:名__尾缀)或 Lu: 装箱槽元素实例 → 入表去重
fn inst_try_collect(out: List[Str], code: Str) {
    // P0-A:&T 形参(p<…> 码)剥壳收集
    if code.len > 1 && byte_at(code, 0) == 112 {
        var inner = byte_slice(code, 1, code.len)
        inst_try_collect(out, inner)
        return
    }
    if code.len > 2 && byte_slice(code, 0, 2) == "u:" {
        if ct_struct_inst_split(code).len > 1 {
            if !in_list(out, code) {
                out.push(code)
            }
        }
    }
    if code.len > 5 && byte_slice(code, 0, 3) == "Lu:" {
        var elc = "u:" + byte_slice(code, 3, code.len)
        if ct_struct_inst_split(elc).len > 1 {
            if !in_list(out, elc) {
                out.push(elc)
            }
        }
    }
}

// P0-A:实例 typedef 依序直出——嵌套字段实例先出(C 依序完整型);
// done 表会话内去重,#ifndef 宏卫兵双保险(与特化点直出共存)
fn ct_inst_td_emit(file: List[Str], ic: Str, done: List[Str]) {
    if in_list(done, ic) {
        return
    }
    done.push(ic)
    var info = ct_struct_inst_split(ic)
    var bar = 0
    var ci: I32 = 0
    while ci < info.len {
        if byte_at(info, ci) == 124 { bar = ci }
        ci += 1
    }
    var snm = byte_slice(info, 0, bar)
    var encs = byte_slice(info, bar + 1, info.len)
    var tn = ct_ctype(ic)
    var ii: I32 = 1
    while ii < file.len {
        var sd = file[ii]
        if sd[0] == "Struct" && sd[1] == snm {
            var fs2 = sd[4]
            // 先嵌套依赖(字段 u:X__ 尾缀递归;Lu:/B: 槽不依实例 typedef)
            var fd0: I32 = 1
            while fd0 < fs2.len {
                var dc0 = ct_field_code_inst(file, fs2[fd0][3], snm, encs)
                if dc0.len > 2 && byte_slice(dc0, 0, 2) == "u:" && ct_struct_inst_split(dc0).len > 1 {
                    ct_inst_td_emit(file, dc0, done)
                }
                fd0 += 1
            }
            println("#ifndef CT_TDEF_" + tn)
            println("#define CT_TDEF_" + tn)
            var line2 = "typedef struct \{ "
            var fj2: I32 = 1
            while fj2 < fs2.len {
                var fd2 = fs2[fj2]
                var dc = ct_field_code_inst(file, fd2[3], snm, encs)
                if dc.len >= 3 && byte_at(dc, 0) == 97 {
                    line2 = line2 + ct_ctype(a_elem(dc)) + " " + fd2[2] + "[" + a_count(dc) + "]; "
                } else {
                    line2 = line2 + ct_ctype(dc) + " " + fd2[2] + "; "
                }
                fj2 += 1
            }
            line2 = line2 + "} " + tn + ";"
            println(line2)
            println("#endif")
        }
        ii += 1
    }
}

