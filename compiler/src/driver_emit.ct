            println("double ctron_fx_mix(double v, int64_t sh) \{ double r = v; while (sh > 0) \{ r = r * 2.0; sh--; } return r; }")
            println("static long ctron_ext_dispatch0(const char* nm, int n, const char** fr) \{")
            println("    void* p; long u[12]; double d[12]; unsigned fm = 0; int i; int k = 0;")
            println("    char rc = 'i'; const char* sym = nm;")
            println("    if (nm[0] == 'R' && nm[1] && nm[2] == ':') \{ rc = nm[1]; sym = nm + 3; }")
            println("    for (i = 0; i < n; i++) \{")
