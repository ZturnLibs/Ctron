            // 形状表按 (返回别, 元数≤4, 浮参 mask) 展开全 case,>4 参浮形状响亮
            // panic 不静默。F32 实参经 ctron_ext_f32slot 位 preserving 放入 double
            // 槽低 32 位(callee 读 s 寄存器=低 32),返回浮值经 fret 文本缓冲
            // ("%.17g" 往返零损)回传解释器。
            // Windows 无 dlfcn:整段桥按 _WIN32 排除,桩保持响亮失败(β 口径)
            println("#if !defined(_WIN32)")
            println("static char ctron_ext_fretbuf[64];")
            println("const char* ctron_ext_fret(void) \{ return ctron_ext_fretbuf; }")
