            println("#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__")
            println("    memcpy(((char*)&dx) + 4, &ctron_f32u, 4);")
            println("#else")
            println("    memcpy(((char*)&dx) + 0, &ctron_f32u, 4);")
            println("#endif")
            println("    return dx; }")
            // T45 解释桥行为锚靶(hermetic:零 libc/libm 依赖,值全二进制精确;
