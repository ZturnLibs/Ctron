// =====================================================================
// driver_emit.ct —— 编译器入口(代码生成模式)
// parse(锚 read_file("ANCHORINPUT"),构建脚本换靶)→ 发射等价 C 到 stdout;
// 产物自带 main(argc,argv):`<bin> run <file>` 可覆盖输入锚(通用二进制)。
// Phase 4:函数体经静态缓冲(CT_OUT/CT_PEND)发射——文件作用域件(spawn shim、
// mcell typedef)先于函数体 flush;并发运行时(ct_scope/ct_task/ct_chan/ct_res)
// 常驻样板;文件级 static let → 零初始化 + ctron_statics_init()(自举闭环)。
// =====================================================================

fn main() -> I32 {
    let src = read_file("ANCHORINPUT")
    match src {
        Some(s) => {
            var toks = List[Str]()
            var lns = List[Str]()
            var cols = List[Str]()
            var pdiags = List[Str]()
            scan4(s, toks, lns, cols, pdiags)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur, lns, cols, pdiags)
            // 模块加载器(§2):use 解析 → 可见性 → 合并;无 use 时为无感直通
            var ldiags = List[Str]()
            var lstack = List[Str]()
            // 发射驱动无 path 回退:ctron_entry 为空时加载器目录退化为 "."(无 use 源无感;
            // 多文件包发射用 bin/ctron-emit,文档化限制)
            var epath = ctron_entry()
            lstack.push(epath)
            // 词法/解析诊断(镜像 seed:PATH:LINE:COL CODE: MSG)→ 止于 rc=1
            if pdiags.len > 0 {
                var dpath = epath
                if seq2(dpath, "") {
                    dpath = "ANCHORINPUT"
                }
                var pi: I32 = 0
                while pi < pdiags.len {
                    println(dpath + ":" + pdiags[pi])
                    pi += 1
                }
                return 1
            }
            file = pkg_load_use(file, pkg_dir_of(epath), lstack, ldiags)
            if ldiags.len > 0 {
                var li: I32 = 0
                while li < ldiags.len {
                    println(ldiags[li])
                    li += 1
                }
                return 1
            }
            // T52 插件沙箱:derive 展开钩子(发射前;产物注入主 file,与 check/run 同口径)
            var pldiags = List[Str]()
            file = plugin_expand(file, pkg_dir_of(epath), pldiags)
            if pldiags.len > 0 {
                var pli: I32 = 0
                while pli < pldiags.len {
                    println(epath + ":" + pldiags[pli])
                    pli += 1
                }
                return 1
            }
            // CLI 化:先取输入 main 的锚字面量(作默认值),再把调用点换为标记
            var anch = ct_find_main_anchor(file)
            file = ct_swap_anchor(file)
            println("#include <stdio.h>")
            println("#include <stdint.h>")
            println("#include <string.h>")
            println("#include <stdlib.h>")
            println("#include <dirent.h>")
            println("#include <pthread.h>")
            println("#include <setjmp.h>")
            println("#include <time.h>")
            println("#if defined(_WIN32)")
            println("#include <windows.h>")
            println("#include <fcntl.h>")
            println("#include <io.h>")
            println("#else")
            println("#include <dlfcn.h>")
            println("#include <errno.h>")
            println("#endif")
            println("#if defined(__APPLE__)")
            println("#include <mach-o/dyld.h>")
            println("#endif")
            println("#if defined(__linux__)")
            println("#include <unistd.h>")
            println("#endif")
            println("static char* ctron_abase = 0;")
            println("static size_t ctron_aoff = 0;")
            println("static size_t ctron_acap = 0;")
            println("static void* ctron_amalloc(size_t n) \{ n = (n + 15) & ~(size_t)15; if (ctron_aoff + n > ctron_acap) \{ size_t nc = ctron_acap ? ctron_acap * 2 : (size_t)4194304; while (nc < ctron_aoff + n) \{ nc = nc * 2; } ctron_abase = (char*)malloc(nc); ctron_aoff = 0; ctron_acap = nc; } void* p = ctron_abase + ctron_aoff; ctron_aoff += n; return p; }")
            // 运行时辅助:容器/单元格/字节域/读文件(必须先于使用它的原型)
            println("typedef struct \{ unsigned long long magic; char** items; int n; int cap; } ctron_list;")
            // T29 M1 GC 前向声明(核心实现在 ct_chans 声明之后;保守根先行,
            // CTRON_GC=1 显式开启,默认 bump;并发程序自动退避——ct_spawn 置 ct_gc_conc)
            println("static void* ct_gc_alloc(size_t n);")
            println("static long long ct_gc_live_bytes(void);")
            println("static long long ct_gc_collect(void);")
            println("static void ct_mcreg_add(void* p, size_t words);")
            println("static int ct_gc_conc = 0;")
            println("typedef struct \{ int32_t v; } ctron_cell;")
                        // T30 into_gc 真深拷(§6.3):静态元素模式分派(0=标量槽/1=Str/2=嵌套表/3=struct 盒)
            println("static ctron_list* ct_ig_l(ctron_list* src, int mode, size_t esz, int imode) \{ if (!src) return 0; ctron_list* d = (ctron_list*)ct_gc_alloc(sizeof(ctron_list)); d->magic = 0x4354726F6E4C7374ULL; d->n = src->n; d->cap = src->n > 0 ? src->n : 0; d->items = 0; if (src->n > 0 && src->items) \{ d->items = (char**)ct_gc_alloc(sizeof(char*) * (size_t)src->n); for (int q = 0; q < src->n; q++) \{ char* v = src->items[q]; char* w = v; if (mode == 0) \{ w = v; } else if (mode == 1) \{ size_t n = v ? strlen(v) + 1 : 1; char* r2 = (char*)ct_gc_alloc(n); if (v) memcpy(r2, v, n); r2[n-1] = 0; w = r2; } else if (mode == 2) \{ w = (char*)ct_ig_l((ctron_list*)v, imode, esz, -1); } else \{ void* b2 = ct_gc_alloc(esz); if (v) memcpy(b2, v, esz); w = (char*)b2; } d->items[q] = w; } } return d; }")
println("static ctron_list* ctron_list_new(void) \{ ctron_list* l = (ctron_list*)ct_gc_alloc(sizeof(ctron_list)); l->magic = 0x4354726F6E4C7374ULL; l->items = 0; l->n = 0; l->cap = 0; return l; }")
            println("static int ctron_len(const void* p) \{ const char* s = (const char*)p; unsigned long long m = 0; if (strlen(s) >= 8) \{ memcpy(&m, s, 8); if (m == 0x4354726F6E4C7374ULL) \{ return ((const ctron_list*)p)->n; } } return (int)strlen(s); }")
            println("static void ctron_list_push(ctron_list* l, const char* s) \{ if (l->n == l->cap) \{ int nc = l->cap ? l->cap * 2 : 8; char** ni = (char**)ct_gc_alloc(sizeof(char*) * (size_t)nc); int q = 0; while (q < l->n) \{ ni[q] = l->items[q]; q += 1; } l->items = ni; l->cap = nc; } l->items[l->n] = (char*)s; l->n += 1; }")
            println("static ctron_cell* ctron_cell_new(int32_t v0) \{ ctron_cell* c = (ctron_cell*)ct_gc_alloc(sizeof(ctron_cell)); c->v = v0; return c; }")
            println("static void ctron_print_i32(int32_t v) \{ printf(\"%d" + bs() + "n\", v); }")
            println("static const char* ctron_str_concat(const char* a, const char* b) \{ size_t la = strlen(a), lb = strlen(b); char* r = (char*)ct_gc_alloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb); r[la + lb] = 0; return r; }")
            println("static const char* ctron_i32_to_string(int32_t v) \{ char* r = (char*)ct_gc_alloc(16); snprintf(r, 16, \"%d\", v); return r; }")
            println("static void ctron_print_i64(int64_t v) \{ printf(\"%lld" + bs() + "n\", (long long)v); }")
            println("static int ctron_byte_at(const char* s, int i) \{ return (int)(unsigned char)s[i]; }")
            println("static const char* ctron_utf8_enc(int cp) \{ static const char* rep = \"\\xEF\\xBF\\xBD\"; unsigned char b[5]; int un = 0; if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) \{ return rep; } if (cp < 0x80) \{ b[un++] = (unsigned char)cp; } else if (cp < 0x800) \{ b[un++] = (unsigned char)(0xC0 | (cp >> 6)); b[un++] = (unsigned char)(0x80 | (cp & 0x3F)); } else if (cp < 0x10000) \{ b[un++] = (unsigned char)(0xE0 | (cp >> 12)); b[un++] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F)); b[un++] = (unsigned char)(0x80 | (cp & 0x3F)); } else \{ b[un++] = (unsigned char)(0xF0 | (cp >> 18)); b[un++] = (unsigned char)(0x80 | ((cp >> 12) & 0x3F)); b[un++] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F)); b[un++] = (unsigned char)(0x80 | (cp & 0x3F)); } b[un] = 0; char* r = (char*)ct_gc_alloc((size_t)un + 1); memcpy(r, b, (size_t)un); r[un] = 0; return r; }")
            println("static void ctron_panic(const char* m);")
            println("static const char* ctron_byte_slice(const char* s, int a, int b) \{ int n = b - a; if (n < 0 || a < 0 || (long)a + (long)n > (long)strlen(s)) \{ ctron_panic(\"byte_slice: range out of bounds\"); } char* r = (char*)ct_gc_alloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }")
            // Str 编组(§9.6 v0.6):C 侧 char* 深拷入 arena(Ctron-owned,免 free;
            // 语言面 str_from_c;解释器口径为恒等——解释域无 C 堆)
            println("static const char* ctron_str_from_c(const char* p) \{ size_t n = strlen(p); char* r = (char*)ct_gc_alloc(n + 1); memcpy(r, p, n + 1); return r; }")
            println("static const char* ctron_read_file(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return \"\"; } fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET); char* r = (char*)ct_gc_alloc((size_t)n + 1); size_t rd = fread(r, 1, (size_t)n, f); r[rd] = 0; fclose(f); return r; }")
            println("static const char* ctron_read_dir(const char* path) \{ DIR* d = opendir(path); if (!d) \{ return NULL; } size_t cap = 256; size_t len = 0; char* r = (char*)malloc(cap); r[0] = 0; struct dirent* de; while ((de = readdir(d)) != NULL) \{ if (strcmp(de->d_name, \".\") == 0 || strcmp(de->d_name, \"..\") == 0) \{ continue; } size_t bl = strlen(de->d_name); while (len + bl + 2 > cap) \{ cap *= 2; } char* nb = (char*)realloc(r, cap); r = nb; memcpy(r + len, de->d_name, bl); len += bl; r[len] = 10; len += 1; } closedir(d); r[len] = 0; return r; }")
            println("static int ctron_fs_exists(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return 0; } fclose(f); return 1; }")
            println("static int ctron_fs_write(const char* path, const char* data) \{ FILE* f = fopen(path, \"wb\"); if (!f) \{ return 0; } size_t n = strlen(data); size_t w = fwrite(data, 1, n, f); fclose(f); return w == n; }")
            println("static int ctron_fs_mkdir(const char* path) \{\n#include <sys/stat.h>\n#include <errno.h>\n char tmp[4096]; size_t len = strlen(path); if (len == 0 || len >= sizeof(tmp)) \{ return 0; } memcpy(tmp, path, len + 1); for (char* p = tmp + 1; *p; p++) \{ if (*p == '/') \{ *p = 0; if (mkdir(tmp, 0755) != 0 && errno != EEXIST) \{ return 0; } *p = '/'; } } if (mkdir(tmp, 0755) != 0 && errno != EEXIST) \{ return 0; } return 1; }")
            println("int32_t ctron_fs_mkdir_p(const char* path) \{ return (int32_t)ctron_fs_mkdir(path); }")
            println("static int ctron_fs_delete(const char* path) \{ return remove(path) == 0; }")
            println("static int64_t ctron_now_ms(void) \{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (long long)ts.tv_sec * 1000LL + ts.tv_nsec / 1000000LL; }")
            println("static const char* ctron_now_ms_text(void) \{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); long long ms = (long long)ts.tv_sec * 1000LL + ts.tv_nsec / 1000000LL; char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%lld\", ms); return r; }")
            println("typedef int64_t ct_i;")
            println("typedef struct \{ int variant; ct_i v; } ct_res;")
            // T25 &Trait 胖指针(§3.5):{data, vtable} 值传递
            println("typedef struct \{ void* data; void* vtable; } ct_obj;")
            println("static void* deref_ptr(void* p) \{ return p; }")
            println("typedef struct ct_scope \{ int cancelled; pthread_mutex_t mu; } ct_scope;")
            println("static ct_scope* ct_scope_new(void) \{ ct_scope* s = (ct_scope*)calloc(1, sizeof(ct_scope)); pthread_mutex_init(&s->mu, 0); return s; }")
            println("static pthread_mutex_t ct_gm = PTHREAD_MUTEX_INITIALIZER;")
            println("static void ct_glock(void) \{ pthread_mutex_lock(&ct_gm); }")
            println("static void ct_gunlock(void) \{ pthread_mutex_unlock(&ct_gm); }")
            println("typedef struct ct_task \{ pthread_t th; void* env; void* (*shim)(void*); ct_i result; int state; char pmsg[128]; ct_scope* scope; jmp_buf jmp; } ct_task;")
            println("static __thread ct_task* ct_tls_task = 0;")
            println("__attribute__((noinline)) static ct_task** ct_tls_slot(void) \{ return &ct_tls_task; }")
            println("typedef struct ct_chan \{ pthread_mutex_t mu; pthread_cond_t cv_full, cv_empty; ct_i* buf; int head, tail, cnt, cap; } ct_chan;")
            println("static ct_chan** ct_chans = 0; static int ct_nchans = 0, ct_chancap = 0; static pthread_mutex_t ct_chreg = PTHREAD_MUTEX_INITIALIZER;")
            // ==== T29 M1 tracing GC(非移动 mark-sweep;设计:2026-09-15-gc-contract-design §6.2 M1)====
            // 根集:机器栈[帧址,main 基]保守扫(S1 档)+chan 环+mcell 注册表+bump 区(闭包
            // env 持指针)+GC 堆载荷传播;精确帧链根集=M1.5(T31 重开,S2)。
            // S1 硬化:超块尺寸类+内部指针块起点归约+worklist 迭代标记(路径② SIGSEGV 两机制销账)。
            // 对象=超级块内定步距刻切,头 {sz,mk};mk:0 空/1 活未色/2 已标;空块首载荷字=空闲链。
            // 并发退避:ct_spawn/ct_ch_reg 置 ct_gc_conc → 分配回落 bump(任务栈不扫,UAF 防线)。
            println("static char* ct_gc_stack_base = 0;")
            println("static int ct_gc_on = -1;")
            println("static size_t ct_gc_since = 0, ct_gc_thresh = 8u*1024u*1024u, ct_gc_livesz = 0;")
            // S1(T31 重开,2026-10-02):标记器硬化+迭代化。①超块单尺寸类(bsz,块步距恒
            // 16+bsz)——内部指针 O(1) 归约块起点再读头,灭路径②「载荷当头读」野扫 SIGSEGV;
            // 头双门(h[1]==1 且 0<h[0]≤bsz)。②显式 worklist 替代 mkword/mkrange 互递归
            // (递归深度=对象图深度,深链/C 栈爆实证)。③新超块 calloc 清零——未刻切块头
            // 读 0=天然拒标,垃圾头不可能。根集不变(保守栈+chan+mcell+bump 区)。
            println("typedef struct ct_sb \{ struct ct_sb* nx; char* cur; char* end; void* fl; size_t cap; size_t live; size_t bsz; } ct_sb;")
            println("static ct_sb* ct_gc_sbs = 0;")
            println("static char** ct_gc_wl = 0;")
            println("static size_t ct_gc_wln = 0, ct_gc_wlc = 0;")
            println("static void ctron_panic(const char* m);")
            println("static void ct_gc_wlput(char* lo, char* hi) \{ if (ct_gc_wln + 2 > ct_gc_wlc) \{ size_t nc = ct_gc_wlc ? ct_gc_wlc * 2 : 4096; char** nw = (char**)realloc(ct_gc_wl, nc * sizeof(char*)); if (!nw) \{ ctron_panic(\"gc: worklist OOM(realloc败=标记候选丢失=静默UAF,响亮退出)\"); } ct_gc_wl = nw; ct_gc_wlc = nc; } ct_gc_wl[ct_gc_wln++] = lo; ct_gc_wl[ct_gc_wln++] = hi; }")
            // S2(T31 重开 M1.5):精确帧链根集(契约 §6.3;编码=槽注册制——发射器不知 C 帧
            // 偏移,槽节点持 &局部 强制落内存+每 fn 帧节点 cleanup 尾声统一)。kind 0=词槽
            // 直标/1=值结构体(u:/R/E:)域扫。__thread=多线程推拉隔离(pmap 8 线程);收集
            // 仅主线程,任务线程分配已退避 bump。主栈保守扫降级 CTRON_GC_CONSERV 逃逸档。
            println("typedef struct ct_frs \{ void** addr; int kind; size_t sz; } ct_frs;")
            println("typedef struct ct_fr \{ struct ct_fr* up; ct_frs pool[32]; int pn; int ovf; int sv[8]; int spn; } ct_fr;")
            println("static __thread ct_fr* ct_fp = 0;")
            println("static void ct_fp_pop(void* p) \{ ct_fp = ((ct_fr*)p)->up; }")
            println("static int ct_gc_conserv = 0;")
            println("static int ct_gc_arena_scan = 1;")
            println("static int ct_gc_ovf = 0;")
            println("typedef struct ct_mce \{ void* p; size_t words; struct ct_mce* nx; } ct_mce;")
            println("static ct_mce* ct_mcreg_h = 0;")
            println("static void ct_mcreg_add(void* p, size_t words) \{ ct_mce* e = (ct_mce*)malloc(sizeof(ct_mce)); if (!e) return; e->p = p; e->words = words; e->nx = ct_mcreg_h; ct_mcreg_h = e; }")
            println("static int ct_gc_enabled(void) \{ if (ct_gc_on < 0) \{ const char* g = getenv(\"CTRON_GC\"); ct_gc_on = (g && (!strcmp(g, \"1\") || !strcmp(g, \"on\"))) ? 1 : 0; const char* th = getenv(\"CTRON_GC_THRESHOLD\"); if (th && *th) \{ long v = atol(th); if (v > 0) ct_gc_thresh = (size_t)v; } const char* cv = getenv(\"CTRON_GC_CONSERV\"); ct_gc_conserv = 1; if (cv && (*cv == '0' || *cv == 'f')) \{ ct_gc_conserv = 0; } const char* av = getenv(\"CTRON_GC_ARENASCAN\"); ct_gc_arena_scan = 1; if (av && (*av == '0' || *av == 'f')) \{ ct_gc_arena_scan = 0; } } return ct_gc_on; }")
            println("static void ct_gc_mkword(void* w) \{ ct_sb* s = 0; for (ct_sb* q = ct_gc_sbs; q; q = q->nx) \{ char* b = (char*)(q + 1); if ((char*)w >= b && (char*)w < q->end) \{ s = q; break; } } if (!s) \{ return; } size_t st = 16 + s->bsz; size_t off = (size_t)((char*)w - (char*)(s + 1)); size_t* hdr = (size_t*)((char*)(s + 1) + (off / st) * st); if (hdr[1] != 1) \{ return; } if (hdr[0] == 0 || hdr[0] > s->bsz) \{ return; } hdr[1] = 2; ct_gc_livesz += hdr[0]; ct_gc_wlput((char*)(hdr + 2), (char*)(hdr + 2) + hdr[0]); if (hdr[0] >= 24) \{ unsigned long long mg; memcpy(&mg, hdr + 2, 8); if (mg == 0x4354726F6E4C7374ULL) \{ char** it = *(char***)((char*)(hdr + 2) + 8); int nn = *(int*)((char*)(hdr + 2) + 16); if (it && nn > 0) \{ ct_gc_wlput((char*)it, (char*)it + (size_t)nn * sizeof(char*)); } } } }")
            println("static void* ct_gc_alloc(size_t n) \{ if (ct_gc_conc || !ct_gc_enabled()) \{ return ctron_amalloc(n); } if (ct_gc_since > ct_gc_thresh && ct_gc_since > ct_gc_livesz) \{ ct_gc_collect(); } /* S4④:堆自适应——churn 超过活集才收集,摊销全堆标记 <=2x;8MB 底线保小堆响应 */ size_t sz = (n + 15) & ~(size_t)15; ct_sb* best = 0; for (ct_sb* s = ct_gc_sbs; s; s = s->nx) \{ if (s->bsz >= sz && s->fl) \{ if (!best || s->bsz < best->bsz) \{ best = s; } } } if (best) \{ size_t* h = (size_t*)best->fl; best->fl = (void*)h[2]; h[0] = sz; h[1] = 1; best->live += 1; ct_gc_since += sz; return (void*)(h + 2); } ct_sb* carve = 0; for (ct_sb* s = ct_gc_sbs; s; s = s->nx) \{ if (s->bsz >= sz && s->cur + 16 + s->bsz <= s->end) \{ if (!carve || s->bsz < carve->bsz) \{ carve = s; } } } size_t bsz = 32; while (bsz < sz) \{ bsz *= 2; } if (!carve) \{ size_t st = 16 + bsz; size_t cap = 1024u * 1024u; if (cap < st) \{ cap = st; } cap = (cap / st) * st; ct_sb* s = (ct_sb*)calloc(1, sizeof(ct_sb) + cap); if (!s) \{ return ct_gc_alloc(n); } s->nx = ct_gc_sbs; ct_gc_sbs = s; s->cap = cap; s->fl = 0; s->live = 0; s->bsz = bsz; s->cur = (char*)(s + 1); s->end = s->cur + cap; carve = s; } size_t st = 16 + carve->bsz; size_t* h = (size_t*)carve->cur; h[0] = sz; h[1] = 1; h[2] = 0; carve->cur = carve->cur + st; carve->live += 1; ct_gc_since += sz; return (void*)(h + 2); }")
            println("static long long ct_gc_collect(void) \{ if (!ct_gc_enabled()) return -1; __asm__ volatile(\"\" : : : \"memory\"); ct_gc_livesz = 0; ct_gc_wln = 0; ct_gc_ovf = 0; for (ct_fr* f = ct_fp; f; f = f->up) \{ if (f->ovf) \{ ct_gc_ovf = 1; } for (int pi3 = 0; pi3 < f->pn; pi3++) \{ ct_frs* s = &f->pool[pi3]; if (s->kind == 0) \{ ct_gc_mkword(*(void**)s->addr); } else \{ ct_gc_wlput((char*)s->addr, (char*)s->addr + s->sz); } } } char* fa = (char*)__builtin_frame_address(0); if ((ct_gc_conserv || ct_gc_ovf) && ct_gc_stack_base && fa < ct_gc_stack_base) ct_gc_wlput(fa, ct_gc_stack_base); for (int i = 0; i < ct_nchans; i++) \{ if (ct_chans[i] && ct_chans[i]->buf && ct_chans[i]->cap > 0) \{ ct_gc_wlput((char*)ct_chans[i]->buf, (char*)ct_chans[i]->buf + (size_t)ct_chans[i]->cap * sizeof(ct_i)); } } for (ct_mce* e = ct_mcreg_h; e; e = e->nx) \{ ct_gc_wlput((char*)e->p, (char*)e->p + e->words * sizeof(void*)); } if (ctron_abase && ct_gc_arena_scan) \{ ct_gc_wlput(ctron_abase, ctron_abase + ctron_aoff); } while (ct_gc_wln > 0) \{ char* hi2 = ct_gc_wl[--ct_gc_wln]; char* lo2 = ct_gc_wl[--ct_gc_wln]; for (char* w2 = lo2; w2 + sizeof(void*) <= hi2; w2 += sizeof(void*)) \{ void* c2; memcpy(&c2, w2, sizeof(void*)); ct_gc_mkword(c2); } } for (ct_sb* s = ct_gc_sbs; s; s = s->nx) \{ char* b2 = (char*)(s + 1); size_t st2 = 16 + s->bsz; size_t nb2 = (size_t)(s->cur - b2) / st2; for (size_t i2 = 0; i2 < nb2; i2++) \{ size_t* h = (size_t*)(b2 + i2 * st2); if (h[1] == 2) \{ h[1] = 1; } else if (h[1] == 1) \{ h[1] = 0; s->live -= 1; *(void**)(h + 2) = s->fl; s->fl = (void*)h; } } } ct_gc_since = 0; ct_sb** pp = &ct_gc_sbs; while (*pp) \{ ct_sb* s = *pp; if (s->live == 0) \{ *pp = s->nx; free(s); } else \{ pp = &s->nx; } } return (long long)ct_gc_livesz; }")
            println("static long long ct_gc_live_bytes(void) \{ return ct_gc_enabled() ? (long long)ct_gc_livesz : -1LL; }")
            println("static void ct_ch_reg(ct_chan* c) \{ pthread_mutex_lock(&ct_chreg); if (ct_nchans == ct_chancap) \{ int nc = ct_chancap ? ct_chancap * 2 : 16; ct_chan** na = (ct_chan**)realloc(ct_chans, (size_t)nc * sizeof(ct_chan*)); if (na) \{ ct_chans = na; ct_chancap = nc; } } if (ct_nchans < ct_chancap) \{ ct_chans[ct_nchans] = c; ct_nchans += 1; } pthread_mutex_unlock(&ct_chreg); }")
            // P2-D 并发模板模式分支:rt 七符号以"弱定义哑元"垫底(机制同 ctron_net.c——
            // Mach-O 无 undefined-weak→NULL 链接语义,weak extern 声明链接期报 undefined,
            // Task 3 实证;弱定义哑元 + ctron_rt.c 强定义链接期整体顶替,ELF/Mach-O 双侧
            // 标准语义,无同 TU 常量折叠)。未链 rt ⇒ 哑元 active 恒 0 ⇒ 七触点全走
            // P1 pthread 原路径(默认分支逐字保留);链入 rt 且 CTRON_RT=coro ⇒ 协程改道。
            // 哑元无条件发射(评审 Important 修):_WIN32 也裁不得——触点对 rt 符号的
            // 引用仅运行期守卫(ct_rt_active/coro_ctx 恒 0,调用面永不执行),符号引用
            // 本身存活;任何 #if 裁切都留 mingw 链接 undefined(init/cancel_wake_all/
            // notify_done/join_key/run/park 共九处)。PE/COFF 弱定义 mingw gcc 受支持;
            // rt 为 POSIX-only 永不在 _WIN32 链入,哑元即终解。
            println("__attribute__((weak)) int ctron_rt_active(void) \{ return 0; }")
            println("__attribute__((weak)) void ctron_rt_init(int workers) \{ (void)workers; }")
            println("__attribute__((weak)) void* ctron_rt_run(void (*fn)(void*), void* arg, void* key) \{ (void)fn; (void)arg; (void)key; return 0; }")
            println("__attribute__((weak)) void ctron_rt_join_key(void* key) \{ (void)key; }")
            println("__attribute__((weak)) void ctron_rt_park(void) \{ }")
            println("__attribute__((weak)) void ctron_rt_wake(void* key) \{ (void)key; }")
            println("__attribute__((weak)) void ctron_rt_notify_done(void* key) \{ (void)key; }")
            println("__attribute__((weak)) void ctron_rt_cancel_wake_all(void) \{ }")
            println("__attribute__((weak)) void* ctron_rt_current(void) \{ return 0; }")
            // P9 栈面全量(A′ 分段+钉住+再入续跑):序言检查强钩子哑元——
            // ctron_rt.c 强定义链接期顶替(P2-D 同款);检查仅 CTRON_MORESTACK
            // 发射期注入,哑元态(未链 rt)恒 0/不可达。size_t 对齐 rt 侧签名。
            // 哑元同挂发射期门:默认发射逐字节与旧形一致(黄金站岗)。
            if !seq2(env_get("CTRON_MORESTACK"), "") && !seq2(env_get("CTRON_MORESTACK"), "0") {
                println("__attribute__((weak)) int ctron_rt_stk_low(size_t need) \{ (void)need; return 0; }")
                println("__attribute__((weak)) void ctron_rt_stk_grow(void (*fn)(void*, void*), void* a, void* r) \{ (void)fn; (void)a; (void)r; }")
            }
            // 判据冻结口径:ct_rt_active = 真 rt 已链且 CTRON_RT=coro;ct_rt_coro_ctx =
            // 再加 current() 非空(协程上下文)——口径同 ctron_net.c ct_rt_parkable,
            // 因 park 对裸线程是契约外 no-op,裸线程调用面(如 main)保持 pthread 原语。
            println("static int ct_rt_active(void) \{")
            println("#if !defined(_WIN32)")
            println("    return ctron_rt_active();")
            println("#else")
            println("    return 0;")
            println("#endif")
            println("}")
            println("static int ct_rt_coro_ctx(void) \{")
            println("#if !defined(_WIN32)")
            println("    return ctron_rt_active() && ctron_rt_current() != 0;")
            println("#else")
            println("    return 0;")
            println("#endif")
            println("}")
            // 首个 spawn 的惰性 init:active() 要求真 rt 已 init(getenv==coro 且 g_inited),
            // 而 rt_run 的惰性 init 在 active() 门后 —— 模板侧按冻结口径(getenv
            // CTRON_RT=="coro")自探,仅协程环境才 init(默认环境不建 worker 线程)。
            println("static int ct_rt_env_coro(void) \{ const char* e = getenv(\"CTRON_RT\"); return e != 0 && strcmp(e, \"coro\") == 0; }")
            // 任务自取:协程模式以 rt current()(= spawn 时挂的 key=ct_task*)为准,
            // 对 N:M 迁移免疫;裸线程回退 __thread 槽(P1 口径,主线程恒 0)。
            // 全部 TLS 直访经 noinline 槽访问器(ctron_rt.c:301 同款已登记约束:
            // darwin/arm64 把 TLV 槽地址缓存在 callee-saved 寄存器,跨 park 迁移后
            // rt_swap 恢复旧镜像 ⇒ 直访串块——实证 shim 结果写 NULL->result 段错误)。
            println("static ct_task* ct_task_self(void) \{")
            println("#if !defined(_WIN32)")
            println("    if (ctron_rt_active()) \{ void* _k = ctron_rt_current(); if (_k) \{ return (ct_task*)_k; } }")
            println("#endif")
            println("    return *ct_tls_slot();")
            println("}")
            println("static void ct_cancel_broadcast(void) \{ int i; for (i = 0; i < ct_nchans; i++) \{ pthread_mutex_lock(&ct_chans[i]->mu); pthread_cond_broadcast(&ct_chans[i]->cv_full); pthread_cond_broadcast(&ct_chans[i]->cv_empty); pthread_mutex_unlock(&ct_chans[i]->mu); } if (ct_rt_active()) ctron_rt_cancel_wake_all(); }")
            // Drop 运行时栈(P1-A2,§6.4 panic 展开):指针条目 + 每类型 thunk;
            // ctron_panic 先取所有权逆序展开再 longjmp/exit(弹后再调,嵌套 panic 有界)
            println("typedef struct \{ void (*fn)(void*); void* obj; } ct_drent;")
            println("static ct_drent ct_drstack[2048];")
            println("static int ct_drn = 0;")
            println("static void ctron_drop_push(void (*fn)(void*), void* obj) \{ if (ct_drn < 2048) \{ ct_drstack[ct_drn].fn = fn; ct_drstack[ct_drn].obj = obj; ct_drn += 1; } }")
            println("static void ctron_drop_pop(void) \{ if (ct_drn > 0) \{ ct_drn -= 1; } }")
            println("static void ctron_drop_unwind(void) \{ while (ct_drn > 0) \{ ct_drn -= 1; ct_drstack[ct_drn].fn(ct_drstack[ct_drn].obj); } }")
            println("static int ctron_cb_depth = 0;")
            println("static void ctron_panic(const char* m) \{ fflush(stdout); fprintf(stderr, \"%s\\n\", m); ctron_drop_unwind(); if (ctron_cb_depth > 0) \{ exit(1); } ct_task* _tp = ct_task_self(); if (_tp) \{ snprintf(_tp->pmsg, 128, \"%s\", m); _tp->state = 2; if (_tp->scope) \{ _tp->scope->cancelled = 1; } ct_cancel_broadcast(); longjmp(_tp->jmp, 1); } exit(1); }")
            println("static int64_t ctron_i64_add(int64_t a, int64_t b) \{ int64_t r; if (__builtin_add_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (+)\"); } return r; }")
            println("static int64_t ctron_i64_sub(int64_t a, int64_t b) \{ int64_t r; if (__builtin_sub_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            println("static int64_t ctron_i64_mul(int64_t a, int64_t b) \{ int64_t r; if (__builtin_mul_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (*)\"); } return r; }")
            println("static int64_t ctron_i64_div(int64_t a, int64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } if (b == -1 && a == (-9223372036854775807LL - 1)) \{ ctron_panic(\"integer overflow (/)\"); } return a / b; }")
            println("static int64_t ctron_i64_mod(int64_t a, int64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } if (b == -1 && a == (-9223372036854775807LL - 1)) \{ ctron_panic(\"integer overflow (%)\"); } return a % b; }")
            println("static int64_t ctron_i64_neg(int64_t a) \{ int64_t r; if (__builtin_sub_overflow(0, a, &r)) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            // U64/USize 定宽槽检查帮手(P1-B):uint64_t,panic 消息镜像宿主
            // W 域定宽检查帮手(P1-B2):int32 中间量 + 宽度界门,panic 镜像 w_arith
            println("static int32_t ctron_w_add(int32_t a, int32_t b, int32_t lo, int32_t hi) \{ int32_t r = a + b; if (r < lo || r > hi) \{ ctron_panic(\"integer overflow (+)\"); } return r; }")
            println("static int32_t ctron_w_sub(int32_t a, int32_t b, int32_t lo, int32_t hi) \{ int32_t r = a - b; if (r < lo || r > hi) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            println("static int32_t ctron_w_mul(int32_t a, int32_t b, int32_t lo, int32_t hi) \{ int32_t r = a * b; if (r < lo || r > hi) \{ ctron_panic(\"integer overflow (*)\"); } return r; }")
            println("static int32_t ctron_w_div(int32_t a, int32_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a / b; }")
            println("static int32_t ctron_w_mod(int32_t a, int32_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a % b; }")
            println("static uint64_t ctron_u64_add(uint64_t a, uint64_t b) \{ uint64_t r; if (__builtin_add_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (+)\"); } return r; }")
            println("static uint64_t ctron_u64_sub(uint64_t a, uint64_t b) \{ uint64_t r; if (__builtin_sub_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            println("static uint64_t ctron_u64_mul(uint64_t a, uint64_t b) \{ uint64_t r; if (__builtin_mul_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (*)\"); } return r; }")
            println("static uint64_t ctron_u64_div(uint64_t a, uint64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a / b; }")
            println("static uint64_t ctron_u64_mod(uint64_t a, uint64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a % b; }")
            println("static const char* ctron_i64_to_string(int64_t v) \{ char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%lld\", (long long)v); return r; }")
            // Phase 4 并发运行时(函数部):任务 trampoline/spawn/join/Channel/parallel
            println("static void* ct_shim_tramp(void* p) \{ ct_task* t = (ct_task*)p; *ct_tls_slot() = t; if (setjmp(t->jmp) == 0) \{ t->shim(t->env); t->state = 1; } ct_fp = 0; if (ct_rt_active()) ctron_rt_notify_done((void*)t); return 0; }")
            println("static ct_task* ct_spawn(void* (*shim)(void*), void* env, ct_scope* sc) \{ ct_gc_conc = 1; ct_task* t = (ct_task*)calloc(1, sizeof(ct_task)); t->shim = shim; t->env = env; t->scope = sc; if (!ct_rt_active() && ct_rt_env_coro()) ctron_rt_init(0); if (ct_rt_active()) \{ ctron_rt_run((void (*)(void*))ct_shim_tramp, t, (void*)t); return t; } pthread_create(&t->th, 0, ct_shim_tramp, t); return t; }")
            println("static ct_i ct_join(ct_task* t) \{ void* r; if (ct_rt_active()) \{ ctron_rt_join_key((void*)t); } else \{ pthread_join(t->th, &r); } if (t->state == 2) \{ ctron_panic(t->pmsg); } return t->result; }")
            println("static ct_res ct_join_or(ct_task* t) \{ void* r; if (ct_rt_active()) \{ ctron_rt_join_key((void*)t); } else \{ pthread_join(t->th, &r); } ct_res res; if (t->state == 2) \{ res.variant = 1; res.v = (ct_i)(long)\"task panic\"; } else \{ res.variant = 0; res.v = t->result; } return res; }")
            println("static ct_chan* ct_ch_make(int cap) \{ if (cap < 1) \{ cap = 1; } ct_chan* c = (ct_chan*)calloc(1, sizeof(ct_chan)); pthread_mutex_init(&c->mu, 0); pthread_cond_init(&c->cv_full, 0); pthread_cond_init(&c->cv_empty, 0); c->cap = cap; c->buf = (ct_i*)calloc((size_t)cap, sizeof(ct_i)); ct_ch_reg(c); return c; }")
            println("static ct_res ct_ch_send(ct_chan* c, ct_i v) \{ ct_res res; pthread_mutex_lock(&c->mu); while (c->cnt == c->cap) \{ ct_task* _ct = ct_task_self(); ct_scope* sc = _ct ? _ct->scope : 0; if (sc && sc->cancelled) \{ pthread_mutex_unlock(&c->mu); res.variant = 1; res.v = (ct_i)(long)\"ScopeCancelled\"; return res; } if (ct_rt_coro_ctx()) \{ pthread_mutex_unlock(&c->mu); ctron_rt_park(); pthread_mutex_lock(&c->mu); continue; } pthread_cond_wait(&c->cv_full, &c->mu); } c->buf[c->tail] = v; c->tail = (c->tail + 1) % c->cap; c->cnt += 1; pthread_cond_broadcast(&c->cv_empty); pthread_mutex_unlock(&c->mu); if (ct_rt_active()) ctron_rt_cancel_wake_all(); res.variant = 0; res.v = 0; return res; }")
            println("static ct_res ct_ch_recv(ct_chan* c) \{ ct_res res; pthread_mutex_lock(&c->mu); while (c->cnt == 0) \{ ct_task* _ct = ct_task_self(); ct_scope* sc = _ct ? _ct->scope : 0; if (sc && sc->cancelled) \{ pthread_mutex_unlock(&c->mu); res.variant = 1; res.v = (ct_i)(long)\"ScopeCancelled\"; return res; } if (ct_rt_coro_ctx()) \{ pthread_mutex_unlock(&c->mu); ctron_rt_park(); pthread_mutex_lock(&c->mu); continue; } pthread_cond_wait(&c->cv_empty, &c->mu); } res.variant = 0; res.v = c->buf[c->head]; c->head = (c->head + 1) % c->cap; c->cnt -= 1; pthread_cond_broadcast(&c->cv_full); pthread_mutex_unlock(&c->mu); if (ct_rt_active()) ctron_rt_cancel_wake_all(); return res; }")
            println("static inline int32_t ct_bit_shl_i32(int32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return (int32_t)(((uint32_t)a) << n); }")
            println("static inline uint32_t ct_bit_shl_u32(uint32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return (uint32_t)(((uint32_t)a) << n); }")
            println("static inline int64_t ct_bit_shl_i64(int64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return (int64_t)(((uint64_t)a) << n); }")
            println("static inline uint64_t ct_bit_shl_u64(uint64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return (uint64_t)(((uint64_t)a) << n); }")
            println("static inline int32_t ct_bit_shr_i32(int32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return a >> n; }")
            println("static inline uint32_t ct_bit_shr_u32(uint32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return (uint32_t)(((uint32_t)a) >> n); }")
            println("static inline int64_t ct_bit_shr_i64(int64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return a >> n; }")
            println("static inline uint64_t ct_bit_shr_u64(uint64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return (uint64_t)(((uint64_t)a) >> n); }")
            println("typedef ct_i (*ct_fn0)(void);")
            println("typedef ct_i (*ct_fn1)(ct_i);")
            println("typedef ct_i (*ct_fn2)(ct_i, ct_i);")
            println("typedef ct_i (*ct_fn3)(ct_i, ct_i, ct_i);")
            println("typedef struct \{ void* fn; void* env; } ct_clo;")
            println("typedef ct_clo* ct_clop;")
            println("typedef ct_i (*ct_cfn0)(void*);")
            println("typedef ct_i (*ct_cfn1)(void*, ct_i);")
            println("typedef ct_i (*ct_cfn2)(void*, ct_i, ct_i);")
            println("typedef ct_i (*ct_cfn3)(void*, ct_i, ct_i, ct_i);")
            // context-pointer 闭包糖(§9.6 v0.8):C 签名(业务参..., void* ctx)——
            // ctx = clo_handle 闭包箱句柄;蹦床经箱内 shim(env-first)路由回闭包
            println("static ct_i ctron_clo_tramp2(ct_i _e, void* _u) \{ ct_clop _b = (ct_clop)_u; return ((ct_cfn1)(_b->fn))(_b->env, _e); }")
            println("static ct_i ctron_clo_tramp3(ct_i _e, ct_i _x, void* _u) \{ ct_clop _b = (ct_clop)_u; return ((ct_cfn2)(_b->fn))(_b->env, _e, _x); }")
