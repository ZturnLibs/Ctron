// =====================================================================
// driver_emit.ct —— 编译器入口(代码生成模式)
// parse(锚 read_file("ANCHORINPUT"),构建脚本换靶)→ 发射等价 C 到 stdout;
// 产物自带 main(argc,argv):`<bin> run <file>` 可覆盖输入锚(通用二进制)。
// Phase 4:函数体经静态缓冲(CT_OUT/CT_PEND)发射——文件作用域件(spawn shim、
// mcell typedef)先于函数体 flush;并发运行时(ct_scope/ct_task/ct_chan/ct_res)
// 常驻样板;文件级 static let → 零初始化 + ctron_statics_init()(自举闭环)。
// =====================================================================

fn main() -> I32 {
    let src = read_file("ANCHORINPUT")
    match src {
        Some(s) => {
            var pdiags = List[Str]()
            // W5b:CTRON_AST_IN 命中直载(壳层副签已校验;坏前缀回退全 parse);
            // CTRON_AST_FILL 非空 = miss 回填(parse 干净才写,E-AST fail-closed)
            var cachin = env_get("CTRON_AST_IN")
            var file = List[Str]()
            var cached = false
            if cachin.len > 0 {
                file = ast_cache_load(cachin)
                if file.len > 1 {
                    cached = true
                }
            }
            if !cached {
                var toks = List[Str]()
                var lns = List[Str]()
                var cols = List[Str]()
                scan4(s, toks, lns, cols, pdiags)
                var cur = Atomic[I32](0)
                file = p_file(toks, cur, lns, cols, pdiags)
                var cfill = env_get("CTRON_AST_FILL")
                if cfill.len > 0 {
                    if pdiags.len == 0 {
                        var ser = ast_ser_file(file)
                        if ser.len > 0 {
                            fs_write(cfill, ser)
                        }
                    }
                }
            }
            // 模块加载器(§2):use 解析 → 可见性 → 合并;无 use 时为无感直通
            var ldiags = List[Str]()
            var lstack = List[Str]()
            // 发射驱动无 path 回退:ctron_entry 为空时加载器目录退化为 "."(无 use 源无感;
            // 多文件包发射用 bin/ctron-emit,文档化限制)
            var epath = ctron_entry()
            lstack.push(epath)
            // 词法/解析诊断(镜像 seed:PATH:LINE:COL CODE: MSG)→ 止于 rc=1
            if pdiags.len > 0 {
                var dpath = epath
                if seq2(dpath, "") {
                    dpath = "ANCHORINPUT"
                }
                var pi: I32 = 0
                while pi < pdiags.len {
                    println(dpath + ":" + pdiags[pi])
                    pi += 1
                }
                return 1
            }
            var lmisses = List[Str]()
            file = pkg_load_use_m(file, pkg_dir_of(epath), lstack, ldiags, lmisses)
            if ldiags.len > 0 {
                var li: I32 = 0
                while li < ldiags.len {
                    eprint(ldiags[li])
                    li += 1
                }
                return 1
            }
            // S4-⑤:emit 面解析链未命中 = fail-closed(此前静默保留 Use 产出
            // 必然失败的 C 且 rc=0;调查 2026-10-07 定罪,COVERAGE 在册)。
            // 诊断走 eprint:emit 的 stdout = 产物 C 载体,println 诊断会污染产物
            if lmisses.len > 0 {
                var mi2: I32 = 0
                while mi2 < lmisses.len {
                    eprint("E2020: use 导入未命中解析链:" + lmisses[mi2] + "(W8902 出路:独立发布包试: ctron pkg add " + lmisses[mi2] + ";std 包查 CTRON_STDPATH)")
                    mi2 += 1
                }
                return 1
            }
            // T52 插件沙箱:derive 展开钩子(发射前;产物注入主 file,与 check/run 同口径)
            var pldiags = List[Str]()
            file = plugin_expand(file, pkg_dir_of(epath), pldiags)
            if pldiags.len > 0 {
                var pli: I32 = 0
                while pli < pldiags.len {
                    println(epath + ":" + pldiags[pli])
                    pli += 1
                }
                return 1
            }
            // CLI 化:先取输入 main 的锚字面量(作默认值),再把调用点换为标记
            var anch = ct_find_main_anchor(file)
            file = ct_swap_anchor(file)
            println("#include <stdio.h>")
            println("#include <stdint.h>")
            println("#include <string.h>")
            println("#include <stdlib.h>")
            println("#include <stdint.h>")
            println("#include <dirent.h>")
            println("#include <pthread.h>")
            println("#include <setjmp.h>")
            println("#include <time.h>")
            println("#if defined(_WIN32)")
            println("#include <windows.h>")
            println("#include <fcntl.h>")
            println("#include <io.h>")
            println("#include <direct.h>")
            println("static int ctron_w_setenv(const char* k9, const char* v9) \{ int n9 = strlen(k9) + strlen(v9) + 2; char* b9 = (char*)malloc((size_t)n9); if (!b9) \{ return -1; } snprintf(b9, (size_t)n9, \"%s=%s\", k9, v9); int r9 = _putenv(b9); free(b9); return r9; }")
            println("#define setenv(k, v, o) ctron_w_setenv(k, v)")
            println("#define mkdir(p, m) _mkdir(p)")            // G7-W1:dlopen 桥 Windows 垫片(宏重定向四名;POSIX 臂零语义变化)
            println("#define RTLD_NOW 0")
            println("#define RTLD_GLOBAL 0")
            println("#define RTLD_DEFAULT ((void*)0)")
            println("static void* ctron_w_dlopen(const char* p7, int m7) \{ int w7 = MultiByteToWideChar(CP_UTF8, 0, p7, -1, 0, 0); wchar_t* q7 = 0; if (w7 > 0) \{ q7 = (wchar_t*)malloc(sizeof(wchar_t) * (size_t)w7); MultiByteToWideChar(CP_UTF8, 0, p7, -1, q7, w7); } (void)m7; void* r7 = q7 ? (void*)LoadLibraryW(q7) : (void*)0; free(q7); return r7; }")
            println("static void* ctron_w_dlsym(void* h7, const char* s7) \{ if (!h7) \{ h7 = (void*)GetModuleHandleW(0); } return (void*)GetProcAddress((HMODULE)h7, s7); }")
            println("static int ctron_w_dlclose(void* h7) \{ return FreeLibrary((HMODULE)h7) ? 0 : -1; }")
            println("static char ctron_w_dlebuf[256];")
            println("static const char* ctron_w_dlerror(void) \{ DWORD e7 = GetLastError(); if (!e7) \{ return 0; } SetLastError(0); wchar_t v7[128]; DWORD n7 = FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, 0, e7, 0, v7, 128, 0); if (!n7) \{ return 0; } int r7 = WideCharToMultiByte(CP_UTF8, 0, v7, (int)n7, ctron_w_dlebuf, 255, 0, 0); if (r7 <= 0) \{ return 0; } ctron_w_dlebuf[r7] = 0; while (r7 > 0 && (ctron_w_dlebuf[r7-1] == 10 || ctron_w_dlebuf[r7-1] == 13 || ctron_w_dlebuf[r7-1] == 32)) \{ ctron_w_dlebuf[--r7] = 0; } return ctron_w_dlebuf; }")
            println("#define dlopen ctron_w_dlopen")
            println("#define dlsym ctron_w_dlsym")
            println("#define dlclose ctron_w_dlclose")
            println("#define dlerror ctron_w_dlerror")
            println("#else")
            println("#include <dlfcn.h>")
            println("#include <errno.h>")
            println("#endif")
            println("#if defined(__APPLE__)")
            println("#include <mach-o/dyld.h>")
            println("#endif")
            println("#if defined(__linux__)")
            println("#include <unistd.h>")
            println("#endif")
            println("static int ctron_alock = 0;")
            // G1(秘本 P0-2):arena 段化——块链 + 每竞技场状态(ct_arn)+ 线程选择。
            // 全局竞技场 ctron_aglobal 保留自旋锁(T46:pthread 双线程并发 bump 互踩
            // 防线,锁面只此一处);任务线程 TLS 指向私有段(ct_shim_tramp 建,
            // ct_join 收段),段对 GC 不可见 → 主线程收集永不与任务栈相遇(pthread 档
            // 解除 ct_gc_conc 永久退避的地基)。coro 档不装段,退避口径不变(T2)。
            // 首块 16KB、增长倍增、旧块链上保留(段释放全链回收;全局竞技场旧块=
            // 永生,同旧口径泄漏面)。__sync 内建 = gcc/clang;MSVC 无此内建,emit 面
            // Windows 支持本身在册为债(T46 口径沿用)。
            println("typedef struct ct_ablk \{ struct ct_ablk* nx; size_t cap; size_t used; } ct_ablk;")
            println("typedef struct ct_arn \{ ct_ablk* cur; size_t off; } ct_arn;")
            println("static ct_arn ctron_aglobal;")
            println("static __thread ct_arn* ct_tls_arn = 0;")
            println("static void ctron_panic(const char* m);")
            println("static void* ct_ablk_new(size_t cap) \{ ct_ablk* b = (ct_ablk*)malloc(sizeof(ct_ablk) + cap); if (!b) \{ ctron_panic(\"arena OOM\"); } b->nx = 0; b->cap = cap; b->used = 0; return b; }")
            println("static void* ctron_amalloc(size_t n) \{ n = (n + 15) & ~(size_t)15; ct_arn* a = ct_tls_arn ? ct_tls_arn : &ctron_aglobal; int lk = (a == &ctron_aglobal); if (lk) \{ while (__sync_lock_test_and_set(&ctron_alock, 1)) \{ } } if (!a->cur || a->off + n > a->cur->cap) \{ size_t nc = a->cur ? a->cur->cap * 2 : (size_t)16384; while (nc < n) \{ nc = nc * 2; } ct_ablk* nb = (ct_ablk*)malloc(sizeof(ct_ablk) + nc); if (!nb) \{ if (lk) \{ __sync_lock_release(&ctron_alock); } ctron_panic(\"arena OOM\"); } if (a->cur) \{ a->cur->used = a->off; } nb->nx = a->cur; nb->cap = nc; nb->used = 0; a->cur = nb; a->off = 0; } void* p = (char*)(a->cur + 1) + a->off; a->off += n; if (lk) \{ __sync_lock_release(&ctron_alock); } return p; }")
                        println("static int64_t ctron_str_to_i64(const char* s) \{ int64_t r = 0; int neg = 0; long k = 0; if (s[k] == 45) \{ neg = 1; k++; } else if (s[k] == 43) \{ k++; } while (s[k] >= 48 && s[k] <= 57) \{ r = r * 10 + (s[k] - 48); k++; } return neg ? -r : r; }")
            // 运行时辅助:容器/单元格/字节域/读文件(必须先于使用它的原型)
            println("typedef struct \{ unsigned long long magic; char** items; int n; int cap; } ctron_list;")
            // T29 M1 GC 前向声明(核心实现在 ct_chans 声明之后;保守根先行,
            // G1-T7:CTRON_GC 默认开(J2 翻面裁决,长跑默认有界);CTRON_GC=0/off 退回 bump。
            // 并发退避=coro 档限定(pthread 任务走段,见 T2)
            println("static void* ct_gc_alloc(size_t n);")
            println("static long long ct_gc_live_bytes(void);")
            println("static long long ct_gc_collect(void);")
            println("static void ct_mcreg_add(void* p, size_t words);")
            println("static int ct_gc_conc = 0;")
            println("typedef struct \{ int32_t v; } ctron_cell;")
                        // T30 into_gc 真深拷(§6.3):静态元素模式分派(0=标量槽/1=Str/2=嵌套表/3=struct 盒)
            println("static ctron_list* ct_ig_l(ctron_list* src, int mode, size_t esz, int imode) \{ if (!src) return 0; ctron_list* d = (ctron_list*)ct_gc_alloc(sizeof(ctron_list)); d->magic = 0x4354726F6E4C7374ULL; d->n = src->n; d->cap = src->n > 0 ? src->n : 0; d->items = 0; if (src->n > 0 && src->items) \{ d->items = (char**)ct_gc_alloc(sizeof(char*) * (size_t)src->n); for (int q = 0; q < src->n; q++) \{ char* v = src->items[q]; char* w = v; if (mode == 0) \{ w = v; } else if (mode == 1) \{ size_t n = v ? strlen(v) + 1 : 1; char* r2 = (char*)ct_gc_alloc(n); if (v) memcpy(r2, v, n); r2[n-1] = 0; w = r2; } else if (mode == 2) \{ w = (char*)ct_ig_l((ctron_list*)v, imode, esz, -1); } else \{ void* b2 = ct_gc_alloc(esz); if (v) memcpy(b2, v, esz); w = (char*)b2; } d->items[q] = w; } } return d; }")
println("static ctron_list* ctron_list_new(void) \{ ctron_list* l = (ctron_list*)ct_gc_alloc(sizeof(ctron_list)); l->magic = 0x4354726F6E4C7374ULL; l->items = 0; l->n = 0; l->cap = 0; return l; }")
            // StringBuilder 发射臂(T50 尾巴;§3.8.2):单缓冲形(段表语义在
            // interp,emit 单缓冲等价,推入序一致)。句柄形 = char* 伪装(N 通道
            // 全兼容);魔数与 ctron_list 同款八字节形(strlen>=8 门必备)
            println("typedef struct \{ unsigned long long magic; char* data; int len; int cap; } ctron_sb;")
            println("static char* ctron_sb_new(void) \{ ctron_sb* sb = (ctron_sb*)ct_gc_alloc(sizeof(ctron_sb)); sb->magic = 0x4374726F6E534231ULL; sb->data = (char*)ct_gc_alloc(64); sb->data[0] = 0; sb->len = 0; sb->cap = 64; return (char*)sb; }")
            // G1-T5:增量 push(容量足原地写,不足倍增;旧=每 push 全量重分配 O(n²))
            println("static void ctron_sb_push(const void* h, const char* s) \{ ctron_sb* sb = (ctron_sb*)h; int n = (int)strlen(s); if (sb->len + n + 1 > sb->cap) \{ int nc = sb->cap ? sb->cap * 2 : 64; while (nc < sb->len + n + 1) \{ nc = nc * 2; } char* r = (char*)ct_gc_alloc((size_t)nc); memcpy(r, sb->data, (size_t)sb->len); sb->data = r; sb->cap = nc; } memcpy(sb->data + sb->len, s, (size_t)n); sb->len += n; sb->data[sb->len] = 0; }")
            println("static void ctron_sb_reserve(const void* h, int n) \{ ctron_sb* sb = (ctron_sb*)h; if (n <= 0) \{ return; } if (sb->len + n + 1 > sb->cap) \{ int nc = sb->cap ? sb->cap * 2 : 64; while (nc < sb->len + n + 1) \{ nc = nc * 2; } char* r = (char*)ct_gc_alloc((size_t)nc); memcpy(r, sb->data, (size_t)sb->len); sb->data = r; sb->cap = nc; } }")
            println("static void ctron_sb_clear(const void* h) \{ ctron_sb* sb = (ctron_sb*)h; sb->len = 0; sb->data[0] = 0; }")
            println("static const char* ctron_sb_str(const void* p) \{ const char* s0 = (const char*)p; unsigned long long m2 = 0; if (strlen(s0) >= 8) \{ memcpy(&m2, s0, 8); if (m2 == 0x4374726F6E534231ULL) \{ const ctron_sb* sb2 = (const ctron_sb*)p; size_t dn = (size_t)sb2->len; char* r = (char*)ct_gc_alloc(dn + 1); memcpy(r, sb2->data, dn + 1); return r; } } return s0; }")
            println("static int ctron_len(const void* p) \{ const char* s = (const char*)p; unsigned long long m = 0; if (strlen(s) >= 8) \{ memcpy(&m, s, 8); if (m == 0x4354726F6E4C7374ULL) \{ return ((const ctron_list*)p)->n; } if (m == 0x4374726F6E534231ULL) \{ return (int)strlen(((const ctron_sb*)p)->data); } } return (int)strlen(s); }")
            println("static void ctron_list_push(ctron_list* l, const char* s) \{ if (l->n == l->cap) \{ int nc = l->cap ? l->cap * 2 : 8; char** ni = (char**)ct_gc_alloc(sizeof(char*) * (size_t)nc); int q = 0; while (q < l->n) \{ ni[q] = l->items[q]; q += 1; } l->items = ni; l->cap = nc; } l->items[l->n] = (char*)s; l->n += 1; }")
            println("static ctron_cell* ctron_cell_new(int32_t v0) \{ ctron_cell* c = (ctron_cell*)ct_gc_alloc(sizeof(ctron_cell)); c->v = v0; return c; }")
            println("static void ctron_print_i32(int32_t v) \{ printf(\"%d" + bs() + "n\", v); }")
            println("static const char* ctron_str_concat(const char* a, const char* b) \{ size_t la = strlen(a), lb = strlen(b); char* r = (char*)ct_gc_alloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb); r[la + lb] = 0; return r; }")
            println("static const char* ctron_i32_to_string(int32_t v) \{ char* r = (char*)ct_gc_alloc(16); snprintf(r, 16, \"%d\", v); return r; }")
            println("static void ctron_print_i64(int64_t v) \{ printf(\"%lld" + bs() + "n\", (long long)v); }")
            println("static int ctron_byte_at(const char* s, int i) \{ return (int)(unsigned char)s[i]; }")
            // CC2(2026-10-16):str_byte 内建宿主口——单字节保真构造(0-255 直落 1 字节;
            // utf8_enc 逐字节用于 ≥0x80 = 双重编码祸根,字节平面读出一律走本口)
            println("static const char* ctron_str_byte(int b) \{ char* r = (char*)ct_gc_alloc(2); r[0] = (char)(b & 0xFF); r[1] = 0; return r; }")
            println("static const char* ctron_utf8_enc(int cp) \{ static const char* rep = \"\\xEF\\xBF\\xBD\"; unsigned char b[5]; int un = 0; if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) \{ return rep; } if (cp < 0x80) \{ b[un++] = (unsigned char)cp; } else if (cp < 0x800) \{ b[un++] = (unsigned char)(0xC0 | (cp >> 6)); b[un++] = (unsigned char)(0x80 | (cp & 0x3F)); } else if (cp < 0x10000) \{ b[un++] = (unsigned char)(0xE0 | (cp >> 12)); b[un++] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F)); b[un++] = (unsigned char)(0x80 | (cp & 0x3F)); } else \{ b[un++] = (unsigned char)(0xF0 | (cp >> 18)); b[un++] = (unsigned char)(0x80 | ((cp >> 12) & 0x3F)); b[un++] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F)); b[un++] = (unsigned char)(0x80 | (cp & 0x3F)); } b[un] = 0; char* r = (char*)ct_gc_alloc((size_t)un + 1); memcpy(r, b, (size_t)un); r[un] = 0; return r; }")
            // CC2 自发射口(自举固定点修,2026-10-18):eval_call.ct 经 extern 直调的
            // _t 十进制文本面(解释臂=host_shim/cc2_str.c malloc 版;发射臂=本 GC 委派,
            // 编译器自发射产物(cc_interp/cc_emitter)解释用户程序时同 path 可用)
            println("static const char* ctron_str_byte_t(const char* dec) \{ return ctron_str_byte((int)strtol(dec, 0, 10)); }")
            println("static const char* ctron_utf8_enc_t(const char* dec) \{ return ctron_utf8_enc((int)strtol(dec, 0, 10)); }")
            // W5b-bit(2026-10-28):bit.* 算术宿主口自发射版(与 host_shim/cc2_bit.c 同族;
            // 编译器自发射产物解释用户程序时同 path 可用)。体内零花括号(裸 { 词法毒在册,
            // 见 c-rust-divergences 词法器统一志向)——三目链 + CTB_M 宏。
            println("#define CTB_M(bits) (bits == 64 ? ~(unsigned long long)0 : ((1ULL << bits) - 1))")
            println("static long long ctron_bit_i64(int op, long long a, long long b, int bits, int sgn) \{ return (bits == 32) ? (long long)(int32_t)(uint32_t)(op == 0 ? (a & b) : op == 1 ? (a | b) : op == 2 ? (a ^ b) : op == 3 ? (a ^ CTB_M(bits)) : op == 4 ? ((a << b) & CTB_M(bits)) : sgn ? (((bits == 32 ? (long long)(int32_t)a : a) >> b) & CTB_M(bits)) : (a >> b)) : (long long)(op == 0 ? (a & b) : op == 1 ? (a | b) : op == 2 ? (a ^ b) : op == 3 ? (a ^ CTB_M(bits)) : op == 4 ? ((a << b) & CTB_M(bits)) : sgn ? (((bits == 32 ? (long long)(int32_t)a : a) >> b) & CTB_M(bits)) : (a >> b)); }")
            println("static void ctron_panic(const char* m);")
            println("static const char* ctron_byte_slice(const char* s, int a, int b) \{ int n = b - a; if (n < 0 || a < 0 || (long)a + (long)n > (long)strlen(s)) \{ ctron_panic(\"byte_slice: range out of bounds\"); } char* r = (char*)ct_gc_alloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }")
            // Str 编组(§9.6 v0.6):C 侧 char* 深拷入 arena(Ctron-owned,免 free;
            // 语言面 str_from_c;解释器口径为恒等——解释域无 C 堆)
            println("static const char* ctron_str_from_c(const char* p) \{ size_t n = strlen(p); char* r = (char*)ct_gc_alloc(n + 1); memcpy(r, p, n + 1); return r; }")
            println("static const char* ctron_dlerror_str(void) \{ const char* e5 = dlerror(); if (!e5) \{ return \"\"; } size_t n5 = strlen(e5); char* r5 = (char*)ct_gc_alloc(n5 + 1); memcpy(r5, e5, n5 + 1); return r5; }")
            println("static const char* ctron_read_file(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return \"\"; } fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET); char* r = (char*)ct_gc_alloc((size_t)n + 1); size_t rd = fread(r, 1, (size_t)n, f); r[rd] = 0; fclose(f); return r; }")
            // LSP/管道 I/O 宿主原语(解释臂 eval_call 同语义):read_line stdin 读一行
            // (去尾部 10/13,EOF 空串);read_bytes stdin 恰读 n 字节(Content-Length 体)
            println("static const char* ctron_read_line(void) \{ size_t cap = 256; size_t n = 0; char* buf = (char*)malloc(cap); if (!buf) \{ abort(); } int c; while ((c = fgetc(stdin)) != EOF) \{ if (c == 10) \{ break; } if (n + 2 > cap) \{ cap *= 2; buf = (char*)realloc(buf, cap); if (!buf) \{ abort(); } } buf[n] = (char)c; n++; } if (c == EOF && n == 0) \{ free(buf); return \"\"; } if (n > 0 && buf[n - 1] == 13) \{ n--; } buf[n] = 0; char* r = (char*)ct_gc_alloc(n + 1); memcpy(r, buf, n + 1); free(buf); return r; }")
            println("static const char* ctron_read_bytes(int64_t want) \{ if (want < 0) \{ want = 0; } char* r = (char*)ct_gc_alloc((size_t)want + 1); size_t got = 0; while (got < (size_t)want) \{ size_t k = fread(r + got, 1, (size_t)want - got, stdin); if (k == 0) \{ break; } got += k; } r[got] = 0; return r; }")
            println("static const char* ctron_read_dir(const char* path) \{ DIR* d = opendir(path); if (!d) \{ return NULL; } size_t cap = 256; size_t len = 0; char* r = (char*)malloc(cap); r[0] = 0; struct dirent* de; while ((de = readdir(d)) != NULL) \{ if (strcmp(de->d_name, \".\") == 0 || strcmp(de->d_name, \"..\") == 0) \{ continue; } size_t bl = strlen(de->d_name); while (len + bl + 2 > cap) \{ cap *= 2; } char* nb = (char*)realloc(r, cap); r = nb; memcpy(r + len, de->d_name, bl); len += bl; r[len] = 10; len += 1; } closedir(d); r[len] = 0; return r; }")
            println("static int ctron_fs_exists(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return 0; } fclose(f); return 1; }")
            println("static int ctron_fs_write(const char* path, const char* data) \{ FILE* f = fopen(path, \"wb\"); if (!f) \{ return 0; } size_t n = strlen(data); size_t w = fwrite(data, 1, n, f); fclose(f); return w == n; }")
            println("static int ctron_fs_mkdir(const char* path) \{\n#include <sys/stat.h>\n#include <errno.h>\n char tmp[4096]; size_t len = strlen(path); if (len == 0 || len >= sizeof(tmp)) \{ return 0; } memcpy(tmp, path, len + 1); for (char* p = tmp + 1; *p; p++) \{ if (*p == '/') \{ *p = 0; if (mkdir(tmp, 0755) != 0 && errno != EEXIST) \{ return 0; } *p = '/'; } } if (mkdir(tmp, 0755) != 0 && errno != EEXIST) \{ return 0; } return 1; }")
            println("int32_t ctron_fs_mkdir_p(const char* path) \{ return (int32_t)ctron_fs_mkdir(path); }")
            println("static int ctron_fs_delete(const char* path) \{ return remove(path) == 0; }")
            println("static void ctron_sleep_ms(long long ms) \{ struct timespec ts; ts.tv_sec = ms / 1000; ts.tv_nsec = (ms % 1000) * 1000000L; nanosleep(&ts, 0); }")
            println("static void ctron_sleep_ns(long long ns) \{ struct timespec ts; ts.tv_sec = ns / 1000000000LL; ts.tv_nsec = ns % 1000000000LL; nanosleep(&ts, 0); }")
            println("static int64_t ctron_now_ms(void) \{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (long long)ts.tv_sec * 1000LL + ts.tv_nsec / 1000000LL; }")
            println("static const char* ctron_now_ms_text(void) \{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); long long ms = (long long)ts.tv_sec * 1000LL + ts.tv_nsec / 1000000LL; char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%lld\", ms); return r; }")
            // 时钟 ns 面(loom 内化批2):mono = CLOCK_MONOTONIC(时长测量);wall = ns 精度墙钟;
            // _text 变体 = 解释器宽域标记入口(now_ms 同径;19 位十进制 + NUL ≤ 32 缓冲)
            println("static int64_t ctron_mono_ns(void) \{ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec; }")
            println("static const char* ctron_mono_ns_text(void) \{ struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); long long ns = (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec; char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%lld\", ns); return r; }")
            println("static int64_t ctron_wall_ns(void) \{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec; }")
            println("static const char* ctron_wall_ns_text(void) \{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); long long ns = (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec; char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%lld\", ns); return r; }")
            println("typedef int64_t ct_i;")
            println("typedef struct \{ int variant; ct_i v; } ct_res;")
            // T25 &Trait 胖指针(§3.5):{data, vtable} 值传递
            println("typedef struct \{ void* data; void* vtable; } ct_obj;")
            println("static void* deref_ptr(void* p) \{ return p; }")
            println("typedef struct ct_scope \{ int cancelled; pthread_mutex_t mu; struct ct_task* head; struct ct_task* tail; } ct_scope;")
            // G3-W1:任务链=scope 属主线程单写(spawn 于属主线程,join-all 走查免锁)
            println("static ct_scope* ct_scope_new(void) \{ ct_scope* s = (ct_scope*)calloc(1, sizeof(ct_scope)); pthread_mutex_init(&s->mu, 0); return s; }")
            println("static pthread_mutex_t ct_gm = PTHREAD_MUTEX_INITIALIZER;")
            println("static void ct_glock(void) \{ pthread_mutex_lock(&ct_gm); }")
            println("static void ct_gunlock(void) \{ pthread_mutex_unlock(&ct_gm); }")
            println("typedef struct ct_task \{ pthread_t th; void* env; void* (*shim)(void*); ct_i result; int state; char pmsg[128]; ct_scope* scope; void* arn; int joined; struct ct_task* snext; pthread_mutex_t done_mu; pthread_cond_t done_cv; int done; jmp_buf jmp; } ct_task;")
            println("static __thread ct_task* ct_tls_task = 0;")
            println("__attribute__((noinline)) static ct_task** ct_tls_slot(void) \{ return &ct_tls_task; }")
            println("typedef struct ct_chan \{ pthread_mutex_t mu; pthread_cond_t cv_full, cv_empty; ct_i* buf; int head, tail, cnt, cap; int is_str; } ct_chan;")
            println("static ct_chan** ct_chans = 0; static int ct_nchans = 0, ct_chancap = 0; static pthread_mutex_t ct_chreg = PTHREAD_MUTEX_INITIALIZER;")
            // ==== T29 M1 tracing GC(非移动 mark-sweep;设计:2026-09-15-gc-contract-design §6.2 M1)====
            // 根集:机器栈[帧址,main 基]保守扫(S1 档)+chan 环+mcell 注册表+bump 区(闭包
            // env 持指针)+GC 堆载荷传播;精确帧链根集=M1.5(T31 重开,S2)。
            // S1 硬化:超块尺寸类+内部指针块起点归约+worklist 迭代标记(路径② SIGSEGV 两机制销账)。
            // 对象=超级块内定步距刻切,头 {sz,mk};mk:0 空/1 活未色/2 已标;空块首载荷字=空闲链。
            // 并发退避(G1 重定义):coro 档(CTRON_RT=coro)spawn 置 ct_gc_conc →
            // 全体分配回落全局 bump(协程跨线程迁移,TLS 段不安全,维持旧口径);
            // pthread 档任务走私有段(T2),主线程 GC 保持活跃。
            println("static char* ct_gc_stack_base = 0;")
            println("static int ct_gc_on = -1;")
            println("static size_t ct_gc_since = 0, ct_gc_thresh = 8u*1024u*1024u, ct_gc_livesz = 0;")
            // S1(T31 重开,2026-10-02):标记器硬化+迭代化。①超块单尺寸类(bsz,块步距恒
            // 16+bsz)——内部指针 O(1) 归约块起点再读头,灭路径②「载荷当头读」野扫 SIGSEGV;
            // 头双门(h[1]==1 且 0<h[0]≤bsz)。②显式 worklist 替代 mkword/mkrange 互递归
            // (递归深度=对象图深度,深链/C 栈爆实证)。③新超块 calloc 清零——未刻切块头
            // 读 0=天然拒标,垃圾头不可能。根集不变(保守栈+chan+mcell+bump 区)。
            println("typedef struct ct_sb \{ struct ct_sb* nx; char* cur; char* end; void* fl; size_t cap; size_t live; size_t bsz; int empty_age; } ct_sb;")
            println("static ct_sb* ct_gc_sbs = 0;")
            println("static char** ct_gc_wl = 0;")
            println("static size_t ct_gc_wln = 0, ct_gc_wlc = 0;")
            println("static void ctron_panic(const char* m);")
            println("static void ct_gc_wlput(char* lo, char* hi) \{ if (ct_gc_wln + 2 > ct_gc_wlc) \{ size_t nc = ct_gc_wlc ? ct_gc_wlc * 2 : 4096; char** nw = (char**)realloc(ct_gc_wl, nc * sizeof(char*)); if (!nw) \{ ctron_panic(\"gc: worklist OOM(realloc败=标记候选丢失=静默UAF,响亮退出)\"); } ct_gc_wl = nw; ct_gc_wlc = nc; } ct_gc_wl[ct_gc_wln++] = lo; ct_gc_wl[ct_gc_wln++] = hi; }")
            // S2(T31 重开 M1.5):精确帧链根集(契约 §6.3;编码=槽注册制——发射器不知 C 帧
            // 偏移,槽节点持 &局部 强制落内存+每 fn 帧节点 cleanup 尾声统一)。kind 0=词槽
            // 直标/1=值结构体(u:/R/E:)域扫。__thread=多线程推拉隔离(pmap 8 线程);收集
            // 仅主线程,任务线程分配已退避 bump。主栈保守扫降级 CTRON_GC_CONSERV 逃逸档。
            println("typedef struct ct_frs \{ void** addr; int kind; size_t sz; } ct_frs;")
            println("typedef struct ct_fr \{ struct ct_fr* up; ct_frs pool[128]; int pn; int ovf; int sv[32]; int spn; } ct_fr;")
            println("static __thread ct_fr* ct_fp = 0;")
            println("static void ct_fp_pop(void* p) \{ ct_fp = ((ct_fr*)p)->up; }")
            println("static int ct_gc_conserv = 0;")
            println("static int ct_gc_arena_scan = 1;")
            println("static int ct_gc_ovf = 0;")
            println("typedef struct ct_mce \{ void* p; size_t words; struct ct_mce* nx; } ct_mce;")
            println("static ct_mce* ct_mcreg_h = 0;")
            println("static void ct_mcreg_add(void* p, size_t words) \{ ct_mce* e = (ct_mce*)malloc(sizeof(ct_mce)); if (!e) return; e->p = p; e->words = words; e->nx = ct_mcreg_h; ct_mcreg_h = e; }")
            println("static int ct_gc_enabled(void) \{ if (ct_gc_on < 0) \{ const char* g = getenv(\"CTRON_GC\"); ct_gc_on = (g && (!strcmp(g, \"0\") || !strcmp(g, \"off\"))) ? 0 : 1; const char* th = getenv(\"CTRON_GC_THRESHOLD\"); if (th && *th) \{ long v = atol(th); if (v > 0) ct_gc_thresh = (size_t)v; } const char* cv = getenv(\"CTRON_GC_CONSERV\"); ct_gc_conserv = 1; if (cv && (*cv == '0' || *cv == 'f')) \{ ct_gc_conserv = 0; } const char* av = getenv(\"CTRON_GC_ARENASCAN\"); ct_gc_arena_scan = 1; if (av && (*av == '0' || *av == 'f')) \{ ct_gc_arena_scan = 0; } } return ct_gc_on; }")
            println("static void ct_gc_mkword(void* w) \{ ct_sb* s = 0; for (ct_sb* q = ct_gc_sbs; q; q = q->nx) \{ char* b = (char*)(q + 1); if ((char*)w >= b && (char*)w < q->end) \{ s = q; break; } } if (!s) \{ return; } size_t st = 16 + s->bsz; size_t off = (size_t)((char*)w - (char*)(s + 1)); size_t* hdr = (size_t*)((char*)(s + 1) + (off / st) * st); if (hdr[1] != 1) \{ return; } if (hdr[0] == 0 || hdr[0] > s->bsz) \{ return; } hdr[1] = 2; ct_gc_livesz += hdr[0]; ct_gc_wlput((char*)(hdr + 2), (char*)(hdr + 2) + hdr[0]); if (hdr[0] >= 24) \{ unsigned long long mg; memcpy(&mg, hdr + 2, 8); if (mg == 0x4354726F6E4C7374ULL) \{ char** it = *(char***)((char*)(hdr + 2) + 8); int nn = *(int*)((char*)(hdr + 2) + 16); if (it && nn > 0) \{ ct_gc_wlput((char*)it, (char*)it + (size_t)nn * sizeof(char*)); } } } }")
            println("static void* ct_gc_alloc(size_t n) \{ if (ct_gc_conc || !ct_gc_enabled() || ct_tls_arn) \{ return ctron_amalloc(n); } if (ct_gc_since > ct_gc_thresh && ct_gc_since > ct_gc_livesz) \{ ct_gc_collect(); } /* S4④:堆自适应——churn 超过活集才收集,摊销全堆标记 <=2x;8MB 底线保小堆响应 */ size_t sz = (n + 15) & ~(size_t)15; ct_sb* best = 0; for (ct_sb* s = ct_gc_sbs; s; s = s->nx) \{ if (s->bsz >= sz && s->fl) \{ if (!best || s->bsz < best->bsz) \{ best = s; } } } if (best) \{ size_t* h = (size_t*)best->fl; best->fl = (void*)h[2]; h[0] = sz; h[1] = 1; best->live += 1; ct_gc_since += sz; return (void*)(h + 2); } ct_sb* carve = 0; for (ct_sb* s = ct_gc_sbs; s; s = s->nx) \{ if (s->bsz >= sz && s->cur + 16 + s->bsz <= s->end) \{ if (!carve || s->bsz < carve->bsz) \{ carve = s; } } } size_t bsz = 32; while (bsz < sz) \{ bsz *= 2; } if (!carve) \{ size_t st = 16 + bsz; size_t cap = 1024u * 1024u; if (cap < st) \{ cap = st; } cap = (cap / st) * st; ct_sb* s = (ct_sb*)calloc(1, sizeof(ct_sb) + cap); if (!s) \{ return ct_gc_alloc(n); } s->nx = ct_gc_sbs; ct_gc_sbs = s; s->cap = cap; s->fl = 0; s->live = 0; s->bsz = bsz; s->cur = (char*)(s + 1); s->end = s->cur + cap; carve = s; } size_t st = 16 + carve->bsz; size_t* h = (size_t*)carve->cur; h[0] = sz; h[1] = 1; h[2] = 0; carve->cur = carve->cur + st; carve->live += 1; ct_gc_since += sz; return (void*)(h + 2); }")
            println("static long long ct_gc_collect_inner(void);")
            println("// Boehm GC_with_callee_saves 同款壳:setjmp 必须先于一切可打脏调用方\n") 
            println("// 寄存器的语句——薄壳捕获全寄存器态落 jmp_buf 入根集,实体下沉 inner\n")
            println("static long long ct_gc_collect(void) \{ jmp_buf ct_rjb; setjmp(ct_rjb); ct_gc_wlput((char*)ct_rjb, (char*)ct_rjb + sizeof(ct_rjb)); return ct_gc_collect_inner(); }")

            println("static long long ct_gc_collect_inner(void) \{ __asm__ volatile(\"\" : : : \"memory\"); ct_gc_livesz = 0; ct_gc_wln = 0; ct_gc_ovf = 0; jmp_buf ct_rjb; setjmp(ct_rjb); ct_gc_wlput((char*)ct_rjb, (char*)ct_rjb + sizeof(ct_rjb)); for (ct_fr* f = ct_fp; f; f = f->up) \{ if (f->ovf) \{ ct_gc_ovf = 1; } for (int pi3 = 0; pi3 < f->pn; pi3++) \{ ct_frs* s = &f->pool[pi3]; if (s->kind == 0) \{ ct_gc_mkword(*(void**)s->addr); } else \{ ct_gc_wlput((char*)s->addr, (char*)s->addr + s->sz); } } } char* fa = (char*)__builtin_frame_address(0); if ((ct_gc_conserv || ct_gc_ovf) && ct_gc_stack_base && fa < ct_gc_stack_base) ct_gc_wlput(fa, ct_gc_stack_base); for (int i = 0; i < ct_nchans; i++) \{ if (ct_chans[i] && ct_chans[i]->buf && ct_chans[i]->cap > 0) \{ ct_gc_wlput((char*)ct_chans[i]->buf, (char*)ct_chans[i]->buf + (size_t)ct_chans[i]->cap * sizeof(ct_i)); } } for (ct_mce* e = ct_mcreg_h; e; e = e->nx) \{ ct_gc_wlput((char*)e->p, (char*)e->p + e->words * sizeof(void*)); } if (ct_gc_arena_scan) \{ ct_ablk* b3 = ctron_aglobal.cur; if (b3) \{ ct_gc_wlput((char*)(b3 + 1), (char*)(b3 + 1) + ctron_aglobal.off); } for (b3 = b3 ? b3->nx : (ct_ablk*)0; b3; b3 = b3->nx) \{ ct_gc_wlput((char*)(b3 + 1), (char*)(b3 + 1) + b3->used); } } while (ct_gc_wln > 0) \{ char* hi2 = ct_gc_wl[--ct_gc_wln]; char* lo2 = ct_gc_wl[--ct_gc_wln]; for (char* w2 = lo2; w2 + sizeof(void*) <= hi2; w2 += sizeof(void*)) \{ void* c2; memcpy(&c2, w2, sizeof(void*)); ct_gc_mkword(c2); } } for (ct_sb* s = ct_gc_sbs; s; s = s->nx) \{ char* b2 = (char*)(s + 1); size_t st2 = 16 + s->bsz; size_t nb2 = (size_t)(s->cur - b2) / st2; for (size_t i2 = 0; i2 < nb2; i2++) \{ size_t* h = (size_t*)(b2 + i2 * st2); if (h[1] == 2) \{ h[1] = 1; } else if (h[1] == 1) \{ h[1] = 0; s->live -= 1; *(void**)(h + 2) = s->fl; s->fl = (void*)h; } } } ct_gc_since = 0; ct_sb** pp = &ct_gc_sbs; while (*pp) \{ ct_sb* s = *pp; if (s->live == 0) \{ s->empty_age += 1; if (s->empty_age >= 2) \{ *pp = s->nx; free(s); } else \{ pp = &s->nx; } } else \{ s->empty_age = 0; pp = &s->nx; } } return (long long)ct_gc_livesz; }")
            println("static long long ct_gc_live_bytes(void) \{ return ct_gc_enabled() ? (long long)ct_gc_livesz : -1LL; }")
            println("static void ct_ch_reg(ct_chan* c) \{ pthread_mutex_lock(&ct_chreg); if (ct_nchans == ct_chancap) \{ int nc = ct_chancap ? ct_chancap * 2 : 16; ct_chan** na = (ct_chan**)realloc(ct_chans, (size_t)nc * sizeof(ct_chan*)); if (na) \{ ct_chans = na; ct_chancap = nc; } } if (ct_nchans < ct_chancap) \{ ct_chans[ct_nchans] = c; ct_nchans += 1; } pthread_mutex_unlock(&ct_chreg); }")
            // P2-D 并发模板模式分支:rt 七符号以"弱定义哑元"垫底(机制同 ctron_net.c——
            // Mach-O 无 undefined-weak→NULL 链接语义,weak extern 声明链接期报 undefined,
            // Task 3 实证;弱定义哑元 + ctron_rt.c 强定义链接期整体顶替,ELF/Mach-O 双侧
            // 标准语义,无同 TU 常量折叠)。未链 rt ⇒ 哑元 active 恒 0 ⇒ 七触点全走
            // P1 pthread 原路径(默认分支逐字保留);链入 rt 且 CTRON_RT=coro ⇒ 协程改道。
            // 哑元无条件发射(评审 Important 修):_WIN32 也裁不得——触点对 rt 符号的
            // 引用仅运行期守卫(ct_rt_active/coro_ctx 恒 0,调用面永不执行),符号引用
            // 本身存活;任何 #if 裁切都留 mingw 链接 undefined(init/cancel_wake_all/
            // notify_done/join_key/run/park 共九处)。PE/COFF 弱定义 mingw gcc 受支持;
            // rt 为 POSIX-only 永不在 _WIN32 链入,哑元即终解。
            println("__attribute__((weak)) int ctron_rt_active(void) \{ return 0; }")
            println("__attribute__((weak)) void ctron_rt_init(int workers) \{ (void)workers; }")
            println("__attribute__((weak)) void* ctron_rt_run(void (*fn)(void*), void* arg, void* key) \{ (void)fn; (void)arg; (void)key; return 0; }")
            println("__attribute__((weak)) void ctron_rt_join_key(void* key) \{ (void)key; }")
            println("__attribute__((weak)) void ctron_rt_park(void) \{ }")
            println("__attribute__((weak)) void ctron_rt_wake(void* key) \{ (void)key; }")
            println("__attribute__((weak)) void ctron_rt_notify_done(void* key) \{ (void)key; }")
            println("__attribute__((weak)) void ctron_rt_cancel_wake_all(void) \{ }")
            println("__attribute__((weak)) void* ctron_rt_current(void) \{ return 0; }")
            // P9 栈面全量(A′ 分段+钉住+再入续跑):序言检查强钩子哑元——
            // ctron_rt.c 强定义链接期顶替(P2-D 同款);检查仅 CTRON_MORESTACK
            // 发射期注入,哑元态(未链 rt)恒 0/不可达。size_t 对齐 rt 侧签名。
            // 哑元同挂发射期门:默认发射逐字节与旧形一致(黄金站岗)。
            if !seq2(env_get("CTRON_MORESTACK"), "") && !seq2(env_get("CTRON_MORESTACK"), "0") {
                println("__attribute__((weak)) int ctron_rt_stk_low(size_t need) \{ (void)need; return 0; }")
                println("__attribute__((weak)) void ctron_rt_stk_grow(void (*fn)(void*, void*), void* a, void* r) \{ (void)fn; (void)a; (void)r; }")
            }
            // 判据冻结口径:ct_rt_active = 真 rt 已链且 CTRON_RT=coro;ct_rt_coro_ctx =
            // 再加 current() 非空(协程上下文)——口径同 ctron_net.c ct_rt_parkable,
            // 因 park 对裸线程是契约外 no-op,裸线程调用面(如 main)保持 pthread 原语。
            println("static int ct_rt_active(void) \{")
            println("#if !defined(_WIN32)")
            println("    return ctron_rt_active();")
            println("#else")
            println("    return 0;")
            println("#endif")
            println("}")
            println("static int ct_rt_coro_ctx(void) \{")
            println("#if !defined(_WIN32)")
            println("    return ctron_rt_active() && ctron_rt_current() != 0;")
            println("#else")
            println("    return 0;")
            println("#endif")
            println("}")
            // 首个 spawn 的惰性 init:active() 要求真 rt 已 init(getenv==coro 且 g_inited),
            // 而 rt_run 的惰性 init 在 active() 门后 —— 模板侧按冻结口径(getenv
            // CTRON_RT=="coro")自探,仅协程环境才 init(默认环境不建 worker 线程)。
            println("static int ct_rt_env_coro(void) \{ const char* e = getenv(\"CTRON_RT\"); return e != 0 && strcmp(e, \"coro\") == 0; }")
            // 任务自取:协程模式以 rt current()(= spawn 时挂的 key=ct_task*)为准,
            // 对 N:M 迁移免疫;裸线程回退 __thread 槽(P1 口径,主线程恒 0)。
            // 全部 TLS 直访经 noinline 槽访问器(ctron_rt.c:301 同款已登记约束:
            // darwin/arm64 把 TLV 槽地址缓存在 callee-saved 寄存器,跨 park 迁移后
            // rt_swap 恢复旧镜像 ⇒ 直访串块——实证 shim 结果写 NULL->result 段错误)。
            println("static ct_task* ct_task_self(void) \{")
            println("#if !defined(_WIN32)")
            println("    if (ctron_rt_active()) \{ void* _k = ctron_rt_current(); if (_k) \{ return (ct_task*)_k; } }")
            println("#endif")
            println("    return *ct_tls_slot();")
            println("}")
            println("static void ct_cancel_broadcast(void) \{ int i; for (i = 0; i < ct_nchans; i++) \{ pthread_mutex_lock(&ct_chans[i]->mu); pthread_cond_broadcast(&ct_chans[i]->cv_full); pthread_cond_broadcast(&ct_chans[i]->cv_empty); pthread_mutex_unlock(&ct_chans[i]->mu); } if (ct_rt_active()) ctron_rt_cancel_wake_all(); }")
            // Drop 运行时栈(P1-A2,§6.4 panic 展开):指针条目 + 每类型 thunk;
            // ctron_panic 先取所有权逆序展开再 longjmp/exit(弹后再调,嵌套 panic 有界)
            println("typedef struct \{ void (*fn)(void*); void* obj; } ct_drent;")
            println("static ct_drent ct_drstack[2048];")
            println("static int ct_drn = 0;")
            println("static void ctron_drop_push(void (*fn)(void*), void* obj) \{ if (ct_drn < 2048) \{ ct_drstack[ct_drn].fn = fn; ct_drstack[ct_drn].obj = obj; ct_drn += 1; } }")
            println("static void ctron_drop_pop(void) \{ if (ct_drn > 0) \{ ct_drn -= 1; } }")
            println("static void ctron_drop_unwind(void) \{ while (ct_drn > 0) \{ ct_drn -= 1; ct_drstack[ct_drn].fn(ct_drstack[ct_drn].obj); } }")
            println("static int ctron_cb_depth = 0;")
            println("static void ctron_panic(const char* m) \{ fflush(stdout); fprintf(stderr, \"%s\\n\", m); ctron_drop_unwind(); if (ctron_cb_depth > 0) \{ exit(1); } ct_task* _tp = ct_task_self(); if (_tp) \{ snprintf(_tp->pmsg, 128, \"%s\", m); _tp->state = 2; if (_tp->scope) \{ _tp->scope->cancelled = 1; } ct_cancel_broadcast(); longjmp(_tp->jmp, 1); } exit(1); }")
            println("static int64_t ctron_i64_add(int64_t a, int64_t b) \{ int64_t r; if (__builtin_add_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (+)\"); } return r; }")
            println("static int64_t ctron_i64_sub(int64_t a, int64_t b) \{ int64_t r; if (__builtin_sub_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            println("static int64_t ctron_i64_mul(int64_t a, int64_t b) \{ int64_t r; if (__builtin_mul_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (*)\"); } return r; }")
            println("static int64_t ctron_i64_div(int64_t a, int64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } if (b == -1 && a == (-9223372036854775807LL - 1)) \{ ctron_panic(\"integer overflow (/)\"); } return a / b; }")
            println("static int64_t ctron_i64_mod(int64_t a, int64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } if (b == -1 && a == (-9223372036854775807LL - 1)) \{ ctron_panic(\"integer overflow (%)\"); } return a % b; }")
            println("static int64_t ctron_i64_neg(int64_t a) \{ int64_t r; if (__builtin_sub_overflow(0, a, &r)) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            // U64/USize 定宽槽检查帮手(P1-B):uint64_t,panic 消息镜像宿主
            // W 域定宽检查帮手(P1-B2):int32 中间量 + 宽度界门,panic 镜像 w_arith
            println("static int32_t ctron_w_add(int32_t a, int32_t b, int32_t lo, int32_t hi) \{ int32_t r = a + b; if (r < lo || r > hi) \{ ctron_panic(\"integer overflow (+)\"); } return r; }")
            println("static int32_t ctron_w_sub(int32_t a, int32_t b, int32_t lo, int32_t hi) \{ int32_t r = a - b; if (r < lo || r > hi) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            println("static int32_t ctron_w_mul(int32_t a, int32_t b, int32_t lo, int32_t hi) \{ int32_t r = a * b; if (r < lo || r > hi) \{ ctron_panic(\"integer overflow (*)\"); } return r; }")
            println("static int32_t ctron_w_div(int32_t a, int32_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a / b; }")
            println("static int32_t ctron_w_mod(int32_t a, int32_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a % b; }")
            println("static uint64_t ctron_u64_add(uint64_t a, uint64_t b) \{ uint64_t r; if (__builtin_add_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (+)\"); } return r; }")
            println("static uint64_t ctron_u64_sub(uint64_t a, uint64_t b) \{ uint64_t r; if (__builtin_sub_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (-)\"); } return r; }")
            println("static uint64_t ctron_u64_mul(uint64_t a, uint64_t b) \{ uint64_t r; if (__builtin_mul_overflow(a, b, &r)) \{ ctron_panic(\"integer overflow (*)\"); } return r; }")
            println("static uint64_t ctron_u64_div(uint64_t a, uint64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a / b; }")
            println("static uint64_t ctron_u64_mod(uint64_t a, uint64_t b) \{ if (b == 0) \{ ctron_panic(\"division by zero\"); } return a % b; }")
            println("static const char* ctron_i64_to_string(int64_t v) \{ char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%lld\", (long long)v); return r; }")
            println("static const char* ctron_u64_to_string(uint64_t v) \{ char* r = (char*)ct_gc_alloc(32); snprintf(r, 32, \"%llu\", (unsigned long long)v); return r; }")
            // 插值/to_string 标量面(§4.11;IP-23 23a-2 钉子):拼写对齐 println
            // 三元约定(零形 "0.0" ±0 无负号/整数形 %.1f/其余 %g)——解释臂 df
            // 规范十进制在非整数值域逐字同形,整数形补 .0;界内 long long 试探
            // 防 1e300 级 UB 转换(≥2^63 双精度恒整数,直落 %.1f)。512B 容
            // %.1f 全量位(1.8e308 → 309 位 + .0)
            println("static const char* ctron_f64_to_string(double v) \{ char* r = (char*)ct_gc_alloc(512); if (v == 0.0) \{ snprintf(r, 512, \"0.0\"); } else \{ double t = (v >= -9.22e18 && v <= 9.22e18) ? (double)(long long)v : v; if (v == t) \{ snprintf(r, 512, \"%.1f\", v); } else \{ snprintf(r, 512, \"%g\", v); } } return r; }")
            // IP-01 W2 错误链发射面(§5.4):ctron_anyerr 物化结构 + 判型/字段/包装助手。
            // 布点=ct_res typedef(line~201)之后;枚举统一视图读 variant(布局同
            // ct_enum_* {int variant; ct_i p[2]})。code/变体名表见 ct_vnames_* 发射点
            println("typedef struct ctron_anyerr ctron_anyerr;")
            println("struct ctron_anyerr \{ unsigned long long magic; char* message; ctron_anyerr* cause; char* trace; char* code; void* payload; char* tname; };")
            println("static int ct_is_anyerr(const void* p) \{ const ctron_anyerr* e = (const ctron_anyerr*)p; return e && e->magic == 0x4354414E59455252ULL; }")
            println("static const char* ct_err_fld(long v, const char* f) \{ ctron_anyerr* e = (ctron_anyerr*)v; if (ct_is_anyerr(e)) \{ if (f[0] == 109) return e->message ? e->message : \"\"; if (f[0] == 99 && f[1] == 111) return e->code ? e->code : \"\"; if (f[0] == 116) return e->trace ? e->trace : \"\"; } return \"\"; }")
            println("struct ct_enum_gen \{ int variant; ct_i p[2]; };")
            println("static const char* ct_dot_join(const char* a, const char* b) \{ char* r = (char*)ct_gc_alloc((a ? strlen(a) : 0) + (b ? strlen(b) : 0) + 2); sprintf(r, \"%s.%s\", a ? a : \"\", b ? b : \"\"); return r; }")
            println("static long ct_anyerr_wrap_e(void* p, const char* tn, const char** vn, const char* vname) \{ ctron_anyerr* n = (ctron_anyerr*)ct_gc_alloc(sizeof(ctron_anyerr)); n->magic = 0x4354414E59455252ULL; n->message = 0; n->cause = 0; n->trace = 0; n->payload = p; n->tname = (char*)tn; n->code = 0; if (vname) \{ n->code = (char*)ct_dot_join(tn, vname); } else if (vn && p) \{ n->code = (char*)ct_dot_join(tn, vn[((struct ct_enum_gen*)p)->variant]); } return (long)n; }")
            println("static long ct_anyerr_wrap_s(const char* s) \{ ctron_anyerr* n = (ctron_anyerr*)ct_gc_alloc(sizeof(ctron_anyerr)); n->magic = 0x4354414E59455252ULL; n->message = 0; n->cause = 0; n->trace = 0; n->code = (char*)s; n->payload = 0; n->tname = 0; return (long)n; }")
            println("static char* ct_trace_join(const char* old, const char* msg) \{ char* r = (char*)ct_gc_alloc((old ? strlen(old) : 0) + (msg ? strlen(msg) : 0) + 12); if (old && old[0]) \{ sprintf(r, \"%s; ctx:%s\", old, msg ? msg : \"\"); } else \{ sprintf(r, \"ctx:%s\", msg ? msg : \"\"); } return r; }")
            println("static ct_res ct_ctxres(ct_res v, const char* msg) \{ if (v.variant == 0) \{ return v; } ctron_anyerr* o = (ctron_anyerr*)(long)v.v; ctron_anyerr* n = (ctron_anyerr*)ct_gc_alloc(sizeof(ctron_anyerr)); n->magic = 0x4354414E59455252ULL; n->message = (char*)(msg ? msg : \"\"); if (ct_is_anyerr(o)) \{ n->cause = o; n->trace = ct_trace_join(o->trace, msg); n->code = o->code; n->payload = o->payload; n->tname = o->tname; } else \{ n->cause = 0; n->trace = ct_trace_join(0, msg); n->code = 0; n->payload = (void*)o; n->tname = 0; } ct_res r; r.variant = 1; r.v = (ct_i)(long)n; return r; }")
            // R1(Str? NULL 模型族):ct_res 构造(Some/None)→ char* 适配(注解 let/
            // return 位消费;init 已是 char* 时调用方直通不经过本助手)
            println("static const char* ct_optstr_unr(ct_res v) \{ if (v.variant == 0) \{ return (const char*)(long)v.v; } return 0; }")
            // Phase 4 并发运行时(函数部):任务 trampoline/spawn/join/Channel/parallel
            println("static void* ct_shim_tramp(void* p) \{ ct_task* t = (ct_task*)p; if (!ct_rt_active()) \{ ct_arn* ta = (ct_arn*)calloc(1, sizeof(ct_arn)); ta->cur = (ct_ablk*)ct_ablk_new((size_t)16384); ct_tls_arn = ta; t->arn = ta; } *ct_tls_slot() = t; if (setjmp(t->jmp) == 0) \{ t->shim(t->env); t->state = 1; } ct_fp = 0; pthread_mutex_lock(&t->done_mu); t->done = 1; pthread_cond_broadcast(&t->done_cv); pthread_mutex_unlock(&t->done_mu); if (ct_rt_active()) ctron_rt_notify_done((void*)t); return 0; }")
            println("static ct_task* ct_spawn(void* (*shim)(void*), void* env, ct_scope* sc) \{ ct_task* t = (ct_task*)calloc(1, sizeof(ct_task)); pthread_mutex_init(&t->done_mu, 0); pthread_cond_init(&t->done_cv, 0); t->shim = shim; t->env = env; t->scope = sc; if (sc) \{ if (sc->tail) \{ sc->tail->snext = t; } else \{ sc->head = t; } sc->tail = t; } if (ct_rt_active() || ct_rt_env_coro()) \{ ct_gc_conc = 1; } if (!ct_rt_active() && ct_rt_env_coro()) ctron_rt_init(0); if (ct_rt_active()) \{ ctron_rt_run((void (*)(void*))ct_shim_tramp, t, (void*)t); return t; } pthread_attr_t _sa; pthread_attr_init(&_sa); pthread_attr_setstacksize(&_sa, 8u << 20); pthread_create(&t->th, &_sa, ct_shim_tramp, t); return t; }")
            println("static void ct_task_seg_free(ct_task* t) \{ if (t && t->arn) \{ ct_arn* a = (ct_arn*)t->arn; ct_ablk* b = a->cur; while (b) \{ ct_ablk* nx = b->nx; free(b); b = nx; } free(a); t->arn = 0; } }")
            println("static ct_i ct_join(ct_task* t) \{ void* r; if (ct_rt_active()) \{ ctron_rt_join_key((void*)t); } else \{ pthread_join(t->th, &r); } t->joined = 1; if (t->state == 2) \{ ct_task_seg_free(t); ctron_panic(t->pmsg); } ct_i v = t->result; ct_task_seg_free(t); return v; }")
            println("static ct_res ct_join_or(ct_task* t) \{ void* r; if (ct_rt_active()) \{ ctron_rt_join_key((void*)t); } else \{ pthread_join(t->th, &r); } t->joined = 1; ct_task_seg_free(t); ct_res res; if (t->state == 2) \{ res.variant = 1; res.v = (ct_i)(long)\"task panic\"; } else \{ res.variant = 0; res.v = t->result; } return res; }")
            // G3-W4:TaskPool——N 工作者+无界任务队列;排空后停工;任务段纪律=
            // 每入队件经 ct_shim_tramp 上下文跑(段=件粒度);工作者线程置退避
            println("typedef struct ct_pitem \{ void* (*shim)(void*); void* env; struct ct_pitem* nx; } ct_pitem;")
            println("typedef struct ct_tpool \{ pthread_mutex_t mu; pthread_cond_t cv; ct_pitem* head; ct_pitem* tail; int n; int stop; pthread_t th[16]; } ct_tpool;")
            println("static void* ct_pool_worker(void* p) \{ ct_tpool* tp = (ct_tpool*)p; ct_gc_conc = 1; for (;;) \{ pthread_mutex_lock(&tp->mu); while (tp->head == 0 && !tp->stop) \{ pthread_cond_wait(&tp->cv, &tp->mu); } if (tp->head == 0 && tp->stop) \{ pthread_mutex_unlock(&tp->mu); break; } ct_pitem* it = tp->head; tp->head = it->nx; if (!tp->head) \{ tp->tail = 0; } pthread_mutex_unlock(&tp->mu); ct_task* t = (ct_task*)calloc(1, sizeof(ct_task)); pthread_mutex_init(&t->done_mu, 0); pthread_cond_init(&t->done_cv, 0); t->shim = it->shim; t->env = it->env; ct_shim_tramp((void*)t); ct_task_seg_free(t); free(t); free(it); } return 0; }")
            println("static ct_tpool* ct_pool_new(int n) \{ if (n < 1) \{ n = 1; } if (n > 16) \{ n = 16; } ct_tpool* tp = (ct_tpool*)calloc(1, sizeof(ct_tpool)); pthread_mutex_init(&tp->mu, 0); pthread_cond_init(&tp->cv, 0); tp->n = n; int i; for (i = 0; i < n; i++) \{ pthread_attr_t _pa; pthread_attr_init(&_pa); pthread_attr_setstacksize(&_pa, 8u << 20); pthread_create(&tp->th[i], &_pa, ct_pool_worker, tp); } return tp; }")
            println("static void ct_pool_spawn(ct_tpool* tp, void* (*shim)(void*), void* env) \{ ct_pitem* it = (ct_pitem*)malloc(sizeof(ct_pitem)); it->shim = shim; it->env = env; it->nx = 0; pthread_mutex_lock(&tp->mu); if (tp->tail) \{ tp->tail->nx = it; } else \{ tp->head = it; } tp->tail = it; pthread_cond_broadcast(&tp->cv); pthread_mutex_unlock(&tp->mu); }")
            // G3-W1:scope 退出 join-all——spec §07「作用域退出必然 join 全部子任务」
            // 兑现;链表=属主线程单写(全 spawn 于属主程序序),走查免锁;已显式
            // join 跳过(joined 置位),panic 重抛/段回收/joined 语义全复用 ct_join
            println("static void* ct_shim_tramp(void* p);")
            println("static void ct_task_seg_free(ct_task* t);")
            println("static void ct_scope_join_all(ct_scope* sc) \{ if (!sc) \{ return; } ct_task* t = sc->head; while (t) \{ ct_task* nx = t->snext; if (!t->joined) \{ ct_join(t); } t = nx; } }")
            // G3-W3:join_t 超时形——pthread timedwait 正典;coro 档回落无限等
            //(rt deadline 停车暴露挂后续);超时不 joined 不收段=join-all 兜底
            println("static ct_res ct_join_t(ct_task* t, long long ms) \{ ct_res res; if (ct_rt_active()) \{ ctron_rt_join_key((void*)t); t->joined = 1; ct_task_seg_free(t); if (t->state == 2) \{ res.variant = 1; res.v = (ct_i)(long)\"task panic\"; } else \{ res.variant = 0; res.v = t->result; } return res; } struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_sec += ms / 1000; ts.tv_nsec += (ms % 1000) * 1000000L; if (ts.tv_nsec >= 1000000000L) \{ ts.tv_sec += 1; ts.tv_nsec -= 1000000000L; } pthread_mutex_lock(&t->done_mu); while (!t->done) \{ ct_task* self2 = ct_task_self(); ct_scope* sc2 = self2 ? self2->scope : 0; if (sc2 && sc2->cancelled) \{ pthread_mutex_unlock(&t->done_mu); res.variant = 1; res.v = (ct_i)(long)\"ScopeCancelled\"; return res; } int wr = pthread_cond_timedwait(&t->done_cv, &t->done_mu, &ts); if (wr != 0) \{ break; } } pthread_mutex_unlock(&t->done_mu); if (!t->done) \{ res.variant = 1; res.v = (ct_i)(long)\"JoinTimeout\"; return res; } t->joined = 1; ct_task_seg_free(t); if (t->state == 2) \{ res.variant = 1; res.v = (ct_i)(long)\"task panic\"; } else \{ res.variant = 0; res.v = t->result; } return res; }")
            // G3-W3:scope.cancel()——cancelled 置位+广播;阻塞 recv/send/join_t 等待点即时 Err
            println("static void ct_scope_cancel(ct_scope* sc) \{ if (!sc) \{ return; } sc->cancelled = 1; ct_cancel_broadcast(); }")
            // G1-T3 通道边界值语义(Str 元素):send 拷入 malloc 中转块(线程安全,
            // 任务段指针不出境),recv 拷入接收方分配域(任务=本段,主线程=GC 堆/
            // 全局)后 free 中转块——中转块对 GC 不可见,「pop→使用」窗口结构性消失;
            // 消费即释放=流式长跑有界。is_str 旗=Channel[Str/String] 构造位传入
            // (trans_expr ctor 臂;码表 "s" 同罩 Str 与 String)。
            println("static const char* ct_xsend_str(const char* s) \{ size_t n = s ? strlen(s) + 1 : 1; char* r = (char*)malloc(n); if (!r) \{ ctron_panic(\"chan send OOM\"); } if (s) \{ memcpy(r, s, n); } else \{ r[0] = 0; } return r; }")
            println("static const char* ct_xrecv_str(const char* s) \{ size_t n = strlen(s) + 1; char* r; if (ct_tls_arn || !ct_gc_enabled()) \{ r = (char*)ctron_amalloc(n); } else \{ r = (char*)ct_gc_alloc(n); } memcpy(r, s, n); free((void*)s); return r; }")
            println("static ct_chan* ct_ch_make(int cap, int is_str) \{ if (cap < 1) \{ cap = 1; } ct_chan* c = (ct_chan*)calloc(1, sizeof(ct_chan)); pthread_mutex_init(&c->mu, 0); pthread_cond_init(&c->cv_full, 0); pthread_cond_init(&c->cv_empty, 0); c->cap = cap; c->is_str = is_str; c->buf = (ct_i*)calloc((size_t)cap, sizeof(ct_i)); ct_ch_reg(c); return c; }")
            println("static ct_res ct_ch_send(ct_chan* c, ct_i v) \{ ct_res res; if (c->is_str) \{ v = (ct_i)(long)ct_xsend_str((const char*)(long)v); } pthread_mutex_lock(&c->mu); while (c->cnt == c->cap) \{ ct_task* _ct = ct_task_self(); ct_scope* sc = _ct ? _ct->scope : 0; if (sc && sc->cancelled) \{ pthread_mutex_unlock(&c->mu); if (c->is_str) \{ free((void*)(long)v); } res.variant = 1; res.v = (ct_i)(long)\"ScopeCancelled\"; return res; } if (ct_rt_coro_ctx()) \{ pthread_mutex_unlock(&c->mu); ctron_rt_park(); pthread_mutex_lock(&c->mu); continue; } pthread_cond_wait(&c->cv_full, &c->mu); } c->buf[c->tail] = v; c->tail = (c->tail + 1) % c->cap; c->cnt += 1; pthread_cond_broadcast(&c->cv_empty); pthread_mutex_unlock(&c->mu); if (ct_rt_active()) ctron_rt_cancel_wake_all(); res.variant = 0; res.v = 0; return res; }")
            println("static ct_res ct_ch_recv(ct_chan* c) \{ ct_res res; pthread_mutex_lock(&c->mu); while (c->cnt == 0) \{ ct_task* _ct = ct_task_self(); ct_scope* sc = _ct ? _ct->scope : 0; if (sc && sc->cancelled) \{ pthread_mutex_unlock(&c->mu); res.variant = 1; res.v = (ct_i)(long)\"ScopeCancelled\"; return res; } if (ct_rt_coro_ctx()) \{ pthread_mutex_unlock(&c->mu); ctron_rt_park(); pthread_mutex_lock(&c->mu); continue; } pthread_cond_wait(&c->cv_empty, &c->mu); } res.variant = 0; res.v = c->buf[c->head]; if (c->is_str) \{ res.v = (ct_i)(long)ct_xrecv_str((const char*)(long)res.v); } c->head = (c->head + 1) % c->cap; c->cnt -= 1; pthread_cond_broadcast(&c->cv_full); pthread_mutex_unlock(&c->mu); if (ct_rt_active()) ctron_rt_cancel_wake_all(); return res; }")
            // G3-W3:recv_t 超时形——timedwait 正典;Str 载荷边界拷贝与 recv 同;
            // coro 档停车路径 v0 回落无限等(与 join_t 同口径文档化)
            println("static ct_res ct_ch_recv_t(ct_chan* c, long long ms) \{ ct_res res; struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_sec += ms / 1000; ts.tv_nsec += (ms % 1000) * 1000000L; if (ts.tv_nsec >= 1000000000L) \{ ts.tv_sec += 1; ts.tv_nsec -= 1000000000L; } pthread_mutex_lock(&c->mu); while (c->cnt == 0) \{ ct_task* _ct = ct_task_self(); ct_scope* sc = _ct ? _ct->scope : 0; if (sc && sc->cancelled) \{ pthread_mutex_unlock(&c->mu); res.variant = 1; res.v = (ct_i)(long)\"ScopeCancelled\"; return res; } if (ct_rt_coro_ctx()) \{ pthread_mutex_unlock(&c->mu); ctron_rt_park(); pthread_mutex_lock(&c->mu); continue; } int wr = pthread_cond_timedwait(&c->cv_empty, &c->mu, &ts); if (wr != 0 && c->cnt == 0) \{ pthread_mutex_unlock(&c->mu); res.variant = 1; res.v = (ct_i)(long)\"RecvTimeout\"; return res; } } res.variant = 0; res.v = c->buf[c->head]; if (c->is_str) \{ res.v = (ct_i)(long)ct_xrecv_str((const char*)(long)res.v); } c->head = (c->head + 1) % c->cap; c->cnt -= 1; pthread_cond_broadcast(&c->cv_full); pthread_mutex_unlock(&c->mu); if (ct_rt_active()) ctron_rt_cancel_wake_all(); return res; }")
            println("static inline int32_t ct_bit_shl_i32(int32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return (int32_t)(((uint32_t)a) << n); }")
            println("static inline uint32_t ct_bit_shl_u32(uint32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return (uint32_t)(((uint32_t)a) << n); }")
            println("static inline int64_t ct_bit_shl_i64(int64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return (int64_t)(((uint64_t)a) << n); }")
            println("static inline uint64_t ct_bit_shl_u64(uint64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return (uint64_t)(((uint64_t)a) << n); }")
            println("static inline int32_t ct_bit_shr_i32(int32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return a >> n; }")
            println("static inline uint32_t ct_bit_shr_u32(uint32_t a, int32_t n) \{ if (n < 0 || n >= 32) \{ ctron_panic(\"bit shift range\"); } return (uint32_t)(((uint32_t)a) >> n); }")
            println("static inline int64_t ct_bit_shr_i64(int64_t a, int32_t n) \{ if (n < 0 || n >= 64) \{ ctron_panic(\"bit shift range\"); } return a >> n; }")
