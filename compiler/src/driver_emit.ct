// =====================================================================
// driver_emit.ct —— 编译器入口(代码生成模式)
// parse(锚 read_file("ANCHORINPUT"),构建脚本换靶)→ 发射等价 C 到 stdout;
// 产物自带 main(argc,argv):`<bin> run <file>` 可覆盖输入锚(通用二进制)。
// =====================================================================

fn main() -> I32 {
    let src = read_file("ANCHORINPUT")
    match src {
        Some(s) => {
            var toks = List[Str]()
            var lns = List[Str]()
            scan(s, toks, lns)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur, lns)
            // 模块加载器(§2):use 解析 → 可见性 → 合并;无 use 时为无感直通
            var ldiags = List[Str]()
            var lstack = List[Str]()
            // 发射驱动无 path 回退:ctron_entry 为空时加载器目录退化为 "."(无 use 源无感;
            // 多文件包发射用 bin/ctron-emit,文档化限制)
            var epath = ctron_entry()
            lstack.push(epath)
            file = pkg_load_use(file, pkg_dir_of(epath), lstack, ldiags)
            if ldiags.len > 0 {
                var li: I32 = 0
                while li < ldiags.len {
                    println(ldiags[li])
                    li += 1
                }
                return 1
            }
            // CLI 化:先取输入 main 的锚字面量(作默认值),再把调用点换为标记
            var anch = ct_find_main_anchor(file)
            file = ct_swap_anchor(file)
            println("#include <stdio.h>")
            println("#include <stdint.h>")
            println("#include <string.h>")
            println("#include <stdlib.h>")
            println("#include <dirent.h>")
            println("static char* ctron_abase = 0;")
            println("static size_t ctron_aoff = 0;")
            println("static size_t ctron_acap = 0;")
            println("static void* ctron_amalloc(size_t n) \{ n = (n + 15) & ~(size_t)15; if (ctron_aoff + n > ctron_acap) \{ size_t nc = ctron_acap ? ctron_acap * 2 : (size_t)4194304; while (nc < ctron_aoff + n) \{ nc = nc * 2; } ctron_abase = (char*)malloc(nc); ctron_aoff = 0; ctron_acap = nc; } void* p = ctron_abase + ctron_aoff; ctron_aoff += n; return p; }")
            // 运行时辅助:容器/单元格/字节域/读文件(必须先于使用它的原型)
            println("typedef struct \{ unsigned long long magic; char** items; int n; int cap; } ctron_list;")
            println("typedef struct \{ int32_t v; } ctron_cell;")
            println("static ctron_list* ctron_list_new(void) \{ ctron_list* l = (ctron_list*)ctron_amalloc(sizeof(ctron_list)); l->magic = 0x4354726F6E4C7374ULL; l->items = 0; l->n = 0; l->cap = 0; return l; }")
            println("static int ctron_len(const void* p) \{ const char* s = (const char*)p; unsigned long long m = 0; if (strlen(s) >= 8) \{ memcpy(&m, s, 8); if (m == 0x4354726F6E4C7374ULL) \{ return ((const ctron_list*)p)->n; } } return (int)strlen(s); }")
            println("static void ctron_list_push(ctron_list* l, const char* s) \{ if (l->n == l->cap) \{ int nc = l->cap ? l->cap * 2 : 8; char** ni = (char**)ctron_amalloc(sizeof(char*) * (size_t)nc); int q = 0; while (q < l->n) \{ ni[q] = l->items[q]; q += 1; } l->items = ni; l->cap = nc; } l->items[l->n] = (char*)s; l->n += 1; }")
            println("static ctron_cell* ctron_cell_new(int32_t v0) \{ ctron_cell* c = (ctron_cell*)ctron_amalloc(sizeof(ctron_cell)); c->v = v0; return c; }")
            println("static void ctron_print_i32(int32_t v) \{ printf(\"%d" + bs() + "n\", v); }")
            println("static const char* ctron_str_concat(const char* a, const char* b) \{ size_t la = strlen(a), lb = strlen(b); char* r = (char*)ctron_amalloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb); r[la + lb] = 0; return r; }")
            println("static const char* ctron_i32_to_string(int32_t v) \{ char* r = (char*)ctron_amalloc(16); snprintf(r, 16, \"%d\", v); return r; }")
            println("static const char* ctron_i64_to_string(int64_t v) \{ char* r = (char*)ctron_amalloc(32); snprintf(r, 32, \"%lld\", (long long)v); return r; }")
            println("static void ctron_print_i64(int64_t v) \{ printf(\"%lld" + bs() + "n\", (long long)v); }")
            println("static int ctron_byte_at(const char* s, int i) \{ return (int)(unsigned char)s[i]; }")
            println("static const char* ctron_byte_slice(const char* s, int a, int b) \{ int n = b - a; char* r = (char*)ctron_amalloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }")
            println("static const char* ctron_read_file(const char* path) \{ FILE* f = fopen(path, \"rb\"); if (!f) \{ return NULL; } fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET); char* r = (char*)ctron_amalloc((size_t)n + 1); size_t rd = fread(r, 1, (size_t)n, f); r[rd] = 0; fclose(f); return r; }")
            println("static const char* ctron_read_dir(const char* path) \{ DIR* d = opendir(path); if (!d) \{ return NULL; } size_t cap = 256; size_t len = 0; char* r = (char*)malloc(cap); r[0] = 0; struct dirent* de; while ((de = readdir(d)) != NULL) \{ if (strcmp(de->d_name, \".\") == 0 || strcmp(de->d_name, \"..\") == 0) \{ continue; } size_t bl = strlen(de->d_name); while (len + bl + 2 > cap) \{ cap *= 2; } char* nb = (char*)realloc(r, cap); r = nb; memcpy(r + len, de->d_name, bl); len += bl; r[len] = 10; len += 1; } closedir(d); r[len] = 0; return r; }")
            println("static void ctron_panic(const char* m) \{ fprintf(stderr, \"%s" + bs() + "n\", m); exit(1); }")
            println("static const char* ctron_cli_input = NULL;")
            println("static const char* ctron_entry(void) \{ return ctron_cli_input ? ctron_cli_input : \"\"; }")
            println("static const char* ctron_anchor = \"" + ct_cstr(anch) + "\";")
            println("static const char* ctron_read_file_cli(const char* p) \{ if (ctron_cli_input) \{ return ctron_read_file(ctron_cli_input); } return ctron_read_file(p); }")
            // 用户 struct 值类型(§6.1):typedef 先于原型与函数体
            var si: I32 = 1
            while si < file.len {
                var sd = file[si]
                if sd[0] == "Struct" {
                    var fs = sd[4]
                    var line = "typedef struct \{ "
                    var fj: I32 = 1
                    while fj < fs.len {
                        var fd = fs[fj]
                        line = line + ct_ctype(ct_ty_code(fd[3], file)) + " " + fd[2] + "; "
                        fj += 1
                    }
                    line = line + "} t_" + sd[1] + ";"
                    println(line)
                }
                si += 1
            }
            // 原型前置:C 需先声明后用(语料存在前向引用/递归);extern 声明仅原型(§9.6)
            var pj: I32 = 1
            while pj < file.len {
                var pd = file[pj]
                if pd[0] == "FnExt" {
                    println("static " + ct_ctype(ct_fn_ret(file, pd[1])) + " " + pd[1] + "(" + ct_params_str(pd, file) + ");")
                } else if pd[0] == "Fn" {
                    println("static " + ct_ctype(ct_fn_ret(file, pd[1])) + " t_" + pd[1] + "(" + ct_params_str(pd, file) + ");")
                }
                pj += 1
            }
            var di: I32 = 1
            var hasmain = false
            var ntest: I32 = 0
            var testcalls = ""
            while di < file.len {
                var d = file[di]
                if d[0] == "Fn" {
                    if d[1] == "main" {
                        hasmain = true
                    }
                    ct_fn(d, file)
                } else if d[0] == "Test" {
                    // test 块 → int fn:断言失败 return 1(语句位 assert 发射),成功 return 0
                    println("static int32_t t_test_" + ntest.to_string() + "(void) \{")
                    var tenv = ct_stmts(d[2], List[Str](), file, "", List[Str]())
                    var tl = d[2][d[2].len - 1]
                    if tl[0] != "None" {
                        var es = List[Str]()
                        es.push("Expr")
                        es.push(tl)
                        ct_stmt(es, tenv, file, List[Str]())
                    }
                    println("return 0;")
                    println("}")
                    testcalls = testcalls + "if (t_test_" + ntest.to_string() + "()) \{ return 1; } "
                    ntest += 1
                }
                di += 1
            }
            if hasmain {
                println("int main(int argc, char** argv) \{ if (argc >= 3 && strcmp(argv[1], \"run\") == 0) \{ ctron_cli_input = argv[2]; } return (int)t_main(); }")
            } else {
                println("int main(int argc, char** argv) \{ " + "if (argc >= 3 && strcmp(argv[1], \"run\") == 0) \{ ctron_cli_input = argv[2]; } " + testcalls + "return 0; " + "}")
            }
            return 0
        }
        None => {
            println("read-failed")
            return 1
        }
    }
}
