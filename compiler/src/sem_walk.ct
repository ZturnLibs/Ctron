// =====================================================================
// sem_walk.ct —— 语义树上行走:W8020 must-use / E4030 no_spawn / E3020 channel 元素非 Send
// walk_e/walk_b 携带 fns/rets/ns(no_spawn 上下文)下钻,返回诊断行;归属 sem_walk2 全集。
// =====================================================================
// ---------------- W8020 must-use / E4030 no_spawn(树上行走) ----------------
fn is_opt_ret(ty: List[Str]) -> Bool {
    if ty[0] == "Optional" { return true }
    if ty[0] == "Named" {
        var h = ty[1]
        if or2(h == "Option", h == "Result") { return true }
    }
    // 泛型形 Result[I32, Str]:TypeArgs(Named(Result), 实参…) —— T04 补
    if ty[0] == "TypeArgs" && ty.len > 1 && ty[1][0] == "Named" {
        if or2(ty[1][1] == "Option", ty[1][1] == "Result") { return true }
    }
    return false
}

// W8040:遮蔽前奏符号(名单对齐 C 宿主 is_prelude_name/R 线 register_prelude)
fn is_prelude_name(n: Str) -> Bool {
    if or2(n == "I8", or2(n == "I16", or2(n == "I32", or2(n == "I64", n == "ISize")))) { return true }
    if or2(n == "U8", or2(n == "U16", or2(n == "U32", or2(n == "U64", n == "USize")))) { return true }
    if or2(n == "F32", or2(n == "F64", or2(n == "Bool", or2(n == "Str", or2(n == "String", or2(n == "Void", n == "Never")))))) { return true }
    if or2(n == "TaskPanic", or2(n == "Channel", or2(n == "List", or2(n == "Map", or2(n == "Set", n == "Box"))))) { return true }
    if or2(n == "StringBuilder", or2(n == "Atomic", or2(n == "Global", or2(n == "Mutex", or2(n == "Sender", or2(n == "Receiver", n == "Task")))))) { return true }
    if or2(n == "Scope", or2(n == "Arena", or2(n == "Region", or2(n == "Pool", or2(n == "ArenaList", or2(n == "Simd", n == "AnyError")))))) { return true }
    if or2(n == "Parallel", or2(n == "Path", or2(n == "Bytes", or2(n == "Option", or2(n == "Result", n == "Bit"))))) { return true }
    if or2(n == "Some", or2(n == "None", or2(n == "Ok", n == "Err"))) { return true }
    if or2(n == "Error", or2(n == "Show", or2(n == "Eq", or2(n == "Drop", or2(n == "Clone", or2(n == "Hash", n == "Iter")))))) { return true }
    if or2(n == "Cap", or2(n == "Clock", or2(n == "Fs", or2(n == "Net", n == "Log")))) { return true }
    return false
}

// walk_block/Expr:返回诊断行;ns = no_spawn 上下文
fn is_cmp_op(op: Str) -> Bool {
    return or2(op == "Lt", or2(op == "Gt", or2(op == "Le", or2(op == "Ge", or2(op == "Eq", op == "Ne")))))
}

// 该名是否为带 fn 类型形参的 extern "c" 声明(E4042 门控;闭包实参冷路径才调用)
fn ext_cb_target(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "FnExt" && d[1] == nm {
            var ps = d[3]
            var k: I32 = 1
            while k < ps.len {
                if ps[k][0] == "Param" && ps[k][3][0] == "FnType" {
                    return true
                }
                k += 1
            }
            return false
        }
        i += 1
    }
    return false
}
fn walk_e(file: List[Str], e: List[Str], ns: Bool, fns: List[Str], rets: List[Str], out: List[Str]) {
    var t = e[0]
    if t == "Call" {
        var cal = e[1]
        // E4030:.spawn 调用
        if ns && cal[0] == "Member" && cal[3] == "spawn" {
            out.push(diag_render0("E4030", nline(e)))
        }
        // W8020:丢弃 Option/Result 返回值(仅 Expr 语句层,见 stmt)
        if cal[0] == "TypeArgs" && cal[1].len > 0 && cal[1][0] == "Ident" && cal[1][1] == "Channel" {
            var ag2 = cal[2]
            if ag2.len > 1 {
                var el = ag2[1]
                if !send_of(file, el, 0) {
                    out.push(diag_render0("E3020.elem", nline(e)))
                }
            }
        }
        // E4042(§9.6 v0.6):捕获闭包实参传入 extern "c" 的 fn 指针形参——C 回调
        // 无 env 槽,闭包上下文无法跨边界;仅裸 fn 名(无捕获)可作 C-ABI 回调。
        // 门控:任一实参为 Closure 字面量才扫 extern 表(冷路径,零摊销)。
        if cal[0] == "Ident" {
            var agx = e[2]
            var hasclo = false
            var qi: I32 = 1
            while qi < agx.len && !hasclo {
                if agx[qi][0] == "Closure" {
                    hasclo = true
                }
                qi += 1
            }
            if hasclo && ext_cb_target(file, cal[1]) {
                out.push(diag_render1("E4042", nline(e), cal[1]))
            }
        }
        walk_e(file, cal, ns, fns, rets, out)
        var ag = e[2]
        var i: I32 = 1
        while i < ag.len {
            walk_e(file, ag[i], ns, fns, rets, out)
            i += 1
        }
        return
    }
    if t == "Member" {
        walk_e(file, e[1], ns, fns, rets, out)
        return
    }
    if t == "Binary" {
        // E1001:比较运算符不可链(a < b < c;钉子 §2,镜像 C 词法同款拦截)
        if is_cmp_op(e[1]) && e[2][0] == "Binary" && is_cmp_op(e[2][1]) {
            out.push("E1001@" + nline(e) + "(parse): " + diag_text0("E1001.chain"))
        }
        walk_e(file, e[2], ns, fns, rets, out)
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Unary" {
        walk_e(file, e[2], ns, fns, rets, out)
        return
    }
    if t == "Range" {
        walk_e(file, e[2], ns, fns, rets, out)
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Index" {
        walk_e(file, e[1], ns, fns, rets, out)
        walk_e(file, e[2], ns, fns, rets, out)
        return
    }
    if t == "TypeArgs" {
        walk_e(file, e[1], ns, fns, rets, out)
        return
    }
    if t == "Try" {
        walk_e(file, e[1], ns, fns, rets, out)
        return
    }
    if or2(t == "TupleE", t == "ArrLit") {
        var i2: I32 = 1
        while i2 < e.len {
            walk_e(file, e[i2], ns, fns, rets, out)
            i2 += 1
        }
        return
    }
    if t == "BlockExpr" {
        walk_b(file, e[1], ns, fns, rets, out, false)
        return
    }
    if t == "If" {
        walk_e(file, e[1], ns, fns, rets, out)
        walk_b(file, e[2], ns, fns, rets, out, false)
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Match" {
        walk_e(file, e[1], ns, fns, rets, out)
        var arms = e[2]
        var i3: I32 = 1
        while i3 < arms.len {
            var a = arms[i3]
            walk_e(file, a[2], ns, fns, rets, out)
            i3 += 1
        }
        return
    }
    if t == "Closure" {
        walk_e(file, e[3], ns, fns, rets, out)
        return
    }
    if t == "Own" {
        walk_b(file, e[2], ns, fns, rets, out, false)
        return
    }
    if t == "Scope" {
        walk_b(file, e[2], ns, fns, rets, out, false)
        return
    }
}

fn w8020_check(file: List[Str], ce: List[Str], fns: List[Str], rets: List[Str], out: List[Str]) {
    if ce[0] != "Call" {
        return
    }
    var cal2 = ce[1]
    if cal2[0] != "Ident" {
        return
    }
    var nm2 = cal2[1]
    var k: I32 = 0
    while k < fns.len {
        if fns[k] == nm2 {
            if is_opt_ret(rets[k]) {
                out.push(diag_render1("W8020", nline(ce), nm2))
            }
            return
        }
        k += 1
    }
}

fn walk_b(file: List[Str], b: List[Str], ns: Bool, fns: List[Str], rets: List[Str], out: List[Str], body: Bool) {
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Return" {
            walk_e(file, st[1], ns, fns, rets, out)
        } else if t == "Let" {
            // W8040:绑定名遮蔽前奏符号(§3.8)
            var lp = st[2]
            if lp[0] == "PatId" && is_prelude_name(lp[1]) {
                out.push(diag_render1("W8040", nline(st), lp[1]))
            }
            walk_e(file, st[4], ns, fns, rets, out)
        } else if t == "While" {
            walk_e(file, st[1], ns, fns, rets, out)
            walk_b(file, st[2], ns, fns, rets, out, false)
        } else if t == "For" {
            walk_e(file, st[2], ns, fns, rets, out)
            walk_b(file, st[3], ns, fns, rets, out, false)
        } else if t == "Assign" {
            walk_e(file, st[3], ns, fns, rets, out)
        } else if t == "Expr" {
            // W8020:丢弃 Option/Result 返回值
            w8020_check(file, st[1], fns, rets, out)
            walk_e(file, st[1], ns, fns, rets, out)
        }
        i += 1
    }
    // 块尾表达式:fn/test 体语境(body)下同判 W8020 —— 值位块(let x = {…}/if 臂)
    // 的尾是块值非丢弃,body=false 不判(T04:此前 fn 体尾调用漏扫,与 C 宿主同修)
    if body {
        w8020_check(file, b[b.len - 1], fns, rets, out)
    }
    walk_e(file, b[b.len - 1], ns, fns, rets, out)
}
