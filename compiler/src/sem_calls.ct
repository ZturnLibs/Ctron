// =====================================================================
// sem_calls.ct —— E2020:调用目标解析(bare 调用面,callable/value 双名集)
// interp_hit 插值原文引用粗判;sem_calls_all 全文件扫调用节点。
// =====================================================================
// 插值原文是否引用绑定名(粗粒度:子串命中即算使用)
fn interp_hit(txt: Str, nm: Str) -> Bool {
    var nn = nm.len
    if nn == 0 {
        return false
    }
    var hn = txt.len
    var i: I32 = 0
    while i + nn <= hn {
        var k: I32 = 0
        var ok = true
        while k < nn {
            if byte_at(txt, i + k) != byte_at(nm, k) {
                ok = false
            }
            k += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}

fn sem_calls_all(file: List[Str], diags: List[Str], prof: Str) {
    var fns = List[Str]()
    var ars = List[Str]()
    var rets = List[Str]()
    var prms = List[Str]()
    var stN = List[Str]()
    var stT = List[Str]()
    var vars = List[Str]()
    var varAr = List[Str]()
    var enums = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if or2(t == "Fn", or2(t == "FnC", or2(t == "FnPub", or2(t == "Method", t == "FnExt")))) {
            fns.push(d[1])
            ars.push((d[3].len - 1).to_string())
            rets.push(d[4])
            prms.push(d[3])
        } else if t == "Static" {
            stN.push(d[1])
            stT.push(d[3])
        } else if t == "Const" {
            stN.push(d[1])
            stT.push(d[2])
        } else if t == "Enum" {
            enums.push(d[1])
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                var v = vs[j]
                vars.push(v[1])
                varAr.push((v[2].len - 1).to_string())
                j += 1
            }
        }
        i += 1
    }
    var tpars = List[Str]()
    var i0: I32 = 1
    while i0 < file.len {
        var d0 = file[i0]
        if or2(d0[0] == "Fn", or2(d0[0] == "FnC", or2(d0[0] == "FnPub", or2(d0[0] == "Method", d0[0] == "Class")))) {
            var tps = d0[2]
            var q0: I32 = 1
            while q0 < tps.len {
                tpars.push("n:" + tps[q0][1])
                q0 += 1
            }
        }
        i0 += 1
    }
    var prel = List[Str]()
    prel.push("print")
    prel.push("println")
    prel.push("panic")
    prel.push("assert")
    prel.push("assert_eq")
    prel.push("assert_ne")
    prel.push("read_file")
    prel.push("read_dir")
    prel.push("fs_exists")
    prel.push("fs_write")
    prel.push("fs_delete")
    prel.push("byte_at")
    prel.push("byte_slice")
    prel.push("Some")
    prel.push("None")
    prel.push("Ok")
    prel.push("Err")
    prel.push("fmt")
    prel.push("char_len")
    prel.push("Box")
    prel.push("List")
    prel.push("String")
    prel.push("Channel")
    prel.push("Mutex")
    prel.push("Atomic")
    prel.push("Global")
    prel.push("Task")
    prel.push("Scope")
    prel.push("Simd")
    prel.push("Option")
    prel.push("Result")
    prel.push("AnyError")
    prel.push("Show")
    prel.push("Eq")
    prel.push("Error")
    prel.push("Cap")
    prel.push("Clone")
    prel.push("Hash")
    prel.push("Iter")
    prel.push("parallel")
    prel.push("arena")
    if seq2(prof, "web") {
        // web 档(§9.2):stdweb.dom 内建命名空间(dom.set_title/dom.title)→ 值名集
        vars.push("dom")
    }
    var lets = List[Str]()
    var reads = List[Str]()
    var isrc = List[Str]()
    var tc = List[Str]()
    tc.push(fns)
    tc.push(ars)
    tc.push(rets)
    tc.push(prms)
    tc.push(stN)
    tc.push(stT)
    tc.push(vars)
    tc.push(varAr)
    tc.push(enums)
    tc.push(lets)
    tc.push(reads)
    tc.push(isrc)
    tc.push(prel)
    tc.push(tpars)
    i = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if or2(t == "Fn", or2(t == "FnC", or2(t == "FnPub", or2(t == "Method", t == "FnExt")))) {
            var loc = List[Str]()
            var envT = List[Str]()
            fn_params_push(d[3], loc, envT)
            var wlets = List[Str]()
            var wreads = List[Str]()
            var wisrc = List[Str]()
            var tcw = List[Str]()
            var q: I32 = 0
            while q < 9 {
                tcw.push(tc[q])
                q += 1
            }
            tcw.push(wlets)
            tcw.push(wreads)
            tcw.push(wisrc)
            tcw.push(prel)
            tcw.push(tpars)
            tcb(file, d[5], tcw, loc, envT, d[4], diags)
            var u: I32 = 0
            while u < wlets.len {
                var un = wlets[u]
                if !in_list(wreads, un) {
                    var hit = false
                    var w: I32 = 0
                    while w < wisrc.len && !hit {
                        if interp_hit(wisrc[w], un) {
                            hit = true
                        }
                        w += 1
                    }
                    if !hit {
                        var isu = false
                        if un.len > 0 && byte_at(un, 0) == 95 {
                            isu = true
                        }
                        if !isu {
                            diags.push("W8030: 未使用绑定(unused):" + un)
                        }
                    }
                }
                u += 1
            }
        } else if t == "Impl" {
            var its = d[4]
            var mi: I32 = 1
            while mi < its.len {
                var md = its[mi]
                if md[0] == "Method" {
                    var mloc = List[Str]()
                    var menv = List[Str]()
                    fn_params_push(md[3], mloc, menv)
                    tcb(file, md[5], tc, mloc, menv, md[4], diags)
                }
                mi += 1
            }
        } else if t == "Test" {
            tcb(file, d[2], tc, List[Str](), List[Str](), List[Str](), diags)
        }
        i += 1
    }
}
