// =====================================================================
// parse.ct —— 解析器:token 串 → 结构化文件节点树
// 节点 = List[Str]:child[0] = tag,其后按模式放标量 Str 或子节点(List)。
// 接口:p_file(toks, cur, lns) → 文件节点树;内部 p_* 递归下降 + 停滞守卫。
// =====================================================================
// ---------------- 树节点 ----------------
fn mk(t: Str) -> List[Str] {
    var n = List[Str]()
    n.push(t)
    return n
}

// 行号戳(lns 与 toks 平行,scan 产出):把行号串追加为节点末槽
fn nstamp(n: List[Str], line: Str) {
    n.push(line)
}

// ---------------- 解析(建树):p_file(toks, cur, lns) → 文件节点树 ----------------
fn qtext(raw: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = raw.len
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 117 {
            var hx = ""
            var pp = j + 2
            var mapped = false
            if pp < n && byte_at(raw, pp) == 123 {
                pp += 1
                while pp < n && byte_at(raw, pp) != 125 {
                    hx = hx + byte_slice(raw, pp, pp + 1)
                    pp += 1
                }
                if hx == "4E2D" {
                    out = out + "中"
                    mapped = true
                }
            }
            if mapped {
                j = pp + 1
            } else {
                out = out + byte_slice(raw, j, j + 2)
                j += 2
            }
        } else if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 123 {
            out = out + "\{"
            j += 2
        } else {
            out = out + byte_slice(raw, j, j + 1)
            j += 1
        }
    }
    return out
}

fn parts_of(raw: Str) -> List[Str] {
    var np = mk("Parts")
    var k: I32 = 0
    var n = raw.len
    var j: I32 = 0
    var ts: I32 = 0
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 2 <= n {
            if j + 3 < n && byte_at(raw, j + 1) == 117 && byte_at(raw, j + 2) == 123 {
                var q = j + 3
                while q < n && byte_at(raw, q) != 125 { q += 1 }
                if q < n { j = q + 1 } else { j += 2 }
            } else {
                j += 2
            }
        } else if c == 123 {
            if j > ts {
                var tx = mk("Text")
                tx.push(qtext(byte_slice(raw, ts, j)))
                np.push(tx)
                k += 1
            }
            var d: I32 = 1
            var p = j + 1
            while d > 0 && p < n {
                var cp = byte_at(raw, p)
                if cp == 123 { d += 1 }
                if cp == 125 { d -= 1 }
                p += 1
            }
            var ix = mk("Interp")
            ix.push(qtext(byte_slice(raw, j + 1, p - 1)))
            np.push(ix)
            k += 1
            j = p
            ts = p
        } else {
            j += 1
        }
    }
    if n > ts {
        var ty = mk("Text")
        ty.push(qtext(byte_slice(raw, ts, n)))
        np.push(ty)
        k += 1
    }
    return np
}

fn p_and(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_cmp(toks, cur, lns, al)
    var go = true
    while go {
        if tok(toks, cur) == "&&" {
            adv(cur)
            var r = p_cmp(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push("AndAnd")
            nb.push(l)
            nb.push(r)
            l = nb
        } else { go = false }
    }
    return l
}

fn p_cmp(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_rng(toks, cur, lns, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "==" { op = "Eq" }
        if t == "!=" { op = "Ne" }
        if t == "<" { op = "Lt" }
        if t == ">" { op = "Gt" }
        if t == "<=" { op = "Le" }
        if t == ">=" { op = "Ge" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_rng(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_rng(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var f = p_add(toks, cur, lns, al)
    var t = tok(toks, cur)
    if or2(t == "..", t == "..=") {
        adv(cur)
        var to = p_add(toks, cur, lns, al)
        var nb = mk("Range")
        if t == "..=" {
            nb.push("true")
        } else {
            nb.push("false")
        }
        nb.push(f)
        nb.push(to)
        return nb
    }
    return f
}

fn p_add(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_mul(toks, cur, lns, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "+" { op = "Add" }
        if t == "-" { op = "Sub" }
        if t == "+%" { op = "WrapAdd" }
        if t == "-%" { op = "WrapSub" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_mul(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_mul(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_una(toks, cur, lns, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "*" { op = "Mul" }
        if t == "/" { op = "Div" }
        if t == "%" { op = "Mod" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_una(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_una(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var t = tok(toks, cur)
    if t == "-" {
        adv(cur)
        var e = p_una(toks, cur, lns, al)
        var nu = mk("Unary")
        nu.push("Neg")
        nu.push(e)
        return nu
    }
    if t == "!" {
        adv(cur)
        var e = p_una(toks, cur, lns, al)
        var nu = mk("Unary")
        nu.push("Not")
        nu.push(e)
        return nu
    }
    return p_post(toks, cur, lns, al)
}

fn p_post(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var e = p_pri(toks, cur, lns, al)
    var go = true
    while go {
        while tok(toks, cur) == "NL" && toks[cur.load() + 1] == "." {
            adv(cur)
        }
        var t = tok(toks, cur)
        var ln0 = lns[cur.load()]
        if t == "(" {
            adv(cur)
            var ag = mk("Args")
            var more = true
            while more {
                if tok(toks, cur) == ")" {
                    more = false
                } else {
                    ag.push(p_stmt_expr(toks, cur, lns, "1"))
                    if tok(toks, cur) == "," {
                        adv(cur)
                    } else {
                        more = false
                    }
                }
            }
            adv(cur)
            var cl = mk("Call")
            cl.push(e)
            cl.push(ag)
            nstamp(cl, ln0)
            e = cl
        } else if t == "." {
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            var mb = mk("Member")
            mb.push(e)
            var mbline = ln0
            if is_digit(byte_at(nm, 0)) {
                mb.push("TIdx")
                mb.push(num_text(nm))
            } else {
                mb.push("Nm")
                mb.push(nm)
            }
            nstamp(mb, mbline)
            e = mb
        } else if t == "[" {
            var d: I32 = 1
            var q = cur.load() + 1
            var hascom = false
            while d > 0 {
                var tk2 = toks[q]
                if tk2 == "[" { d += 1 }
                if tk2 == "]" { d -= 1 }
                if tk2 == "," && d == 1 { hascom = true }
                q += 1
            }
            var nx = toks[q]
            var ta = false
            if nx == "(" { ta = true }
            if or2(al == "1", false) && nx == "\{" { ta = true }
            if nx == "." && hascom { ta = true }
            if ta {
                adv(cur)
                var ag = mk("TArgs2")
                var more = true
                while more {
                    if tok(toks, cur) == "]" { more = false } else {
                        var at = tok(toks, cur)
                        if is_digit(byte_at(at, 0)) {
                            var cv = mk("ComptimeVal")
                            cv.push(num_text(at))
                            ag.push(cv)
                            adv(cur)
                        } else {
                            ag.push(p_typ(toks, cur, lns))
                        }
                        if tok(toks, cur) == "," { adv(cur) } else { more = false }
                    }
                }
                adv(cur)
                var tg = mk("TypeArgs")
                tg.push(e)
                tg.push(ag)
                e = tg
            } else {
                adv(cur)
                var ix = p_stmt_expr(toks, cur, lns, "1")
                adv(cur)
                var inode = mk("Index")
                inode.push(e)
                inode.push(ix)
                e = inode
            }
        } else if t == "?" {
            adv(cur)
            var tr = mk("Try")
            tr.push(e)
            nstamp(tr, ln0)
            e = tr
        } else {
            go = false
        }
    }
    return e
}

fn p_pri(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var t = tok(toks, cur)
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        var nb = mk("Int")
        var isf = false
        var tx = num_text(t)
        var jj: I32 = 0
        while jj < tx.len {
            var cc = byte_at(tx, jj)
            if or2(cc == 46, or2(cc == 101, cc == 69)) { isf = true }
            jj += 1
        }
        if isf { nb = mk("Float") }
        nb.push(num_text(t))
        nb.push(num_sfx(t))
        return nb
    }
    if t == "if" {
        return p_if(toks, cur, lns)
    }
    if t == "match" {
        return p_match(toks, cur, lns)
    }
    if t == "void" {
        adv(cur)
        return mk("Void")
    }
    if t == "true" {
        adv(cur)
        var bt = mk("Bool")
        bt.push("true")
        return bt
    }
    if t == "false" {
        adv(cur)
        var bf = mk("Bool")
        bf.push("false")
        return bf
    }
    if t == "own" {
        adv(cur)
        adv(cur)
        var an = tok(toks, cur)
        adv(cur)
        adv(cur)
        adv(cur)
        var ow = mk("Own")
        ow.push(an)
        ow.push(p_block(toks, cur, lns))
        return ow
    }
    if t == "|" {
        adv(cur)
        var cl = mk("Closure")
        var cp = mk("CPs")
        var more = true
        while more {
            if tok(toks, cur) == "|" { more = false } else {
                var isv = "false"
                var t0 = tok(toks, cur)
                if t0 == "var" { isv = "true" }
                if or2(t0 == "var", t0 == "let") { adv(cur) }
                var cn = tok(toks, cur)
                adv(cur)
                var cpar = mk("ClosureParam")
                cpar.push(isv)
                cpar.push(cn)
                var ty = mk("None")
                if tok(toks, cur) == ":" {
                    adv(cur)
                    ty = p_typ(toks, cur, lns)
                }
                cpar.push(ty)
                cp.push(cpar)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        var ret = mk("None")
        if tok(toks, cur) == "->" {
            adv(cur)
            ret = p_typ(toks, cur, lns)
        }
        cl.push(cp)
        cl.push(ret)
        cl.push(p_stmt_expr(toks, cur, lns, "1"))
        return cl
    }
    if t == "scope" {
        adv(cur)
        adv(cur)
        adv(cur)
        var pn = tok(toks, cur)
        adv(cur)
        adv(cur)
        var sc = mk("Scope")
        sc.push(pn)
        sc.push(p_block(toks, cur, lns))
        return sc
    }
    if b0 == 34 {
        adv(cur)
        var ns = mk("Str")
        ns.push(parts_of(byte_slice(t, 1, t.len - 1)))
        return ns
    }
    if t == "\{" {
        adv(cur)
        var be = mk("BlockExpr")
        be.push(p_block(toks, cur, lns))
        return be
    }
    if t == "[" {
        adv(cur)
        var al = mk("ArrLit")
        var more = true
        while more {
            if tok(toks, cur) == "]" { more = false } else {
                al.push(p_stmt_expr(toks, cur, lns, "1"))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return al
    }
    if t == "(" {
        adv(cur)
        var e0 = p_or(toks, cur, lns, "1")
        if tok(toks, cur) == "," {
            var tn = mk("TupleE")
            tn.push(e0)
            var more = true
            while more {
                if tok(toks, cur) == "," {
                    adv(cur)
                    tn.push(p_and(toks, cur, lns, "1"))
                } else {
                    more = false
                }
            }
            adv(cur)
            return tn
        }
        adv(cur)
        return e0
    }
    if al == "1" && b0 >= 65 && b0 <= 90 && toks[cur.load() + 1] == "\{" {
        var nm = t
        adv(cur)
        adv(cur)
        var sl = mk("StructLit")
        sl.push(nm)
        var lf = mk("LitFs")
        var more = true
        while more {
            if or2(tok(toks, cur) == "}", tok(toks, cur) == "#EOF") {
                more = false
            } else if tok(toks, cur) == "NL" {
                adv(cur)
            } else {
                var fnm = tok(toks, cur)
                adv(cur)
                adv(cur)
                var fv = mk("LField")
                fv.push(fnm)
                fv.push(p_stmt_expr(toks, cur, lns, "1"))
                lf.push(fv)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        sl.push(lf)
        nstamp(sl, lns[cur.load()])
        return sl
    }
    adv(cur)
    var ni = mk("Ident")
    ni.push(t)
    return ni
}

fn p_tpars(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var tp = mk("TPs")
    var more = true
    while more {
        if tok(toks, cur) == "]" { more = false } else {
            var isc = "false"
            if tok(toks, cur) == "comptime" {
                isc = "true"
                adv(cur)
            }
            var nm = tok(toks, cur)
            adv(cur)
            var tp1 = mk("TPar")
            tp1.push(nm)
            tp1.push(isc)
            var bd = mk("Bounds")
            if tok(toks, cur) == ":" {
                adv(cur)
                var more2 = true
                while more2 {
                    bd.push(tok(toks, cur))
                    adv(cur)
                    if tok(toks, cur) == "+" { adv(cur) } else { more2 = false }
                }
            }
            tp1.push(bd)
            tp.push(tp1)
            if tok(toks, cur) == "," { adv(cur) } else { more = false }
        }
    }
    adv(cur)
    return tp
}

fn p_typ(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var t = tok(toks, cur)
    if t == "(" {
        adv(cur)
        var tt = mk("TupleT")
        var more = true
        while more {
            if tok(toks, cur) == ")" { more = false } else {
                tt.push(p_typ(toks, cur, lns))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return tt
    }
    if t == "&" {
        adv(cur)
        var rf = mk("Ref")
        rf.push(p_typ(toks, cur, lns))
        if tok(toks, cur) == "?" {
            adv(cur)
            var op = mk("Optional")
            op.push(rf)
            return op
        }
        return rf
    }
    if t == "fn" {
        adv(cur)
        var ft = mk("FnT")
        adv(cur)
        var more2 = true
        while more2 {
            if tok(toks, cur) == ")" { more2 = false } else {
                ft.push(p_typ(toks, cur, lns))
                if tok(toks, cur) == "," { adv(cur) } else { more2 = false }
            }
        }
        adv(cur)
        var fret = mk("None")
        if tok(toks, cur) == "->" {
            adv(cur)
            fret = p_typ(toks, cur, lns)
        }
        var ftn = mk("FnType")
        ftn.push(ft)
        ftn.push(fret)
        if tok(toks, cur) == "?" {
            adv(cur)
            var op2 = mk("Optional")
            op2.push(ftn)
            return op2
        }
        return ftn
    }
    var nm = tok(toks, cur)
    adv(cur)
    var nt = mk("Named")
    nt.push(nm)
    var ta = mk("TArgs")
    if tok(toks, cur) == "[" {
        var nx1 = toks[cur.load() + 1]
        var isempty = false
        var single = false
        if nx1 == "]" { isempty = true }
        if !isempty && nx1 != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx1, 0)) { single = true }
        if !isempty && !single {
            adv(cur)
            var more = true
            while more {
                if tok(toks, cur) == "]" { more = false } else {
                    ta.push(p_typ(toks, cur, lns))
                    if tok(toks, cur) == "," { adv(cur) } else { more = false }
                }
            }
            adv(cur)
        }
    }
    nt.push(ta)
    var base = nt
    if tok(toks, cur) == "[" {
        var nx2 = toks[cur.load() + 1]
        var isarr = false
        if nx2 == "]" { isarr = true }
        if nx2 != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx2, 0)) { isarr = true }
        if isarr {
            adv(cur)
            if tok(toks, cur) == "]" {
                adv(cur)
                var sl = mk("Slice")
                sl.push(base)
                base = sl
            } else {
                var sz = p_stmt_expr(toks, cur, lns, "1")
                adv(cur)
                var ar = mk("ArrayT")
                ar.push(base)
                ar.push(sz)
                base = ar
            }
        }
    }
    if tok(toks, cur) == "?" {
        adv(cur)
        var op3 = mk("Optional")
        op3.push(base)
        base = op3
    }
    return base
}

fn p_or(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    var l = p_and(toks, cur, lns, al)
    var go = true
    while go {
        if tok(toks, cur) == "or" {
            adv(cur)
            var r = p_and(toks, cur, lns, al)
            var nb = mk("Binary")
            nb.push("Or")
            nb.push(l)
            nb.push(r)
            l = nb
        } else {
            go = false
        }
    }
    return l
}

fn p_stmt_expr(toks: List[Str], cur: Atomic[I32], lns: List[Str], al: Str) -> List[Str] {
    return p_or(toks, cur, lns, al)
}

fn p_pattern(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var t = tok(toks, cur)
    if t == "_" {
        adv(cur)
        return mk("PatWild")
    }
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        var isf = false
        var tx = num_text(t)
        var jj: I32 = 0
        while jj < tx.len {
            var cc = byte_at(tx, jj)
            if or2(cc == 46, or2(cc == 101, cc == 69)) { isf = true }
            jj += 1
        }
        var np = mk("PatLitI")
        if isf { np = mk("PatLitF") }
        np.push(num_text(t))
        return np
    }
    if b0 == 34 {
        adv(cur)
        var np = mk("PatLitS")
        np.push(qtext(byte_slice(t, 1, t.len - 1)))
        return np
    }
    if t == "true" {
        adv(cur)
        var np = mk("PatLitB")
        np.push("true")
        return np
    }
    if t == "false" {
        adv(cur)
        var np = mk("PatLitB")
        np.push("false")
        return np
    }
    if t == "(" {
        adv(cur)
        var np = mk("PatTup")
        var more = true
        while more {
            if tok(toks, cur) == ")" { more = false } else {
                np.push(p_pattern(toks, cur))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return np
    }
    var nm = t
    adv(cur)
    if tok(toks, cur) == "(" {
        adv(cur)
        var agg = mk("PatAgg")
        agg.push(nm)
        var sub = mk("SubTup")
        var more2 = true
        while more2 {
            if tok(toks, cur) == ")" { more2 = false } else {
                sub.push(p_pattern(toks, cur))
                if tok(toks, cur) == "," { adv(cur) } else { more2 = false }
            }
        }
        adv(cur)
        agg.push(sub)
        return agg
    }
    if tok(toks, cur) == "\{" {
        adv(cur)
        var agg = mk("PatAgg")
        agg.push(nm)
        var sub = mk("SubSt")
        var more3 = true
        while more3 {
            if tok(toks, cur) == "}" { more3 = false } else {
                var fnm = tok(toks, cur)
                adv(cur)
                var pp = mk("None")
                if tok(toks, cur) == ":" {
                    adv(cur)
                    pp = p_pattern(toks, cur)
                }
                var fld = mk("PatFld")
                fld.push(fnm)
                fld.push(pp)
                sub.push(fld)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        agg.push(sub)
        return agg
    }
    if or2(b0 >= 65, false) && b0 <= 90 {
        var agg = mk("PatAgg")
        agg.push(nm)
        agg.push(mk("SubUnit"))
        return agg
    }
    var pi = mk("PatId")
    pi.push(nm)
    return pi
}

fn p_match(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var ln0 = lns[cur.load()]
    adv(cur)
    var nm = mk("Match")
    nm.push(p_stmt_expr(toks, cur, lns, "0"))
    adv(cur)
    var arms = mk("Arms")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" { go = false } else if tok(toks, cur) == "#EOF" { go = false } else {
            var ma = mk("Arm")
            ma.push(p_pattern(toks, cur))
            adv(cur)
            ma.push(p_stmt_expr(toks, cur, lns, "1"))
            arms.push(ma)
        }
    }
    adv(cur)
    nm.push(arms)
    nstamp(nm, ln0)
    return nm
}

fn p_if(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    adv(cur)
    var ni = mk("If")
    ni.push(p_and(toks, cur, lns, "0"))
    adv(cur)
    ni.push(p_block(toks, cur, lns))
    var els = mk("None")
    if tok(toks, cur) == "else" {
        adv(cur)
        if tok(toks, cur) == "if" {
            els = p_if(toks, cur, lns)
        } else {
            adv(cur)
            var be = mk("BlockExpr")
            be.push(p_block(toks, cur, lns))
            els = be
        }
    }
    ni.push(els)
    return ni
}

fn p_block(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var nb = mk("Block")
    var tailSet = false
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var p0 = cur.load()
        var t = tok(toks, cur)
        var ln0 = lns[cur.load()]
        if t == "}" {
            adv(cur)
            go = false
        } else if t == "#EOF" {
            go = false
        } else if t == "return" {
            adv(cur)
            var re = mk("Return")
            var reline = ln0
            var rt = tok(toks, cur)
            if or3(rt == "}", rt == "#EOF", rt == "NL") {
                var rn = mk("None")
                re.push(rn)
            } else {
                re.push(p_stmt_expr(toks, cur, lns, "1"))
            }
            nstamp(re, reline)
            nb.push(re)
        } else if or2(t == "let", t == "var") {
            var isv = "false"
            if t == "var" { isv = "true" }
            adv(cur)
            var pp = p_pattern(toks, cur)
            var ty = mk("None")
            if tok(toks, cur) == ":" {
                adv(cur)
                ty = p_typ(toks, cur, lns)
            }
            adv(cur)
            var lv = mk("Let")
            lv.push(isv)
            var lvline = ln0
            lv.push(pp)
            lv.push(ty)
            lv.push(p_stmt_expr(toks, cur, lns, "1"))
            nstamp(lv, lvline)
            nb.push(lv)
        } else if t == "while" {
            adv(cur)
            var wc = p_stmt_expr(toks, cur, lns, "0")
            adv(cur)
            var wb = p_block(toks, cur, lns)
            var wh = mk("While")
            wh.push(wc)
            wh.push(wb)
            nb.push(wh)
        } else if t == "for" {
            adv(cur)
            var fp = p_pattern(toks, cur)
            adv(cur)
            var it = p_stmt_expr(toks, cur, lns, "0")
            adv(cur)
            var fb = p_block(toks, cur, lns)
            var fo = mk("For")
            fo.push(fp)
            fo.push(it)
            fo.push(fb)
            nb.push(fo)
        } else {
            var e = p_stmt_expr(toks, cur, lns, "1")
            var t2 = tok(toks, cur)
            var op = ""
            if t2 == "=" { op = "Eq" }
            if t2 == "+=" { op = "AddEq" }
            if t2 == "-=" { op = "SubEq" }
            if t2 == "*=" { op = "MulEq" }
            if t2 == "/=" { op = "DivEq" }
            if t2 == "%=" { op = "ModEq" }
            if op != "" {
                adv(cur)
                var asn = mk("Assign")
                asn.push(e)
                var asline = ln0
                asn.push(op)
                asn.push(p_stmt_expr(toks, cur, lns, "1"))
                nstamp(asn, asline)
                nb.push(asn)
            } else {
                var nx = t2
                if nx == "NL" {
                    while tok(toks, cur) == "NL" {
                        adv(cur)
                    }
                    nx = tok(toks, cur)
                }
                if nx == "}" {
                    adv(cur)
                    nb.push(e)
                    tailSet = true
                    go = false
                } else {
                    var es = mk("Expr")
                    es.push(e)
                    nb.push(es)
                }
            }
        }
        if cur.load() == p0 {
            adv(cur)
        }
    }
    if !tailSet {
        var nn = mk("None")
        nb.push(nn)
    }
    return nb
}

fn p_fn2(toks: List[Str], cur: Atomic[I32], lns: List[Str], tag: Str) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var nf = mk(tag)
    nf.push(nm)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    adv(cur)
    var ps = mk("Ps")
    var more = true
    while more {
        if tok(toks, cur) == ")" { more = false } else {
            var isv = "false"
            var t0 = tok(toks, cur)
            if t0 == "var" { isv = "true" }
            if or2(t0 == "var", t0 == "let") { adv(cur) }
            if tok(toks, cur) == "&" {
                adv(cur)
            }
            var pn = tok(toks, cur)
            adv(cur)
            if pn == "self" {
                var rc = mk("Receiver")
                rc.push(isv)
                ps.push(rc)
            } else {
                adv(cur)
                var pty = p_typ(toks, cur, lns)
                var par = mk("Param")
                par.push(isv)
                par.push(pn)
                par.push(pty)
                ps.push(par)
            }
            if tok(toks, cur) == "," { adv(cur) } else { more = false }
        }
    }
    adv(cur)
    var ret = mk("None")
    if tok(toks, cur) == "->" {
        adv(cur)
        ret = p_typ(toks, cur, lns)
    }
    var body = mk("None")
    if tok(toks, cur) == "\{" {
        adv(cur)
        body = p_block(toks, cur, lns)
    }
    nf.push(tp)
    nf.push(ps)
    nf.push(ret)
    nf.push(body)
    return nf
}

fn p_fn(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    return p_fn2(toks, cur, lns, "Fn")
}

fn p_test(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    adv(cur)
    var t = tok(toks, cur)
    adv(cur)
    var nt = mk("Test")
    nt.push(qtext(byte_slice(t, 1, t.len - 1)))
    adv(cur)
    nt.push(p_block(toks, cur, lns))
    return nt
}

fn p_field(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var isv = "false"
    var t = tok(toks, cur)
    if t == "var" { isv = "true" }
    if or2(t == "let", t == "var") { adv(cur) }
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var f = mk("Field")
    f.push(isv)
    f.push(nm)
    f.push(p_typ(toks, cur, lns))
    return f
}

fn p_struct2(toks: List[Str], cur: Atomic[I32], lns: List[Str], dr: List[Str]) -> List[Str] {
    var ln0 = lns[cur.load()]
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    adv(cur)
    var ns = mk("Struct")
    ns.push(nm)
    ns.push(dr)
    ns.push(tp)
    var fs = mk("Fields")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" { go = false } else if tok(toks, cur) == "#EOF" { go = false } else {
            fs.push(p_field(toks, cur, lns))
        }
    }
    adv(cur)
    ns.push(fs)
    nstamp(ns, ln0)
    return ns
}

fn p_struct(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var dr0 = mk("Drvs")
    return p_struct2(toks, cur, lns, dr0)
}

fn p_enum2(toks: List[Str], cur: Atomic[I32], lns: List[Str], dr: List[Str]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ne = mk("Enum")
    ne.push(nm)
    ne.push(dr)
    var vs = mk("Vars")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" { go = false } else if tok(toks, cur) == "#EOF" { go = false } else {
            var vn = tok(toks, cur)
            adv(cur)
            var v = mk("Variant")
            v.push(vn)
            var kind = mk("KUnit")
            if tok(toks, cur) == "(" {
                adv(cur)
                kind = mk("KTuple")
                var more = true
                while more {
                    if tok(toks, cur) == ")" { more = false } else {
                        kind.push(p_typ(toks, cur, lns))
                        if tok(toks, cur) == "," { adv(cur) } else { more = false }
                    }
                }
                adv(cur)
            } else if tok(toks, cur) == "\{" {
                adv(cur)
                kind = mk("KStruct")
                var more2 = true
                while more2 {
                    while tok(toks, cur) == "NL" {
                        adv(cur)
                    }
                    if tok(toks, cur) == "}" { more2 = false } else if tok(toks, cur) == "#EOF" { more2 = false } else {
                        kind.push(p_field(toks, cur, lns))
                        while tok(toks, cur) == "NL" {
                            adv(cur)
                        }
                        if tok(toks, cur) == "," {
                            adv(cur)
                        }
                    }
                }
                adv(cur)
            }
            v.push(kind)
            vs.push(v)
        }
    }
    adv(cur)
    ne.push(vs)
    return ne
}

fn p_prop_item2(toks: List[Str], cur: Atomic[I32], lns: List[Str], kind: Str) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur, lns)
    var body = mk("None")
    var tag = "PropSig"
    if tok(toks, cur) == "\{" {
        adv(cur)
        body = p_block(toks, cur, lns)
        tag = "PropImpl"
    }
    if kind == "imp" {
        tag = "Prop"
    }
    var pn = mk(tag)
    pn.push(nm)
    pn.push(ty)
    pn.push(body)
    return pn
}

fn p_items(toks: List[Str], cur: Atomic[I32], lns: List[Str], kind: Str) -> List[Str] {
    var it = mk("Items")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var t = tok(toks, cur)
        if or2(t == "}", t == "#EOF") {
            adv(cur)
            go = false
        } else if t == "#" {
            adv(cur)
            adv(cur)
            var anm = tok(toks, cur)
            adv(cur)
            while tok(toks, cur) != "]" && tok(toks, cur) != "#EOF" {
                adv(cur)
            }
            if tok(toks, cur) == "]" {
                adv(cur)
            }
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var md = p_fn2(toks, cur, lns, "Method")
            md.push(anm)
            it.push(md)
        } else if t == "fn" {
            it.push(p_fn2(toks, cur, lns, "Method"))
        } else if t == "prop" {
            var pk = "sig"
            if or2(kind == "impl", kind == "class") {
                pk = "imp"
            }
            it.push(p_prop_item2(toks, cur, lns, pk))
        } else if kind == "trait" {
            go = false
        } else {
            it.push(p_field(toks, cur, lns))
        }
    }
    adv(cur)
    return it
}

fn p_class(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var nc = mk("Class")
    nc.push(nm)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    adv(cur)
    nc.push(tp)
    nc.push(p_items(toks, cur, lns, "class"))
    return nc
}

fn p_impl(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    adv(cur)
    var ni = mk("Impl")
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    ni.push(tp)
    ni.push(p_typ(toks, cur, lns))
    adv(cur)
    ni.push(p_typ(toks, cur, lns))
    adv(cur)
    ni.push(p_items(toks, cur, lns, "impl"))
    return ni
}

fn p_trait(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var nt = mk("Trait")
    nt.push(nm)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    nt.push(tp)
    var sup = mk("Bounds")
    if tok(toks, cur) == ":" {
        adv(cur)
        var more = true
        while more {
            sup.push(tok(toks, cur))
            adv(cur)
            if tok(toks, cur) == "+" { adv(cur) } else { more = false }
        }
    }
    nt.push(sup)
    adv(cur)
    nt.push(p_items(toks, cur, lns, "trait"))
    return nt
}

fn p_enum(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var dr0 = mk("Drvs")
    return p_enum2(toks, cur, lns, dr0)
}

fn p_use(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nu = mk("Use")
    var segs = mk("Segs")
    var syms = mk("Syms")
    var braced = false
    var more = true
    while more {
        var a = tok(toks, cur)
        if a == "." {
            adv(cur)
        } else if a == "\{" {
            adv(cur)
            braced = true
            var more2 = true
            while more2 {
                var b2 = tok(toks, cur)
                if or2(b2 == "}", b2 == "#EOF") {
                    more2 = false
                } else {
                    syms.push(b2)
                    adv(cur)
                    if tok(toks, cur) == "," {
                        adv(cur)
                    }
                }
            }
            if tok(toks, cur) == "}" {
                adv(cur)
            }
            more = false
        } else if a == "#EOF" {
            more = false
        } else {
            segs.push(a)
            adv(cur)
            var nx = tok(toks, cur)
            if nx != "." {
                more = false
            }
        }
    }
    if !braced {
        // 无花括号:末段即符号(use app.hidden.secret)
        syms.push(segs[segs.len - 1])
    }
    nu.push(segs)
    nu.push(syms)
    return nu
}

fn p_const(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur, lns)
    adv(cur)
    var nc = mk("Const")
    nc.push(nm)
    nc.push(ty)
    nc.push(p_stmt_expr(toks, cur, lns, "1"))
    return nc
}

fn p_static(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var ln0 = lns[cur.load()]
    adv(cur)
    var wv = "false"
    var t = tok(toks, cur)
    if t == "var" { wv = "true" }
    if or2(t == "var", t == "let") { adv(cur) }
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur, lns)
    adv(cur)
    var ns = mk("Static")
    ns.push(nm)
    ns.push(wv)
    ns.push(ty)
    ns.push(p_stmt_expr(toks, cur, lns, "1"))
    nstamp(ns, ln0)
    return ns
}

// extern "c" fn 声明(§9.6):无函数体;仅支持 "c"(v0);anm = 前置 #[attr] 名(可空)
fn p_extern(toks: List[Str], cur: Atomic[I32], lns: List[Str], anm: Str) -> List[Str] {
    adv(cur)
    adv(cur)
    while tok(toks, cur) == "NL" {
        adv(cur)
    }
    var fd = p_fn2(toks, cur, lns, "FnExt")
    if anm != "" {
        fd.push(anm)
    }
    return fd
}

fn p_file(toks: List[Str], cur: Atomic[I32], lns: List[Str]) -> List[Str] {
    var nf = mk("File")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var p0 = cur.load()
        var t = tok(toks, cur)
        if t == "#EOF" {
            go = false
        } else if t == "#" {
            adv(cur)
            adv(cur)
            var anm = tok(toks, cur)
            adv(cur)
            while tok(toks, cur) != "]" && tok(toks, cur) != "#EOF" {
                adv(cur)
            }
            if tok(toks, cur) == "]" {
                adv(cur)
            }
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "extern" {
                nf.push(p_extern(toks, cur, lns, anm))
            } else {
                var fd = p_fn2(toks, cur, lns, "Fn")
                fd.push(anm)
                nf.push(fd)
            }
        } else if t == "pub" {
            adv(cur)
            if tok(toks, cur) == "(" {
                // pub(pkg):单包模型下与 pub 同义(v0)
                adv(cur)
                adv(cur)
                adv(cur)
            }
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "fn" {
                nf.push(p_fn2(toks, cur, lns, "FnPub"))
            } else {
                nf.push(p_fn(toks, cur, lns))
            }
        } else if t == "comptime" {
            adv(cur)
            nf.push(p_fn2(toks, cur, lns, "FnC"))
        } else if t == "@" {
            adv(cur)
            adv(cur)
            adv(cur)
            var dr2 = mk("Drvs")
            var more3 = true
            while more3 {
                if tok(toks, cur) == ")" {
                    more3 = false
                } else {
                    dr2.push(tok(toks, cur))
                    adv(cur)
                    if tok(toks, cur) == "," { adv(cur) }
                }
            }
            adv(cur)
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var t2 = tok(toks, cur)
            if t2 == "struct" {
                nf.push(p_struct2(toks, cur, lns, dr2))
            } else if t2 == "enum" {
                nf.push(p_enum2(toks, cur, lns, dr2))
            } else if t2 == "trait" {
                nf.push(p_trait(toks, cur, lns))
            } else {
                nf.push(p_fn(toks, cur, lns))
            }
        } else if t == "test" {
            nf.push(p_test(toks, cur, lns))
        } else if t == "extern" {
            nf.push(p_extern(toks, cur, lns, ""))
        } else if t == "enum" {
            nf.push(p_enum(toks, cur, lns))
        } else if t == "struct" {
            nf.push(p_struct(toks, cur, lns))
        } else if t == "class" {
            nf.push(p_class(toks, cur, lns))
        } else if t == "impl" {
            nf.push(p_impl(toks, cur, lns))
        } else if t == "trait" {
            nf.push(p_trait(toks, cur, lns))
        } else if t == "use" {
            nf.push(p_use(toks, cur))
        } else if t == "const" {
            nf.push(p_const(toks, cur, lns))
        } else if t == "static" {
            nf.push(p_static(toks, cur, lns))
        } else {
            nf.push(p_fn(toks, cur, lns))
        }
        if cur.load() == p0 {
            adv(cur)
        }
    }
    return nf
}

// ---------------- 模块加载器 v0(§2):use 解析 → 可见性 → 整模块合并 → 循环检测 ----------------
fn pkg_dir_of(path: Str) -> Str {
    var i = path.len - 1
    while i >= 0 {
        if byte_at(path, i) == 47 {
            return byte_slice(path, 0, i)
        }
        i -= 1
    }
    return "."
}

// std.* 导入:stdlib 未实现,跳过加载(§7 std 可用性 v0 口径)
fn segs_std(d: List[Str]) -> Bool {
    if d[0] != "Use" {
        return false
    }
    var segs = d[1]
    if segs.len < 2 {
        return false
    }
    return seq2(segs[1], "std")
}

fn pkg_check_caps(mf: List[Str], dir: Str, diags: List[Str]) {
    // E4010(§8.2):use std.<key>.<Name>(key ∈ {fs,time}) 且本文件有 &Name 参数,
    // 而 Ctron.toml [caps] 未声明该 key
    var i: I32 = 1
    while i < mf.len {
        var d = mf[i]
        if d[0] == "Use" {
            var segs = d[1]
            var symsN = d[2]
            if segs.len > 2 && seq2(segs[1], "std") {
                var cap = segs[2]
                if or2(seq2(cap, "fs"), seq2(cap, "time")) {
                    var name = ""
                    if symsN.len > 1 {
                        name = symsN[1]
                    } else {
                        if segs.len > 3 {
                            name = segs[3]
                        }
                    }
                    if name.len > 0 {
                        var hit = false
                        var j: I32 = 1
                        while j < mf.len && !hit {
                            var dd = mf[j]
                            if dd[0] == "Fn" {
                                var ps = dd[3]
                                var q: I32 = 1
                                while q < ps.len {
                                    var pr = ps[q]
                                    if pr[0] == "Param" {
                                        var pt = pr[3]
                                        if pt[0] == "Ref" && pt[1][0] == "Named" && seq2(pt[1][1], name) {
                                            hit = true
                                        }
                                    }
                                    q += 1
                                }
                            }
                            j += 1
                        }
                        if hit && !pkg_caps_allowed(dir, cap) {
                            diags.push("E4010: 使用 " + cap + " 能力超出 manifest(caps) 声明:参数 &" + name)
                        }
                    }
                }
            }
        }
        i += 1
    }
}

fn pkg_caps_allowed(dir: Str, cap: Str) -> Bool {
    var toml = read_file(dir + "/../Ctron.toml")
    match toml {
        Some(t) => {
            var insec = false
            var i: I32 = 0
            while i < t.len {
                var c = byte_at(t, i)
                if c == 91 {
                    var sec = ""
                    i += 1
                    while i < t.len && byte_at(t, i) != 93 {
                        sec = sec + byte_slice(t, i, i + 1)
                        i += 1
                    }
                    insec = seq2(sec, "caps")
                } else if c == 10 {
                    i += 1
                } else {
                    var key = ""
                    var i0 = i
                    while i < t.len && byte_at(t, i) != 61 && byte_at(t, i) != 10 {
                        if byte_at(t, i) != 32 {
                            key = key + byte_slice(t, i, i + 1)
                        }
                        i += 1
                    }
                    if i == i0 {
                        i += 1
                    }
                    if insec && key.len > 0 && seq2(key, cap) {
                        return true
                    }
                }
            }
            return false
        }
        None => {
            return true
        }
    }
}

fn pkg_load_use(file: List[Str], dir: Str, stack: List[Str], diags: List[Str]) -> List[Str] {
    pkg_check_caps(file, dir, diags)
    if diags.len > 0 {
        return file
    }
    var out = file
    var i: I32 = 1
    while i < out.len {
        var d = out[i]
        if or2(d[0] != "Use", segs_std(d)) {
            // 非 Use,或 std.* 导入(stdlib 未落地,忽略)
        } else {
            // 节点形态:[Use, Segs, Syms](全列表;无花括号时 Syms 空 symbolic=Segs 末段)
            // std.* 前缀:stdlib 未落地,保持既有"忽略 use"语义(单文件语料兼容)
            var segs = d[1]
            var symsN = d[2]
            var syms = List[Str]()
            var k: I32 = 1
            while k < symsN.len {
                syms.push(symsN[k])
                k += 1
            }
            if syms.len == 0 {
                syms.push(segs[segs.len - 1])
            }
            // 模块相对路径:跳过包名段(首段),其余按目录展开
            var rel = ""
            var j2: I32 = 2
            while j2 < segs.len {
                rel = rel + "/" + segs[j2]
                j2 += 1
            }
            var mpath = dir + rel + ".ct"
            if in_list(stack, mpath) {
                diags.push("E5020: 模块循环导入(circular):" + mpath)
                return out
            }
            var src = read_file(mpath)
            match src {
                Some(ms) => {
                    var toks2 = List[Str]()
                    var lns2 = List[Str]()
                    scan(ms, toks2, lns2)
                    var cur2 = Atomic[I32](0)
                    var mf = p_file(toks2, cur2, lns2)
                    pkg_check_caps(mf, dir, diags)
                    // 可见性:请求符号必须存在且为 pub(v0:FnPub)
                    var k: I32 = 0
                    while k < syms.len {
                        var sn = syms[k]
                        var found = false
                        var vis = false
                        var m2: I32 = 1
                        while m2 < mf.len {
                            var md = mf[m2]
                            if md.len > 1 && md[1] == sn {
                                found = true
                                if md[0] == "FnPub" {
                                    vis = true
                                }
                            }
                            m2 += 1
                        }
                        if !found {
                            diags.push("E2020: use 导入未找到符号:" + sn)
                        } else if !vis {
                            diags.push("E2020: use 导入的符号未公开(pub):" + sn)
                        }
                        k += 1
                    }
                    if diags.len > 0 {
                        return out
                    }
                    var stack2 = stack
                    stack2.push(mpath)
                    mf = pkg_load_use(mf, dir, stack2, diags)
                    if diags.len > 0 {
                        return out
                    }
                    // 合并:双侧滤除 Use(模块自身的 use 已递归展开)
                    var merged = mk("File")
                    var j3: I32 = 1
                    while j3 < out.len {
                        if out[j3][0] != "Use" {
                            merged.push(out[j3])
                        }
                        j3 += 1
                    }
                    var j4: I32 = 1
                    while j4 < mf.len {
                        if mf[j4][0] != "Use" {
                            merged.push(mf[j4])
                        }
                        j4 += 1
                    }
                    out = merged
                    i = 1
                }
                None => {
                    diags.push("E2020: use 模块文件不可读:" + mpath)
                    return out
                }
            }
        }
        i += 1
    }
    return out
}
