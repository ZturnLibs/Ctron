// =====================================================================
// eval_env.ct —— 环境/fmt/文本工具:env_at·env_add·env_set·env_drop·env_dedupe
// 作用域链;fmt 值→文本(v 域标签分发);e4/s4;expr_of_text 插值表达式复解析;
// find_decl/unesc;eval_str 插值串求值;pm2/enum_var。
// =====================================================================
fn fmt(v: List[Str]) -> Str {
    var k = v[0]
    if k == "I" {
        return v[1]
    }
    if k == "W" {
        return v[1]
    }
    if k == "6" {
        return v[1]
    }
    if k == "B" {
        return v[1]
    }
    if k == "S" {
        return v[1]
    }
    if k == "D" {
        return df_show(v[1])
    }
    if k == "V" {
        return ""
    }
    if k == "T" {
        // Option/Result 值:变体名(无载荷 None/Err)或 变体(载荷)
        if v.len == 3 {
            return v[1] + "(" + fmt(v[2]) + ")"
        }
        return v[1]
    }
    if k == "U" {
        return fmt_struct(v)
    }
    return "<value>"
}

// @derive(Show)(§3d):U 值结构化格式 Name(f=v,...) —— show 方法/插值两通道同族;
// 字段值经 fmt 递归(嵌套 struct 自动下钻,与 emit 侧 ct_show_frag_dp 逐字对齐)
fn fmt_struct(v: List[Str]) -> Str {
    var s = v[1] + "("
    var i: I32 = 2
    var first = true
    while i < v.len {
        if first {
            first = false
        } else {
            s = s + ","
        }
        s = s + v[i] + "=" + fmt(v[i + 1])
        i += 2
    }
    return s + ")"
}

// @derive(Eq)(§3d):U 值结构化逐字段相等 —— emit 侧 ct_eq_expr_dp 同族对齐;
// 标量按规范文本比较(解释器标量值即文本),嵌套 struct 递归;型别名不同 → 不等;
// 不支持的字段型别 panic(与发射面同界:标量/Str/嵌套 struct 之外不派生)
fn eq_val(a: List[Str], b: List[Str]) -> Bool {
    if !seq2(a[0], b[0]) {
        return false
    }
    if or2(a[0] == "S", or2(a[0] == "I", or2(a[0] == "W", a[0] == "B"))) {
        return seq2(a[1], b[1])
    }
    if a[0] == "U" {
        if !seq2(a[1], b[1]) {
            return false
        }
        var i: I32 = 2
        while i < a.len {
            if !eq_val(a[i + 1], b[i + 1]) {
                return false
            }
            i += 2
        }
        return true
    }
    panic("eq 字段型别:" + a[0])
    return false
}
fn env_at(env: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if seq2(en[0], nm) {
            return en
        }
        i += 1
    }
    return List[Str]()
}
fn env_add(env: List[Str], nm: Str, val: List[Str]) -> List[Str] {
    var out = List[Str]()
    var en = List[Str]()
    en.push(nm)
    en.push(val)
    out.push(en)
    var i: I32 = 0
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
fn env_set(env: List[Str], nm: Str, val: List[Str]) -> List[Str] {
    var out = List[Str]()
    var done = false
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if !done && seq2(en[0], nm) {
            var nb = List[Str]()
            nb.push(nm)
            nb.push(val)
            out.push(nb)
            done = true
        } else {
            out.push(en)
        }
        i += 1
    }
    return out
}
fn env_drop(env: List[Str], n: I32) -> List[Str] {
    var out = List[Str]()
    var i = n
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
// keep 块的前 n 项按名去重(保留最新):while 体绑定有界累积,新者优先查找不变
fn env_dedupe(env: List[Str], n: I32) -> List[Str] {
    var keep = List[Str]()
    var i: I32 = 0
    while i < n && i < env.len {
        var en = env[i]
        var seen = false
        var j: I32 = 0
        while j < keep.len {
            if seq2(keep[j][0], en[0]) {
                seen = true
            }
            j += 1
        }
        if !seen {
            keep.push(en)
        }
        i += 1
    }
    var out = keep
    i = n
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
fn e4(fl: Str, env: List[Str], vv: List[Str], out: Str) -> List[Str] {
    var r = List[Str]()
    r.push(fl)
    r.push(env)
    r.push(vv)
    r.push(out)
    return r
}
fn s4(fl: Str, env: List[Str], out: Str, vv: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push(fl)
    r.push(env)
    r.push(out)
    r.push(vv)
    return r
}
fn expr_of_text(s: Str) -> List[Str] {
    var toks = List[Str]()
    var lns = List[Str]()
    scan(s, toks, lns)
    var cur = Atomic[I32](0)
    return p_stmt_expr(toks, cur, lns, "1")
}
fn find_decl(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var tt = d[0]
        // tag 先行:Use 节点的 d[1] 是段列表(非 Str),急切 seq2 会 rt abort
        if or3(seq2(tt, "Fn"), seq2(tt, "FnPub"), seq2(tt, "FnC")) {
            if seq2(d[1], nm) {
                return d
            }
        }
        i += 1
    }
    return List[Str]()
}
fn unesc(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    var n = s.len
    while i < n {
        var c = byte_at(s, i)
        if c == 92 && i + 1 < n {
            var e = byte_at(s, i + 1)
            if e == 110 {
                out = out + "\n"
                i += 2
            } else if e == 116 {
                out = out + "\t"
                i += 2
            } else if e == 114 {
                out = out + "\r"
                i += 2
            } else if e == 123 {
                out = out + "\{"
                i += 2
            } else if e == 34 {
                out = out + "\""
                i += 2
            } else if e == 92 {
                out = out + "\\"
                i += 2
            } else {
                out = out + byte_slice(s, i, i + 2)
                i += 2
            }
        } else {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}

fn eval_str(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var parts = e[1]
    var acc = ""
    var env2 = env
    var j: I32 = 1
    while j < parts.len {
        var p = parts[j]
        if p[0] == "Text" {
            acc = acc + unesc(p[1])
        } else {
            var ex = expr_of_text(p[1])
            var er = eval_expr(file, env2, out, ex)
            out = er[3]
            if er[0] != "k" {
                return er
            }
            env2 = er[1]
            acc = acc + fmt(er[2])
        }
        j += 1
    }
    return e4("k", env2, vS(acc), out)
}
fn pm2(ok: Str, env: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push(ok)
    r.push(env)
    return r
}
fn enum_var(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" {
            var vs = d[3]
            var k: I32 = 1
            while k < vs.len {
                if seq2(vs[k][1], nm) {
                    return true
                }
                k += 1
            }
        }
        i += 1
    }
    return false
}
