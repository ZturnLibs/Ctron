// =====================================================================
// sem_main.ct —— 语义检查主控:sem_walk2(file) → 诊断串(空串 = 通过)
// 12 项全集(与 C 版 ctronc 逐字差分):W8010 浅拷贝 / W8020 must-use / E4030 no_spawn /
//   E3020 跨线程 Send / E3031 spawn 形参 / E3060 own 内 GC 可变写 / E4020·E6020 pure·comptime
//   能力 / E3010 spawn 闭包捕获非 Send / E3050 own 内 arena use-after-move /
//   E2030 match 穷尽 / E3040 分配效果。各检查实现分居 sem_walk/send/own/pure/spawn/
//   move/exh/alloc/type/calls/comptime/ceval/closure.ct;逐条 "CODE@行: msg\n"。
// =====================================================================
// prof:full(默认)/bare —— bare 档文件级 no_alloc 上下文(隐式分配一律 E3040)
fn sem_walk2(file: List[Str], prof: Str) -> Str {
    var out = ""
    var diags = List[Str]()
    // 预扫描:class 名、fn 名+ret、attr
    var cls = List[Str]()
    var fns = List[Str]()
    var rets = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if t == "Class" {
            cls.push(d[1])
        } else if or2(t == "Fn", or2(t == "FnC", or2(t == "FnPub", t == "FnExt"))) {
            fns.push(d[1])
            rets.push(d[4])
        } else if t == "Method" {
            fns.push(d[1])
            rets.push(d[4])
        } else if t == "Static" && d[2] == "true" {
                diag1(diags, "E3030", nline(d), d[1])
        }
        i += 1
    }
    // 声明序遍历
    i = 1
    while i < file.len {
        var d = file[i]
        var t = d[0]
        if t == "Struct" {
            var nm = d[1]
            var hit = false
            var hn = ""
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len && !hit {
                var f = fs[j]
                var ty = f[3]
                if ty[0] == "Named" {
                    var h = ty[1]
                    var k: I32 = 0
                    while k < cls.len && !hit {
                        if cls[k] == h {
                            hit = true
                            hn = f[2]
                        }
                        k += 1
                    }
                }
                j += 1
            }
            if hit {
                diag2(diags, "W8010", nline(d), nm, hn)
            }
        } else if or2(t == "Fn", or2(t == "FnC", t == "FnPub")) {
            var ns = false
            if d.len >= 7 && d[6] == "no_spawn" {
                ns = true
            }
            walk_b(file, d[5], ns, fns, rets, diags)
            var e6 = sem_e3060(file, d, t)
            if e6 != "" {
                diags.push(byte_slice(e6, 0, e6.len - 1))
            }
            var ckind = ""
            if d.len >= 7 && d[6] == "pure" {
                ckind = "E4020: pure 函数含能力调用(pure)"
            } else if t == "FnC" {
                ckind = "E6020: comptime 函数含能力调用(comptime)"
            }
            if ckind != "" {
                var ec = sem_cap(file, d, ckind)
                if ec != "" {
                    diags.push(byte_slice(ec, 0, ec.len - 1))
                }
            }
            if !(d.len >= 7 && d[6] == "no_spawn") {
                var es = sem_spawn2(file, d, t)
                if es != "" {
                    diags.push(byte_slice(es, 0, es.len - 1))
                }
            }
            var mv = sem_mv(file, d, t)
            if mv != "" {
                diags.push(byte_slice(mv, 0, mv.len - 1))
            }
            var ex = sem_exh(file, d, t)
            if ex != "" {
                diags.push(byte_slice(ex, 0, ex.len - 1))
            }
            var ac = sem_alloc(file, d, t, prof)
            if ac != "" {
                diags.push(byte_slice(ac, 0, ac.len - 1))
            }
        } else if t == "Test" {
            walk_b(file, d[2], false, fns, rets, diags)
            var e6b = sem_e3060(file, d, "Test")
            if e6b != "" {
                diags.push(byte_slice(e6b, 0, e6b.len - 1))
            }
            var es2 = sem_spawn2(file, d, "Test")
            if es2 != "" {
                diags.push(byte_slice(es2, 0, es2.len - 1))
            }
            var mv2 = sem_mv(file, d, "Test")
            if mv2 != "" {
                diags.push(byte_slice(mv2, 0, mv2.len - 1))
            }
            var ex2 = sem_exh(file, d, "Test")
            if ex2 != "" {
                diags.push(byte_slice(ex2, 0, ex2.len - 1))
            }
            var ac2 = sem_alloc(file, d, "Test", prof)
            if ac2 != "" {
                diags.push(byte_slice(ac2, 0, ac2.len - 1))
            }
        } else if t == "Static" {
            if !send_of(file, d[3], 0) {
                diag1(diags, "E3031", nline(d), d[1])
            }
        } else if t == "Impl" {
            var tr = d[2]
            var trname = ""
            if tr.len > 0 && tr[0] == "Named" {
                trname = tr[1]
            }
            var its = d[4]
            var mi: I32 = 1
            while mi < its.len {
                var md = its[mi]
                if md[0] == "Method" {
                    var mna = or2(has_noalloc(md), trait_method_noalloc(file, trname, md[1]))
                    if mna {
                        var dl = List[Str]()
                        var ab = List[Str]()
                        var gl = List[Str]()
                        al_b(file, md[5], false, true, ab, gl, dl)
                        var qq: I32 = 0
                        while qq < dl.len {
                            diags.push(dl[qq])
                            qq += 1
                        }
                    }
                }
                mi += 1
            }
        }
        i += 1
    }
    // E2020/E2010:名字解析与类型统一 v1(见文件尾新节)
    sem_calls_all(file, diags, prof)
    // #[trusted]/#[repr] 语义化(§9.6;v0.6 注记):extern "c" 必须标记 #[trusted]
    // (信任边界,可枚举审计);trusted 仅限 extern 声明(E4040);repr 仅限 struct
    // 声明(E4041);extern 边界 C-ABI 类型治理(W8052/W8053)。
    var ti: I32 = 1
    while ti < file.len {
        var td = file[ti]
        if td[0] == "FnExt" {
            // 带 #[trusted] 的 FnExt:len 8(尾部 anm + nstamp 行号);无标记 len 7
            if td.len < 8 {
                diag1(diags, "W8050", nline(td), td[1])
            }
            if td.len > 7 && attr_is(td[6], "repr") {
                diag1(diags, "E4041", nline(td), td[1])
            }
            // C-ABI 类型治理(v0.6):容器/能力类型不得跨界;返回 fn 类型 v0.7 起支持
            //(边界 ct_fnK + 绑定面装箱)
            var eps = td[3]
            var ek: I32 = 1
            while ek < eps.len {
                var epr = eps[ek]
                if epr[0] == "Param" && ext_nonabi_ty(epr[3]) {
                    diag2(diags, "W8052.param", nline(td), td[1], epr[2])
                }
                ek += 1
            }
            if ext_nonabi_ty(td[4]) {
                diag1(diags, "W8052.ret", nline(td), td[1])
            }
        } else if or2(td[0] == "Fn", td[0] == "FnPub") {
            // fn 带 #[trusted]:# 分支 push anm 后补 nstamp(len 7,nline 安全)
            if td.len > 6 && seq2(td[6], "trusted") {
                diag1(diags, "E4040", nline(td), td[1])
            } else if td.len > 6 && attr_is(td[6], "repr") {
                diag1(diags, "E4041", nline(td), td[1])
            }
            // E4044(v0.7 §9.6):变参形参仅限 extern "c" 声明
            var vps = td[3]
            var vk: I32 = 1
            while vk < vps.len {
                if vps[vk][0] == "VaArgs" {
                    // 行号:仅带属性戳的 fn(len>7,尾槽=stamp)可 nline;裸 fn 无戳,
                    // 回退 "0"(与 Enum 的 E4041@0 同款;p_fn2 统一补戳后可收回)
                    var vln = "0"
                    if td.len > 7 {
                        vln = nline(td)
                    }
                    diag1(diags, "E4044", vln, td[1])
                }
                vk += 1
            }
        } else if td[0] == "Struct" {
            // #[repr(...)] struct(v0.6/v0.7):发射面按声明序直出 C struct(布局 = C 声明序,
            // 与 C 侧同型定义即 ABI 兼容);属性为显式 FFI 导出标记,字段含非 C-ABI 类型 = W8051
            // (镜像 Rust improper_ctypes 警示面);packed/align(N) 变体直出 GNU 属性。
            // Struct 节点 [5]=anm [6]=stamp。
            if td.len > 6 && attr_is(td[5], "repr") {
                var rfs = td[4]
                var rj: I32 = 1
                while rj < rfs.len {
                    var rfd = rfs[rj]
                    if rfd.len > 3 && rfd[0] == "Field" && ext_nonabi_ty(rfd[3]) {
                        diag2(diags, "W8051", nline(td), td[1], rfd[2])
                    }
                    rj += 1
                }
            }
        } else if td[0] == "Enum" {
            // Enum 节点无行号戳(nline 回退 "0");#[attr] 名在尾槽([4])
            if td.len > 4 && attr_is(td[4], "repr") {
                diag1(diags, "E4041", "0", td[1])
            }
        } else if td[0] == "Class" {
            // §6.2 硬规则(P0-G/GC spike):类直接持有需确定性释放的资源字段 → E4050
            var rfs = td[3]
            var rj: I32 = 1
            while rj < rfs.len {
                var rfd = rfs[rj]
                if rfd.len > 3 && rfd[0] == "Field" {
                    var rh = ty_head(rfd[3])
                    if or2(seq2(rh, "Mutex"), seq2(rh, "Channel")) {
                        diag2(diags, "E4050", nline(rfd), td[1], rfd[2])
                    }
                }
                rj += 1
            }
        }
        ti += 1
    }
    // E3070:闭包可变捕获(两遍式,见文件尾新节)
    sem_closures(file, diags)
    // E6020/E6010:comptime 副作用扫描 + const/static-let 编译期试求值(见文件尾新节)
    sem_comp(file, diags)
    var kk: I32 = 0
    while kk < diags.len {
        out = out + diags[kk] + "\n"
        kk += 1
    }
    return out
}

// 属性名匹配(§9.6 v0.7):裸名或带实参 "名(...)"——前缀 + '(' 收口;等值即真
fn attr_is(v: Str, name: Str) -> Bool {
    if seq2(v, name) {
        return true
    }
    if v.len > name.len + 1 {
        if byte_at(v, name.len) == 40 {
            return seq2(byte_slice(v, 0, name.len), name)
        }
    }
    return false
}

// 堆叠属性成员判(§9.6 v0.7):"trusted,dlsym" 形式的逗号分段,逐段 attr_is
fn attr_has(v: Str, name: Str) -> Bool {
    var i: I32 = 0
    var seg = ""
    while i < v.len {
        var c = byte_at(v, i)
        if c == 44 {
            if attr_is(seg, name) {
                return true
            }
            seg = ""
        } else {
            seg = seg + byte_slice(v, i, i + 1)
        }
        i += 1
    }
    return attr_is(seg, name)
}

// 属性实参提取:"名(实参)" → 实参(嵌套括号含内层原文);非带参属性 → ""
fn attr_arg(v: Str) -> Str {
    var bar = -1
    var i: I32 = 0
    while i < v.len {
        if byte_at(v, i) == 40 {
            bar = i
            i = v.len
        }
        i += 1
    }
    if bar < 0 {
        return ""
    }
    // 堆叠属性下实参止于配对 ')'(不能切到串尾——尾槽还有后续段)
    var dep: I32 = 1
    var j = bar + 1
    while j < v.len {
        var c = byte_at(v, j)
        if c == 40 {
            dep += 1
        }
        if c == 41 {
            dep -= 1
            if dep == 0 {
                return byte_slice(v, bar + 1, j)
            }
        }
        j += 1
    }
    return ""
}

// C-ABI 类型治理(§9.6 v0.6):容器/能力类型不得跨 extern 边界(镜像 Rust
// improper_ctypes 警示面);标量/Str(char*)/用户 struct(声明序布局)/切片视图
// ((ptr,len) 复合,见 spec 注记)均放行;fn 类型本身为合法 C 函数指针(F1..3 →
// ct_fnK,放行;返回向 v0 限制由 W8053 专门表达)。
fn ext_nonabi_ty(ty: List[Str]) -> Bool {
    var t = ty[0]
    if t == "Named" {
        var h = ty[1]
        if seq2(h, "Option") {
            // Option[Str] 放行(v0.8 §9.6):extern 返回 NULL ↔ None 编组面;
            // 其余载荷仍拒(值域 ct_i 无 NULL 语义)
            if ty.len > 2 && ty[2].len > 1 && ty[2][1][0] == "Named" && seq2(ty[2][1][1], "Str") {
                return false
            }
            return true
        }
        if or2(seq2(h, "List"), or2(seq2(h, "Atomic"), or2(seq2(h, "Result"), or2(seq2(h, "Box"), or2(seq2(h, "Mutex"), or2(seq2(h, "Channel"), seq2(h, "Global"))))))) {
            return true
        }
        return false
    }
    if ty.len > 1 {
        return ext_nonabi_ty(ty[1])
    }
    return false
}
