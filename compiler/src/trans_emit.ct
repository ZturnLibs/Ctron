// =====================================================================
// trans_emit.ct —— 函数发射与文件样板:ct_fn(fn→C 定义,值语义形参/返回)、
// ct_str_payload 字面量载荷、ct_find_main_anchor/ct_swap_anchor main 锚替换、
// bs 样板文本(原型区/运行时助手/无 main 包的测试 main 生成)。
// =====================================================================
// Impl 方法 → 合成 Fn 节点表(名字 t_<ForType>__<method>,self 类型注解
// 缺失时取 impl for 型,值语义 v0)
fn ct_impl_method_fns(d: List[Str]) -> List[Str] {
    var out = List[Str]()
    if d[3].len < 2 || d[3][0] != "Named" {
        return out
    }
    var forh = ty_head(d[3])
    var its = d[4]
    var k: I32 = 1
    while k < its.len {
        var it = its[k]
        if it[0] == "Method" {
            var fnn = mk("Fn")
            fnn.push(forh + "__" + it[1])
            fnn.push(mk("TPs"))
            var nps = mk("Ps")
            var pr: I32 = 1
            while pr < it[3].len {
                var pa = it[3][pr]
                if pa[0] == "Param" && pa[2] == "self" && pa[3][0] == "None" {
                    var stn = mk("Named")
                    stn.push(forh)
                    stn.push(mk("TArgs"))
                    var npa = mk("Param")
                    npa.push(pa[1])
                    npa.push(pa[2])
                    npa.push(stn)
                    nps.push(npa)
                } else {
                    nps.push(pa)
                }
                pr += 1
            }
            fnn.push(nps)
            fnn.push(it[4])
            fnn.push(it[5])
            out.push(fnn)
        }
        k += 1
    }
    return out
}

fn ct_fn(d: List[Str], file: List[Str], pass: Str) {
    var ps = d[3]
    var k: I32 = 1
    var env = List[Str]()
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            env = env_bind(env, pr[2], ct_ty_code(pr[3], file))
            var elc = ct_opt_elem_strict(file, pr[3])
            if elc.len > 0 {
                env = env_bind(env, "#elem:" + pr[2], elc)
            }
            // P0-3:fn 值形参返回型别侧条目(F<arity> 码不带 R;间接调用/链上成员读解析用)。
            // P0-2/seam② 收窄:标量/Str 返回(R 码非 v/i)亦入码,镜像种子 decl_ty_tc 存槽口径;
            // i 即旧形态无差不入码,v 无值不绑
            if pr[3][0] == "FnType" {
                var frc = ct_ty_code(pr[3][2], file)
                if frc != "v" {
                    if frc != "i" {
                        env = env_bind(env, "#fret:" + pr[2], frc)
                    }
                }
            }
        }
        k += 1
    }
    var rc = ct_fn_ret(file, d[1])
    // P0-2:返回为 fn(A)->R 时绑 '#retfn'(内参码逗号串)——Return 位闭包形参码
    // 注入源(§4.7 自动适配;trans_stmt Return 位临时改绑 #clcodes 消费)
    if d[4].len > 1 && d[4][0] == "FnType" {
        var racc = ""
        var rpi: I32 = 1
        while rpi < d[4][1].len {
            if rpi > 1 {
                racc = racc + ","
            }
            racc = racc + ct_ty_code(d[4][1][rpi], file)
            rpi += 1
        }
        env = env_bind(env, "#retfn", racc)
    }
    if seq2(pass, "2") {
        println(ct_ctype(rc) + " t_" + d[1] + "(" + ct_params_str(d, file) + ") ")
    }
    // 闭包命名前缀:ct_clo_<fn>_L<行>(跨文件合并下行号撞号,fn 名合并面唯一)
    env = env_bind(env, "#clofn", d[1])
    var penv = env_bind(env, "#p", pass)
    ct_body(d[5], penv, file, rc)
}

// T25:trait 是否被引用为 &Trait 参数(仅这些产 vtable;Drop/UFCS 走既有路径)
fn ct_trait_used_as_ref(file: List[Str], tn: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnPub", d[0] == "Method")) {
            var ps = d[3]
            var k: I32 = 1
            while k < ps.len {
                var pr = ps[k]
                if pr[0] == "Param" && pr[3][0] == "Ref" {
                    if pr[3][1].len > 1 && pr[3][1][0] == "Named" {
                        if seq2(pr[3][1][1], tn) {
                            return true
                        }
                    }
                }
                k += 1
            }
        }
        i += 1
    }
    return false
}

// T25 &Trait vtable 发射(§3.5):trait 方法槽结构 + impl thunk + 常量
fn ct_vtable_emit(file: List[Str]) {
    // ① trait 方法槽结构(仅有 impl 的 trait)
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Trait" {
            var tn = d[1]
            var has_impl = ct_trait_used_as_ref(file, tn)
            var j: I32 = 1
            while j < file.len && !has_impl {
                if file[j][0] == "Impl" && seq2(ty_head(file[j][2]), tn) {
                    has_impl = true
                }
                j += 1
            }
            if has_impl {
                println("typedef struct vt_" + tn + " vt_" + tn + ";")
                println("struct vt_" + tn + " \{")
                var tits = d[4]
                var k: I32 = 1
                while k < tits.len {
                    var tit = tits[k]
                    if tit[0] == "Method" {
                        println("    ct_i (*" + tit[1] + ")(void* self);")
                    }
                    k += 1
                }
                println("};")
            }
        }
        i += 1
    }
    // ② impl thunk + 常量
    i = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" && d[3].len > 1 && d[3][0] == "Named" && ct_trait_used_as_ref(file, ty_head(d[2])) {
            var tn2 = ty_head(d[2])
            var cn = d[3][1]
            // 找 trait 方法集(按声明序)
            var tits2 = List[Str]()
            var j3: I32 = 1
            while j3 < file.len {
                if file[j3][0] == "Trait" && seq2(file[j3][1], tn2) {
                    tits2 = file[j3][4]
                }
                j3 += 1
            }
            // thunk(impl 方法接收者=具体型,vtable 槽=void*;桥接)
            // + 方法体发射(standalone fn;thunk 与 vtable 消费)
            var its2 = d[4]
            var k2: I32 = 1
            while k2 < its2.len {
                var it2 = its2[k2]
                if it2[0] == "Method" {
                    // 方法函数体(self 绑定具体型)
                    var mr25 = ct_fn_ret(file, cn + "__" + it2[1])
                    println("static " + ct_ctype(mr25) + " t_" + cn + "__" + it2[1] + "(" + ct_ctype("u:" + cn) + " t_self)")
                    var menv25 = env_bind(env_bind(env_bind(List[Str](), "self", "u:" + cn), "#clofn", cn + "__" + it2[1]), "#p", "2")
                    ct_body(it2[5], menv25, file, mr25)
                    // thunk
                    println("static ct_i vt_thk_" + tn2 + "_" + it2[1] + "_" + cn + "(void* _s) \{ return (ct_i)(long)t_" + cn + "__" + it2[1] + "(*(t_" + cn + "*)_s); }")
                }
                k2 += 1
            }
            // vtable 常量
            println("static const vt_" + tn2 + " vt_" + tn2 + "_for_" + cn + " = \{")
            var k3: I32 = 1
            var first3 = true
            while k3 < tits2.len {
                var tit3 = tits2[k3]
                if tit3[0] == "Method" {
                    if !first3 {
                        println(",")
                    }
                    print("    ." + tit3[1] + " = vt_thk_" + tn2 + "_" + tit3[1] + "_" + cn)
                    first3 = false
                }
                k3 += 1
            }
            println("")
            println("};")
        }
        i += 1
    }
}

// Drop 方法发射(§6.4):impl Drop for T 的 drop 方法 → static void t_<T>__drop(t_<T> t_self)
// 值接收者:作用域出口处绑定行将消亡,字段写不可观察;Atomic 共享单元经指针透写(镜像 eval 免克隆)
fn ct_drop_fn(d: List[Str], file: List[Str], pass: Str) {
    var ftn = ty_head(d[3])
    if d[1].len > 1 && d[1][0] == "TPs" {
        panic("emit:泛型 impl Drop 未支持:" + ftn)
    }
    var mi: I32 = 1
    while mi < d[4].len {
        var it = d[4][mi]
        if it[0] == "Method" && seq2(it[1], "drop") {
            if seq2(pass, "2") {
                println("static void t_" + ftn + "__drop(t_" + ftn + " t_self) ")
            }
            var menv = env_bind(env_bind(env_bind(List[Str](), "self", "u:" + ftn), "#clofn", ftn + "__drop"), "#p", pass)
            ct_body(it[5], menv, file, "v")
        }
        mi += 1
    }
}

// Str 节点 Text 载荷原样拼接(不做转义还原)
fn ct_str_payload(e: List[Str]) -> Str {
    var parts = e[1]
    var acc = ""
    var j: I32 = 1
    while j < parts.len {
        var p = parts[j]
        if p[0] == "Text" { acc = acc + p[1] }
        j += 1
    }
    return acc
}

// 字符串值 → C 字符串字面量(含引号;转义 " 反斜杠 换行 制表 回车)
fn ct_str_cquote(s: Str) -> Str {
    var e = bs()
    var out = "\""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if c == 34 {
            out = out + e + "\""
        } else if c == 92 {
            out = out + e + e
        } else if c == 10 {
            out = out + e + "n"
        } else if c == 9 {
            out = out + e + "t"
        } else if c == 13 {
            out = out + e + "r"
        } else {
            out = out + byte_slice(s, i, i + 1)
        }
        i += 1
    }
    return out + "\""
}

// 输入 main 首个 let read_file(Str 字面量) 的载荷(cc/selfcomp 模块的输入锚);未命中返回 ""
fn ct_find_main_anchor(file: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        // stub/合并面守卫:len < 6 的子节点非 Fn(跳过;P1b stub 的 d[5] 为
        // 类型戳字符串,直入 d[5] 体遍历即崩)
        if d.len <= 5 {
            i += 1
            continue
        }
        if d[0] == "Fn" && d[1] == "main" {
            var b = d[5]
            var k: I32 = 1
            while k < b.len {
                var st = b[k]
                if st[0] == "Let" {
                    var e = st[4]
                    if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "read_file" {
                        if e[2].len > 1 && e[2][1][0] == "Str" {
                            return ct_str_payload(e[2][1])
                        }
                    }
                }
                k += 1
            }
        }
        i += 1
    }
    return ""
}

// 把 main 首个 read_file(Str 字面量) 载荷换为 CLI 标记(发射时改走 ctron_anchor);
// 未命中返回原 file。纯 List 重建:Str→Args→Call→Let→Block→Fn→File。
fn ct_swap_anchor(file: List[Str]) -> List[Str] {
    var mi: I32 = 1
    while mi < file.len {
        var d = file[mi]
        // stub/合并面守卫(同 ct_find_main_anchor)
        if d.len <= 5 {
            mi += 1
            continue
        }
        if d[0] == "Fn" && d[1] == "main" {
            var b = d[5]
            var k: I32 = 1
            while k < b.len {
                var st = b[k]
                if st[0] == "Let" {
                    var e = st[4]
                    if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "read_file" {
                        if e[2].len > 1 && e[2][1][0] == "Str" {
                            var np = List[Str]()
                            np.push("Text")
                            np.push("CTRONCLIINPUT")
                            var nps = List[Str]()
                            nps.push("Parts")
                            nps.push(np)
                            var ns = List[Str]()
                            ns.push("Str")
                            ns.push(nps)
                            var na = List[Str]()
                            na.push("Args")
                            na.push(ns)
                            var nc = List[Str]()
                            nc.push("Call")
                            nc.push(e[1])
                            nc.push(na)
                            var nl = List[Str]()
                            nl.push("Let")
                            nl.push(st[1])
                            nl.push(st[2])
                            nl.push(st[3])
                            nl.push(nc)
                            var nb = List[Str]()
                            nb.push("Block")
                            var j: I32 = 1
                            while j < b.len {
                                if j == k { nb.push(nl) } else { nb.push(b[j]) }
                                j += 1
                            }
                            var nd = List[Str]()
                            nd.push("Fn")
                            nd.push(d[1])
                            nd.push(d[2])
                            nd.push(d[3])
                            nd.push(d[4])
                            nd.push(nb)
                            var nf = List[Str]()
                            nf.push("File")
                            var j2: I32 = 1
                            while j2 < file.len {
                                if j2 == mi { nf.push(nd) } else { nf.push(file[j2]) }
                                j2 += 1
                            }
                            return nf
                        }
                    }
                }
                k += 1
            }
        }
        mi += 1
    }
    return file
}

fn bs() -> Str {
    return "\\"
}
