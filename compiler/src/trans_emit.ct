// =====================================================================
// trans_emit.ct —— 函数发射与文件样板:ct_fn(fn→C 定义,值语义形参/返回)、
// ct_str_payload 字面量载荷、ct_find_main_anchor/ct_swap_anchor main 锚替换、
// bs 样板文本(原型区/运行时助手/无 main 包的测试 main 生成)。
// =====================================================================
// Impl 方法 → 合成 Fn 节点表(名字 t_<ForType>__<method>,self 类型注解
// 缺失时取 impl for 型,值语义 v0)
fn ct_impl_method_fns(d: List[Str]) -> List[Str] {
    var out = List[Str]()
    if d[3].len < 2 || d[3][0] != "Named" {
        return out
    }
    var forh = ty_head(d[3])
    var its = d[4]
    var k: I32 = 1
    while k < its.len {
        var it = its[k]
        if it[0] == "Method" {
            var fnn = mk("Fn")
            fnn.push(forh + "__" + it[1])
            fnn.push(mk("TPs"))
            var nps = mk("Ps")
            var pr: I32 = 1
            while pr < it[3].len {
                var pa = it[3][pr]
                if pa[0] == "Param" && pa[2] == "self" && pa[3][0] == "None" {
                    var stn = mk("Named")
                    stn.push(forh)
                    stn.push(mk("TArgs"))
                    var npa = mk("Param")
                    npa.push(pa[1])
                    npa.push(pa[2])
                    npa.push(stn)
                    nps.push(npa)
                } else {
                    nps.push(pa)
                }
                pr += 1
            }
            fnn.push(nps)
            fnn.push(it[4])
            fnn.push(it[5])
            out.push(fnn)
        }
        k += 1
    }
    return out
}

// ═══ P9 栈面全量:morestack 序言机器(2026-10-03)═══
// A′=分段+钉住+再入续跑:序言检查失败 → rt 切段重入本函数(thunk),返回值
// 拷回原调用点。CTRON_MORESTACK 发射期门(env_get,非空且非 "0"=开);
// main 不注入(宿主栈 OS 自生长)。est=256+96×(Let 节点+形参) 封顶 32768
// ——粗估,真帧超估由 rt 侧 RT_MS_MARGIN+guard 触顶诊断兜底。
// 计划:docs/superpowers/plans/2026-10-03-p9-morestack-machine.md。
fn ct_ms_lets_e(e: List[Str]) -> I32 {
    var t = e[0]
    if t == "BlockExpr" { return ct_ms_lets_b(e[1]) }
    if t == "If" {
        var n: I32 = 0
        if e[2].len > 1 && e[2][0] == "BlockExpr" {
            n = n + ct_ms_lets_b(e[2][1])
        } else {
            n = n + ct_ms_lets_b(e[2])
        }
        if e[3][0] == "If" {
            n = n + ct_ms_lets_e(e[3])
        } else if e[3][0] == "BlockExpr" {
            n = n + ct_ms_lets_b(e[3][1])
        }
        return n
    }
    return 0
}

fn ct_ms_lets_b(b: List[Str]) -> I32 {
    var n: I32 = 0
    var i: I32 = 1
    while i < b.len - 1 {
        var st = b[i]
        var t = st[0]
        if t == "Let" {
            n += 1
        } else if t == "While" {
            n = n + ct_ms_lets_b(st[2])
        } else if t == "For" {
            n = n + ct_ms_lets_b(st[3])
        } else if t == "If" {
            n = n + ct_ms_lets_e(st)
        } else if t == "Match" {
            var mi: I32 = 1
            while mi < st[2].len {
                n = n + ct_ms_lets_e(st[2][mi][2])
                if st[2][mi].len > 3 {
                    n = n + ct_ms_lets_e(st[2][mi][3])
                }
                mi += 1
            }
        }
        i += 1
    }
    if b[b.len - 1][0] != "None" {
        n = n + ct_ms_lets_e(b[b.len - 1])
    }
    return n
}

// 序言机器直出:args 桶 typedef + 再入 thunk(先于函数定义打印),返回序言
// 行(空串=门关/跳过)。d=Fn 节点(具体 fn 或单态化特化合成节点;特化位
// 盒槽形参由调用方先行排除);sym=C 符号全名(ct_fn 位 "t_"+名;特化位 mg,
// 调用方自备前置原型)。
fn ct_ms_pre(sym: Str, d: List[Str], file: List[Str], rc: Str) -> Str {
    var msv = env_get("CTRON_MORESTACK")
    if seq2(msv, "") {
        return ""
    }
    if seq2(msv, "0") {
        return ""
    }
    var fname = d[1]
    if seq2(fname, "main") {
        return ""
    }
    var ps = d[3]
    var tys = List[Str]()
    var nms = List[Str]()
    var k: I32 = 1
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            tys.push(ct_ctype(ct_ty_code(pr[3], file)))
            nms.push("t_" + pr[2])
        }
        k += 1
    }
    var np = nms.len
    // EST 底数计入每函数固定帧开销:发射器为每函数钉 ct_frn(ct_fr = up 8B +
    // pool[128]×16B + pn/ovf/spn + sv[32]×4 ≈ 2196B)+ 被调保存寄存器/对齐
    // ≈ 0x60——本式须与 driver_emit.ct ct_fr typedef 的 pool/sv 尺寸联动,改池
    // 必同步本底数。史鉴:75cb7395 池扩容(32→128)曾使 256 底数低估 2.9KB/帧
    //(帧 848B→3248B),64KB 小栈上检查通过后本帧踏穿 guard = w7 ms_grow 回归
    var est = 2300 + 96 * (ct_ms_lets_b(d[5]) + np)
    if est > 32768 {
        est = 32768
    }
    var anm = sym + "_ms_a"
    var tnm = sym + "_ms"
    if np > 0 {
        var td = "typedef struct \{ "
        var i2: I32 = 0
        while i2 < np {
            td = td + tys[i2] + " f" + i2.to_string() + "; "
            i2 += 1
        }
        td = td + "} " + anm + ";"
        println(td)
    }
    var call = sym + "("
    var i3: I32 = 0
    while i3 < np {
        if i3 > 0 {
            call = call + ", "
        }
        call = call + "p__->f" + i3.to_string()
        i3 += 1
    }
    call = call + ")"
    var unused = ""
    if seq2(rc, "v") {
        unused = "(void)r__; "
    } else if np == 0 {
        unused = "(void)a__; "
    }
    var pre = ""
    if np > 0 {
        pre = anm + "* p__ = (" + anm + "*)a__; "
    }
    var tbody = call + ";"
    if !seq2(rc, "v") {
        tbody = "((" + ct_ctype(rc) + "*)r__)[0] = " + call + ";"
    }
    println("static void " + tnm + "(void* a__, void* r__) \{ " + unused + pre + tbody + " }")
    var ardecl = ""
    var arset = ""
    var growargs = "(void*)0"
    if np > 0 {
        ardecl = anm + " ar__; "
        var i4: I32 = 0
        while i4 < np {
            arset = arset + "ar__.f" + i4.to_string() + " = " + nms[i4] + "; "
            i4 += 1
        }
        growargs = "&ar__"
    }
    var retmid = ""
    if !seq2(rc, "v") {
        retmid = ct_ctype(rc) + " r__; "
    }
    var growret = "(void*)0"
    if !seq2(rc, "v") {
        growret = "&r__"
    }
    var tail = " return;"
    if !seq2(rc, "v") {
        tail = " return r__;"
    }
    return "if (ctron_rt_stk_low(" + est.to_string() + ")) \{ " + ardecl + arset + retmid + "ctron_rt_stk_grow(" + tnm + ", " + growargs + ", " + growret + ");" + tail + " }"
}

fn ct_fn(d: List[Str], file: List[Str], pass: Str) {
    var ps = d[3]
    var k: I32 = 1
    var env = List[Str]()
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            env = env_bind(env, pr[2], ct_ty_code(pr[3], file))
            var elc = ct_opt_elem_strict(file, pr[3])
            if elc.len > 0 {
                env = env_bind(env, "#elem:" + pr[2], elc)
            }
            // P0-3:fn 值形参返回型别侧条目(F<arity> 码不带 R;间接调用/链上成员读解析用)。
            // P0-2/seam② 收窄:标量/Str 返回(R 码非 v/i)亦入码,镜像种子 decl_ty_tc 存槽口径;
            // i 即旧形态无差不入码,v 无值不绑
            if pr[3][0] == "FnType" {
                var frc = ct_ty_code(pr[3][2], file)
                if frc != "v" {
                    if frc != "i" {
                        env = env_bind(env, "#fret:" + pr[2], frc)
                    }
                }
            }
        }
        k += 1
    }
    var rc = ct_fn_ret(file, d[1])
    // P0-2:返回为 fn(A)->R 时绑 '#retfn'(内参码逗号串)——Return 位闭包形参码
    // 注入源(§4.7 自动适配;trans_stmt Return 位临时改绑 #clcodes 消费)
    if d[4].len > 1 && d[4][0] == "FnType" {
        var racc = ""
        var rpi: I32 = 1
        while rpi < d[4][1].len {
            if rpi > 1 {
                racc = racc + ","
            }
            racc = racc + ct_ty_code(d[4][1][rpi], file)
            rpi += 1
        }
        env = env_bind(env, "#retfn", racc)
    }
    // IP-01 W2:#cerr 侧条目 = 本函数 Result 错误侧元素码("u:AnyError" 标记/空)
    //(Err 构造与 ? 传播位的 AnyError 物化判据;env 侧条目随作用域自然贯穿,
    // #elem:#fret 同族。闭包体沿用外层 #cerr = v0 近似,在册)
    var cec = ct_err_elem_of(file, d[4])
    if cec.len > 0 {
        env = env_bind(env, "#cerr", cec)
    }
    if seq2(pass, "2") {
        // P9 栈面全量:序言机器直出(门=CTRON_MORESTACK;main 除外)
        var mspro = ct_ms_pre("t_" + d[1], d, file, rc)
        println(ct_ctype(rc) + " t_" + d[1] + "(" + ct_params_str(d, file) + ") ")
        if mspro.len > 0 {
            env = env_bind(env, "#mspro", mspro)
        }
    }
    // T31 M1.5:帧节点序言+指针族形参注册(#frpro;ct_body 花括号后直出)
    var frp = ct_fr_prologue()
    var fpk: I32 = 1
    var fpi: I32 = 0
    while fpk < ps.len {
        var fp2 = ps[fpk]
        if fp2[0] == "Param" {
            var frl = ct_reg_line(fp2[2], ct_ty_code(fp2[3], file))
            if frl.len > 0 {
                frp = frp + " " + frl
            }
            fpi += 1
        }
        fpk += 1
    }
    // 闭包命名前缀:ct_clo_<fn>_L<行>(跨文件合并下行号撞号,fn 名合并面唯一)
    env = env_bind(env, "#clofn", d[1])
    var penv = env_bind(env_bind(env, "#p", pass), "#frpro", frp)
    ct_body(d[5], penv, file, rc)
}

// 自由型参判别(v1 启发式):单大写名 = 泛型占位(T/S/K/V 惯例;语言面禁
// 单大写具体型)。判例:15 层 or2 嵌套 = seed eval 静默死,守卫用平面 if 链。
fn ct_is_type_param_name(n: Str) -> Bool {
    if n.len != 1 {
        return false
    }
    var c0 = byte_at(n, 0)
    if c0 >= 65 && c0 <= 90 {
        return true
    }
    return false
}

// T25:trait 是否被引用为 &Trait 参数(仅这些产 vtable;Drop/UFCS 走既有路径)
fn ct_trait_used_as_ref(file: List[Str], tn: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if or2(d[0] == "Fn", or2(d[0] == "FnPub", d[0] == "Method")) {
            var ps = d[3]
            var k: I32 = 1
            while k < ps.len {
                var pr = ps[k]
                if pr[0] == "Param" && pr[3][0] == "Ref" {
                    if pr[3][1].len > 1 && pr[3][1][0] == "Named" {
                        if seq2(pr[3][1][1], tn) {
                            return true
                        }
                    }
                }
                k += 1
            }
        }
        i += 1
    }
    return false
}

// T25 &Trait vtable 发射(§3.5):trait 方法槽结构 + impl thunk + 常量
fn ct_vtable_emit(file: List[Str]) {
    // ① trait 方法槽结构(仅有 impl 的 trait)
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Trait" {
            var tn = d[1]
            // P3/iter-T16 v2 定界:泛型 trait(TPs 非空)的共享 vtable = 构造性
            // ill-typed——槽型含 TPAr 默认码(t_MapSeq__II 无 typedef 可引用,
            // cc 硬错),真面 = per-instance vtable(v2 设计位批)。树内零
            // &Seq 胖指针用户(实测)→ 泛型 trait 跳过 vt 发射(impl 方法
            // standalone fn 与 UFCS 直调面不受涉);非泛型 trait 保持原样。
            var tpgen = d[2].len > 1
            var has_impl = ct_trait_used_as_ref(file, tn)
            var j: I32 = 1
            while j < file.len && !has_impl {
                if file[j][0] == "Impl" && seq2(ty_head(file[j][2]), tn) {
                    has_impl = true
                }
                j += 1
            }
            if has_impl && !tpgen {
                println("typedef struct vt_" + tn + " vt_" + tn + ";")
                println("struct vt_" + tn + " \{")
                var tits = d[4]
                var k: I32 = 1
                while k < tits.len {
                    var tit = tits[k]
                    if tit[0] == "Method" {
                        // T26 全签名槽:trait 声明位取返回码+非 self 形参
                        //(v1 面=恒 ct_i 单 self 槽的扩展;§3.5 方法槽序=声明序)
                        var r26 = tit[4]
                        var ret26 = "i"
                        if r26[0] == "None" {
                            ret26 = "v"
                        } else {
                            ret26 = ct_ty_code(r26, file)
                        }
                        var sl26 = "    " + ct_ctype(ret26) + " (*" + tit[1] + ")(void* self"
                        var ps26 = tit[3]
                        var pi26: I32 = 1
                        while pi26 < ps26.len {
                            if ps26[pi26][0] == "Param" && ps26[pi26][2] != "self" {
                                sl26 = sl26 + ", " + ct_ctype(ct_ty_code(ps26[pi26][3], file))
                            }
                            pi26 += 1
                        }
                        println(sl26 + ");")
                    }
                    k += 1
                }
                println("};")
            }
        }
        i += 1
    }
    // ② impl thunk + 常量
    // iter-T16 v2 径A:方法体恒发射(UFCS 具体分派引用,旧 used_as_ref 连坐
    // 致 t_<T>__<m> 未定义硬错);Thunk/槽/常量 = vt 面,仅胖指用户在册时发射。
    // 泛型 trait impl 不再跳——vt struct+常量 = per-instance(实例后缀 =
    // trait targs encode,与 ty 码 t:<Trait>__<enc> 同名;#ifndef 守卫
    // dedupe 多 impl 同 targs)
    i = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" && d[3].len > 1 && d[3][0] == "Named" {
            var tn2 = ty_head(d[2])
            // trait targs 具体性守卫:含未解析名(iter.ct 旧式自由型参 T/S)
            // → 排异(体归单态化道;占位码签名 ill-typed 防线)
            var conc26 = true
            if d[2].len > 2 && d[2][2].len > 1 {
                var k27: I32 = 1
                while k27 < d[2][2].len {
                    var tg27 = d[2][2][k27]
                    if tg27[0] == "Named" {
                        if ct_is_type_param_name(tg27[1]) {
                            conc26 = false
                        }
                    }
                    k27 += 1
                }
            }
            // Drop impl 排异:方法体归 ct_drop_fn 专道(§6.4),此处重发 = 重定义
            // impl 自身泛型(TPs 非空,iter.ct 的 Seq[T,…] 族)排异:体归单态化
            // 专用道,此处签名 T/S 落占位码 ill-typed(旧 skip9 同域)
            if tn2.len > 0 && !seq2(tn2, "Drop") && !(d[1].len > 1 && d[1][0] == "TPs") && conc26 {
            var cn = d[3][1]
            var vtref26 = ct_trait_used_as_ref(file, tn2)
            // 实例后缀:impl 的 trait targs(Seq[I32] → __I;非泛型 = 空串,码面不变)
            var vtbase26 = tn2
            var tpgen26 = false
            if d[2].len > 2 && d[2][2].len > 1 {
                tpgen26 = true
                var suf26 = ""
                var k26: I32 = 1
                while k26 < d[2][2].len {
                    suf26 = suf26 + ct_inst_encode(ct_ty_code(d[2][2][k26], file))
                    k26 += 1
                }
                vtbase26 = tn2 + "__" + suf26
            }
            // 找 trait 方法集(按声明序)
            var tits2 = List[Str]()
            var j3: I32 = 1
            while j3 < file.len {
                if file[j3][0] == "Trait" && seq2(file[j3][1], tn2) {
                    tits2 = file[j3][4]
                }
                j3 += 1
            }
            // thunk(impl 方法接收者=具体型,vtable 槽=void* self+非 self 形参;桥接)
            // + 方法体发射(standalone fn 全签名,thunk 与 vtable 消费;T26 带参形)
            var its2 = d[4]
            var slots26 = List[Str]()
            var k2: I32 = 1
            while k2 < its2.len {
                var it2 = its2[k2]
                if it2[0] == "Method" {
                    var r26b = it2[4]
                    var mr25 = "i"
                    if r26b[0] == "None" {
                        mr25 = "v"
                    } else {
                        mr25 = ct_ty_code(r26b, file)
                    }
                    // 非 self 形参:签名串 + env 绑定 + thunk 串三用一遍收集
                    // (形参名保留原名:方法体按 t_<原名> 引用,env 绑定原名→型码)
                    var ps26b = it2[3]
                    var sigx = ""
                    var thunkp = ""
                    var thunke = ""
                    var menv25 = env_bind(env_bind(env_bind(List[Str](), "self", "u:" + cn), "#clofn", cn + "__" + it2[1]), "#p", "2")
                    var pi26b: I32 = 1
                    while pi26b < ps26b.len {
                        if ps26b[pi26b][0] == "Param" && ps26b[pi26b][2] != "self" {
                            var pc26 = ct_ty_code(ps26b[pi26b][3], file)
                            var pn26 = ps26b[pi26b][2]
                            var cpn26 = "t_" + pn26
                            sigx = sigx + ", " + ct_ctype(pc26) + " " + cpn26
                            thunkp = thunkp + ", " + ct_ctype(pc26) + " " + cpn26
                            thunke = thunke + ", " + cpn26
                            menv25 = env_bind(menv25, pn26, pc26)
                        }
                        pi26b += 1
                    }
                    // 方法函数体(self 绑定具体型)
                    println("static " + ct_ctype(mr25) + " t_" + cn + "__" + it2[1] + "(" + ct_ctype("u:" + cn) + " t_self" + sigx + ")")
                    // T31 M1.5:方法帧(self=u: 值结构体 kind1+指针族形参)
                    var mfrp25 = ct_fr_prologue() + " " + ct_reg_line("self", "u:" + cn)
                    var mpi25: I32 = 1
                    var mi25: I32 = 0
                    while mpi25 < ps26b.len {
                        if ps26b[mpi25][0] == "Param" && ps26b[mpi25][2] != "self" {
                            var mrl25 = ct_reg_line(ps26b[mpi25][2], ct_ty_code(ps26b[mpi25][3], file))
                            if mrl25.len > 0 {
                                mfrp25 = mfrp25 + " " + mrl25
                            }
                            mi25 += 1
                        }
                        mpi25 += 1
                    }
                    menv25 = env_bind(menv25, "#frpro", mfrp25)
                    ct_body(it2[5], menv25, file, mr25)
                    // thunk(vt 面专用,仅胖指用户在册时发射)
                    if vtref26 {
                        if seq2(mr25, "v") {
                            println("static void vt_thk_" + tn2 + "_" + it2[1] + "_" + cn + "(void* _s" + thunkp + ") \{ t_" + cn + "__" + it2[1] + "(*(t_" + cn + "*)_s" + thunke + "); }")
                        } else {
                            println("static " + ct_ctype(mr25) + " vt_thk_" + tn2 + "_" + it2[1] + "_" + cn + "(void* _s" + thunkp + ") \{ return t_" + cn + "__" + it2[1] + "(*(t_" + cn + "*)_s" + thunke + "); }")
                        }
                        if tpgen26 {
                            // per-instance vt 槽(具体签型;self 擦除为 void*)
                            slots26.push("    " + ct_ctype(mr25) + " (*" + it2[1] + ")(void* self" + sigx + ");")
                        }
                    }
                }
                k2 += 1
            }
            // vtable 常量(vt 面):泛型 = per-instance(vt_<Trait>__<enc>_for_<Type>,
            // struct #ifndef 守卫先行);非泛型 = 旧名 vt_<Trait>_for_<Type> 不变
            if vtref26 {
                if tpgen26 {
                    println("#ifndef CT_VTDEF_" + vtbase26)
                    println("#define CT_VTDEF_" + vtbase26)
                    println("typedef struct vt_" + vtbase26 + " vt_" + vtbase26 + ";")
                    println("struct vt_" + vtbase26 + " \{")
                    var s26: I32 = 0
                    while s26 < slots26.len {
                        println(slots26[s26])
                        s26 += 1
                    }
                    println("};")
                    println("#endif")
                }
                println("static const vt_" + vtbase26 + " vt_" + vtbase26 + "_for_" + cn + " = \{")
                var k3: I32 = 1
                var first3 = true
                while k3 < tits2.len {
                    var tit3 = tits2[k3]
                    if tit3[0] == "Method" {
                        if !first3 {
                            println(",")
                        }
                        print("    ." + tit3[1] + " = vt_thk_" + tn2 + "_" + tit3[1] + "_" + cn)
                        first3 = false
                    }
                    k3 += 1
                }
                println("")
                println("};")
            }
            }
        }
        i += 1
    }
}

// Drop 方法发射(§6.4):impl Drop for T 的 drop 方法 → static void t_<T>__drop(t_<T> t_self)
// 值接收者:作用域出口处绑定行将消亡,字段写不可观察;Atomic 共享单元经指针透写(镜像 eval 免克隆)
fn ct_drop_fn(d: List[Str], file: List[Str], pass: Str) {
    var ftn = ty_head(d[3])
    if d[1].len > 1 && d[1][0] == "TPs" {
        panic("emit:泛型 impl Drop 未支持:" + ftn)
    }
    var mi: I32 = 1
    while mi < d[4].len {
        var it = d[4][mi]
        if it[0] == "Method" && seq2(it[1], "drop") {
            if seq2(pass, "2") {
                println("static void t_" + ftn + "__drop(t_" + ftn + " t_self) ")
            }
            var menv = env_bind(env_bind(env_bind(List[Str](), "self", "u:" + ftn), "#clofn", ftn + "__drop"), "#p", pass)
            // T31 M1.5:drop 帧(self=u: 值结构体 kind1)
            menv = env_bind(menv, "#frpro", ct_fr_prologue() + " " + ct_reg_line("self", "u:" + ftn))
            ct_body(it[5], menv, file, "v")
        }
        mi += 1
    }
}

// Str 节点 Text 载荷原样拼接(不做转义还原)
fn ct_str_payload(e: List[Str]) -> Str {
    var parts = e[1]
    var acc = ""
    var j: I32 = 1
    while j < parts.len {
        var p = parts[j]
        if p[0] == "Text" { acc = acc + p[1] }
        j += 1
    }
    return acc
}

// 字符串值 → C 字符串字面量(含引号;转义 " 反斜杠 换行 制表 回车)
fn ct_str_cquote(s: Str) -> Str {
    var e = bs()
    var out = "\""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if c == 34 {
            out = out + e + "\""
        } else if c == 92 {
            out = out + e + e
        } else if c == 10 {
            out = out + e + "n"
        } else if c == 9 {
            out = out + e + "t"
        } else if c == 13 {
            out = out + e + "r"
        } else {
            out = out + byte_slice(s, i, i + 1)
        }
        i += 1
    }
    return out + "\""
}

// 输入 main 首个 let read_file(Str 字面量) 的载荷(cc/selfcomp 模块的输入锚);未命中返回 ""
fn ct_find_main_anchor(file: List[Str]) -> Str {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        // stub/合并面守卫:len < 6 的子节点非 Fn(跳过;P1b stub 的 d[5] 为
        // 类型戳字符串,直入 d[5] 体遍历即崩)
        if d.len <= 5 {
            i += 1
            continue
        }
        if d[0] == "Fn" && d[1] == "main" {
            var b = d[5]
            var k: I32 = 1
            while k < b.len {
                var st = b[k]
                if st[0] == "Let" {
                    var e = st[4]
                    if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "read_file" {
                        if e[2].len > 1 && e[2][1][0] == "Str" {
                            return ct_str_payload(e[2][1])
                        }
                    }
                }
                k += 1
            }
        }
        i += 1
    }
    return ""
}

// 把 main 首个 read_file(Str 字面量) 载荷换为 CLI 标记(发射时改走 ctron_anchor);
// 未命中返回原 file。纯 List 重建:Str→Args→Call→Let→Block→Fn→File。
fn ct_swap_anchor(file: List[Str]) -> List[Str] {
    var mi: I32 = 1
    while mi < file.len {
        var d = file[mi]
        // stub/合并面守卫(同 ct_find_main_anchor)
        if d.len <= 5 {
            mi += 1
            continue
        }
        if d[0] == "Fn" && d[1] == "main" {
            var b = d[5]
            var k: I32 = 1
            while k < b.len {
                var st = b[k]
                if st[0] == "Let" {
                    var e = st[4]
                    if e[0] == "Call" && e[1][0] == "Ident" && e[1][1] == "read_file" {
                        if e[2].len > 1 && e[2][1][0] == "Str" {
                            var np = List[Str]()
                            np.push("Text")
                            np.push("CTRONCLIINPUT")
                            var nps = List[Str]()
                            nps.push("Parts")
                            nps.push(np)
                            var ns = List[Str]()
                            ns.push("Str")
                            ns.push(nps)
                            var na = List[Str]()
                            na.push("Args")
                            na.push(ns)
                            var nc = List[Str]()
                            nc.push("Call")
                            nc.push(e[1])
                            nc.push(na)
                            var nl = List[Str]()
                            nl.push("Let")
                            nl.push(st[1])
                            nl.push(st[2])
                            nl.push(st[3])
                            nl.push(nc)
                            var nb = List[Str]()
                            nb.push("Block")
                            var j: I32 = 1
                            while j < b.len {
                                if j == k { nb.push(nl) } else { nb.push(b[j]) }
                                j += 1
                            }
                            var nd = List[Str]()
                            nd.push("Fn")
                            nd.push(d[1])
                            nd.push(d[2])
                            nd.push(d[3])
                            nd.push(d[4])
                            nd.push(nb)
                            var nf = List[Str]()
                            nf.push("File")
                            var j2: I32 = 1
                            while j2 < file.len {
                                if j2 == mi { nf.push(nd) } else { nf.push(file[j2]) }
                                j2 += 1
                            }
                            return nf
                        }
                    }
                }
                k += 1
            }
        }
        mi += 1
    }
    return file
}

fn bs() -> Str {
    return "\\"
}
