// =====================================================================

// eval_val.ct —— 值域基础:进制字面量解析(digit_of/txt_num/dvi)、值构造器

// (vI/vB/vS/vV2/vL/vdeep,V 标签定义处)、truth/veq/scmp/vcmp 真值·相等·序、

// ari/val_arith 算术分派。宽度域与 Float 域见 eval_width/eval_float.ct。

// =====================================================================

// ---------------- 数值与文本基础(进制字面量/digit_of/txt_num) ----------------

fn digit_of(c: I32) -> I32 {

    if c >= 48 && c <= 57 { return c - 48 }

    if c >= 97 && c <= 102 { return c - 97 + 10 }

    if c >= 65 && c <= 70 { return c - 65 + 10 }

    return 0

}

fn txt_num(t: Str) -> I32 {

    // 支持 0x/0b/0o/十进制(去下划线)

    var i: I32 = 0

    var n = t.len

    var radix: I32 = 10

    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 120 {

        radix = 16

        i = 2

    }

    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 111 {

        radix = 8

        i = 2

    }

    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 98 {

        radix = 2

        i = 2

    }

    var acc7 = "0"

    var rtxt = dvi_str(radix)

    while i < n {

        var c = byte_at(t, i)

        if c == 95 {

            i += 1

        } else {

            acc7 = c6add(c6mul(acc7, rtxt), dvi_str(digit_of(c)))

            i += 1

        }

    }

    return wrap_i32(acc7)

}

// I32 数值 → 十进制文本(dvi 的逆;免 to_string 分派)
fn dvi_str(v: I32) -> Str {

    if v == 0 {

        return "0"

    }

    var neg = false

    var x = v

    if x < 0 {

        neg = true

        x = 0 - x

    }

    var d = ""

    while x > 0 {

        var q: I32 = x / 10

        var r: I32 = x - q * 10

        d = byte_slice("0123456789", r, r + 1) + d

        x = q

    }

    if neg {

        return "-" + d

    }

    return d

}

// 十进制文本(非负)→ 规范 I32 文本:先模 2^32,≥2^31 折回负半区
fn wrap_i32(u: Str) -> I32 {

    var m = c6can(u)

    if m.len > 0 {

        if byte_at(m, 0) == 45 {

            m = byte_slice(m, 1, m.len)

        }

    }

    var qr = c6divmod(m, "4294967296")

    var bar: I32 = 0

    var ci: I32 = 0

    while ci < qr.len {

        if byte_at(qr, ci) == 124 {

            bar = ci

        }

        ci += 1

    }

    var r = byte_slice(qr, bar + 1, qr.len)

    if c6abscmp(r, "2147483647") > 0 {

        r = c6sub(r, "4294967296")

    }

    return dvi(r)

}

// ---------------- 树行走求值器(表达式/语句/作用域/控制流) ----------------

// 值 = List[Str]:[0]=类别 I(Int文本)/B(true|false)/S(文本)/V(void)/R(range)

// env = 绑定 List(新在前);表达式求值线程 env/out;返回 [flow,env,val,out]

// flow:k 正常 / r return / a 断言失败;run_stmt/run_block 返回 [flow,env,out,val]



fn vI(x: I32) -> List[Str] {

    var v = List[Str]()

    v.push("I")

    v.push(x.to_string())

    return v

}

fn vB(b: Bool) -> List[Str] {

    var v = List[Str]()

    v.push("B")

    if b {

        v.push("true")

    } else {

        v.push("false")

    }

    return v

}

fn vS(s: Str) -> List[Str] {

    var v = List[Str]()

    v.push("S")

    v.push(s)

    return v

}

fn vV2() -> List[Str] {

    var v = List[Str]()

    v.push("V")

    return v

}

// C9f①:List 域 —— 客体 List 直接持有宿主 List 对象(引用语义,push 原地变、别名可见,

// 镜像 rt.c listnode);布局 ["L", item…](同 A:类别槽后逐元素)。

fn vL() -> List[Str] {

    var v = List[Str]()

    v.push("L")

    return v

}

// into_gc 深拷贝(镜像 rt.c clone_val):按种类分发,U 域名/值交错、A/L 值槽递归,

// 标量/T/F/C 逐槽重建(槽内容不窥探 —— 字符串载荷不可索引)

fn vdeep(v: List[Str]) -> List[Str] {

    var k0 = v[0]

    // M(Atomic/Global 共享单元)保持身份:克隆不得切断别名

    if k0 == "M" {

        return v

    }

    if k0 == "U" {

        var ou = List[Str]()

        ou.push("U")

        ou.push(v[1])

        var iu: I32 = 2

        while iu + 1 < v.len {

            ou.push(v[iu])

            ou.push(vdeep(v[iu + 1]))

            iu += 2

        }

        return ou

    }

    if or2(k0 == "A", k0 == "L") {

        var oa = List[Str]()

        oa.push(k0)

        var ia: I32 = 1

        while ia < v.len {

            oa.push(vdeep(v[ia]))

            ia += 1

        }

        return oa

    }

    var out = List[Str]()

    out.push(v[0])

    var i: I32 = 1

    while i < v.len {

        out.push(v[i])

        i += 1

    }

    return out

}

fn dvi(t: Str) -> I32 {

    // P1-B:十进制文本 → I32。"7" 域文本精确累加 → mod 2^32 → 负半区折回 →
    // MIN 特判(0-2147483647-1 惯用法)→ 幅值安全累加(免界门/免递归)

    var neg = false

    var k: I32 = 0

    if t.len > 0 && byte_at(t, 0) == 45 {

        neg = true

        k = 1

    }

    var acc7 = "0"

    while k < t.len {

        acc7 = c6add(c6mul(acc7, "10"), dvi_str(digit_of(byte_at(t, k))))

        k += 1

    }

    var qr = c6divmod(acc7, "4294967296")

    var bar: I32 = 0

    var ci: I32 = 0

    while ci < qr.len {

        if byte_at(qr, ci) == 124 {

            bar = ci

        }

        ci += 1

    }

    var r = byte_slice(qr, bar + 1, qr.len)

    if neg {

        if r != "0" {

            r = c6sub("4294967296", r)

        }

    }

    if c6abscmp(r, "2147483647") > 0 {

        r = "-" + c6sub("4294967296", r)

    }

    if seq2(r, "-2147483648") {

        return 0 - 2147483647 - 1

    }

    var res: I32 = 0

    var k2: I32 = 0

    var neg2 = false

    if r.len > 0 && byte_at(r, 0) == 45 {

        neg2 = true

        k2 = 1

    }

    while k2 < r.len {

        res = res * 10 + digit_of(byte_at(r, k2))

        k2 += 1

    }

    if neg2 {

        res = 0 - res

    }

    return res

}

fn truth(v: List[Str]) -> Bool {

    var k = v[0]

    if k == "B" {

        return seq2(v[1], "true")

    }

    if k == "I" {

        return dvi(v[1]) != 0

    }

    if k == "D" {

        return v[1] != "0"

    }

    return true

}

fn veq(a: List[Str], b: List[Str]) -> Bool {

    var ka = a[0]

    var kb = b[0]

    if or2(ka == "D", kb == "D") {

        return vcmp(a, b) == 0

    }

    if ka == "I" && kb == "I" {

        return dvi(a[1]) == dvi(b[1])

    }
    if or2(ka == "6", kb == "6") {
        return c6cmp(c6can(a[1]), c6can(b[1])) == 0
    }
    if or2(ka == "7", kb == "7") {
        return vcmp(a, b) == 0
    }
    if or2(ka == "W", kb == "W") {

        if or2(ka == "I", ka == "W") && or2(kb == "I", kb == "W") {

            return dvi(a[1]) == dvi(b[1])

        }

        return false

    }

    if ka == "B" && kb == "B" {

        return seq2(a[1], b[1])

    }

    if ka == "S" && kb == "S" {

        return seq2(a[1], b[1])

    }

    if ka == "T" && kb == "T" {

        // Option/Result 结构相等:变体同名 + 载荷递归 veq(None/Err 无载荷)

        if !seq2(a[1], b[1]) {

            return false

        }

        if a.len == 3 {

            if b.len != 3 {

                return false

            }

            return veq(a[2], b[2])

        }

        return b.len == 2

    }

    return false

}

fn scmp(a: Str, b: Str) -> I32 {

    var n = a.len

    if b.len < n {

        n = b.len

    }

    var i: I32 = 0

    while i < n {

        var x = byte_at(a, i)

        var y = byte_at(b, i)

        if x < y {

            return -1

        }

        if x > y {

            return 1

        }

        i += 1

    }

    if a.len < b.len {

        return -1

    }

    if a.len > b.len {

        return 1

    }

    return 0

}

// ---------------- I64 域(值 ["6", 规范十进制文本];符号支持) ----------------

fn v6(t: Str) -> List[Str] {

    var v = List[Str]()

    v.push("6")

    v.push(t)

    return v

}

// U64/USize 域(P1-B):["7", 无符号十进制文本],0..2^64-1 精确承载
fn v7(t: Str) -> List[Str] {

    var v = List[Str]()

    v.push("7")

    v.push(c6can(t))

    return v

}



fn c6can(t: Str) -> Str {

    var neg = false

    var i: I32 = 0

    if t.len > 0 {

        if byte_at(t, 0) == 45 {

            neg = true

            i = 1

        }

    }

    var strip = true

    while strip {

        if i >= t.len - 1 {

            strip = false

        } else {

            if byte_at(t, i) != 48 {

                strip = false

            } else {

                i += 1

            }

        }

    }

    var m = byte_slice(t, i, t.len)

    if neg {

        if m == "0" {

            return "0"

        }

        return "-" + m

    }

    if m == "" {

        return "0"

    }

    return m

}



fn c6abscmp(a: Str, b: Str) -> I32 {

    if a.len != b.len {

        if a.len > b.len {

            return 1

        }

        return -1

    }

    var i: I32 = 0

    while i < a.len {

        var x = byte_at(a, i)

        var y = byte_at(b, i)

        if x > y {

            return 1

        }

        if x < y {

            return -1

        }

        i += 1

    }

    return 0

}



// 字面量域判定(§3.1.1):进制识别/十进制归一/超 I32 宽度;下划线分隔符剥离
fn lit_digits(t: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < t.len {
        var c = byte_at(t, i)
        if c != 95 {
            out = out + byte_slice(t, i, i + 1)
        }
        i += 1
    }
    return out
}

// int64 界门(§4.5 检查算术):规范十进制文本是否落在 [MIN, MAX];
// 发射侧 ctron_i64_* 帮手镜像
// U64 界门(P1-B):非负且 ≤ 2^64-1
fn c6_in_u64(r: Str) -> Bool {
    if r.len > 0 {
        if byte_at(r, 0) == 45 {
            return false
        }
    }
    return c6abscmp(r, "18446744073709551615") <= 0
}

fn c6_in_i64(r: Str) -> Bool {    var neg = false
    var m = r
    if m.len > 0 {
        if byte_at(m, 0) == 45 {
            neg = true
            m = byte_slice(m, 1, m.len)
        }
    }
    if neg {
        return c6abscmp(m, "9223372036854775808") <= 0
    }
    return c6abscmp(m, "9223372036854775807") <= 0
}

fn lit_is_dec(t: Str) -> Bool {
    if t.len > 1 {
        if byte_at(t, 0) == 48 {
            var c2 = byte_at(t, 1)
            if or2(c2 == 120, or2(c2 == 111, c2 == 98)) {
                return false
            }
        }
    }
    return true
}

// 0x/0o/0b 字面量 → 规范十进制文本(逐位 acc*radix+d,c6 文本域算术)
fn lit_radix_dec(t: Str) -> Str {
    var radix: I32 = 16
    if byte_at(t, 1) == 111 {
        radix = 8
    }
    if byte_at(t, 1) == 98 {
        radix = 2
    }
    var rs = "16"
    if radix == 8 {
        rs = "8"
    }
    if radix == 2 {
        rs = "2"
    }
    var acc = "0"
    var i: I32 = 2
    while i < t.len {
        var c = byte_at(t, i)
        if c != 95 {
            var dv = digit_of(c)
            acc = c6add(c6mul(acc, rs), byte_slice("00010203040506070809101112131415", dv * 2, dv * 2 + 2))
        }
        i += 1
    }
    return c6can(acc)
}

// 字面量 → 规范十进制文本(十进制剥下划线;进制转十进制)
fn lit_to_dec(t: Str) -> Str {
    if lit_is_dec(t) {
        return c6can(lit_digits(t))
    }
    return lit_radix_dec(t)
}

fn lit_wide_i32(t: Str) -> Bool {
    return c6abscmp(lit_to_dec(t), "2147483647") > 0
}

fn c6cmp(a: Str, b: Str) -> I32 {

    var aneg = false

    var bneg = false

    if a.len > 0 {

        if byte_at(a, 0) == 45 {

            aneg = true

        }

    }

    if b.len > 0 {

        if byte_at(b, 0) == 45 {

            bneg = true

        }

    }

    if aneg {

        if bneg {

            return c6abscmp(b, a)

        }

        return -1

    }

    if bneg {

        return 1

    }

    return c6abscmp(a, b)

}



fn c6add(a: Str, b: Str) -> Str {
    var aneg = false
    var bneg = false
    if a.len > 0 {
        if byte_at(a, 0) == 45 {
            aneg = true
        }
    }
    if b.len > 0 {
        if byte_at(b, 0) == 45 {
            bneg = true
        }
    }
    var am = c6can(a)
    var bm = c6can(b)
    if aneg {
        am = byte_slice(am, 1, am.len)
    }
    if bneg {
        bm = byte_slice(bm, 1, bm.len)
    }
    if aneg {
        if bneg {
            return "-" + c6addmag(am, bm)
        }
        return c6submag(bm, am)
    }
    if bneg {
        return c6submag(am, bm)
    }
    return c6addmag(am, bm)
}

// 非负十进制加法(核心,无符号处理)
fn c6addmag(a: Str, b: Str) -> Str {
    var out = ""

    var ia = a.len

    var ib = b.len

    var carry: I32 = 0

    while ia > 0 {

        ia -= 1

        var d = byte_at(a, ia) - 48 + carry

        if ib > 0 {

            ib -= 1

            d += byte_at(b, ib) - 48

        }

        if d > 9 {

            d -= 10

            carry = 1

        } else {

            carry = 0

        }

        out = byte_slice("0123456789", d, d + 1) + out

    }

    while ib > 0 {

        ib -= 1

        var d2 = byte_at(b, ib) - 48 + carry

        if d2 > 9 {

            d2 -= 10

            carry = 1

        } else {

            carry = 0

        }

        out = byte_slice("0123456789", d2, d2 + 1) + out

    }

    if carry == 1 {

        out = "1" + out

    }

    return c6can(out)

}



fn c6submag(a: Str, b: Str) -> Str {

    var out = ""

    var ia = a.len

    var ib = b.len

    var borrow: I32 = 0

    while ia > 0 {

        ia -= 1

        var d = byte_at(a, ia) - 48 - borrow

        if ib > 0 {

            ib -= 1

            d -= byte_at(b, ib) - 48

        }

        if d < 0 {

            d += 10

            borrow = 1

        } else {

            borrow = 0

        }

        out = byte_slice("0123456789", d, d + 1) + out

    }

    return c6can(out)

}



fn c6sub(a: Str, b: Str) -> Str {

    var aneg = false

    var bneg = false

    if a.len > 0 {

        if byte_at(a, 0) == 45 {

            aneg = true

        }

    }

    if b.len > 0 {

        if byte_at(b, 0) == 45 {

            bneg = true

        }

    }

    if or2(aneg, bneg) {

        if aneg {

            if bneg {

                return c6sub(byte_slice(a, 1, a.len), byte_slice(b, 1, b.len))

            }

            return "-" + c6add(byte_slice(a, 1, a.len), b)

        }

        return c6add(a, byte_slice(b, 1, b.len))

    }

    var c = c6abscmp(a, b)

    if c == 0 {

        return "0"

    }

    if c > 0 {

        return c6submag(a, b)

    }

    return "-" + c6submag(b, a)

}

// 非负竖式乘法(逐位乘累加;单步数值 <= 89,I32 安全)
fn c6mul(a: Str, b: Str) -> Str {
    var acc = "0"
    var ib = b.len
    while ib > 0 {
        ib -= 1
        var d = byte_at(b, ib) - 48
        var part = ""
        var carry: I32 = 0
        var ia = a.len
        while ia > 0 {
            ia -= 1
            var p = (byte_at(a, ia) - 48) * d + carry
            carry = p / 10
            part = byte_slice("0123456789", p % 10, p % 10 + 1) + part
        }
        while carry > 0 {
            part = byte_slice("0123456789", carry % 10, carry % 10 + 1) + part
            carry = carry / 10
        }
        var zeros = b.len - 1 - ib
        var z: I32 = 0
        while z < zeros {
            part = part + "0"
            z += 1
        }
        acc = c6add(acc, part)
    }
    return c6can(acc)
}

// 长除试商:返回 "商|余数"(复合串,镜像 ct_struct_inst_split 先例)
fn c6divmod(a: Str, b: Str) -> Str {
    var q = ""
    var rem = "0"
    var i: I32 = 0
    while i < a.len {
        // rem * 10 + digit(a[i])(文本拼接即十进制左移)
        rem = c6can(rem + byte_slice(a, i, i + 1))
        var qd: I32 = 0
        while c6abscmp(rem, b) >= 0 {
            rem = c6submag(rem, b)
            qd += 1
        }
        q = q + byte_slice("0123456789", qd, qd + 1)
        i += 1
    }
    return q + "|" + rem
}

fn vcmp(a: List[Str], b: List[Str]) -> I32 {

    if a[0] == "S" && b[0] == "S" {

        return scmp(a[1], b[1])

    }

    if or2(a[0] == "D", b[0] == "D") {

        return df_vcmp(a[1], b[1])

    }

    if or2(a[0] == "6", or2(b[0] == "6", or2(a[0] == "I", b[0] == "I"))) {

        if or2(a[0] == "6", b[0] == "6") {

            var at = a[1]

            var bt = b[1]

            if a[0] == "I" {

                at = dvi(a[1]).to_string()

            }

            if b[0] == "I" {

                bt = dvi(b[1]).to_string()

            }

            return c6cmp(at, bt)

        }

    }

    // U64/USize 比较域(P1-B):同域/跨 I/6 直文本幅值比较(负值混比语料避,挂账)
    if or2(a[0] == "7", b[0] == "7") {

        var at7 = a[1]

        var bt7 = b[1]

        if a[0] == "W" {

            at7 = dvi(a[1]).to_string()

        }

        if b[0] == "W" {

            bt7 = dvi(b[1]).to_string()

        }

        return c6abscmp(at7, bt7)

    }

    var x = dvi(a[1])

    var y = dvi(b[1])

    if x < y {

        return -1

    }

    if x > y {

        return 1

    }

    return 0

}

fn ari(op: Str, x: I32, y: I32) -> I32 {

    if op == "Add" {

        return x + y

    }

    if op == "Sub" {

        return x - y

    }

    if op == "Mul" {

        return x * y

    }

    if op == "Div" {

        return x / y

    }

    if op == "Mod" {

        return x % y

    }

    if op == "WrapAdd" {

        return x + y

    }

    if op == "WrapSub" {

        return x - y

    }

    if op == "AddEq" {

        return x + y

    }

    if op == "SubEq" {

        return x - y

    }

    if op == "MulEq" {

        return x * y

    }

    if op == "DivEq" {

        return x / y

    }

    if op == "ModEq" {

        return x % y

    }

    return 0

}

fn val_arith(op: Str, a: List[Str], b: List[Str]) -> List[Str] {

    if or2(a[0] == "D", b[0] == "D") {

        return vD(df_bin(op, a[1], b[1]))

    }

    // I64 域:["6", 十进制文本],支持 Add/Sub(文本十进制运算)

    if or2(a[0] == "6", b[0] == "6") {

        if a[0] != "6" {

            a = v6(a[1])

        }

        if b[0] != "6" {

            b = v6(b[1])

        }

        if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {

            var rs = c6sub(a[1], b[1])
            if !c6_in_i64(rs) {
                panic("integer overflow (-)")
            }
            return v6(rs)

        }

        if or2(seq2(op, "Add"), seq2(op, "AddEq")) {

            var ra = c6add(a[1], b[1])
            if !c6_in_i64(ra) {
                panic("integer overflow (+)")
            }
            return v6(ra)

        }
        // 乘:符号异或(先去符号位,竖式纯非负)
        if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
            var at = a[1]
            var bt = b[1]
            var aneg = false
            var bneg = false
            if at.len > 0 {
                if byte_at(at, 0) == 45 {
                    aneg = true
                    at = byte_slice(at, 1, at.len)
                }
            }
            if bt.len > 0 {
                if byte_at(bt, 0) == 45 {
                    bneg = true
                    bt = byte_slice(bt, 1, bt.len)
                }
            }
            var mag = c6mul(c6can(at), c6can(bt))
            if !c6_in_i64(mag) {
                panic("integer overflow (*)")
            }
            if mag == "0" {
                return v6("0")
            }
            if aneg {
                if bneg {
                    return v6(mag)
                }
                return v6("-" + mag)
            }
            if bneg {
                return v6("-" + mag)
            }
            return v6(mag)
        }
        // 除/模:截断除法(镜像 C99)——商向零取整(符号异或),余数符号随被除数;除零 panic
        if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {
            if b[1] == "0" {
                panic("division by zero")
            }
            // MIN / -1 与 MIN % -1 均溢出(两补域);发射侧 ctron_i64_div/mod 镜像
            if b[1] == "-1" {
                if a[1] == "-9223372036854775808" {
                    if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                        panic("integer overflow (/)")
                    }
                    panic("integer overflow (%)")
                }
            }
            var aneg2 = false
            var bneg2 = false
            if a[1].len > 0 {
                if byte_at(a[1], 0) == 45 {
                    aneg2 = true
                }
            }
            if b[1].len > 0 {
                if byte_at(b[1], 0) == 45 {
                    bneg2 = true
                }
            }
            var at = a[1]
            var bt = b[1]
            if aneg2 {
                at = byte_slice(at, 1, at.len)
            }
            if bneg2 {
                bt = byte_slice(bt, 1, bt.len)
            }
            var qr = c6divmod(at, bt)
            var bar: I32 = 0
            var ci: I32 = 0
            while ci < qr.len {
                if byte_at(qr, ci) == 124 {
                    bar = ci
                }
                ci += 1
            }
            var q = byte_slice(qr, 0, bar)
            var r = byte_slice(qr, bar + 1, qr.len)
            // 商符号 = 符号异或;余数符号随被除数(C99)
            if aneg2 {
                if bneg2 {
                    if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                        return v6(q)
                    }
                    return v6("-" + r)
                }
                if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                    return v6("-" + q)
                }
                return v6("-" + r)
            }
            if bneg2 {
                if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                    return v6("-" + q)
                }
                return v6(r)
            }
            if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                return v6(q)
            }
            return v6(r)
        }

        panic("I64 arithmetic: 不支持的算符")

    }

    // U64/USize 域(P1-B):定宽 + 检查算术,界 2^64 字符串比较(宿主 ck_int 同口径)
    if or2(a[0] == "7", b[0] == "7") {

        if a[0] != "7" {

            a = v7(a[1])

        }

        if b[0] != "7" {

            b = v7(b[1])

        }

        if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {

            if c6abscmp(a[1], b[1]) < 0 {

                panic("integer overflow (-)")

            }

            return v7(c6sub(a[1], b[1]))

        }

        if or2(seq2(op, "Add"), seq2(op, "AddEq")) {

            var r7a = c6add(a[1], b[1])

            if !c6_in_u64(r7a) {

                panic("integer overflow (+)")

            }

            return v7(r7a)

        }

        if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {

            var m7 = c6mul(a[1], b[1])

            if !c6_in_u64(m7) {

                panic("integer overflow (*)")

            }

            return v7(m7)

        }

        if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {

            if b[1] == "0" {

                panic("division by zero")

            }

            var qr7 = c6divmod(a[1], b[1])

            var bar7: I32 = 0

            var ci7: I32 = 0

            while ci7 < qr7.len {

                if byte_at(qr7, ci7) == 124 {

                    bar7 = ci7

                }

                ci7 += 1

            }

            if or2(seq2(op, "Div"), seq2(op, "DivEq")) {

                return v7(byte_slice(qr7, 0, bar7))

            }

            return v7(byte_slice(qr7, bar7 + 1, qr7.len))

        }

        panic("U64 算术: 不支持的算符")

    }

    // 除零永不关闭(§4.5:ARM64 等硬件静默回 0,必须显式检查)

    if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {

        if dvi(b[1]) == 0 {

            panic("division by zero")

        }

    }

    if or2(a[0] == "W", b[0] == "W") {

        return w_arith(op, a, b)

    }

    if a[0] == "VEC" && b[0] == "VEC" {

        var vr = List[Str]()

        vr.push("VEC")

        var vi2: I32 = 1

        while vi2 < a.len {

            vr.push(vD(df_bin(op, a[vi2][1], b[vi2][1])))

            vi2 += 1

        }

        return vr

    }

    // I32 检查算术(镜像 rt:溢出 panic;Wrap* 走宽度域之外的宿主回绕)

    if or2(seq2(op, "Add"), seq2(op, "AddEq")) {

        if iadd_ov(dvi(a[1]), dvi(b[1])) {

            panic("integer overflow (+)")

        }

    }

    if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {

        if isub_ov(dvi(a[1]), dvi(b[1])) {

            panic("integer overflow (-)")

        }

    }

    if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {

        if imul_ov(dvi(a[1]), dvi(b[1]), 2147483647, 0 - 2147483647 - 1) {

            panic("integer overflow (*)")

        }

    }

    return vI(ari(op, dvi(a[1]), dvi(b[1])))

}
