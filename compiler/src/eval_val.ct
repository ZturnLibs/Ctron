// =====================================================================

// eval_val.ct —— 值域基础:进制字面量解析(digit_of/txt_num/dvi)、值构造器

// (vI/vB/vS/vV2/vL/vdeep,V 标签定义处)、truth/veq/scmp/vcmp 真值·相等·序、

// ari/val_arith 算术分派。宽度域与 Float 域见 eval_width/eval_float.ct。

// =====================================================================

// ---------------- 数值与文本基础(进制字面量/digit_of/txt_num) ----------------

fn digit_of(c: I32) -> I32 {

    if c >= 48 && c <= 57 { return c - 48 }

    if c >= 97 && c <= 102 { return c - 97 + 10 }

    if c >= 65 && c <= 70 { return c - 65 + 10 }

    return 0

}

fn txt_num(t: Str) -> I32 {

    // 支持 0x/0b/0o/十进制(去下划线)

    var i: I32 = 0

    var n = t.len

    var radix: I32 = 10

    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 120 {

        radix = 16

        i = 2

    }

    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 111 {

        radix = 8

        i = 2

    }

    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 98 {

        radix = 2

        i = 2

    }

    // 十进制规范快路径:无前缀/下划线、全数字 → I64 直累加折回,免 c6 链

    if radix == 10 && i == 0 {

        var allc = true

        var j: I32 = 0

        while j < n {

            var c = byte_at(t, j)

            if c == 95 {

                allc = false

            }

            if c < 48 {

                allc = false

            }

            if c > 57 {

                allc = false

            }

            if j == 0 && n > 1 && c == 48 {

                allc = false

            }

            j += 1

        }

        if allc {

            var v: I64 = 0

            var q: I32 = 0

            while q < n {

                v = v * 10 + (byte_at(t, q) - 48)

                q += 1

            }

            var mo: I64 = v % 4294967296

            if mo >= 2147483648 {

                mo = mo - 4294967296

            }

            return mo.as[I32]()

        }

    }

    var acc7 = "0"

    var rtxt = dvi_str(radix)

    while i < n {

        var c = byte_at(t, i)

        if c == 95 {

            i += 1

        } else {

            acc7 = c6add(c6mul(acc7, rtxt), dvi_str(digit_of(c)))

            i += 1

        }

    }

    return wrap_i32(acc7)

}

// I32 数值 → 十进制文本(dvi 的逆;免 to_string 分派)
fn dvi_str(v: I32) -> Str {
    // 规范十进制直出(MIN32 含;snprintf 双臂一致)。此前的逐位拼接在
    // env 写入热路径上每次分配 ~2×位数,为 loop 基准第一分配大户。
    return v.to_string()
}

// 十进制文本(非负)→ 规范 I32 文本:先模 2^32,≥2^31 折回负半区
fn wrap_i32(u: Str) -> I32 {

    var m = c6can(u)

    if m.len > 0 {

        if byte_at(m, 0) == 45 {

            m = byte_slice(m, 1, m.len)

        }

    }

    var qr = c6divmod(m, "4294967296")

    var bar: I32 = 0

    var ci: I32 = 0

    while ci < qr.len {

        if byte_at(qr, ci) == 124 {

            bar = ci

        }

        ci += 1

    }

    var r = byte_slice(qr, bar + 1, qr.len)

    if c6abscmp(r, "2147483647") > 0 {

        r = c6sub(r, "4294967296")

    }

    return dvi(r)

}

// ---------------- 树行走求值器(表达式/语句/作用域/控制流) ----------------

// 值 = Val 结构体(eval 值/流表示换代 S1):标量域原生字段零 arena 分配,
// 算术/比较字段直取;复合值(U/A/L/T/P/R/C/F/M/BOX/NS/SCOPE/SIMD/VEC/TASK/
// CH/MUX)沿旧 List[Str] 编码位面不变,整表挂 cx 槽(引用共享,别名语义不变;
// seed clone_val 对 V_LIST 字段为指针共享(rt_eval.c:39 fallthrough return v),
// 发射臂 C struct 同 shallow,双臂一致)。
// tag:0=V(void) 1=I(I32) 2=6(I64) 3=7(U64) 4=B(Bool) 5=S(Str) 6=D(F64)
//     7=W(定宽) 8=复合(cx)
// 容器边界(env 条目/实参表/复合载荷元素)经 v_box/v_unbox 适配:复合恒等穿透
// (零分配),标量按旧编码现建(分配画像与换代前相同)。6/7 域超 I64 承载域的
// 值(巨型字面量)回 s 文本槽,消费端经 v6t/v7t 文本投影统一取载荷。
struct Val {
    var tag: I32
    var iv: I64
    var b: Bool
    var s: Str
    var cx: List[Str]
}

// 标量 cx 槽哨兵:仅作值使用(裸名禁成员/下标调用——发射面 ct_typeof 缺口);
// 只读共享,标量 cx 永不写入(写面全部 tag=8 守卫),双臂身份无观察差异

// 流 = Flow 结构体(S1 换代):每表达式/语句节点一个,e4/s4 元组消除;
// kind:k 正常 / r return / a 断言失败 / b break / c continue(Str 与原编码同形)
struct Flow {
    var kind: Str
    var env: List[Str]
    var v: Val
    var out: Str
}

// 复合载荷包装槽:cx 字段存 [payload] 单元素包装表。依据:seed 臂 struct 复制对
// List 字段深克隆(V_ARR 型,壳重建而元素指针照抄),发射臂浅拷贝——包装壳克隆后
// payload 指针双臂共享,原地写语义一致;直挂载荷则 seed 臂写丢失(probe_alias 实证)。
fn cx_wrap(l: List[Str]) -> List[Str] {
    var w = List[Str]()
    w.push(l)
    return w
}

// 载荷取用(恒等:返回包装内原表,引用共享,原地写别名可见)
fn cx_of(v: Val) -> List[Str] {
    return v.cx[0]
}

fn vI(x: I32) -> Val {
    return Val { tag: 1, iv: x.as[I64](), b: false, s: "" }
}

fn vB(b: Bool) -> Val {
    return Val { tag: 4, iv: 0, b: b, s: "" }
}

fn vS(s: Str) -> Val {
    return Val { tag: 5, iv: 0, b: false, s: s }
}

fn vV2() -> Val {
    return Val { tag: 0, iv: 0, b: false, s: "" }
}

// I64 域:iv 原生承载;超 I64 文本(巨型字面量)回 s 槽零损
fn v6(t: Str) -> Val {
    var m = c6can(t)
    if c6_in_i64(m) {
        return Val { tag: 2, iv: c6_i64v(m), b: false, s: "" }
    }
    return Val { tag: 2, iv: 0, b: false, s: m }
}

// U64 域:iv 承载 ≤2^63-1;超域回 s 槽(文本零损,消费端 v7t 分流)
fn v7(t: Str) -> Val {
    var m = c6can(t)
    if c6_i64ok(m) {
        return Val { tag: 3, iv: c6_i64v(m), b: false, s: "" }
    }
    return Val { tag: 3, iv: 0, b: false, s: m }
}

// I64 字段直构(检查式算术产出,iv 必在域内;零文本)
fn v6i(x: I64) -> Val {
    return Val { tag: 2, iv: x, b: false, s: "" }
}

// 6/7 域文本投影(iv 原生 → 规范十进制;文本槽直返)
fn v6t(v: Val) -> Str {
    if v.s != "" {
        return v.s
    }
    return c6_i64s(v.iv)
}

fn v7t(v: Val) -> Str {
    if v.s != "" {
        return v.s
    }
    return c6_i64s(v.iv)
}

// C9f①:List 域 —— 客体 List 直接持有宿主 List 对象(引用语义,push 原地变、别名可见,
// 镜像 rt.c listnode);布局 ["L", item…](同 A:类别槽后逐元素)。
fn vL() -> Val {
    var v = List[Str]()
    v.push("L")
    return Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(v) }
}

// 容器边界适配:Val → 旧编码(复合恒等穿透;标量按旧布局现建)
fn v_box(v: Val) -> List[Str] {
    if v.tag == 8 {
        return cx_of(v)
    }
    if v.tag == 1 {
        var b1 = List[Str]()
        b1.push("I")
        b1.push(dvi_str(v.iv.as[I32]()))
        return b1
    }
    if v.tag == 4 {
        var b2 = List[Str]()
        b2.push("B")
        if v.b {
            b2.push("true")
        } else {
            b2.push("false")
        }
        return b2
    }
    if v.tag == 5 {
        var b3 = List[Str]()
        b3.push("S")
        b3.push(v.s)
        return b3
    }
    if v.tag == 2 {
        var b4 = List[Str]()
        b4.push("6")
        b4.push(v6t(v))
        return b4
    }
    if v.tag == 3 {
        var b5 = List[Str]()
        b5.push("7")
        b5.push(v7t(v))
        return b5
    }
    if v.tag == 7 {
        var b6 = List[Str]()
        b6.push("W")
        b6.push(dvi_str(v.iv.as[I32]()))
        b6.push(v.s)
        return b6
    }
    if v.tag == 6 {
        var b7 = List[Str]()
        b7.push("D")
        b7.push(v.s)
        return b7
    }
    var b0 = List[Str]()
    b0.push("V")
    return b0
}

// 容器边界适配:旧编码 → Val(复合恒等包裹,整表即 cx)
fn v_unbox(l: List[Str]) -> Val {
    var k0 = l[0]
    if k0 == "I" {
        return vI(dvi(l[1]))
    }
    if k0 == "B" {
        return vB(seq2(l[1], "true"))
    }
    if k0 == "S" {
        return vS(l[1])
    }
    if k0 == "V" {
        return vV2()
    }
    if k0 == "6" {
        return v6(l[1])
    }
    if k0 == "7" {
        return v7(l[1])
    }
    if k0 == "W" {
        return vW(l[2], dvi(l[1]))
    }
    if k0 == "D" {
        return Val { tag: 6, iv: 0, b: false, s: l[1] }
    }
    return Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(l) }
}

// 复合值包裹(cx 位面表 → Val;构造点Sugar,免逐处展开五槽字面量)
fn cx_val(l: List[Str]) -> Val {
    return Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(l) }
}

// 值标签投影(Val.tag → 旧编码标签文本;sem_comptime vtag_ok/driver_emit const 面用)
fn vtag_str(v: Val) -> Str {
    if v.tag == 0 {
        return "V"
    }
    if v.tag == 1 {
        return "I"
    }
    if v.tag == 2 {
        return "6"
    }
    if v.tag == 3 {
        return "7"
    }
    if v.tag == 4 {
        return "B"
    }
    if v.tag == 5 {
        return "S"
    }
    if v.tag == 6 {
        return "D"
    }
    if v.tag == 7 {
        return "W"
    }
    return cx_of(v)[0]
}

// into_gc 深拷贝(镜像 rt.c clone_val):按种类分发,U 域名/值交错、A/L 值槽递归,
// 标量/T/F/C 逐槽重建(槽内容不窥探 —— 字符串载荷不可索引);复合位面(旧编码)内
// 标量元素同为旧编码,递归自洽
fn vdeep(v: List[Str]) -> List[Str] {

    var k0 = v[0]

    // M(Atomic/Global 共享单元)保持身份:克隆不得切断别名

    if k0 == "M" {

        return v

    }

    if k0 == "U" {

        var ou = List[Str]()

        ou.push("U")

        ou.push(v[1])

        var iu: I32 = 2

        while iu + 1 < v.len {

            ou.push(v[iu])

            ou.push(vdeep(v[iu + 1]))

            iu += 2

        }

        return ou

    }

    if or2(k0 == "A", k0 == "L") {

        var oa = List[Str]()

        oa.push(k0)

        var ia: I32 = 1

        while ia < v.len {

            oa.push(vdeep(v[ia]))

            ia += 1

        }

        return oa

    }

    var out = List[Str]()

    out.push(v[0])

    var i: I32 = 1

    while i < v.len {

        out.push(v[i])

        i += 1

    }

    return out

}

fn dvi(t: Str) -> I32 {

    // P1-B:十进制文本 → I32。"7" 域文本精确累加 → mod 2^32 → 负半区折回 →
    // MIN 特判(0-2147483647-1 惯用法)→ 幅值安全累加(免界门/免递归)

    var neg = false

    var k: I32 = 0

    if t.len > 0 && byte_at(t, 0) == 45 {

        neg = true

        k = 1

    }

    // 十进制快路径:仅正数(负支 seed 解释口径有未解分歧,见计划 Phase 0)

    if neg == false && t.len - k <= 10 {

        var allc = true

        var q: I32 = k

        while q < t.len {

            var c = byte_at(t, q)

            if c < 48 {

                allc = false

            }

            if c > 57 {

                allc = false

            }

            q += 1

        }

        if allc {

            var v: I64 = 0

            var p2: I32 = k

            while p2 < t.len {

                v = v * 10 + (byte_at(t, p2) - 48)

                p2 += 1

            }

            return v.as[I32]()

        }

    }

    var acc7 = "0"

    while k < t.len {

        acc7 = c6add(c6mul(acc7, "10"), dvi_str(digit_of(byte_at(t, k))))

        k += 1

    }

    var qr = c6divmod(acc7, "4294967296")

    var bar: I32 = 0

    var ci: I32 = 0

    while ci < qr.len {

        if byte_at(qr, ci) == 124 {

            bar = ci

        }

        ci += 1

    }

    var r = byte_slice(qr, bar + 1, qr.len)

    if neg {

        if r != "0" {

            r = c6sub("4294967296", r)

        }

    }

    if c6abscmp(r, "2147483647") > 0 {

        r = "-" + c6sub("4294967296", r)

    }

    if seq2(r, "-2147483648") {

        return 0 - 2147483647 - 1

    }

    var res: I32 = 0

    var k2: I32 = 0

    var neg2 = false

    if r.len > 0 && byte_at(r, 0) == 45 {

        neg2 = true

        k2 = 1

    }

    while k2 < r.len {

        res = res * 10 + digit_of(byte_at(r, k2))

        k2 += 1

    }

    if neg2 {

        res = 0 - res

    }

    return res

}

fn truth(v: Val) -> Bool {
    if v.tag == 4 {
        return v.b
    }
    if v.tag == 1 {
        return v.iv != 0
    }
    if v.tag == 6 {
        return v.s != "0"
    }
    return true
}

fn veq(a: Val, b: Val) -> Bool {
    if or2(a.tag == 6, b.tag == 6) {
        return vcmp(a, b) == 0
    }
    if a.tag == 1 && b.tag == 1 {
        return a.iv == b.iv
    }
    if or2(a.tag == 2, b.tag == 2) {
        if a.s == "" {
            if b.s == "" {
                return a.iv == b.iv
            }
        }
        return c6cmp(c6can(v6t(a)), c6can(v6t(b))) == 0
    }
    if or2(a.tag == 3, b.tag == 3) {
        return vcmp(a, b) == 0
    }
    if or2(a.tag == 7, b.tag == 7) {
        if or2(a.tag == 1, a.tag == 7) && or2(b.tag == 1, b.tag == 7) {
            return a.iv == b.iv
        }
        return false
    }
    if a.tag == 4 && b.tag == 4 {
        return a.b == b.b
    }
    if a.tag == 5 && b.tag == 5 {
        return seq2(a.s, b.s)
    }
    if a.tag == 8 && b.tag == 8 {
        // Option/Result 结构相等:变体同名 + 载荷递归 veq(None/Err 无载荷)
        if seq2(cx_of(a)[0], "T") && seq2(cx_of(b)[0], "T") {
            if !seq2(cx_of(a)[1], cx_of(b)[1]) {
                return false
            }
            if cx_of(a).len == 3 {
                if cx_of(b).len != 3 {
                    return false
                }
                return veq(v_unbox(cx_of(a)[2]), v_unbox(cx_of(b)[2]))
            }
            return cx_of(b).len == 2
        }
    }
    return false
}

fn scmp(a: Str, b: Str) -> I32 {

    var n = a.len

    if b.len < n {

        n = b.len

    }

    var i: I32 = 0

    while i < n {

        var x = byte_at(a, i)

        var y = byte_at(b, i)

        if x < y {

            return -1

        }

        if x > y {

            return 1

        }

        i += 1

    }

    if a.len < b.len {

        return -1

    }

    if a.len > b.len {

        return 1

    }

    return 0

}

fn c6_i64ok(t: Str) -> Bool {

    var i: I32 = 0

    if t.len > 0 {

        if byte_at(t, 0) == 45 {

            i = 1

        }

    }

    var d: I32 = t.len - i

    if d < 1 {

        return false

    }

    if d > 18 {

        return false

    }

    while i < t.len {

        var c = byte_at(t, i)

        if c < 48 {

            return false

        }

        if c > 57 {

            return false

        }

        i += 1

    }

    return true

}

fn c6_i64v(t: Str) -> I64 {
    // 负数走负向累加(v = v*10 - d):各中间步 ≥ MIN,MIN 本尊(-2^63)可精确承载;
    // 正向累加在最后一步会撞检查式 I64 加法上界(v6/v7 解析 MIN 幅值时的实证溢出)
    var neg = false
    var i: I32 = 0
    if t.len > 0 {
        if byte_at(t, 0) == 45 {
            neg = true
            i = 1
        }
    }
    var v: I64 = 0
    if neg {
        while i < t.len {
            v = v * 10 - (byte_at(t, i) - 48)
            i += 1
        }
        return v
    }
    while i < t.len {
        v = v * 10 + (byte_at(t, i) - 48)
        i += 1
    }
    return v
}

fn c6_i64s(v: I64) -> Str {
    // 规范十进制直出(MIN 安全;snprintf 双臂一致),替代逐位递归拼接
    return v.to_string()
}

fn c6can(t: Str) -> Str {

    var neg = false

    var i: I32 = 0

    if t.len > 0 {

        if byte_at(t, 0) == 45 {

            neg = true

            i = 1

        }

    }

    var strip = true

    while strip {

        if i >= t.len - 1 {

            strip = false

        } else {

            if byte_at(t, i) != 48 {

                strip = false

            } else {

                i += 1

            }

        }

    }

    var m = byte_slice(t, i, t.len)

    if neg {

        if m == "0" {

            return "0"

        }

        return "-" + m

    }

    if m == "" {

        return "0"

    }

    return m

}



fn c6abscmp(a: Str, b: Str) -> I32 {

    if a.len != b.len {

        if a.len > b.len {

            return 1

        }

        return -1

    }

    var i: I32 = 0

    while i < a.len {

        var x = byte_at(a, i)

        var y = byte_at(b, i)

        if x > y {

            return 1

        }

        if x < y {

            return -1

        }

        i += 1

    }

    return 0

}



// 字面量域判定(§3.1.1):进制识别/十进制归一/超 I32 宽度;下划线分隔符剥离
fn lit_digits(t: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < t.len {
        var c = byte_at(t, i)
        if c != 95 {
            out = out + byte_slice(t, i, i + 1)
        }
        i += 1
    }
    return out
}

// int64 界门(§4.5 检查算术):规范十进制文本是否落在 [MIN, MAX];
// 发射侧 ctron_i64_* 帮手镜像
// U64 界门(P1-B):非负且 ≤ 2^64-1
fn c6_in_u64(r: Str) -> Bool {
    if r.len > 0 {
        if byte_at(r, 0) == 45 {
            return false
        }
    }
    return c6abscmp(r, "18446744073709551615") <= 0
}

fn c6_in_i64(r: Str) -> Bool {    var neg = false
    var m = r
    if m.len > 0 {
        if byte_at(m, 0) == 45 {
            neg = true
            m = byte_slice(m, 1, m.len)
        }
    }
    if neg {
        return c6abscmp(m, "9223372036854775808") <= 0
    }
    return c6abscmp(m, "9223372036854775807") <= 0
}

fn lit_is_dec(t: Str) -> Bool {
    if t.len > 1 {
        if byte_at(t, 0) == 48 {
            var c2 = byte_at(t, 1)
            if or2(c2 == 120, or2(c2 == 111, c2 == 98)) {
                return false
            }
        }
    }
    return true
}

// 0x/0o/0b 字面量 → 规范十进制文本(逐位 acc*radix+d,c6 文本域算术)
fn lit_radix_dec(t: Str) -> Str {
    var radix: I32 = 16
    if byte_at(t, 1) == 111 {
        radix = 8
    }
    if byte_at(t, 1) == 98 {
        radix = 2
    }
    var rs = "16"
    if radix == 8 {
        rs = "8"
    }
    if radix == 2 {
        rs = "2"
    }
    var acc = "0"
    var i: I32 = 2
    while i < t.len {
        var c = byte_at(t, i)
        if c != 95 {
            var dv = digit_of(c)
            acc = c6add(c6mul(acc, rs), byte_slice("00010203040506070809101112131415", dv * 2, dv * 2 + 2))
        }
        i += 1
    }
    return c6can(acc)
}

// 字面量 → 规范十进制文本(十进制剥下划线;进制转十进制)
fn lit_to_dec(t: Str) -> Str {
    if lit_is_dec(t) {
        return c6can(lit_digits(t))
    }
    return lit_radix_dec(t)
}

fn lit_wide_i32(t: Str) -> Bool {
    // 十进制:零分配逐位判宽(跳符号/下划线/前导零后与 2147483647 逐位比较);
    // 旧实现全量 lit_to_dec 换算(逐字符拼接+规范化),为 loop 基准第一分配大户
    // (14 分配/迭代,直方图+RA 采样实证)。进制字面量走换算冷路径。
    if lit_is_dec(t) {
        var i: I32 = 0
        if t.len > 0 {
            if byte_at(t, 0) == 45 {
                i = 1
            }
        }
        var base: I32 = i
        while base < t.len {
            var c0 = byte_at(t, base)
            if c0 != 48 && c0 != 95 {
                break
            }
            base += 1
        }
        var eff: I32 = 0
        var j: I32 = base
        while j < t.len {
            if byte_at(t, j) != 95 {
                eff += 1
            }
            j += 1
        }
        if eff < 10 {
            return false
        }
        if eff > 10 {
            return true
        }
        var limit = "2147483647"
        var k: I32 = 0
        var pos: I32 = base
        while k < 10 {
            while byte_at(t, pos) == 95 {
                pos += 1
            }
            var c = byte_at(t, pos) - 48
            var l = byte_at(limit, k) - 48
            if c < l {
                return false
            }
            if c > l {
                return true
            }
            pos += 1
            k += 1
        }
        return false
    }
    return c6abscmp(lit_to_dec(t), "2147483647") > 0
}

fn c6cmp(a: Str, b: Str) -> I32 {

    var aneg = false

    var bneg = false

    if a.len > 0 {

        if byte_at(a, 0) == 45 {

            aneg = true

        }

    }

    if b.len > 0 {

        if byte_at(b, 0) == 45 {

            bneg = true

        }

    }

    if aneg {

        if bneg {

            return c6abscmp(b, a)

        }

        return -1

    }

    if bneg {

        return 1

    }

    return c6abscmp(a, b)

}



fn c6add(a: Str, b: Str) -> Str {

    if c6_i64ok(a) && c6_i64ok(b) {

        return c6_i64s(c6_i64v(a) + c6_i64v(b))

    }
    var aneg = false
    var bneg = false
    if a.len > 0 {
        if byte_at(a, 0) == 45 {
            aneg = true
        }
    }
    if b.len > 0 {
        if byte_at(b, 0) == 45 {
            bneg = true
        }
    }
    var am = c6can(a)
    var bm = c6can(b)
    if aneg {
        am = byte_slice(am, 1, am.len)
    }
    if bneg {
        bm = byte_slice(bm, 1, bm.len)
    }
    if aneg {
        if bneg {
            return "-" + c6addmag(am, bm)
        }
        var c = c6abscmp(am, bm)
        if c == 0 {
            return "0"
        }
        if c > 0 {
            return "-" + c6submag(am, bm)
        }
        return c6submag(bm, am)
    }
    if bneg {
        var c2 = c6abscmp(am, bm)
        if c2 == 0 {
            return "0"
        }
        if c2 > 0 {
            return c6submag(am, bm)
        }
        return "-" + c6submag(bm, am)
    }
    return c6addmag(am, bm)
}

// 非负十进制加法(核心,无符号处理)
fn c6addmag(a: Str, b: Str) -> Str {
    var out = ""

    var ia = a.len

    var ib = b.len

    var carry: I32 = 0

    while ia > 0 {

        ia -= 1

        var d = byte_at(a, ia) - 48 + carry

        if ib > 0 {

            ib -= 1

            d += byte_at(b, ib) - 48

        }

        if d > 9 {

            d -= 10

            carry = 1

        } else {

            carry = 0

        }

        out = byte_slice("0123456789", d, d + 1) + out

    }

    while ib > 0 {

        ib -= 1

        var d2 = byte_at(b, ib) - 48 + carry

        if d2 > 9 {

            d2 -= 10

            carry = 1

        } else {

            carry = 0

        }

        out = byte_slice("0123456789", d2, d2 + 1) + out

    }

    if carry == 1 {

        out = "1" + out

    }

    return c6can(out)

}



fn c6submag(a: Str, b: Str) -> Str {

    var out = ""

    var ia = a.len

    var ib = b.len

    var borrow: I32 = 0

    while ia > 0 {

        ia -= 1

        var d = byte_at(a, ia) - 48 - borrow

        if ib > 0 {

            ib -= 1

            d -= byte_at(b, ib) - 48

        }

        if d < 0 {

            d += 10

            borrow = 1

        } else {

            borrow = 0

        }

        out = byte_slice("0123456789", d, d + 1) + out

    }

    return c6can(out)

}



fn c6sub(a: Str, b: Str) -> Str {

    if c6_i64ok(a) && c6_i64ok(b) {

        return c6_i64s(c6_i64v(a) - c6_i64v(b))

    }

    var aneg = false

    var bneg = false

    if a.len > 0 {

        if byte_at(a, 0) == 45 {

            aneg = true

        }

    }

    if b.len > 0 {

        if byte_at(b, 0) == 45 {

            bneg = true

        }

    }

    if or2(aneg, bneg) {

        if aneg {

            if bneg {

                return c6sub(byte_slice(a, 1, a.len), byte_slice(b, 1, b.len))

            }

            return "-" + c6add(byte_slice(a, 1, a.len), b)

        }

        return c6add(a, byte_slice(b, 1, b.len))

    }

    var c = c6abscmp(a, b)

    if c == 0 {

        return "0"

    }

    if c > 0 {

        return c6submag(a, b)

    }

    return "-" + c6submag(b, a)

}

// 非负竖式乘法(逐位乘累加;单步数值 <= 89,I32 安全)
fn c6mul(a: Str, b: Str) -> Str {

    if c6_i64ok(a) && c6_i64ok(b) {

        var va = c6_i64v(a)

        var vb = c6_i64v(b)

        if va >= -2000000000 && va <= 2000000000 && vb >= -2000000000 && vb <= 2000000000 {

            return c6_i64s(va * vb)

        }

    }
    var acc = "0"
    var ib = b.len
    while ib > 0 {
        ib -= 1
        var d = byte_at(b, ib) - 48
        var part = ""
        var carry: I32 = 0
        var ia = a.len
        while ia > 0 {
            ia -= 1
            var p = (byte_at(a, ia) - 48) * d + carry
            carry = p / 10
            part = byte_slice("0123456789", p % 10, p % 10 + 1) + part
        }
        while carry > 0 {
            part = byte_slice("0123456789", carry % 10, carry % 10 + 1) + part
            carry = carry / 10
        }
        var zeros = b.len - 1 - ib
        var z: I32 = 0
        while z < zeros {
            part = part + "0"
            z += 1
        }
        acc = c6add(acc, part)
    }
    return c6can(acc)
}

// 长除试商:返回 "商|余数"(复合串,镜像 ct_struct_inst_split 先例)
fn c6divmod(a: Str, b: Str) -> Str {
    var q = ""
    var rem = "0"
    var i: I32 = 0
    while i < a.len {
        // rem * 10 + digit(a[i])(文本拼接即十进制左移)
        rem = c6can(rem + byte_slice(a, i, i + 1))
        var qd: I32 = 0
        while c6abscmp(rem, b) >= 0 {
            rem = c6submag(rem, b)
            qd += 1
        }
        q = q + byte_slice("0123456789", qd, qd + 1)
        i += 1
    }
    return q + "|" + rem
}

fn vcmp(a: Val, b: Val) -> I32 {
    if a.tag == 5 && b.tag == 5 {
        return scmp(a.s, b.s)
    }
    if or2(a.tag == 6, b.tag == 6) {
        return df_vcmp(a.s, b.s)
    }
    if or2(a.tag == 2, or2(b.tag == 2, or2(a.tag == 1, b.tag == 1))) {
        if or2(a.tag == 2, b.tag == 2) {
            if a.s == "" {
                if b.s == "" {
                    if a.iv < b.iv {
                        return -1
                    }
                    if a.iv > b.iv {
                        return 1
                    }
                    return 0
                }
            }
            return c6cmp(v6t(a), v6t(b))
        }
    }
    // U64/USize 比较域(P1-B):同域/跨 I/W 直幅值比较(负值混比语料避,挂账)
    if or2(a.tag == 3, b.tag == 3) {
        var at7 = v7t(a)
        var bt7 = v7t(b)
        if a.tag == 7 {
            at7 = c6_i64s(a.iv)
        }
        if b.tag == 7 {
            bt7 = c6_i64s(b.iv)
        }
        return c6abscmp(at7, bt7)
    }
    var x = a.iv
    var y = b.iv
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    return 0
}

fn ari(op: Str, x: I32, y: I32) -> I32 {

    if op == "Add" {

        return x + y

    }

    if op == "Sub" {

        return x - y

    }

    if op == "Mul" {

        return x * y

    }

    if op == "Div" {

        return x / y

    }

    if op == "Mod" {

        return x % y

    }

    if op == "WrapAdd" {

        return x + y

    }

    if op == "WrapSub" {

        return x - y

    }

    if op == "AddEq" {

        return x + y

    }

    if op == "SubEq" {

        return x - y

    }

    if op == "MulEq" {

        return x * y

    }

    if op == "DivEq" {

        return x / y

    }

    if op == "ModEq" {

        return x % y

    }

    return 0

}

fn val_arith(op: Str, a: Val, b: Val) -> Val {
    if or2(a.tag == 6, b.tag == 6) {
        return vD(df_bin(op, a.s, b.s))
    }
    // I64 域:iv 原生(v6t 统一文本投影),检查算术(溢出 panic,镜像发射口径)
    if or2(a.tag == 2, b.tag == 2) {
        // 双 iv 原生:字段直算(编译器源 I64 算术=检查式,溢出消息与文本管线逐字
        // 同源:ctron_i64_* / seed ck_int 64);任一侧带 s 巨型字面量文本槽 → 旧管线
        if a.s == "" {
            if b.s == "" {
                if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {
                    return v6i(a.iv - b.iv)
                }
                if or2(seq2(op, "Add"), seq2(op, "AddEq")) {
                    return v6i(a.iv + b.iv)
                }
                if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
                    return v6i(a.iv * b.iv)
                }
                if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                    if b.iv == 0 {
                        panic("division by zero")
                    }
                    return v6i(a.iv / b.iv)
                }
                if or2(seq2(op, "Mod"), seq2(op, "ModEq")) {
                    if b.iv == 0 {
                        panic("division by zero")
                    }
                    return v6i(a.iv % b.iv)
                }
                panic("I64 arithmetic: 不支持的算符")
            }
        }
        var ta = v6t(a)
        var tb = v6t(b)
        if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {
            var rs = c6sub(ta, tb)
            if !c6_in_i64(rs) {
                panic("integer overflow (-)")
            }
            return v6(rs)
        }
        if or2(seq2(op, "Add"), seq2(op, "AddEq")) {
            var ra = c6add(ta, tb)
            if !c6_in_i64(ra) {
                panic("integer overflow (+)")
            }
            return v6(ra)
        }
        // 乘:符号异或(先去符号位,竖式纯非负)
        if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
            var at = ta
            var bt = tb
            var aneg = false
            var bneg = false
            if at.len > 0 {
                if byte_at(at, 0) == 45 {
                    aneg = true
                    at = byte_slice(at, 1, at.len)
                }
            }
            if bt.len > 0 {
                if byte_at(bt, 0) == 45 {
                    bneg = true
                    bt = byte_slice(bt, 1, bt.len)
                }
            }
            var mag = c6mul(c6can(at), c6can(bt))
            if mag == "0" {
                return v6("0")
            }
            var negr = false
            if aneg {
                if !bneg {
                    negr = true
                }
            } else {
                if bneg {
                    negr = true
                }
            }
            if negr {
                if c6abscmp(mag, "9223372036854775808") > 0 {
                    panic("integer overflow (*)")
                }
                return v6("-" + mag)
            }
            if c6abscmp(mag, "9223372036854775807") > 0 {
                panic("integer overflow (*)")
            }
            return v6(mag)
        }
        // 除/模:截断除法(镜像 C99)——商向零取整(符号异或),余数符号随被除数;除零 panic
        if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {
            if tb == "0" {
                panic("division by zero")
            }
            // MIN / -1 与 MIN % -1 均溢出(两补域);发射侧 ctron_i64_div/mod 镜像
            if tb == "-1" {
                if ta == "-9223372036854775808" {
                    if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                        panic("integer overflow (/)")
                    }
                    panic("integer overflow (%)")
                }
            }
            var aneg2 = false
            var bneg2 = false
            if ta.len > 0 {
                if byte_at(ta, 0) == 45 {
                    aneg2 = true
                }
            }
            if tb.len > 0 {
                if byte_at(tb, 0) == 45 {
                    bneg2 = true
                }
            }
            var at2 = ta
            var bt2 = tb
            if aneg2 {
                at2 = byte_slice(at2, 1, at2.len)
            }
            if bneg2 {
                bt2 = byte_slice(bt2, 1, bt2.len)
            }
            var qr = c6divmod(at2, bt2)
            var bar: I32 = 0
            var ci: I32 = 0
            while ci < qr.len {
                if byte_at(qr, ci) == 124 {
                    bar = ci
                }
                ci += 1
            }
            var q = c6can(byte_slice(qr, 0, bar))
            var r = c6can(byte_slice(qr, bar + 1, qr.len))
            // 商符号 = 符号异或;余数符号随被除数(C99)
            if aneg2 {
                if bneg2 {
                    if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                        return v6(q)
                    }
                    return v6("-" + r)
                }
                if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                    return v6("-" + q)
                }
                return v6("-" + r)
            }
            if bneg2 {
                if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                    return v6("-" + q)
                }
                return v6(r)
            }
            if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                return v6(q)
            }
            return v6(r)
        }
        panic("I64 arithmetic: 不支持的算符")
    }
    // U64/USize 域(P1-B):定宽 + 检查算术,界 2^64 幅值比较(宿主 ck_int 同口径)
    if or2(a.tag == 3, b.tag == 3) {
        var ua = v7t(a)
        var ub = v7t(b)
        if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {
            if c6abscmp(ua, ub) < 0 {
                panic("integer overflow (-)")
            }
            return v7(c6sub(ua, ub))
        }
        if or2(seq2(op, "Add"), seq2(op, "AddEq")) {
            var r7a = c6add(ua, ub)
            if !c6_in_u64(r7a) {
                panic("integer overflow (+)")
            }
            return v7(r7a)
        }
        if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
            var m7 = c6mul(ua, ub)
            if !c6_in_u64(m7) {
                panic("integer overflow (*)")
            }
            return v7(m7)
        }
        if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {
            if ub == "0" {
                panic("division by zero")
            }
            var qr7 = c6divmod(ua, ub)
            var bar7: I32 = 0
            var ci7: I32 = 0
            while ci7 < qr7.len {
                if byte_at(qr7, ci7) == 124 {
                    bar7 = ci7
                }
                ci7 += 1
            }
            if or2(seq2(op, "Div"), seq2(op, "DivEq")) {
                return v7(byte_slice(qr7, 0, bar7))
            }
            return v7(byte_slice(qr7, bar7 + 1, qr7.len))
        }
        panic("U64 算术: 不支持的算符")
    }
    // 除零永不关闭(§4.5:ARM64 等硬件静默回 0,必须显式检查)
    if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {
        if b.iv == 0 {
            panic("division by zero")
        }
    }
    if or2(a.tag == 7, b.tag == 7) {
        return w_arith(op, a, b)
    }
    if a.tag == 8 && b.tag == 8 {
        if cx_of(a)[0] == "VEC" && cx_of(b)[0] == "VEC" {
            var vr = List[Str]()
            vr.push("VEC")
            var vi2: I32 = 1
            while vi2 < cx_of(a).len {
                vr.push(v_box(vD(df_bin(op, v_unbox(cx_of(a)[vi2]).s, v_unbox(cx_of(b)[vi2]).s))))
                vi2 += 1
            }
            return Val { tag: 8, iv: 0, b: false, s: "", cx: cx_wrap(vr) }
        }
    }
    // I32 检查算术(镜像 rt:溢出 panic;Wrap* 走宽度域之外的宿主回绕)
    var xa = a.iv.as[I32]()
    var yb = b.iv.as[I32]()
    if or2(seq2(op, "Add"), seq2(op, "AddEq")) {
        if iadd_ov(xa, yb) {
            panic("integer overflow (+)")
        }
    }
    if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {
        if isub_ov(xa, yb) {
            panic("integer overflow (-)")
        }
    }
    if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
        if imul_ov(xa, yb, 2147483647, 0 - 2147483647 - 1) {
            panic("integer overflow (*)")
        }
    }
    return vI(ari(op, xa, yb))
}