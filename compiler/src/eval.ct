// =====================================================================
// eval.ct —— 树行走求值器(解释执行)
// 覆盖:I32/Bool/Str(含 {expr} 插值)/Float(十进制定点)/变量+块作用域/
//       if·while·for(range·数组·List)/match(字面量·通配·绑定)/Option·Result
//       与 ? 传播/struct·枚举/UFCS/闭包与 fn 值/List(引用语义)/trait·impl
//       方法/绑定克隆与原地写/read_file·Atomic·unesc 内建。
// 接口:run_block/run_tests/find_decl;值域 V 标签见 vV2/fmt。
// =====================================================================
// ---------------- 数值与文本基础(进制字面量/digit_of/txt_num) ----------------
fn digit_of(c: I32) -> I32 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 97 + 10 }
    if c >= 65 && c <= 70 { return c - 65 + 10 }
    return 0
}
fn txt_num(t: Str) -> I32 {
    // 支持 0x/0b/0o/十进制(去下划线)
    var i: I32 = 0
    var n = t.len
    var radix: I32 = 10
    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 120 {
        radix = 16
        i = 2
    }
    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 111 {
        radix = 8
        i = 2
    }
    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 98 {
        radix = 2
        i = 2
    }
    var acc: I32 = 0
    while i < n {
        var c = byte_at(t, i)
        if c == 95 {
            i += 1
        } else {
            acc = acc * radix + digit_of(c)
            i += 1
        }
    }
    return acc
}
// ---------------- 树行走求值器(表达式/语句/作用域/控制流) ----------------
// 值 = List[Str]:[0]=类别 I(Int文本)/B(true|false)/S(文本)/V(void)/R(range)
// env = 绑定 List(新在前);表达式求值线程 env/out;返回 [flow,env,val,out]
// flow:k 正常 / r return / a 断言失败;run_stmt/run_block 返回 [flow,env,out,val]

fn vI(x: I32) -> List[Str] {
    var v = List[Str]()
    v.push("I")
    v.push(x.to_string())
    return v
}
fn vB(b: Bool) -> List[Str] {
    var v = List[Str]()
    v.push("B")
    if b {
        v.push("true")
    } else {
        v.push("false")
    }
    return v
}
fn vS(s: Str) -> List[Str] {
    var v = List[Str]()
    v.push("S")
    v.push(s)
    return v
}
fn vV2() -> List[Str] {
    var v = List[Str]()
    v.push("V")
    return v
}
// C9f①:List 域 —— 客体 List 直接持有宿主 List 对象(引用语义,push 原地变、别名可见,
// 镜像 rt.c listnode);布局 ["L", item…](同 A:类别槽后逐元素)。
fn vL() -> List[Str] {
    var v = List[Str]()
    v.push("L")
    return v
}
// into_gc 深拷贝(镜像 rt.c clone_val):按种类分发,U 域名/值交错、A/L 值槽递归,
// 标量/T/F/C 逐槽重建(槽内容不窥探 —— 字符串载荷不可索引)
fn vdeep(v: List[Str]) -> List[Str] {
    var k0 = v[0]
    // M(Atomic/Global 共享单元)保持身份:克隆不得切断别名
    if k0 == "M" {
        return v
    }
    if k0 == "U" {
        var ou = List[Str]()
        ou.push("U")
        ou.push(v[1])
        var iu: I32 = 2
        while iu + 1 < v.len {
            ou.push(v[iu])
            ou.push(vdeep(v[iu + 1]))
            iu += 2
        }
        return ou
    }
    if or2(k0 == "A", k0 == "L") {
        var oa = List[Str]()
        oa.push(k0)
        var ia: I32 = 1
        while ia < v.len {
            oa.push(vdeep(v[ia]))
            ia += 1
        }
        return oa
    }
    var out = List[Str]()
    out.push(v[0])
    var i: I32 = 1
    while i < v.len {
        out.push(v[i])
        i += 1
    }
    return out
}
fn dvi(t: Str) -> I32 {
    var neg = false
    var k: I32 = 0
    if t.len > 0 && byte_at(t, 0) == 45 {
        neg = true
        k = 1
    }
    var acc: I32 = 0
    while k < t.len {
        acc = acc * 10 + byte_at(t, k) - 48
        k += 1
    }
    if neg {
        return 0 - acc
    }
    return acc
}
fn truth(v: List[Str]) -> Bool {
    var k = v[0]
    if k == "B" {
        return seq2(v[1], "true")
    }
    if k == "I" {
        return dvi(v[1]) != 0
    }
    if k == "D" {
        return v[1] != "0"
    }
    return true
}
fn veq(a: List[Str], b: List[Str]) -> Bool {
    var ka = a[0]
    var kb = b[0]
    if or2(ka == "D", kb == "D") {
        return vcmp(a, b) == 0
    }
    if ka == "I" && kb == "I" {
        return dvi(a[1]) == dvi(b[1])
    }
    if or2(ka == "W", kb == "W") {
        if or2(ka == "I", ka == "W") && or2(kb == "I", kb == "W") {
            return dvi(a[1]) == dvi(b[1])
        }
        return false
    }
    if ka == "B" && kb == "B" {
        return seq2(a[1], b[1])
    }
    if ka == "S" && kb == "S" {
        return seq2(a[1], b[1])
    }
    return false
}
fn scmp(a: Str, b: Str) -> I32 {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    var i: I32 = 0
    while i < n {
        var x = byte_at(a, i)
        var y = byte_at(b, i)
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        i += 1
    }
    if a.len < b.len {
        return -1
    }
    if a.len > b.len {
        return 1
    }
    return 0
}
fn vcmp(a: List[Str], b: List[Str]) -> I32 {
    if a[0] == "S" && b[0] == "S" {
        return scmp(a[1], b[1])
    }
    if or2(a[0] == "D", b[0] == "D") {
        return df_vcmp(a[1], b[1])
    }
    var x = dvi(a[1])
    var y = dvi(b[1])
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    return 0
}
fn ari(op: Str, x: I32, y: I32) -> I32 {
    if op == "Add" {
        return x + y
    }
    if op == "Sub" {
        return x - y
    }
    if op == "Mul" {
        return x * y
    }
    if op == "Div" {
        return x / y
    }
    if op == "Mod" {
        return x % y
    }
    if op == "WrapAdd" {
        return x + y
    }
    if op == "WrapSub" {
        return x - y
    }
    if op == "AddEq" {
        return x + y
    }
    if op == "SubEq" {
        return x - y
    }
    if op == "MulEq" {
        return x * y
    }
    if op == "DivEq" {
        return x / y
    }
    if op == "ModEq" {
        return x % y
    }
    return 0
}
fn val_arith(op: Str, a: List[Str], b: List[Str]) -> List[Str] {
    if or2(a[0] == "D", b[0] == "D") {
        return vD(df_bin(op, a[1], b[1]))
    }
    // 除零永不关闭(§4.5:ARM64 等硬件静默回 0,必须显式检查)
    if or2(seq2(op, "Div"), or2(seq2(op, "Mod"), or2(seq2(op, "DivEq"), seq2(op, "ModEq")))) {
        if dvi(b[1]) == 0 {
            panic("division by zero")
        }
    }
    if or2(a[0] == "W", b[0] == "W") {
        return w_arith(op, a, b)
    }
    if a[0] == "VEC" && b[0] == "VEC" {
        var vr = List[Str]()
        vr.push("VEC")
        var vi2: I32 = 1
        while vi2 < a.len {
            vr.push(vD(df_bin(op, a[vi2][1], b[vi2][1])))
            vi2 += 1
        }
        return vr
    }
    // I32 检查算术(镜像 rt:溢出 panic;Wrap* 走宽度域之外的宿主回绕)
    if or2(seq2(op, "Add"), seq2(op, "AddEq")) {
        if iadd_ov(dvi(a[1]), dvi(b[1])) {
            panic("integer overflow (+)")
        }
    }
    if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {
        if isub_ov(dvi(a[1]), dvi(b[1])) {
            panic("integer overflow (-)")
        }
    }
    if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
        if imul_ov(dvi(a[1]), dvi(b[1]), 2147483647, 0 - 2147483647 - 1) {
            panic("integer overflow (*)")
        }
    }
    return vI(ari(op, dvi(a[1]), dvi(b[1])))
}

// ---------------- 宽度域(u8/i8/u16/i16 值标签 W:载荷在前、宽度在后) ----------------
fn vW(w: Str, x: I32) -> List[Str] {
    var v = List[Str]()
    v.push("W")
    v.push(x.to_string())
    v.push(w)
    return v
}
fn w_of(v: List[Str]) -> Str {
    if v[0] == "W" {
        return v[2]
    }
    return "i32"
}
fn w_rank(w: Str) -> I32 {
    if w == "i32" {
        return 3
    }
    if or2(w == "u16", w == "i16") {
        return 2
    }
    return 1
}
fn w_signed(w: Str) -> Bool {
    return or2(w == "i8", w == "i16")
}
fn w_max(w: Str) -> I32 {
    if w == "u8" {
        return 255
    }
    if w == "i8" {
        return 127
    }
    if w == "u16" {
        return 65535
    }
    if w == "i16" {
        return 32767
    }
    return 2147483647
}
fn w_min(w: Str) -> I32 {
    if or2(w == "u8", w == "u16") {
        return 0
    }
    if w == "i8" {
        return 0 - 128
    }
    if w == "i16" {
        return 0 - 32768
    }
    return 0 - 2147483647 - 1
}
// ≤16 位宽度下的回绕:I32 中间量安全;按 2^bits 取模,有符号再折回
fn w_arith(op: Str, a: List[Str], b: List[Str]) -> List[Str] {
    var wa = w_of(a)
    var wb = w_of(b)
    var w = wa
    if w_rank(wb) > w_rank(wa) {
        w = wb
    }
    var x = dvi(a[1])
    var y = dvi(b[1])
    var mx = w_max(w)
    var mn = w_min(w)
    if or2(seq2(op, "WrapAdd"), seq2(op, "WrapSub")) {
        var t = x + y
        if seq2(op, "WrapSub") {
            t = x - y
        }
        var s: I32 = 1
        var k: I32 = 0
        while k < w_bits(w) {
            s = s * 2
            k += 1
        }
        var m = t % s
        if m < 0 {
            m += s
        }
        if w_signed(w) && m > mx {
            m -= s
        }
        return vW(w, m)
    }
    if or2(seq2(op, "Add"), seq2(op, "AddEq")) {
        var r = x + y
        if or2(r > mx, r < mn) {
            panic("integer overflow (+)")
        }
        return vW(w, r)
    }
    if or2(seq2(op, "Sub"), seq2(op, "SubEq")) {
        var r = x - y
        if or2(r > mx, r < mn) {
            panic("integer overflow (-)")
        }
        return vW(w, r)
    }
    if or2(seq2(op, "Mul"), seq2(op, "MulEq")) {
        if imul_ov(x, y, mx, mn) {
            panic("integer overflow (*)")
        }
        return vW(w, x * y)
    }
    return vW(w, ari(op, x, y))
}
fn w_bits(w: Str) -> I32 {
    if or2(w == "u8", w == "i8") {
        return 8
    }
    if or2(w == "u16", w == "i16") {
        return 16
    }
    return 32
}
// I32 溢出判定(除法法,截断语义下精确;MIN 以 0-2147483647-1 构造避免字面量溢出)
fn iadd_ov(x: I32, y: I32) -> Bool {
    if y > 0 {
        return x > 2147483647 - y
    }
    if y < 0 {
        return x < (0 - 2147483647 - 1) - y
    }
    return false
}
fn isub_ov(x: I32, y: I32) -> Bool {
    if y < 0 {
        return x > 2147483647 + y
    }
    if y > 0 {
        return x < (0 - 2147483647 - 1) + y
    }
    return false
}
fn imul_ov(x: I32, y: I32, mx: I32, mn: I32) -> Bool {
    if or2(x == 0, y == 0) {
        return false
    }
    if x > 0 && y > 0 {
        return x > mx / y
    }
    if x > 0 && y < 0 {
        return y < mn / x
    }
    if x < 0 && y > 0 {
        return x < mn / y
    }
    return x < mx / y
}
// ---------------- Float 域(十进制定点,镜像 rt fmt 可观测语义) ----------------
// 值 ["D", 规范十进制文本](规范: [-]int[.frac],frac 尾零修剪,零恒为 "0")。
// 宿主 double 的二进制舍入细节挂账;工作精度 9 位有效(scale ≤ 9)。
fn vD(t: Str) -> List[Str] {
    var v = List[Str]()
    v.push("D")
    v.push(t)
    return v
}
fn df_p10(k: I32) -> I64 {
    var r: I64 = 1
    var i: I32 = 0
    while i < k {
        r = r * 10
        i += 1
    }
    return r
}
fn df_digits(a: I64) -> I32 {
    var n: I32 = 0
    var x: I64 = a
    if x < 0 {
        x = 0 - x
    }
    if x == 0 {
        return 1
    }
    while x > 0 {
        x = x / 10
        n += 1
    }
    return n
}
fn df_pack(m: I64, s: I32) -> Str {
    return m.to_string() + "@" + s.to_string()
}
fn df_pm(p: Str) -> I64 {
    var m: I64 = 0
    var i: I32 = 0
    var neg = false
    if byte_at(p, 0) == 45 {
        neg = true
        i = 1
    }
    while i < p.len {
        var c = byte_at(p, i)
        if c == 64 {
            if neg {
                m = 0 - m
            }
            return m
        }
        m = m * 10 + (c - 48)
        i += 1
    }
    if neg {
        m = 0 - m
    }
    return m
}
fn df_ps(p: Str) -> I32 {
    var v: I32 = 0
    var i: I32 = 0
    var seen = false
    while i < p.len {
        var c = byte_at(p, i)
        if c == 64 {
            seen = true
        } else {
            if seen {
                v = v * 10 + (c - 48)
            }
        }
        i += 1
    }
    return v
}
// 字面量文本 → 规范对(pack):[-]int[.frac],frac 截至多 15 位
fn df_split(t: Str) -> Str {
    var sgn: I64 = 1
    var body = t
    if body.len > 0 && byte_at(body, 0) == 45 {
        sgn = 0 - 1
        body = byte_slice(body, 1, body.len)
    }
    var ip = ""
    var fp = ""
    var dot = false
    var i: I32 = 0
    while i < body.len {
        var c = byte_at(body, i)
        if c == 46 {
            dot = true
        } else {
            if !dot {
                ip = ip + byte_slice(body, i, i + 1)
            } else {
                if fp.len < 15 {
                    fp = fp + byte_slice(body, i, i + 1)
                }
            }
        }
        i += 1
    }
    if ip == "" {
        ip = "0"
    }
    var m: I64 = 0
    var j: I32 = 0
    while j < ip.len {
        m = m * 10 + (byte_at(ip, j) - 48)
        j += 1
    }
    j = 0
    while j < fp.len {
        m = m * 10 + (byte_at(fp, j) - 48)
        j += 1
    }
    m = m * sgn
    return df_pack(m, fp.len)
}
fn df_al(m: I64, s: I32, t: I32) -> I64 {
    var r: I64 = m
    var i: I32 = s
    while i < t {
        r = r * 10
        i += 1
    }
    return r
}
// (m, s) → 规范十进制文本(scale ≤ 9,有效位 ≤ 9,尾零修剪,零 → "0")
fn df_text(m: I64, s: I32) -> Str {
    var neg = m < 0
    var a: I64 = m
    if neg {
        a = 0 - a
    }
    var sc: I32 = s
    while sc > 9 {
        a = a / 10
        sc -= 1
    }
    while a > 0 && sc > 0 && a % 10 == 0 {
        a = a / 10
        sc -= 1
    }
    while df_digits(a) > 9 && sc > 0 {
        a = a / 10
        sc -= 1
    }
    if a == 0 {
        return "0"
    }
    var ds = a.to_string()
    var t = ""
    if neg {
        t = "-"
    }
    if sc == 0 {
        return t + ds
    }
    if ds.len <= sc {
        var pad = "0."
        var z: I32 = 0
        while z < sc - ds.len {
            pad = pad + "0"
            z += 1
        }
        return t + pad + ds
    }
    return t + byte_slice(ds, 0, ds.len - sc) + "." + byte_slice(ds, ds.len - sc, ds.len)
}
fn df_can(t: Str) -> Str {
    var p = df_split(t)
    return df_text(df_pm(p), df_ps(p))
}
fn df_bin(op: Str, ta: Str, tb: Str) -> Str {
    var pa = df_split(ta)
    var pb = df_split(tb)
    var m1 = df_pm(pa)
    var s1 = df_ps(pa)
    var m2 = df_pm(pb)
    var s2 = df_ps(pb)
    if or2(op == "Add", op == "Sub") {
        var s: I32 = s1
        if s2 > s {
            s = s2
        }
        var x = df_al(m1, s1, s)
        var y = df_al(m2, s2, s)
        if op == "Sub" {
            return df_text(x - y, s)
        }
        return df_text(x + y, s)
    }
    if op == "Mul" {
        return df_text(m1 * m2, s1 + s2)
    }
    if op == "Div" {
        if m2 == 0 {
            panic("float div by zero")
            return "0"
        }
        var k: I32 = 17 - df_digits(m1)
        if k < 0 {
            k = 0
        }
        var num: I64 = m1 * df_p10(k)
        var q: I64 = num / m2
        var rm: I64 = num - q * m2
        if rm < 0 {
            rm = 0 - rm
        }
        var m2a: I64 = m2
        if m2a < 0 {
            m2a = 0 - m2a
        }
        var qinc: I64 = 1
        if q < 0 {
            qinc = 0 - 1
        }
        if m2a != 0 && rm * 2 >= m2a {
            q = q + qinc
        }
        return df_text(q, s1 - s2 + k)
    }
    panic("df_bin:" + op)
    return "0"
}
fn df_vcmp(ta: Str, tb: Str) -> I32 {
    var pa = df_split(ta)
    var pb = df_split(tb)
    var m1 = df_pm(pa)
    var s1 = df_ps(pa)
    var m2 = df_pm(pb)
    var s2 = df_ps(pb)
    var s: I32 = s1
    if s2 > s {
        s = s2
    }
    var x = df_al(m1, s1, s)
    var y = df_al(m2, s2, s)
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    return 0
}
fn df_add1(ds: Str) -> Str {
    var digits = "0123456789"
    var i: I32 = ds.len - 1
    while i >= 0 {
        var c = byte_at(ds, i)
        if c == 57 {
            i -= 1
        } else {
            var head = byte_slice(ds, 0, i)
            var mid = byte_slice(digits, c - 47, c - 46)
            var tail = ""
            var z: I32 = 0
            while z < ds.len - i - 1 {
                tail = tail + "0"
                z += 1
            }
            return head + mid + tail
        }
    }
    var out = "1"
    var z2: I32 = 0
    while z2 < ds.len {
        out = out + "0"
        z2 += 1
    }
    return out
}
// %g(6 位有效,镜像 C printf;十进制定点近似,二进制舍入细节挂账)
fn df_g(t: Str) -> Str {
    var neg = byte_at(t, 0) == 45
    var body = t
    if neg {
        body = byte_slice(t, 1, t.len)
    }
    var ip = ""
    var fp = ""
    var dot = false
    var i: I32 = 0
    while i < body.len {
        var c = byte_at(body, i)
        if c == 46 {
            dot = true
        } else {
            if !dot {
                ip = ip + byte_slice(body, i, i + 1)
            } else {
                fp = fp + byte_slice(body, i, i + 1)
            }
        }
        i += 1
    }
    var digits = ip + fp
    while digits.len > 1 && byte_at(digits, 0) == 48 {
        digits = byte_slice(digits, 1, digits.len)
    }
    var xe: I32 = 0
    if ip == "0" {
        var z: I32 = 0
        while z < fp.len && byte_at(fp, z) == 48 {
            z += 1
        }
        xe = 0 - z - 1
    } else {
        xe = ip.len - 1
    }
    var keep = digits
    if keep.len > 6 {
        var rest = byte_at(keep, 6)
        keep = byte_slice(keep, 0, 6)
        if rest >= 53 {
            keep = df_add1(keep)
        }
    }
    while keep.len > 1 && byte_at(keep, keep.len - 1) == 48 {
        keep = byte_slice(keep, 0, keep.len - 1)
    }
    var e: I32 = xe
    if keep.len > 6 {
        e = xe + 1
        keep = byte_slice(keep, 0, 1) + byte_slice(keep, 1, 6)
    }
    var sgn = ""
    if neg {
        sgn = "-"
    }
    if or2(e < -4, e >= 6) {
        var mant = byte_slice(keep, 0, 1)
        if keep.len > 1 {
            mant = mant + "." + byte_slice(keep, 1, keep.len)
        }
        var ae = e
        var es = "+"
        if ae < 0 {
            es = "-"
            ae = 0 - ae
        }
        var es2 = ae.to_string()
        while es2.len < 2 {
            es2 = "0" + es2
        }
        return sgn + mant + "e" + es + es2
    }
    if e >= 0 {
        var pnt = e + 1
        if keep.len <= pnt {
            var r = keep
            var z2: I32 = keep.len
            while z2 < pnt {
                r = r + "0"
                z2 += 1
            }
            return sgn + r
        }
        return sgn + byte_slice(keep, 0, pnt) + "." + byte_slice(keep, pnt, keep.len)
    }
    var pad = "0."
    var z3: I32 = 0
    while z3 < 0 - e - 1 {
        pad = pad + "0"
        z3 += 1
    }
    return sgn + pad + keep
}
// 可打印形式:整值 %.1f,否则 %g(rt fmt_val 同款)
fn df_show(t: Str) -> Str {
    var dot = false
    var i: I32 = 0
    while i < t.len {
        if byte_at(t, i) == 46 {
            dot = true
        }
        i += 1
    }
    if !dot {
        return t + ".0"
    }
    return df_g(t)
}

fn fmt(v: List[Str]) -> Str {
    var k = v[0]
    if k == "I" {
        return v[1]
    }
    if k == "W" {
        return v[1]
    }
    if k == "B" {
        return v[1]
    }
    if k == "S" {
        return v[1]
    }
    if k == "D" {
        return df_show(v[1])
    }
    if k == "V" {
        return ""
    }
    return "<value>"
}
fn env_at(env: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if seq2(en[0], nm) {
            return en
        }
        i += 1
    }
    return List[Str]()
}
fn env_add(env: List[Str], nm: Str, val: List[Str]) -> List[Str] {
    var out = List[Str]()
    var en = List[Str]()
    en.push(nm)
    en.push(val)
    out.push(en)
    var i: I32 = 0
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
fn env_set(env: List[Str], nm: Str, val: List[Str]) -> List[Str] {
    var out = List[Str]()
    var done = false
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if !done && seq2(en[0], nm) {
            var nb = List[Str]()
            nb.push(nm)
            nb.push(val)
            out.push(nb)
            done = true
        } else {
            out.push(en)
        }
        i += 1
    }
    return out
}
fn env_drop(env: List[Str], n: I32) -> List[Str] {
    var out = List[Str]()
    var i = n
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
// keep 块的前 n 项按名去重(保留最新):while 体绑定有界累积,新者优先查找不变
fn env_dedupe(env: List[Str], n: I32) -> List[Str] {
    var keep = List[Str]()
    var i: I32 = 0
    while i < n && i < env.len {
        var en = env[i]
        var seen = false
        var j: I32 = 0
        while j < keep.len {
            if seq2(keep[j][0], en[0]) {
                seen = true
            }
            j += 1
        }
        if !seen {
            keep.push(en)
        }
        i += 1
    }
    var out = keep
    i = n
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
fn e4(fl: Str, env: List[Str], vv: List[Str], out: Str) -> List[Str] {
    var r = List[Str]()
    r.push(fl)
    r.push(env)
    r.push(vv)
    r.push(out)
    return r
}
fn s4(fl: Str, env: List[Str], out: Str, vv: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push(fl)
    r.push(env)
    r.push(out)
    r.push(vv)
    return r
}
fn expr_of_text(s: Str) -> List[Str] {
    var toks = List[Str]()
    scan(s, toks)
    var cur = Atomic[I32](0)
    return p_stmt_expr(toks, cur, "1")
}
fn find_decl(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var tt = d[0]
        if seq2(d[1], nm) && or3(seq2(tt, "Fn"), seq2(tt, "FnPub"), seq2(tt, "FnC")) {
            return d
        }
        i += 1
    }
    return List[Str]()
}
fn unesc(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    var n = s.len
    while i < n {
        var c = byte_at(s, i)
        if c == 92 && i + 1 < n {
            var e = byte_at(s, i + 1)
            if e == 110 {
                out = out + "\n"
                i += 2
            } else if e == 116 {
                out = out + "\t"
                i += 2
            } else if e == 114 {
                out = out + "\r"
                i += 2
            } else if e == 123 {
                out = out + "\{"
                i += 2
            } else if e == 34 {
                out = out + "\""
                i += 2
            } else if e == 92 {
                out = out + "\\"
                i += 2
            } else {
                out = out + byte_slice(s, i, i + 2)
                i += 2
            }
        } else {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}

fn eval_str(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var parts = e[1]
    var acc = ""
    var env2 = env
    var j: I32 = 1
    while j < parts.len {
        var p = parts[j]
        if p[0] == "Text" {
            acc = acc + unesc(p[1])
        } else {
            var ex = expr_of_text(p[1])
            var er = eval_expr(file, env2, out, ex)
            out = er[3]
            if er[0] != "k" {
                return er
            }
            env2 = er[1]
            acc = acc + fmt(er[2])
        }
        j += 1
    }
    return e4("k", env2, vS(acc), out)
}
fn pm2(ok: Str, env: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push(ok)
    r.push(env)
    return r
}
fn enum_var(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" {
            var vs = d[3]
            var k: I32 = 1
            while k < vs.len {
                if seq2(vs[k][1], nm) {
                    return true
                }
                k += 1
            }
        }
        i += 1
    }
    return false
}
// ---------------- trait/impl 方法域(镜像 rt.c cls_method/cls_prop) ----------------
// 节点 schema:Method=[Method,nm,TPs,Ps,ret,body];Impl=[Impl,TPs,trait_ty,for_ty,Items];
// Trait=[Trait,nm,TPs,Bounds,Items];Prop=[Prop,nm,ty,body];Class=[Class,nm,TPs,Items]
fn ty_head(ty: List[Str]) -> Str {
    var t = ty[0]
    if t == "Named" {
        return ty[1]
    }
    if or3(t == "Ref", or2(t == "Slice", t == "Optional")) {
        return ty_head(ty[1])
    }
    return ""
}
fn find_trait(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Trait" && seq2(d[1], nm) {
            return d
        }
        i += 1
    }
    return List[Str]()
}
fn is_class(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Class" && seq2(d[1], nm) {
            return true
        }
        i += 1
    }
    return false
}
fn find_impl_method(file: List[Str], cls: Str, m: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" && seq2(ty_head(d[3]), cls) {
            var its = d[4]
            var k: I32 = 1
            while k < its.len {
                var it = its[k]
                if it[0] == "Method" && seq2(it[1], m) {
                    return it
                }
                k += 1
            }
            var tn = ty_head(d[2])
            if tn.len > 0 {
                var tr = find_trait(file, tn)
                if tr.len > 0 {
                    var tits = tr[4]
                    var j: I32 = 1
                    while j < tits.len {
                        var tit = tits[j]
                        if tit[0] == "Method" && seq2(tit[1], m) && tit[5][0] != "None" {
                            return tit
                        }
                        j += 1
                    }
                }
            }
        }
        i += 1
    }
    return List[Str]()
}
fn find_impl_prop(file: List[Str], cls: Str, m: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" && seq2(ty_head(d[3]), cls) {
            var its = d[4]
            var k: I32 = 1
            while k < its.len {
                var it = its[k]
                if it[0] == "Prop" && seq2(it[1], m) && it[3][0] != "None" {
                    return it
                }
                k += 1
            }
        }
        i += 1
    }
    return List[Str]()
}
fn call_method_vals(file: List[Str], env: List[Str], out: Str, mth: List[Str], sv: List[Str], vals: List[Str]) -> List[Str] {
    var ps = mth[3]
    var nenv = env_add(List[Str](), "self", bind_of(file, sv))
    var k: I32 = 1
    var ai: I32 = 0
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            nenv = env_add(nenv, pr[2], bind_of(file, vals[ai]))
            ai += 1
        }
        k += 1
    }
    var br = run_block(file, nenv, out, mth[5], false)
    var fl = "k"
    if br[0] == "a" {
        fl = "a"
    }
    return e4(fl, env, br[3], br[2])
}
fn call_prop_vals(file: List[Str], env: List[Str], out: Str, pp: List[Str], sv: List[Str]) -> List[Str] {
    var nenv = env_add(List[Str](), "self", sv)
    var br = run_block(file, nenv, out, pp[3], false)
    var fl = "k"
    if br[0] == "a" {
        fl = "a"
    }
    return e4(fl, env, br[3], br[2])
}
// ---------------- 绑定克隆与原地写(镜像 rt.c env_let/ST_ASSIGN) ----------------
// rt env_let:结构体值(非类)深克隆后才入绑定槽;类/List/标量保持引用。
// 成员写经绑定槽原地生效:结构体无别名(绑定时已克隆)→ 原地 == 重建;
// 类共享 → 原地写对别名可见。
fn bind_of(file: List[Str], v: List[Str]) -> List[Str] {
    if v[0] == "U" && !is_class(file, v[1]) {
        return vdeep(v)
    }
    return v
}
fn u_set_ip(u: List[Str], nm: Str, nv: List[Str]) -> Bool {
    var i: I32 = 2
    while i + 1 < u.len {
        if seq2(u[i], nm) {
            u[i + 1] = nv
            return true
        }
        i += 2
    }
    return false
}
fn u_field(u: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 2
    while i + 1 < u.len {
        if seq2(u[i], nm) {
            return u[i + 1]
        }
        i += 2
    }
    return List[Str]()
}
fn pat_match(pat: List[Str], v: List[Str], env: List[Str]) -> List[Str] {
    var t = pat[0]
    if t == "PatWild" {
        return pm2("1", env)
    }
    if t == "PatLitI" {
        if v[0] == "I" && dvi(v[1]) == dvi(pat[1]) {
            return pm2("1", env)
        }
        return pm2("0", env)
    }
    if t == "PatLitS" {
        if v[0] == "S" && seq2(v[1], pat[1]) {
            return pm2("1", env)
        }
        return pm2("0", env)
    }
    if t == "PatLitB" {
        if v[0] == "B" && seq2(v[1], pat[1]) {
            return pm2("1", env)
        }
        return pm2("0", env)
    }
    if t == "PatAgg" {
        var sub = pat[2]
        if v[0] == "U" && seq2(v[1], pat[1]) && sub[0] == "SubSt" {
            var env2 = env
            var ok3 = true
            var k: I32 = 1
            while k < sub.len && ok3 {
                var pf = sub[k]
                var nm2 = pf[1]
                var fv2 = u_field(v, nm2)
                if fv2.len == 0 {
                    ok3 = false
                } else {
                    if pf[2][0] == "None" {
                        env2 = env_add(env2, nm2, fv2)
                    } else {
                        var pr3 = pat_match(pf[2], fv2, env2)
                        if !seq2(pr3[0], "1") {
                            ok3 = false
                        } else {
                            env2 = pr3[1]
                        }
                    }
                }
                k += 1
            }
            if ok3 {
                return pm2("1", env2)
            }
            return pm2("0", env)
        }
        if v[0] == "T" && seq2(v[1], pat[1]) {
            if sub[0] == "SubUnit" {
                if v.len == 2 {
                    return pm2("1", env)
                }
                return pm2("0", env)
            }
            if sub[0] == "SubTup" {
                var np = sub.len - 1
                var npv = v.len - 2
                if np == npv {
                    var env3 = env
                    var ok2 = true
                    var k: I32 = 1
                    while k < sub.len && ok2 {
                        var pp = sub[k]
                        var pv = v[k + 1]
                        var pr2 = pat_match(pp, pv, env3)
                        if !seq2(pr2[0], "1") {
                            ok2 = false
                        } else {
                            env3 = pr2[1]
                        }
                        k += 1
                    }
                    if ok2 {
                        return pm2("1", env3)
                    }
                }
                return pm2("0", env)
            }
        }
        return pm2("0", env)
    }
    if t == "PatId" {
        return pm2("1", env_add(env, pat[1], v))
    }
    if t == "PatTup" {
        if v[0] != "P" {
            return pm2("0", env)
        }
        if pat.len - 1 != v.len - 1 {
            return pm2("0", env)
        }
        var env4 = env
        var k4: I32 = 1
        while k4 < pat.len {
            var pr4 = pat_match(pat[k4], v[k4], env4)
            if !seq2(pr4[0], "1") {
                return pm2("0", env)
            }
            env4 = pr4[1]
            k4 += 1
        }
        return pm2("1", env4)
    }
    return pm2("0", env)
}
fn eval_expr(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var t = e[0]
    if t == "Int" {
        // 宽度后缀:u8/i8/u16/i16 → W 值;其余(含 i32/u32/i64/u64)沿用 I32 域
        if e.len > 2 {
            var sfx = e[2]
            if or2(sfx == "u8", or2(sfx == "i8", or2(sfx == "u16", sfx == "i16"))) {
                return e4("k", env, vW(sfx, txt_num(e[1])), out)
            }
        }
        return e4("k", env, vI(txt_num(e[1])), out)
    }
    if t == "Bool" {
        if seq2(e[1], "true") {
            return e4("k", env, vB(true), out)
        }
        return e4("k", env, vB(false), out)
    }
    if t == "Float" {
        return e4("k", env, vD(df_can(e[1])), out)
    }
    if t == "Str" {
        return eval_str(file, env, out, e)
    }
    if t == "Ident" {
        var en = env_at(env, e[1])
        if en.len > 0 {
            return e4("k", env, en[1], out)
        }
        if or2(seq2(e[1], "Some"), or2(seq2(e[1], "None"), or2(seq2(e[1], "Ok"), seq2(e[1], "Err")))) {
            var tv = List[Str]()
            tv.push("T")
            tv.push(e[1])
            return e4("k", env, tv, out)
        }
        if enum_var(file, e[1]) {
            var tv2 = List[Str]()
            tv2.push("T")
            tv2.push(e[1])
            return e4("k", env, tv2, out)
        }
        var fnd = find_decl(file, e[1])
        if fnd.len > 0 {
            var fv = List[Str]()
            fv.push("F")
            fv.push(e[1])
            return e4("k", env, fv, out)
        }
        if seq2(e[1], "parallel") {
            var ns = List[Str]()
            ns.push("NS")
            ns.push("parallel")
            return e4("k", env, ns, out)
        }
        panic("unbound:" + e[1])
        return e4("a", env, vV2(), out)
    }
    if t == "Unary" {
        var ur = eval_expr(file, env, out, e[2])
        if ur[0] != "k" {
            return ur
        }
        if seq2(e[1], "Neg") {
            if ur[2][0] == "D" {
                var dt = ur[2][1]
                if dt != "0" {
                    if byte_at(dt, 0) == 45 {
                        dt = byte_slice(dt, 1, dt.len)
                    } else {
                        dt = "-" + dt
                    }
                }
                return e4("k", ur[1], vD(dt), ur[3])
            }
            return e4("k", ur[1], vI(0 - dvi(ur[2][1])), ur[3])
        }
        return e4("k", ur[1], vB(!truth(ur[2])), ur[3])
    }
    if t == "Binary" {
        var op = e[1]
        if seq2(op, "AndAnd") {
            var lr = eval_expr(file, env, out, e[2])
            if lr[0] != "k" {
                return lr
            }
            if !truth(lr[2]) {
                return e4("k", lr[1], vB(false), lr[3])
            }
            var rr = eval_expr(file, lr[1], lr[3], e[3])
            if rr[0] != "k" {
                return rr
            }
            return e4("k", rr[1], vB(truth(rr[2])), rr[3])
        }
        var lr2 = eval_expr(file, env, out, e[2])
        if lr2[0] != "k" {
            return lr2
        }
        var rr2 = eval_expr(file, lr2[1], lr2[3], e[3])
        if rr2[0] != "k" {
            return rr2
        }
        var a = lr2[2]
        var b = rr2[2]
        if seq2(op, "Eq") {
            return e4("k", rr2[1], vB(veq(a, b)), rr2[3])
        }
        if seq2(op, "Ne") {
            return e4("k", rr2[1], vB(!veq(a, b)), rr2[3])
        }
        if seq2(op, "Lt") {
            return e4("k", rr2[1], vB(vcmp(a, b) < 0), rr2[3])
        }
        if seq2(op, "Gt") {
            return e4("k", rr2[1], vB(vcmp(a, b) > 0), rr2[3])
        }
        if seq2(op, "Le") {
            return e4("k", rr2[1], vB(vcmp(a, b) <= 0), rr2[3])
        }
        if seq2(op, "Ge") {
            return e4("k", rr2[1], vB(vcmp(a, b) >= 0), rr2[3])
        }
        if seq2(op, "Add") {
            if a[0] == "S" && b[0] == "S" {
                return e4("k", rr2[1], vS(fmt(a) + fmt(b)), rr2[3])
            }
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        if or3(seq2(op, "Sub"), seq2(op, "Mul"), seq2(op, "Div")) {
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        if seq2(op, "Mod") {
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        if or2(seq2(op, "WrapAdd"), seq2(op, "WrapSub")) {
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        panic("binop:" + op)
        return e4("a", env, vV2(), out)
    }
    if t == "Range" {
        var fr = eval_expr(file, env, out, e[2])
        if fr[0] != "k" {
            return fr
        }
        var tr = eval_expr(file, fr[1], fr[3], e[3])
        if tr[0] != "k" {
            return tr
        }
        var rv = List[Str]()
        rv.push("R")
        rv.push(e[1])
        rv.push(fr[2])
        rv.push(tr[2])
        return e4("k", tr[1], rv, tr[3])
    }
    if t == "Member" {
        var ob = eval_expr(file, env, out, e[1])
        if ob[0] != "k" {
            return ob
        }
        var recv = ob[2]
        if seq2(e[2], "TIdx") {
            var ti = e[3]
            if recv[0] == "P" {
                var pi2 = dvi(ti)
                if pi2 + 1 < recv.len {
                    return e4("k", ob[1], recv[pi2 + 1], ob[3])
                }
            }
            panic("tindex:" + ti)
            return e4("a", env, vV2(), out)
        }
        if seq2(e[2], "Nm") {
            var m = e[3]
            if seq2(m, "len") {
                if recv[0] == "S" {
                    return e4("k", ob[1], vI(recv[1].len), ob[3])
                }
                if recv[0] == "A" {
                    return e4("k", ob[1], vI(recv.len - 1), ob[3])
                }
                if recv[0] == "L" {
                    return e4("k", ob[1], vI(recv.len - 1), ob[3])
                }
                panic("len target")
                return e4("a", env, vV2(), out)
            }
            if recv[0] == "S" && seq2(m, "char_len") {
                var cl: I32 = 0
                var ci: I32 = 0
                while ci < recv[1].len {
                    if !utf8_cont(recv[1], ci) {
                        cl += 1
                    }
                    ci += 1
                }
                return e4("k", ob[1], vI(cl), ob[3])
            }
            if recv[0] == "BOX" && recv[1][0] == "U" {
                var fv3 = u_field(recv[1], m)
                if fv3.len > 0 {
                    return e4("k", ob[1], fv3, ob[3])
                }
            }
            if recv[0] == "P" && m.len > 0 && byte_at(m, 0) >= 48 && byte_at(m, 0) <= 57 {
                var pi = dvi(m)
                if pi + 1 < recv.len {
                    return e4("k", ob[1], recv[pi + 1], ob[3])
                }
            }
            if recv[0] == "U" {
                var fv = u_field(recv, m)
                if fv.len > 0 {
                    return e4("k", ob[1], fv, ob[3])
                }
                // C9f②:类实例 impl prop(rt.c EX_MEMBER 字段→cls_prop 同序)
                if is_class(file, recv[1]) {
                    var pp = find_impl_prop(file, recv[1], m)
                    if pp.len > 0 {
                        var prr = call_prop_vals(file, ob[1], ob[3], pp, recv)
                        return e4(prr[0], ob[1], prr[2], prr[3])
                    }
                }
                panic("field:" + m)
                return e4("a", env, vV2(), out)
            }
            panic("member:" + m)
            return e4("a", env, vV2(), out)
        }
        panic("tindex")
        return e4("a", env, vV2(), out)
    }
    if t == "If" {
        var cr = eval_expr(file, env, out, e[1])
        if cr[0] != "k" {
            return cr
        }
        if truth(cr[2]) {
            var br = run_block(file, cr[1], cr[3], e[2], false)
            return e4(br[0], br[1], br[3], br[2])
        }
        var el = e[3]
        if el[0] == "None" {
            return e4("k", cr[1], vV2(), cr[3])
        }
        return eval_expr(file, cr[1], cr[3], el)
    }
    if t == "BlockExpr" {
        var br = run_block(file, env, out, e[1], false)
        return e4(br[0], br[1], br[3], br[2])
    }
    if t == "Closure" {
        var cv = List[Str]()
        cv.push("C")
        cv.push(e[1])
        cv.push(e[3])
        cv.push(env)
        return e4("k", env, cv, out)
    }
    if t == "TupleE" {
        var tp = List[Str]()
        tp.push("P")
        var env5 = env
        var out5 = out
        var k5: I32 = 1
        while k5 < e.len {
            var er5 = eval_expr(file, env5, out5, e[k5])
            if er5[0] != "k" {
                return er5
            }
            env5 = er5[1]
            out5 = er5[3]
            tp.push(er5[2])
            k5 += 1
        }
        return e4("k", env5, tp, out5)
    }
    if t == "ArrLit" {
        var arr = List[Str]()
        arr.push("A")
        var env2 = env
        var out2 = out
        var k: I32 = 1
        while k < e.len {
            var er = eval_expr(file, env2, out2, e[k])
            if er[0] != "k" {
                return er
            }
            env2 = er[1]
            out2 = er[3]
            arr.push(er[2])
            k += 1
        }
        return e4("k", env2, arr, out2)
    }
    if t == "StructLit" {
        var su = List[Str]()
        su.push("U")
        su.push(e[1])
        var lf = e[2]
        var env2 = env
        var out2 = out
        var k: I32 = 1
        while k < lf.len {
            var fld = lf[k]
            var fv = eval_expr(file, env2, out2, fld[2])
            if fv[0] != "k" {
                return fv
            }
            env2 = fv[1]
            out2 = fv[3]
            su.push(fld[1])
            su.push(fv[2])
            k += 1
        }
        return e4("k", env2, su, out2)
    }
    if t == "Index" {
        var ob = eval_expr(file, env, out, e[1])
        if ob[0] != "k" {
            return ob
        }
        var ix = eval_expr(file, ob[1], ob[3], e[2])
        if ix[0] != "k" {
            return ix
        }
        var arrv = ob[2]
        var idx = dvi(ix[2][1])
        // C9f①:L 与 A 同布局(类别槽后逐元素),索引读同轨道(rt.c V_LIST/V_ARR 同分支)
        if !or2(seq2(arrv[0], "A"), seq2(arrv[0], "L")) {
            panic("index target")
            return e4("a", env, vV2(), out)
        }
        if idx < 0 {
            panic("index target")
            return e4("a", env, vV2(), out)
        }
        if idx >= arrv.len - 1 {
            panic("index target")
            return e4("a", env, vV2(), out)
        }
        return e4("k", ix[1], arrv[idx + 1], ix[3])
    }
    if t == "Match" {
        var sr = eval_expr(file, env, out, e[1])
        if sr[0] != "k" {
            return sr
        }
        var arms = e[2]
        var i2: I32 = 1
        var found = false
        var res = e4("k", sr[1], vV2(), sr[3])
        while i2 < arms.len && !found {
            var arm = arms[i2]
            var pm = pat_match(arm[1], sr[2], sr[1])
            if seq2(pm[0], "1") {
                var ae = eval_expr(file, pm[1], sr[3], arm[2])
                res = ae
                found = true
            }
            i2 += 1
        }
        if found {
            return res
        }
        panic("match no arm")
        return e4("a", env, vV2(), out)
    }
    if t == "TypeArgs" {
        if e[1][0] == "Ident" && seq2(e[1][1], "Simd") {
            var sv = List[Str]()
            sv.push("SIMD")
            sv.push(ty_head(e[2][1]))
            sv.push(e[2][2][1])
            return e4("k", env, sv, out)
        }
        return eval_expr(file, env, out, e[1])
    }
    if t == "Own" {
        var obr = run_block(file, env, out, e[2], false)
        return e4(obr[0], obr[1], obr[3], obr[2])
    }
    if t == "Scope" {
        var scv = List[Str]()
        scv.push("SCOPE")
        var nenv = env_add(env, e[1], scv)
        var sbr = run_block(file, nenv, out, e[2], false)
        return e4(sbr[0], sbr[1], sbr[3], sbr[2])
    }
    if t == "Try" {
        var xr = eval_expr(file, env, out, e[1])
        if xr[0] != "k" {
            return xr
        }
        var xv = xr[2]
        if xv[0] == "T" {
            if or2(seq2(xv[1], "None"), seq2(xv[1], "Err")) {
                return e4("r", xr[1], xv, xr[3])
            }
            if or2(seq2(xv[1], "Some"), seq2(xv[1], "Ok")) {
                if xv.len == 3 {
                    return e4("k", xr[1], xv[2], xr[3])
                }
                return e4("k", xr[1], xv, xr[3])
            }
        }
        return e4("k", xr[1], xv, xr[3])
    }
    if t == "Call" {
        return eval_call(file, env, out, e)
    }
    if t == "Void" {
        return e4("k", env, vV2(), out)
    }
    panic("expr:" + t)
    return e4("a", env, vV2(), out)
}
fn call_decl_vals(file: List[Str], env: List[Str], out: Str, d: List[Str], vals: List[Str]) -> List[Str] {
    var ps = d[3]
    var nenv = List[Str]()
    var k: I32 = 1
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            nenv = env_add(nenv, pr[2], bind_of(file, vals[k - 1]))
        }
        k += 1
    }
    var br = run_block(file, nenv, out, d[5], false)
    var fl = "k"
    if br[0] == "a" {
        fl = "a"
    }
    return e4(fl, env, br[3], br[2])
}
fn call_cv(file: List[Str], env: List[Str], out: Str, v: List[Str], vals: List[Str]) -> List[Str] {
    if seq2(v[0], "F") {
        var d = find_decl(file, v[1])
        if d.len == 0 {
            panic("no fn:" + v[1])
            return e4("a", env, vV2(), out)
        }
        return call_decl_vals(file, env, out, d, vals)
    }
    if seq2(v[0], "C") {
        var cap = v[3]
        var cp = v[1]
        var nenv = cap
        var k: I32 = 1
        while k < cp.len {
            nenv = env_add(nenv, cp[k][2], vals[k - 1])
            k += 1
        }
        var br = eval_expr(file, nenv, out, v[2])
        return e4(br[0], env, br[2], br[3])
    }
    panic("call value")
    return e4("a", env, vV2(), out)
}
fn call_id(file: List[Str], env: List[Str], out: Str, nm: Str, vals: List[Str]) -> List[Str] {
    if seq2(nm, "print") {
        if vals.len == 1 {
            return e4("k", env, vV2(), out + fmt(vals[0]))
        }
        panic("print arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "println") {
        if vals.len == 1 {
            return e4("k", env, vV2(), out + fmt(vals[0]) + "\n")
        }
        panic("println arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert") {
        if vals.len == 1 {
            if truth(vals[0]) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert failed"), out)
        }
        panic("assert arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert_eq") {
        if vals.len == 2 {
            if veq(vals[0], vals[1]) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert_eq failed: " + fmt(vals[0]) + " != " + fmt(vals[1])), out)
        }
        panic("assert_eq arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert_ne") {
        if vals.len == 2 {
            if !veq(vals[0], vals[1]) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert_ne failed: " + fmt(vals[0]) + " != " + fmt(vals[1])), out)
        }
        panic("assert_ne arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "read_file") {
        if vals.len == 1 && vals[0][0] == "S" {
            var rr = read_file(vals[0][1])
            match rr {
                Some(s) => {
                    var tv = List[Str]()
                    tv.push("T")
                    tv.push("Some")
                    tv.push(vS(s))
                    return e4("k", env, tv, out)
                }
                None => {
                    var tw = List[Str]()
                    tw.push("T")
                    tw.push("None")
                    return e4("k", env, tw, out)
                }
            }
        }
        panic("read_file args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "read_dir") {
        if vals.len == 1 && vals[0][0] == "S" {
            var rd = read_dir(vals[0][1])
            match rd {
                Some(s2) => {
                    var tv2 = List[Str]()
                    tv2.push("T")
                    tv2.push("Some")
                    tv2.push(vS(s2))
                    return e4("k", env, tv2, out)
                }
                None => {
                    var tw2 = List[Str]()
                    tw2.push("T")
                    tw2.push("None")
                    return e4("k", env, tw2, out)
                }
            }
        }
        panic("read_dir args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "byte_at") {
        if vals.len == 2 && vals[0][0] == "S" && vals[1][0] == "I" {
            return e4("k", env, vI(byte_at(vals[0][1], dvi(vals[1][1]))), out)
        }
        panic("byte_at arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "byte_slice") {
        if vals.len == 3 && vals[0][0] == "S" && vals[1][0] == "I" && vals[2][0] == "I" {
            return e4("k", env, vS(byte_slice(vals[0][1], dvi(vals[1][1]), dvi(vals[2][1]))), out)
        }
        panic("byte_slice arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "panic") {
        if vals.len == 1 {
            return e4("a", env, vS(fmt(vals[0])), out)
        }
        panic("panic arity")
        return e4("a", env, vV2(), out)
    }
    if or2(seq2(nm, "Some"), or2(seq2(nm, "None"), or2(seq2(nm, "Ok"), seq2(nm, "Err")))) {
        var tv = List[Str]()
        tv.push("T")
        tv.push(nm)
        var qq: I32 = 0
        while qq < vals.len {
            tv.push(vals[qq])
            qq += 1
        }
        return e4("k", env, tv, out)
    }
    var evb = env_at(env, nm)
    if evb.len > 0 {
        var kv = evb[1]
        if or2(seq2(kv[0], "C"), seq2(kv[0], "F")) {
            return call_cv(file, env, out, kv, vals)
        }
    }
    var d = find_decl(file, nm)
    if d.len == 0 {
        var va = variant_arity(file, nm)
        if va >= 0 {
            if va == vals.len {
                var tv3 = List[Str]()
                tv3.push("T")
                tv3.push(nm)
                var q3: I32 = 0
                while q3 < vals.len {
                    tv3.push(vals[q3])
                    q3 += 1
                }
                return e4("k", env, tv3, out)
            }
            panic("variant arity:" + nm)
            return e4("a", env, vV2(), out)
        }
        panic("no fn:" + nm)
        return e4("a", env, vV2(), out)
    }
    return call_decl_vals(file, env, out, d, vals)
}
// 变体载荷元数:非变体 → -1;KUnit → 0;KTuple → 类型个数
fn variant_arity(file: List[Str], nm: Str) -> I32 {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" {
            var vs = d[3]
            var j: I32 = 1
            while j < vs.len {
                var vt = vs[j]
                if seq2(vt[1], nm) {
                    var kd = vt[2]
                    if kd[0] == "KTuple" {
                        return kd.len - 1
                    }
                    return 0
                }
                j += 1
            }
        }
        i += 1
    }
    return 0 - 1
}
// T 快捷构造(枚举变体/Option/Result 值)
fn vT(vt: Str, p: List[Str]) -> List[Str] {
    var v = List[Str]()
    v.push("T")
    v.push(vt)
    v.push(p)
    return v
}
// as[T]() 显式转换:浮转整截断;整窄化按宽度回绕;宽整型维持 I32 域
fn conv_as(v: List[Str], tgt: Str) -> List[Str] {
    if or2(tgt == "F64", tgt == "F32") {
        if or2(v[0] == "I", v[0] == "W") {
            return vD(df_can(v[1]))
        }
        return v
    }
    if or2(tgt == "U8", or2(tgt == "I8", or2(tgt == "U16", tgt == "I16"))) {
        var wl = "u8"
        if tgt == "I8" {
            wl = "i8"
        }
        if tgt == "U16" {
            wl = "u16"
        }
        if tgt == "I16" {
            wl = "i16"
        }
        var iv = 0
        if v[0] == "D" {
            iv = d_intpart(v[1])
        } else {
            iv = dvi(v[1])
        }
        var s: I32 = 1
        var k: I32 = 0
        while k < w_bits(wl) {
            s = s * 2
            k += 1
        }
        var m = iv % s
        if m < 0 {
            m += s
        }
        if w_signed(wl) && m > w_max(wl) {
            m -= s
        }
        return vW(wl, m)
    }
    if v[0] == "D" {
        return vI(d_intpart(v[1]))
    }
    if v[0] == "W" {
        return vI(dvi(v[1]))
    }
    return v
}
// 十进制定点文本 → 截断整数(取小数点前)
fn d_intpart(t: Str) -> I32 {
    var i: I32 = 0
    var n = t.len
    while i < n {
        if byte_at(t, i) == 46 {
            n = i
        }
        i += 1
    }
    return dvi(byte_slice(t, 0, n))
}
// parallel.map/reduce(顺序化:闭包逐元素即刻执行)
fn ns_map_reduce(file: List[Str], ob: List[Str], vals: List[Str], ismap: Bool) -> List[Str] {
    var av = vals[0]
    if !or2(av[0] == "A", av[0] == "L") {
        panic("parallel target")
        return e4("a", ob[1], vV2(), ob[3])
    }
    if ismap {
        var outv = List[Str]()
        outv.push(av[0])
        var i: I32 = 1
        while i < av.len {
            var fa = List[Str]()
            fa.push(av[i])
            var er = call_cv(file, ob[1], ob[3], vals[1], fa)
            if er[0] != "k" {
                return er
            }
            outv.push(er[2])
            i += 1
        }
        return e4("k", ob[1], outv, ob[3])
    }
    var acc = vals[1]
    var i2: I32 = 1
    while i2 < av.len {
        var fa2 = List[Str]()
        fa2.push(acc)
        fa2.push(av[i2])
        var er2 = call_cv(file, ob[1], ob[3], vals[2], fa2)
        if er2[0] != "k" {
            return er2
        }
        acc = er2[2]
        i2 += 1
    }
    return e4("k", ob[1], acc, ob[3])
}
// UTF-8 续字节:0x80..0xBF
fn utf8_cont(s: Str, k: I32) -> Bool {
    var c = byte_at(s, k)
    return c >= 128 && c < 192
}
// 子串包含(朴素匹配)
fn str_contains(s: Str, sub: Str) -> Bool {
    var n = s.len
    var m = sub.len
    if m == 0 {
        return true
    }
    var i: I32 = 0
    while i + m <= n {
        var j: I32 = 0
        var ok = true
        while j < m && ok {
            if byte_at(s, i + j) != byte_at(sub, j) {
                ok = false
            }
            j += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}
// Option/Result 组合子(recv = ["T", "Some/None/Ok/Err", payload?])
fn call_mem(file: List[Str], env: List[Str], out: Str, cal: List[Str], vals: List[Str]) -> List[Str] {
    var ob = eval_expr(file, env, out, cal[1])
    if ob[0] != "k" {
        return ob
    }
    var recv = ob[2]
    var m = cal[3]
    if seq2(m, "to_string") {
        if vals.len == 0 {
            return e4("k", ob[1], vS(fmt(recv)), ob[3])
        }
        panic("to_string arity")
        return e4("a", env, vV2(), out)
    }
    // 并发域(顺序化模拟:spawn 即刻完整执行;结果与调度无关的测试面)
    if recv[0] == "SCOPE" && seq2(m, "spawn") && vals.len == 1 {
        var noargs = List[Str]()
        var sr = call_cv(file, ob[1], ob[3], vals[0], noargs)
        var tk = List[Str]()
        tk.push("TASK")
        if sr[0] == "a" {
            tk.push("P")
            tk.push(sr[3])
        } else {
            tk.push("K")
            tk.push(sr[2])
        }
        return e4("k", ob[1], tk, ob[3] + sr[3])
    }
    if recv[0] == "TASK" && seq2(m, "join") && vals.len == 0 {
        if seq2(recv[1], "P") {
            return e4("a", ob[1], recv[2], ob[3])
        }
        return e4("k", ob[1], recv[2], ob[3])
    }
    if recv[0] == "TASK" && seq2(m, "join_or") && vals.len == 0 {
        var jr = List[Str]()
        jr.push("T")
        if seq2(recv[1], "P") {
            jr.push("Err")
            jr.push(vS("task panic"))
        } else {
            jr.push("Ok")
            jr.push(recv[2])
        }
        return e4("k", ob[1], jr, ob[3])
    }
    if or2(recv[0] == "MUX", recv[0] == "M") && or2(seq2(m, "with_mut"), seq2(m, "with")) && vals.len == 1 {
        var fa2 = List[Str]()
        if recv[0] == "M" && seq2(m, "with_mut") {
            fa2.push(recv)
        } else {
            fa2.push(recv[1])
        }
        return call_cv(file, ob[1], ob[3], vals[0], fa2)
    }
    if recv[0] == "M" && seq2(m, "fetch_add") && vals.len == 1 {
        var oldm = recv[1]
        recv[1] = val_arith("Add", oldm, vals[0])
        return e4("k", ob[1], oldm, ob[3])
    }
    if recv[0] == "NS" && seq2(m, "map") && vals.len == 2 {
        return ns_map_reduce(file, ob, vals, true)
    }
    if recv[0] == "NS" && seq2(m, "reduce") && vals.len == 3 {
        return ns_map_reduce(file, ob, vals, false)
    }
    if recv[0] == "CH" && seq2(m, "send") && vals.len == 1 {
        var capn = dvi(recv[3][1])
        if capn >= 0 && recv[1].len >= capn {
            return e4("k", ob[1], vT("Err", vS("ScopeCancelled")), ob[3])
        }
        recv[1].push(vals[0])
        return e4("k", ob[1], vT("Ok", vV2()), ob[3])
    }
    if recv[0] == "CH" && seq2(m, "recv") && vals.len == 0 {
        var cur = recv[2]
        var q2 = recv[1]
        var idx = dvi(cur[1])
        if idx >= q2.len {
            return e4("k", ob[1], vT("Err", vS("ScopeCancelled")), ob[3])
        }
        cur[1] = (idx + 1).to_string()
        return e4("k", ob[1], vT("Ok", q2[idx]), ob[3])
    }
    if recv[0] == "SIMD" && seq2(m, "splat") && vals.len == 1 {
        var vc = List[Str]()
        vc.push("VEC")
        var n = dvi(recv[2])
        var vi: I32 = 0
        while vi < n {
            vc.push(vals[0])
            vi += 1
        }
        return e4("k", ob[1], vc, ob[3])
    }
    if recv[0] == "VEC" && seq2(m, "lane") && vals.len == 1 {
        return e4("k", ob[1], recv[dvi(vals[0][1]) + 1], ob[3])
    }
    if recv[0] == "VEC" && seq2(m, "to_array") && vals.len == 0 {
        var arr2 = List[Str]()
        arr2.push("A")
        var ai: I32 = 1
        while ai < recv.len {
            arr2.push(recv[ai])
            ai += 1
        }
        return e4("k", ob[1], arr2, ob[3])
    }
    if seq2(m, "slice") {
        if vals.len == 1 && recv[0] == "S" && vals[0][0] == "R" {
            var rv = vals[0]
            var lo = dvi(rv[2][1])
            var hi = dvi(rv[3][1])
            if seq2(rv[1], "true") {
                hi += 1
            }
            var L = recv[1].len
            // UTF-8 边界(§3.3):切点不得落在续字节上
            if lo > 0 && lo < L && utf8_cont(recv[1], lo) {
                return e4("a", ob[1], vS("invalid utf8 boundary"), ob[3])
            }
            if hi > 0 && hi < L && utf8_cont(recv[1], hi) {
                return e4("a", ob[1], vS("invalid utf8 boundary"), ob[3])
            }
            if lo < 0 {
                lo = 0
            }
            if hi > L {
                hi = L
            }
            if hi < lo {
                hi = lo
            }
            return e4("k", ob[1], vS(byte_slice(recv[1], lo, hi)), ob[3])
        }
        panic("slice args")
        return e4("a", env, vV2(), out)
    }
    if seq2(m, "load") {
        if recv[0] == "M" && vals.len == 0 {
            return e4("k", ob[1], recv[1], ob[3])
        }
    }
    if seq2(m, "store") {
        if recv[0] == "M" && vals.len == 1 {
            recv[1] = vals[0]
            return e4("k", ob[1], vV2(), ob[3])
        }
    }
    if seq2(m, "push") {
        if recv[0] == "L" && vals.len == 1 {
            recv.push(vals[0])
            return e4("k", ob[1], vV2(), ob[3])
        }
    }
    if seq2(m, "into_gc") {
        if recv[0] == "L" && vals.len == 0 {
            return e4("k", ob[1], vdeep(recv), ob[3])
        }
    }
    if seq2(m, "contains") && recv[0] == "L" && vals.len == 1 {
        var fnd2 = false
        var li: I32 = 1
        while li < recv.len && !fnd2 {
            if or2(recv[li][0] == "S", recv[li][0] == "L") {
                if str_contains(fmt(recv[li]), fmt(vals[0])) {
                    fnd2 = true
                }
            } else {
                if veq(recv[li], vals[0]) {
                    fnd2 = true
                }
            }
            li += 1
        }
        return e4("k", ob[1], vB(fnd2), ob[3])
    }
    // Option/Result 组合子(recv = ["T", "Some/None/Ok/Err", payload?])
    if recv[0] == "T" {
        if seq2(m, "or") && vals.len == 1 {
            if or2(seq2(recv[1], "Some"), seq2(recv[1], "Ok")) {
                if recv.len == 3 {
                    return e4("k", ob[1], recv[2], ob[3])
                }
                return e4("k", ob[1], recv, ob[3])
            }
            return e4("k", ob[1], vals[0], ob[3])
        }
        if seq2(m, "expect") && vals.len == 1 && vals[0][0] == "S" {
            if or2(seq2(recv[1], "Some"), seq2(recv[1], "Ok")) {
                if recv.len == 3 {
                    return e4("k", ob[1], recv[2], ob[3])
                }
                return e4("k", ob[1], recv, ob[3])
            }
            return e4("a", ob[1], vS(vals[0][1]), ob[3])
        }
        if seq2(m, "is_some") && vals.len == 0 {
            return e4("k", ob[1], vB(or2(seq2(recv[1], "Some"), seq2(recv[1], "Ok"))), ob[3])
        }
        if seq2(m, "map") && vals.len == 1 {
            if seq2(recv[1], "Some") && recv.len == 3 {
                var fa = List[Str]()
                fa.push(recv[2])
                var mr = call_cv(file, ob[1], ob[3], vals[0], fa)
                if mr[0] != "k" {
                    return mr
                }
                var tv = List[Str]()
                tv.push("T")
                tv.push("Some")
                tv.push(mr[2])
                return e4("k", mr[1], tv, mr[3])
            }
            return e4("k", ob[1], recv, ob[3])
        }
        if seq2(m, "context") && vals.len == 1 && vals[0][0] == "S" {
            if seq2(recv[1], "Err") {
                var p = recv
                if recv.len == 3 {
                    p = recv[2]
                }
                var cs = List[Str]()
                cs.push("T")
                cs.push("Some")
                cs.push(p)
                var eb = List[Str]()
                eb.push("U")
                eb.push("AnyError")
                eb.push("message")
                eb.push(vS(vals[0][1]))
                eb.push("cause")
                eb.push(cs)
                eb.push("trace")
                var trl = List[Str]()
                trl.push("L")
                trl.push(vS("ctx:" + vals[0][1]))
                eb.push(trl)
                var te = List[Str]()
                te.push("T")
                te.push("Err")
                te.push(eb)
                return e4("k", ob[1], te, ob[3])
            }
            return e4("k", ob[1], recv, ob[3])
        }
    }
    if recv[0] == "U" && seq2(m, "show") && vals.len == 0 {
        return e4("k", ob[1], vS("<" + recv[1] + ">"), ob[3])
    }
    // C9f②:类实例方法/trait 默认方法(镜像 rt.c V_STRUCT&&is_class 先于 UFCS;
    // 类找不到方法直接 panic,不落 UFCS)
    if recv[0] == "U" && is_class(file, recv[1]) {
        var mth = find_impl_method(file, recv[1], m)
        if mth.len > 0 {
            return call_method_vals(file, ob[1], ob[3], mth, recv, vals)
        }
        panic("unknown method:" + m)
        return e4("a", env, vV2(), out)
    }
    var ddx = find_decl(file, m)
    if ddx.len > 0 {
        var fvv = List[Str]()
        fvv.push(recv)
        var qq: I32 = 0
        while qq < vals.len {
            fvv.push(vals[qq])
            qq += 1
        }
        return call_decl_vals(file, ob[1], ob[3], ddx, fvv)
    }
    panic("method:" + m)
    return e4("a", env, vV2(), out)
}
fn eval_call(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var ag = e[2]
    var vals = List[Str]()
    var env2 = env
    var out2 = out
    var i: I32 = 1
    while i < ag.len {
        var ar = eval_expr(file, env2, out2, ag[i])
        if ar[0] != "k" {
            return ar
        }
        env2 = ar[1]
        out2 = ar[3]
        vals.push(ar[2])
        i += 1
    }
    var cal = e[1]
    if cal[0] == "Ident" {
        return call_id(file, env2, out2, cal[1], vals)
    }
    if cal[0] == "Member" {
        return call_mem(file, env2, out2, cal, vals)
    }
    // C9f①:List 构造 List[T]()(rt.c:同参忽略,恒空表;arena.list[T]() 同)
    if cal[0] == "TypeArgs" {
        var base = cal[1]
        // as[T]() 显式转换(窄化截断,浮转整截断)
        if base[0] == "Member" && seq2(base[3], "as") {
            var ar = eval_expr(file, env2, out2, base[1])
            if ar[0] != "k" {
                return ar
            }
            var tgt = ""
            if cal[2].len > 1 {
                tgt = ty_head(cal[2][1])
            }
            return e4("k", ar[1], conv_as(ar[2], tgt), ar[3])
        }
        if base[0] == "Ident" && seq2(base[1], "Channel") {
            var cap = vals[0]
            var q = List[Str]()
            var cur = List[Str]()
            cur.push("M")
            cur.push("0")
            var tx = List[Str]()
            tx.push("CH")
            tx.push(q)
            tx.push(cur)
            tx.push(cap)
            var rx = List[Str]()
            rx.push("CH")
            rx.push(q)
            rx.push(cur)
            rx.push(cap)
            var pr = List[Str]()
            pr.push("P")
            pr.push(tx)
            pr.push(rx)
            return e4("k", env2, pr, out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Global") {
            var gv = List[Str]()
            gv.push("M")
            if vals.len > 1 {
                gv.push(vals[1])
            } else {
                gv.push(vV2())
            }
            return e4("k", env2, gv, out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Box") {
            var bv = List[Str]()
            bv.push("BOX")
            if vals.len > 0 {
                bv.push(vals[0])
            } else {
                bv.push(vV2())
            }
            return e4("k", env2, bv, out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Mutex") {
            var mx = List[Str]()
            mx.push("MUX")
            if vals.len > 0 {
                mx.push(vals[0])
            } else {
                mx.push(vV2())
            }
            return e4("k", env2, mx, out2)
        }
        var islist = false
        if base[0] == "Ident" && seq2(base[1], "List") {
            islist = true
        }
        if base[0] == "Member" && seq2(base[2], "Nm") && seq2(base[3], "list") && base[1][0] == "Ident" && seq2(base[1][1], "arena") {
            islist = true
        }
        if islist {
            return e4("k", env2, vL(), out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Atomic") {
            var mv = List[Str]()
            mv.push("M")
            if vals.len > 0 {
                mv.push(vals[0])
            } else {
                mv.push(vV2())
            }
            return e4("k", env2, mv, out2)
        }
    }
    panic("call target")
    return e4("a", env, vV2(), out)
}
fn run_stmt(file: List[Str], env: List[Str], out: Str, st: List[Str]) -> List[Str] {
    var t = st[0]
    if t == "Return" {
        if st[1][0] == "None" {
            return s4("r", env, out, vV2())
        }
        var er = eval_expr(file, env, out, st[1])
        if er[0] != "k" {
            return s4(er[0], er[1], er[3], er[2])
        }
        return s4("r", er[1], er[3], er[2])
    }
    if t == "Let" {
        var pat = st[2]
        if pat[0] == "PatId" {
            var er = eval_expr(file, env, out, st[4])
            if er[0] != "k" {
                return s4(er[0], er[1], er[3], er[2])
            }
            // 宽度注解:let x: U8/I8/U16/I16 = <整值> → 值带宽标签
            var vv = bind_of(file, er[2])
            if or2(er[2][0] == "I", er[2][0] == "W") && st[3][0] == "Named" {
                var h = ty_head(st[3])
                if or2(h == "U8", or2(h == "I8", or2(h == "U16", h == "I16"))) {
                    var wl = "u8"
                    if h == "I8" {
                        wl = "i8"
                    }
                    if h == "U16" {
                        wl = "u16"
                    }
                    if h == "I16" {
                        wl = "i16"
                    }
                    vv = vW(wl, dvi(er[2][1]))
                }
            }
            return s4("k", env_add(er[1], pat[1], vv), er[3], vV2())
        }
        if pat[0] == "PatWild" {
            var er = eval_expr(file, env, out, st[4])
            if er[0] != "k" {
                return s4(er[0], er[1], er[3], er[2])
            }
            return s4("k", er[1], er[3], vV2())
        }
        if pat[0] == "PatTup" {
            var er2 = eval_expr(file, env, out, st[4])
            if er2[0] != "k" {
                return s4(er2[0], er2[1], er2[3], er2[2])
            }
            var pmr = pat_match(pat, er2[2], er2[1])
            if seq2(pmr[0], "1") {
                return s4("k", pmr[1], er2[3], vV2())
            }
            panic("let pat mismatch")
            return s4("a", env, out, vV2())
        }
        panic("let pat:" + pat[0])
        return s4("a", env, out, vV2())
    }
    if t == "Expr" {
        var er = eval_expr(file, env, out, st[1])
        return s4(er[0], er[1], er[3], er[2])
    }
    if t == "Assign" {
        var tg = st[1]
        if tg[0] == "Member" && tg[2] == "Nm" && tg[1][0] == "Ident" {
            var oname = tg[1][1]
            var fname = tg[3]
            var en = env_at(env, oname)
            if en.len == 0 {
                panic("unbound:" + oname)
                return s4("a", env, out, vV2())
            }
            var ov = en[1]
            if ov[0] != "U" {
                panic("member assign target")
                return s4("a", env, out, vV2())
            }
            var vr = eval_expr(file, env, out, st[3])
            if vr[0] != "k" {
                return s4(vr[0], vr[1], vr[3], vr[2])
            }
            var op = st[2]
            var nv = vr[2]
            if !seq2(op, "Eq") {
                var oldf = u_field(ov, fname)
                nv = vI(ari(op, dvi(oldf[1]), dvi(nv[1])))
            }
            // C9g:原地写(镜像 rt.c ST_ASSIGN 经绑定槽直接改;结构体绑定时已克隆,类共享可见)
            if !u_set_ip(ov, fname, nv) {
                panic("field:" + fname)
                return s4("a", env, out, vV2())
            }
            return s4("k", vr[1], vr[3], vV2())
        }
        if tg[0] == "Ident" {
            var nm = tg[1]
            var en = env_at(env, nm)
            if en.len == 0 {
                panic("unbound:" + nm)
                return s4("a", env, out, vV2())
            }
            var vr = eval_expr(file, env, out, st[3])
            if vr[0] != "k" {
                return s4(vr[0], vr[1], vr[3], vr[2])
            }
            var op = st[2]
            var nv = vr[2]
            if !seq2(op, "Eq") {
                var oa = en[1]
                if oa[0] == "M" {
                    oa[1] = val_arith(op, oa[1], nv)
                    return s4("k", vr[1], vr[3], vV2())
                }
                nv = val_arith(op, oa, nv)
            }
            // C9g:结构体右值赋给绑定也克隆(镜像 rt.c b->slot = clone…)
            return s4("k", env_set(vr[1], nm, bind_of(file, nv)), vr[3], vV2())
        }
        // C9f①:索引赋值 a[i] = v / a[i] op= v —— A/L 同布局;L 经宿主 List 索引写
        // 写透共享后备(镜像 rt.c ST_ASSIGN 的 V_LIST/V_ARR 写透分支)
        if tg[0] == "Index" && tg[1][0] == "Ident" {
            var nm3 = tg[1][1]
            var en3 = env_at(env, nm3)
            if en3.len == 0 {
                panic("unbound:" + nm3)
                return s4("a", env, out, vV2())
            }
            var cont = en3[1]
            if !or2(seq2(cont[0], "A"), seq2(cont[0], "L")) {
                panic("index assign target")
                return s4("a", env, out, vV2())
            }
            var ixr = eval_expr(file, env, out, tg[2])
            if ixr[0] != "k" {
                return s4(ixr[0], ixr[1], ixr[3], ixr[2])
            }
            var idx = dvi(ixr[2][1])
            if or2(idx < 0, idx >= cont.len - 1) {
                panic("index out of bounds")
                return s4("a", env, out, vV2())
            }
            var vr = eval_expr(file, env, out, st[3])
            if vr[0] != "k" {
                return s4(vr[0], vr[1], vr[3], vr[2])
            }
            var op3 = st[2]
            var nv3 = vr[2]
            if !seq2(op3, "Eq") {
                var old3 = cont[idx + 1]
                nv3 = vI(ari(op3, dvi(old3[1]), dvi(nv3[1])))
            }
            cont[idx + 1] = nv3
            return s4("k", ixr[1], ixr[3], vV2())
        }
        panic("assign target:" + tg[0])
        return s4("a", env, out, vV2())
    }
    if t == "While" {
        var go = true
        var envw = env
        var outw = out
        var base: I32 = envw.len
        while go {
            var cr = eval_expr(file, envw, outw, st[1])
            if cr[0] != "k" {
                return s4(cr[0], cr[1], cr[3], cr[2])
            }
            envw = cr[1]
            outw = cr[3]
            if truth(cr[2]) {
                var br = run_block(file, envw, outw, st[2], true)
                if br[0] != "k" {
                    return s4(br[0], br[1], br[2], br[3])
                }
                envw = br[1]
                outw = br[2]
                // keep 累积压缩:新增段按名去重回基线,防跨轮线性增长(env_add 全量拷贝 → O(n²))
                if envw.len > base {
                    envw = env_dedupe(envw, envw.len - base)
                }
            } else {
                go = false
            }
        }
        return s4("k", envw, outw, vV2())
    }
    if t == "For" {
        var pat = st[1]
        var nm = "_"
        if pat[0] == "PatId" {
            nm = pat[1]
        }
        var ir = eval_expr(file, env, out, st[2])
        if ir[0] != "k" {
            return s4(ir[0], ir[1], ir[3], ir[2])
        }
        var it = ir[2]
        if it[0] == "A" {
            var envw3 = ir[1]
            var outw3 = ir[3]
            var c2: I32 = 1
            while c2 < it.len {
                var eit = env_add(envw3, nm, it[c2])
                var br = run_block(file, eit, outw3, st[3], false)
                if br[0] != "k" {
                    return s4(br[0], br[1], br[2], br[3])
                }
                envw3 = env_drop(br[1], 1)
                outw3 = br[2]
                c2 += 1
            }
            return s4("k", envw3, outw3, vV2())
        }
        if it[0] == "L" {
            var envl = ir[1]
            var outl = ir[3]
            var ci: I32 = 1
            while ci < it.len {
                var eit = env_add(envl, nm, it[ci])
                var br = run_block(file, eit, outl, st[3], false)
                if br[0] != "k" {
                    return s4(br[0], br[1], br[2], br[3])
                }
                envl = env_drop(br[1], 1)
                outl = br[2]
                ci += 1
            }
            return s4("k", envl, outl, vV2())
        }
        if it[0] != "R" {
            panic("for iter not range")
            return s4("a", env, out, vV2())
        }
        var lo = dvi(it[2][1])
        var hi = dvi(it[3][1])
        var incl = seq2(it[1], "true")
        var envw = ir[1]
        var outw = ir[3]
        var cur = lo
        var more = true
        if incl {
            if cur > hi {
                more = false
            }
        } else {
            if cur >= hi {
                more = false
            }
        }
        while more {
            var eit = env_add(envw, nm, vI(cur))
            var br = run_block(file, eit, outw, st[3], false)
            if br[0] != "k" {
                return s4(br[0], br[1], br[2], br[3])
            }
            envw = env_drop(br[1], 1)
            outw = br[2]
            cur += 1
            if incl {
                if cur > hi {
                    more = false
                }
            } else {
                if cur >= hi {
                    more = false
                }
            }
        }
        return s4("k", envw, outw, vV2())
    }
    panic("stmt:" + t)
    return s4("a", env, out, vV2())
}
fn run_block(file: List[Str], env0: List[Str], out: Str, blk: List[Str], keep: Bool) -> List[Str] {
    var flow = "k"
    var env = env0
    var o2 = out
    var val = vV2()
    var i: I32 = 1
    while i < blk.len - 1 {
        if flow == "k" {
            var sr = run_stmt(file, env, o2, blk[i])
            flow = sr[0]
            env = sr[1]
            o2 = sr[2]
            val = sr[3]
        }
        i += 1
    }
    if flow == "k" {
        var tl = blk[blk.len - 1]
        if tl[0] == "None" {
            val = vV2()
        } else {
            var er = eval_expr(file, env, o2, tl)
            flow = er[0]
            env = er[1]
            val = er[2]
            o2 = er[3]
        }
    }
    // 镜像 rt 可观察行为:while 体 keep=true 绑定留存但按名去重(有界,防 O(n²)),
    // 其余块照丢。rt 实现为链帧泄漏怪癖,此处以显式去重等价复刻其可观察语义。
    var extra = env.len - env0.len
    if extra > 0 {
        if keep {
            env = env_dedupe(env, extra)
        } else {
            // RAII(§6.4):作用域退出按声明逆序 drop(仅 impl Drop 的类/结构体值)
            // env 为前插式:新增段是 [0, extra),逆声明序 = 下标升序
            var di: I32 = 0
            while di < extra {
                var dv = env[di][1]
                if dv[0] == "U" {
                    var dm = find_impl_method(file, dv[1], "drop")
                    if dm.len > 0 {
                        // drop(self) 免克隆:字段共享单元(Atomic)的写入必须透到原件
                        var dnenv = env_add(List[Str](), "self", dv)
                        var dbr = run_block(file, dnenv, o2, dm[5], false)
                        o2 = dbr[2]
                    }
                }
                di += 1
            }
            env = env_drop(env, extra)
        }
    }
    return s4(flow, env, o2, val)
}
// static let 预绑定:文件级 Static(false) 声明按序求值入 env(镜像 rt 全局初始化)
fn statics_env(file: List[Str]) -> List[Str] {
    var env = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Static" && d[2] == "false" {
            var vr = eval_expr(file, env, "", d[4])
            if vr[0] == "k" {
                env = env_add(env, d[1], bind_of(file, vr[2]))
            }
        }
        if d[0] == "Const" {
            var vr2 = eval_expr(file, env, "", d[3])
            if vr2[0] == "k" {
                env = env_add(env, d[1], bind_of(file, vr2[2]))
            }
        }
        i += 1
    }
    return env
}
fn run_tests(file: List[Str]) -> List[Str] {
    var env0 = statics_env(file)
    var acc = ""
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Test" {
            var br = run_block(file, env0, "", d[2], false)
            if br[0] == "a" {
                return s4("a", br[1], acc + br[2], br[3])
            }
            acc = acc + br[2]
        }
        i += 1
    }
    return s4("k", List[Str](), acc, vV2())
}
