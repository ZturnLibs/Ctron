// =====================================================================
// driver_check.ct —— 编译器入口(检查模式)
// parse → 单文件语义检查即止;诊断逐条 "CODE: msg" 打印并止(rc=1),
// 干净打印 "check OK decls=N"(N = 顶层 decl 数)并返回 rc=0。
// --format=json(§10.2):构建锚 ANCHORFMT 注入("1"/"0";非 sed 路径恒文本面),
// 输出冻结 schema:code/severity/message/file/span/notes/fixes。
// span 为 v0 近似:以消息尾段名定位源码首含行(列恒 1);解析器 span 标注(类型检查 v1)落地后替换。
// 输入锚:read_file("../selfhosted/input_cc.ct"),构建/运行脚本换靶。
// =====================================================================
fn json_escape(s: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = s.len
    while j < n {
        var c = byte_at(s, j)
        if c == 34 {
            out = out + "\\\""
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else {
            out = out + byte_slice(s, j, j + 1)
        }
        j += 1
    }
    return out
}

fn has_sub(hay: Str, nd: Str) -> Bool {
    var nn = nd.len
    if nn == 0 {
        return true
    }
    var hn = hay.len
    var i: I32 = 0
    while i + nn <= hn {
        var k: I32 = 0
        var ok = true
        while k < nn {
            if byte_at(hay, i + k) != byte_at(nd, k) { ok = false }
            k += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}

fn probe_line(src: Str, msg: Str) -> I32 {
    // 取 msg 最后一段(": " 之后)作探针在源码中定位首含行;找不到退回 1
    var probe = msg
    var j: I32 = 0
    var last: I32 = -1
    while j + 1 < msg.len {
        if byte_at(msg, j) == 58 && byte_at(msg, j + 1) == 32 { last = j }
        j += 1
    }
    if last >= 0 { probe = byte_slice(msg, last + 2, msg.len) }
    if probe.len == 0 { return 1 }
    var line: I32 = 1
    var pass = 0
    var start: I32 = 0
    var i2: I32 = 0
    var n2 = src.len
    var probe2 = probe
    while pass < 2 {
        if pass == 1 {
            var dot: I32 = -1
            var q: I32 = 0
            while q < probe.len {
                if byte_at(probe, q) == 46 { dot = q }
                q += 1
            }
            if dot < 0 {
                probe2 = ""
            } else {
                probe2 = byte_slice(probe, dot + 1, probe.len)
            }
            line = 1
            start = 0
            i2 = 0
        }
        if probe2.len > 0 {
        while i2 <= n2 {
            var hit = false
            if i2 == n2 {
                hit = true
            } else {
                hit = byte_at(src, i2) == 10
            }
            if hit {
                if has_sub(byte_slice(src, start, i2), probe2) {
                    return line
                }
                line += 1
                start = i2 + 1
            }
            i2 += 1
        }
        }
        pass += 1
    }
    return 1
}

fn json_diag(path: Str, src: Str, ln: Str, first: Bool) {
    var sp: I32 = 0
    while sp < ln.len && byte_at(ln, sp) != 32 { sp += 1 }
    var code = byte_slice(ln, 0, sp)
    if sp > 0 && byte_at(code, sp - 1) == 58 {
        code = byte_slice(code, 0, sp - 1)
    }
    var msg = byte_slice(ln, sp + 1, ln.len)
    var sev = "error"
    if byte_at(code, 0) == 87 { sev = "warning" }
    // span 标注:code 段 "CODE@行" → 精确行;无标注 → probe 近似(v0 回退)
    var at: I32 = 0
    var atok: I32 = -1
    var q: I32 = 0
    while q < code.len {
        if byte_at(code, q) == 64 { atok = q }
        q += 1
    }
    if atok >= 0 {
        at = dvi(byte_slice(code, atok + 1, code.len))
        code = byte_slice(code, 0, atok)
    }
    if at <= 0 {
        at = probe_line(src, msg)
    }
    if !first { print(",") }
    print("\{\"code\":\"" + json_escape(code) + "\",\"severity\":\"" + sev + "\",\"message\":\"" + json_escape(msg) + "\",\"file\":\"" + json_escape(path) + "\",\"span\":\{\"line_start\":" + at.to_string() + ",\"col_start\":1,\"line_end\":" + at.to_string() + ",\"col_end\":1},\"notes\":[],\"fixes\":[]}")
}

// 文本面剥离 span 标注:码后 "@<数字>"(诊断内部携带行号,JSON 面消费)
fn strip_at(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        var drop = false
        if c == 64 {
            var j = i + 1
            var nd = 0
            while j < s.len && byte_at(s, j) >= 48 && byte_at(s, j) <= 57 {
                j += 1
                nd += 1
            }
            if nd > 0 && j < s.len && byte_at(s, j) == 58 {
                drop = true
                out = out + ":"
                i = j + 1
            }
        }
        if !drop {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}
fn main() -> I32 {
    let path = "../selfhosted/input_cc.ct"
    let src = read_file(path)
    match src {
        Some(s) => {
            var toks = List[Str]()
            var lns = List[Str]()
            var cols = List[Str]()
            var pdiags = List[Str]()
            scan4(s, toks, lns, cols, pdiags)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur, lns, cols, pdiags)
            // 模块加载器(§2):use 解析 → 可见性 → 合并;无 use 时为无感直通
            var ldiags = List[Str]()
            var lstack = List[Str]()
            var epath = ctron_entry()
            if seq2(epath, "") {
                epath = path
            }
            lstack.push(epath)
            // 词法/解析诊断(镜像 seed:PATH:LINE:COL CODE: MSG)→ 止于 rc=1
            if pdiags.len > 0 {
                var pi: I32 = 0
                while pi < pdiags.len {
                    println(epath + ":" + pdiags[pi])
                    pi += 1
                }
                return 1
            }
            file = pkg_load_use(file, pkg_dir_of(epath), lstack, ldiags)
            if ldiags.len > 0 {
                var li: I32 = 0
                while li < ldiags.len {
                    println(ldiags[li])
                    li += 1
                }
                return 1
            }
            var chk_fmt = ctron_cli_flag("format")
            if chk_fmt.len == 0 {
                chk_fmt = "ANCHORFMT"
            }
            var chk_prof = ctron_cli_flag("profile")
            if chk_prof.len == 0 {
                chk_prof = "ANCHORPROFILE"
            }
            var sems = sem_walk2(file, chk_prof)
            if or2(seq2(chk_fmt, "1"), seq2(chk_fmt, "json")) {
                print("\{\"diagnostics\":[")
                if !seq2(sems, "") {
                    var i: I32 = 0
                    var first = true
                    while i < sems.len {
                        var e: I32 = i
                        while e < sems.len && byte_at(sems, e) != 10 { e += 1 }
                        if e > i {
                            json_diag(path, s, byte_slice(sems, i, e), first)
                            first = false
                        }
                        i = e + 1
                    }
                    println("]}")
                    return 1
                }
                println("]}")
                return 0
            }
            if !seq2(sems, "") {
                print(strip_at(sems))
                return 1
            }
            println("check OK decls=" + (file.len - 1).to_string())
            var chk_trusted = ctron_cli_flag("trusted")
            if chk_trusted.len == 0 {
                chk_trusted = "ANCHORTAUSTED"
            }
            if seq2(chk_trusted, "1") {
                // 信任边界审计(§9.6):枚举全部 #[trusted] extern
                var ai: I32 = 1
                while ai < file.len {
                    var ad = file[ai]
                    if ad[0] == "FnExt" {
                        if ad.len > 7 {
                            println("trusted: " + ad[1] + "@" + nline(ad))
                        }
                    }
                    ai += 1
                }
            }
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
