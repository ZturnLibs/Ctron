// =====================================================================
// driver_check.ct —— 编译器入口(检查模式)
// parse → 单文件语义检查即止;诊断逐条 "CODE: msg" 打印并止(rc=1),
// 干净打印 "check OK decls=N"(N = 顶层 decl 数)并返回 rc=0。
// --format=json(§10.2):旗标回退——--format=json|1 旗标优先(native 亦可),
// 缺省回落构建锚 ANCHORFMT("1"/"0" 由 sed 注入;字面未注入即文本面),
// 输出冻结 schema:code/severity/message/file/span/notes/fixes。
// span 为 v0 近似:以消息尾段名定位源码首含行(列恒 1);解析器 span 标注(类型检查 v1)落地后替换。
// 输入锚:read_file("ANCHORINPUT") 中性锚,构建/运行脚本换靶(compiler/ 不依赖 selfhosted)。
// =====================================================================
fn json_escape(s: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = s.len
    while j < n {
        var c = byte_at(s, j)
        if c == 34 {
            out = out + "\\\""
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else {
            out = out + byte_slice(s, j, j + 1)
        }
        j += 1
    }
    return out
}

fn has_sub(hay: Str, nd: Str) -> Bool {
    var nn = nd.len
    if nn == 0 {
        return true
    }
    var hn = hay.len
    var i: I32 = 0
    while i + nn <= hn {
        var k: I32 = 0
        var ok = true
        while k < nn {
            if byte_at(hay, i + k) != byte_at(nd, k) { ok = false }
            k += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}

fn probe_line(src: Str, msg: Str) -> I32 {
    // 取 msg 最后一段(": " 之后)作探针在源码中定位首含行;找不到退回 1
    var probe = msg
    var j: I32 = 0
    var last: I32 = -1
    while j + 1 < msg.len {
        if byte_at(msg, j) == 58 && byte_at(msg, j + 1) == 32 { last = j }
        j += 1
    }
    if last >= 0 { probe = byte_slice(msg, last + 2, msg.len) }
    if probe.len == 0 { return 1 }
    var line: I32 = 1
    var pass = 0
    var start: I32 = 0
    var i2: I32 = 0
    var n2 = src.len
    var probe2 = probe
    while pass < 2 {
        if pass == 1 {
            var dot: I32 = -1
            var q: I32 = 0
            while q < probe.len {
                if byte_at(probe, q) == 46 { dot = q }
                q += 1
            }
            if dot < 0 {
                probe2 = ""
            } else {
                probe2 = byte_slice(probe, dot + 1, probe.len)
            }
            line = 1
            start = 0
            i2 = 0
        }
        if probe2.len > 0 {
        while i2 <= n2 {
            var hit = false
            if i2 == n2 {
                hit = true
            } else {
                hit = byte_at(src, i2) == 10
            }
            if hit {
                if has_sub(byte_slice(src, start, i2), probe2) {
                    return line
                }
                line += 1
                start = i2 + 1
            }
            i2 += 1
        }
        }
        pass += 1
    }
    return 1
}

// T18:parser 诊断 JSON 输出(pdiags 格式 "LINE:COL CODE: msg" → 精确 span)
fn json_diag_lc(path: Str, ln: Str, first: Bool) {
    var p1: I32 = 0
    while p1 < ln.len && byte_at(ln, p1) != 58 { p1 += 1 }
    var lno = dvi(byte_slice(ln, 0, p1))
    var p2: I32 = p1 + 1
    while p2 < ln.len && byte_at(ln, p2) != 32 { p2 += 1 }
    var col = dvi(byte_slice(ln, p1 + 1, p2))
    var rest = byte_slice(ln, p2 + 1, ln.len)
    var sp: I32 = 0
    while sp < rest.len && byte_at(rest, sp) != 32 { sp += 1 }
    var code = byte_slice(rest, 0, sp)
    if sp > 0 && byte_at(code, sp - 1) == 58 {
        code = byte_slice(code, 0, sp - 1)
    }
    var msg = byte_slice(rest, sp + 1, rest.len)
    var sev = "error"
    if byte_at(code, 0) == 87 { sev = "warning" }
    if !first { print(",") }
    print("\{\"code\":\"" + json_escape(code) + "\",\"severity\":\"" + sev + "\",\"message\":\"" + json_escape(msg) + "\",\"file\":\"" + json_escape(path) + "\",\"span\":\{\"line_start\":" + lno.to_string() + ",\"col_start\":" + col.to_string() + ",\"line_end\":" + lno.to_string() + ",\"col_end\":" + (col + 1).to_string() + "},\"notes\":[],\"fixes\":[]}")
}

fn json_diag(path: Str, src: Str, ln: Str, first: Bool) {
    var sp: I32 = 0
    while sp < ln.len && byte_at(ln, sp) != 32 { sp += 1 }
    var code = byte_slice(ln, 0, sp)
    if sp > 0 && byte_at(code, sp - 1) == 58 {
        code = byte_slice(code, 0, sp - 1)
    }
    var msg = byte_slice(ln, sp + 1, ln.len)
    var sev = "error"
    if byte_at(code, 0) == 87 { sev = "warning" }
    // span 标注:code 段 "CODE@行" → 精确行;无标注 → probe 近似(v0 回退)
    var at: I32 = 0
    var atok: I32 = -1
    var q: I32 = 0
    while q < code.len {
        if byte_at(code, q) == 64 { atok = q }
        q += 1
    }
    if atok >= 0 {
        at = dvi(byte_slice(code, atok + 1, code.len))
        code = byte_slice(code, 0, atok)
    }
    if at <= 0 {
        at = probe_line(src, msg)
    }
    if !first { print(",") }
    // T19 fix-it:按码生成机器可执行修复建议(§10.1 首批三码)
    var fixes = "[]"
    if seq2(code, "E3030") {
        fixes = "[\{\"title\":\"static var 不存在;用 let(不可变)或 Global[T](可变全局)\",\"edits\":[\{\"kind\":\"replace\",\"span\":\{\"line_start\":" + at.to_string() + ",\"col_start\":1,\"line_end\":" + at.to_string() + ",\"col_end\":11},\"text\":\"let\"}]}]"
    }
    if seq2(code, "E2020") {
        fixes = "[\{\"title\":\"检查拼写或添加 use 导入\",\"edits\":[]}]"
    }
    if seq2(code, "W8010") {
        fixes = "[\{\"title\":\"struct 含类引用字段拷贝浅共享;改值字段或显式 Box\",\"edits\":[]}]"
    }
    print("\{\"code\":\"" + json_escape(code) + "\",\"severity\":\"" + sev + "\",\"message\":\"" + json_escape(msg) + "\",\"file\":\"" + json_escape(path) + "\",\"span\":\{\"line_start\":" + at.to_string() + ",\"col_start\":1,\"line_end\":" + at.to_string() + ",\"col_end\":1},\"notes\":[],\"fixes\":" + fixes + "}")
}

// 文本面剥离 span 标注:码后 "@<数字>"(诊断内部携带行号,JSON 面消费)
fn strip_at(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        var drop = false
        if c == 64 {
            var j = i + 1
            var nd = 0
            while j < s.len && byte_at(s, j) >= 48 && byte_at(s, j) <= 57 {
                j += 1
                nd += 1
            }
            if nd > 0 && j < s.len && byte_at(s, j) == 58 {
                drop = true
                out = out + ":"
                i = j + 1
            }
        }
        if !drop {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}
fn main() -> I32 {
    let path = "ANCHORINPUT"
    // read_file 实参必须是 Str 字面量:发射时 ct_swap_anchor 换为 CLI 标记,
    // 原生 ctron-chk 才能响应 `run <file>` 覆盖(seed 面由 ctc.sh sed 换靶,双口径同源)。
    let src = read_file("ANCHORINPUT")
    match src {
        Some(s) => {
            var epath = ctron_entry()
            if seq2(epath, "") {
                epath = path
            }
            if gui_is_ctml(epath) {
                // 独立 .ctml 检查(SL-6c;§5.1 语法缝):标记 tokenizer → GuiBlock File 节
                // → gui_check_file 同径走查,不经 .ct 词法/解析/语义。诊断先出(收集式
                // 不中止),警告随 OK 行后印(E8193 警告级不置 rc)
                var gfile = gui_ctml_file(s)
                var cml_dump = ctron_cli_flag("dumpgui")
                if cml_dump.len == 0 {
                    cml_dump = "ANCHORDUMPGUI"
                }
                var cml_diags = List[Str]()
                var cml_warns = List[Str]()
                gui_check_file(gfile, cml_diags, cml_warns, true)
                if cml_diags.len > 0 {
                    var ci: I32 = 0
                    while ci < cml_diags.len {
                        println(cml_diags[ci])
                        ci += 1
                    }
                    return 1
                }
                println("check OK gui decls=" + (gfile.len - 1).to_string())
                if cml_dump == "1" {
                    gui_dump_file(gfile)
                    // SL-7β1:骨架表倾倒(与域包 sk_dump 双端差分,s22_sk_equiv)
                    gui_sk_dump_all(gfile)
                }
                var cwi: I32 = 0
                while cwi < cml_warns.len {
                    println(cml_warns[cwi])
                    cwi += 1
                }
                return 0
            }
            var toks = List[Str]()
            var lns = List[Str]()
            var cols = List[Str]()
            var pdiags = List[Str]()
            // doc-test 提升(§10.4):```c 围栏块 → 文件尾合成 test 块(driver_doctest.ct);
            // .ctml 分支已提前返回,不受本面影响
            var s2 = doctest_lift(s)
            scan4(s2, toks, lns, cols, pdiags)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur, lns, cols, pdiags)
            // 模块加载器(§2):use 解析 → 可见性 → 合并;无 use 时为无感直通
            var ldiags = List[Str]()
            var lstack = List[Str]()
            lstack.push(epath)
            // T18:chk_fmt 提前初始化(pdiags 早退需判 JSON 模式)
            var chk_fmt18 = ctron_cli_flag("format")
            if chk_fmt18.len == 0 {
                chk_fmt18 = "ANCHORFMT"
            }
            // 词法/解析诊断(镜像 seed:PATH:LINE:COL CODE: MSG)→ 止于 rc=1
            // T18:JSON 模式下 pdiags 走 JSON 面(精确 LINE:COL span)
            if pdiags.len > 0 {
                if or2(seq2(chk_fmt18, "1"), seq2(chk_fmt18, "json")) {
                    print("\{\"diagnostics\":[")
                    var pi18: I32 = 0
                    while pi18 < pdiags.len {
                        json_diag_lc(epath, pdiags[pi18], pi18 == 0)
                        pi18 += 1
                    }
                    println("]}")
                    return 1
                }
                var pi: I32 = 0
                while pi < pdiags.len {
                    println(epath + ":" + pdiags[pi])
                    pi += 1
                }
                return 1
            }
            var chk_fmt = ctron_cli_flag("format")
            if chk_fmt.len == 0 {
                chk_fmt = "ANCHORFMT"
            }
            var chk_prof = ctron_cli_flag("profile")
            if chk_prof.len == 0 {
                chk_prof = "ANCHORPROFILE"
            }
            var lmisses = List[Str]()
            file = pkg_load_use_t(file, pkg_dir_of(epath), lstack, ldiags, lmisses, chk_prof)
            if ldiags.len > 0 {
                var li: I32 = 0
                while li < ldiags.len {
                    println(ldiags[li])
                    li += 1
                }
                var mi: I32 = 0
                while mi < lmisses.len {
                    println("W8902: 包 " + lmisses[mi] + " 未命中解析链(项目目录→lib→pkgs→deps);独立发布包试: ctron pkg add " + lmisses[mi])
                    mi += 1
                }
                return 1
            }
            var sems = sem_walk2(file, chk_prof)
            if or2(seq2(chk_fmt, "1"), seq2(chk_fmt, "json")) {
                print("\{\"diagnostics\":[")
                var first18 = true
                // T18:parser 诊断入 JSON(精确 LINE:COL 来自词法层)
                if pdiags.len > 0 {
                    var pi18: I32 = 0
                    while pi18 < pdiags.len {
                        json_diag_lc(epath, pdiags[pi18], first18)
                        first18 = false
                        pi18 += 1
                    }
                }
                if !seq2(sems, "") {
                    var i: I32 = 0
                    while i < sems.len {
                        var e: I32 = i
                        while e < sems.len && byte_at(sems, e) != 10 { e += 1 }
                        if e > i {
                            json_diag(epath, s, byte_slice(sems, i, e), first18)
                            first18 = false
                        }
                        i = e + 1
                    }
                    println("]}")
                    return 1
                }
                println("]}")
                return 0
            }
            if !seq2(sems, "") {
                print(strip_at(sems))
                return 1
            }
            println("check OK decls=" + (file.len - 1).to_string())
            var chk_dump = ctron_cli_flag("dumpgui")
            if chk_dump.len == 0 {
                chk_dump = "ANCHORDUMPGUI"
            }
            if chk_dump == "1" {
                gui_dump_file(file)
                // W3 检查面(挂 dumpgui 旗标下;C 宿主 sem 对 gui_ck 助手参数的
                // E2020 分歧解决后,再评估移入默认 check 路径)
                // SL-6(M1-d):gwarns 警告通道(E8193 警告级)——打印不置 rc
                // SL-7β1:检查面先行(诊断 rc=1 即返,非法标记不做骨架倾倒)
                var gdiags = List[Str]()
                var gwarns = List[Str]()
                gui_check_file(file, gdiags, gwarns, false)
                var gi: I32 = 0
                while gi < gdiags.len {
                    println(gdiags[gi])
                    gi += 1
                }
                if gdiags.len > 0 {
                    return 1
                }
                gui_sk_dump_all(file)
                var wi: I32 = 0
                while wi < gwarns.len {
                    println(gwarns[wi])
                    wi += 1
                }
            }
            var chk_trusted = ctron_cli_flag("trusted")
            if chk_trusted.len == 0 {
                chk_trusted = "ANCHORTAUSTED"
            }
            if seq2(chk_trusted, "1") {
                // 信任边界审计(§9.6):枚举全部 #[trusted] extern
                var ai: I32 = 1
                while ai < file.len {
                    var ad = file[ai]
                    if ad[0] == "FnExt" {
                        if ad.len > 7 {
                            println("trusted: " + ad[1] + "@" + nline(ad))
                        }
                    }
                    ai += 1
                }
            }
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
