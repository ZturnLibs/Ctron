// derive_json —— T52 官方 derive(Json) 插件(§8.3 声明式代码生成;设计案 §6)
// W1+W2 充实(2026-10-10,计划 docs/superpowers/plans/2026-10-10-derive-json-plugin-plan.md);
// v2.1 接口 ty_full(2026-10-10 接口修订,List/Option 启用):
//   产物 = 普通 Ctron 源文本(§3 非宏手术),per-type:
//     写半边:__esc_<T>(全量转义含包裹引号,RFC 8259;std/json esc 同款纯字面量
//     形——utf8_enc 解释臂传参 bug 在册,产物不用之)+ <T>_to_json(型别
//     mangling:同名方法跨接收者型别冲突,interp 名字分派首注册胜)。
//     读半边:err 先行双件契约——<T>_json_err(es,pre)->Str(空串=ok;语句位
//     match)+ <T>_from_json_at(es,pre)->T(值件全 .or(dft) 直返,零 match 零
//     Result;Result 载荷槽 = ct_i 64 位,struct 值发射面原理性不可行)。
//   型别面 v2.1:I32(as[I32] 收窄)/I64/Bool/Str/嵌套 struct(未 derive 由 sem
//     未解析兜)/List[标量四件](jw_keys 下标枚举,元素 local-中转)/
//     Option[标量四件](null 母语:tag z = None,写半边 is_some+or)。
//     F64 排除(emit to_string 乱值实探 1.5→"1");组合泛型(List[Option]/
//     List[List])、struct 元素列表(List[Struct])、Map/定长数组 = 陷阱 fn
//     (sem 未解析调用嵌型别名;空产物静默通过不可用;iface v1 有损 ty 槽由
//     ty_full 修订解除)。List[struct]/Option[struct] 陷阱依据 = emit struct
//     值链面在册账。
//   消费方 use 契约(读半边):std.json.{ parse, jix_new, jix_tag, jix_val,
//     jix_i64, jix_bool, jw_keys };写半边零依赖自包含。
//   插件自身上层转义纪律:产物文本内 { 一律经 lb("\{")合成(闭括号 } 裸写合法)。
use ctron.plugin.{ DeriveInput }

pub fn ctron_derive(input: DeriveInput) -> Str {
    let q = "\""
    let bs = "\\"
    let lb = "\{"
    let tn = input.type_name
    var body = ""
    var rd = ""
    var rv = ""
    var first = true
    var k: I32 = 0
    var bad = ""
    while k < input.fields.len {
        let f = input.fields[k]
        var t = f.ty_full
        if t == "" {
            t = f.ty
        }
        var comma = ""
        if !first {
            comma = ","
        }
        var pre = "    b = b + " + q + comma + bs + q + f.name + bs + q + ":" + q + " + "
        var path = q + "." + f.name + q
        if (t == "I32") || (t == "I64") {
            body = body + pre + "self." + f.name + ".to_string()" + "\n"
            var conv = ""
            if t == "I32" {
                conv = ".as[I32]()"
            }
            rd = rd + "    match jix_i64(ix, pre + " + path + ") " + lb + "\n"
            rd = rd + "        Ok(_) => " + lb + " }\n"
            rd = rd + "        Err(me) => " + lb + " return me }\n"
            rd = rd + "    }\n"
            rv = rv + "    let f_" + f.name + " = jix_i64(ix, pre + " + path + ").or(0)" + conv + "\n"
        } else {
            if t == "Bool" {
                body = body + pre + "(if self." + f.name + " " + lb + " " + q + "true" + q + " } else " + lb + " " + q + "false" + q + " })" + "\n"
                rd = rd + "    match jix_bool(ix, pre + " + path + ") " + lb + "\n"
                rd = rd + "        Ok(_) => " + lb + " }\n"
                rd = rd + "        Err(me) => " + lb + " return me }\n"
                rd = rd + "    }\n"
                rv = rv + "    let f_" + f.name + " = jix_bool(ix, pre + " + path + ").or(false)\n"
            } else {
                if t == "Str" {
                    body = body + pre + "__esc_" + tn + "(self." + f.name + ")" + "\n"
                    rd = rd + "    var tg_" + f.name + " = jix_tag(ix, pre + " + path + ")\n"
                    rd = rd + "    if tg_" + f.name + " == \"\" " + lb + " return \"noent@\" + pre + " + path + " }\n"
                    rd = rd + "    if tg_" + f.name + " == \"z\" " + lb + " return \"null@\" + pre + " + path + " }\n"
                    rd = rd + "    if tg_" + f.name + " != \"s\" " + lb + " return \"type@\" + pre + " + path + " }\n"
                    rv = rv + "    let v_" + f.name + " = jix_val(ix, pre + " + path + ")\n"
                } else {
                    if t == "F64" {
                        bad = "F64"
                    } else {
                        if cj_pref(t, "List[") {
                            var el = cj_inner(t, 5)
                            if cj_scalar4(el) {
                                body = body + cj_list_body(f, el, tn, comma, q, bs, lb)
                                rd = rd + cj_list_err(el, f.name, q, lb)
                                rv = rv + cj_list_val(el, f.name, q, lb)
                            } else {
                                bad = t
                            }
                        } else {
                            if cj_pref(t, "Option[") {
                                var el = cj_inner(t, 7)
                                if cj_scalar4(el) {
                                    body = body + cj_opt_body(f, el, tn, comma, q, bs, lb)
                                    rd = rd + cj_opt_err(el, f.name, q, lb)
                                    rv = rv + cj_opt_val(el, f.name, q, lb)
                                } else {
                                    bad = t
                                }
                            } else {
                                if cj_generic(t) {
                                    bad = t
                                } else {
                                    body = body + pre + "self." + f.name + "." + t + "_to_json()" + "\n"
                                    rd = rd + "    var ce_" + f.name + " = " + t + "_json_err(es, pre + " + path + ")\n"
                                    rd = rd + "    if ce_" + f.name + " != \"\" " + lb + " return ce_" + f.name + " }\n"
                                    rv = rv + "    let f_" + f.name + " = " + t + "_from_json_at(es, pre + " + path + ")\n"
                                }
                            }
                        }
                    }
                }
            }
        }
        first = false
        k += 1
    }
    if bad != "" {
        // 陷阱信道:未支持型别 → 产物引用未定义 fn(sem 未解析错误,型别名嵌于名)
        var tout = "fn " + tn + "_to_json(self: " + tn + ") -> Str " + lb + "\n"
        tout = tout + "    return __unsupported_json_field_" + tn + "_" + cj_san(bad) + "()" + "\n"
        tout = tout + "}" + "\n"
        tout = tout + "fn " + tn + "_json_err(es: List[List[Str]], pre: Str) -> Str " + lb + "\n"
        tout = tout + "    return __unsupported_json_read_" + tn + "_" + cj_san(bad) + "()" + "\n"
        tout = tout + "}" + "\n"
        tout = tout + "fn " + tn + "_from_json_at(es: List[List[Str]], pre: Str) -> " + tn + " " + lb + "\n"
        tout = tout + "    return __unsupported_json_read_" + tn + "_" + cj_san(bad) + "()" + "\n"
        tout = tout + "}" + "\n"
        return tout
    }
    var out = cj_esc_helper(tn, lb)
    out = out + "fn " + tn + "_to_json(self: " + tn + ") -> Str " + lb + "\n"
    out = out + "    var b = " + q + bs + lb + q + "\n"
    out = out + body
    out = out + "    return b + " + q + "}" + q + "\n"
    out = out + "}" + "\n"
    // 读半边:err 先行双件(校验件/取值件;消费契约见头注)
    out = out + "fn " + tn + "_json_err(es: List[List[Str]], pre: Str) -> Str " + lb + "\n"
    out = out + "    let ix = jix_new(es)\n"
    out = out + rd
    out = out + "    return \"\"\n"
    out = out + "}" + "\n"
    out = out + "fn " + tn + "_from_json_at(es: List[List[Str]], pre: Str) -> " + tn + " " + lb + "\n"
    out = out + "    let ix = jix_new(es)\n"
    out = out + rv
    out = out + "    return " + tn + " " + lb + "\n"
    out = out + cj_fields(input)
    out = out + "    }\n"
    out = out + "}" + "\n"
    return out
}

// ---- List[标量] 三件 ----

fn cj_list_body(f: DeriveField, el: Str, tn: Str, comma: Str, q: Str, bs: Str, lb: Str) -> Str {
    let n = f.name
    var r = "    b = b + " + q + comma + bs + q + n + bs + q + ":" + q + " + " + q + "[" + q + "\n"
    r = r + "    var li_" + n + " = 0\n"
    r = r + "    while li_" + n + " < self." + n + ".len " + lb + "\n"
    r = r + "        if li_" + n + " > 0 " + lb + "\n"
    r = r + "            b = b + \",\"\n"
    r = r + "        }\n"
    r = r + "        let el_" + n + " = self." + n + "[li_" + n + "]\n"
    r = r + "        b = b + " + cj_el_out(el, tn, "el_" + n, q, lb) + "\n"
    r = r + "        li_" + n + " += 1\n"
    r = r + "    }\n"
    r = r + "    b = b + \"]\"\n"
    return r
}

fn cj_list_err(el: Str, n: Str, q: Str, lb: Str) -> Str {
    var np = q + "." + n + q
    var r = "    var ks_" + n + " = jw_keys(es, pre + " + np + ")\n"
    r = r + "    var ki_" + n + " = 0\n"
    r = r + "    while ki_" + n + " < ks_" + n + ".len " + lb + "\n"
    if el == "Str" {
        r = r + "        var te_" + n + " = jix_tag(ix, pre + " + np + " + \".\" + ks_" + n + "[ki_" + n + "])\n"
        r = r + "        if te_" + n + " != \"s\" " + lb + "\n"
        r = r + "            if te_" + n + " == \"\" " + lb + " return \"noent@\" + pre + " + np + " + \".\" + ks_" + n + "[ki_" + n + "] }\n"
        r = r + "            return \"type@\" + pre + " + np + " + \".\" + ks_" + n + "[ki_" + n + "]\n"
        r = r + "        }\n"
    } else {
        r = r + "        match jix_" + cj_jn(el) + "(ix, pre + " + np + " + \".\" + ks_" + n + "[ki_" + n + "]) " + lb + "\n"
        r = r + "            Ok(_) => " + lb + " }\n"
        r = r + "            Err(me) => " + lb + " return me }\n"
        r = r + "        }\n"
    }
    r = r + "        ki_" + n + " += 1\n"
    r = r + "    }\n"
    return r
}

fn cj_list_val(el: Str, n: Str, q: Str, lb: Str) -> Str {
    var np = q + "." + n + q
    var r = "    let ks_" + n + " = jw_keys(es, pre + " + np + ")\n"
    r = r + "    var v_" + n + " = List[" + el + "]()\n"
    r = r + "    var kv_" + n + " = 0\n"
    r = r + "    while kv_" + n + " < ks_" + n + ".len " + lb + "\n"
    if el == "Str" {
        r = r + "        v_" + n + ".push(jix_val(ix, pre + " + np + " + \".\" + ks_" + n + "[kv_" + n + "]))\n"
    } else {
        if el == "Bool" {
            r = r + "        v_" + n + ".push(jix_bool(ix, pre + " + np + " + \".\" + ks_" + n + "[kv_" + n + "]).or(false))\n"
        } else {
            if el == "I32" {
                r = r + "        v_" + n + ".push(jix_i64(ix, pre + " + np + " + \".\" + ks_" + n + "[kv_" + n + "]).or(0).as[I32]())\n"
            } else {
                r = r + "        v_" + n + ".push(jix_i64(ix, pre + " + np + " + \".\" + ks_" + n + "[kv_" + n + "]).or(0))\n"
            }
        }
    }
    r = r + "        kv_" + n + " += 1\n"
    r = r + "    }\n"
    return r
}

// ---- Option[标量] 三件(null 母语:tag z = None) ----

fn cj_opt_body(f: DeriveField, el: Str, tn: Str, comma: Str, q: Str, bs: Str, lb: Str) -> Str {
    let n = f.name
    var vexp = "self." + n + ".or(0).to_string()"
    if el == "Str" {
        vexp = "__esc_" + tn + "(self." + n + ".or(\"\"))"
    }
    if el == "Bool" {
        vexp = "(if self." + n + ".or(false) " + lb + " " + q + "true" + q + " } else " + lb + " " + q + "false" + q + " })"
    }
    var r = "    b = b + " + q + comma + bs + q + n + bs + q + ":" + q + " + (if self." + n + ".is_some() " + lb + " " + vexp + " } else " + lb + " " + q + "null" + q + " })" + "\n"
    return r
}

fn cj_opt_err(el: Str, n: Str, q: Str, lb: Str) -> Str {
    var np = q + "." + n + q
    var r = "    var tg_" + n + " = jix_tag(ix, pre + " + np + ")\n"
    r = r + "    if tg_" + n + " == \"\" " + lb + " return \"noent@\" + pre + " + np + " }\n"
    r = r + "    if tg_" + n + " != \"z\" " + lb + "\n"
    if el == "Str" {
        r = r + "        if tg_" + n + " != \"s\" " + lb + " return \"type@\" + pre + " + np + " }\n"
    } else {
        r = r + "        match jix_" + cj_jn(el) + "(ix, pre + " + np + ") " + lb + "\n"
        r = r + "            Ok(_) => " + lb + " }\n"
        r = r + "            Err(me) => " + lb + " return me }\n"
        r = r + "        }\n"
    }
    r = r + "    }\n"
    return r
}

fn cj_opt_val(el: Str, n: Str, q: Str, lb: Str) -> Str {
    var np = q + "." + n + q
    var r = "    var tg_" + n + " = jix_tag(ix, pre + " + np + ")\n"
    r = r + "    var v_" + n + ": Option[" + el + "] = None\n"
    r = r + "    if tg_" + n + " != \"z\" " + lb + "\n"
    if el == "Str" {
        r = r + "        v_" + n + " = Some(jix_val(ix, pre + " + np + "))\n"
    } else {
        if el == "Bool" {
            r = r + "        v_" + n + " = Some(jix_bool(ix, pre + " + np + ").or(false))\n"
        } else {
            if el == "I32" {
                r = r + "        v_" + n + " = Some(jix_i64(ix, pre + " + np + ").or(0).as[I32]())\n"
            } else {
                r = r + "        v_" + n + " = Some(jix_i64(ix, pre + " + np + ").or(0))\n"
            }
        }
    }
    r = r + "    }\n"
    return r
}

// ---- 型别助手 ----

// 元素写出式(local 名传入):Str 走外层 per-type __esc;Bool 双臂;数字 to_string
fn cj_el_out(el: Str, tn: Str, loc: Str, q: Str, lb: Str) -> Str {
    if el == "Str" {
        return "__esc_" + tn + "(" + loc + ")"
    }
    if el == "Bool" {
        return "(if " + loc + " " + lb + " " + q + "true" + q + " } else " + lb + " " + q + "false" + q + " })"
    }
    return loc + ".to_string()"
}

// jix 数字/布尔件名(I32/I64 共 i64;Bool 走 bool)
fn cj_jn(el: Str) -> Str {
    if el == "Bool" {
        return "bool"
    }
    return "i64"
}

// 前缀 + 尾 ']' 判定
fn cj_pref(t: Str, p: Str) -> Bool {
    if t.len <= p.len {
        return false
    }
    if byte_at(t, t.len - 1) != 93 {
        return false
    }
    var i: I32 = 0
    while i < p.len {
        if byte_at(t, i) != byte_at(p, i) {
            return false
        }
        i += 1
    }
    return true
}

// 剥前缀与尾 ']' 取实参文本
fn cj_inner(t: Str, plen: I32) -> Str {
    return byte_slice(t, plen, t.len - 1)
}

// 标量四件判定
fn cj_scalar4(el: Str) -> Bool {
    if (el == "I32") || (el == "I64") {
        return true
    }
    if (el == "Bool") || (el == "Str") {
        return true
    }
    return false
}

// ty 是否带型别实参(实参槽位之外的泛型一律陷阱)
fn cj_generic(t: Str) -> Bool {
    var i: I32 = 0
    while i < t.len {
        let c = byte_at(t, i)
        if c == 91 {
            return true
        }
        i += 1
    }
    return false
}

// 陷阱名净化:非字母数字压 _
fn cj_san(ty: Str) -> Str {
    var r = ""
    var i: I32 = 0
    while i < ty.len {
        let c = byte_at(ty, i)
        var ok = false
        if c >= 48 {
            if c <= 57 {
                ok = true
            }
        }
        if c >= 65 {
            if c <= 90 {
                ok = true
            }
        }
        if c >= 97 {
            if c <= 122 {
                ok = true
            }
        }
        if ok {
            r = r + byte_slice(ty, i, i + 1)
        } else {
            r = r + "_"
        }
        i += 1
    }
    return r
}

// 结构字面量字段清单:err 先行双件下全部引 let/var 局部(f_*/v_*)
fn cj_fields(input: DeriveInput) -> Str {
    var r = ""
    var k: I32 = 0
    while k < input.fields.len {
        let f = input.fields[k]
        var t = f.ty_full
        if t == "" {
            t = f.ty
        }
        var comma = ","
        if k == input.fields.len - 1 {
            comma = ""
        }
        var loc = "f_"
        if (t == "Str") || (cj_pref(t, "List[")) || (cj_pref(t, "Option[")) {
            loc = "v_"
        }
        r = r + "        " + f.name + ": " + loc + f.name + comma + "\n"
        k += 1
    }
    return r
}

// per-type 全量转义 helper 产物(std/json esc 同款:含包裹引号;控制字符经
// 字母字面量 + hex 查表,零 utf8_enc 依赖、零深字面量转义手术)
fn cj_esc_helper(tn: Str, lb: Str) -> Str {
    var out = "fn __esc_" + tn + "(s: Str) -> Str " + lb + "\n"
    out = out + "    var e = " + "\"\\\\\"\n"
    out = out + "    var q = " + "\"\\\"\"\n"
    out = out + "    var out = q\n"
    out = out + "    var i: I32 = 0\n"
    out = out + "    while i < s.len " + lb + "\n"
    out = out + "        let c = byte_at(s, i)\n"
    out = out + "        if c == 34 " + lb + "\n"
    out = out + "            out = out + e + q\n"
    out = out + "        } else if c == 92 " + lb + "\n"
    out = out + "            out = out + e + e\n"
    out = out + "        } else if c == 8 " + lb + "\n"
    out = out + "            out = out + e + \"b\"\n"
    out = out + "        } else if c == 9 " + lb + "\n"
    out = out + "            out = out + e + \"t\"\n"
    out = out + "        } else if c == 10 " + lb + "\n"
    out = out + "            out = out + e + \"n\"\n"
    out = out + "        } else if c == 12 " + lb + "\n"
    out = out + "            out = out + e + \"f\"\n"
    out = out + "        } else if c == 13 " + lb + "\n"
    out = out + "            out = out + e + \"r\"\n"
    out = out + "        } else " + lb + "\n"
    out = out + "            if c < 32 " + lb + "\n"
    out = out + "                out = out + e + \"u00\" + byte_slice(\"0123456789ABCDEF\", c / 16, c / 16 + 1) + byte_slice(\"0123456789ABCDEF\", c % 16, c % 16 + 1)\n"
    out = out + "            } else " + lb + "\n"
    out = out + "                out = out + byte_slice(s, i, i + 1)\n"
    out = out + "            }\n"
    out = out + "        }\n"
    out = out + "        i += 1\n"
    out = out + "    }\n"
    out = out + "    return out + q\n"
    out = out + "}\n"
    return out
}
