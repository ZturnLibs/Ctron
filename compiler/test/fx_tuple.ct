// fx_tuple.ct —— FB-9/F20:元组发射面(构造/跨 fn 返回/循环内 return/数字成员)
fn mk() -> (I32, Str) {
    return (7, "s")
}

fn find(xs: List[I32]) -> (I32, Str) {
    var i: I32 = 0
    while i < xs.len {
        if xs[i] > 2 {
            return (i, "hit")
        }
        i += 1
    }
    return (0, "none")
}

fn main() -> I32 {
    let a = mk()
    println(a.0.to_string())
    println(a.1)
    var xs = List[I32]()
    xs.push(1)
    xs.push(5)
    let r = find(xs)
    println(r.0.to_string())
    println(r.1)
    return 0
}
