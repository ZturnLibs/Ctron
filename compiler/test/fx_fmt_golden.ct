fn a() {}



fn g(xs: List[I32]) -> I32 {
return xs
.map(twice)
.filter(gt0)
.len()
}

fn h(n: I32) -> Str {
let label = if n > 0 { "pos" } else { "neg" }
var t = 0
for i in 0..n {
t += -1 + i
}
if !false && !true {
t = -t
}
var e = 0xFF
var f = 2.5
//@ panic: 标记逐字保留(campaign 语义,fmt 不得改动)
var w = b or c
return label
}

fn k(xs: List[I32]) {
var y = xs[0]
g(y, xs[1])
noop() {}
}

