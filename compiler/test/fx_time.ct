// fx_time.ct —— now_ms 内建对齐夹具(I64 域 ["6", 十进制文本])
// 输出全 Bool 化:跨面双跑的时刻值必然不同,原始时间戳/差值不入 diff。
fn main() -> I32 {
    var t = now_ms()
    println((t > 1000000000).to_string())
    var u = now_ms()
    println((u >= t).to_string())
    var d = u - t
    println((d >= 0).to_string())
    println((d < 60000).to_string())
    println((d.to_string().len >= 1).to_string())
    // I64 算术:秒换算(除法)+ 反乘回 + 模
    var secs = t / 1000
    println((secs > 1500000000).to_string())
    println((secs * 1000 <= t).to_string())
    println((t % 1000 < 1000).to_string())
    // I64 负数(C99 截断:商向零取整,余数符号随被除数)
    var neg = 0 - t
    var nd = neg / 1000
    var nr = neg % 1000
    println((nd < 0).to_string())
    println((nr <= 0).to_string())
    println((nd * 1000 + nr == neg).to_string())
    return 0
}
