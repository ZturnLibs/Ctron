// fx_time.ct —— now_ms 内建对齐夹具(I64 域 ["6", 十进制文本])
// 输出全 Bool 化:跨面双跑的时刻值必然不同,原始时间戳/差值不入 diff。
fn main() -> I32 {
    var t = now_ms()
    println((t > 1000000000).to_string())
    var u = now_ms()
    println((u >= t).to_string())
    var d = u - t
    println((d >= 0).to_string())
    println((d < 60000).to_string())
    println((d.to_string().len >= 1).to_string())
    // I64 算术:秒换算(除法)+ 反乘回 + 模
    var secs = t / 1000
    println((secs > 1500000000).to_string())
    println((secs * 1000 <= t).to_string())
    println((t % 1000 < 1000).to_string())
    // I64 负数(C99 截断:商向零取整,余数符号随被除数)
    var neg = 0 - t
    var nd = neg / 1000
    var nr = neg % 1000
    println((nd < 0).to_string())
    println((nr <= 0).to_string())
    println((nd * 1000 + nr == neg).to_string())
    // 宽字面量直入 6 域(§3.1.1:I32 装不下的十进制字面量;int64 宽度内两实现一致)
    var big: I64 = 9007199254740993
    println(big.to_string())
    println((big * 2 == 18014398509481986).to_string())
    println((big / 2 == 4503599627370496).to_string())
    println((big % 1000003 == 224294).to_string())
    var mbig: I64 = -9007199254740993
    println((mbig == 0 - big).to_string())
    println((mbig / 1000 == -9007199254740).to_string())
    // 进制宽字面量同口径直入 6 域(0x/0o/0b;下划线分隔)
    var hmax: I64 = 0x7FFFFFFFFFFFFFFF
    println(hmax.to_string())
    println((hmax % 1000000007 == 291172003).to_string())
    println((-hmax == -9223372036854775807).to_string())
    var omin: I64 = -0o1000000000000000000000
    println((omin == -9223372036854775808).to_string())
    // hex-E 修复锚:含 E/e 的十六进制字面量不再误判 Float
    var dead: I64 = 0xDEADBEEF
    println(dead.to_string())
    var cafe: I64 = 0xdeadbeefcafe
    println(cafe.to_string())
    return 0
}
