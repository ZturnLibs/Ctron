// fx_fnval.ct —— Phase 5:一等 fn 值(具名函数/闭包字面量 → fn 类型参数,间接调用)
fn apply_twice(f: fn(I32) -> I32, x: I32) -> I32 {
    return f(f(x))
}
fn double(x: I32) -> I32 {
    return x * 2
}
fn combine(f: fn(I32, I32) -> I32, a: I32, b: I32) -> I32 {
    return f(a, b)
}
fn main() -> I32 {
    var r1 = apply_twice(double, 5)
    var r2 = apply_twice(|x| x + 3, 5)
    var r3 = combine(|a, b| a * 10 + b, 4, 2)
    println(r1.to_string())
    println(r2.to_string())
    println(r3.to_string())
    return 0
}
