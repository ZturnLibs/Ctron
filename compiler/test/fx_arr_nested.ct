// fx_arr_nested.ct —— 嵌套 T[N][M] 全链(注解/字面/传参/跨 fn 返回/链式下标)
fn sum(m: I32[2][2]) -> I32 {
    var s: I32 = 0
    var i: I32 = 0
    while i < 2 {
        s += m[i][0] + m[i][1]
        i += 1
    }
    return s
}

fn mk() -> I32[2][2] {
    var b: I32[2][2] = [[5, 6], [7, 8]]
    return b
}

fn main() -> I32 {
    var m: I32[2][2] = [[1, 2], [3, 4]]
    println(sum(m).to_string())
    println(m[1][0].to_string())
    let r = mk()
    println(r[0][1].to_string())
    return 0
}
