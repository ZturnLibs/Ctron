// std/str.ct —— Str 工具种子(words/contains/lines/count_ch;字节级,UTF-8 透传)

// 空白分隔切词(空格/制表/换行/回车;与 wc 词口径一致)
pub fn words(s: Str) -> List[Str] {
    var out = List[Str]()
    var cur = ""
    var inword = false
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        var isws = false
        if c == 32 { isws = true }
        if c == 9 { isws = true }
        if c == 10 { isws = true }
        if c == 13 { isws = true }
        if isws {
            if inword {
                out.push(cur)
                inword = false
                cur = ""
            }
        } else {
            cur = cur + byte_slice(s, i, i + 1)
            inword = true
        }
        i += 1
    }
    if inword {
        out.push(cur)
    }
    return out
}

// 子串包含(空子串恒真)
pub fn contains(s: Str, sub: Str) -> Bool {
    var sn = sub.len
    if sn == 0 { return true }
    var hn = s.len
    if hn < sn { return false }
    var i: I32 = 0
    while i + sn <= hn {
        var ok = true
        var k: I32 = 0
        while k < sn {
            if byte_at(s, i + k) != byte_at(sub, k) { ok = false }
            k += 1
        }
        if ok { return true }
        i += 1
    }
    return false
}

// 按换行切行(保留末尾不带换行的行)
pub fn lines(s: Str) -> List[Str] {
    var out = List[Str]()
    var start: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == 10 {
            out.push(byte_slice(s, start, i))
            start = i + 1
        }
        i += 1
    }
    if start < s.len {
        out.push(byte_slice(s, start, s.len))
    }
    return out
}

// 字节出现计数
pub fn count_ch(s: Str, ch: I32) -> I32 {
    var n: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == ch { n += 1 }
        i += 1
    }
    return n
}

// 以 sep 串接(parts 空返回空串;单元素不加 sep)
pub fn join(parts: List[Str], sep: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < parts.len {
        if i > 0 {
            out = out + sep
        }
        out = out + parts[i]
        i += 1
    }
    return out
}

// 前缀匹配(空前缀恒真)
pub fn starts_with(s: Str, pre: Str) -> Bool {
    var pn = pre.len
    if pn == 0 { return true }
    if s.len < pn { return false }
    var i: I32 = 0
    while i < pn {
        if byte_at(s, i) != byte_at(pre, i) { return false }
        i += 1
    }
    return true
}

// 后缀匹配(空后缀恒真)
pub fn ends_with(s: Str, suf: Str) -> Bool {
    var sn = suf.len
    if sn == 0 { return true }
    if s.len < sn { return false }
    var start = s.len - sn
    var i: I32 = 0
    while i < sn {
        if byte_at(s, start + i) != byte_at(suf, i) { return false }
        i += 1
    }
    return true
}

// 去两端 ASCII 空白(全空白返回空串)
pub fn trim(s: Str) -> Str {
    var start: I32 = 0
    var end = s.len
    var head = true
    while head {
        if start >= end {
            head = false
        } else {
            var c = byte_at(s, start)
            var isws = false
            if c == 32 { isws = true }
            if c == 9 { isws = true }
            if c == 10 { isws = true }
            if c == 13 { isws = true }
            if isws {
                start += 1
            } else {
                head = false
            }
        }
    }
    var tail = true
    while tail {
        if end <= start {
            tail = false
        } else {
            var c = byte_at(s, end - 1)
            var isws = false
            if c == 32 { isws = true }
            if c == 9 { isws = true }
            if c == 10 { isws = true }
            if c == 13 { isws = true }
            if isws {
                end -= 1
            } else {
                tail = false
            }
        }
    }
    return byte_slice(s, start, end)
}

test "words splits on whitespace" {
    var ws = words("hello  world\n\tctron")
    assert(ws.len == 3)
    assert(ws[0] == "hello")
    assert(ws[1] == "world")
    assert(ws[2] == "ctron")
}

test "contains finds substring" {
    assert(contains("ctron", "tro"))
    assert(!contains("ctron", "xyz"))
    assert(contains("abc", ""))
}

test "lines splits keeping last partial" {
    var ls = lines("a\nb\nc")
    assert(ls.len == 3)
    assert(ls[0] == "a")
    assert(ls[2] == "c")
}

test "count_ch counts newlines" {
    assert(count_ch("a\nb\nc\n", 10) == 3)
    assert(count_ch("abc", 10) == 0)
}

test "join with separator" {
    var xs = List[Str]()
    xs.push("a")
    xs.push("b")
    xs.push("c")
    assert(join(xs, ",") == "a,b,c")
    assert(join(xs, "") == "abc")
    var empty = List[Str]()
    assert(join(empty, "-") == "")
    var one = List[Str]()
    one.push("solo")
    assert(join(one, "-") == "solo")
}

test "starts_with / ends_with" {
    assert(starts_with("ctron lang", "ctron"))
    assert(!starts_with("ctron", "lang"))
    assert(ends_with("main.ct", ".ct"))
    assert(!ends_with("main.ct", ".go"))
    assert(starts_with("abc", ""))
    assert(ends_with("abc", ""))
    assert(!starts_with("ab", "abc"))
}

test "trim strips ascii space" {
    assert(trim("  hi  ") == "hi")
    assert(trim("\t\nhi\r\n") == "hi")
    assert(trim("   ") == "")
    assert(trim("no-trim") == "no-trim")
}


// 按单字符分隔(与 lines/words 同族;sep 为 I32 字节值)
pub fn split(s: Str, sep: I32) -> List[Str] {
    var out = List[Str]()
    var start: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == sep {
            out.push(byte_slice(s, start, i))
            start = i + 1
        }
        i += 1
    }
    out.push(byte_slice(s, start, s.len))
    return out
}

// 反转 Str
pub fn reverse(s: Str) -> Str {
    var out = ""
    var i = s.len
    while i > 0 {
        out = out + byte_slice(s, i - 1, i)
        i -= 1
    }
    return out
}

// 子串替换(全部替换;新串与旧串等长不限)
pub fn replace(s: Str, from: Str, to: Str) -> Str {
    if from.len == 0 {
        return s
    }
    var out = ""
    var i: I32 = 0
    while i < s.len {
        if i + from.len <= s.len {
            var ok = true
            var k: I32 = 0
            while k < from.len {
                if byte_at(s, i + k) != byte_at(from, k) {
                    ok = false
                }
                k += 1
            }
            if ok {
                out = out + to
                i += from.len
                i -= 1
            } else {
                out = out + byte_slice(s, i, i + 1)
            }
        } else {
            out = out + byte_slice(s, i, i + 1)
        }
        i += 1
    }
    return out
}

test "split by separator" {
    var ps = split("a,b,c", 44)
    assert(ps.len == 3)
    assert(ps[0] == "a")
    assert(ps[1] == "b")
    assert(ps[2] == "c")
    var no_sep = split("abc", 44)
    assert(no_sep.len == 1)
    assert(no_sep[0] == "abc")
}

test "reverse string" {
    assert(reverse("abc") == "cba")
    assert(reverse("") == "")
    assert(reverse("a") == "a")
}

test "replace all occurrences" {
    assert(replace("hello world", "o", "0") == "hell0 w0rld")
    assert(replace("aaa", "aa", "b") == "ba")
    assert(replace("abc", "xyz", "q") == "abc")
}

// ASCII 大小写转换(查找表方案;非 ASCII 字节透传)
pub fn to_lower(s: Str) -> Str {
    var lower = "abcdefghijklmnopqrstuvwxyz"
    var out = ""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        var ch = byte_slice(s, i, i + 1)
        var isupper = false
        if c >= 65 {
            if c <= 90 {
                isupper = true
            }
        }
        if isupper {
            var pos = c - 65
            ch = byte_slice(lower, pos, pos + 1)
        }
        out = out + ch
        i += 1
    }
    return out
}

pub fn to_upper(s: Str) -> Str {
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out = ""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        var ch = byte_slice(s, i, i + 1)
        var islower = false
        if c >= 97 {
            if c <= 122 {
                islower = true
            }
        }
        if islower {
            var pos = c - 97
            ch = byte_slice(upper, pos, pos + 1)
        }
        out = out + ch
        i += 1
    }
    return out
}

pub fn pad_left(s: Str, width: I32, pad: Str) -> Str {
    var out = s
    while out.len < width {
        out = pad + out
    }
    return out
}

pub fn pad_right(s: Str, width: I32, pad: Str) -> Str {
    var out = s
    while out.len < width {
        out = out + pad
    }
    return out
}

pub fn char_at(s: Str, i: I32) -> Str {
    return byte_slice(s, i, i + 1)
}

test "to_lower / to_upper ascii" {
    assert(to_lower("Hello World") == "hello world")
    assert(to_upper("hello world") == "HELLO WORLD")
    assert(to_lower("") == "")
    assert(to_upper("123abc") == "123ABC")
}

test "pad_left / pad_right" {
    assert(pad_left("7", 3, "0") == "007")
    assert(pad_right("7", 3, "0") == "700")
    assert(pad_left("1234", 3, "0") == "1234")
    assert(pad_right("", 2, "-") == "--")
}

test "char_at" {
    assert(char_at("hello", 0) == "h")
    assert(char_at("hello", 4) == "o")
}

// ============ v0.2 扩张(since: std-0.2) ============

// 首次出现 sub 的字节下标;无 -1;空 sub = 0
pub fn index_of(s: Str, sub: Str) -> I32 {
    return index_of_from(s, sub, 0)
}

// 从 from 起找;from 越界 -1
pub fn index_of_from(s: Str, sub: Str, from: I32) -> I32 {
    var sn = sub.len
    var hn = s.len
    if sn == 0 {
        return 0
    }
    if from < 0 {
        return -1
    }
    if from > hn {
        return -1
    }
    var i = from
    while i + sn <= hn {
        var ok = true
        var k: I32 = 0
        while k < sn {
            if byte_at(s, i + k) != byte_at(sub, k) {
                ok = false
            }
            k += 1
        }
        if ok {
            return i
        }
        i += 1
    }
    return -1
}

// 串分隔(始终 ≥1 段;sep 空返回原串单段)
pub fn split_str(s: Str, sep: Str) -> List[Str] {
    var out = List[Str]()
    if sep.len == 0 {
        out.push(s)
        return out
    }
    var start: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if index_of_from(s, sep, i) == i {
            out.push(byte_slice(s, start, i))
            i += sep.len
            start = i
        } else {
            i += 1
        }
    }
    out.push(byte_slice(s, start, s.len))
    return out
}

// 重复 n 次;n ≤ 0 返回空串
pub fn repeat(s: Str, n: I32) -> Str {
    var out = ""
    var i: I32 = 0
    while i < n {
        out = out + s
        i += 1
    }
    return out
}

// 字节类判定(ASCII)
pub fn is_ascii_digit(b: I32) -> Bool {
    return b >= 48 && b <= 57
}

pub fn is_ascii_alpha(b: I32) -> Bool {
    if b >= 65 && b <= 90 {
        return true
    }
    return b >= 97 && b <= 122
}

pub fn is_ascii_space(b: I32) -> Bool {
    if b == 32 {
        return true
    }
    if b == 9 {
        return true
    }
    if b == 10 {
        return true
    }
    return b == 13
}

// 前缀/后缀剥离;不匹配 None
pub fn strip_prefix(s: Str, pre: Str) -> Option[Str] {
    if !starts_with(s, pre) {
        return None
    }
    return Some(byte_slice(s, pre.len, s.len))
}

pub fn strip_suffix(s: Str, suf: Str) -> Option[Str] {
    if !ends_with(s, suf) {
        return None
    }
    return Some(byte_slice(s, 0, s.len - suf.len))
}

// 非重叠出现计数;空 sub = 0
pub fn count_sub(s: Str, sub: Str) -> I32 {
    if sub.len == 0 {
        return 0
    }
    var n: I32 = 0
    var i: I32 = 0
    while i <= s.len {
        var p = index_of_from(s, sub, i)
        if p < 0 {
            return n
        }
        n += 1
        i = p + sub.len
    }
    return n
}

// ASCII 大小写不敏感相等;长度不等 false
pub fn eq_ignore_ascii_case(a: Str, b: Str) -> Bool {
    if a.len != b.len {
        return false
    }
    var i: I32 = 0
    while i < a.len {
        var ca = byte_at(a, i)
        var cb = byte_at(b, i)
        if ca >= 65 && ca <= 90 {
            ca += 32
        }
        if cb >= 65 && cb <= 90 {
            cb += 32
        }
        if ca != cb {
            return false
        }
        i += 1
    }
    return true
}

test "index_of positions" {
    assert_eq(index_of("hello world", "world"), 6)
    assert_eq(index_of("hello", "lol"), -1)
    assert_eq(index_of("hello", ""), 0)
    assert_eq(index_of("", "a"), -1)
    assert_eq(index_of("aaa", "aa"), 0)
    assert_eq(index_of_from("abcabc", "bc", 2), 4)
    assert_eq(index_of_from("abc", "a", 99), -1)
}

test "split_str keeps empties" {
    var a = split_str("a,b,c", ",")
    assert_eq(a.len, 3)
    assert_eq(a[1], "b")
    var e = split_str("a,,c", ",")
    assert_eq(e.len, 3)
    assert_eq(e[1], "")
    var t = split_str(",x", ",")
    assert_eq(t.len, 2)
    assert_eq(t[0], "")
    var n = split_str("abc", ",")
    assert_eq(n.len, 1)
    var s = split_str("abc", "")
    assert_eq(s.len, 1)
    assert_eq(s[0], "abc")
    var m = split_str("a::b", ":")
    assert_eq(m.len, 3)
}

test "repeat zero and many" {
    assert_eq(repeat("ab", 3), "ababab")
    assert_eq(repeat("ab", 1), "ab")
    assert_eq(repeat("ab", 0), "")
    assert_eq(repeat("ab", -1), "")
    assert_eq(repeat("", 5), "")
}

test "ascii class predicates" {
    assert(is_ascii_digit(48))
    assert(is_ascii_digit(57))
    assert(!is_ascii_digit(47))
    assert(is_ascii_alpha(65))
    assert(is_ascii_alpha(97))
    assert(!is_ascii_alpha(91))
    assert(is_ascii_space(32))
    assert(is_ascii_space(9))
    assert(!is_ascii_space(65))
}

// 发射面安全 Option 助手(match 形;成员调用 .or/.is_some 发射有缺陷 C13a)
pub fn str_get(o: Option[Str], dft: Str) -> Str {
    match o {
        Some(v) => {
            return v
        }
        None => {
            return dft
        }
    }
}

pub fn str_some(o: Option[Str]) -> Bool {
    match o {
        Some(v) => {
            return true
        }
        None => {
            return false
        }
    }
}

test "strip prefix suffix" {
    assert_eq(str_get(strip_prefix("main.ct", "main"), "?"), ".ct")
    assert(!str_some(strip_prefix("main.ct", "nope")))
    assert_eq(str_get(strip_prefix("abc", ""), "?"), "abc")
    var s = strip_suffix("main.ct", ".ct")
    assert_eq(str_get(s, "?"), "main")
    assert(!str_some(strip_suffix("main.ct", ".go")))
    assert(!str_some(strip_suffix("abc", "abcd")))
}

test "count_sub non overlapping" {
    assert_eq(count_sub("aaa", "aa"), 1)
    assert_eq(count_sub("ababab", "ab"), 3)
    assert_eq(count_sub("abc", ""), 0)
    assert_eq(count_sub("abc", "xyz"), 0)
}

test "eq ignore ascii case" {
    assert(eq_ignore_ascii_case("Hello", "hello"))
    assert(eq_ignore_ascii_case("", ""))
    assert(!eq_ignore_ascii_case("Hello", "hell"))
    assert(eq_ignore_ascii_case("café", "café"))
    assert(!eq_ignore_ascii_case("Hello", "HELLO!"))
}
