// std/map.ct —— IntMap 种子(List 偶奇键值槽;函数式:put 返回新映射)
pub fn new() -> List[I32] {
    return List[I32]()
}
pub fn put(m: List[I32], k: I32, v: I32) -> List[I32] {
    var out = List[I32]()
    var i: I32 = 0
    var hit = false
    while i < m.len {
        if m[i] == k {
            out.push(k)
            out.push(v)
            hit = true
        } else {
            out.push(m[i])
            out.push(m[i + 1])
        }
        i = i + 2
    }
    if !hit {
        out.push(k)
        out.push(v)
    }
    return out
}
pub fn get(m: List[I32], k: I32, dft: I32) -> I32 {
    var i: I32 = 0
    while i < m.len {
        if m[i] == k {
            return m[i + 1]
        }
        i = i + 2
    }
    return dft
}
pub fn has(m: List[I32], k: I32) -> Bool {
    var i: I32 = 0
    while i < m.len {
        if m[i] == k {
            return true
        }
        i = i + 2
    }
    return false
}
