// std/map.ct —— Map[K, V] 种子(双 List 平行槽;函数式:put 返回新映射)
// K 需可 ==(bound Eq:标量原生可等/派生结构体逐字段);调用点经显式 TypeArgs 实例化(v0)
struct Map[K, V] {
    let ks: List[K]
    let vs: List[V]
}

pub fn map_new[K, V]() -> Map[K, V] {
    return Map { ks: List[K](), vs: List[V]() }
}

pub fn put[K: Eq, V](m: Map[K, V], k: K, v: V) -> Map[K, V] {
    var nks = List[K]()
    var nvs = List[V]()
    var i: I32 = 0
    var hit = false
    while i < m.ks.len {
        if m.ks[i] == k {
            nks.push(k)
            nvs.push(v)
            hit = true
        } else {
            nks.push(m.ks[i])
            nvs.push(m.vs[i])
        }
        i = i + 1
    }
    if !hit {
        nks.push(k)
        nvs.push(v)
    }
    return Map { ks: nks, vs: nvs }
}

pub fn get[K: Eq, V](m: Map[K, V], k: K, dft: V) -> V {
    var i: I32 = 0
    while i < m.ks.len {
        if m.ks[i] == k {
            return m.vs[i]
        }
        i = i + 1
    }
    return dft
}

pub fn has[K: Eq, V](m: Map[K, V], k: K) -> Bool {
    var i: I32 = 0
    while i < m.ks.len {
        if m.ks[i] == k {
            return true
        }
        i = i + 1
    }
    return false
}
