// std/crypto.ct —— 密码学原语(纯 Ctron;§12 纯 Ctron 驱动的规范级前置)
// since: std-0.5 stability: experimental
// 口径:SHA-256 首件(FIPS 180-4);验收锚 = RFC 6234/FIPS 标准向量
// 实现:语言无位运算(§4.5 bit 模块待建),位函数以 div/mod 位抽取实现;
// 全部 32 位词以 I64 承载并经 z64 宽域播种(自举值标签随值走,I32 标签跨界
// 2^31 假阳;U32 字面量标签同病,见登记分歧);消息调度用 16 滑窗具名局部,
// 不经 List(发射面对 List 元素读无数值转换,登记缺口)
// 预算:全向量内联测试需 CTRON_MAX_STEPS=0(D2 旋钮,四向量约 200 万步);
// 自举解释口径无快速宽整型,整向量不可实用(登记),以函数级锚验证

// 宽域零播种(strconv 同款):I64 变量以大字面量差分构造,值标签落在 6 域,
// 避免自举口径对小值按 I32 界假阳(乘 2 跨 2 的 31 次方即误报)
fn z64() -> I64 {
    var w: I64 = 4294967296
    return w - w
}

// 2 的 k 次幂(k ∈ 0..31;I64 承载)
fn p2(k: I32) -> I64 {
    var r: I64 = z64() + 1
    var i: I32 = 0
    while i < k {
        r = r * 2
        i += 1
    }
    return r
}

// 32 位异或(值域恒 0 到 4294967295;逐位抽取合成)
fn xor32(a: I64, b: I64) -> I64 {
    var acc: I64 = z64()
    var i: I32 = 0
    var p: I64 = z64() + 1
    while i < 32 {
        var ba = a / p % 2
        var bb = b / p % 2
        var xb = ba + bb
        if xb == 2 {
            xb = 0
        }
        acc += xb * p
        p = p * 2
        i += 1
    }
    return acc
}

// 32 位与
fn and32(a: I64, b: I64) -> I64 {
    var acc: I64 = z64()
    var i: I32 = 0
    var p: I64 = z64() + 1
    while i < 32 {
        acc += (a / p % 2) * (b / p % 2) * p
        p = p * 2
        i += 1
    }
    return acc
}

// 32 位取反(满幅差即按位反;掩码经宽域播种防 U32 字面量标签假阳)
fn not32(a: I64) -> I64 {
    var mask: I64 = z64() + 4294967295
    return mask - a
}

// 循环右移:低 32-n 位左移拼接高 n 位(纯算术;此为热路径,忌逐位循环)
fn rotr32(v: I64, n: I32) -> I64 {
    var pn: I64 = p2(n)
    var high = v / pn
    var low = v - high * pn
    return low * p2(32 - n) + high
}

// 逻辑右移
fn shr32(v: I64, n: I32) -> I64 {
    return v / p2(n)
}

// 消息字节入 64 位域(自举口径无隐式拓宽,经 I64 加法中转)
fn msgb(msg: Str, g: I32) -> I64 {
    var t: I64 = z64()
    t = t + byte_at(msg, g)
    return t
}

// 十六进制小写数位
fn hexch(v: I64) -> Str {
    if v == 0 {
        return "0"
    }
    if v == 1 {
        return "1"
    }
    if v == 2 {
        return "2"
    }
    if v == 3 {
        return "3"
    }
    if v == 4 {
        return "4"
    }
    if v == 5 {
        return "5"
    }
    if v == 6 {
        return "6"
    }
    if v == 7 {
        return "7"
    }
    if v == 8 {
        return "8"
    }
    if v == 9 {
        return "9"
    }
    if v == 10 {
        return "a"
    }
    if v == 11 {
        return "b"
    }
    if v == 12 {
        return "c"
    }
    if v == 13 {
        return "d"
    }
    if v == 14 {
        return "e"
    }
    return "f"
}

// 32 位词转 8 位十六进制小写串
fn hex_word(h: I64) -> Str {
    var out = ""
    var pw: I64 = z64() + 268435456
    var k7: I32 = 0
    while k7 < 8 {
        out = out + hexch(h / pw % 16)
        pw = pw / 16
        k7 += 1
    }
    return out
}

// 轮常量(前 64 素数立方根小数部分前 32 位;FIPS 180-4 4.2.2)
