// std/set.ct —— Set[V] 种子(List 成员;函数式:add 返回新集合)
// V 需可 ==(add 去重 bound Eq);泛型体内嵌泛型调用属挂账深水区,add 内联去重扫描
struct Set[V] {
    let items: List[V]
}

pub fn set_new[V]() -> Set[V] {
    return Set { items: List[V]() }
}

pub fn mem[V](s: Set[V], v: V) -> Bool {
    var i: I32 = 0
    while i < s.items.len {
        if s.items[i] == v {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn add[V: Eq](s: Set[V], v: V) -> Set[V] {
    var found = false
    var i: I32 = 0
    while i < s.items.len {
        if s.items[i] == v {
            found = true
        }
        i = i + 1
    }
    if found {
        return s
    }
    var nitems = List[V]()
    var j: I32 = 0
    while j < s.items.len {
        nitems.push(s.items[j])
        j = j + 1
    }
    nitems.push(v)
    return Set { items: nitems }
}

pub fn len[V](s: Set[V]) -> I32 {
    return s.items.len
}
