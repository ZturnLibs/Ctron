// std/tls.ct —— TLS 门面(P3-C;BIO-over-hybrid,ctron_tls.c 同目录 c_src)
// 能力审计口径(任务裁定,不加新 caps 键):TLS 是 net 句柄之上的加工层,
// 复用 net 能力;门面传输函数首参 net: StdNet 按值贯穿 —— 调用点能力显形
// 同 std/net.ct ②(无需 use std.tls.Tls 锚;不新增 trait)。
// 门面形态(镜像 std/net.ct):
//   ① 免费函数面(trait 方法不可发射,Task 5 登记;net.ct ① 同款);
//   ② 句柄 = 值 struct TlsConn { ctx: I64 } + impl Drop(ctx >= 0 才关);
//      显式 tls_close 后须 conn.ctx = -1(var 字段),Drop 跳过 —— 同 net
//      fd=-1 纪律。fd 本体归 net 层(TcpStream)所有,TLS close 绝不关 fd,
//      两句柄 Drop 先后无关(ctron_tls.c 文件头"Drop 序"注)。
//   ③ 错误面 = rc:0 成 / <0 败 + tls_last_error()(mbedtls_strerror 进
//      thread-local TLS 槽;net.ct ③ 同款;Result[struct,_] Ok 绑定成员访问
//      不可发射,统一 rc)。读:0 = eof(对端 close_notify → CONN_EOF),
//      <0 = err(超时 = SSL_TIMEOUT);底层传输错误细节可另读
//      ctron_net_last_errno(net 槽,BIO 同线程,ctron_tls.c 文件头)。
//   ④ 握手序:tls_client / tls_server 建句柄(不握手)→ tls_set_alpn /
//      tls_set_hostname(可选)→ tls_handshake。ALPN 必须握手前设;握手为
//      阻塞式(BIO blocking 形,协程上经 net 垫片停车,ctron_tls.c 文件头),
//      facade 不设超时。
//   ⑤ 单次 tls_read 至多搬运 4096 字节(net 口径⑤ CT_CHUNK 同值)。
//   ⑥ 句柄出参形态:tls_client/tls_server 直接返回 ctx 句柄(>0;堆胞指针,
//      <0 = 失败)—— 冻结 C 面 ctron_tls_ctx_new 即此口径,不用 net 的
//      rc+Box[Box64] 通道(fd 可为 0,指针恒非 0,符号即判据)。由此本模块
//      【不 import std.net】(加载器无 pop 的栈式查环把任何跨模块菱形 use
//      误判环 —— tls→net 后消费方再 use std.net 即 E5020,实证;StdNet 形参
//      按名于 use 文本合并后的单命名空间解析,消费方 use std.net.{Net_probe}
//      即供给,E5030 同名拦截是此机制的守卫面)。
use std.tls.bind.{ctron_tls_last_errno, ctron_tls_strerror, ctron_tls_ctx_new, ctron_tls_use_cert, ctron_tls_use_ca_bundle, ctron_tls_set_alpn, ctron_tls_set_hostname, ctron_tls_handshake, ctron_tls_read, ctron_tls_write, ctron_tls_alpn_selected_s, ctron_tls_close}

// ---- 句柄与错误类型(值 struct;ctx < 0 视为已关闭) ----

struct TlsError {
    let message: Str
}

struct TlsConn {
    var ctx: I64
}

// RAII:作用域出口释放 mbedTLS 资源(close_notify 尽力发);显式 tls_close 后
// 必须 conn.ctx = -1,否则 Drop 二次释放。
impl Drop for TlsConn {
    fn drop(var self) {
        if self.ctx >= 0 {
            ctron_tls_close(self.ctx)
        }
    }
}

// 最后一次垫片错误的详情(TLS 槽;0 = 无错可读)。mbedTLS rc 为负值
// (如 -0x2700),mbedtls_strerror 出文本。str_from_c 为语言内建(深拷
// C-owned 串,§9.6;发射 ctron_str_from_c,无需模块导入)。
pub fn tls_last_error() -> TlsError {
    let e = ctron_tls_last_errno()
    if e == 0 {
        return TlsError { message: "unknown tls error" }
    }
    return TlsError { message: "tls error " + e.to_string() + ": " + str_from_c(ctron_tls_strerror(e)) }
}

// ---- 传输免费函数(net: StdNet 首参 = 调用点能力显形;rc 约定见头注) ----

// 客户端句柄:建 ctx 并装入信任锚,返回 ctx 句柄(>0;失败 <0,tls_last_error
// 可读)。ca 为空串 → 系统默认路径探测(darwin/主流 linux 布局,ctron_tls.c
// ct_ca_probe);探测失败 <0(ENOENT)。继以 tls_set_alpn(可选)+ tls_handshake。
pub fn tls_client(net: StdNet, fd: I64, ca: Str) -> I64 {
    let ctx = ctron_tls_ctx_new(0)
    if ctx < 0 {
        return -1
    }
    if ctron_tls_use_ca_bundle(ctx, ca) != 0 {
        ctron_tls_close(ctx)
        return -1
    }
    return ctx
}

// 服务端句柄:建 ctx 并装入证书链 + 私钥(PEM 文件路径),返回同上。
pub fn tls_server(net: StdNet, fd: I64, cert: Str, key: Str) -> I64 {
    let ctx = ctron_tls_ctx_new(1)
    if ctx < 0 {
        return -1
    }
    if ctron_tls_use_cert(ctx, cert, key) != 0 {
        ctron_tls_close(ctx)
        return -1
    }
    return ctx
}

// 设本端 ALPN 提供表("h2,http/1.1" 逗号串;mbedTLS 服务端按【服务端】偏好
// 序选定)。必须在 tls_handshake 前调用;传空串 = 清除。
pub fn tls_set_alpn(net: StdNet, conn: TlsConn, protos: Str) -> I64 {
    return ctron_tls_set_alpn(conn.ctx, protos)
}

// 设服务器名(SNI + 名字匹配)。增补面(冻结面无 host 参):不调用时 client
// 握手默认 set_hostname(NULL) opt-out —— 链验证 REQUIRED 保留,仅名字匹配
// 跳过(ctron_tls.c 文件头"主机名口径");传空串 = 回到 opt-out 态。
pub fn tls_set_hostname(net: StdNet, conn: TlsConn, host: Str) -> I64 {
    return ctron_tls_set_hostname(conn.ctx, host)
}

// 握手(阻塞式;fd = net 层已 connect/accept 的 socket,即后续 BIO 传输体)。
// 0 成 / <0 败(证书验证失败、协议失败等,mbedtls_strerror 可读)。
// 形参含 fd:冻结 C 面 ctron_tls_handshake(ctx, fd) 于握手时把 fd 注入垫片
// (此后的 read/write/close 只凭 ctx);TlsConn 保持冻结单字段 { ctx: I64 }。
pub fn tls_handshake(net: StdNet, conn: TlsConn, fd: I64) -> I64 {
    return ctron_tls_handshake(conn.ctx, fd)
}

// 带超时读:timeout_ms <= 0 永久阻塞;>0 到时返 -1(槽 = SSL_TIMEOUT)。
// >0 n / 0 eof / <0 err;单次调用至多搬运 4096 字节(头注⑤)。
pub fn tls_read(net: StdNet, conn: TlsConn, buf: &I64[], cap: I64, timeout_ms: I64) -> I64 {
    return ctron_tls_read(conn.ctx, buf, cap, timeout_ms)
}

// 写(Str 零拷贝直通);全量发完语义(send-all),返回 n / <0 err。
pub fn tls_write_str(net: StdNet, conn: TlsConn, s: Str) -> I64 {
    return ctron_tls_write(conn.ctx, s, s.len)
}

// 显式释放(close_notify 尽力发;不关 fd —— fd 归 net 层)。调用后必须
// conn.ctx = -1(var 字段),否则作用域出口 Drop 二次释放。
pub fn tls_close(net: StdNet, conn: TlsConn) -> I64 {
    return ctron_tls_close(conn.ctx)
}

// 协商结果(握手后);无 ALPN/未协商 → ""。
pub fn tls_alpn(net: StdNet, conn: TlsConn) -> Str {
    return str_from_c(ctron_tls_alpn_selected_s(conn.ctx))
}
