use std.map.{map_new, put, get, has}
use std.set.{set_new, add, mem, len}
use std.fmap.{fnew, fput, fget, flen, fwords}
use std.sort.{sorted, sorted_desc, reversed}
use std.fs.{read_or, exists}
use std.path.{path_join, path_normalize}
use std.str.{index_of, strip_suffix}
use std.enc.{hex_encode, hex_decode, b64_encode, b64_decode, pct_encode}
use std.hash.{djb2, fnv1a32}
use std.rand.{rng_fresh, rng_next}
use std.strconv.{parse_i64, parse_bool}
use std.time.{date_format, date_parse, weekday}
use std.unicode.{cp_count, cp_valid_utf8}

fn main() -> I32 {
    var m = map_new[I32, I32]()
    m = put[I32, I32](m, 1, 10)
    m = put[I32, I32](m, 2, 20)
    m = put[I32, I32](m, 1, 30)
    var total = get[I32, I32](m, 1, 0) + get[I32, I32](m, 2, 0) + get[I32, I32](m, 9, 7)
    println(total.to_string())
    println(has[I32, I32](m, 2).to_string())
    var s = add[I32](add[I32](set_new[I32](), 5), 5)
    println(len[I32](s).to_string())
    println(mem[I32](s, 5).to_string())
    var w = map_new[I32, Str]()
    w = put[I32, Str](w, 7, "seven")
    println(get[I32, Str](w, 7, "?"))
    println(get[I32, Str](w, 8, "?"))

    // FMap[I32]:djb2 开放寻址;覆盖写 / 插入序词表
    var fm = fnew[I32]()
    fm = fput[I32](fm, "apple", 3)
    fm = fput[I32](fm, "pear", 5)
    fm = fput[I32](fm, "apple", 8)
    println(fget[I32](fm, "apple", 0).to_string())
    println(fget[I32](fm, "pear", 0).to_string())
    println(fget[I32](fm, "fig", 0).to_string())
    println(flen[I32](fm).to_string())
    var fw = fwords[I32](fm)
    println(fw[0] + "=" + fget[I32](fm, fw[0], 0).to_string() + "," + fw[1] + "=" + fget[I32](fm, fw[1], 0).to_string())

    // sort:泛型稳定排序(I32 标量比较 / Str strcmp 字节序)
    var nums = List[I32]()
    nums.push(3)
    nums.push(1)
    nums.push(2)
    var asc = sorted[I32](nums)
    println(asc[0].to_string() + asc[1].to_string() + asc[2].to_string())
    var desc = sorted_desc[I32](nums)
    println(desc[0].to_string() + desc[1].to_string() + desc[2].to_string())
    var ws2 = List[Str]()
    ws2.push("pear")
    ws2.push("apple")
    var sasc = sorted[Str](ws2)
    println(sasc[0] + "," + sasc[1])
    println(reversed[I32](nums)[0].to_string())

    // 迭代面:map keys/values(首插序,覆盖写不移位;用 w: Map[I32, Str])
    w = put[I32, Str](w, 8, "eight")
    var mk = keys[I32, Str](w)
    var mv = values[I32, Str](w)
    println(mk[0].to_string() + "=" + mv[0] + "," + mk[1].to_string() + "=" + mv[1])

    // set tolist/fromlist(去重往返)
    s = add[I32](s, 9)
    var tl = tolist[I32](s)
    println(tl[0].to_string() + "," + tl[1].to_string())

    // fmap fvals(与 fwords 一一对应)
    var fv = fvals[I32](fm)
    println(fv[0].to_string() + "," + fv[1].to_string())

    // fs 便利层:read_or 命中/缺省
    var fpath = "/tmp/ctron_stdpkg_fs.txt"
    if exists(fpath) {
        fs_delete(fpath)
    }
    println(read_or(fpath, "none").to_string())
    println(fs_write(fpath, "saved").to_string())
    println(read_or(fpath, "none"))
    fs_delete(fpath)

    // ============ v0.2 扩张消费面(std-0.2;C1-C6 安全形态) ============
    // split_str 下标/csv 索引/opt 闭包组合在发射面触发解释器缺陷(登记 C13),
    // 由各模块 test 块承载,不入消费面
    println(path_join("a", "b"))
    println(path_normalize("a/./b/../c"))
    println(index_of("hello world", "world").to_string())
    println(strip_suffix("main.ct", ".ct").or("?"))
    println(hex_encode("AB"))
    println(hex_decode("4142").or("?"))
    println(b64_encode("foobar"))
    println(b64_decode("Zm9vYmFy").or("?"))
    println(pct_encode("a b"))
    println(djb2("abc").to_string())
    println(fnv1a32("abc").to_string())
    var rs = rng_fresh()
    println(rng_next(rs).to_string())
    println(parse_i64("-42").or(0).to_string())
    println(parse_bool("true").or(false).to_string())
    println(date_format(0))
    println(date_parse("2024-02-29").or(-1).to_string())
    println(weekday(0).to_string())
    println(cp_count("ok").to_string())
    println(cp_valid_utf8("ok").to_string())
    return 0
}
