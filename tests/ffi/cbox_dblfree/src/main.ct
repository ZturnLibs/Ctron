// tests/ffi/cbox_dblfree —— CBox 违例负锚一:双 free(守卫响亮 panic,
// 先于第二次 libc free —— 不静默不坠)
//@ panic: CBox: double free
use ffi.{cbox_own, cbox_free}

#[repr(c)]
struct Thing {
    var v: I64
}

#[trusted]
extern "c" fn thing_make(v: I64) -> &Thing

test "double free is rejected by the ownership sentinel" {
    let b = cbox_own(thing_make(1))
    cbox_free(b)
    cbox_free(b)
}
