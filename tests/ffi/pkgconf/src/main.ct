// 命中则展开其 --libs(fakefoo.pc: -lfakefoo -lfakeextra);发射 C 文本不变。
// 本夹具只验标记面(驱动输出),不真链(fakefoo 并非真实库)。
#[link(name = "fakefoo")]
#[trusted]
extern "c" fn fakefoo_ver() -> I32

fn main() -> I32 {
    assert_eq(0, 0)
    return 0
}
