// 02f_match_guards.ct —— 模式守卫与或模式(§4.6;R-P3c 三线落地,2026-09-28 迁入主套件)
// 语义承诺:pat if cond => 守卫(依序判定);A | B => 或模式;字符串字面量模式;
//          守卫臂不参与穷尽(反例:02f_match_guard_exhaustive.neg.ct)
fn classify(n: I32) -> Str {
    return match n {
        0 => "zero"
        x if x < 0 => "negative"
        x if x % 2 == 0 => "even"
        _ => "odd"
    }
}

fn kind(c: Str) -> Str {
    return match c {
        "go" | "ctron" => "fast"
        _ => "other"
    }
}

enum Tag {
    A
    B
    C
}

fn tag_name(t: Tag) -> Str {
    return match t {
        A | B => "ab"
        C => "c"
    }
}

test "guards evaluated in order" {
    assert_eq(classify(0), "zero")
    assert_eq(classify(-5), "negative")
    assert_eq(classify(4), "even")
    assert_eq(classify(7), "odd")
}

test "or patterns on string literals" {
    assert_eq(kind("ctron"), "fast")
    assert_eq(kind("go"), "fast")
    assert_eq(kind("rust"), "other")
}

test "or patterns on enum variants" {
    assert_eq(tag_name(A), "ab")
    assert_eq(tag_name(B), "ab")
    assert_eq(tag_name(C), "c")
}

test "option guard" {
    let opt: I32? = Some(5)
    let desc = match opt {
        Some(v) if v > 3 => "big"
        Some(_) => "small"
        None => "empty"
    }
    assert_eq(desc, "big")
}
