// 04b_logic.ct —— &&/!/德摩根、% 符号语义、复合赋值、遮蔽、range 值、else-if 链
// 语义承诺:逻辑或唯一写法 = 德摩根;!a && !b;结果符号随被除数

fn or_dm(a: Bool, b: Bool) -> Bool {
    return !(!a && !b)                // 德摩根:等价 a || b(v0.3+ 无 ||)
}

test "de morgan or via truth table" {
    assert_eq(or_dm(false, false), false)
    assert_eq(or_dm(true, false), true)
    assert_eq(or_dm(false, true), true)
    assert_eq(or_dm(true, true), true)
}

test "logic and negation" {
    assert(true && !false)
    assert(!(1 > 2))
}

test "remainder sign follows dividend" {
    assert_eq(-7 % 3, -1)
    assert_eq(7 % -3, 1)
    assert_eq((-7) % (-3), -1)
}

test "compound assignments" {
    var x: I32 = 10
    x -= 4                             // 6
    x *= 3                             // 18
    x /= 5                             // 3
    x %= 2                             // 1
    assert_eq(x, 1)
    assert_ne(x, 2)
}

test "shadowing allowed across blocks, not within" {
    let x = 1
    {
        let x = x + 1                  // 内层块遮蔽外层(§2.4)
        assert_eq(x, 2)
    }
    assert_eq(x, 1)
}

test "range as value and else-if chain" {
    let r = 0..4                      // range 是值
    var count: I32 = 0
    for i in r { count += 1 }
    assert_eq(count, 4)
    let label = if false { "a" } else if true { "b" } else { "c" }
    assert_eq(label, "b")
}
