// 03m_binary_nul_probe.ct —— L4 量尺 v2:read_bytes 全量字节链 NUL 保真
// (判定只量 nuls 与 mid_ok:nuls>0 且 mid_ok=1 → 字节链保真成立)
// v1(read_or Str 链)=Str NUL 终结结构性局限,Red 账随 L4 设计立稿归档
// (docs/superpowers/plans/2026-10-07-l4-bytes-design.md)
fn main() -> I32 {
    let bin = read_bytes("/bin/echo")
    println("len:" + bytes_len(bin).to_string())
    var nuls: I32 = 0
    var i: I32 = 0
    while i < bytes_len(bin) {
        if bytes_at(bin, i) == 0 {
            nuls += 1
        }
        i += 1
    }
    println("nuls:" + nuls.to_string())
    let half = bytes_len(bin) / 2
    let mid = bytes_slice(bin, half, 8)
    var mid_ok: I32 = 1
    var k: I32 = 0
    while k < 8 {
        if bytes_at(mid, k) != bytes_at(bin, half + k) {
            mid_ok = 0
        }
        k += 1
    }
    println("mid_ok:" + mid_ok.to_string())
    return 0
}
