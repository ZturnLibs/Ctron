// 10_trace.ct —— `?` 位置链:context 物化为 AnyError.trace(§5.3/§5.4,v0.5 两段式)
@derive(Error)
enum Fail {
    Bad
}

@derive(Error)
enum HttpError {
    Timeout
}

fn inner() -> Result[I32, Fail] {
    return Err(Bad)
}

fn relay() -> Result[I32, AnyError] {
    let v = inner()?          // `?` 记录调用点;向 AnyError 自动擦除
    return Ok(v)
}

fn relay2() -> Result[I32, AnyError] {
    let v = relay().context("mid")?
    return Ok(v)
}

test "context materializes the propagation trace" {
    match relay().context("top") {
        Err(e) => {
            assert(e.trace.len > 0)        // 至少一处 file:line
            assert(e.trace.contains(":"))
            assert_eq(e.message, "top")
        }
        Ok(_) => assert(false)
    }
}

test "error code survives erasure (IP-01 W1)" {
    match relay().context("top") {
        Err(e) => assert_eq(e.code, "Fail.Bad")   // 擦除后原始码可读(注册名全形)
        Ok(_) => assert(false)
    }
}

test "downcast recovers the concrete error (IP-01)" {
    match relay().context("top") {
        Err(e) => {
            match downcast[Fail](e) {
                Some(_) => { assert(true) }
                None => { assert(false) }
            }
            match downcast[HttpError](e) {
                Some(_) => { assert(false) }
                None => { assert(true) }
            }
        }
        Ok(_) => assert(false)
    }
}

test "context chain keeps the innermost code" {
    match relay2().context("outer") {
        Err(e) => {
            assert_eq(e.code, "Fail.Bad")    // 码不随包装链漂移
            assert_eq(e.message, "outer")    // message 取最近上下文
        }
        Ok(_) => assert(false)
    }
}
