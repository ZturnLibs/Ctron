// 04e_break_drop.neg.ct —— v0.7 修订二 E2071:break 越过带 Drop 局部的作用域
//@ fail: E2071
//@ msg: Drop

struct Ticket {
    let id: I32
}

impl Drop for Ticket {
    fn drop(var self) {
        let _ = self.id
    }
}

test "break crossing drop local is rejected" {
    while true {
        let t: Ticket = Ticket { id: 1 }
        if true { break }
        let _ = t
    }
}
