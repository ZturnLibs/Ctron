// 03i_string_builder_probe.ct —— L5 探针→T03 冒烟(2026-09-28:spec-gap W1 T03 三线落地
// StringBuilder 后,本件从「类型存在」探针转正为真实使用冒烟:push_str/to_string/len)
// 判定 heritage:L5 曾判「立(无真身)」于 2026-09-27,被 T03 销账;详见 divergences web P0 节
fn main() -> I32 {
    let sb = StringBuilder()
    sb.push_str("hello")
    sb.push_str(" ")
    sb.push_str("world")
    let out = sb.to_string()
    println(out)
    println("len:" + sb.len.to_string())
    assert(out == "hello world")
    assert(sb.len == 11)
    return 0
}

test "probe file carries runnable block" {
    assert(true)
}

test "stringbuilder push_str to_string len" {
    let sb = StringBuilder()
    sb.push_str("hello")
    sb.push_str(" ")
    sb.push_str("world")
    let out = sb.to_string()
    assert(out == "hello world")
    assert(sb.len == 11)
}
