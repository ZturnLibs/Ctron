// tests/crypto_vec/corpus/a_sha256_edge.ct —— 填充边界:55/56/63/64 字节
// (0x80 落位/末块槽位/双块长度域;interp 臂预算约 8 块等效——P5-B 登记
// 解释器堆不回收,逐文件 ~10 块内)。锚值 = python hashlib 生成。
use std.crypto.{sha256_bytes, bytes_to_hex, bytes_from_hex}

fn h2b(s: Str) -> List[I32] {
    return bytes_from_hex(s)
}

test "sha256 55b" {
    assert_eq(bytes_to_hex(sha256_bytes(h2b("31323334353637383930313233343536373839303132333435363738393031323334353637383930313233343536373839303132333435"))), "03c3a70e99ed5eeccd80f73771fcf1ece643d939d9ecc76f25544b0233f708e9")
}

test "sha256 56b" {
    assert_eq(bytes_to_hex(sha256_bytes(h2b("3132333435363738393031323334353637383930313233343536373839303132333435363738393031323334353637383930313233343536"))), "0be66ce72c2467e793202906000672306661791622e0ca9adf4a8955b2ed189c")
}

test "sha256 63b" {
    assert_eq(bytes_to_hex(sha256_bytes(h2b("313233343536373839303132333435363738393031323334353637383930313233343536373839303132333435363738393031323334353637383930313233"))), "b97f6a278ef6a159ba660dc99fc5426ae3c1e4e08c471827d660bf36cfb236e7")
}

test "sha256 64b" {
    assert_eq(bytes_to_hex(sha256_bytes(h2b("31323334353637383930313233343536373839303132333435363738393031323334353637383930313233343536373839303132333435363738393031323334"))), "676491965ed3ec50cb7a63ee96315480a95c54426b0b72bca8a0d4ad1285ad55")
}
