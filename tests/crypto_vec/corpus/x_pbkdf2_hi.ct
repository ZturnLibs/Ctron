// tests/crypto_vec/corpus/x_pbkdf2_hi.ct —— PBKDF2 高迭代向量(x_ = 仅
// emit 臂入计,json_fidelity x_p53_rounding 同款结构性登记):RFC 6070
// SHA-256 同参 c=2 / c=4096 两档 + 25B 长盐 c=4096 + dkLen 截取。
// interp 专斥理由:堆不回收(P5-B 登记),c=4096 ≈ 8192 块压缩等效,
// 解释器口径不可实用(crypto.ct 头注同口径);emit 口径 ≈ 0.7s。
// 锚值 = python hashlib.pbkdf2_hmac 生成。
use std.crypto.{pbkdf2_sha256, bytes_to_hex, bytes_from_hex}

fn h2b(s: Str) -> List[I32] {
    return bytes_from_hex(s)
}

test "sha256-pbkdf2 c2 dk20" {
    assert_eq(bytes_to_hex(pbkdf2_sha256(h2b("70617373776f7264"), h2b("73616c74"), 2, 20)), "ae4d0c95af6b46d32d0adff928f06dd02a303f8e")
}

test "rfc6070-sha256 c5 dk20" {
    assert_eq(bytes_to_hex(pbkdf2_sha256(h2b("70617373776f7264"), h2b("73616c74"), 5, 20)), "65cc4b332e89aa90252ddca8fd3641d5b830f221")
}

test "rfc6070-sha256 c4096 dk20" {
    assert_eq(bytes_to_hex(pbkdf2_sha256(h2b("70617373776f7264"), h2b("73616c74"), 4096, 20)), "c5e478d59288c841aa530db6845c4c8d962893a0")
}

test "sha256-pbkdf2 c4096 dk25 long salt" {
    assert_eq(bytes_to_hex(pbkdf2_sha256(h2b("70617373776f726450415353574f524470617373776f7264"), h2b("73616c7453414c5473616c7453414c5473616c7453414c5473616c7453414c5473616c74"), 4096, 25)), "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c")
}

test "sha256-pbkdf2 c4096 dk32" {
    assert_eq(bytes_to_hex(pbkdf2_sha256(h2b("70617373776f7264"), h2b("73616c74"), 4096, 32)), "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a")
}
