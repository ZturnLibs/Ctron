// 01_basics.ct —— 字面量、算术、表达式、UFCS、循环
// 钉子:2(字面量类型)、3(块即表达式)、5(range)、6(回绕运算)、18(属性无括号)

fn double(x: I32) -> I32 {
    return x * 2
}

fn greet(name: Str, n: I32) -> Str {
    return "hi {name} x{n}"
}

test "arithmetic" {
    assert_eq(2 + 3 * 4, 14)                  // 优先级
    assert_eq(7 / 2, 3)                       // 整除截断
    assert_eq(255u8 +% 1u8, 0u8)              // 显式回绕,默认检查算术之外唯一入口
    assert_eq(2.5 * 2.0, 5.0)                 // 浮点字面量默认 F64
}

test "if is an expression" {
    let n = 5
    let label = if n > 0 { "pos" } else { "neg" }
    assert_eq(label, "pos")
}

test "string interpolation" {
    assert_eq(greet("ct", 3), "hi ct x3")
}

test "ufcs free function as method" {
    assert_eq(double(21), 42)
    assert_eq(21.double(), 42)                // UFCS:两种写法同一函数
}

test "loops and ranges" {
    var sum = 0
    for i in 0..5 { sum += i }                // 0..5 = 0,1,2,3,4
    assert_eq(sum, 10)
    var inclusive = 0
    for i in 0..=5 { inclusive += i }         // 双闭
    assert_eq(inclusive, 15)
    var n = 1
    while n < 100 { n = n * 3 }
    assert_eq(n, 243)
}

fn shout(msg: Str) -> Void {                  // 显式 Void 返回(§3.1 单元类型)
    return void
}

test "multiline blocks with same-line else" {
    let n = 5
    let label = if n > 3 {
        "big"
    } else {
        "small"
    }                                          // `} else {` 必须同行(§1.6)
    assert_eq(label, "big")
    shout("ok")                                // Void 调用可作语句
}
