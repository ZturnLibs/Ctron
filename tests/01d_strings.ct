// 01d_strings.ct —— 转义、插值链(字段/属性/方法/索引)、len(字节) vs char_len(字符)
test "escapes" {
    assert_eq("a\nb".len, 3)
    assert_eq("\{", "{")
    assert_eq("\u{4E2D}", "中")
}

test "interpolation with member chains and indexing" {
    var xs: I32[3] = [1, 2, 3]
    let msg = "len={xs.len} first={xs[0]}"       // 属性链 + 索引(§1.4)
    assert_eq(msg, "len=3 first=1")
    let opt: I32? = Some(7)
    assert_eq("v={opt.or(0)}", "v=7")            // 方法调用进插值
}
