// fb8_array_byval.ct —— FB-8/F5:定长数组按值传参(§3.1 T[N] 值类型;被调改元不污染调用方)
fn bump(buf: I32[3]) -> I32 {
    buf[0] = 99
    return buf[0]
}

fn main() -> I32 {
    var a: I32[3] = [1, 2, 3]
    let r = bump(a)
    println(r.to_string())
    println(a[0].to_string())
    return 0
}

test "array param by value" {
    var a: I32[3] = [1, 2, 3]
    assert_eq(bump(a), 99)
    assert_eq(a[0], 1)
}
