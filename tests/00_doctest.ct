// 00_doctest.ct —— doc-test 格式锚样例(README §8):/// 注释中的 ```c 围栏块被编译并执行
/// 返回两数之和。
///
/// ```c
/// assert_eq(add2(40, 2), 42)
/// ```
///
/// 第二块:同文件多块逐块提升;```text 等非 c 标签围栏 = 散文不执行
/// (下面这行若被提升,999 断言必失败)。
///
/// ```text
/// assert_eq(add2(0, 0), 999)
/// ```
///
/// ```c
/// assert_eq(add2(-1, 1), 0)
/// ```
pub fn add2(a: I32, b: I32) -> I32 {
    return a + b
}

test "doc-test format sample" {
    assert_eq(add2(1, 2), 3)
}
