// proc —— 零 shell 进程控制回环验收(lib/proc;CW-F3b)
// 钉住:run_argv 捕获 stdout(/bin/echo)、退出码透传(/usr/bin/false = 1)、
// exec 失败 127(不存在路径)、cwd 切换、spawn_bg 后台 + kill + wait(信号杀 = -1)、
// words_to_blob 纯面已在 lib inline。CI 纪律:仅本机 /bin 工具,零网络。
use proc.{run_argv, run_argv_rc, spawn_bg, kill_pid, wait_pid, words_to_blob, argv_to_blob}
use proc.bind.{ctron_proc_run_argv_p, ProcBox64}
use fio.{write_raw}

test "run_argv captures stdout and rc" {
    var blob: U8[64] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = words_to_blob("/bin/echo proc-e2e-ok", blob)
    assert(n > 0)
    var out: U8[64] = [0, 0, 0, 0, 0, 0, 0, 0]
    let rc = run_argv("", blob, n.as[I64](), out)
    assert(rc == 0)
    // 输出 = "proc-e2e-ok\n"
    assert(out[0] == 112)
    assert(out[4] == 45)
    assert(out[11] == 10)
}

test "run_argv exit code passthrough" {
    var blob: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = words_to_blob("/usr/bin/false", blob)
    var out: U8[8] = [0, 0, 0, 0, 0, 0, 0, 0]
    assert(run_argv("", blob, n.as[I64](), out) == 1)
}

test "run_argv exec fail = 127" {
    var blob: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = words_to_blob("/no/such/bin-xyz", blob)
    var out: U8[8] = [0, 0, 0, 0, 0, 0, 0, 0]
    assert(run_argv("", blob, n.as[I64](), out) == 127)
}

test "spawn_bg + kill + wait (signaled = -1)" {
    // /bin/sleep 5 后台 → pid > 0;kill(SIGTERM) 后 wait = -1(非正常退出)
    // 注:spawn_bg 的 argv 固定为 "<bin> run <arg>" 形 → 用 loom 形语义此处以
    // run 形验证信号路径:直接对 sleep 用 run_argv 变体不可 kill(内联 wait)——
    // 改验 pid 正常态:spawn 一个立即退出的 run 形("true" 语义经 echo)
    var blob: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = words_to_blob("/bin/echo bg", blob)
    assert(n > 0)
    // spawn_bg 是 "<bin> run <arg>" 固定形——用 /bin/echo run bg:退出 0,不阻塞
    let pid = spawn_bg("", "/bin/echo", "bg", "")
    assert(pid > 0)
    let wrc = wait_pid(pid)
    assert(wrc == 0)
    // 信号杀路径:/bin/sleep 以 run 形跑会被内联 wait 卡 60s——略;
    // kill 对已收尸 pid = -1(ESRCH)可作轻锚
    assert(kill_pid(pid) == -1)
}

test "run_argv_p: PATH lookup + stdin redirect + capture count" {
    // stdin 载荷落盘 → /usr/bin/cat 换 PATH 名 "cat"(execvp 验证)→ 捕获回读
    var payload: U8[12] = [115, 116, 100, 105, 110, 45, 101, 50, 101, 10, 0, 0]
    let pin = "/tmp/ctron-proc-stdin.txt"
    assert(write_raw(pin, payload, 10) == 1)
    var blob: U8[16] = [0, 0, 0, 0, 0, 0, 0, 0]
    var n: I32 = 0
    n = blob_push_word(blob, n, "cat")
    assert(n > 0)
    var out: U8[16] = [0, 0, 0, 0, 0, 0, 0, 0]
    var plen = ProcBox64 { v: 0 }
    let rc = ctron_proc_run_argv_p("", blob, n.as[I64](), pin, 1, out, plen)
    assert(rc == 0)
    assert(plen.v == 10)
    assert(out[0] == 115)
    assert(out[9] == 10)
    // capture=0 面:stdout 继承(不建管道;rc 型语义)——cat 无 stdout 消费也正常退出
    var plen0 = ProcBox64 { v: 0 }
    assert(ctron_proc_run_argv_p("", blob, n.as[I64](), pin, 0, out, plen0) == 0)
    assert(plen0.v == 0)
    fs_delete(pin)
}

// rc 型面:run_argv_rc(stdout/stderr 继承;argv_to_blob 构包)——rc0 / 透传 / 127

test "run_argv_rc: rc 0 via echo (3 args, stdout inherited)" {
    var argv = List[Str]()
    argv.push("/bin/echo")
    argv.push("rc")
    argv.push("face")
    argv.push("ok")
    var blob: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = argv_to_blob(argv, blob)
    // "/bin/echo\0rc\0face\0ok\0" = 10 + 3 + 5 + 3 = 21
    assert(n == 21)
    // 输出直入测试主进程 stdout(run.sh 落盘),此处只验 rc 面
    assert(run_argv_rc("", blob, n.as[I64](), "") == 0)
}

test "run_argv_rc: exit code passthrough (false = 1)" {
    var blob: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = words_to_blob("/usr/bin/false", blob)
    assert(run_argv_rc("", blob, n.as[I64](), "") == 1)
}

test "run_argv_rc: exec fail = 127 (stdin_path empty = inherit)" {
    var blob: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    let n = words_to_blob("/no/such/bin-rc-xyz", blob)
    assert(run_argv_rc("", blob, n.as[I64](), "") == 127)
}

// 上限实证:14 段 argv(/bin/echo + 13 单字符参)capture=1 → 26 字节整捕
// (旧上限 12 只解析 12 段 = 11 参 = 22 字节 → 本臂必败 = 上限回归钉)
test "run_argv_p cap 32: 14-segment argv captured intact" {
    var blob: U8[64] = [0, 0, 0, 0, 0, 0, 0, 0]
    var n: I32 = 0
    n = blob_push_word(blob, n, "/bin/echo")
    n = blob_push_word(blob, n, "0")
    n = blob_push_word(blob, n, "1")
    n = blob_push_word(blob, n, "2")
    n = blob_push_word(blob, n, "3")
    n = blob_push_word(blob, n, "4")
    n = blob_push_word(blob, n, "5")
    n = blob_push_word(blob, n, "6")
    n = blob_push_word(blob, n, "7")
    n = blob_push_word(blob, n, "8")
    n = blob_push_word(blob, n, "9")
    n = blob_push_word(blob, n, "a")
    n = blob_push_word(blob, n, "b")
    n = blob_push_word(blob, n, "c")
    assert(n == 36)
    var out: U8[32] = [0, 0, 0, 0, 0, 0, 0, 0]
    var plen = ProcBox64 { v: 0 }
    let rc = ctron_proc_run_argv_p("", blob, n.as[I64](), "", 1, out, plen)
    assert(rc == 0)
    // echo 输出 = 13 字符 + 12 空格 + 1 换行 = 26
    assert(plen.v == 26)
    assert(out[0] == 48)
    assert(out[1] == 32)
    assert(out[24] == 99)
    assert(out[25] == 10)
}

// argv_to_blob 对照:同词输入产同 blob(words_to_blob 一致性);空表 = -1
test "argv_to_blob parity with words_to_blob + empty = -1" {
    var wb: U8[64] = [0, 0, 0, 0, 0, 0, 0, 0]
    let wn = words_to_blob("/bin/echo x y", wb)
    var argv = List[Str]()
    argv.push("/bin/echo")
    argv.push("x")
    argv.push("y")
    var ab: U8[64] = [0, 0, 0, 0, 0, 0, 0, 0]
    let an = argv_to_blob(argv, ab)
    assert(wn == an)
    var t: I32 = 0
    while t < an {
        assert(ab[t] == wb[t])
        t = t + 1
    }
    assert(argv_to_blob(List[Str](), ab) == -1)
}

// 词追加(NUL 结尾);返回新 n(-1 = 容量不足)
fn blob_push_word(var blob: U8[], n: I32, word: Str) -> I32 {
    var i: I32 = 0
    while i < word.len {
        if n >= blob.len { return -1 }
        var bv: I64 = byte_at(word, i)
        if bv < 0 { bv = bv + 256 }
        blob[n] = bv.as[U8]()
        n = n + 1
        i = i + 1
    }
    if n >= blob.len { return -1 }
    blob[n] = 0.as[U8]()
    return n + 1
}
