// 08_bare.ct —— bare 档:一切分配显式经 arena 参数(§5.6,钉子 16)
//@ target: bare

fn total(data: U8[], arena: Arena) -> U32 {
    var seen = arena.zeros[U32](256)          // 显式 arena 分配频次表
    for b in data { seen[b] += 1 }
    var acc: U32 = 0
    for b in data { acc += seen[b] }          // 频次之和 = 元素个数(自校验)
    return acc
}

test "bare explicit arena" {
    let data: U8[] = [1, 2, 2, 3]
    assert_eq(total(data, Arena.fixed(1024)), 4)
}
