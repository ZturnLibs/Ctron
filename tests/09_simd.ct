// 09_simd.ct —— 定长向量一等公民(§3.1/§9.5;前奏 API:v0.5 钉死)
test "simd splat, lane, elementwise whitelist ops" {
    let a = Simd[F32, 4].splat(2.0f32)
    let b = Simd[F32, 4].splat(3.0f32)
    let c = a * b + a                 // 元素级白名单运算:2*3+2 = 8
    assert_eq(c.lane(0), 8.0f32)
    let arr = c.to_array()            // -> F32[4]
    assert_eq(arr.len, 4)
    assert_eq(arr[3], 8.0f32)
}
