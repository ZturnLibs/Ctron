// tls_smoke —— P3-C TLS 门面回环验收(BIO-over-hybrid 混合化继承的机械证明)
// 双模式:默认 pthread 面与 CTRON_RT=coro 面各跑一次(tests/net/run.sh 主环
// 随双矩阵各跑本夹具;本目录 run.sh 可单独驱动双模式)。coro 面下服务端
// 协程的 TLS 握手/读写深停车于 net 垫片(read_t 的 MSG_DONTWAIT 直试 +
// wait_fd 停车),与主面客户端并发完成握手 —— TLS 不设新停车点、零 rt 直引
// (ctron_tls.c 文件头);若混合化未继承,本夹具双面即挂死或失败。
// 证书:run.sh 内 openssl req -x509 自签(临时目录,零外联),路径经环境
// 变量注入(std 无 getenv 面 → c_src/ct_smoke_env.c 垫 + #[trusted] extern,
// probe_boundary 先例)。
// 钉住:listen :0 + 端口回读、TLS 握手(client REQUIRED 验自签链 + server
// 证书)、ALPN 服务端偏好序选定(客户端提供序故意倒序)、写读回环、
// eof(close_notify → CONN_EOF → tls_read 0)、显式 close + ctx=-1 纪律
// (Drop 跳过)与 Drop RAII 兜底。
// 发射面避让(登记):assert/panic 语句在 sc.spawn 闭包(void* shim)内发射
// 裸 `return 1`(int→指针,cc 报)—— 服务端协程内一律显式 return 码,
// 主面 join 后断言;StdNet 值 struct 亦不可入闭包捕获槽(发射 int32 截断,
// 同 Task 4/6 登记的捕获面)—— 服务端协程内自取 Net_probe()。主面(内联
// 展开,非 shim)断言不受限。CI 纪律:仅回环、:0、零外联。
use std.net.{Net_probe, last_net_error, net_tcp_listen, net_tcp_sockname, net_tcp_accept, net_tcp_connect}
use std.tls.{tls_client, tls_server, tls_set_alpn, tls_handshake, tls_read, tls_write_str, tls_close, tls_alpn, tls_last_error}

#[trusted]
extern "c" fn ctron_smoke_env(k: Str) -> Str

fn main() -> I32 {
    let net = Net_probe()
    let cert = ctron_smoke_env("CTRON_SMOKE_CERT")
    let key = ctron_smoke_env("CTRON_SMOKE_KEY")
    let ca = ctron_smoke_env("CTRON_SMOKE_CA")
    assert(cert.len > 0)
    assert(key.len > 0)
    assert(ca.len > 0)

    // ---- listen :0 + sockname 回读实际端口(net 面,§11.3 同前夹具) ----
    let lfd_box = Box[Box64](Box64 { v: 0 })
    if net_tcp_listen(net, "127.0.0.1", 0, lfd_box) != 0 {
        panic(last_net_error().message)
    }
    let port_box = Box[Box64](Box64 { v: 0 })
    assert(net_tcp_sockname(net, lfd_box.v, port_box) == 0)
    let port = port_box.v
    assert(port > 0)
    let lfd = lfd_box.v

    var out = scope { |sc|
        // ---- 服务端协程:accept → TLS server 句柄 → 握手 → ALPN →
        //      回环一笔 → 读对端 close_notify 的 eof。无 assert/panic 语句
        //      (发射面避让,见头注),失败经 join 码暴露。 ----
        var srv = sc.spawn(|| {
            let net2 = Net_probe()
            let afd_box = Box[Box64](Box64 { v: 0 })
            if net_tcp_accept(net2, lfd, afd_box) != 0 {
                return 1
            }
            let srvst = TcpStream { fd: afd_box.v }
            let sctx = tls_server(net2, srvst.fd, cert, key)
            if sctx < 0 {
                return 2
            }
            var conn = TlsConn { ctx: sctx }
            if tls_set_alpn(net2, conn, "ctron-tls/1,http/1.1") != 0 {
                return 3
            }
            if tls_handshake(net2, conn, srvst.fd) != 0 {
                return 4
            }
            // 服务端偏好序胜出(客户端提供序 http/1.1 在前)
            if tls_alpn(net2, conn) != "ctron-tls/1" {
                return 5
            }

            var buf: I64[4096] = [0, 0, 0, 0]
            let n = tls_read(net2, conn, buf, 4096, 5000)
            if n != 9 {
                return 6
            }
            if buf[0] != 116 || buf[7] != 103 || buf[8] != 33 {
                return 7            // "tls-ping!":首 't'(116)/'g'(103)/尾 '!'(33)
            }
            let w = tls_write_str(net2, conn, "tls-pong!")
            if w != 9 {
                return 8
            }
            // 客户端 close_notify → eof(0):CONN_EOF 映射钉住
            let en = tls_read(net2, conn, buf, 4096, 5000)
            if en != 0 {
                return 9
            }

            tls_close(net2, conn)
            conn.ctx = -1
            return 0
        })

        // ---- 客户端(主面):connect → TLS client 句柄(信任锚 = 自签
        //      cert 本身)→ 握手 → ALPN 断言 → 写读回环 → 显式关 ----
        let cfd_box = Box[Box64](Box64 { v: 0 })
        if net_tcp_connect(net, "127.0.0.1", port, cfd_box) != 0 {
            panic("connect: " + last_net_error().message)
        }
        let st = TcpStream { fd: cfd_box.v }
        let cctx = tls_client(net, st.fd, ca)
        if cctx < 0 {
            panic("client ctx: " + tls_last_error().message)
        }
        var cc = TlsConn { ctx: cctx }
        assert(tls_set_alpn(net, cc, "http/1.1,ctron-tls/1") == 0)
        if tls_handshake(net, cc, st.fd) != 0 {
            panic("client handshake: " + tls_last_error().message)
        }
        assert(tls_alpn(net, cc) == "ctron-tls/1")

        let w = tls_write_str(net, cc, "tls-ping!")
        assert(w == 9)
        var buf: I64[4096] = [0, 0, 0, 0]
        let n = tls_read(net, cc, buf, 4096, 5000)
        if n < 0 {
            panic("client read: " + tls_last_error().message)
        }
        assert(n == 9)
        assert(buf[0] == 116)   // 't'
        assert(buf[7] == 103)   // 'g'
        assert(buf[8] == 33)    // '!'

        tls_close(net, cc)
        cc.ctx = -1
        let s = srv.join()
        assert(s == 0)
        return 0
    }
    return 0
}
