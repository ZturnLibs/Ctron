// fb9_tuple.ct —— FB-9/F20:元组值面(§3.1.2;构造/成员/跨 fn 返回/循环体 return)
fn mk() -> (I32, Str) {
    return (7, "s")
}

fn main() -> I32 {
    let a = mk()
    assert_eq(a.0, 7)
    assert_eq(a.1, "s")
    return 0
}

test "tuple value face" {
    let t = (1, "x")
    assert_eq(t.0, 1)
    assert_eq(t.1, "x")
}
