// 03j_stringbuilder.ct —— StringBuilder owned 字符串构建(§3.8.2;T03 三线落地,2026-09-28 迁入主套件)
// 语义承诺:push_str 拼接;to_string 产出 owned String;len 为当前字节长度
test "builder concat" {
    var sb = StringBuilder()
    sb.push_str("hello")
    sb.push_str(", ")
    sb.push_str("ctron")
    assert_eq(sb.len, 12)
    assert_eq(sb.to_string(), "hello, ctron")
}

test "builder from empty" {
    var sb = StringBuilder()
    assert_eq(sb.len, 0)
    sb.push_str("")
    assert_eq(sb.to_string(), "")
}

test "builder reserve clear" {
    // G1-T5:reserve(确保再收 n 字节不重分配)+ clear(复用同一缓冲)
    var sb = StringBuilder()
    sb.reserve(1024)
    var i: I32 = 0
    while i < 100 {
        sb.push_str("abcdefghij")
        i += 1
    }
    assert_eq(sb.len, 1000)
    sb.clear()
    assert_eq(sb.len, 0)
    sb.push_str("again")
    assert_eq(sb.to_string(), "again")
}
