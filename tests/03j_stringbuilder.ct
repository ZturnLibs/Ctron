// 03j_stringbuilder.ct —— StringBuilder owned 字符串构建(§3.8.2;T03 三线落地,2026-09-28 迁入主套件)
// 语义承诺:push_str 拼接;to_string 产出 owned String;len 为当前字节长度
test "builder concat" {
    var sb = StringBuilder()
    sb.push_str("hello")
    sb.push_str(", ")
    sb.push_str("ctron")
    assert_eq(sb.len, 12)
    assert_eq(sb.to_string(), "hello, ctron")
}

test "builder from empty" {
    var sb = StringBuilder()
    assert_eq(sb.len, 0)
    sb.push_str("")
    assert_eq(sb.to_string(), "")
}
