// 04g_let_assign.neg.ct —— §4.0 let 不可变绑定:E2080 赋值门(v0.9)
// 语义承诺:let 绑定一经初始化不可重赋值;需写回显式声明 var。var/参数/闭包形参/
// for·match 模式绑定不在本门(v0.9 豁免面,登记债)。
//@ fail: E2080

test "assign to let binding is rejected" {
    let x = 1
    x = 2
    assert_eq(x, 2)
}

test "compound assign to let binding is rejected" {
    let n = 10
    n += 5
    assert_eq(n, 15)
}

test "let shadows var then assign is rejected" {
    var y = 1
    y = 2
    let y = 3
    y = 4
    assert_eq(y, 4)
}
