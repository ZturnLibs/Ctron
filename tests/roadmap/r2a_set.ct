// r2a_set.ct —— Set[T] 去重集合(R-P2a,§3.8.2 v0.6)
// 语义承诺:insert 返回"是否新增";contains/remove 返回 Bool;len 为元素数
// 锚点:R-P2a 落地转绿
test "insert dedup returns novelty" {
    var s = Set[Str]()
    assert(s.insert("a"))
    assert(!s.insert("a"))
    s.insert("b")
    assert_eq(s.len, 2)
}

test "contains and remove" {
    var s = Set[I32]()
    s.insert(1)
    s.insert(2)
    assert(s.contains(2))
    assert(!s.contains(3))
    assert(s.remove(1))
    assert(!s.remove(1))
    assert_eq(s.len, 1)
}
