// r5a_semantics.ct —— comptime 求值语义回归锚(R-P5a)
// 现状:const 按声明序求值(对语料语义等价);R-P5a 切换真编译期求值后,
//      本文件必须保持全绿——它是重构防线,不是新特性锚
comptime fn fib(n: I32) -> I32 {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

comptime fn gcd(a: I32, b: I32) -> I32 {
    if b == 0 { return a }
    return gcd(b, a % b)
}

const FIB7: I32 = fib(7)
const FIB9: I32 = fib(9)
const GCD: I32 = gcd(48, 36)

test "comptime constants keep semantics" {
    assert_eq(FIB7, 13)
    assert_eq(FIB9, 34)
    assert_eq(GCD, 12)
}
