// r6c_as_u64_negsrc.ct —— 负值源 as[U64] 模 2^64(§3.6 窄化语义;P1-B 收口判据)
// 语义承诺:(-1).as[U64]() == 18446744073709551615(负值模 2^64 折回;
// 旁断言:U64 上界字面量在无期望类型上下文保真,不被 i64 截断)
// 锚点:R 线 interp 字面量 i64 截断缺陷已修(2026-09-19,超 i64 正程保真 UInt)→ R 线绿;
// C 宿主仍在册红(三处:wrap_int 64 位无掩码透传 -1、as 调用实参位字面量 decl 检查
// 按有符号拒、未标注位自适应丢 us → 得 2^128-1/-1);自举线一直正确。
test "negative source as u64 wraps mod 2^64" {
    let n: I32 = -1
    assert_eq(n.as[U64](), 18446744073709551615)
}
