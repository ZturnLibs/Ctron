//@ fail: E2030
// 02f_match_guard_exhaustive.neg.ct —— 守卫臂不参与穷尽(§4.6;R-P3c 三线落地迁入)
// 语义承诺:守卫可能不成立,带守卫的臂不算覆盖;全部臂带守卫且无通配 = E2030
enum Two {
    X
    Y
}

fn f(e: Two) -> I32 {
    return match e {
        X if true => 1
        Y if true => 2
    }
}

test "guards do not exhaust" {
    assert_eq(f(X), 1)
}
