// 04d_bool_or.ct —— v0.7 修订一:|| 逻辑或(短路,Bool-only;§4.0 运算符宪法)
// 与零参闭包 || 的位置消歧:起始位=闭包参数表,中缀位=逻辑或。

fn get(n: I32) -> Option[I32] {
    if n > 0 {
        return Some(n)
    }
    return None
}

fn pick(f: fn() -> I32) -> I32 {
    return f()
}

test "truth table" {
    assert_eq(true || false, true)
    assert_eq(false || true, true)
    assert_eq(false || false, false)
    assert_eq(true || true, true)
}

test "precedence: and binds tighter than or" {
    assert_eq(true || false && false, true)
    assert_eq((true || false) && false, false)
}

test "or default unaffected by new level" {
    let a = get(5) or 99
    let b = get(0) or 99
    assert_eq(a, 5)
    assert_eq(b, 99)
}

test "zero arg closure and bool or coexist" {
    let v = pick(|| 7)
    assert_eq(v, 7)
    assert_eq(false || true, true)
}

test "right operand skipped on true lhs" {
    // 短路:RHS 不求值(此处 RHS 为可观察的函数调用)
    var calls: I32 = 0
    let r = true || next_is_true(calls)
    assert_eq(r, true)
}

fn next_is_true(_n: I32) -> Bool {
    return true
}

// v0.8 回归锚:if 条件含 || 链(曾因 p_if 走 p_and 不消费 || 而解析错位,
// 发射面报 StructLit 非值类型;语料此前零覆盖)
fn or_if(t: I32) -> I32 {
    var b: I32 = 10
    while b > 0 {
        var d = byte_at("x y", 0)
        if d == 32 || d == 9 {
            b -= 1
        } else {
            return b + t
        }
    }
    return t
}

test "if condition with || chain parses and runs" {
    assert_eq(1 == 1 || 2 == 3, true)
    assert_eq(1 == 2 || 2 == 3, false)
}

test "if || inside loop with else" {
    assert_eq(or_if(1), 11)
}
