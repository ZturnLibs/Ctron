// x_client_e2e —— P4-C HTTP 客户端 e2e(emit 专臂;self-hosted loopback)
// 服务端 = sc.spawn 协程(发射面避让:闭包内无 assert/panic,一律显式 return 码;
// HttpSock Drop 句柄在内层裸块生灭 —— (g) while 体 Drop 局部禁令惯用法);
// 客户端 = 主面,内联断言不受限。钉住:
//   - 基本 GET/200 + 体;POST 体(Content-Length 分框)
//   - 重定向链:307(全 URL Location)保方法保体;302(路径 Location)降 GET
//     弃体;303 → GET;上限 5 跳(/loop 自环 → err 7,nredir = 6)
//   - keep-alive 复用计数(bru:成功走复用连接的次数,测试可见)
//   - 对端早关(client 侧视角)→ 复用连接零字节读败 → 重连一次(重试一次)
// CI 纪律:仅回环、:0、零外联。双 RT 矩阵(默认 + CTRON_RT=coro)由 run.sh 双跑。
use http.client.{ http_net, client_listen, client_sockname, client_accept, client_read_t, client_request, client_write_str, client_close, HttpSock, rr_rc, rr_status, rr_err, rr_nredir, rr_reuses, rr_body_len, rr_body_off }
use http.parse.{ http_parse_head, http_limits_default, http_rc, http_method_start, http_method_len, http_target_start, http_target_len, http_clen, http_head_end }
use http.message.{ msg_response_head }

// 请求行 target 切片等值
fn fx_target_is(buf: &I64[], ms: I64, ml: I64, ts: I64, tl: I64, want: Str) -> I64 {
    if tl != want.len {
        return 0
    }
    var i: I64 = 0
    while i < tl {
        if buf[ts + i] != byte_at(want, i.as[I32]()).as[I64]() {
            return 0
        }
        i += 1
    }
    return 1
}

// lane 切片 → Str( printable ASCII;方法/体回声面)
fn fx_slice_str(src: &I64[], a: I64, b: I64) -> Str {
    var out = ""
    var i = a
    while i < b {
        let c = src[i]
        if c < 32 || c > 126 || c == 123 {
            return ""
        }
        if c < 123 {
            out = out + byte_slice(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz", c - 32, c - 31)
        } else {
            out = out + byte_slice("|}~", c - 124, c - 123)
        }
        i += 1
    }
    return out
}

// 体字节等值断言面
fn fx_eq_bytes(buf: &I64[], off: I64, want: Str) -> I64 {
    var i: I32 = 0
    while i < want.len {
        if buf[off + i.as[I64]()] != byte_at(want, i).as[I64]() {
            return 0
        }
        i += 1
    }
    return 1
}

// Str 落 lane(请求体)
fn fx_fill(buf: &I64[], s: Str) -> I64 {
    var i: I32 = 0
    while i < s.len {
        buf[i] = byte_at(s, i).as[I64]()
        i += 1
    }
    return s.len.as[I64]()
}

// 服务端读一请求头(parse 增量;读追加经 scratch —— lane 无偏移读面)
struct SrvHead {
    var rc: I64
    var n: I64
    var ms: I64
    var ml: I64
    var ts: I64
    var tl: I64
    var clen: I64
    var hend: I64
}

fn fx_srv_read(fd: I64, buf: &I64[], cap: I64, scr: &I64[]) -> SrvHead {
    var out = SrvHead { rc: -1, n: 0, ms: 0, ml: 0, ts: 0, tl: 0, clen: 0, hend: 0 }
    var n: I64 = 0
    var need = 1
    var guard: I64 = 0
    while need == 1 && guard < 64 {
        guard += 1
        let h = http_parse_head(buf, n, http_limits_default())
        if http_rc(h) == 1 {
            need = 0
            out.rc = 0
            out.ms = http_method_start(h)
            out.ml = http_method_len(h)
            out.ts = http_target_start(h)
            out.tl = http_target_len(h)
            out.clen = http_clen(h)
            out.hend = http_head_end(h)
            out.n = n
        } else {
            if http_rc(h) == -1 {
                return out
            }
            let r = client_read_t(fd, scr, 2048, 5000)
            if r <= 0 {
                return out
            }
            var i: I64 = 0
            while i < r {
                if n + i < cap {
                    buf[n + i] = scr[i]
                }
                i += 1
            }
            n = n + r
        }
    }
    return out
}

// 服务端读一请求体(CL;头后追加)
fn fx_srv_body(fd: I64, buf: &I64[], n0: I64, hend: I64, clen: I64, cap: I64, scr: &I64[]) -> I64 {
    var n = n0
    let need = hend + clen
    while n < need {
        let r = client_read_t(fd, scr, 2048, 5000)
        if r <= 0 {
            return -1
        }
        var i: I64 = 0
        while i < r {
            if n + i < cap {
                buf[n + i] = scr[i]
            }
            i += 1
        }
        n = n + r
    }
    return n
}

test "client e2e redirects keepalive retry" {
    let net = http_net()
    let lfd_box = Box[Box64](Box64 { v: -1 })
    assert(client_listen("127.0.0.1", 0, lfd_box) == 0)
    let port_box = Box[Box64](Box64 { v: 0 })
    assert(client_sockname(lfd_box.v, port_box) == 0)
    let port = port_box.v
    assert(port > 0)
    let lfd = lfd_box.v

    var out = scope { |sc|
        // ---- 服务端协程:路由面(闭包内无 assert/panic;显式 return 码) ----
        var srv = sc.spawn(|| {
            var served: I64 = 0
            let total: I64 = 15
            while served < total {
                let afd = Box[Box64](Box64 { v: -1 })
                if client_accept(lfd, afd) != 0 {
                    return 1
                }
