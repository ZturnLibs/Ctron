                    var sock = HttpSock { fd: afd.v }
                    var open = 1
                    while open == 1 && served < total {
                        let sr = fx_srv_read(sock.fd, buf2, 4096, scr2)
                        if sr.rc != 0 {
                            open = 0
                        } else {
                            if sr.clen > 0 {
                                let bn = fx_srv_body(sock.fd, buf2, sr.n, sr.hend, sr.clen, 4096, scr2)
                                if bn < 0 {
                                    open = 0
                                }
                            }
                        }
                        if open == 1 {
                            var route = 0
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/hello") == 1 {
                                route = 1
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/j1") == 1 {
                                route = 2
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/j2") == 1 {
                                route = 3
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/k1") == 1 {
                                route = 4
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/k2") == 1 {
                                route = 5
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/k3") == 1 {
                                route = 6
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/dropped") == 1 {
                                route = 7
                            }
                            if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/loop") == 1 {
                                route = 8
                            }
                            var bodystr = ""
                            if route == 3 {
                                let m = fx_slice_str(buf2, sr.ms, sr.ms + sr.ml)
                                let b = fx_slice_str(buf2, sr.hend, sr.hend + sr.clen)
                                bodystr = "M=" + m + ",B=" + b
                            }
                            if route == 5 {
                                let m = fx_slice_str(buf2, sr.ms, sr.ms + sr.ml)
                                bodystr = "M=" + m
                            }
                            if route == 1 {
                                if client_write_str(sock.fd, msg_response_head(1, 200, "OK", 5) + "hello") < 0 {
                                    open = 0
                                }
                            }
                            if route == 2 {
                                let loc = "HTTP/1.1 307 Temporary Redirect\r\nLocation: http://127.0.0.1:" + port.to_string() + "/j2\r\nContent-Length: 0\r\n\r\n"
                                if client_write_str(sock.fd, loc) < 0 {
                                    open = 0
                                }
                            }
                            if route == 3 {
                                if client_write_str(sock.fd, msg_response_head(1, 200, "OK", bodystr.len.as[I64]()) + bodystr) < 0 {
                                    open = 0
                                }
                            }
                            if route == 4 {
                                if client_write_str(sock.fd, "HTTP/1.1 302 Found\r\nLocation: /k2\r\nContent-Length: 0\r\n\r\n") < 0 {
                                    open = 0
                                }
                            }
                            if route == 5 {
                                if client_write_str(sock.fd, msg_response_head(1, 200, "OK", bodystr.len.as[I64]()) + bodystr) < 0 {
                                    open = 0
                                }
                            }
                            if route == 6 {
                                if client_write_str(sock.fd, "HTTP/1.1 303 See Other\r\nLocation: /hello\r\nContent-Length: 0\r\n\r\n") < 0 {
                                    open = 0
                                }
                            }
                            if route == 7 {
                                // 响应后静默关连接(无 Connection: close 头)—— 陈旧缓存面
                                if client_write_str(sock.fd, msg_response_head(1, 200, "OK", 1) + "d") < 0 {
                                    open = 0
                                }
                                open = 0
                            }
                            if route == 8 {
                                if client_write_str(sock.fd, "HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\n\r\n") < 0 {
                                    open = 0
                                }
                            }
                            served += 1
                        }
                    }
                }
            }
            return 0
        })

