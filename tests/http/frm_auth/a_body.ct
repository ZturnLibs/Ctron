// tests/http/frm_auth/a_body.ct —— body 绑定语料(P6-C;双臂 a_ 纯面)
// 面:JSON typed 提取(I64 定宽保真含 2^53+1 / f64 / bool / 字符串 / 嵌套,
//   缺省 + required 双语义,kind 三分负例,cap 拒,语法坏 emsg)+
//   multipart 字段+文件 happy(boundary 提取矩阵含 quoted/CI/域拒,字节道
//   文件件,行中 boundary 惰性数据钉)、malformed 矩阵(缺 close Err /
//   首 delimiter 缺 / 头区坏 / disposition 坏 / 5 件槽超 / cap 超)。
use http.frm.body.{ body_json, bj_rc, bj_why, bj_emsg, bj_i64, bj_i64_kind, bj_f64, bj_bool, bj_bool_kind, bj_str, bs_rc, bs_v, breq_i64, bi_rc, bi_v, body_err_ok, body_err_parse, body_err_cap, mp_boundary, mb_rc, mb_v, mp_parse, mp_rc, mp_why, mp_n, mp_name, mp_fname, mp_data, mp_dlen, mp_field, mp_err_ok, mp_err_cap, mp_err_bnd, mp_err_nofirst, mp_err_noclose, mp_err_hdr, mp_err_disp, mp_err_many }

// 字节道入参助手(fixture 局部;bd_ 私名防撞)
fn fb_bytes(s: Str) -> List[I32] {
    var out = List[I32]()
    var i: I32 = 0
    while i < s.len {
        out.push(byte_at(s, i))
        i += 1
    }
    return out
}

test "json bind numeric fidelity and typed matrix" {
    // 数值保真(I64 定宽;2^53+1 钉 —— jv_* 结构通道面)
    let doc = "\{\"id\":7,\"neg\":-5,\"big\":9007199254740993,\"max\":9223372036854775807,\"score\":0.75,\"on\":true,\"off\":false,\"nick\":\"zed\",\"sub\":\{\"depth\":-5},\"nul\":null,\"flt\":1.5}"
    let b = body_json(doc, 4096)
    assert(bj_rc(b) == 1 && bj_why(b) == body_err_ok())
    assert(bj_i64(b, "$.id", 0) == 7)
    assert(bj_i64(b, "$.neg", 0) == -5)
    assert(bj_i64(b, "$.big", 0) == 9007199254740993)
    assert(bj_i64(b, "$.max", 0) == 9223372036854775807)
    assert(bj_i64(b, "$.sub.depth", 0) == -5)
    // f64 / bool
    assert(bj_f64(b, "$.score", 0.0) == 0.75)
    assert(bj_bool(b, "$.on", false))
    assert(!bj_bool(b, "$.off", true))
    // 字符串面
    let s = bj_str(b, "$.nick")
    assert(bs_rc(s) == 1 && bs_v(s) == "zed")
}

test "json bind negatives and required" {
    let doc = "\{\"id\":7,\"nul\":null,\"nick\":\"zed\",\"flt\":1.5}"
    let b = body_json(doc, 4096)
    // 缺省面:缺失 → dft;kind 三分 + frac
    assert(bj_i64(b, "$.nope", 99) == 99)
    assert(bj_i64_kind(b, "$.nope") == "noent")
    assert(bj_i64_kind(b, "$.nul") == "null")
    assert(bj_i64_kind(b, "$.nick") == "type")
    assert(bj_i64_kind(b, "$.flt") == "frac")
    assert(bj_bool_kind(b, "$.nick") == "type")
    // 类型不符负例(字符串面取数值路径 / 数值路径取字符串)
    assert(bs_rc(bj_str(b, "$.id")) == 2)
    assert(bs_rc(bj_str(b, "$.nope")) == 0)
    // required 面:ok / noent / 他类
    let r1 = breq_i64(b, "$.id")
    assert(bi_rc(r1) == 1 && bi_v(r1) == 7)
    assert(bi_rc(breq_i64(b, "$.nope")) == 0)
    assert(bi_rc(breq_i64(b, "$.nick")) == 2)
    assert(bi_rc(breq_i64(b, "$.flt")) == 2)
    // cap 超(先验于析)→ why 2
    assert(bj_why(body_json(doc, 4)) == body_err_cap())
    // 语法坏 → why 1 + emsg 原文(std/json 负路径自带噪声打印,登记)
    let bad = body_json("\{\"id\":}", 4096)
    assert(bj_rc(bad) == 0 && bj_why(bad) == body_err_parse() && bj_emsg(bad).len > 0)
}

test "multipart happy field file and data pin" {
    // 字段 + 文件双件(文件件字节道;Content-Type 等他头掠过)
    let raw = "--BX\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nhello\r\n--BX\r\nContent-Disposition: form-data; name=\"doc\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nfile-bytes\r\n--BX--\r\n"
    let body = fb_bytes(raw)
    let p = mp_parse(body, body.len.as[I64](), "BX", 4096)
    assert(mp_rc(p) == 1 && mp_why(p) == mp_err_ok() && mp_n(p) == 2)
    assert(mp_name(p, 0) == "title" && mp_fname(p, 0) == "")
    assert(mp_field(p, 0) == "hello")
    assert(mp_name(p, 1) == "doc" && mp_fname(p, 1) == "a.txt")
    assert(mp_dlen(p, 1) == 10)
    let d1 = mp_data(p, 1)
    assert(d1[0] == 102 && d1[9] == 115)
    assert(mp_field(p, 1) == "file-bytes")
    // preamble 丢弃(首 delimiter 前噪声)
    let rawp = "--preamble noise--\r\n--BX\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nv\r\n--BX--\r\n"
    let bp = fb_bytes(rawp)
    let pp = mp_parse(bp, bp.len.as[I64](), "BX", 4096)
    assert(mp_rc(pp) == 1 && mp_n(pp) == 1 && mp_field(pp, 0) == "v")
    // 行中 boundary 字节 = 惰性数据(RFC 2046 §5.1.1 行首锚定;头注②)
    let raw2 = "--BX\r\nContent-Disposition: form-data; name=\"m\"\r\n\r\nxx--BXyy\r\n--BX--\r\n"
    let b2 = fb_bytes(raw2)
    let p2 = mp_parse(b2, b2.len.as[I64](), "BX", 4096)
    assert(mp_rc(p2) == 1 && mp_n(p2) == 1)
    assert(mp_field(p2, 0) == "xx--BXyy")
    // 空 part 数据 + close 无尾 CRLF(epilogue 容忍)
    let raw3 = "--BX\r\nContent-Disposition: form-data; name=\"e\"\r\n\r\n--BX--"
    let b3 = fb_bytes(raw3)
    let p3 = mp_parse(b3, b3.len.as[I64](), "BX", 4096)
    assert(mp_rc(p3) == 1 && mp_n(p3) == 1 && mp_dlen(p3, 0) == 0)
    // LWSP transport padding 容忍
    let raw4 = "--BX \r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nv\r\n--BX--  \r\nepi\r\n"
    let b4 = fb_bytes(raw4)
    let p4 = mp_parse(b4, b4.len.as[I64](), "BX", 4096)
    assert(mp_rc(p4) == 1 && mp_n(p4) == 1 && mp_field(p4, 0) == "v")
}

test "multipart boundary extraction matrix" {
    assert(mb_v(mp_boundary("multipart/form-data; boundary=abc123")) == "abc123")
    assert(mb_v(mp_boundary("multipart/form-data;boundary=abc123")) == "abc123")
    assert(mb_v(mp_boundary("multipart/form-data; charset=utf-8; boundary=\"x.y-z_9\"")) == "x.y-z_9")
    assert(mb_v(mp_boundary("MULTIPART/FORM-DATA; BOUNDARY=ci-case")) == "ci-case")
    // 非引号值止于 ';'(RFC 2045 参数拆分);引号内 ';' = bchars 域外
    assert(mb_v(mp_boundary("multipart/form-data; boundary=a;b")) == "a")
    assert(mb_rc(mp_boundary("multipart/form-data; boundary=\"a;b\"")) == 0)
    // 域拒:空 / >70 / 尾空格 / 他型
    assert(mb_rc(mp_boundary("multipart/form-data")) == 0)
    assert(mb_rc(mp_boundary("multipart/form-data; boundary=" + "0123456789012345678901234567890123456789012345678901234567890123456789012345")) == 0)
    assert(mb_rc(mp_boundary("multipart/form-data; boundary=\"trail \"")) == 0)
    assert(mb_rc(mp_boundary("application/json")) == 0)
    assert(mb_v(mp_boundary("multipart/form-data; boundary=sl/ash:ok=eq?")) == "sl/ash:ok=eq?")
}

test "multipart negative matrix" {
    let raw = "--BX\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nv\r\n--BX--\r\n"
    let body = fb_bytes(raw)
    // cap 超(先验)
    assert(mp_why(mp_parse(body, body.len.as[I64](), "BX", 4)) == mp_err_cap())
    // boundary 形坏(构造域)
    assert(mp_why(mp_parse(body, body.len.as[I64](), "", 4096)) == mp_err_bnd())
    // 首 delimiter 缺
    assert(mp_why(mp_parse(fb_bytes("no delims here"), 14, "BX", 4096)) == mp_err_nofirst())
    // 缺 close delimiter → Err(题面钉)
    let raw2 = "--BX\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nv\r\n"
    let b2 = fb_bytes(raw2)
    assert(mp_why(mp_parse(b2, b2.len.as[I64](), "BX", 4096)) == mp_err_noclose())
    // part 头区 CRLFCRLF 缺
    let raw3 = "--BX\r\nContent-Disposition: form-data; name=\"t\"\r\n--BX--\r\n"
    let b3 = fb_bytes(raw3)
    assert(mp_why(mp_parse(b3, b3.len.as[I64](), "BX", 4096)) == mp_err_hdr())
    // disposition 非 form-data / 缺 name
    let raw4 = "--BX\r\nContent-Disposition: attachment; filename=\"x\"\r\n\r\nv\r\n--BX--\r\n"
    let b4 = fb_bytes(raw4)
    assert(mp_why(mp_parse(b4, b4.len.as[I64](), "BX", 4096)) == mp_err_disp())
    let raw5 = "--BX\r\nContent-Disposition: form-data; filename=\"x\"\r\n\r\nv\r\n--BX--\r\n"
    let b5 = fb_bytes(raw5)
    assert(mp_why(mp_parse(b5, b5.len.as[I64](), "BX", 4096)) == mp_err_disp())
    // 第 5 件 → 槽超(4 槽上限)
    let one = "--BX\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nv\r\n--BX--\r\n"
    let many = "--BX\r\nContent-Disposition: form-data; name=\"0\"\r\n\r\n0\r\n--BX\r\nContent-Disposition: form-data; name=\"1\"\r\n\r\n1\r\n--BX\r\nContent-Disposition: form-data; name=\"2\"\r\n\r\n2\r\n--BX\r\nContent-Disposition: form-data; name=\"3\"\r\n\r\n3\r\n--BX\r\nContent-Disposition: form-data; name=\"4\"\r\n\r\n4\r\n--BX--\r\n"
    let bm = fb_bytes(many)
    assert(mp_why(mp_parse(bm, bm.len.as[I64](), "BX", 4096)) == mp_err_many())
    // 对照:4 件恰满 → ok
    let four = "--BX\r\nContent-Disposition: form-data; name=\"0\"\r\n\r\n0\r\n--BX\r\nContent-Disposition: form-data; name=\"1\"\r\n\r\n1\r\n--BX\r\nContent-Disposition: form-data; name=\"2\"\r\n\r\n2\r\n--BX\r\nContent-Disposition: form-data; name=\"3\"\r\n\r\n3\r\n--BX--\r\n"
    let b4p = fb_bytes(four)
    assert(mp_rc(mp_parse(b4p, b4p.len.as[I64](), "BX", 4096)) == 1)
}
