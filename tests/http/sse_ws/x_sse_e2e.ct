// x_sse_e2e —— P4-C SSE 行为面(emit 专臂;self-hosted loopback;双 RT 由 run.sh)
// 服务端 = sc.spawn 协程(闭包内无 assert/panic,显式 return 码;HttpSock 于
// 内层裸块生灭):
//   conn A  GET /events → chunked SSE(三事件:多行 data + id + 默认事件名),
//           客户端走 client_request(CL/chunked 分框 → 体区 sse_step 派发);
//   conn B  GET /stream → 无 CL 无 TE(Connection: close)原始事件流,事件间
//           30ms 节奏 → 客户端裸 socket 增量读 + sse_step 逐事件派发(流语义)。
// CI 纪律:仅回环、:0、零外联。
use http.client.{ http_net, client_listen, client_sockname, client_accept, client_connect, client_request, client_read_t, client_write, client_write_str, client_close, client_sleep_ms, HttpSock, rr_rc, rr_status, rr_body_len, rr_body_off }
use http.parse.{ http_parse_head, http_limits_default, http_rc, http_method_start, http_method_len, http_target_start, http_target_len, http_clen, http_head_end }
use http.message.{ msg_response_head, msg_chunk_header, msg_cl_header, msg_head_end, msg_header, msg_last_chunk, msg_request_line }
use http.sse.{ sse_event_str, sse_step, sse_st_new, sret_rc, sret_err, sret_consumed, sret_name, sret_data, sret_id, sret_st }

fn fx_slice_str(src: &I64[], a: I64, b: I64) -> Str {
    var out = ""
    var i = a
    while i < b {
        let c = src[i]
        if c < 32 || c > 126 || c == 123 {
            return ""
        }
        if c < 123 {
            out = out + byte_slice(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz", c - 32, c - 31)
        } else {
            out = out + byte_slice("|}~", c - 124, c - 123)
        }
        i += 1
    }
    return out
}

fn fx_eq_bytes(buf: &I64[], off: I64, want: Str) -> I64 {
    var i: I32 = 0
    while i < want.len {
        if buf[off + i.as[I64]()] != byte_at(want, i).as[I64]() {
            return 0
        }
        i += 1
    }
    return 1
}

fn fx_target_is(buf: &I64[], ms: I64, ml: I64, ts: I64, tl: I64, want: Str) -> I64 {
    if tl != want.len {
        return 0
    }
    var i: I64 = 0
    while i < tl {
        if buf[ts + i] != byte_at(want, i.as[I32]()).as[I64]() {
            return 0
        }
        i += 1
    }
    return 1
}

struct SrvHead {
    var rc: I64
    var n: I64
    var ms: I64
    var ml: I64
    var ts: I64
    var tl: I64
    var clen: I64
    var hend: I64
}

fn fx_srv_read(fd: I64, buf: &I64[], cap: I64, scr: &I64[]) -> SrvHead {
    var out = SrvHead { rc: -1, n: 0, ms: 0, ml: 0, ts: 0, tl: 0, clen: 0, hend: 0 }
    var n: I64 = 0
    var need = 1
    var guard: I64 = 0
    while need == 1 && guard < 64 {
        guard += 1
        let h = http_parse_head(buf, n, http_limits_default())
        if http_rc(h) == 1 {
            need = 0
            out.rc = 0
            out.ms = http_method_start(h)
            out.ml = http_method_len(h)
            out.ts = http_target_start(h)
            out.tl = http_target_len(h)
            out.clen = http_clen(h)
            out.hend = http_head_end(h)
            out.n = n
        } else {
            if http_rc(h) == -1 {
                return out
            }
            let r = client_read_t(fd, scr, 2048, 5000)
            if r <= 0 {
                return out
            }
            var i: I64 = 0
            while i < r {
                if n + i < cap {
                    buf[n + i] = scr[i]
                }
                i += 1
            }
            n = n + r
        }
    }
    return out
}

test "sse e2e chunked and stream" {
    let net = http_net()
    let lfd_box = Box[Box64](Box64 { v: -1 })
    assert(client_listen("127.0.0.1", 0, lfd_box) == 0)
    let port_box = Box[Box64](Box64 { v: 0 })
    assert(client_sockname(lfd_box.v, port_box) == 0)
    let port = port_box.v
    let lfd = lfd_box.v

    var out = scope { |sc|
        var srv = sc.spawn(|| {
            var served: I64 = 0
            while served < 2 {
                let afd = Box[Box64](Box64 { v: -1 })
                if client_accept(lfd, afd) != 0 {
                    return 1
                }
                {
