                    var sock = HttpSock { fd: afd.v }
                    let sr = fx_srv_read(sock.fd, buf2, 4096, scr2)
                    if sr.rc != 0 {
                        return 2
                    }
                    var is_stream = 0
                    if fx_target_is(buf2, sr.ms, sr.ml, sr.ts, sr.tl, "/stream") == 1 {
                        is_stream = 1
                    }
                    if is_stream == 0 {
                        // conn A:chunked SSE
                        let e1 = sse_event_str("add", "l1\nl2", "42", "")
                        let e2 = sse_event_str("", "tick", "", "")
                        let e3 = sse_event_str("", "bye", "", "")
                        let head = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\n\r\n"
                        let c1 = msg_chunk_header(e1.len.as[I64]()) + e1 + "\r\n"
                        let c2 = msg_chunk_header(e2.len.as[I64]()) + e2 + "\r\n"
                        let c3 = msg_chunk_header(e3.len.as[I64]()) + e3 + "\r\n"
                        if client_write_str(sock.fd, head + c1 + c2 + c3 + msg_last_chunk()) < 0 {
                            return 3
                        }
                    } else {
                        // conn B:原始事件流(Connection: close;事件间 30ms 节奏)
                        let head = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\n"
                        if client_write_str(sock.fd, head) < 0 {
                            return 4
                        }
                        if client_write_str(sock.fd, sse_event_str("add", "l1\nl2", "42", "")) < 0 {
                            return 5
                        }
                        client_sleep_ms(30)
                        if client_write_str(sock.fd, sse_event_str("", "tick", "", "")) < 0 {
                            return 6
                        }
                        client_sleep_ms(30)
                        if client_write_str(sock.fd, sse_event_str("", "bye", "", "")) < 0 {
                            return 7
                        }
                    }
                    served += 1
                }
            }
            return 0
        })

