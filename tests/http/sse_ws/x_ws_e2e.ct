    let net = http_net()
    let lfd_box = Box[Box64](Box64 { v: -1 })
    assert(client_listen("127.0.0.1", 0, lfd_box) == 0)
    let port_box = Box[Box64](Box64 { v: 0 })
    assert(client_sockname(lfd_box.v, port_box) == 0)
    let port = port_box.v
    let lfd = lfd_box.v

    var out = scope { |sc|
        var srv = sc.spawn(|| {
            var served: I64 = 0
            while served < 4 {
                let afd = Box[Box64](Box64 { v: -1 })
                if client_accept(lfd, afd) != 0 {
                    return 1
