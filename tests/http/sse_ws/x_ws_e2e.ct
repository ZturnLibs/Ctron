                    var bn_s = Box[Box64](Box64 { v: 0 })
                    var bmsg_s = Box[Box64](Box64 { v: 0 })
        var bpos_s = Box[Box64](Box64 { v: 0 })
                    var sock = HttpSock { fd: afd.v }
                    // ---- upgrade 握手 ----
                    let sr = fx_srv_read(sock.fd, buf2, 1024, scr2)
                    if sr.rc != 0 {
                        return 2
                    }
                    let wh = fx_ws_head(buf2, sr)
                    if wh.rc != 0 {
                        return 3
                    }
                    if ws_upgrade_ok(buf2, wh.us, wh.ul, buf2, wh.cs, wh.cl, buf2, wh.ks, wh.kl, buf2, wh.vs2, wh.vl2) != 1 {
                        return 4
                    }
                    let acc = ws_accept_key_lane(buf2, wh.ks, wh.kl)
                    let resp101 = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + acc + "\r\n\r\n"
                    if client_write_str(sock.fd, resp101) < 0 {
                        return 5
                    }
                    if served == 0 {
                        // ---- session A:回声五连 ----
                        // 1) 文本回声
                        var f1 = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                        if f1.rc != 0 || f1.opcode != 1 || f1.fin != 1 || f1.produced != 5 {
                            return 6
                        }
                        // 单帧文本消费面 UTF-8 校验演示(P4-C 评审 Minor 钉;此前仅
                        // 分片重组路径(session A 3/session D)有校验 —— 单帧文本
                        // 同为 RFC 6455 §8.1 close 1007 面,消费方重组完成处同规)
                        if ws_utf8_valid(asm, 0, f1.produced) != 1 {
                            return 28
                        }
                        let n1 = ws_frame_encode(obuf, 0, 1024, ws_op_text(), 1, asm, 0, f1.produced, 0, 0)
                        if client_write(sock.fd, obuf, n1) != n1 {
                            return 7
                        }
                        // 2) ping → pong
                        var f2 = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                        if f2.rc != 0 || f2.opcode != ws_op_ping() || f2.produced != 2 {
                            return 8
                        }
                        let n2 = ws_frame_encode(obuf, 0, 1024, ws_op_pong(), 1, asm, 0, f2.produced, 0, 0)
                        if client_write(sock.fd, obuf, n2) != n2 {
                            return 9
                        }
                        // 3) 分片重组:text fin=0 "Wor" + cont fin=1 "ld" → 单帧 "World" 回声
                        var f3 = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                        if f3.rc != 0 || f3.opcode != 1 || f3.fin != 0 || f3.produced != 3 {
                            return 10
                        }
                        var asmlen = f3.produced
                        var frag_open = 1
                        var fguard: I64 = 0
                        while frag_open == 1 && fguard < 16 {
                            fguard += 1
                            var fc = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, asmlen, 1024, bn_s, bpos_s, bmsg_s)
                            if fc.rc != 0 || fc.opcode != 0 {
                                return 11
                            }
                            asmlen = asmlen + fc.produced
                            if fc.fin == 1 {
                                frag_open = 0
                            }
                        }
                        if asmlen != 5 {
                            return 12
                        }
                        // 文本重组完成 → UTF-8 校验(§8.1;违例 → close 1007)
                        if ws_utf8_valid(asm, 0, asmlen) != 1 {
                            var cp7: I64[2] = [0, 0]
                            ws_close_payload(1007, cp7)
                            let n7 = ws_frame_encode(obuf, 0, 1024, ws_op_close(), 1, cp7, 0, 2, 0, 0)
                            client_write(sock.fd, obuf, n7)
                            return 20
                        }
                        let n3 = ws_frame_encode(obuf, 0, 1024, ws_op_text(), 1, asm, 0, asmlen, 0, 0)
                        if client_write(sock.fd, obuf, n3) != n3 {
                            return 13
                        }
                        // 4) binary 回声
                        var f4 = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                        if f4.rc != 0 || f4.opcode != ws_op_binary() || f4.fin != 1 || f4.produced != 3 {
                            return 14
                        }
                        let n4 = ws_frame_encode(obuf, 0, 1024, ws_op_binary(), 1, asm, 0, f4.produced, 0, 0)
                        if client_write(sock.fd, obuf, n4) != n4 {
                            return 15
                        }
                        // 5) close 回声(同码)
                        var f5 = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                        if f5.rc != 0 || f5.opcode != ws_op_close() || f5.produced != 2 {
                            return 16
                        }
                        let n5 = ws_frame_encode(obuf, 0, 1024, ws_op_close(), 1, asm, 0, f5.produced, 0, 0)
                        if client_write(sock.fd, obuf, n5) != n5 {
                            return 17
                        }
                    } else {
                        if served == 1 {
                            // ---- session B:未掩码客户端帧 → 协议错 → close 1002 ----
                            var fb = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                            if fb.rc == 0 || fb.err != 5 {
                                return 18
                            }
                            var cp2: I64[2] = [0, 0]
                            ws_close_payload(ws_close_protocol_error(), cp2)
                            let nb = ws_frame_encode(obuf, 0, 1024, ws_op_close(), 1, cp2, 0, 2, 0, 0)
                            if client_write(sock.fd, obuf, nb) != nb {
                                return 19
                            }
                        } else {
                            if served == 2 {
                                // ---- session C:close 携非上线码(1005)→ 不回声,close 1002 ----
                                var fc = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                                if fc.rc != 0 || fc.opcode != ws_op_close() || fc.produced != 2 {
                                    return 21
                                }
                                let ccode = asm[0] * 256 + asm[1]
                                if ws_close_code_ok(ccode) == 1 {
                                    return 22
                                }
                                var cp3: I64[2] = [0, 0]
                                ws_close_payload(ws_close_protocol_error(), cp3)
                                let nc = ws_frame_encode(obuf, 0, 1024, ws_op_close(), 1, cp3, 0, 2, 0, 0)
                                if client_write(sock.fd, obuf, nc) != nc {
                                    return 23
                                }
                            } else {
                                // ---- session D:分片文本重组完成含非法 UTF-8 → close 1007 ----
                                var fd0 = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, 0, 1024, bn_s, bpos_s, bmsg_s)
                                if fd0.rc != 0 || fd0.opcode != ws_op_text() || fd0.fin != 0 {
                                    return 24
                                }
                                var dlen = fd0.produced
                                var dopen = 1
                                var dguard: I64 = 0
                                while dopen == 1 && dguard < 16 {
                                    dguard += 1
                                    var dc = fx_ws_read_frame(sock.fd, buf2, 1024, scr2, 1, asm, dlen, 1024, bn_s, bpos_s, bmsg_s)
                                    if dc.rc != 0 || dc.opcode != 0 {
                                        return 25
                                    }
                                    dlen = dlen + dc.produced
                                    if dc.fin == 1 {
                                        dopen = 0
                                    }
                                }
                                // 重组完成 → UTF-8 校验(登记:分片中段非法字节延迟到完成才报)
                                if ws_utf8_valid(asm, 0, dlen) == 1 {
                                    return 26
                                }
                                var cp4: I64[2] = [0, 0]
                                ws_close_payload(1007, cp4)
                                let nd = ws_frame_encode(obuf, 0, 1024, ws_op_close(), 1, cp4, 0, 2, 0, 0)
                                if client_write(sock.fd, obuf, nd) != nd {
                                    return 27
                                }
                            }
                        }
                    }
                    served += 1
                }
            }
            return 0
