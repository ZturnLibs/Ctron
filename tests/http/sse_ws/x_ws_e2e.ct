// x_ws_e2e —— P4-C WebSocket 行为面(emit 专臂;self-hosted loopback;双 RT 由 run.sh)
// 服务端 = sc.spawn 协程(闭包内无 assert/panic,一律显式 return 码):
//   conn A  upgrade 握手(ws_upgrade_ok lane 面校验 + ws_accept_key_lane 计算
//           Sec-WebSocket-Accept)→ 文本回声 / ping→pong / 分片重组回声 /
//           binary 回声 / close 回声(同码);
//   conn B  upgrade 后收【未掩码】客户端帧 → 协议错 → close 1002(RFC 6455
//           §5.1 服务端 MUST 收掩码帧)。
// 客户端 = 主面:101 直通(client_request)+ Accept 头黄金向量互证 + 掩码帧
// (rng 种子键 —— RFC 仅要求"不可预测",v1 登记限制)+ 帧面断言。
// CI 纪律:仅回环、:0、零外联。
use std.http.client.{ http_net, client_listen, client_sockname, client_accept, client_request, client_read_t, client_write, client_write_str, client_close, HttpSock }
use std.http.ws.{ ws_upgrade_ok, ws_accept_key, ws_accept_key_lane, ws_frame_encode, ws_frame_head, ws_step, ws_st_new, ws_close_payload, ws_close_protocol_error, ws_close_code_ok, ws_utf8_valid, ws_op_text, ws_op_binary, ws_op_ping, ws_op_pong, ws_op_close, wr_rc, wr_err, wr_consumed, wr_produced, wr_fin, wr_opcode }
use std.rand.{ rng_fresh, rng_next }

fn fx_fill(buf: &I64[], s: Str) -> I64 {
    var i: I32 = 0
    while i < s.len {
        buf[i] = byte_at(s, i).as[I64]()
        i += 1
    }
    return s.len.as[I64]()
}

fn fx_eq_bytes(buf: &I64[], off: I64, want: Str) -> I64 {
    var i: I32 = 0
    while i < want.len {
        if buf[off + i.as[I64]()] != byte_at(want, i).as[I64]() {
            return 0
        }
        i += 1
    }
    return 1
}

struct SrvHead {
    var rc: I64
    var n: I64
    var ms: I64
    var ml: I64
    var ts: I64
    var tl: I64
    var clen: I64
    var hend: I64
}

fn fx_srv_read(fd: I64, buf: &I64[], cap: I64, scr: &I64[]) -> SrvHead {
    var out = SrvHead { rc: -1, n: 0, ms: 0, ml: 0, ts: 0, tl: 0, clen: 0, hend: 0 }
    var n: I64 = 0
    var need = 1
    var guard: I64 = 0
    while need == 1 && guard < 64 {
        guard += 1
        let h = http_parse_head(buf, n, http_limits_default())
        if http_rc(h) == 1 {
            need = 0
            out.rc = 0
            out.ms = http_method_start(h)
            out.ml = http_method_len(h)
            out.ts = http_target_start(h)
            out.tl = http_target_len(h)
            out.clen = http_clen(h)
            out.hend = http_head_end(h)
            out.n = n
        } else {
            if http_rc(h) == -1 {
                return out
            }
            let r = client_read_t(fd, scr, 512, 5000)
            if r <= 0 {
                return out
            }
            var i: I64 = 0
            while i < r {
                if n + i < cap {
                    buf[n + i] = scr[i]
                }
                i += 1
            }
            n = n + r
        }
    }
    return out
}

// upgrade 头三件(upgrade/connection/key)切片提取
struct WsHeadSrv {
    var rc: I64
    var us: I64
    var ul: I64
    var cs: I64
    var cl: I64
    var ks: I64
    var kl: I64
    var vs2: I64
    var vl2: I64
}

fn fx_ws_head(buf: &I64[], sr: SrvHead) -> WsHeadSrv {
    var out = WsHeadSrv { rc: -1, us: 0, ul: 0, cs: 0, cl: 0, ks: 0, kl: 0, vs2: 0, vl2: 0 }
    let h = http_parse_head(buf, sr.n, http_limits_default())
    let uv = http_header_value(buf, h, "upgrade")
    let cv = http_header_value(buf, h, "connection")
    let kv = http_header_value(buf, h, "sec-websocket-key")
    let vv = http_header_value(buf, h, "sec-websocket-version")
    if sl_rc(uv) == 0 && sl_rc(cv) == 0 && sl_rc(kv) == 0 && sl_rc(vv) == 0 {
        out.rc = 0
        out.us = sl_vs(uv)
        out.ul = sl_vl(uv)
        out.cs = sl_vs(cv)
        out.cl = sl_vl(cv)
        out.ks = sl_vs(kv)
        out.kl = sl_vl(kv)
        out.vs2 = sl_vs(vv)
        out.vl2 = sl_vl(vv)
    }
    return out
}

// 读一完整帧(增量;expect 注入方向性;载荷落 dst[dfill..])
struct FxFrame {
    var rc: I64
    var err: I64
    var opcode: I64
    var fin: I64
    var produced: I64
}

fn fx_ws_read_frame(fd: I64, buf: &I64[], cap: I64, scr: &I64[], expect: I64, dst: &I64[], dfill: I64, dcap: I64, bn: Box[Box64], bpos: Box[Box64], bmsg: Box[Box64]) -> FxFrame {
    var out = FxFrame { rc: -1, err: 0, opcode: -1, fin: 0, produced: 0 }
    // 消息态(frag)经 bmsg 胞跨调用携带 —— 分片序列校验需要跨帧记忆
    var wst = WsSt { phase: 0, fin: 0, opcode: 0, masked: 0, expect: expect, frag: bmsg.v, remain: 0, plen: 0, mk: 0 }
    var n = bn.v
    var pos = bpos.v
    var guard: I64 = 0
    var done = 0
    while done == 0 && guard < 10000 {
        guard += 1
        let r = ws_step(buf, n, pos, wst, dst, dfill + out.produced, dcap)
        pos = pos + wr_consumed(r)
        out.produced = out.produced + wr_produced(r)
        let rc = wr_rc(r)
        if rc == 1 {
            out.rc = 0
            out.err = 0
            out.opcode = wr_opcode(r)
            out.fin = wr_fin(r)
            done = 1
        } else {
            if rc == -1 {
                out.rc = -1
                out.err = wr_err(r)
                done = 1
            } else {
                if rc == 2 {
                    out.rc = -2
                    done = 1
                } else {
                    let rd = client_read_t(fd, scr, 512, 5000)
                    if rd <= 0 {
                        done = 1
                    } else {
                        var i: I64 = 0
                        while i < rd {
                            if n + i < cap {
                                buf[n + i] = scr[i]
                            }
                            i += 1
                        }
                        n = n + rd
                    }
                }
            }
        }
        wst = wr_st(r)
        bmsg.v = wst_frag(wst)
    }
    // 余量压实到缓冲头(帧界 = 消费位;粘包面)
    var k = pos
    var j: I64 = 0
    while k < n {
        buf[j] = buf[k]
        j += 1
        k += 1
    }
    bn.v = n - pos
    bpos.v = 0
    return out
}

