    let s = sse_event_str("add", "l1\nl2", "42", "") + sse_event_str("", "tick", "42", "") + sse_event_str("", "bye", "", "")
    let n = sf_fill(buf, s)
    var names: I64[8] = [0, 0, 0, 0, 0, 0, 0, 0]
    var datas: Str[8] = ["", "", "", "", "", "", "", ""]
    var cnt: I64[1] = [0]
    let pos = sf_drain(buf, n, names, datas, cnt)
    assert(cnt[0] == 3)
    assert(pos == n)
    assert_eq(datas[0], "add|l1\nl2|42")
    assert_eq(datas[1], "message|tick|42")
    assert_eq(datas[2], "message|bye|")
    // 状态复位:data 累积不跨事件
    assert(sst_data(sse_st_new()) == "")
}
