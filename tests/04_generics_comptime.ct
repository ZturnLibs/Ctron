// 04_generics_comptime.ct —— 单态化泛型、comptime 常量、定长数组(§6.3/§6.4,钉子 1)
// 语义承诺:泛型 [] 记法;comptime 函数在编译期执行,const 初始化即 comptime

fn swap[T](pair: (T, T)) -> (T, T) {
    let (a, b) = pair
    return (b, a)
}

comptime fn fib(n: I32) -> I32 {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

const FIB10: I32 = fib(10)                    // const 初始化在编译期求值(CVM,受预算约束)

test "generic monomorphization" {
    let p = swap((1, 2))
    assert_eq(p.0, 2)
    let q = swap(("a", "b"))
    assert_eq(q.1, "a")
}

test "comptime const evaluation" {
    assert_eq(FIB10, 55)
}

test "fixed arrays and slices" {
    let a: I32[3] = [1, 2, 3]
    assert_eq(a[0], 1)
    assert_eq(a.len, 3)
    let xs: I32[] = [1, 2, 3, 4]              // 定长数组隐式退化为切片
    var acc: I32 = 0
    for x in xs { acc += x }
    assert_eq(acc, 10)
}
