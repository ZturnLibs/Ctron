// 04f_infer.ct —— v0.7 修订三:调用点类型推断(Go 式仅实参;省略 TypeArgs)
// 共享版 = 裸型参位子集;结构化(List[V])形态见 compiler-rust/tests/fixtures/04f_infer.ct

fn identity[V](x: V) -> V {
    return x
}

test "infer from argument" {
    let a = identity(42)
    assert_eq(a, 42)
    let s = identity("hi")
    assert_eq(s, "hi")
}

test "explicit typeargs still work" {
    let b = identity[I32](5)
    assert_eq(b, 5)
}

test "literal default drives inference" {
    let f = identity(2.5)
    assert_eq(f, 2.5)
}
