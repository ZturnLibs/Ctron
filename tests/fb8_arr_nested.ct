// fb8_arr_nested.ct —— 嵌套 T[N][M] 值面(注解/字面/传参/链式下标)
fn sum(m: I32[2][2]) -> I32 {
    var s: I32 = 0
    var i: I32 = 0
    while i < 2 {
        s += m[i][0] + m[i][1]
        i += 1
    }
    return s
}

fn main() -> I32 {
    var m: I32[2][2] = [[1, 2], [3, 4]]
    assert_eq(sum(m), 10)
    assert_eq(m[1][0], 3)
    return 0
}

test "nested array face" {
    var m: I32[2][2] = [[1, 2], [3, 4]]
    assert_eq(m[0][1], 2)
}
