// 探针实证:空产物=静默通过不可用;DBG 残留产物=interp SIGSEGV——陷阱是 v1 唯一合规形态。

@derive(Json)
struct WithF {
    let v: F64
}

@derive(Json)
struct WithM {
    let m: Map[Str, I32]
}

fn main() -> I32 {
    return 0
}

test "anchor carries runnable block" {
    assert(true)
}
