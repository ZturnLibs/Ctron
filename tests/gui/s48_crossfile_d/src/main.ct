// tests/gui/s48_crossfile_d —— SL-8c-4④ P2:跨文件 view 导入
// 被用模块 todo.ct 居视图+业务,主文件 use 请求后 desugar 端到端。
// 合成 fn 直驱(与 s41 同契约)+键入/添加/删末/空态翻转全交互。
use todo.{Model, make, input, add_todo, remove_last}
use gui.{test, d_frame, d_expect_text, d_expect_absent}

fn headless_suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[Model](make())
    var rc: I32 = test(src, 320, 640,
        |buf| __gui_bind_TodoApp(buf, m),
        |name| __gui_act_TodoApp(name, m),
        |k| { },
        |t, act, key| {
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "S48 CROSSFILE")
            d_expect_text(t, "nothing yet")
            // 键入持久化:on:input 名通道
            __gui_act_TodoApp("input:hello", m)
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "hello")
            // 添加
            __gui_act_TodoApp("add_todo", m)
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "hello")
            d_expect_absent(t, "nothing yet")
            // 第二项
            m.todos.push("world")
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "world")
            // 删末项
            __gui_act_TodoApp("remove_last", m)
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_absent(t, "world")
            d_expect_text(t, "hello")
        })
    return rc
}

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return headless_suite()
    }
    return run(TodoApp(m: make()))
}
