// tests/gui/s49_xfilecomp/comp.ct —— P2 跨文件组件:显示 prop+数据事件(Ⅱ)
// 组件体仅用自家 prop;mark 数据事件实参=事件局部数据(处理器仅数据形参,
// static/println 观察哨;模型变异经宿主自有事件,组件事件无根捕获)
pub fn badge_tag() -> Str {
    return "BADGE"
}

view Badge (t: Str, n: I32) {
  <vbox class="bdg">
    <label class="bl">{t}</label>
    <label class="bn">{n}</label>
    <button class="bb" on:click={mark(t)}>MARK</button>
  </vbox>
}
style bdg { direction: column h: 120 }
style bl { fg: "#22c55e" h: 30 }
style bn { fg: "#e5e5e5" h: 30 }
style bb { bg: "#2563eb" fg: "#ffffff" w: 90 h: 30 }
