fn make() -> M {
    return M { state: "", mainhits: 0 }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "main_btn" {
        m.mainhits = m.mainhits + 1
        m.state = "MAIN"
        return
    }
    if name == "b1_btn" {
        m.state = "B1"
        return
    }
    if name == "b2_btn" {
        m.state = "B2"
        return
    }
}

fn board1_src() -> Str {
    return "view B1 (m: M) \{\n  <vbox class=\"b1root\">\n    <button class=\"b1btn\" on:click=\{b1_btn(m)}>板一按钮</button>\n  </vbox>\n}\nstyle b1root \{ direction: column gap: 8 padding: 8 }\nstyle b1btn \{ direction: column w: 100 h: 28 bg: \"#2563eb\" fg: \"#ffffff\" }"
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 400, 400,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            // ⑤ 主树按钮基线(板未开时点击命中)
            d_frame(t, |buf| bind_all(buf, m))
            println("PRE-CLICK cmds=" + d_cmd_count().to_string())
            actc(d_click(t, "main_btn"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            if m.state != "MAIN" {
                panic("s91: state 不符 " + m.state)
            }
            // ① 开板:几何 (250,50) 160×120
            gui_board_open("检查器", board1_src(), 250, 50, 160, 120)
            d_board_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            d_board_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            // ② 板体按钮点击((250+8+50, 50+24+8+14)=(308,96)):走浮板树
            var nm1: Str = d_board_click(t, 308, 96)
            println("NM1=[" + nm1 + "] bhits=" + t.bhits.len.to_string() + " brects=" + t.brects.len.to_string())
            if nm1 != "b1_btn" {
                panic("s91: 板体命中不符 [" + nm1 + "]")
            }
            actc(nm1, List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            if m.state != "B1" {
                panic("s91: state 不符 " + m.state)
            }
            // ③ 关闭盒(右上 (250+160-10, 50+12)=(400,62)):关板
            var nm2: Str = d_board_click(t, 400, 62)
            if nm2 != "__close__" {
                panic("s91: 关闭盒未命中 [" + nm2 + "]")
            }
            d_board_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            // 板关后:坐标点击走主树(main_btn 在 (208,38)-(288,66))
            actc(d_click(t, "main_btn"), List[Str]())
            if m.state != "MAIN" {
                panic("s91: 关板后应走主树")
            }
            // ④ 重开+拖拽:drag_on (260,62) → drag_to (100,200) 落位
            gui_board_open("检查器", board1_src(), 250, 50, 160, 120)
            d_board_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_board_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            var nm4: Str = d_board_click(t, 260, 62)
            if nm4 != "__drag__" {
                panic("s84: 标题栏未命中 [" + nm4 + "]")
            }
            d_board_drag_to(t, 100, 200)
            d_board_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            // 拖后板体按钮新位 ((100+8+50, 200+24+8+14)=(158,246))
            println("POST-DRAG bhits=" + t.bhits.len.to_string() + " brects=" + t.brects.len.to_string())
            var nm5: Str = d_board_click(t, 158, 246)
            if nm5 != "b1_btn" {
                panic("s91: 拖后板体未命中 [" + nm5 + "]")
            }
            println("S91-WIN-GREEN")
        })
}

view Root (m: M) {
  <vbox class="root">
    <button class="mainbtn" on:click={main_btn(m)}>主按钮</button>
    <label class="state">{m.state}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style mainbtn { direction: column w: 80 h: 28 bg: "#22c55e" fg: "#0b0f19" }
style state { fg: "#22c55e" h: 22 }

fn main_btn(m: Box[M]) {
}

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
