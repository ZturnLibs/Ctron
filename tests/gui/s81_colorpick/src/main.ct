// tests/gui/s81_colorpick —— G 档 GUI-39:ColorPick(库 0.5)headless 验收
// 四径:canvas SV 渐变像素(d_draw+d_px_at 角/中点)/拖拽选点(d_drag→dragpx/py
// 带标 permille→SV 折算写回 cur+swatch bg 跟随)/色相条点击(cp_hue 行)/hex 输入
// 双向(组件内 bind 源名通道 "hex" 宿主包装应答+cp_hex 文本通道)。
// HSV→RGB 全 I32 算术(无位运算:打包/拆包走乘除)。
use gui_widgets.{gui_widgets_ver}
use gui_theme.{color_parse}
use gui.{test, d_frame, d_draw, d_px_n, d_px_at, d_drag, d_send_char,
         d_expect_text, ev_arg_s, gui_focus_req}

struct M {
    var hue: I32
    var svx: I32
    var svy: I32
    var cur: Str
    var hexin: Str
    var hues: List[Str]
    var state: Str
}

// —— ColorPick 事件头(实逻辑驻桩,窗口模式直调;headless 经 act 同源)——
fn cp_paint(m: Box[M]) {
    // SV 渐变:x=饱和度 0→1000,y 上=明度 1000 下=0;盒相对画点;
    // 4px 步进(像素槽容量 4096 帽,160x120 全画=19200 越帽)
    var py: I32 = 0
    while py < 120 {
        var px: I32 = 0
        while px < 160 {
            var s: I32 = px * 1000 / 159
            var v: I32 = 1000 - py * 1000 / 119
            var p: I32 = hsv_pack(m.hue, s, v)
            canvas_px(px, py, p / 65536, p / 256 - (p / 65536) * 256, p - (p / 65536) * 65536 - (p / 256 - (p / 65536) * 256) * 256)
            px += 4
        }
        py += 4
    }
    m.state = "PAINTED"
}
fn cp_drag(m: Box[M], px: Str, py: Str) {
    m.svx = untag(px)
    m.svy = untag(py)
    rebuild(m)
}
fn cp_hue(m: Box[M], row: I32) {
    m.hue = row * 30
    rebuild(m)
}
fn cp_hex(m: Box[M], text: Str) {
    m.hexin = text
    if text.len == 7 {
        if byte_at(text, 0) == 35 {
            m.cur = text
            m.state = "HEX"
        }
    }
}

