fn make() -> M {
    var vs = List[Str]()
    vs.push("40")
    vs.push("80")
    vs.push("120")
    var ps = List[Str]()
    ps.push("0")
    ps.push("500")
    ps.push("1000")
    ps.push("250")
    return M { vals: vs, pts: ps, state: "" }
}

// 宿主归一:raw→像素(raw*120/max;负值/零 max 钳 0——空安全)
fn bar_px(raw: I32, max: I32) -> I32 {
    if max <= 0 {
        return 0
    }
    if raw < 0 {
        return 0
    }
    return raw * 120 / max
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "lt_paint" {
        lt_paint(m)
        return
    }
    if name == "bc_paint" {
        bc_paint(m)
        return
    }
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 360, 420,
        |buf| __gui_bind_Root(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            // 0) 宿主钳位纯值
            if bar_px(10, 30) != 40 || bar_px(-5, 30) != 0 || bar_px(10, 0) != 0 {
                panic("s83: bar_px 钳位不符")
            }
            // ① 条几何(像素域):d_draw 三条 → 1440 点;各条首点 (x0, 120-h)
            d_frame(t, |buf| __gui_bind_Root(buf, m))
            println("CVCOUNT " + gui_canvas_count().to_string())
            var fired0: I32 = d_draw(t, |buf| __gui_bind_Root(buf, m), |nm, ar| act(nm, ar, m))
            if fired0 != 2 {
                panic("s83: 条绘制帧未触发 f=" + fired0.to_string())
            }
            // 双 canvas 同槽:条 1440 + 折线 50 = 1490(条先画)
            if d_px_n() != 1490 {
                panic("s83: 条点数不符 n=" + d_px_n().to_string())
            }
            // 条 0 首点 (8, 80);条 1 起 240 → (36, 40);条 2 起 720 → (64, 0)
            if d_px_at(0, 0) != 8 || d_px_at(0, 1) != 80 || d_px_at(0, 2) != 37 {
                panic("s83: 条0 不符")
            }
            if d_px_at(240, 0) != 36 || d_px_at(240, 1) != 40 {
                panic("s83: 条1 不符")
            }
            if d_px_at(720, 0) != 64 || d_px_at(720, 1) != 0 {
                panic("s83: 条2 不符")
            }
            // ② 折线像素:d_draw 触发,50 点,首/中/末三点插值断言
            var fired: I32 = d_draw(t, |buf| __gui_bind_Root(buf, m), |nm, ar| act(nm, ar, m))
            if fired != 2 {
                panic("s83: 绘制帧未触发 f=" + fired.to_string())
            }
            if d_px_n() != 1490 {
                panic("s83: 点数不符 n=" + d_px_n().to_string())
            }
            // 首点=条 0 (0, 80)(槽序:条先画);折线首点在 1440
            if d_px_at(0, 0) != 8 || d_px_at(0, 1) != 80 || d_px_at(0, 2) != 37 {
                panic("s83: 首点不符")
            }
            if d_px_at(1440, 0) != 0 || d_px_at(1440, 1) != 80 || d_px_at(1440, 2) != 34 {
                panic("s83: 折线首点不符")
            }
            // x=100(索引 1440+25):f=300,seg=1,frac=500 → y‰=750 → py=80-60=20
            if d_px_at(1465, 0) != 100 || d_px_at(1465, 1) != 20 || d_px_at(1465, 4) != 94 {
                panic("s83: 中点不符")
            }
            // 末点 x=196(索引 1489):seg=2 frac=940 → y‰=1000-750*940/1000=295 → py=80-23=57
            if d_px_at(1489, 0) != 196 || d_px_at(1489, 1) != 57 {
                panic("s83: 末点不符")
            }
            // ③ 边界:空 vals → 0 点不崩
            m.vals = List[Str]()
            d_draw(t, |buf| __gui_bind_Root(buf, m), |nm, ar| act(nm, ar, m))
            if d_px_n() != 50 {
                panic("s83: 空数据仍有条 n=" + d_px_n().to_string())
            }
            // ④ 单值:一条 h=60 → 30 行 ×12 = 360 点,首点 (8, 60)
            var one = List[Str]()
            one.push("60")
            m.vals = one
            d_draw(t, |buf| __gui_bind_Root(buf, m), |nm, ar| act(nm, ar, m))
            if d_px_n() != 410 {
                panic("s83: 单值点数不符 n=" + d_px_n().to_string())
            }
            if d_px_at(0, 0) != 8 || d_px_at(0, 1) != 60 {
                panic("s83: 单值首点不符")
            }
            println("S83-CHART-GREEN " + gui_widgets_ver())
        })
}

view Root (m: M) {
  <vbox class="root">
    <BarChart vals: {m.vals}/>
    <LineChart pts: {m.pts}/>
    <label class="state">{m.state}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style state { fg: "#22c55e" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
