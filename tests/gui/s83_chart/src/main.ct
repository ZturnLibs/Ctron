// tests/gui/s83_chart —— G 档 GUI-41:BarChart/LineChart(库 0.6)headless 验收
// 三径:①条几何(条高像素串 each 值驱动 h;x 步进=条宽+gap;空/单值/负钳边界,
// 钳位在宿主);②折线像素(d_draw→lt_paint 盒相对画点,千分比 y 线性插值,
// 4px 步进 4096 帽);③渲染面值断言全显式十六进制 bg(default 令牌折叠空在册)。
// 归一在宿主(纯 prop 契约):raw*120/max 钳 ≥0;轴/刻度=宿主 label 组合(v1)。
use gui_widgets.{gui_widgets_ver}
use gui.{test, d_frame, d_draw, d_px_n, d_px_at, d_cmd_count, d_cmd_type,
         d_cmd_x100, d_cmd_w100, d_cmd_h100, gs2i, gui_canvas_count}

struct M {
    var vals: List[Str]
    var pts: List[Str]
    var state: Str
}

// —— 库全事件头桩(LineChart 实逻辑驻桩,窗口模式直调;headless 经 act 同源)——
fn lt_paint(m: Box[M]) {
    // 折线:pts=千分比 y;canvas 200x80;x 4px 步进(像素槽 4096 帽),
    // 段内线性插值;色 #22c55e 显式
    var n: I32 = m.pts.len
    if n < 2 {
        return
    }
    var x: I32 = 0
    while x < 200 {
        var f: I32 = x * (n - 1)
        var seg: I32 = f / 200
        var frac: I32 = (f - seg * 200) * 1000 / 200
        var y0: I32 = gs2i(m.pts[seg])
        var y1: I32 = 0
        if seg + 1 < n {
            y1 = gs2i(m.pts[seg + 1])
        }
        var yp: I32 = y0 + (y1 - y0) * frac / 1000
        var py: I32 = 80 - yp * 80 / 1000
        canvas_px(x, py, 34, 197, 94)
        x += 4
    }
    m.state = "PLOTTED"
}
fn bc_paint(m: Box[M]) {
    // 条:i∈[0,n) x0=8+i*28,宽 24,自底向上;2px 步进(帽 4096 在册);
    // 3 条 40/80/120px → 240+480+720=1440 点
    var i: I32 = 0
    while i < m.vals.len {
        var h: I32 = gs2i(m.vals[i])
        var x0: I32 = 8 + i * 28
        var yy: I32 = 120 - h
        while yy < 120 {
            var xx: I32 = x0
            while xx < x0 + 24 {
                canvas_px(xx, yy, 37, 99, 235)
                xx += 2
            }
            yy += 2
        }
        i += 1
    }
}

