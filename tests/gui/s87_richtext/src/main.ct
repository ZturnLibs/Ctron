fn make() -> M {
    return M { state: "" }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "noop" {
        return
    }
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 360, 200,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            d_frame(t, |buf| bind_all(buf, m))
            // 段扫描:Bold(bold 段 fg=基色 TEXT)/plain/code(teal 78,201,176)
            var dn: I32 = d_cmd_count()
            var di: I32 = 0
            var nbold: I32 = 0
            var ncode: I32 = 0
            var nplain: I32 = 0
            while di < dn {
                if d_cmd_type(di) == 1 {
                    var tl: I32 = d_cmd_text_len(di)
                    var bi: I32 = 0
                    var tx: Str = ""
                    while bi < tl {
                        tx = tx + char_str(d_cmd_text_byte(di, bi))
                        bi += 1
                    }
                    if tx == "Bold" {
                        nbold += 1
                    }
                    if tx == " plain " {
                        nplain += 1
                    }
                    if tx == "code" {
                        ncode += 1
                        if d_cmd_text_fg_r(di) != 78 || d_cmd_text_fg_g(di) != 201 || d_cmd_text_fg_b(di) != 176 {
                            panic("s87: code 段色不符")
                        }
                    }
                }
                di += 1
            }
            if nbold != 1 || nplain != 1 || ncode != 1 {
                panic("s87: 分段不符 b=" + nbold.to_string() + " p=" + nplain.to_string() + " c=" + ncode.to_string())
            }
            println("S87-RICHTEXT-GREEN " + gui_widgets_ver())
        })
}

view Root (m: M) {
  <vbox class="root">
    <label class="rich">**Bold** plain @@code@@</label>
    <label class="state">{m.state}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style rich { direction: row rich: 1 }
style state { fg: "#22c55e" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
