// tests/gui/s31_state —— 波次一 T1/T3/T6:颜色读回 + 令牌折叠 + 交互态(hover/active/disabled)
// d_hover/d_active 注入→bg 折叠值变;disabled={} 真值→disabled-bg/fg 灰化(§2.1)
use gui.{test, d_frame, d_click, d_cmd_count, d_cmd_type, d_cmd_bg_r, d_cmd_bg_g, d_cmd_bg_b, d_hover, d_active, theme_apply, theme_default}

view P {
  <vbox class="root">
    <button class="sw" on:click={noop}>S</button>
    <button class="tk" on:click={noop}>T</button>
    <button class="dx" disabled={dflag} on:click={noop}>D</button>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style sw { bg: "#aa33cc" hover_bg: "#bb44dd" active_bg: "#9922bb" w: 60 h: 30 }
style tk { bg: ACCENT w: 40 h: 20 }
style dx { bg: "#aa33cc" disabled_bg: "#666666" disabled_fg: "#555555" w: 60 h: 30 }

fn noop() {
}

fn bind_all(buf: List[Str]) {
    if buf[0] == "dflag" {
        buf.push("b:1")
    }
}

fn scan_bg(r: I32, g: I32, b: I32) -> I32 {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 2 {
            if d_cmd_bg_r(i) == r {
                if d_cmd_bg_g(i) == g {
                    if d_cmd_bg_b(i) == b {
                        return 1
                    }
                }
            }
        }
        i += 1
    }
    return 0
}

fn main() -> I32 {
    var src: Str = ctron_embedded()
    theme_apply(theme_default())
    var rc: I32 = test(src, 320, 240,
        |buf| bind_all(buf),
        |name| noop(),
        |k| k,
        |t, a, k2| {
            d_frame(t, |buf| bind_all(buf))
            if scan_bg(170, 51, 204) != 1 {
                panic("s31: 基态 #aa33cc 未现")
            }
            if scan_bg(37, 99, 235) != 1 {
                panic("s31: ACCENT 令牌未折叠 #2563eb")
            }
            if scan_bg(102, 102, 102) != 1 {
                panic("s31: disabled 态未灰化至 #666666")
            }
            d_hover(t, "noop")
            d_frame(t, |buf| bind_all(buf))
            if scan_bg(187, 68, 221) != 1 {
                panic("s31: hover_bg #bb44dd 未折叠")
            }
            d_active(t, 1)
            d_frame(t, |buf| bind_all(buf))
            if scan_bg(153, 34, 187) != 1 {
                panic("s31: active_bg #9922bb 未折叠")
            }
            d_active(t, 0)
            d_hover(t, "")
            d_frame(t, |buf| bind_all(buf))
            if scan_bg(187, 68, 221) == 1 {
                panic("s31: hover 清除后 hover_bg 残留")
            }
            if scan_bg(170, 51, 204) != 1 {
                panic("s31: 清除后基态未复原")
            }
            println("S31-STATE-GREEN")
        })
    return rc
}
