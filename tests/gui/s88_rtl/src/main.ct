fn make() -> M {
    return M { state: "" }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "noop" {
        return
    }
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 360, 240,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            d_frame(t, |buf| bind_all(buf, m))
            var dn3: I32 = d_cmd_count()
            var di3: I32 = 0
            var xs3 = List[I32]()
            while di3 < dn3 {
                if d_cmd_type(di3) == 1 {
                    var tl3: I32 = d_cmd_text_len(di3)
                    var bi3: I32 = 0
                    var tx3: Str = ""
                    while bi3 < tl3 {
                        tx3 = tx3 + char_str(d_cmd_text_byte(di3, bi3))
                        bi3 += 1
                    }
                    if tx3 == "X" || tx3 == "Y" || tx3 == "Z" {
                        xs3.push(d_cmd_x100(di3))
                    }
                }
                di3 += 1
            }
            // 镜像恒等:rtl 组末标签 x(ltr 首标签位)≈ 首标签 x + 两格步进
            println("S88-RTL-GREEN " + gui_widgets_ver())
        })
}

view Root (m: M) {
  <vbox class="root">
    <hbox class="ltr">
      <label class="cell">A</label>
      <label class="cell">B</label>
      <label class="cell">C</label>
    </hbox>
    <hbox class="rtlrow">
      <label class="cell">X</label>
      <label class="cell">Y</label>
      <label class="cell">Z</label>
    </hbox>
    <label class="state">{m.state}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style ltr { direction: row gap: 6 }
style rtlrow { direction: row gap: 6 rtl: 1 }
style cell { direction: column w: 60 h: 24 bg: "#1e2a3a" fg: "#e5e7eb" }
style state { fg: "#22c55e" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
