// tests/gui/s33_run_d —— SL-8c-4②:gui.run 装配合成域包夹具(Todo 照抄面前身)
// 验收三层:
// 1) 合成面:run(TodoApp(m: make())) 经编译器 desugar 改写+拼写 __gui_bind/
//    __gui_act/__gui_run 三 fn(check 面全量语义核对=合成正确性活证)
// 2) 直驱面:headless 下 test() 直接驱动合成 fn(bind 双路径带型应答/act 头
//    分发),d_click 按头按压断言模型变更
// 3) 真窗面:CTRON_GUI_RUN=1 时走合成的 __gui_run(默认锚 run_d),CI 不开窗
// 业务契约:业务 fn 取 Box[Model](可变语义);make() 返回值由合成器装箱。
// 注:headless 直驱面的 __p_m 形参位以 Box[Model] 恒等装箱传入(合成 fn 契约)。
use gui.{test, d_click, d_frame, d_expect_text, char_str}

struct Model {
    var draft: Str
}

view TodoApp(m: Model) {
  <vbox class="root">
    <label class="title">CTRON RUN</label>
    <input bind={m.draft} class="fld"/>
    <button class="btn" on:click={add(m)}>add</button>
    <when cond={m.draft.len > 0}>
      <label class="echo">{m.draft}</label>
    </when>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style title { fg: "#ffffff" size: 24 h: 40 }
style fld { bg: "#2a2a2e" fg: "#ffffff" h: 36 }
style btn { bg: "#2563eb" fg: "#ffffff" w: 120 h: 44 }
style echo { fg: "#22c55e" h: 30 }

fn make() -> Model {
    return Model { draft: "hi" }
}

fn add(mm: Box[Model]) {
    mm.draft = mm.draft + "!"
}

// headless 自动验收:合成 fn 直驱(与生成装配同契约)
fn headless_suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[Model](make())
    var rc: I32 = test(src, 320, 480,
        |buf| __gui_bind_TodoApp(buf, m),
        |name| __gui_act_TodoApp(name, m),
        |k| { },
        |t, act, key| {
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "CTRON RUN")
            d_expect_text(t, "hi")
            act(d_click(t, "add"))
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "hi!")
        })
    return rc
}

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return headless_suite()
    }
    return run(TodoApp(m: make()))
}
