// 手势桩(本件头;窗口模式直调)
fn card_lp(m: Box[M]) {
}
fn card_sw(m: Box[M]) {
}

fn make() -> M {
    return M { state: "" }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "card_lp" {
        m.state = "LP@" + ev_arg_s(args, 0)
        return
    }
    if name == "card_sw" {
        m.state = "SW" + ev_arg_s(args, 0)
        return
    }
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 360, 240,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            // ① longpress:先入注入域(tick 1000)→ 压 (100,60) → tick 1800(距压 800>600)
            d_tick(t, 1000)
            d_touch_press(t, 100, 60, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_tick(t, 1800)
            d_frame(t, |buf| bind_all(buf, m))
            d_touch_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            if m.state != "LP@100" {
                panic("s89: longpress 不符 " + m.state)
            }
            // 释放(清跟踪态)
            d_touch_release(t, 100, 60, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            // ② swipe 左:压 (150,60) → 释放 (60,62) → SW L
            d_touch_press(t, 150, 60, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_touch_release(t, 60, 62, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            d_touch_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            if m.state != "SWL" {
                panic("s89: swipe 左不符 " + m.state)
            }
            // ③ swipe 右:压 (60,60) → 释放 (170,58) → SW R
            d_touch_press(t, 60, 60, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_touch_release(t, 170, 58, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            d_touch_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            if m.state != "SWR" {
                panic("s89: swipe 右不符 " + m.state)
            }
            // ④ 干扰:压 (30,30)(卡外)tick 700 帧 → 无 fire(state 保持 SWR)
            d_touch_press(t, 30, 30, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_tick(t, 700)
            d_touch_frame(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_touch_release(t, 30, 30, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            if m.state != "SWR" {
                panic("s89: 卡外长按误 fire")
            }
            println("S89-TOUCH-GREEN")
        })
}

view Root (m: M) {
  <vbox class="root">
    <button class="card" on:longpress={card_lp(m)} on:swipe={card_sw(m)}>card</button>
    <label class="state">{m.state}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style card { direction: column w: 200 h: 60 bg: "#1e2a3a" fg: "#e5e7eb" }
style state { fg: "#22c55e" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
