fn make() -> M {
    return M { acc: "", n: 0 }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.acc" {
        buf.push(m.acc)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "on_async" {
        m.acc = m.acc + ev_arg_s(args, 0)
        m.n = m.n + 1
        return
    }
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    // 注册 + 两件投递。跨线程半程=spawn 语句发射(对端在飞断点,smoke
    // conc_parallel 同源在册)——v1 同线程 post 证全管线(队列/FIFO/drain),
    // 对端 spawn 落地后字面替换 spawn { gui_async_post(x) } 即得并发实证
    gui_async_on("on_async")
    gui_async_post("a")
    gui_async_post("b")
    return test(src, 320, 240,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            // 帧循环 drain:FIFO 到齐 "ab"(任务并发,到达帧不定,有界等待)
            var i: I32 = 0
            while i < 200 {
                d_async_drain(t, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
                d_frame(t, |buf| bind_all(buf, m))
                if m.n == 2 {
                    i = 100000
                }
                i += 1
            }
            d_frame(t, |buf| bind_all(buf, m))
            if m.n != 2 {
                panic("s86: 到达件数不符 n=" + m.n.to_string())
            }
            d_expect_text(t, "ab")
            println("S86-ASYNC-GREEN " + gui_widgets_ver())
        })
}

view Root (m: M) {
  <vbox class="root">
    <label class="acc">{m.acc}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style acc { fg: "#22c55e" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
