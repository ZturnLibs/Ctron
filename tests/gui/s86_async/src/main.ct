// tests/gui/s86_async —— G 档 GUI-44:异步任务→UI(C 队列投递+帧 drain)headless 验收
// spawn 任务 gui_async_post(Str) → C 互斥队列 → d_async_drain 帧驱动 FIFO fire
// (action=gui_async_on 注册名);UI 线程唯一触 UI(Send 纪律 E3010 守卫在语言面)。
use gui_widgets.{gui_widgets_ver}
use gui.{test, d_frame, d_async_drain, d_expect_text, gui_async_post, gui_async_on, ev_arg_s}

struct M {
    var acc: Str
    var n: I32
}

