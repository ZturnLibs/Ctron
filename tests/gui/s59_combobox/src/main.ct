// tests/gui/s59_combobox —— GUI-19 combobox 组件 headless 验收
// 四段:点输入框开下拉 → 输入字符过滤 → 点选填入并收起 → 全量重开
use gui.{test, d_frame, d_expect_text, d_expect_absent, d_click_inst, d_focus, d_send_char, ev_arg_i, Driver}

struct M {
    var cbopen: Bool
    var filter: Str
    var cbtext: Str
    var cbval: Str
}

fn cb_close() {
}
fn cbf(text: Str) {
}
fn cb_pick() {
}

// 过滤谓词(应用侧手写;GUI-13 落库后可换 contains 内建)
fn has_sub(s: Str, sub: Str) -> Bool {
    if sub.len == 0 {
        return true
    }
    var i: I32 = 0
    while i + sub.len <= s.len {
        var ok: Bool = true
        var j: I32 = 0
        while j < sub.len {
            if byte_at(s, i + j) != byte_at(sub, j) {
                ok = false
                j = sub.len
            }
            j += 1
        }
        if ok {
            return true
        }
        i += 1
    }
    return false
}

fn push_if(buf: List[Str], m: Box[M], item: Str) {
    if has_sub(item, m.filter) {
        buf.push(item)
    }
}


fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "cbtext" {
        buf.push(m.cbtext)
    }
    if buf[0] == "cbopen" {
        if m.cbopen {
            buf.push("b:1")
        } else {
            buf.push("b:0")
        }
    }
    if buf[0] == "each:cbopts" {
        push_if(buf, m, "Ctron")
        push_if(buf, m, "Rust")
        push_if(buf, m, "Go")
    }
    if buf[0] == "cbval" {
        buf.push(m.cbval)
    }
}

// 过滤后第 N 项(与 bind_all 同构的可见集)
fn filtered_pick(m: Box[M], row: I32) -> Str {
    var vis: List[Str] = List[Str]()
    if has_sub("Ctron", m.filter) {
        vis.push("Ctron")
    }
    if has_sub("Rust", m.filter) {
        vis.push("Rust")
    }
    if has_sub("Go", m.filter) {
        vis.push("Go")
    }
    if row < vis.len {
        return vis[row]
    }
    return ""
}

fn name_is_pick(name: Str) -> Bool {
    return name == "cb_pick" || (name.len > 8 && byte_at(name, 7) == 58 && byte_at(name, 0) == 99 && byte_at(name, 1) == 98 && byte_at(name, 2) == 95 && byte_at(name, 3) == 112 && byte_at(name, 4) == 105 && byte_at(name, 5) == 99 && byte_at(name, 6) == 107)
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "cb_close" {
        m.cbopen = false
        return
    }
    // on:input 名通道:"cbf:值"——输入即开(过滤+下拉同帧)
    if name.len >= 4 {
        if byte_at(name, 0) == 99 && byte_at(name, 1) == 98 && byte_at(name, 2) == 102 && byte_at(name, 3) == 58 {
            m.filter = byte_slice(name, 4, name.len)
            m.cbopen = true
            return
        }
    }
    if name_is_pick(name) {
        var ni: I32 = 0
        if name.len > 8 {
            var k: I32 = 8
            while k < name.len {
                ni = ni * 10 + (byte_at(name, k) - 48)
                k += 1
            }
        }
        var v: Str = filtered_pick(m, ni)
        if v != "" {
            m.cbval = v
            m.cbtext = v
            m.cbopen = false
            m.filter = ""
        }
    }
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var m = Box[M](M { cbopen: false, filter: "", cbtext: "", cbval: "" })
    var rc: I32 = test(src, 320, 300,
        |buf| bind_all(buf, m),
        |name, args| act(name, args, m),
        |k| { },
        |t, actc, k2| {
            // S1 初始:下拉收起
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_absent(t, "Ctron")
            // S2 输入即开:输入 "o" → 下拉开+过滤剩 Ctron/Go
            d_focus(t)
            d_send_char(t, 111, |buf| {
                if buf[0] == "cbtext" {
                    buf.push(m.cbtext)
                }
            }, |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "Ctron")
            d_expect_absent(t, "Rust")
            d_expect_text(t, "Go")
            // S3 点过滤后第 1 项(Go):填入并收起
            actc(d_click_inst(t, "cb_pick", 1), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "Go")
            d_expect_absent(t, "Ctron")
            d_expect_absent(t, "Rust")
            println("S59-COMBOBOX-GREEN")
        })
    return rc
}
