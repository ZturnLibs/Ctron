fn make() -> M {
    return M { state: "" }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "noop" {
        return
    }
}

// 子串扫描(dump 全文 contain 判;下标坑绕行——就地逐字节)
fn has_sub(s: Str, sub: Str) -> I32 {
    if sub.len == 0 {
        return 1
    }
    var i: I32 = 0
    while i + sub.len <= s.len {
        var j: I32 = 0
        var ok: I32 = 1
        while j < sub.len {
            if byte_at(s, i + j) != byte_at(sub, j) {
                ok = 0
            }
            j += 1
        }
        if ok == 1 {
            return 1
        }
        i += 1
    }
    return 0
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 320, 240,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            d_frame(t, |buf| bind_all(buf, m))
            var dump: Str = d_ax_dump(t)
            // 三 role 推导 + 文本载荷
            if has_sub(dump, "button button") != 1 {
                panic("s90: button role 缺")
            }
            if has_sub(dump, "textbox input") != 1 {
                panic("s90: textbox role 缺")
            }
            if has_sub(dump, "text label") != 1 {
                panic("s90: text role 缺")
            }
            if has_sub(dump, "'保存'") != 1 {
                panic("s90: 按钮文本缺")
            }
            if has_sub(dump, "'标题文字'") != 1 {
                panic("s90: 标签文本缺")
            }
            if has_sub(dump, "bind=m.state") != 1 {
                panic("s90: bind 路径缺")
            }
            println("S90-A11Y-GREEN")
        })
}

view Root (m: M) {
  <vbox class="root">
    <button class="b">保存</button>
    <input class="i" bind={m.state}/>
    <label class="l">标题文字</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style b { direction: column w: 90 h: 30 bg: "#2563eb" fg: "#ffffff" }
style i { direction: column w: 160 h: 30 bg: "#111827" fg: "#e5e7eb" }
style l { fg: "#e5e7eb" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
