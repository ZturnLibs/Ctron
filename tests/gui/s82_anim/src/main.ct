// tests/gui/s82_anim —— G 档 GUI-42:动画纯函数库(门面 re-export)headless 验收
// 两段:①纯值断言(ease 恒等/中点/回弹过冲与端点/lerp 双向/prog 钳位);
// ②d_tick 帧驱动(bind 每帧算 anim_out_cubic 经 prop 通道,值驱动 w 槽 + 回显
// label):0→138→210→240 关键帧精确 + 超时恒值钳位 + 渲染面 w100 几何随动。
use gui_widgets.{gui_widgets_ver}
use gui.{test, d_frame, d_tick, d_expect_text, d_cmd_count, d_cmd_type, d_cmd_w100,
         anim_prog, ease_linear, ease_out_cubic, ease_in_cubic, ease_in_out, ease_out_back,
         lerp_i, anim_i, anim_out_cubic, gui_now}

struct M {
    var t0: I32
    var aw: I32
    var state: Str
}

