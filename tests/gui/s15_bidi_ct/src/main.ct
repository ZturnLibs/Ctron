// tests/gui/s15_bidi_ct —— M3 地基:Ctron FFI 驱动 SheenBidi(s14 为 C 层冒烟;本夹具证 Ctron 侧可达)
// 口径:不透明句柄 I64 直通(shim 持引用);UBA 断言在 Ctron 侧——FFI 编组与算法结果一次验尽

#[trusted]
extern "c" fn sb_open(text: Str) -> I64

#[trusted]
extern "c" fn sb_paragraph(alg: I64, len: I32) -> I64

#[trusted]
extern "c" fn sb_line(para: I64) -> I64

#[trusted]
extern "c" fn sb_run_count(line: I64) -> I32

#[trusted]
extern "c" fn sb_run_offset(line: I64, i: I32) -> I32

#[trusted]
extern "c" fn sb_run_length(line: I64, i: I32) -> I32

#[trusted]
extern "c" fn sb_run_level(line: I64, i: I32) -> I32

#[trusted]
extern "c" fn sb_close(line: I64, para: I64, alg: I64) -> Void

fn main() -> I32 {
    // "Hi " + "سلام":LTR 基向下 UBA 切两段 run——拉丁段 level 0(offset 0,3 字节),
    // 阿拉伯段 level 1(offset 3,4 码点 × UTF-8 双字节 = 8 字节)
    var text: Str = "Hi سلام"
    var alg: I64 = sb_open(text)
    var para: I64 = sb_paragraph(alg, text.len)
    var line: I64 = sb_line(para)

    assert_eq(sb_run_count(line), 2)
    assert_eq(sb_run_offset(line, 0), 0)
    assert_eq(sb_run_length(line, 0), 3)
    assert_eq(sb_run_level(line, 0), 0)
    assert_eq(sb_run_offset(line, 1), 3)
    assert_eq(sb_run_length(line, 1), 8)
    assert_eq(sb_run_level(line, 1), 1)

    sb_close(line, para, alg)
    println("s15_bidi_ct: Ctron FFI 驱动 SheenBidi run 切分全绿")
    return 0
}
