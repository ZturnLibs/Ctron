// tests/gui/s5_golden —— GUI 泳道 S5:.ctml 运行时解析器(read_file 模式;计划 S5)
// 最小语法面:view + vbox/hbox + label/button + class 属性 + style 五属性
//   (direction/gap/padding/bg + 令牌引用 + 颜色串 #RRGGBB 校验);限深 1(子元素=文本叶子)。
// 验证:骨架 IR 文本 dump 黄金差分 + 同源数据驱动 Clay 布局做几何断言。
// 全部使用已验证发射能力:byte_at/byte_slice/.len/Str 比较+拼接/List 索引/Atomic 游标。

#[trusted]
extern "c" fn gui_clay_init(w: I32, h: I32) -> I32

#[trusted]
extern "c" fn gui_begin_layout(w: I32, h: I32) -> I32

#[trusted]
extern "c" fn gui_open() -> I32

#[trusted]
extern "c" fn gui_close() -> I32

#[trusted]
// 全 int 契约(d73afcc;bg 位打包)
extern "c" fn gui_cfg(dir: I32, gap: I32, padx: I32, pady: I32, ax: I32, ay: I32,
                      wmode: I32, wval: I32, hmode: I32, hval: I32, bg: I32) -> I32

#[trusted]
extern "c" fn gui_text(s: Str, size: I32, r: I32, g: I32, b: I32, a: I32) -> I32

#[trusted]
extern "c" fn gui_end_layout() -> I32

#[trusted]
extern "c" fn gui_cmd_count() -> I32

#[trusted]
extern "c" fn gui_cmd_type(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_x100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_y100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_w100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_text_len(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_bg_r(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_bg_g(i: I32) -> I32

// ==================== 迷你词法 ====================

fn ws(src: Str, cur: Atomic[I32]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        var b: I32 = byte_at(src, cur.load())
        if b == 32 {
            cur.store(cur.load() + 1)
        } else {
            if b == 10 {
                cur.store(cur.load() + 1)
            } else {
                if b == 13 {
                    cur.store(cur.load() + 1)
                } else {
                    if b == 9 {
                        cur.store(cur.load() + 1)
                    } else {
                        return 0
                    }
                }
            }
        }
    }
    return 0
}

fn word(src: Str, cur: Atomic[I32]) -> Str {
    ws(src, cur)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        var al: Bool = b >= 65 && b <= 90
        var low: Bool = b >= 97 && b <= 122
        var dg: Bool = b >= 48 && b <= 57
        if al {
            i += 1
        } else {
            if low {
                i += 1
            } else {
                if b == 95 {
                    i += 1
                } else {
                    if b == 45 {
                        i += 1
                    } else {
                        if dg {
                            i += 1
                        } else {
                            break
                        }
                    }
                }
            }
        }
    }
    cur.store(i)
    if i > start {
        return byte_slice(src, start, i)
    }
    panic("s5: 期待标识符 @byte " + cur.load().to_string() + " byte=" + byte_at(src, cur.load()).to_string())
    return ""
}

fn lit(src: Str, cur: Atomic[I32], c: I32) -> I32 {
    ws(src, cur)
    var b: I32 = byte_at(src, cur.load())
    if b != c {
        panic("s5: 期待字符,字节码 " + c.to_string())
    }
    cur.store(cur.load() + 1)
    return 0
}

fn str_lit(src: Str, cur: Atomic[I32]) -> Str {
    lit(src, cur, 34)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == 34 {
            break
        }
        i += 1
    }
    cur.store(i + 1)
    return byte_slice(src, start, i)
}

// 元素文本:到 '<' 为止,首尾去空白;游标停在 '<'
fn text_span(src: Str, cur: Atomic[I32]) -> Str {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == 60 {
            break
        }
        i += 1
    }
    var e: I32 = i
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    while e > start {
        var c1: I32 = byte_at(src, e - 1)
        if c1 == 32 {
            e -= 1
        } else {
            if c1 == 10 {
                e -= 1
            } else {
                if c1 == 9 {
                    e -= 1
                } else {
                    break
                }
            }
        }
    }
    cur.store(i)
    if e > start {
        return byte_slice(src, start, e)
    }
    return ""
}

// ==================== 颜色与令牌 ====================

fn chk(a: I32, b: I32, tag: Str) -> I32 {
    if a != b {
        panic("s5 assert " + tag + ": " + a.to_string() + " != " + b.to_string())
    }
    return 0
}

fn hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("s5: 非法十六进制")
    return 0
}

fn parse_color(v: Str) -> I32 {
    if byte_at(v, 0) == 35 {
        if v.len != 7 {
            panic("s5: 颜色须 #RRGGBB,得 " + v)
        }
        var r: I32 = hex1(byte_at(v, 1)) * 16 + hex1(byte_at(v, 2))
        var g: I32 = hex1(byte_at(v, 3)) * 16 + hex1(byte_at(v, 4))
        var b: I32 = hex1(byte_at(v, 5)) * 16 + hex1(byte_at(v, 6))
        return r * 65536 + g * 256 + b
    }
    if v == "ACCENT" {
        return 0xc83c3c
    }
    if v == "DANGER" {
        return 0xdc2626
    }
    if v == "BG" {
        return 0x181820
    }
    panic("s5: 未知令牌 " + v)
    return 0
}

fn s2i(s: Str) -> I32 {
    var v: I32 = 0
    var i: I32 = 0
    while i < s.len {
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    }
    return v
}

// ==================== 解析 ====================

// 属性表:仅 class;返回 class 值(无则 "")
fn attrs(src: Str, cur: Atomic[I32]) -> Str {
    var out: Str = ""
    while true {
        ws(src, cur)
        if byte_at(src, cur.load()) == 62 {
            break
        }
        var an: Str = word(src, cur)
        lit(src, cur, 61)
        var av: Str = str_lit(src, cur)
        if an == "class" {
            out = av
        }
    }
    return out
}

fn parse_leaf(src: Str, cur: Atomic[I32], tags: List[Str], cls: List[Str],
              texts: List[Str], leaf: List[I32], depth: List[I32]) -> I32 {
    lit(src, cur, 60)
    var tag: Str = word(src, cur)
    if tag != "label" {
        if tag != "button" {
            panic("s5: 子元素仅 label/button,得 " + tag)
        }
    }
    var c: Str = attrs(src, cur)
    lit(src, cur, 62)
    if byte_at(src, cur.load()) == 60 {
        if byte_at(src, cur.load() + 1) != 47 {
            panic("s5: 限深 1——子元素须为文本叶子")
        }
    }
    var t: Str = text_span(src, cur)
    lit(src, cur, 60)
    lit(src, cur, 47)
    var et: Str = word(src, cur)
    if et != tag {
        panic("s5: 闭合标签不匹配 " + et)
    }
    lit(src, cur, 62)
    println("  el " + tag + " cls=" + c + " text=" + t.len.to_string())
    tags.push(tag)
    cls.push(c)
    texts.push(t)
    leaf.push(1)
    depth.push(1)
    return 0
}

fn parse_view(src: Str, cur: Atomic[I32], tags: List[Str], cls: List[Str],
              texts: List[Str], leaf: List[I32], depth: List[I32]) -> I32 {
    var name: Str = word(src, cur)
    println("view " + name)
    ws(src, cur)
    lit(src, cur, 123)
    ws(src, cur)
    lit(src, cur, 60)
    var tag: Str = word(src, cur)
    if tag != "vbox" {
        if tag != "hbox" {
            panic("s5: 根容器仅 vbox/hbox,得 " + tag)
        }
    }
    var rootcls: Str = attrs(src, cur)
    lit(src, cur, 62)
    println("  root " + tag + " cls=" + rootcls)
    tags.push(tag)
    cls.push(rootcls)
    texts.push("")
    leaf.push(0)
    depth.push(0)
    while true {
        ws(src, cur)
        if byte_at(src, cur.load()) == 60 {
            if byte_at(src, cur.load() + 1) == 47 {
                break
            }
        }
        parse_leaf(src, cur, tags, cls, texts, leaf, depth)
    }
    lit(src, cur, 60)
    lit(src, cur, 47)
    var et: Str = word(src, cur)
    lit(src, cur, 62)
    ws(src, cur)
    lit(src, cur, 125)
    return 0
}

fn parse_style(src: Str, cur: Atomic[I32], sk: List[Str], sv: List[Str]) -> I32 {
    var name: Str = word(src, cur)
    var line: Str = "style " + name
    ws(src, cur)
    lit(src, cur, 123)
    while true {
        ws(src, cur)
        if byte_at(src, cur.load()) == 125 {
            break
        }
        var p: Str = word(src, cur)
        lit(src, cur, 58)
        ws(src, cur)
        var b: I32 = byte_at(src, cur.load())
        var v: Str = ""
        if b == 34 {
            v = str_lit(src, cur)
        } else {
            v = word(src, cur)
        }
        if p == "bg" {
            var packed: I32 = parse_color(v)
            if packed < 0 {
                panic("s5: 颜色解析失败")
            }
        }
        line = line + " " + p + "=" + v
        sk.push(name + "." + p)
        sv.push(v)
        ws(src, cur)
        if byte_at(src, cur.load()) == 59 {
            lit(src, cur, 59)
        }
    }
    lit(src, cur, 125)
    println(line)
    return 0
}

fn parse_all(src: Str, cur: Atomic[I32], tags: List[Str], cls: List[Str],
             texts: List[Str], leaf: List[I32], depth: List[I32],
             sk: List[Str], sv: List[Str]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        ws(src, cur)
        if cur.load() >= n {
            break
        }
        var w: Str = word(src, cur)
        if w == "view" {
            parse_view(src, cur, tags, cls, texts, leaf, depth)
        } else {
            if w == "style" {
                parse_style(src, cur, sk, sv)
            } else {
                panic("s5: 顶层仅 view/style,得 " + w)
            }
        }
    }
    return 0
}

fn style_get(sk: List[Str], sv: List[Str], key: Str, dflt: Str) -> Str {
    var i: I32 = 0
    while i < sk.len {
        if sk[i] == key {
            return sv[i]
        }
        i += 1
    }
    return dflt
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var cur = Atomic[I32](0)
    var tags = List[Str]()
    var cls = List[Str]()
    var texts = List[Str]()
    var leaf = List[I32]()
    var depth = List[I32]()
    var sk = List[Str]()
    var sv = List[Str]()
    parse_all(src, cur, tags, cls, texts, leaf, depth, sk, sv)

    // 布局重放:单根 + 叶子(样式来自 class 查表;bg 打包色过桥)
    var dircode: I32 = 1
    if style_get(sk, sv, "root.direction", "column") == "row" {
        dircode = 0
    }
    var gap: I32 = s2i(style_get(sk, sv, "root.gap", "8"))
    var pad: I32 = s2i(style_get(sk, sv, "root.padding", "16"))
    gui_clay_init(320, 200)
    gui_begin_layout(320, 200)
    gui_open()
    gui_cfg(dircode, gap, pad, pad, 0, 0, 1, 0, 1, 0, 0)
    var k: I32 = 0
    while k < tags.len {
        if leaf[k] == 1 {
            gui_open()
            var bgp: I32 = 0
            var wm: I32 = 1
            var hm: I32 = 0
            var wv: I32 = 0
            var hv: I32 = 0
            if tags[k] == "button" {
                wm = 2
                wv = 100
                hm = 2
                hv = 40
                var bgv: Str = style_get(sk, sv, cls[k] + ".bg", "")
                if bgv != "" {
                    bgp = parse_color(bgv)
                }
            }
            gui_cfg(0, 0, 0, 0, 0, 0, wm, wv, hm, hv, bgp)
            gui_text(texts[k], 20, 230, 230, 235, 255)
            gui_close()
        }
        k += 1
    }
    gui_close()
    var n: I32 = gui_end_layout()

    chk(n, 3, "a1")
    chk(gui_cmd_type(0), 1, "a2")
    chk(gui_cmd_text_len(0), 16, "a3")
    chk(gui_cmd_x100(0), 1600, "a4")
    chk(gui_cmd_y100(0), 1600, "a5")
    chk(gui_cmd_type(1), 2, "a6")
    chk(gui_cmd_y100(1), 4900, "a7")
    chk(gui_cmd_w100(1), 10000, "a8")
    chk(gui_cmd_bg_r(1), 200, "a9")
    chk(gui_cmd_bg_g(1), 60, "a10")
    chk(gui_cmd_type(2), 1, "a11")
    chk(gui_cmd_text_len(2), 6, "a12")
    println("s5 ctml: parse+layout ok")
    return 0
}
