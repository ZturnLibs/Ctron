// tests/gui/s80_datepick —— G 档 GUI-38:DatePick/TimePick(库 0.4)headless 验收
// 月历/周头/格式全 prop(locale 不进引擎);历法=std time.ct(days_from_civil/
// weekday 0=Sunday/leap_days_in_month);行点击=头名位定列+实例后缀定行(dpN:R);
// 时分步进=显参通道 tp_step("h+1" 形,滑杆同款);回绕=宿主钳位。
use gui_widgets.{gui_widgets_ver}
use std.time.{days_from_civil, weekday, leap_days_in_month}
use gui.{test, d_frame, d_expect_text, d_expect_absent, ev_arg_s}

struct M {
    var y: I32
    var mo: I32
    var sd: I32
    var hh: I32
    var mm: I32
    var ym: Str
    var hd: Str
    var hh_s: Str
    var mm_s: Str
    var weeks: List[Str]
    var state: Str
}

// —— 库全事件头桩(DatePick/TimePick 实逻辑驻桩,窗口模式直调;headless 经 act 同源)——
fn dp_prev(m: Box[M]) {
    m.mo = m.mo - 1
    if m.mo < 1 {
        m.mo = 12
        m.y = m.y - 1
    }
    rebuild(m)
}
fn dp_next(m: Box[M]) {
    m.mo = m.mo + 1
    if m.mo > 12 {
        m.mo = 1
        m.y = m.y + 1
    }
    rebuild(m)
}
fn dp0(m: Box[M], row: I32) {
    dp_cell(m, 0, row)
}
fn dp1(m: Box[M], row: I32) {
    dp_cell(m, 1, row)
}
fn dp2(m: Box[M], row: I32) {
    dp_cell(m, 2, row)
}
fn dp3(m: Box[M], row: I32) {
    dp_cell(m, 3, row)
}
fn dp4(m: Box[M], row: I32) {
    dp_cell(m, 4, row)
}
fn dp5(m: Box[M], row: I32) {
    dp_cell(m, 5, row)
}
fn dp6(m: Box[M], row: I32) {
    dp_cell(m, 6, row)
}
fn tp_step(m: Box[M], s: Str) {
    var d: I32 = 0
    var k: I32 = 2
    while k < s.len {
        d = d * 10 + (byte_at(s, k) - 48)
        k += 1
    }
    if byte_at(s, 1) == 45 {
        d = -d
    }
    if byte_at(s, 0) == 104 {
        m.hh = (m.hh + d % 24 + 24) % 24
    } else {
        m.mm = (m.mm + d % 60 + 60) % 60
    }
    rebuild(m)
}

