// tests/gui/s67_comp_a —— A 档五件视图组件 headless 验收
// tabs(数值条件切换)/badge(纯样式)/accordion(slot 投影)/tooltip(hover 通道)/
// toast(透明 overlay + gui_now 自动消失,d_tick 钉确定性时钟)。
use gui.{test, d_frame, d_click, d_click_inst, d_hover, d_expect_text, d_expect_absent, d_tick, gui_now}

struct M {
    var tcur: I32
    var accopen: Bool
    var toast_at: I32
    var toast_msg: Str
    var state: Str
}

fn tab_go() {
}
fn acc_toggle() {
}
fn tip_noop() {
}
fn toast_show() {
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    // each 行实例后缀:tab_go:N
    if name.len > 6 {
        if byte_at(name, 0) == 116 && byte_at(name, 1) == 97 && byte_at(name, 2) == 98 && byte_at(name, 3) == 95 && byte_at(name, 4) == 103 && byte_at(name, 5) == 111 && byte_at(name, 6) == 58 {
            var ni: I32 = 0
            var k9: I32 = 7
            while k9 < name.len {
                ni = ni * 10 + (byte_at(name, k9) - 48)
                k9 += 1
            }
            m.tcur = ni
            m.state = "切到详情"
            if ni == 0 {
                m.state = "切到概览"
            }
            return
        }
    }
    if name == "acc_toggle" {
        if m.accopen {
            m.accopen = false
        } else {
            m.accopen = true
        }
        return
    }
    if name == "toast_show" {
        m.toast_at = gui_now()
        m.toast_msg = "已保存"
        m.state = "toast 弹出"
        return
    }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "tcur" {
        buf.push("i:" + m.tcur.to_string())
    }
    if buf[0] == "each:tabs" {
        if m.tcur == 0 {
            buf.push("> 概览")
        } else {
            buf.push("概览")
        }
        if m.tcur == 1 {
            buf.push("> 详情")
        } else {
            buf.push("详情")
        }
    }
    if buf[0] == "accopen" {
        if m.accopen {
            buf.push("b:1")
        } else {
            buf.push("b:0")
        }
    }
    // toast:show 窗口 1500ms(注入时钟对比);msg 空即隐藏
    if buf[0] == "toastshow" {
        if m.toast_msg != "" {
            if gui_now() - m.toast_at < 1500 {
                buf.push("b:1")
            } else {
                buf.push("b:0")
            }
        } else {
            buf.push("b:0")
        }
    }
    if buf[0] == "toastmsg" {
        buf.push(m.toast_msg)
    }
    if buf[0] == "state" {
        buf.push(m.state)
    }
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var m = Box[M](M { tcur: 0, accopen: false, toast_at: 0, toast_msg: "", state: "" })
    var rc: I32 = test(src, 320, 560,
        |buf| bind_all(buf, m),
        |name, args| act(name, args, m),
        |k| { },
        |t, actc, k2| {
            // 初态:概览页;badge 常驻;accordion 关;tooltip 无;toast 无
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "概览内容")
            d_expect_absent(t, "详情内容")
            d_expect_text(t, "NEW")
            d_expect_absent(t, "折叠内容主体")
            d_expect_absent(t, "提示文案内容")
            d_expect_absent(t, "已保存")
            // tabs:点第二签(实例后缀)→ 内容切换+触发器前缀
            actc(d_click_inst(t, "tab_go", 1), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "详情内容")
            d_expect_absent(t, "概览内容")
            d_expect_text(t, "> 详情")
            // accordion:开 → slot 内容可见(slot 投影)
            actc(d_click(t, "acc_toggle"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "折叠内容主体")
            // tooltip:hover 触发 → 提示可见
            d_hover(t, "tip_noop")
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "提示文案内容")
            // toast:钉时钟→show→窗口内可见→逾时自动消失
            d_tick(t, 100)
            actc("toast_show", List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "已保存")
            d_tick(t, 5000)
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_absent(t, "已保存")
            // accordion 关 → slot 内容零渲染
            actc(d_click(t, "acc_toggle"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_absent(t, "折叠内容主体")
            println("S60-COMPA-GREEN")
        })
    return rc
}
