// tests/gui/s63_ellipsis —— GUI-22 单行省略 headless 验收
// 三段:长文本截断(…结尾+真截断)→ 短文本原样 → 二次帧稳定
use gui.{test, d_frame, d_expect_text, d_cmd_count, d_cmd_type, d_cmd_text_len, d_cmd_text_byte, Driver}

struct M {
    var state: Str
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
}

// 省略号(E2 80 A6)结尾的 TEXT 字节长;无则 -1(ellipsis label 唯一)
fn ell_len(t: Box[Driver]) -> I32 {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 1 {
            var tl: I32 = d_cmd_text_len(i)
            if tl >= 3 {
                if d_cmd_text_byte(i, tl - 3) == 226 && d_cmd_text_byte(i, tl - 2) == 128 && d_cmd_text_byte(i, tl - 1) == 166 {
                    return tl
                }
            }
        }
        i += 1
    }
    return -1
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var m = Box[M](M { state: "" })
    var rc: I32 = test(src, 320, 240,
        |buf| bind_all(buf, m),
        |name, args| act(name, args, m),
        |k| { },
        |t, actc, k2| {
            // S1 长文本:截断发生(… 结尾;原串 54 字节,截断串必更短)
            d_frame(t, |buf| bind_all(buf, m))
            var el: I32 = ell_len(t)
            if el < 3 {
                panic("s63: 无省略号结尾文本 el=" + el.to_string())
            }
            if el >= 54 {
                panic("s63: 截断未发生 el=" + el.to_string())
            }
            d_expect_text(t, "短文本")
            // S2 状态行正常
            m.state = "省略生效"
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "省略生效")
            // S3 二次帧稳定
            d_frame(t, |buf| bind_all(buf, m))
            if ell_len(t) < 3 {
                panic("s63: 二次帧省略消失")
            }
            println("S63-ELLIPSIS-GREEN")
        })
    return rc
}
