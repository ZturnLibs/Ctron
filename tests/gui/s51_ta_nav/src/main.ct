// tests/gui/s51_ta_nav —— textarea 成熟导航/选区 headless 验收
// 覆盖:↑↓ 行移列保持/Home/End 行内化/Shift+End 行内扩选/组词内联(d_ime_set)
use gui.{test, d_focus, d_frame, d_expect_text, d_expect_absent, d_send_key, d_send_char, d_ime_set, d_mod, d_alt, d_click_text, d_rclick, d_cmd_count, d_cmd_type, d_cmd_text_len, d_cmd_text_byte, d_cmd_x100, d_cmd_y100, d_cmd_w100, Driver}

struct M {
    var v: Str
}

view TaN(m: Box[M]) {
  <vbox class="root">
    <textarea bind={m.v} class="ta" on:input={sv}/>
  </vbox>
}
style root { direction: column padding: 8 }
style ta { h: 80 size: 16 }

fn sv(text: Str) {
}

fn act_sv(name: Str, m: Box[M]) {
    var i: I32 = 0
    while i < name.len {
        if byte_at(name, i) == 58 {
            m.v = byte_slice(name, i + 1, name.len)
            return
        }
        i += 1
    }
}

