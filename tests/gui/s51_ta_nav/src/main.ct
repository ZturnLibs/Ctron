fn has_rect(x: I32, y: I32, w: I32) -> Bool {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 2 {
            if d_cmd_x100(i) == x * 100 {
                if d_cmd_y100(i) == y * 100 {
                    if d_cmd_w100(i) == w * 100 {
                        return true
                    }
                }
            }
        }
        i += 1
    }
    return false
}

fn has_text(t: Box[Driver], sub: Str) -> Bool {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 1 {
            var ln: I32 = d_cmd_text_len(i)
            var j: I32 = 0
            while j + sub.len <= ln {
                var ok: I32 = 1
                var k: I32 = 0
                while k < sub.len {
                    if d_cmd_text_byte(i, j + k) != byte_at(sub, k) {
                        ok = 0
                    }
                    k += 1
                }
                if ok == 1 {
                    return true
                }
                j += 1
            }
        }
        i += 1
    }
    return false
}
