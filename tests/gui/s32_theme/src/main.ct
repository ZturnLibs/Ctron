// tests/gui/s32_theme —— 波次一 T4/T5:八主题换装 + theme_auto 探测/钉值
// 逐主题 apply→SURFACE/ACCENT 折叠值断言(顺序相邻主题 surface/accent 必异,
// apply 失默即红);末段复原 theme_default。
use gui.{test, d_frame, d_cmd_count, d_cmd_type, d_cmd_bg_r, d_cmd_bg_g, d_cmd_bg_b, theme_apply, theme_default, theme_auto, gui_os_dark, theme_dark, theme_light, theme_mac_dark, theme_mac_light, theme_win_dark, theme_win_light, theme_linux_dark, theme_linux_light}

view P {
  <vbox class="root">
    <button class="sw" on:click={noop}>S</button>
    <button class="tk" on:click={noop}>T</button>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style sw { bg: SURFACE w: 60 h: 30 }
style tk { bg: ACCENT w: 40 h: 20 }

fn noop() {
}

fn bind_noop(buf: List[Str]) {
}

fn scan_bg(r: I32, g: I32, b: I32) -> I32 {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 2 {
            if d_cmd_bg_r(i) == r {
                if d_cmd_bg_g(i) == g {
                    if d_cmd_bg_b(i) == b {
                        return 1
                    }
                }
            }
        }
        i += 1
    }
    return 0
}

fn main() -> I32 {
    var src: Str = ctron_embedded()
    var rc: I32 = test(src, 320, 200,
        |buf| bind_noop(buf),
        |name, args| noop(),
        |k| k,
        |t, a, k2| {
            // dark 基准
            theme_apply(theme_dark())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(34, 34, 46) != 1 {
                panic("s32: dark SURFACE #22222e 未现")
            }
            if scan_bg(37, 99, 235) != 1 {
                panic("s32: dark ACCENT #2563eb 未现")
            }
            // light 基准
            theme_apply(theme_light())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(255, 255, 255) != 1 {
                panic("s32: light SURFACE #ffffff 未现")
            }
            if scan_bg(37, 99, 235) != 1 {
                panic("s32: light ACCENT #2563eb 未现(surface 已判别)")
            }
            // mac 深/浅
            theme_apply(theme_mac_dark())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(40, 40, 40) != 1 {
                panic("s32: mac_dark SURFACE #282828 未现")
            }
            if scan_bg(10, 132, 255) != 1 {
                panic("s32: mac_dark ACCENT #0a84ff 未现")
            }
            theme_apply(theme_mac_light())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(0, 104, 218) != 1 {
                panic("s32: mac_light ACCENT #0068da 未现")
            }
            // win 深/浅
            theme_apply(theme_win_dark())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(39, 39, 39) != 1 {
                panic("s32: win_dark SURFACE #272727 未现")
            }
            if scan_bg(76, 194, 255) != 1 {
                panic("s32: win_dark ACCENT #4cc2ff 未现")
            }
            theme_apply(theme_win_light())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(0, 95, 184) != 1 {
                panic("s32: win_light ACCENT #005fb8 未现")
            }
            // linux 深/浅
            theme_apply(theme_linux_dark())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(46, 46, 50) != 1 {
                panic("s32: linux_dark SURFACE #2e2e32 未现")
            }
            if scan_bg(53, 132, 228) != 1 {
                panic("s32: linux_dark ACCENT #3584e4 未现")
            }
            theme_apply(theme_linux_light())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(28, 113, 216) != 1 {
                panic("s32: linux_light ACCENT #1c71d8 未现")
            }
            // 复原缺省
            theme_apply(theme_default())
            d_frame(t, |buf| bind_noop(buf))
            if scan_bg(34, 34, 46) != 1 {
                panic("s32: theme_default 复原后 SURFACE 未现")
            }
            // theme_auto 语义:钉值 > 平台×明暗(入口层 auto_apply 的显式优先口径另测)
            theme_apply(theme_auto())
            d_frame(t, |buf| bind_noop(buf))
            if env_get("CTRON_GUI_THEME") == "linux_dark" {
                if scan_bg(46, 46, 50) != 1 {
                    panic("s32: 钉值 linux_dark 未生效")
                }
                println("S32-PIN-GREEN")
            } else {
                if gui_os_dark() {
                    if scan_bg(40, 40, 40) != 1 {
                        panic("s32: auto mac_dark 未生效")
                    }
                } else {
                    if scan_bg(0, 104, 218) != 1 {
                        panic("s32: auto mac_light 未生效")
                    }
                }
                println("S32-AUTO-GREEN")
            }
            println("S32-THEME-GREEN")
        })
    return rc
}
