// —— 本件事件头(press 定源/释放定目标/swap)——
fn get_i(m: Box[M], i: I32) -> Str {
    if i == 0 {
        return m.a
    }
    if i == 1 {
        return m.b
    }
    return m.c
}

fn set_i(m: Box[M], i: I32, v: Str) {
    if i == 0 {
        m.a = v
    }
    if i == 1 {
        m.b = v
    }
    if i == 2 {
        m.c = v
    }
}

fn row_pick(m: Box[M], i: I32) {
    m.from = i
    m.state = "FROM" + i.to_string()
}

fn do_drop(m: Box[M], to: I32) {
    if m.from >= 0 {
        if m.from != to {
            var src: Str = get_i(m, m.from)
            set_i(m, m.from, get_i(m, to))
            set_i(m, to, src)
            m.state = "SWAP" + to.to_string()
        }
        m.from = -1
    }
}

fn r0_pick(m: Box[M]) {
    row_pick(m, 0)
}
fn r1_pick(m: Box[M]) {
    row_pick(m, 1)
}
fn r2_pick(m: Box[M]) {
    row_pick(m, 2)
}
fn r0_drag(i: I32) {
}
fn r1_drag(i: I32) {
}
fn r2_drag(i: I32) {
}

fn r0_drop(m: Box[M]) {
}
fn r1_drop(m: Box[M]) {
}
fn r2_drop(m: Box[M]) {
}

fn make() -> M {
    return M { from: -1, a: "R0", b: "R1", c: "R2", state: "" }
}

fn bind_all(buf: List[Str], m: Box[M]) {
    if buf[0] == "m.a" {
        buf.push(m.a)
    }
    if buf[0] == "m.b" {
        buf.push(m.b)
    }
    if buf[0] == "m.c" {
        buf.push(m.c)
    }
    if buf[0] == "m.state" {
        buf.push(m.state)
    }
}

fn act(name: Str, args: List[Str], m: Box[M]) {
    if name == "r0_pick" {
        row_pick(m, 0)
        return
    }
    if name == "r1_pick" {
        row_pick(m, 1)
        return
    }
    if name == "r2_pick" {
        row_pick(m, 2)
        return
    }
    if name == "r0_drag" {
        row_pick(m, ev_arg_i(args, 0))
        return
    }
    if name == "r1_drag" {
        row_pick(m, ev_arg_i(args, 0))
        return
    }
    if name == "r2_drag" {
        row_pick(m, ev_arg_i(args, 0))
        return
    }
    if name == "r0_drop" {
        do_drop(m, 0)
        return
    }
    if name == "r1_drop" {
        do_drop(m, 1)
        return
    }
    if name == "r2_drop" {
        do_drop(m, 2)
        return
    }
}

fn suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[M](make())
    return test(src, 320, 240,
        |buf| bind_all(buf, m),
        |name, ar| act(name, ar, m),
        |k| k,
        |t, actc, k2| {
            // 初始三行
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "R0")
            d_expect_text(t, "R1")
            d_expect_text(t, "R2")
            // 行 1(中心 ~y=69)垂直拖至行 2(中心 ~y=107):
            // press=click 定源 r1_pick+drag 臂;release 命中行 2 → r2_drop → swap
            d_dragv(t, 100, 69, 107, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            // drag+release 在 d_dragv 内一次完成:终态=换序(源经 drag 实参,
            // 目标经 dropin 命中)
            d_expect_text(t, "SWAP2")
            d_expect_absent(t, "FROM1")
            // 行序断言(列序 TEXT):R0,R2,R1(行 1/行 2 互换)
            var dno: I32 = d_cmd_count()
            var dio: I32 = 0
            var seq: Str = ""
            while dio < dno {
                if d_cmd_type(dio) == 1 {
                    var tlo: I32 = d_cmd_text_len(dio)
                    var bio: I32 = 0
                    var txo: Str = ""
                    while bio < tlo {
                        txo = txo + char_str(d_cmd_text_byte(dio, bio))
                        bio += 1
                    }
                    if txo == "R0" || txo == "R1" || txo == "R2" {
                        seq = seq + txo + " "
                    }
                }
                dio += 1
            }
            if seq != "R0 R2 R1 " {
                panic("s85: 行序不符 [" + seq + "]")
            }
            println("S85-DRAGDROP-GREEN " + gui_widgets_ver())
        })
}

view Root (m: M) {
  <vbox class="root">
    <button class="row" on:click={r0_pick(m)} on:drag={r0_drag(0)} on:dropin={r0_drop(m)}>{m.a}</button>
    <button class="row" on:click={r1_pick(m)} on:drag={r1_drag(1)} on:dropin={r1_drop(m)}>{m.b}</button>
    <button class="row" on:click={r2_pick(m)} on:drag={r2_drag(2)} on:dropin={r2_drop(m)}>{m.c}</button>
    <label class="state">{m.state}</label>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style row { direction: column w: 200 h: 30 bg: "#1e2a3a" fg: "#e5e7eb" }
style state { fg: "#22c55e" h: 22 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return suite()
    }
    return run(Root(m: make()))
}
