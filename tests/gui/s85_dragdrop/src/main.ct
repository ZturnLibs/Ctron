// tests/gui/s85_dragdrop —— G 档 GUI-37:内部拖放(释放命中 on:dropin)headless 验收
// 三行硬列九头(DatePick 模式):press=click(rK_pick 定源)+drag 臂(rK_drag);
// 释放=命中行 dropin(rK_drop 合成 permille 调用形)→ 宿主 swap。d_dragv 垂直拖。
use gui_widgets.{gui_widgets_ver}
use gui.{test, d_frame, d_dragv, d_expect_text, d_expect_absent, ev_arg_i,
         d_cmd_count, d_cmd_type, d_cmd_text_len, d_cmd_text_byte, char_str}

struct M {
    var from: I32
    var a: Str
    var b: Str
    var c: Str
    var state: Str
}

