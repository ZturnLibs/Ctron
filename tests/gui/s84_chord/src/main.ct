// tests/gui/s84_chord —— G 档 GUI-43:chord 序列组合键 headless 验收
// 四径:①完成("g g"→goto);②超时解除(800ms 外次键重武装不误 fire);
// ③干扰不吞(武装期非前缀键 X 解除并落键闭包);④mod 序列("mod+d d"→dup)
// + 单段回归(mod+z→undo 字节恒等)。时间源=注入时钟(d_tick 置位语义在册)。
use gui_widgets.{gui_widgets_ver}
use gui.{test, d_frame, d_tick, d_send_key, d_press_key, d_mod, gui_hotkey, d_expect_text}

struct M {
    var hits: I32
    var xcount: I32
    var state: Str
}

// —— 库全事件头桩(骨架面合并库全量注册=按需备齐;本件无实例)——
