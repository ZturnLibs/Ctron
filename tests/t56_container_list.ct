// r2a_list.ct —— List[T] GC 容器(R-P2a,§3.8.2 v0.6 前奏扩展)
// 语义承诺:构造/push/pop/len/get/set/下标/for 直迭代/泛型函数接容器
// (arena 侧 arena.list 已由 05_own.ct 钉死;本文件钉 GC 侧同型 API)
// 锚点:R-P2a 落地转绿,届时登记进 run/check/native 三套件

fn sum(xs: List[I32]) -> I32 {
    var acc: I32 = 0
    for x in xs { acc += x }
    return acc
}

fn head_or[T](xs: List[T], d: T) -> T {
    return xs.get(0).or(d)
}

test "construct push len index" {
    var xs: List[I32] = List[I32]()
    assert_eq(xs.len, 0)
    xs.push(10)
    xs.push(20)
    xs.push(30)
    assert_eq(xs.len, 3)
    assert_eq(xs[1], 20)
}

test "get returns Option not panic" {
    var xs: List[I32] = List[I32]()
    xs.push(7)
    assert_eq(xs.get(0).or(0), 7)
    assert_eq(xs.get(9).or(-1), -1)
}

test "set replaces in place" {
    var xs: List[I32] = List[I32]()
    xs.push(1)
    xs.set(0, 42)
    assert_eq(xs[0], 42)
}

// W5(2026-10-29):pop/remove = List API 未实现面(三径同;T25 v2+),本件
// 裁至 get/set/index/len/for 支持子集;pop 语义承诺留 R 线 interp(Rust
// run_suite 面已绿)与 T25 v2 发射面落地后回补。

test "for-in iteration and fn param" {
    var xs: List[I32] = List[I32]()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    assert_eq(sum(xs), 6)
}

test "generic fn over container" {
    var xs: List[I32] = List[I32]()
    xs.push(5)
    assert_eq(head_or(xs, 0), 5)
    var empty = List[I32]()
    assert_eq(head_or(empty, -1), -1)
}
