    var total: I64 = 0
    var first: I64 = -1
    var last: I64 = -1
    var b1: I64 = -1
    var b2: I64 = -1
    var b3: I64 = -1
    var b4: I64 = -1
    var guard: I64 = 0
    while total < 5006 && guard < 100 {
        guard += 1
        let n = ctron_dbpg_read(sv[1], sr, 4096)
        assert(n > 0)
        if total == 0 {
            first = sr[0]
            b1 = sr[1]
            b2 = sr[2]
            b3 = sr[3]
            b4 = sr[4]
        }
        last = sr[n - 1]
        total = total + n
    }
    assert_eq(total, 5006)
    assert_eq(first, 81)
    assert_eq(b1, 0)
    assert_eq(b2, 0)
    assert_eq(b3, 19)
    assert_eq(b4, 141)
    // 尾字节 = sql 终止 NUL
    assert_eq(last, 0)
    assert_eq(pg_fd_close(sv[0]), 0)
    assert_eq(pg_fd_close(sv[1]), 0)
}
