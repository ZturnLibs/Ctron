// tests/db/replay_scram/x_scram_nonce.ct —— SCRAM 客户端 nonce 真熵面
// (x_ = 仅 emit 臂入计;interp 无 extern 运行时,x_uuid_live 同款结构性
// 登记;链 db/c_src/ctron_dbpg.c + ctron_entropy.c——ctron_dbpg_entropy
// 为 view 胞形别名转发,链接须并链熵垫片)。emit 臂专用。
use db.pg.{pg_scram_nonce, pg_scram_nonce_from}

test "scram nonce: live entropy 24 chars, two draws differ, pure face intact" {
    let a = pg_scram_nonce()
    assert_eq(a.len, 24)
    let b = pg_scram_nonce()
    assert_eq(b.len, 24)
    // 真熵:两次抽取不相等(128 位级碰撞概率可忽略;失源 = 空串已由 len 断)
    assert(a != b)
    // 纯形面:定值注入复现
    var r = List[I32]()
    var i: I32 = 0
    while i < 18 {
        r.push(i)
        i += 1
    }
    assert_eq(pg_scram_nonce_from(r), "AAECAwQFBgcICQoLDA0ODxAR")
}
