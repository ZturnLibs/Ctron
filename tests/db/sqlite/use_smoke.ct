// G6 sqlite use 解析冒烟(use db.sqlite 链 + open/close 实调)
use db.sqlite.{SqliteDb, sqlite_std, sqlite_open, sqlite_close, sqc_ok}

fn main() {
    let t = sqlite_std()
    let c = sqlite_open(t, ":memory:")
    if sqc_ok(c) != 1 {
        println("sqlite-probe FAIL open")
        return
    }
    sqlite_close(c)
    println("sqlite-probe ok use_smoke")
}
