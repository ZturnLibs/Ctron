// 10_web_dom.ct —— stdweb 最小 API 锚定(§9.2 v0.5;T39 起双面:title/set_body)
//@ target: web
use stdweb.dom

test "dom title roundtrip anchor" {
    dom.set_title("Ctron")
    assert_eq(dom.title(), "Ctron")
}

test "dom body roundtrip anchor(T39 第二面)" {
    dom.set_body("<b id='ct-body-marker'>ctron</b>")
    assert_eq(dom.body(), "<b id='ct-body-marker'>ctron</b>")
}
