// std/time.ct —— 纯历法(days 域;公历)+ Clock 墙钟面(v0.3:now_ms/iso_utc;单调钟待运行时面;Rust interp 内建待补,parity 欠账在册)
// since: std-0.2 stability: experimental
// 口径:days since 1970-01-01(1970-01-01 = 0);年份域 [1,9999];全部纯函数,
// 无时钟依赖(宪章 8);Hinnant 民历算法;I32 除法幅度 ≤1.5e6(C3 安全)

// 公历日期(值类型;字段 let)
struct CivilDate {
    let y: I32
    let m: I32
    let d: I32
}

// 公历闰年:四年一闰、百年不闰、四百年再闰
pub fn leap_is_leap(y: I32) -> Bool {
    if y % 4 != 0 {
        return false
    }
    if y % 100 != 0 {
        return true
    }
    return y % 400 == 0
}

// 月天数;m 越界返回 0(文档化)
pub fn leap_days_in_month(y: I32, m: I32) -> I32 {
    if m < 1 {
        return 0
    }
    if m > 12 {
        return 0
    }
    if m == 2 {
        if leap_is_leap(y) {
            return 29
        }
        return 28
    }
    if m == 4 {
        return 30
    }
    if m == 6 {
        return 30
    }
    if m == 9 {
        return 30
    }
    if m == 11 {
        return 30
    }
    return 31
}

// 公历日期 → days since 1970-01-01;m/d 越界返回 -1(文档化)
pub fn days_from_civil(y: I32, m: I32, d: I32) -> I32 {
    if m < 1 {
        return -1
    }
    if m > 12 {
        return -1
    }
    if d < 1 {
        return -1
    }
    if d > leap_days_in_month(y, m) {
        return -1
    }
    // Hinnant 民历算法(天数域;y ∈ [1,9999] 时全部中间量 I32 安全)
    var yy = y
    if m <= 2 {
        yy = y - 1
    }
    var era: I32 = 0
    if yy >= 0 {
        era = yy / 400
    } else {
        era = (yy - 399) / 400
    }
    var yoe = yy - era * 400
    var mp: I32 = 0
    if m > 2 {
        mp = m - 3
    } else {
        mp = m + 9
    }
    var doy = (153 * mp + 2) / 5 + d - 1
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// days → 公历日期(逆变换;z 域见年份域)
pub fn civil_from_days(z: I32) -> CivilDate {
    var z2 = z + 719468
    var era: I32 = 0
    if z2 >= 0 {
        era = z2 / 146097
    } else {
        era = (z2 - 146096) / 146097
    }
    var doe = z2 - era * 146097
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var yy = yoe + era * 400
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    var mp = (5 * doy + 2) / 153
    var dd = doy - (153 * mp + 2) / 5 + 1
    var mm: I32 = 0
    if mp < 10 {
        mm = mp + 3
    } else {
        mm = mp - 9
    }
    if mm <= 2 {
        yy = yy + 1
    }
    return CivilDate { y: yy, m: mm, d: dd }
}

// 星期:0=星期日 … 6=星期六;1970-01-01 = 4(星期四)
pub fn weekday(z: I32) -> I32 {
    var w = z % 7
    if w < 0 {
        w = w + 7
    }
    var r = w + 4
    if r >= 7 {
        r = r - 7
    }
    return r
}

// "YYYY-MM-DD"(4 位零填充;年份域外返回空串)
pub fn date_format(z: I32) -> Str {
    var cd = civil_from_days(z)
    if cd.y < 1 {
        return ""
    }
    if cd.y > 9999 {
        return ""
    }
    var ys = cd.y.to_string()
    while ys.len < 4 {
        ys = "0" + ys
    }
    var ms = cd.m.to_string()
    if ms.len < 2 {
        ms = "0" + ms
    }
    var ds = cd.d.to_string()
    if ds.len < 2 {
        ds = "0" + ds
    }
    return ys + "-" + ms + "-" + ds
}

// 严格 "YYYY-MM-DD"(10 字节、合规月日含闰);非法 None
fn t_digits2(s: Str, i: I32) -> I32 {
    var a = byte_at(s, i)
    var b = byte_at(s, i + 1)
    if a < 48 {
        return -1
    }
    if a > 57 {
        return -1
    }
    if b < 48 {
        return -1
    }
    if b > 57 {
        return -1
    }
    return (a - 48) * 10 + (b - 48)
}

fn t_digits4(s: Str) -> I32 {
    var v: I32 = 0
    var i: I32 = 0
    while i < 4 {
        var c = byte_at(s, i)
        if c < 48 {
            return -1
        }
        if c > 57 {
            return -1
        }
        v = v * 10 + (c - 48)
        i += 1
    }
    return v
}

pub fn date_parse(s: Str) -> Option[I32] {
    if s.len != 10 {
        return None
    }
    if byte_at(s, 4) != 45 {
        return None
    }
    if byte_at(s, 7) != 45 {
        return None
    }
    var y = t_digits4(s)
    var m = t_digits2(s, 5)
    var d = t_digits2(s, 8)
    if y < 1 {
        return None
    }
    if y > 9999 {
        return None
    }
    if m < 1 {
        return None
    }
    if m > 12 {
        return None
    }
    if d < 1 {
        return None
    }
    if d > leap_days_in_month(y, m) {
        return None
    }
    return Some(days_from_civil(y, m, d))
}

// 发射面安全 Option 助手(match 形;C13a)
pub fn time_get(o: Option[I32], dft: I32) -> I32 {
    match o {
        Some(v) => {
            return v
        }
        None => {
            return dft
        }
    }
}

pub fn time_some(o: Option[I32]) -> Bool {
    match o {
        Some(v) => {
            return true
        }
        None => {
            return false
        }
    }
}

test "leap year four cases" {
    assert(!leap_is_leap(1900))
    assert(leap_is_leap(2000))
    assert(!leap_is_leap(2100))
    assert(leap_is_leap(2024))
    assert(!leap_is_leap(2023))
}

test "days in month" {
    assert_eq(leap_days_in_month(2024, 2), 29)
    assert_eq(leap_days_in_month(2023, 2), 28)
    assert_eq(leap_days_in_month(2024, 1), 31)
    assert_eq(leap_days_in_month(2024, 4), 30)
    assert_eq(leap_days_in_month(2024, 12), 31)
    assert_eq(leap_days_in_month(2024, 0), 0)
    assert_eq(leap_days_in_month(2024, 13), 0)
}

test "epoch and civil round trip" {
    assert_eq(days_from_civil(1970, 1, 1), 0)
    var cd = civil_from_days(0)
    assert_eq(cd.y, 1970)
    assert_eq(cd.m, 1)
    assert_eq(cd.d, 1)
    assert_eq(days_from_civil(2000, 3, 1), 11017)
    var z: I32 = 0
    while z < 2000 {
        var c = civil_from_days(z)
        assert_eq(days_from_civil(c.y, c.m, c.d), z)
        z += 7
    }
}

test "civil invalid month day" {
    assert_eq(days_from_civil(2024, 13, 1), -1)
    assert_eq(days_from_civil(2024, 0, 1), -1)
    assert_eq(days_from_civil(2023, 2, 29), -1)
    assert_eq(days_from_civil(2024, 2, 29), 19782)
    assert_eq(days_from_civil(2024, 4, 31), -1)
}

test "weekday known anchors" {
    assert_eq(weekday(0), 4)
    assert_eq(weekday(-1), 3)
    assert_eq(weekday(1), 5)
    var z: I32 = 0
    while z < 400 {
        assert(weekday(z) >= 0)
        assert(weekday(z) <= 6)
        z += 1
    }
}

test "format parse round trip" {
    assert_eq(date_format(0), "1970-01-01")
    assert_eq(date_format(19782), "2024-02-29")
    assert_eq(time_get(date_parse("1970-01-01"), -1), 0)
    assert_eq(time_get(date_parse("2024-02-29"), -1), 19782)
    assert(!time_some(date_parse("2023-02-29")))
    assert(!time_some(date_parse("2024-13-01")))
    assert(!time_some(date_parse("2024-00-10")))
    assert(!time_some(date_parse("2024-1-01")))
    assert(!time_some(date_parse("20240101")))
    assert(!time_some(date_parse("")))
    var z: I32 = 0
    while z < 2000 {
        var f = date_format(z)
        assert_eq(time_get(date_parse(f), -999999), z)
        z += 7
    }
}


// ============ v0.3 epoch 秒域(I64 承载;P1-B 值域贯通) ============

// 公历日期 → Unix epoch 秒(I64;年域 [1,9999])
pub fn time_to_epoch_s(y: I32, m: I32, d: I32) -> I64 {
    var days = days_from_civil(y, m, d)
    var w: I64 = 4294967296
    var es: I64 = w - w + days
    return es * 86400
}

test "epoch seconds" {
    assert_eq(time_to_epoch_s(1970, 1, 1), 0)
    assert_eq(time_to_epoch_s(2024, 1, 1), 1704067200)
}

// ============ v0.3 Clock 面(墙钟 epoch ms;单调钟待运行时面) ============
// 口径:内建 now_ms(Unix epoch 毫秒)仅在自举/发射口径在册,Rust interp
// 内建待补(parity Rust 臂欠账在册);iso_utc 为纯历法组合,Hinnant 以
// I64 域内联(回避 I64 到 I32 的收窄桥,登记分歧)

// 两位十进制(时/分/秒域填零)
fn two(v: I64) -> Str {
    if v < 10 {
        return "0" + v.to_string()
    }
    return v.to_string()
}

// epoch 毫秒 → ISO 8601 UTC(YYYY-MM-DDTHH:MM:SSZ)
pub fn iso_utc(ms: I64) -> Str {
    var days: I64 = ms / 86400000
    var mod: I64 = ms % 86400000
    if mod < 0 {
        days -= 1
        mod += 86400000
    }
    // 规范化:自举 6 域除法为 floor 语义,负 ms 可得非规范对(如 02-27T24:00),
    // 恒等式 days*86400000 + mod = ms 不变,进位即得规范形(宿主无关)
    if mod >= 86400000 {
        mod -= 86400000
        days += 1
    }
    var hh: I64 = mod / 3600000
    var mi: I64 = mod % 3600000 / 60000
    var ss: I64 = mod % 60000 / 1000
    var z2: I64 = days + 719468
    var era: I64 = 0
    if z2 >= 0 {
        era = z2 / 146097
    } else {
        era = (z2 - 146096) / 146097
    }
    var doe = z2 - era * 146097
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var yy = yoe + era * 400
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    var mp = (5 * doy + 2) / 153
    var dd = doy - (153 * mp + 2) / 5 + 1
    var mm = mp
    if mm < 10 {
        mm = mm + 3
    } else {
        mm = mm - 9
    }
    if mm <= 2 {
        yy = yy + 1
    }
    var out = ""
    if yy < 10 {
        out = out + "000"
    } else {
        if yy < 100 {
            out = out + "00"
        } else {
            if yy < 1000 {
                out = out + "0"
            }
        }
    }
    out = out + yy.to_string()
    out = out + "-"
    if mm < 10 {
        out = out + "0"
    }
    out = out + mm.to_string()
    out = out + "-"
    if dd < 10 {
        out = out + "0"
    }
    out = out + dd.to_string()
    out = out + "T"
    out = out + two(hh) + ":" + two(mi) + ":" + two(ss) + "Z"
    return out
}

// 当前墙钟的 ISO 8601 UTC 串
pub fn now_iso_utc() -> Str {
    return iso_utc(now_ms())
}

test "iso utc civil" {
    assert_eq(iso_utc(0), "1970-01-01T00:00:00Z")
    assert_eq(iso_utc(86400000), "1970-01-02T00:00:00Z")
    assert_eq(iso_utc(1000000000000), "2001-09-09T01:46:40Z")
    assert_eq(iso_utc(951782400000), "2000-02-29T00:00:00Z")
    assert_eq(date_parse(date_format(19000)).or(-1), 19000)
}

test "now wall clock" {
    assert(now_ms() > 1600000000000)
    var t1: I64 = now_ms()
    var t2: I64 = now_ms()
    assert(t2 >= t1)
    var iso = now_iso_utc()
    assert(iso.len == 20)
    assert(byte_at(iso, 4) == 45)
    assert(byte_at(iso, 7) == 45)
    assert(byte_at(iso, 10) == 84)
    assert(byte_at(iso, 13) == 58)
    assert(byte_at(iso, 16) == 58)
    assert(byte_at(iso, 19) == 90)
}

test "iso utc negative and century" {
    assert_eq(iso_utc(-1), "1969-12-31T23:59:59Z")
    assert_eq(iso_utc(-86400000), "1969-12-31T00:00:00Z")
    assert_eq(iso_utc(-2203977600000), "1900-02-28T00:00:00Z")
    assert_eq(iso_utc(-2203891200000), "1900-03-01T00:00:00Z")
}
