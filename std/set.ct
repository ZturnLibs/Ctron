// std/set.ct —— Set[V] 种子(List 成员;函数式:add 返回新集合)
// V 需可 ==(add 去重 bound Eq);add 体内嵌套调用 mem[V](单态化嵌套解析)
struct Set[V] {
    let items: List[V]
}

pub fn set_new[V]() -> Set[V] {
    return Set { items: List[V]() }
}

pub fn mem[V](s: Set[V], v: V) -> Bool {
    var i: I32 = 0
    while i < s.items.len {
        if s.items[i] == v {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn add[V: Eq](s: Set[V], v: V) -> Set[V] {
    if mem[V](s, v) {
        return s
    }
    var nitems = List[V]()
    var j: I32 = 0
    while j < s.items.len {
        nitems.push(s.items[j])
        j = j + 1
    }
    nitems.push(v)
    return Set { items: nitems }
}

pub fn len[V](s: Set[V]) -> I32 {
    return s.items.len
}

// 集合 → List(插入序);List → 集合(依序 add 去重)
pub fn tolist[V](s: Set[V]) -> List[V] {
    return s.items
}

pub fn fromlist[V: Eq](xs: List[V]) -> Set[V] {
    var out = set_new[V]()
    var i: I32 = 0
    while i < xs.len {
        out = add[V](out, xs[i])
        i += 1
    }
    return out
}

test "tolist/fromlist roundtrip dedupes" {
    var xs = List[I32]()
    xs.push(5)
    xs.push(5)
    xs.push(7)
    var s = fromlist[I32](xs)
    assert(len[I32](s) == 2)
    var back = tolist[I32](s)
    assert(back.len == 2)
    assert(back[0] == 5)
    assert(back[1] == 7)
}


// ============ v0.3 完备性:删除与集合代数(函数式,原集合不变) ============

// 删除元素:不存在时原样返回
pub fn set_del[T](s: Set[T], v: T) -> Set[T] {
    if !mem[T](s, v) {
        return s
    }
    var keep = List[T]()
    var i: I32 = 0
    while i < s.items.len {
        var cur: T = s.items[i]
        if cur != v {
            keep.push(cur)
        }
        i += 1
    }
    return Set { items: keep }
}

// 并集:a ∪ b
pub fn set_union[T](a: Set[T], b: Set[T]) -> Set[T] {
    var out = a
    var i: I32 = 0
    while i < b.items.len {
        var cur: T = b.items[i]
        if !mem[T](out, cur) {
            out = add[T](out, cur)
        }
        i += 1
    }
    return out
}

// 交集:a ∩ b(结果保持 a 的元素序)
pub fn set_inter[T](a: Set[T], b: Set[T]) -> Set[T] {
    var out = set_new[T]()
    var i: I32 = 0
    while i < a.items.len {
        var cur: T = a.items[i]
        if mem[T](b, cur) {
            out = add[T](out, cur)
        }
        i += 1
    }
    return out
}

// 差集:a − b(结果保持 a 的元素序)
pub fn set_diff[T](a: Set[T], b: Set[T]) -> Set[T] {
    var out = set_new[T]()
    var i: I32 = 0
    while i < a.items.len {
        var cur: T = a.items[i]
        if !mem[T](b, cur) {
            out = add[T](out, cur)
        }
        i += 1
    }
    return out
}

// 子集判定:a ⊆ b
pub fn set_subset[T](a: Set[T], b: Set[T]) -> Bool {
    var i: I32 = 0
    while i < a.items.len {
        if !mem[T](b, a.items[i]) {
            return false
        }
        i += 1
    }
    return true
}

test "set_del removes and passes through" {
    var s = set_new[I32]()
    s = add[I32](s, 1)
    s = add[I32](s, 2)
    s = add[I32](s, 3)
    s = set_del[I32](s, 2)
    assert_eq(len[I32](s), 2)
    assert(mem[I32](s, 1))
    assert(!mem[I32](s, 2))
    assert(mem[I32](s, 3))
    var s2 = set_del[I32](s, 99)
    assert_eq(len[I32](s2), 2)
}

test "set union inter diff subset" {
    var a = set_new[I32]()
    a = add[I32](a, 1)
    a = add[I32](a, 2)
    a = add[I32](a, 3)
    var b = set_new[I32]()
    b = add[I32](b, 3)
    b = add[I32](b, 4)
    var u = set_union[I32](a, b)
    assert_eq(len[I32](u), 4)
    assert(mem[I32](u, 1))
    assert(mem[I32](u, 4))
    var i12 = set_inter[I32](a, b)
    assert_eq(len[I32](i12), 1)
    assert(mem[I32](i12, 3))
    var d = set_diff[I32](a, b)
    assert_eq(len[I32](d), 2)
    assert(mem[I32](d, 1))
    assert(mem[I32](d, 2))
    assert(!mem[I32](d, 3))
    var sub = set_new[I32]()
    sub = add[I32](sub, 1)
    assert(set_subset[I32](sub, a))
    assert(!set_subset[I32](a, sub))
    assert(set_subset[I32](set_new[I32](), b))
}
