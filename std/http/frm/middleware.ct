// std/http/frm/middleware.ct —— 组合层中间件链骨架 + 请求上下文载体(P6-A)
//
// 链形(P5-E 裁定沿用:Sender/Receiver 字段化截断 ⇒ std 门面禁持通道半端;
// 中间件链/handler 装配一律组合层接线 —— 本模块不持任何 IO 面,零通道):
//
//     中间件 = fn(req: Str, h: I64, next: fn(Str, I64) -> Str) -> Str
//     req    = 请求目标(路径,含原样 percent 编码;组合层自 parse.ct target
//              槽经 frm_slice_str Str 化后传入)
//     h      = 请求句柄(I64;v1 约定 = 路由 id 携带 + 中间件数据槽:中间件
//              以「值变换」下传 —— next(req, h') 传入改写后的 h',handler 读
//              到的即链上累改结果;类型 = I64,无 Any)
//     短路    = 中间件不调 next、径返自身响应(响应胜出);调 next 即透传
//
// 链的组装 = 组合层显式嵌套(闭包字面量适配 fn 形,03g/03h + P6-A 探针
// 已证形;emit 侧 fn 值装箱全宽 ct_i 实参 —— 故【链上只走标量/Str,struct
// 与 lane 视图过装箱调用即断,P6-A 探针实证】):
//
//     let resp = mw1(req, h, |r, k| mw2(r, k, |r2, k2| term(r2, k2)))
//
// 执行序 = 装配嵌套序(外先内后);序断言 = 句柄算术组合(外层 ×10+1、内层
// ×10+2 之类,序错即值异)。FrmCtx(下)为富载体:arena 句柄 + 路径参数 +
// 类型化数据槽 —— 用于组合层【直接调用】边界(装配前构造、终端 handler/
// IO 粘合处按 getter 读),不过装箱链(fn 值实参 ct_i 装箱,struct 即断)。
//
// FrmCtx 形态((h) 缺口绕行:跨模块成员读不可发射 → 值 struct + 标量
// getter;消费方侧字面量构造/整体回传皆绿,数据槽写 = 值重建 with_d*):
//   arena  = 请求 arena 句柄(组合层令牌;纯层无分配器,句柄语义随 P6 body
//            绑定波 formalize,本波为透传槽)
//   req_id = 连接内请求序号(组合层填)
//   np/p*s/p*l = 路径参数 4 槽(frm_ctx_route 自 FrmRoute 搬运)
//   d0/d1  = 中间件数据槽 A/B(类型化 I64;经 with_d0/with_d1 写,getter 读)
//
// 响应助手 = 零 use 自拼(message.ct 不导入 —— 加载器严格树:消费方常需
//   parse+message 直用,本模块再导即菱形 E5020;状态行/CL 三位十进制自拼,
//   与 msg_status_line 同式,CRLF 自备)。
//
// use 面(加载器严格树 E5020 形态登记):本模块 = 框架面唯一入口(门面形,
//   tls.ct ⑥ 同款)—— router 侧符号经本模块 use 单命名空间合并贯穿,
//   消费方【只】use std.http.frm.middleware,不得再直 use router/enc
//   (同叶双径即菱形)。router 侧符号(frm_match/fr_* /frm_param* 等)
//   消费方按名直引即解析。

use std.http.frm.router.{ FrmRoute, frm_match, frm_mcode_buf, frm_m_get, frm_m_post, frm_m_put, frm_m_delete, frm_m_patch, frm_m_head, frm_m_options, frm_m_trace, frm_rc_match, frm_rc_method, frm_rc_miss, fr_rc, fr_id, fr_np, fr_ps, fr_pl, frm_param, frm_param_dec, frm_param_dec_ok, frm_param_i64, fi_rc, fi_v, frm_slice_str }

// ---- 上下文载体 ----

struct FrmCtx {
    let arena: I64
    let req_id: I64
    let np: I64
    let p0s: I64
    let p0l: I64
    let p1s: I64
    let p1l: I64
    let p2s: I64
    let p2l: I64
    let p3s: I64
    let p3l: I64
    let d0: I64
    let d1: I64
}

pub fn frm_ctx_new(arena: I64, req_id: I64) -> FrmCtx {
    return FrmCtx { arena: arena, req_id: req_id, np: 0, p0s: 0, p0l: 0, p1s: 0, p1l: 0, p2s: 0, p2l: 0, p3s: 0, p3l: 0, d0: 0, d1: 0 }
}

// 参数槽搬运:自命中结果(FrmRoute)拷入上下文(组合层:match → ctx 一行接线)
pub fn frm_ctx_route(c: FrmCtx, m: FrmRoute) -> FrmCtx {
    return FrmCtx { arena: c.arena, req_id: c.req_id, np: fr_np(m), p0s: fr_ps(m, 0), p0l: fr_pl(m, 0), p1s: fr_ps(m, 1), p1l: fr_pl(m, 1), p2s: fr_ps(m, 2), p2l: fr_pl(m, 2), p3s: fr_ps(m, 3), p3l: fr_pl(m, 3), d0: c.d0, d1: c.d1 }
}

// 数据槽写(值重建 —— 闭包捕获槽写回禁(⑤),槽变更以新值下传)
pub fn frm_ctx_with_d0(c: FrmCtx, v: I64) -> FrmCtx {
    return FrmCtx { arena: c.arena, req_id: c.req_id, np: c.np, p0s: c.p0s, p0l: c.p0l, p1s: c.p1s, p1l: c.p1l, p2s: c.p2s, p2l: c.p2l, p3s: c.p3s, p3l: c.p3l, d0: v, d1: c.d1 }
}

pub fn frm_ctx_with_d1(c: FrmCtx, v: I64) -> FrmCtx {
    return FrmCtx { arena: c.arena, req_id: c.req_id, np: c.np, p0s: c.p0s, p0l: c.p0l, p1s: c.p1s, p1l: c.p1l, p2s: c.p2s, p2l: c.p2l, p3s: c.p3s, p3l: c.p3l, d0: c.d0, d1: v }
}

// ---- 公开 getter((h) 面同 parse.ct) ----

pub fn frm_ctx_arena(c: FrmCtx) -> I64 { return c.arena }
pub fn frm_ctx_req_id(c: FrmCtx) -> I64 { return c.req_id }
pub fn frm_ctx_np(c: FrmCtx) -> I64 { return c.np }
pub fn frm_ctx_ps(c: FrmCtx, k: I64) -> I64 {
    if k == 0 { return c.p0s }
    if k == 1 { return c.p1s }
    if k == 2 { return c.p2s }
    if k == 3 { return c.p3s }
    return 0
}
pub fn frm_ctx_pl(c: FrmCtx, k: I64) -> I64 {
    if k == 0 { return c.p0l }
    if k == 1 { return c.p1l }
    if k == 2 { return c.p2l }
    if k == 3 { return c.p3l }
    return 0
}
pub fn frm_ctx_d0(c: FrmCtx) -> I64 { return c.d0 }
pub fn frm_ctx_d1(c: FrmCtx) -> I64 { return c.d1 }

// 参数槽 → 原始切片 Str(终端 handler 侧便捷面;组合层持 buf 时常用)
pub fn frm_ctx_param(buf: &I64[], c: FrmCtx, k: I64) -> Str {
    let s = frm_ctx_ps(c, k)
    let l = frm_ctx_pl(c, k)
    if l <= 0 {
        return ""
    }
    return frm_slice_str(buf, s, s + l)
}

// ---- 响应助手(零 use 自拼;CRLF 自备) ----

// 三位十进制状态码(状态行段;msg_status_line 同式)
fn mw_digits(v: I64) -> Str {
    let d1 = v / 100
    let d2 = (v / 10) % 10
    let d3 = v % 10
    return byte_slice("0123456789", d1, d1 + 1) + byte_slice("0123456789", d2, d2 + 1) + byte_slice("0123456789", d3, d3 + 1)
}

// 最小响应:状态行 + Content-Length + 体(HTTP/1.1;连接管理归框架 IO 波)
pub fn frm_resp(status: I64, reason: Str, body: Str) -> Str {
    return "HTTP/1.1 " + mw_digits(status) + " " + reason + "\r\n" + "Content-Length: " + body.len.to_string() + "\r\n" + "\r\n" + body
}

pub fn frm_resp_text(body: Str) -> Str {
    return frm_resp(200, "OK", body)
}

pub fn frm_resp_404() -> Str {
    return frm_resp(404, "Not Found", "not found")
}

pub fn frm_resp_405() -> Str {
    return frm_resp(405, "Method Not Allowed", "method not allowed")
}

// ---- inline tests(纯面自检;链序/短路语料见 tests/http/frm_route) ----

test "ctx slots and rebuild" {
    let c0 = frm_ctx_new(7, 1)
    assert(frm_ctx_arena(c0) == 7 && frm_ctx_req_id(c0) == 1 && frm_ctx_np(c0) == 0)
    let c1 = frm_ctx_with_d0(c0, 42)
    let c2 = frm_ctx_with_d1(c1, 9)
    assert(frm_ctx_d0(c2) == 42 && frm_ctx_d1(c2) == 9)
    assert(frm_ctx_arena(c2) == 7)
    assert(frm_ctx_ps(c2, 3) == 0 && frm_ctx_pl(c2, 2) == 0)
}

test "resp shapes" {
    assert(frm_resp_text("hi") == "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    assert(frm_resp_404() == "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\n\r\nnot found")
    assert(frm_resp_405() == "HTTP/1.1 405 Method Not Allowed\r\nContent-Length: 18\r\n\r\nmethod not allowed")
    assert(frm_resp(500, "ISE", "") == "HTTP/1.1 500 ISE\r\nContent-Length: 0\r\n\r\n")
}
