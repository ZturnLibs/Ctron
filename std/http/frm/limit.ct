// std/http/frm/limit.ct —— 限流 + 过载 shed 中间件(P6-B;per-IP 令牌桶 +
// max-in-flight 信号量 + 503 Retry-After)
//
// 语义登记(v1 口径):
//   令牌桶 = 显式值状态(LimBkt 值进值出 —— 纯层无全局无可变量,状态由
//   组合层持有并以值重建下传;进程内注册表(IP → 桶)归组合层,分布式面
//   列 P8)。补充 = ((now - last) / ivl) * refill,cap 封顶;last 恒以
//   steps * ivl 整步前进(分数步留余 —— 确定性:同 now 序列恒同判定,
//   测试面 now 为注入参数,真钟装配归组合层)。消费 = cost(恒 >= 1,组合
//   层纪律);不足 → 拒 + Retry-After = ceil((cost - tks) * ivl / refill)。
//
//   max-in-flight = 值形信号量(lim_acq/lim_rel):acq n+1 <= maxif 才
//   ok,超即 shed(ok=0,n 不动);rel 下界 0(幂等防负)。释放点 = 组合层
//   响应写出后(链返回 resp 后组合层 rel —— 链形 fn 内无 post-return 钩子,
//   如实登记)。
//
//   判定序(登记):in-flight 门先于令牌桶(shed 优先于限流 —— 满载时不再
//   消耗桶令牌,恢复更快);双门皆过 → next。503 响应:Retry-After = 令牌
//   面取桶算的 retry,shed 面取 1(常量;面区分登记:shed 无时间估计,
//   取最小礼让值)。body = "lim rejected"(12 字节)。
//
//   per-IP 键 = lim_ip_key:FNV 形算术散列(h*131+c,mod 大素数 4294967291
//   —— 无位运算(§4.5 在案),I64 域乘加模;宽域播种 z64 惯用法,crypto.ct
//   同式)。组合层以键索引定长桶槽表;冲突面 = 槽表属组合层,本模块只供键。
//
//   注入面:Retry-After 值恒出自整数运算自拼(十进制),无请求字节入头。
//
// use 面:零 use 纯模块(同 cors/sechdr —— 多中间件同入口组合各为无共享
//   叶子,严格树 E5020 规避;助数字位面自拼不导,防菱形)。

// ---- 配置 ----

pub struct LimCfg {
    let ok: I64
    let err: I64
    let cap: I64
    let refil: I64
    let ivl: I64
    let maxif: I64
}

// err 码:0 ok / 1 参数面(cap/refil/ivl/maxif 任一 <= 0;单码登记)
pub fn lim_err_ok() -> I64 { return 0 }
pub fn lim_err_param() -> I64 { return 1 }

pub fn lcfg_ok(c: LimCfg) -> I64 { return c.ok }
pub fn lcfg_err(c: LimCfg) -> I64 { return c.err }
pub fn lcfg_cap(c: LimCfg) -> I64 { return c.cap }
pub fn lcfg_refil(c: LimCfg) -> I64 { return c.refil }
pub fn lcfg_ivl(c: LimCfg) -> I64 { return c.ivl }
pub fn lcfg_maxif(c: LimCfg) -> I64 { return c.maxif }

// 构造:cap = 桶容量(突发上限),refil = 每 ivl 补充令牌数,ivl = 补充
//   周期(注入时钟 tick 数),maxif = max-in-flight 上限
pub fn lim_cfg(cap: I64, refil: I64, ivl: I64, maxif: I64) -> LimCfg {
    if cap <= 0 || refil <= 0 || ivl <= 0 || maxif <= 0 {
        return LimCfg { ok: 0, err: lim_err_param(), cap: 0, refil: 0, ivl: 0, maxif: 0 }
    }
    return LimCfg { ok: 1, err: lim_err_ok(), cap: cap, refil: refil, ivl: ivl, maxif: maxif }
}

// ---- 令牌桶(显式值状态) ----

pub struct LimBkt {
    let tks: I64
    let last: I64
}

pub fn lb_tks(b: LimBkt) -> I64 { return b.tks }
pub fn lb_last(b: LimBkt) -> I64 { return b.last }

// 值构造面((h) 纪律:组合层以 getter 取旧桶态 + 本构造面重建,消费方
//   不直构字面量;状态下传 = 组合层注册表存 LimBkt 值)
pub fn lim_bkt(tks: I64, last: I64) -> LimBkt {
    return LimBkt { tks: tks, last: last }
}

// 新桶:满容量,last = 装配时注入时钟
pub fn lim_bkt_new(cap: I64, now: I64) -> LimBkt {
    return lim_bkt(cap, now)
}

// 判定结果:ok = 1 放行(新桶态随出)/ 0 拒(retry = Retry-After ticks;
//   拒面桶态仍前移补充步 —— 补充与消费正交,如实登记)
pub struct LimTake {
    let ok: I64
    let retry: I64
    let tks: I64
    let last: I64
}

pub fn lt_ok(t: LimTake) -> I64 { return t.ok }
pub fn lt_retry(t: LimTake) -> I64 { return t.retry }
pub fn lt_tks(t: LimTake) -> I64 { return t.tks }
pub fn lt_last(t: LimTake) -> I64 { return t.last }

pub fn lim_take(b: LimBkt, c: LimCfg, now: I64, cost: I64) -> LimTake {
    var tks = b.tks
    var last = b.last
    if now > last {
        let el = now - last
        let steps = el / c.ivl
        if steps > 0 {
            tks = tks + steps * c.refil
            if tks > c.cap {
                tks = c.cap
            }
            last = last + steps * c.ivl
        }
    }
    if tks >= cost {
        return LimTake { ok: 1, retry: 0, tks: tks - cost, last: last }
    }
    let need = cost - tks
    let retry = (need * c.ivl + c.refil - 1) / c.refil
    return LimTake { ok: 0, retry: retry, tks: tks, last: last }
}

// ---- max-in-flight 信号量(值形) ----

pub struct LimIf {
    let ok: I64
    let n: I64
}

pub fn lif_ok(x: LimIf) -> I64 { return x.ok }
pub fn lif_n(x: LimIf) -> I64 { return x.n }

// 获取:n+1 <= maxif → ok=1 携新值;满 → ok=0 shed(n 不动)
pub fn lim_acq(n: I64, maxif: I64) -> LimIf {
    if n + 1 > maxif {
        return LimIf { ok: 0, n: n }
    }
    return LimIf { ok: 1, n: n + 1 }
}

// 释放:下界 0(幂等防负 —— 重复 rel 语义由组合层纪律约束,值面兜底)
pub fn lim_rel(n: I64) -> I64 {
    if n <= 0 {
        return 0
    }
    return n - 1
}

// ---- per-IP 键(FNV 形算术散列) ----

// 宽域零播种(crypto.ct z64 同式:I64 变量以大字面量差分构造,值标签落宽域)
fn lm_z64() -> I64 {
    var w: I64 = 4294967296
    return w - w
}

// IP → 键(h*131+c mod 4294967291;无位运算,I64 域乘加模,h < 2^39 不越)
pub fn lim_ip_key(ip: Str) -> I64 {
    var h: I64 = lm_z64() + 4294967291
    h = h - 4294967291
    var i: I32 = 0
    while i < ip.len {
        let ch = byte_at(ip, i)
        h = (h * 131 + ch.as[I64]()) % 4294967291
        i += 1
    }
    return h
}

// ---- 响应构造(注入面:全整数自拼) ----

// I64 → 十进制(正域;0 兜底;cors.cs_num 同式自拼)
fn lm_num(v: I64) -> Str {
    if v <= 0 {
        return "0"
    }
    var out = ""
    var x: I64 = v
    while x > 0 {
        let d = (x % 10).as[I32]()
        out = byte_slice("0123456789", d, d + 1) + out
        x = x / 10
    }
    return out
}

// 503 过载/限流响应(retry = Retry-After 秒;body 12 字节)
pub fn lim_resp_503(retry: I64) -> Str {
    return "HTTP/1.1 503 Service Unavailable\r\n" + "Retry-After: " + lm_num(retry) + "\r\n" + "Content-Length: 12\r\n" + "\r\n" + "lim rejected"
}

// ---- inline tests(确定性语料见 tests/http/frm_mw/a_limit.ct) ----

test "take drain refill recover" {
    let c = lim_cfg(3, 1, 10, 8)
    assert(lcfg_ok(c) == 1)
    let b0 = lim_bkt_new(3, 100)
    // 三连耗尽
    let t1 = lim_take(b0, c, 100, 1)
    assert(lt_ok(t1) == 1 && lt_tks(t1) == 2)
    let b1 = LimBkt { tks: lt_tks(t1), last: lt_last(t1) }
    let t2 = lim_take(b1, c, 100, 1)
    assert(lt_ok(t2) == 1 && lt_tks(t2) == 1)
    let b2 = LimBkt { tks: lt_tks(t2), last: lt_last(t2) }
    let t3 = lim_take(b2, c, 100, 1)
    assert(lt_ok(t3) == 1 && lt_tks(t3) == 0)
    // 第四拒:retry = ceil(1*10/1) = 10
    let b3 = LimBkt { tks: lt_tks(t3), last: lt_last(t3) }
    let t4 = lim_take(b3, c, 100, 1)
    assert(lt_ok(t4) == 0 && lt_retry(t4) == 10)
    assert(lim_resp_503(lt_retry(t4)) == "HTTP/1.1 503 Service Unavailable\r\nRetry-After: 10\r\nContent-Length: 12\r\n\r\nlim rejected")
    // 恢复:now = 109(不足一步)仍拒;now = 110(恰一步)补 1 过
    let b4 = LimBkt { tks: lt_tks(t4), last: lt_last(t4) }
    let t5 = lim_take(b4, c, 109, 1)
    assert(lt_ok(t5) == 0)
    let t6 = lim_take(b4, c, 110, 1)
    assert(lt_ok(t6) == 1 && lt_tks(t6) == 0 && lt_last(t6) == 110)
    // 突发封顶:长闲补足 cap 不越
    let b5 = LimBkt { tks: 2, last: 100 }
    let t7 = lim_take(b5, c, 1000, 1)
    assert(lt_ok(t7) == 1 && lt_tks(t7) == 2)
}

test "acq shed rel and cfg" {
    let c1 = lim_cfg(0, 1, 1, 1)
    assert(lcfg_ok(c1) == 0 && lcfg_err(c1) == lim_err_param())
    let a1 = lim_acq(0, 2)
    assert(lif_ok(a1) == 1 && lif_n(a1) == 1)
    let a2 = lim_acq(lif_n(a1), 2)
    assert(lif_ok(a2) == 1 && lif_n(a2) == 2)
    // 满载 shed:n 不动
    let a3 = lim_acq(lif_n(a2), 2)
    assert(lif_ok(a3) == 0 && lif_n(a3) == 2)
    // 释放 + 下界
    assert(lim_rel(lif_n(a2)) == 1)
    assert(lim_rel(0) == 0)
    // per-IP 键:确定性 + 相异
    assert(lim_ip_key("1.2.3.4") == lim_ip_key("1.2.3.4"))
    assert(lim_ip_key("1.2.3.4") != lim_ip_key("5.6.7.8"))
}
