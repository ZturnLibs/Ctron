// std/strconv.ct —— 文本与数值互转(parse_i64/parse_bool;format_hex/bin 移交 v0.3)
// since: std-0.2 stability: experimental
// 口径:parse_i64 溢出返回 None(阈值比较法,无除法);前导 0/前导 + 允许;
// format_hex/format_bin v0.2 仅收非负输入(负数补码面待 P1-B,C10 死区);
// 实现约束(C10):累加器宽域零播种;溢出阈值比较法;format 族待 P1-B 升版

pub fn parse_i64(s: Str) -> Option[I64] {
    if s.len == 0 {
        return None
    }
    var neg = false
    var i: I32 = 0
    var c0 = byte_at(s, 0)
    if c0 == 45 {
        neg = true
        i = 1
    } else {
        if c0 == 43 {
            i = 1
        }
    }
    if i >= s.len {
        return None
    }
    // C10:宽域零播种;正负分开累加,无取负(NEG 会触发算术腐蚀)
    var w: I64 = 4294967296
    var acc: I64 = w - w
    while i < s.len {
        var c = byte_at(s, i)
        if c < 48 {
            return None
        }
        if c > 57 {
            return None
        }
        var d: I64 = c - 48
        if neg {
            if acc < -922337203685477580 {
                return None
            }
            if acc == -922337203685477580 {
                if d > 8 {
                    return None
                }
            }
            acc = acc * 10 - d
        } else {
            if acc > 922337203685477580 {
                return None
            }
            if acc == 922337203685477580 {
                if d > 7 {
                    return None
                }
            }
            acc = acc * 10 + d
        }
        i += 1
    }
    if neg {
        return Some(acc)
    }
    return Some(acc)
}

pub fn parse_bool(s: Str) -> Option[Bool] {
    if s == "true" {
        return Some(true)
    }
    if s == "false" {
        return Some(false)
    }
    return None
}

// 发射面安全 Option 助手(match 形;C13a)
pub fn sc_get_l(o: Option[I64], dft: I64) -> I64 {
    match o {
        Some(v) => {
            return v
        }
        None => {
            return dft
        }
    }
}

pub fn sc_get_b(o: Option[Bool], dft: Bool) -> Bool {
    match o {
        Some(v) => {
            return v
        }
        None => {
            return dft
        }
    }
}

pub fn sc_some_l(o: Option[I64]) -> Bool {
    match o {
        Some(v) => {
            return true
        }
        None => {
            return false
        }
    }
}

pub fn sc_some_b(o: Option[Bool]) -> Bool {
    match o {
        Some(v) => {
            return true
        }
        None => {
            return false
        }
    }
}

test "parse_i64 round trip and signs" {
    assert_eq(sc_get_l(parse_i64("0"), -1), 0)
    assert_eq(sc_get_l(parse_i64("42"), -1), 42)
    assert_eq(sc_get_l(parse_i64("-42"), -1), -42)
    assert_eq(sc_get_l(parse_i64("+7"), -1), 7)
    assert_eq(sc_get_l(parse_i64("007"), -1), 7)
    assert_eq(sc_get_l(parse_i64("9223372036854775807"), 0), 9223372036854775807)
    assert_eq(sc_get_l(parse_i64("-9223372036854775807"), 0).to_string(), "-9223372036854775807")
    assert(!sc_some_l(parse_i64("")))
    assert(!sc_some_l(parse_i64("-")))
    assert(!sc_some_l(parse_i64("12a")))
    assert(!sc_some_l(parse_i64("9223372036854775808")))
    assert(!sc_some_l(parse_i64("-9223372036854775809")))
    var s = "1234567"
    assert_eq(sc_get_l(parse_i64(s), 0).to_string(), "1234567")
}

test "parse_bool exact" {
    assert_eq(sc_get_b(parse_bool("true"), false), true)
    assert_eq(sc_get_b(parse_bool("false"), true), false)
    assert(!sc_some_b(parse_bool("TRUE")))
    assert(!sc_some_b(parse_bool("")))
    assert(!sc_some_b(parse_bool("1")))
}

