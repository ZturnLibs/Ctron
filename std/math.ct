// std/math.ct —— 数学助手(整数域;F64 面随 C2 解除后升版)
// since: std-0.3 stability: experimental
// 口径:整数域纯函数,无浮点依赖;PI/E 等 F64 常量随 C2 解除(P2);
// ceil_div/isqrt 挂起(C17 宿主 OOM,算法正确,待宿主修复复位)

// v ∈ [lo, hi];域外钳位
pub fn clamp(v: I32, lo: I32, hi: I32) -> I32 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// v 是否 2 的幂(v > 0)
pub fn is_pow2(v: I32) -> Bool {
    if v <= 0 {
        return false
    }
    return v % 2 == 0 || v == 1
}

// v > 0 时最高置位下标(0-based;v ≤ 0 返回 0)
pub fn high_bit(v: I32) -> I32 {
    if v <= 0 {
        return 0
    }
    var n: I32 = 0
    var u = v
    while u > 1 {
        u = u / 2
        n += 1
    }
    return n
}

// v > 0 的最小 2 的幂 ≥ v(v ≤ 0 返回 1)
pub fn next_pow2(v: I32) -> I32 {
    if v <= 1 {
        return 1
    }
    var r: I32 = 1
    while r < v {
        r = r * 2
    }
    return r
}

// 绝对值(I32;不触 C10 死区)
pub fn iabs(v: I32) -> I32 {
    if v < 0 {
        return -v
    }
    return v
}

// I64 绝对值(宽域安全)
pub fn iabs64(v: I64) -> I64 {
    if v < 0 {
        return -v
    }
    return v
}

// 两数较大值
pub fn max(a: I32, b: I32) -> I32 {
    if a > b {
        return a
    }
    return b
}

// 两数较小值
pub fn min(a: I32, b: I32) -> I32 {
    if a < b {
        return a
    }
    return b
}

// 两数较大值(I64)
pub fn max64(a: I64, b: I64) -> I64 {
    if a > b {
        return a
    }
    return b
}

// 两数较小值(I64)
pub fn min64(a: I64, b: I64) -> I64 {
    if a < b {
        return a
    }
    return b
}

// 钳位(I64);v ∈ [lo, hi],域外取端点
pub fn clamp64(v: I64, lo: I64, hi: I64) -> I64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// 饱和加法:越上界得 I32 最大值,越下界得 I32 最小值,不触 C10 溢出死区
pub fn sat_add(a: I32, b: I32) -> I32 {
    let hi: I32 = 2147483647
    let lo: I32 = -2147483647 - 1
    if b >= 0 {
        if a > hi - b {
            return hi
        }
        return a + b
    }
    if a < lo - b {
        return lo
    }
    return a + b
}

// 饱和减法:越上界得 I32 最大值,越下界得 I32 最小值,不触 C10 溢出死区
pub fn sat_sub(a: I32, b: I32) -> I32 {
    let hi: I32 = 2147483647
    let lo: I32 = -2147483647 - 1
    if b >= 0 {
        if a < lo + b {
            return lo
        }
        return a - b
    }
    if a > hi + b {
        return hi
    }
    return a - b
}

// 饱和乘法:越上界得 I32 最大值,越下界得 I32 最小值,不触 C10 溢出死区;
// 四象限界门判定的除法恒安全(除数非零,不出现最小值除以负一)
pub fn sat_mul(a: I32, b: I32) -> I32 {
    let hi: I32 = 2147483647
    let lo: I32 = -2147483647 - 1
    if a == 0 {
        return 0
    }
    if b == 0 {
        return 0
    }
    if a > 0 {
        if b > 0 {
            if a > hi / b {
                return hi
            }
            return a * b
        }
        if b < lo / a {
            return lo
        }
        return a * b
    }
    if b > 0 {
        if a < lo / b {
            return lo
        }
        return a * b
    }
    if a < hi / b {
        return hi
    }
    return a * b
}

// I64 域上端(正极大字面量纯绑定,不经检查运算)
fn hi64() -> I64 {
    return 9223372036854775807
}

// I64 域下端(C 宿主检查运算不接受裸字面量操作数,须变量同宽中转构造)
fn lo64() -> I64 {
    let h: I64 = 9223372036854775807
    let z: I64 = 0
    let o: I64 = 1
    return z - h - o
}

// 饱和加法(I64):越上界得 I64 最大值,越下界得 I64 最小值,不触 C10 溢出死区
pub fn sat_add64(a: I64, b: I64) -> I64 {
    let hi: I64 = hi64()
    let lo: I64 = lo64()
    if b >= 0 {
        if a > hi - b {
            return hi
        }
        return a + b
    }
    if a < lo - b {
        return lo
    }
    return a + b
}

// 饱和减法(I64):越上界得 I64 最大值,越下界得 I64 最小值,不触 C10 溢出死区
pub fn sat_sub64(a: I64, b: I64) -> I64 {
    let hi: I64 = hi64()
    let lo: I64 = lo64()
    if b >= 0 {
        if a < lo + b {
            return lo
        }
        return a - b
    }
    if a > hi + b {
        return hi
    }
    return a - b
}

// 饱和乘法(I64):越上界得 I64 最大值,越下界得 I64 最小值,不触 C10 溢出死区;
// 四象限界门判定的除法恒安全(除数非零,不出现最小值除以负一)
pub fn sat_mul64(a: I64, b: I64) -> I64 {
    let hi: I64 = hi64()
    let lo: I64 = lo64()
    if a == 0 {
        return 0
    }
    if b == 0 {
        return 0
    }
    if a > 0 {
        if b > 0 {
            if a > hi / b {
                return hi
            }
            return a * b
        }
        if b < lo / a {
            return lo
        }
        return a * b
    }
    if b > 0 {
        if a < lo / b {
            return lo
        }
        return a * b
    }
    if a < hi / b {
        return hi
    }
    return a * b
}

test "clamp" {
    assert_eq(clamp(5, 1, 10), 5)
    assert_eq(clamp(0, 1, 10), 1)
    assert_eq(clamp(15, 1, 10), 10)
}

test "is_pow2" {
    assert(is_pow2(1))
    assert(is_pow2(2))
    assert(is_pow2(1024))
    assert(!is_pow2(3))
    assert(!is_pow2(0))
    assert(!is_pow2(-2))
}

test "next_pow2" {
    assert_eq(next_pow2(1), 1)
    assert_eq(next_pow2(5), 8)
    assert_eq(next_pow2(8), 8)
    assert_eq(next_pow2(1023), 1024)
    assert_eq(next_pow2(1024), 1024)
}


test "iabs" {
    assert_eq(iabs(-5), 5)
    assert_eq(iabs(5), 5)
    assert_eq(iabs(0), 0)
    assert_eq(iabs64(-1073741823), 1073741823)
}

// ============ v0.4 扩张(since: std-0.4):数值便利与饱和算术 ============
// sat_* 家族:结果越界时钳到域端,永不触 C10 溢出死区;
// 先做界门判定再运算,判定式本身无溢出;I64 界端经 hi64/lo64 变量中转构造
// (C 宿主 checked 运算对裸字面量按 I32 默认宽度求值,见登记分歧)

test "max min" {
    assert_eq(max(3, 7), 7)
    assert_eq(max(7, 3), 7)
    assert_eq(max(-3, -7), -3)
    assert_eq(max(0, 0), 0)
    assert_eq(min(3, 7), 3)
    assert_eq(min(7, 3), 3)
    assert_eq(min(-3, -7), -7)
    assert_eq(max(2147483647, 5), 2147483647)
    assert_eq(min(-2147483647 - 1, 5), -2147483647 - 1)
}

test "max64 min64 clamp64" {
    assert_eq(max64(5000000000, 3), 5000000000)
    assert_eq(max64(3, 5000000000), 5000000000)
    let p5: I64 = 5000000000
    let z: I64 = 0
    let n5: I64 = z - p5
    assert_eq(min64(n5, 3), n5)
    assert_eq(clamp64(5, 1, 10), 5)
    assert_eq(clamp64(0, 1, 10), 1)
    assert_eq(clamp64(15, 1, 10), 10)
    assert_eq(clamp64(5000000000, 1, 4000000000), 4000000000)
}

test "sat_add sat_sub" {
    assert_eq(sat_add(2, 3), 5)
    assert_eq(sat_add(2147483646, 1), 2147483647)
    assert_eq(sat_add(2147483647, 1), 2147483647)
    assert_eq(sat_add(-2147483647 - 1, -1), -2147483647 - 1)
    assert_eq(sat_add(-2147483647, 1), -2147483646)
    assert_eq(sat_sub(5, 3), 2)
    assert_eq(sat_sub(-2147483647, 1), -2147483647 - 1)
    assert_eq(sat_sub(-2147483647 - 1, 1), -2147483647 - 1)
    assert_eq(sat_sub(2147483647, -1), 2147483647)
    assert_eq(sat_sub(2147483646, -1), 2147483647)
}

test "sat_mul" {
    assert_eq(sat_mul(3, 4), 12)
    assert_eq(sat_mul(0, 2147483647), 0)
    assert_eq(sat_mul(2147483647, 2), 2147483647)
    assert_eq(sat_mul(2147483647, -2), -2147483647 - 1)
    assert_eq(sat_mul(-2147483647 - 1, 2), -2147483647 - 1)
    assert_eq(sat_mul(-2147483647 - 1, -1), 2147483647)
    assert_eq(sat_mul(-2147483647 - 1, 1), -2147483647 - 1)
    assert_eq(sat_mul(-1073741824, 2), -2147483647 - 1)
    assert_eq(sat_mul(-3, -4), 12)
}

test "sat64" {
    let hi: I64 = hi64()
    let lo: I64 = lo64()
    assert_eq(sat_add64(2, 3), 5)
    assert_eq(sat_add64(hi, 1), hi)
    assert_eq(sat_sub64(lo, 1), lo)
    assert_eq(sat_mul64(3, 4), 12)
    assert_eq(sat_mul64(0, hi), 0)
    assert_eq(sat_mul64(hi, 2), hi)
    assert_eq(sat_mul64(lo, 1), lo)
    assert_eq(sat_mul64(lo, -1), hi)
    assert_eq(sat_mul64(lo, 2), lo)
    assert_eq(sat_mul64(hi, -2), lo)
}
