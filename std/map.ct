// std/map.ct —— Map[K, V] 种子(双 List 平行槽;函数式:put 返回新映射)
// K 需可 ==(bound Eq:标量原生可等/派生结构体逐字段);调用点经显式 TypeArgs 实例化(v0)
struct Map[K, V] {
    let ks: List[K]
    let vs: List[V]
}

pub fn map_new[K, V]() -> Map[K, V] {
    return Map { ks: List[K](), vs: List[V]() }
}

pub fn put[K: Eq, V](m: Map[K, V], k: K, v: V) -> Map[K, V] {
    var nks = List[K]()
    var nvs = List[V]()
    var i: I32 = 0
    var hit = false
    while i < m.ks.len {
        if m.ks[i] == k {
            nks.push(k)
            nvs.push(v)
            hit = true
        } else {
            nks.push(m.ks[i])
            nvs.push(m.vs[i])
        }
        i = i + 1
    }
    if !hit {
        nks.push(k)
        nvs.push(v)
    }
    return Map { ks: nks, vs: nvs }
}

pub fn get[K: Eq, V](m: Map[K, V], k: K, dft: V) -> V {
    var i: I32 = 0
    while i < m.ks.len {
        if m.ks[i] == k {
            return m.vs[i]
        }
        i = i + 1
    }
    return dft
}

pub fn has[K: Eq, V](m: Map[K, V], k: K) -> Bool {
    var i: I32 = 0
    while i < m.ks.len {
        if m.ks[i] == k {
            return true
        }
        i = i + 1
    }
    return false
}

// 键表/值表(首插序;覆盖写不移位)。返回内部 List 的克隆(读即深克隆语义锚)。
pub fn keys[K, V](m: Map[K, V]) -> List[K] {
    return m.ks
}

pub fn values[K, V](m: Map[K, V]) -> List[V] {
    return m.vs
}

test "keys/values insertion order, replace keeps slot" {
    var m = map_new[I32, Str]()
    m = put[I32, Str](m, 2, "two")
    m = put[I32, Str](m, 1, "one")
    m = put[I32, Str](m, 2, "TWO")
    var ks = keys[I32, Str](m)
    var vs = values[I32, Str](m)
    assert(ks.len == 2)
    assert(ks[0] == 2)
    assert(ks[1] == 1)
    assert(vs[0] == "TWO")
    assert(vs[1] == "one")
}


// ============ v0.3 完备性:大小与删除(函数式,返回新映射) ============

// 键值对数
pub fn map_len[K, V](m: Map[K, V]) -> I32 {
    return m.ks.len
}

// 删除键:不存在时原样返回(函数式,原映射不变)
pub fn map_del[K, V](m: Map[K, V], k: K) -> Map[K, V] {
    var nks = List[K]()
    var nvs = List[V]()
    var i: I32 = 0
    var hit = false
    while i < m.ks.len {
        if m.ks[i] == k {
            hit = true
        } else {
            nks.push(m.ks[i])
            nvs.push(m.vs[i])
        }
        i = i + 1
    }
    if !hit {
        return m
    }
    return Map { ks: nks, vs: nvs }
}

test "map_len counts pairs" {
    var m = map_new[I32, Str]()
    assert_eq(map_len[I32, Str](m), 0)
    m = put[I32, Str](m, 1, "a")
    m = put[I32, Str](m, 2, "b")
    assert_eq(map_len[I32, Str](m), 2)
    m = put[I32, Str](m, 1, "a2")
    assert_eq(map_len[I32, Str](m), 2)
}

test "map_del removes and keeps others" {
    var m = map_new[I32, Str]()
    m = put[I32, Str](m, 1, "a")
    m = put[I32, Str](m, 2, "b")
    m = put[I32, Str](m, 3, "c")
    m = map_del[I32, Str](m, 2)
    assert_eq(map_len[I32, Str](m), 2)
    assert(has[I32, Str](m, 1))
    assert(!has[I32, Str](m, 2))
    assert(has[I32, Str](m, 3))
    // 删除不存在的键:原样返回
    var m2 = map_del[I32, Str](m, 99)
    assert_eq(map_len[I32, Str](m2), 2)
    // 删空
    m = map_del[I32, Str](m, 1)
    m = map_del[I32, Str](m, 3)
    assert_eq(map_len[I32, Str](m), 0)
}
