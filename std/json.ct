// std/json.ct —— JSON 解析与序列化(路径展平 DOM;RFC 8259;v0 口径见文末)

// ============ 序列化 ============

// Str → JSON 字符串字面量(含引号;转义 " \ 与控制字符;UTF-8 透传)
pub fn esc(s: Str) -> Str {
    var e = "\\"
    var out = "\""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if c == 34 { out = out + e + "\"" } else if c == 92 { out = out + e + e } else if c == 8 { out = out + e + "b" } else if c == 9 { out = out + e + "t" } else if c == 10 { out = out + e + "n" } else if c == 12 { out = out + e + "f" } else if c == 13 { out = out + e + "r" } else if c < 32 {
            var hi = byte_slice("0123456789ABCDEF", c / 16, c / 16 + 1)
            var lo = byte_slice("0123456789ABCDEF", c % 16, c % 16 + 1)
            out = out + "\\u00" + hi + lo
        } else {
            out = out + byte_slice(s, i, i + 1)
        }
        i += 1
    }
    return out + "\""
}

// ============ 解析 ============

// 可打印 ASCII 表(\u 解码用;首字符为空格,下标 = 码点 - 32;\{ 为字面花括号)
fn jprint() -> Str {
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|}~"
}

// JSON 字符串转义还原(\u 仅解码可打印 ASCII;其余原样保留,v0 口径)
pub fn unesc(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    while i < s.len {
        var c = byte_at(s, i)
        if c == 92 && i + 1 < s.len {
            var d = byte_at(s, i + 1)
            if d == 34 { out = out + "\""; i += 2 } else if d == 92 { out = out + "\\"; i += 2 } else if d == 47 { out = out + "/"; i += 2 } else if d == 110 { out = out + "\n"; i += 2 } else if d == 116 { out = out + "\t"; i += 2 } else if d == 114 { out = out + "\r"; i += 2 } else if d == 117 && i + 5 < s.len {
                var cp = hex4(s, i + 2)
                if cp >= 32 && cp <= 126 {
                    out = out + byte_slice(jprint(), cp - 32, cp - 31)
                } else {
                    out = out + byte_slice(s, i, i + 6)
                }
                i += 6
            } else {
                out = out + byte_slice(s, i, i + 2)
                i += 2
            }
        } else {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}

// 4 位十六进制 → 码点(非法字符按 0 计)
fn hex4(s: Str, i: I32) -> I32 {
    var v: I32 = 0
    var k: I32 = 0
    while k < 4 {
        var c = byte_at(s, i + k)
        var d: I32 = 0
        if c >= 48 && c <= 57 { d = c - 48 } else if c >= 97 && c <= 102 { d = c - 97 + 10 } else if c >= 65 && c <= 70 { d = c - 65 + 10 }
        v = v * 16 + d
        k += 1
    }
    return v
}

// 跳过空白
fn jskip(s: Str, i: I32) -> I32 {
    var i2 = i
    while i2 < s.len {
        var c = byte_at(s, i2)
        if c == 32 || c == 9 || c == 10 || c == 13 { i2 += 1 } else { return i2 }
    }
    return i2
}

// 解析结果条目:[路径, 标签, 值]。标签:z=null b=Bool n=number s=Str
// a=数组 o=对象(值为空串)。Bool/number 值为原文。根路径 "$"。
// 条目顺序:父先于子(对象/数组在开括号处记录)。

// 共享解析态(err 槽非空 = 已出错)
fn jstate() -> List[Str] {
    var st = List[Str]()
    st.push("")
    st.push("")
    return st
}

fn jerr(st: List[Str], msg: Str) {
    if st[0] == "" { st[0] = msg }
}

// 数值扫描:返回结束下标(原始文本由调用方切片)
fn jnum_end(s: Str, i: I32) -> I32 {
    var i2 = i
    if i2 < s.len && byte_at(s, i2) == 45 { i2 += 1 }
    while i2 < s.len && byte_at(s, i2) >= 48 && byte_at(s, i2) <= 57 { i2 += 1 }
    if i2 < s.len && byte_at(s, i2) == 46 {
        i2 += 1
        while i2 < s.len && byte_at(s, i2) >= 48 && byte_at(s, i2) <= 57 { i2 += 1 }
    }
    if i2 < s.len && (byte_at(s, i2) == 101 || byte_at(s, i2) == 69) {
        i2 += 1
        if i2 < s.len && (byte_at(s, i2) == 43 || byte_at(s, i2) == 45) { i2 += 1 }
        while i2 < s.len && byte_at(s, i2) >= 48 && byte_at(s, i2) <= 57 { i2 += 1 }
    }
    return i2
}

// 字符串扫描:返回结束下标(闭引号后);错误返回 -1
fn jstr_end(s: Str, i: I32) -> I32 {
    var i2 = i + 1
    while i2 < s.len {
        var c = byte_at(s, i2)
        if c == 34 { return i2 }
        if c == 92 { i2 += 1 }
        if c < 32 { return -1 }
        i2 += 1
    }
    return -1
}

// 值解析:pre 为当前路径;返回新下标;错误置 st[0] 并返回 -1
fn jval(s: Str, i: I32, pre: Str, st: List[Str], out: List[List[Str]]) -> I32 {
    var i2 = jskip(s, i)
    if i2 >= s.len {
        jerr(st, "意外结束 @" + pre)
        return -1
    }
    var c = byte_at(s, i2)
    if c == 123 {
        var ent = List[Str]()
        ent.push(pre)
        ent.push("o")
        ent.push("")
        out.push(ent)
        var penv = pre + "."
        i2 = jskip(s, i2 + 1)
        if i2 < s.len && byte_at(s, i2) == 125 { return jskip(s, i2 + 1) }
        while i2 < s.len {
            if byte_at(s, i2) != 34 {
                jerr(st, "对象键须为字符串 @" + pre)
                return -1
            }
            var kend = jstr_end(s, i2)
            if kend < 0 {
                jerr(st, "键字符串未闭合 @" + pre)
                return -1
            }
            var key = unesc(byte_slice(s, i2 + 1, kend))
            i2 = jskip(s, kend + 1)
            if i2 >= s.len || byte_at(s, i2) != 58 {
                jerr(st, "对象缺冒号 @" + pre)
                return -1
            }
            var ni = jval(s, jskip(s, i2 + 1), penv + key, st, out)
            if ni < 0 { return -1 }
            i2 = jskip(s, ni)
            if i2 < s.len && byte_at(s, i2) == 44 { i2 = jskip(s, i2 + 1) } else if i2 < s.len && byte_at(s, i2) == 125 { return jskip(s, i2 + 1) } else {
                jerr(st, "对象缺 } 或 , @" + pre)
                return -1
            }
        }
        jerr(st, "对象未闭合 @" + pre)
        return -1
    }
    if c == 91 {
        var ent = List[Str]()
        ent.push(pre)
        ent.push("a")
        ent.push("")
        out.push(ent)
        var parr = pre + "."
        i2 = jskip(s, i2 + 1)
        if i2 < s.len && byte_at(s, i2) == 93 { return jskip(s, i2 + 1) }
        var idx: I32 = 0
        while i2 < s.len {
            var ni = jval(s, i2, parr + idx.to_string(), st, out)
            if ni < 0 { return -1 }
            idx += 1
            i2 = jskip(s, ni)
            if i2 < s.len && byte_at(s, i2) == 44 { i2 = jskip(s, i2 + 1) } else if i2 < s.len && byte_at(s, i2) == 93 { return jskip(s, i2 + 1) } else {
                jerr(st, "数组缺 ] 或 , @" + pre)
                return -1
            }
        }
        jerr(st, "数组未闭合 @" + pre)
        return -1
    }
    if c == 34 {
        var send = jstr_end(s, i2)
        if send < 0 {
            jerr(st, "字符串未闭合 @" + pre)
            return -1
        }
        var ent = List[Str]()
        ent.push(pre)
        ent.push("s")
        ent.push(unesc(byte_slice(s, i2 + 1, send)))
        out.push(ent)
        return jskip(s, send + 1)
    }
    if c == 116 && i2 + 4 <= s.len && byte_slice(s, i2, i2 + 4) == "true" {
        var ent = List[Str]()
        ent.push(pre)
        ent.push("b")
        ent.push("true")
        out.push(ent)
        return jskip(s, i2 + 4)
    }
    if c == 102 && i2 + 5 <= s.len && byte_slice(s, i2, i2 + 5) == "false" {
        var ent = List[Str]()
        ent.push(pre)
        ent.push("b")
        ent.push("false")
        out.push(ent)
        return jskip(s, i2 + 5)
    }
    if c == 110 && i2 + 4 <= s.len && byte_slice(s, i2, i2 + 4) == "null" {
        var ent = List[Str]()
        ent.push(pre)
        ent.push("z")
        ent.push("")
        out.push(ent)
        return jskip(s, i2 + 4)
    }
    if c == 45 || (c >= 48 && c <= 57) {
        var ne = jnum_end(s, i2)
        var ent = List[Str]()
        ent.push(pre)
        ent.push("n")
        ent.push(byte_slice(s, i2, ne))
        out.push(ent)
        return jskip(s, ne)
    }
    jerr(st, "意外字节 @" + pre)
    return -1
}

// 解析 JSON 文本 → 展平条目表([路径, 标签, 值] 的列表);
// 解析失败 → Err(消息)。查询用 qtag/qval。
pub fn parse(s: Str) -> Result[List[List[Str]], Str] {
    var st = jstate()
    var out = List[List[Str]]()
    var ni = jval(s, 0, "$", st, out)
    if ni < 0 {
        return Err(st[0])
    }
    var end = jskip(s, ni)
    if end < s.len {
        return Err("结尾有多余内容")
    }
    return Ok(out)
}

// 查询:路径对应的标签(空串 = 不存在)
pub fn qtag(entries: List[List[Str]], path: Str) -> Str {
    var i: I32 = 0
    while i < entries.len {
        if entries[i][0] == path { return entries[i][1] }
        i += 1
    }
    return ""
}

// 查询:路径对应的值(标量原文;容器为空串;不存在为空串)
pub fn qval(entries: List[List[Str]], path: Str) -> Str {
    var i: I32 = 0
    while i < entries.len {
        if entries[i][0] == path { return entries[i][2] }
        i += 1
    }
    return ""
}

// ============ 测试 ============

test "esc round trip" {
    let e = esc("tab\there")
    assert_eq(e, "\"tab\\there\"")
}

test "parse array of scalars" {
    let r = parse("[\"alpha\", 42, true, null, -3.5]")
    let es = match r {
        Ok(v) => v
        Err(m) => {
            println(m)
            return 1
        }
    }
    assert_eq(qval(es, "$.0"), "alpha")
    assert_eq(qtag(es, "$.0"), "s")
    assert_eq(qval(es, "$.1"), "42")
    assert_eq(qtag(es, "$.2"), "b")
    assert_eq(qtag(es, "$.3"), "z")
    assert_eq(qval(es, "$.4"), "-3.5")
}

test "parse nested arrays" {
    let r = parse("[[1, 2], [3]]")
    let es = match r {
        Ok(v) => v
        Err(m) => {
            println(m)
            return 1
        }
    }
    assert_eq(qtag(es, "$"), "a")
    assert_eq(qtag(es, "$.0"), "a")
    assert_eq(qval(es, "$.0.0"), "1")
    assert_eq(qval(es, "$.0.1"), "2")
    assert_eq(qval(es, "$.1.0"), "3")
}

test "parse strings with escapes" {
    let r = parse("[\"a\\nb\"]")
    let es = match r {
        Ok(v) => v
        Err(m) => {
            println(m)
            return 1
        }
    }
    assert_eq(qval(es, "$.0"), "a\nb")
}

test "parse errors are signaled" {
    let r = parse("[1, ")
    let bad = match r {
        Ok(v) => v
        Err(m) => {
            println(m)
            return 1
        }
    }
    assert_eq(bad.len, 0)
}

// v0 口径:\uXXXX 仅解码可打印 ASCII,其余原样保留;代理对与多字节未做。
// 块尾值引用 Drop 绑定、发射面方法调用等语言能力就绪后,DOM 可升级为
// JVal 枚举 + 动态容器。

fn main() -> I32 {
    return 0
}
