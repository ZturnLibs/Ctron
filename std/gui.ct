// ==================== 迷你词法(同步自 s6/s7) ====================

fn gws(src: Str, cur: Atomic[I32]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        var b: I32 = byte_at(src, cur.load())
        if b == 47 {
            if cur.load() + 1 < n {
                if byte_at(src, cur.load() + 1) == 47 {
                    cur.store(cur.load() + 2)
                    while cur.load() < n {
                        if byte_at(src, cur.load()) == 10 {
                            break
                        }
                        cur.store(cur.load() + 1)
                    }
                    continue
                }
            }
        }
        if b == 32 {
            cur.store(cur.load() + 1)
        } else {
            if b == 10 {
                cur.store(cur.load() + 1)
            } else {
                if b == 13 {
                    cur.store(cur.load() + 1)
                } else {
                    if b == 9 {
                        cur.store(cur.load() + 1)
                    } else {
                        return 0
                    }
                }
            }
        }
    }
    return 0
}

fn gword(src: Str, cur: Atomic[I32]) -> Str {
    gws(src, cur)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        var al: Bool = b >= 65 && b <= 90
        var low: Bool = b >= 97 && b <= 122
        var dg: Bool = b >= 48 && b <= 57
        if al {
            i += 1
        } else {
            if low {
                i += 1
            } else {
                if b == 95 {
                    i += 1
                } else {
                    if b == 45 {
                        i += 1
                    } else {
                        if dg {
                            i += 1
                        } else {
                            break
                        }
                    }
                }
            }
        }
    }
    cur.store(i)
    if i > start {
        return byte_slice(src, start, i)
    }
    panic("gui: 期待标识符 @byte " + cur.load().to_string())
    return ""
}

fn glit(src: Str, cur: Atomic[I32], c: I32) -> I32 {
    gws(src, cur)
    if byte_at(src, cur.load()) != c {
        var around: Str = "?"
        if cur.load() > 40 {
            around = byte_slice(src, cur.load() - 40, cur.load())
        } else {
            around = byte_slice(src, 0, cur.load())
        }
        panic("gui: 期待字符码 " + c.to_string() + " @byte " + cur.load().to_string() + " srclen=" + src.len.to_string() + " 前文=[" + around + "]")
    }
    cur.store(cur.load() + 1)
    return 0
}

fn gstr(src: Str, cur: Atomic[I32]) -> Str {
    glit(src, cur, 34)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == 34 {
            break
        }
        i += 1
    }
    cur.store(i + 1)
    return byte_slice(src, start, i)
}

fn gspan(src: Str, cur: Atomic[I32], stop: I32) -> Str {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == stop {
            break
        }
        i += 1
    }
    var e: I32 = i
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    while e > start {
        var c1: I32 = byte_at(src, e - 1)
        if c1 == 32 {
            e -= 1
        } else {
            if c1 == 10 {
                e -= 1
            } else {
                if c1 == 9 {
                    e -= 1
                } else {
                    break
                }
            }
        }
    }
    cur.store(i)
    if e > start {
        return byte_slice(src, start, e)
    }
    return ""
}

fn ghex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui: 非法十六进制")
    return 0
}

fn g_parse_color(v: Str) -> I32 {
    if byte_at(v, 0) == 35 {
        if v.len != 7 {
            panic("gui: 颜色须 #RRGGBB,得 " + v)
        }
        var r: I32 = ghex1(byte_at(v, 1)) * 16 + ghex1(byte_at(v, 2))
        var g: I32 = ghex1(byte_at(v, 3)) * 16 + ghex1(byte_at(v, 4))
        var b: I32 = ghex1(byte_at(v, 5)) * 16 + ghex1(byte_at(v, 6))
        return r * 65536 + g * 256 + b
    }
    panic("gui: 未知颜色令牌 " + v)
    return 0
}

fn gs2i(s: Str) -> I32 {
    var v: I32 = 0
    var i: I32 = 0
    while i < s.len {
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    }
    return v
}

pub struct GuiTree {
    var ntag: List[Str]
    var nflag: List[Str]
    var ncls: List[Str]
    var npre: List[Str]
    var nbid: List[Str]
    var npost: List[Str]
    var nfc: List[I32]
    var ns: List[I32]
    var nes: List[I32]
    var nec: List[I32]
    var ev_name: List[Str]
    var ev_fn: List[Str]
    var btns: List[I32]
    var sk: List[Str]
    var sv: List[Str]
}

fn gt_new() -> GuiTree {
    return GuiTree {
        ntag: List[Str](),
        ncls: List[Str](),
        npre: List[Str](),
        nbid: List[Str](),
        npost: List[Str](),
        nfc: List[I32](),
        ns: List[I32](),
        nes: List[I32](),
        nec: List[I32](),
        ev_name: List[Str](),
        ev_fn: List[Str](),
        btns: List[I32](),
        sk: List[Str](),
        sv: List[Str](),
        nflag: List[Str]()
    }
}

fn gt_attrs(src: Str, cur: Atomic[I32], t: GuiTree, conds: List[Str], binds: List[Str], strs: List[Str]) -> Str {
    var out: Str = ""
    while true {
        gws(src, cur)
        var b: I32 = byte_at(src, cur.load())
        if b == 62 || b == 47 {
            // > 结束;/ = 自闭合标记(input/>,留给调用方消费)
            break
        }
        var an: Str = gword(src, cur)
        if an == "on" {
            glit(src, cur, 58)
            var evn: Str = gword(src, cur)
            glit(src, cur, 61)
            glit(src, cur, 123)
            var fnn: Str = gword(src, cur)
            glit(src, cur, 125)
            t.ev_name.push(evn)
            t.ev_fn.push(fnn)
        } else {
            glit(src, cur, 61)
            // 花括号属性值(cond={名}):单词直取(绑定名,SL-5 when 通道)
            var av: Str = ""
            if byte_at(src, cur.load()) == 123 {
                glit(src, cur, 123)
                av = gword(src, cur)
                glit(src, cur, 125)
            } else {
                av = gstr(src, cur)
            }
            if an == "class" {
                out = av
            }
            if an == "cond" {
                conds.push(av)
            }
            if an == "bind" {
                binds.push(av)
            }
            if an == "placeholder" {
                strs.push(av)
            }
        }
    }
    return out
}

fn gt_leaf_text(src: Str, cur: Atomic[I32], t: GuiTree) -> I32 {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 123 {
            break
        }
        if b == 60 {
            break
        }
        i += 1
    }
    var e: I32 = i
    var has_bind: Bool = false
    if i < n {
        if byte_at(src, i) == 123 {
            has_bind = true
        }
    }
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    if !has_bind {
        while e > start {
            var c1: I32 = byte_at(src, e - 1)
            if c1 == 32 {
                e -= 1
            } else {
                if c1 == 10 {
                    e -= 1
                } else {
                    if c1 == 9 {
                        e -= 1
                    } else {
                        break
                    }
                }
            }
        }
    }
    var p0: Str = ""
    if e > start {
        p0 = byte_slice(src, start, e)
    }
    cur.store(i)
    var b: Str = ""
    var p1: Str = ""
    if has_bind {
        cur.store(cur.load() + 1)
        b = gword(src, cur)
        glit(src, cur, 125)
        p1 = gspan(src, cur, 60)
    }
    t.npre.push(p0)
    t.nbid.push(b)
    t.npost.push(p1)
    return 0
}


// 本节点 cond 名(cstart 后最后一个;无 = "")
fn gt_cond_pick(conds: List[Str], cstart: I32) -> Str {
    if conds.len > cstart {
        return conds[conds.len - 1]
    }
    return ""
}

fn gt_node(src: Str, cur: Atomic[I32], t: GuiTree, conds: List[Str], binds: List[Str], strs: List[Str], depth: I32) -> I32 {
    glit(src, cur, 60)
    var tag: Str = gword(src, cur)
    var is_leaf: Bool = false
    if tag == "label" {
        is_leaf = true
    }
    if tag == "button" {
        is_leaf = true
    }
    var is_when: Bool = false
    if tag == "when" {
        is_when = true
    }
    var is_each: Bool = false
    if tag == "each" {
        is_each = true
    }
    var is_input: Bool = false
    if tag == "input" {
        is_input = true
    }
    if !is_leaf {
        if !is_when {
            if !is_each {
                if !is_input {
                    if tag != "vbox" {
                        if tag != "hbox" {
                            panic("gui: 未知元素 " + tag)
                        }
                    }
                }
            }
        }
    }
    if !is_leaf {
        if depth >= 16 {
            panic("gui: 嵌套超限(16)")
        }
    }
    var itemvar: Str = ""
    var listname: Str = ""
    if is_each {
        // 头:item in={listname}(先于 attrs)
        itemvar = gword(src, cur)
        var inkw: Str = gword(src, cur)
        if inkw != "in" {
            panic("gui: each 期待 in,得 " + inkw)
        }
        glit(src, cur, 61)
        glit(src, cur, 123)
        listname = gword(src, cur)
        glit(src, cur, 125)
        gws(src, cur)
    }
    var estart: I32 = t.ev_name.len
    var cstart: I32 = conds.len
    var bstart: I32 = binds.len
    var sstart: I32 = strs.len
    var c: Str = gt_attrs(src, cur, t, conds, binds, strs)
    var id: I32 = t.ntag.len
    if is_input {
        // 自闭合:<input ... />;bind 名 → nbid,placeholder → npre
        glit(src, cur, 47)
        glit(src, cur, 62)
        var ph: Str = ""
        if strs.len > sstart {
            ph = strs[strs.len - 1]
        }
        var bn: Str = ""
        if binds.len > bstart {
            bn = binds[binds.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(ph)
        t.nbid.push(bn)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        return id
    }
    glit(src, cur, 62)
    if is_leaf {
        if byte_at(src, cur.load()) == 60 {
            if byte_at(src, cur.load() + 1) != 47 {
                panic("gui: 叶子不得嵌套")
            }
        }
        gt_leaf_text(src, cur, t)
        t.ntag.push(tag)
        t.ncls.push(c)
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        glit(src, cur, 60)
        glit(src, cur, 47)
        var et: Str = gword(src, cur)
        if et != tag {
            panic("gui: 闭合标签不匹配 " + et)
        }
        glit(src, cur, 62)
        if tag == "button" {
            t.btns.push(id)
        }
    } else {
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(listname)
        t.nbid.push(itemvar)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        var prev: I32 = -1
        while true {
            gws(src, cur)
            if byte_at(src, cur.load()) == 60 {
                if byte_at(src, cur.load() + 1) == 47 {
                    break
                }
            }
            var kid: I32 = gt_node(src, cur, t, conds, binds, strs, depth + 1)
            // 成员链索引赋值(t.nfc[id]=…)解释口径不支持(assign target:Index),
            // 取局部引用中转——List 引用语义下同一底层列表(SL-2v 实证配方)
            var fcl: List[I32] = t.nfc
            var nsl: List[I32] = t.ns
            if prev < 0 {
                fcl[id] = kid
            } else {
                nsl[prev] = kid
            }
            prev = kid
        }
        glit(src, cur, 60)
        glit(src, cur, 47)
        var et2: Str = gword(src, cur)
        if et2 != tag {
            panic("gui: 闭合标签不匹配 " + et2)
        }
        glit(src, cur, 62)
    }
    return id
}

fn gt_style(src: Str, cur: Atomic[I32], t: GuiTree) -> I32 {
    var name: Str = gword(src, cur)
    gws(src, cur)
    glit(src, cur, 123)
    while true {
        gws(src, cur)
        if byte_at(src, cur.load()) == 125 {
            break
        }
        var p: Str = gword(src, cur)
        glit(src, cur, 58)
        gws(src, cur)
        var v: Str = ""
        if byte_at(src, cur.load()) == 34 {
            v = gstr(src, cur)
        } else {
            v = gword(src, cur)
        }
        t.sk.push(name + "." + p)
        t.sv.push(v)
        gws(src, cur)
        if byte_at(src, cur.load()) == 59 {
            glit(src, cur, 59)
        }
    }
    glit(src, cur, 125)
    return 0
}

pub fn gt_parse(src: Str) -> GuiTree {
    var t: GuiTree = gt_new()
    var binds = List[Str]()
    var strs = List[Str]()
    var conds = List[Str]()
    var cur = Atomic[I32](0)
    var n: I32 = src.len
    while cur.load() < n {
        gws(src, cur)
        if cur.load() >= n {
            break
        }
        var w: Str = gword(src, cur)
        if w == "view" {
            gword(src, cur)
            gws(src, cur)
            glit(src, cur, 123)
            gt_node(src, cur, t, conds, binds, strs, 1)
            gws(src, cur)
            glit(src, cur, 125)
        } else {
            if w == "style" {
                gt_style(src, cur, t)
            } else {
                panic("gui: 顶层仅 view/style,得 " + w)
            }
        }
    }
    return t
}

fn gt_cls_prop(classes: Str, prop: Str, dflt: Str, t: GuiTree) -> Str {
    var s: I32 = classes.len - 1
    while s >= 0 {
        var hit: Bool = false
        if s == 0 {
            hit = true
        } else {
            if byte_at(classes, s - 1) == 32 {
                hit = true
            }
        }
        if hit {
            var e: I32 = s
            while e < classes.len {
                if byte_at(classes, e) == 32 {
                    break
                }
                e += 1
            }
            var tok: Str = byte_slice(classes, s, e)
            var key: Str = tok + "." + prop
            var i: I32 = 0
            while i < t.sk.len {
                if t.sk[i] == key {
                    return t.sv[i]
                }
                i += 1
            }
        }
        s -= 1
    }
    return dflt
}
// ==================== 运行时(绑定求值/布局发射/命中/循环) ====================

fn rt_col_r(p: I32) -> I32 {
    return (p / 65536) % 256
}

fn rt_col_g(p: I32) -> I32 {
    return (p / 256) % 256
}

fn rt_col_b(p: I32) -> I32 {
    return p % 256
}

// 列表询问:buf[0] = "each:名",用户逐项 push 标题;返回项文本列表
pub fn rt_bind_items(bind: fn(List[Str]) -> Void, listname: Str) -> List[Str] {
    var buf = List[Str]()
    buf.push("each:" + listname)
    bind(buf)
    var out = List[Str]()
    var i: I32 = 1
    while i < buf.len {
        out.push(buf[i])
        i += 1
    }
    return out
}

fn rt_bind_text(bind: fn(List[Str]) -> Void, name: Str) -> Str {
    var buf = List[Str]()
    buf.push(name)
    bind(buf)
    if buf.len > 1 {
        return buf[buf.len - 1]
    }
    return ""
}

fn rt_emit(t: GuiTree, bind: fn(List[Str]) -> Void, itemvar: Str, item: Str, id: I32) -> I32 {
    // when 条件:旗名经 bind 通道询问("when:名" → push "1"/"0");假 = 整子树跳过
    if t.nflag[id] != "" {
        var fv: Str = rt_bind_text(bind, "when:" + t.nflag[id])
        if fv != "1" {
            return 0
        }
    }
    gui_open()
    var tag: Str = t.ntag[id]
    var c: Str = t.ncls[id]
    if tag == "button" {
        var bgp: I32 = 0
        var bgv: Str = gt_cls_prop(c, "bg", "", t)
        if bgv != "" {
            bgp = g_parse_color(bgv)
        }
        gui_cfg(0, 0, 0, 0, 1, 1, 2, gs2i(gt_cls_prop(c, "w", "66", t)),
                2, gs2i(gt_cls_prop(c, "h", "54", t)), bgp)
        var fgp: I32 = g_parse_color(gt_cls_prop(c, "fg", "#ffffff", t))
        gui_text(t.npre[id], gs2i(gt_cls_prop(c, "size", "26", t)),
                 rt_col_r(fgp), rt_col_g(fgp), rt_col_b(fgp), 255)
    } else {
        if tag == "label" {
            var ax: I32 = 0
            var al: Str = gt_cls_prop(c, "align", "left", t)
            if al == "right" {
                ax = 2
            } else {
                if al == "center" {
                    ax = 1
                }
            }
            gui_cfg(0, 0, 0, 0, ax, 1, 1, 0, 2, gs2i(gt_cls_prop(c, "h", "40", t)), 0)
            var txt: Str = t.npre[id]
            if t.nbid[id] != "" {
                if t.nbid[id] == itemvar {
                    // each 活动项:项文本直取(不经绑定通道)
                    txt = txt + item + t.npost[id]
                } else {
                    txt = txt + rt_bind_text(bind, t.nbid[id]) + t.npost[id]
                }
            } else {
                txt = txt + t.npost[id]
            }
            var sz: I32 = gs2i(gt_cls_prop(c, "size", "40", t))
            if txt.len > 12 {
                sz = 22
            }
            var fgp2: I32 = g_parse_color(gt_cls_prop(c, "fg", "#ffffff", t))
            gui_text(txt, sz, rt_col_r(fgp2), rt_col_g(fgp2), rt_col_b(fgp2), 255)
        } else {
            var dir: I32 = 1
            if tag == "hbox" {
                dir = 0
            }
            var gap: I32 = gs2i(gt_cls_prop(c, "gap", "0", t))
            var pad: I32 = gs2i(gt_cls_prop(c, "padding", "0", t))
            var hmode: I32 = 1
            var hval: I32 = 0
            var hs: Str = gt_cls_prop(c, "h", "", t)
            if hs != "" {
                hmode = 2
                hval = gs2i(hs)
            }
            var bgp2: I32 = 0
            var bgv2: Str = gt_cls_prop(c, "bg", "", t)
            if bgv2 != "" {
                bgp2 = g_parse_color(bgv2)
            }
            gui_cfg(dir, gap, pad, pad, 0, 0, 1, 0, hmode, hval, bgp2)
            if tag == "each" {
                // 按项展开:询问 bind 通道("each:列表名" → 逐项 push 标题),
                // 每项以 itemvar/item 绑定重放孩子子树
                var items = rt_bind_items(bind, t.npre[id])
                var ii: I32 = 0
                while ii < items.len {
                    var ch: I32 = t.nfc[id]
                    while ch >= 0 {
                        rt_emit(t, bind, t.nbid[id], items[ii], ch)
                        ch = t.ns[ch]
                    }
                    ii += 1
                }
            } else {
                var ch: I32 = t.nfc[id]
                while ch >= 0 {
                    rt_emit(t, bind, itemvar, item, ch)
                    ch = t.ns[ch]
                }
            }
        }
    }
    gui_close()
    return 0
}

pub fn rt_draw_frame(t: GuiTree, bind: fn(List[Str]) -> Void, w: I32, h: I32) -> I32 {
    gui_begin_layout(w, h)
    rt_emit(t, bind, "", "", 0)
    return gui_end_layout()
}

pub fn rt_collect_rects(cmds: I32, out: List[I32]) -> I32 {
    var i: I32 = 0
    while i < cmds {
        if gui_cmd_type(i) == 2 {
            out.push(i)
        }
        i += 1
    }
    return 0
}

pub fn rt_hit_name(t: GuiTree, rects: List[I32], px: I32, py: I32) -> Str {
    var j: I32 = 0
    while j < rects.len {
        var ci: I32 = rects[j]
        var px100: I32 = px * 100
        var py100: I32 = py * 100
        if px100 >= gui_cmd_x100(ci) && px100 < gui_cmd_x100(ci) + gui_cmd_w100(ci) {
            if py100 >= gui_cmd_y100(ci) && py100 < gui_cmd_y100(ci) + gui_cmd_h100(ci) {
                if j < t.btns.len {
                    var node: I32 = t.btns[j]
                    var e: I32 = 0
                    while e < t.nec[node] {
                        var gi: I32 = t.nes[node] + e
                        if t.ev_name[gi] == "click" {
                            return t.ev_fn[gi]
                        }
                        e += 1
                    }
                }
                return ""
            }
        }
        j += 1
    }
    return ""
}

pub fn rt_expect_text(want: Str) -> I32 {
    var n: I32 = gui_cmd_count()
    var i: I32 = 0
    while i < n {
        if gui_cmd_type(i) == 1 {
            if gui_cmd_text_len(i) == want.len {
                var ok: Bool = true
                var j: I32 = 0
                while j < want.len {
                    if gui_cmd_text_byte(i, j) != byte_at(want, j) {
                        ok = false
                        j = want.len
                    }
                    j += 1
                }
                if ok {
                    return 0
                }
            }
        }
        i += 1
    }
    var d0: I32 = gui_cmd_text_len(0)
    var dump: Str = "cmd0["
    var dj: I32 = 0
    while dj < d0 {
        dump = dump + gui_cmd_text_byte(0, dj).to_string()
        if dj < d0 - 1 { dump = dump + "," }
        dj += 1
    }
    dump = dump + "]"
    panic("gui test: 断言失败,显示无 [" + want + "] cmds=" + gui_cmd_count().to_string() + " " + dump)
    return 1
}

fn rt_nokey(k: I32) -> Void {
}

fn rt_window_loop(t: GuiTree, title: Str, w: I32, h: I32,
                  bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                  key: fn(I32) -> Void, has_key: Bool) -> I32 {
    var rects = List[I32]()
    gui_clay_init(w, h)
    var n: I32 = rt_draw_frame(t, bind, w, h)
    rt_collect_rects(n, rects)
    InitWindow(w, h, title)
    SetTargetFPS(60)
    while !WindowShouldClose() {
        var evt: I32 = gui_poll_event()
        if evt == 2 {
            var name: Str = rt_hit_name(t, rects, gui_evt_x(), gui_evt_y())
            if name != "" {
                act(name)
            }
        } else {
            if evt == 1 {
                if has_key {
                    key(gui_evt_key())
                }
            }
        }
        rt_draw_frame(t, bind, w, h)
        BeginDrawing()
        gui_clear(27, 27, 29)
        ctron_gui_flush()
        EndDrawing()
    }
    CloseWindow()
    return 0
}

// 带热重载的循环(R2/W4-E3 收编):每 60 帧比对 CTML 内容,变更即原址重解析
// (骨架/几何刷新,rects 重收集;用户闭包与状态不动)
fn rt_window_loop_d(t: GuiTree, src: Str, reload: Str, title: Str, w: I32, h: I32,
                    bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                    key: fn(I32) -> Void, has_key: Bool) -> I32 {
    var rects = List[I32]()
    gui_clay_init(w, h)
    var n: I32 = rt_draw_frame(t, bind, w, h)
    rt_collect_rects(n, rects)
    InitWindow(w, h, title)
    SetTargetFPS(60)
    var frames: I32 = 0
    while !WindowShouldClose() {
        frames += 1
        if frames >= 60 {
            frames = 0
            var src2: Str = read_file(reload)
            // 空源守卫(SL-7α):文件缺失(内嵌兜底形态/运行中被删)不重解析——
            // 此前 src2="" != src 会 gt_parse("") 清空 UI
            if src2 != "" {
                if src2 != src {
                    var t2: GuiTree = gt_parse(src2)
                    t = t2
                    src = src2
                    n = rt_draw_frame(t, bind, w, h)
                    rects = List[I32]()
                    rt_collect_rects(n, rects)
                }
            }
        }
        var evt: I32 = gui_poll_event()
        if evt == 2 {
            var name: Str = rt_hit_name(t, rects, gui_evt_x(), gui_evt_y())
            if name != "" {
                act(name)
            }
        } else {
            if evt == 1 {
                if has_key {
                    key(gui_evt_key())
                }
            }
        }
        rt_draw_frame(t, bind, w, h)
        BeginDrawing()
        gui_clear(27, 27, 29)
        ctron_gui_flush()
        EndDrawing()
    }
    CloseWindow()
    return 0
}

pub fn rt_run(t: GuiTree, title: Str, w: I32, h: I32,
              bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    return rt_window_loop(t, title, w, h, bind, act, rt_nokey, false)
}

pub fn rt_run_kb(t: GuiTree, title: Str, w: I32, h: I32,
                 bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                 key: fn(I32) -> Void) -> I32 {
    return rt_window_loop(t, title, w, h, bind, act, key, true)
}

// d 变体:热重载路径固定 "app.ctml"(默认锚)
pub fn rt_run_d(t: GuiTree, src: Str, title: Str, w: I32, h: I32,
                bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    return rt_window_loop_d(t, src, "app.ctml", title, w, h, bind, act, rt_nokey, false)
}

pub fn rt_run_kb_d(t: GuiTree, src: Str, title: Str, w: I32, h: I32,
                   bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                   key: fn(I32) -> Void) -> I32 {
    return rt_window_loop_d(t, src, "app.ctml", title, w, h, bind, act, key, true)
}

// ==================== 入口与测试驱动(headless) ====================

pub struct Driver {
    var t: GuiTree
    var rects: List[I32]
    var w: I32
    var h: I32
}

fn d_btn_index(t: GuiTree, name: Str) -> I32 {
    var j: I32 = 0
    while j < t.btns.len {
        var node: I32 = t.btns[j]
        var e: I32 = 0
        while e < t.nec[node] {
            var gi: I32 = t.nes[node] + e
            if t.ev_fn[gi] == name {
                return j
            }
            e += 1
        }
        j += 1
    }
    return -1
}

pub fn d_click(t: Box[Driver], name: Str) -> Str {
    var j: I32 = d_btn_index(t.t, name)
    if j < 0 {
        panic("gui test: 未知动作 " + name)
        return ""
    }
    var ci: I32 = t.rects[j]
    var cx: I32 = gui_cmd_x100(ci) / 100 + gui_cmd_w100(ci) / 200
    var cy: I32 = gui_cmd_y100(ci) / 100 + gui_cmd_h100(ci) / 200
    gui_inject_click(cx, cy)
    var evt: I32 = gui_poll_event()
    if evt != 2 {
        panic("gui test: 点击事件丢失 " + name)
        return ""
    }
    return name
}

pub fn d_press_key(t: Box[Driver], k: I32) -> I32 {
    gui_inject_key(k)
    var evt: I32 = gui_poll_event()
    if evt != 1 {
        panic("gui test: 键事件丢失")
        return -1
    }
    return k
}

pub fn d_frame(t: Box[Driver], bind: fn(List[Str]) -> Void) -> I32 {
    return rt_draw_frame(t.t, bind, t.w, t.h)
}

// 注入字符事件(type 3),返回字符码(应用键钩子自行编辑模型)
pub fn d_type_char(t: Box[Driver], k: I32) -> I32 {
    gui_inject_char(k)
    var evt: I32 = gui_poll_event()
    if evt != 3 {
        panic("gui test: 字符事件丢失")
        return -1
    }
    return gui_evt_key()
}

pub fn d_expect_text(t: Box[Driver], want: Str) -> I32 {
    return rt_expect_text(want)
}

// 命令缓冲诊断访问器(自断言钩子/夹具排查用;type: 1=TEXT 2=RECT)
pub fn d_cmd_count() -> I32 {
    return gui_cmd_count()
}

pub fn d_cmd_type(i: I32) -> I32 {
    return gui_cmd_type(i)
}

pub fn d_cmd_text_len(i: I32) -> I32 {
    return gui_cmd_text_len(i)
}

pub fn d_cmd_text_byte(i: I32, j: I32) -> I32 {
    return gui_cmd_text_byte(i, j)
}

// 几何(×100 整数域;黄金帧差分/夹具布局断言用)
pub fn d_cmd_x100(i: I32) -> I32 {
    return gui_cmd_x100(i)
}

pub fn d_cmd_y100(i: I32) -> I32 {
    return gui_cmd_y100(i)
}

pub fn d_cmd_w100(i: I32) -> I32 {
    return gui_cmd_w100(i)
}

pub fn d_cmd_h100(i: I32) -> I32 {
    return gui_cmd_h100(i)
}

// 负断言:want 不出现在任何 TEXT 命令(when 隐藏面)
pub fn d_expect_absent(t: Box[Driver], want: Str) -> I32 {
    var n: I32 = gui_cmd_count()
    var i: I32 = 0
    while i < n {
        if gui_cmd_type(i) == 1 {
            if gui_cmd_text_len(i) == want.len {
                var ok: Bool = true
                var j: I32 = 0
                while j < want.len {
                    if gui_cmd_text_byte(i, j) != byte_at(want, j) {
                        ok = false
                        j = want.len
                    }
                    j += 1
                }
                if ok {
                    panic("gui test: 负断言失败,显示出现 [" + want + "]")
                    return 1
                }
            }
        }
        i += 1
    }
    return 0
}

pub fn test(src: Str, w: I32, h: I32,
            bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
            key: fn(I32) -> Void,
            script: fn(Box[Driver], fn(Str) -> Void, fn(I32) -> Void) -> Void) -> I32 {
    var t: GuiTree = gt_parse(src)
    gui_clay_init(w, h)
    var d = Box[Driver](Driver { t: t, rects: List[I32](), w: w, h: h })
    var n: I32 = rt_draw_frame(d.t, bind, w, h)
    rt_collect_rects(n, d.rects)
    script(d, act, key)
    return 0
}

pub fn run(src: Str, title: Str, w: I32, h: I32,
           bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    var t: GuiTree = gt_parse(src)
    return rt_run(t, title, w, h, bind, act)
}

pub fn run_kb(src: Str, title: Str, w: I32, h: I32,
              bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
              key: fn(I32) -> Void) -> I32 {
    var t: GuiTree = gt_parse(src)
    return rt_run_kb(t, title, w, h, bind, act, key)
}

// d 变体:默认锚 "app.ctml" + 热重载环(60 帧内容比对,变更原址重解析)
pub fn run_d(title: Str, w: I32, h: I32,
             bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    // 文件优先(开发环 + 热重载),缺失回落内嵌块(SL-7α:程序自身 view/style,
    // 独立二进制零 CWD 依赖)
    var src: Str = read_file("app.ctml")
    if src == "" {
        src = ctron_embedded()
    }
    var t: GuiTree = gt_parse(src)
    return rt_run_d(t, src, title, w, h, bind, act)
}

pub fn run_kb_d(title: Str, w: I32, h: I32,
                bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                key: fn(I32) -> Void) -> I32 {
    var src: Str = read_file("app.ctml")
    if src == "" {
        src = ctron_embedded()
    }
    var t: GuiTree = gt_parse(src)
    return rt_run_kb_d(t, src, title, w, h, bind, act, key)
}

// ==================== 输入辅助 ====================

// 字符码 → 单字符 Str(TextInput/type 3 事件;utf8_enc 透传)
pub fn char_str(k: I32) -> Str {
    return utf8_enc(k)
}
