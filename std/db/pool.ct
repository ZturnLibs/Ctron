// std/db/pool.ct —— 有界连接池(P5-E;回放优先架构;§12.3 池纪律)
// since: std-0.5 stability: experimental
// ═══ 规范面(Global Constraints 池纪律 + §12.3)═══
//   池**有界**:容量必填(构造参数;cap < 1 → ok 0 fail-closed,零操作);
//   等待经**有界 Channel**表达背压;回池前复位(必须)——禁止跨取消/跨
//   错误复用脏连接;池绝不发放脏连接。
// ═══ 架构口径(发射面现实裁定;探针实证见 divergences P5-E)═══
//   **核(本文件)= 纯 Ctron 无并发原语**:池状态随值携带(PoolState
//   struct 值语义,单属主),acquire = pool_take(空池 → ok 0 miss 面,
//   **不阻塞**),release = pool_release_*(回池复位)。Channel 等待面 =
//   组合层标准接线(见下"等待接线"),在 tests/db/pool/pool_wait.ct 双臂
//   验收——**Channel 半端(Sender/Receiver)不可作 struct 字段/形参**
//   (emit 臂 int32 截断,P5-E 探针实证并登记),故池对象不持通道,通道
//   由属主任务局部持有:
//
//   等待接线(v1 标准形;pool_wait.ct 逐钉):
//     let (idle_tx, idle_rx) = Channel[I64](cap)   // 空闲槽通道,容量=池容量
//     获取:pool_take miss(ok 0)→ idle_rx.recv() 阻塞等待(背压显式)
//     归还:借出任务复位后 idle_tx.send(slot)(池满即阻塞 = 反向背压)
//     公平性:Channel FIFO + pool_take idle FIFO,先等先得
//     取消:recv/send 随作用域取消以 Err 返回(§7.2/06e_cancel 同面),
//           取消路径禁复用脏连接 = 分类面 pool_classify 恒不产 clean。
//
//   多任务共享 PoolState 经 Mutex[PoolState](Mutex[T] 恒 Send,T 任意)
//   为 v0 登记面:值语义 + with_mut 写回在 spawn 闭包内的发射面未证,
//   v1 池属主单任务 + 通道接线为规范形。
// ═══ 回池复位三件套(§12.3;P5-D 复位路径接线)═══
//   ① 活动事务回滚:**Z('T') 陷阱(P5-D 评审裁定)——查询以 err 0 收口
//      但 ReadyForQuery 状态字节 'T' = 连接在事务中,池必须分类为需复位,
//      经 ROLLBACK 回放路径复位见 'I' 方可回池**(pool_release_pg);
//      E 收口(err 5,drain 档)先排空尾随 Z 再 ROLLBACK(Task 4 同路径:
//      s_tx.ct 排空→回滚→'I')。
//   ② 会话变量复位:pg.ct v1 无 SET 面党 ⇒ 不建模(登记)。
//   ③ 预编译语句清理:命名语句生命周期归池策略 = pg_close_msg 归池消费
//      (pg.ct 预留;v1 池不持语句清单,登记 Task 6 nightly 随动)。
//   复位失败(源耗尽/协议坏/状态非 'I'/越界栅)→ **连接弃用:永不回池、
//   永不发放**(ndrop 计数;真源 fd 关闭由属主组合层执行——池值语义不持
//   fd 生命周期,登记)。
// ═══ 分类面(pool_classify;pool.ct 与接线层共驱一核)═══
//   0 = 直接回池(err 0 且状态 'I' 且非事务)/ 1 = 复位回池(Z('T') 陷阱
//   或 drain 档)/ 2 = 弃用(dirty:pg_conn_dirty == 1,流信任失)。
//   Redis 侧:redis_conn_dirty(P5-E)——v1 命令面无会话态 ⇒ err 0 即
//   clean 直回池,否则弃用(pool_release_redis)。
// ═══ 发射面纪律(divergences (f)-(i);全镜像 pg.ct/redis.ct)═══
//   ① (h) 载荷通道:PoolAcq/PoolState struct 标量字段 + pa_*/pool_*
//      自由 getter。
//   ② (i) C10:计数/下标算术宽域播种(poolz);**struct 字段只用
//      List[Str]/List[I32]**(List[I64] 字段发射面坏,P5-C 登记);槽位
//      表全 I32(容量/槽 id 值域小;fd 值域 ≤ 1024 亦 I32 槽)。
//   ③ List 经形参 push 跨函数传播已证形;struct 字段列表**重建后整体
//      换新**(值语义:局部新表 + 逐槽搬运,不在共享表上原地写)。
//   ④ 无方法调用/无闭包/无 Tuple;状态随值携带;"fn 内未用结果绑定"
//      毒化——忽略返回值用裸语句形。
//   ⑤ inline test 不落本文件(C17 宿主敏感);行为面在 tests/db/pool。
// ═══ use 纪律(严格互斥树;单路径导入)═══
//   单子扩展 std.db.pg(复位经 pg_query_script ROLLBACK 回放路径 +
//   pg_conn_dirty 分类;std/db 树内互用 = client.ct→std.net.bind 同款
//   先例)。**消费方二选一:use std.db.pool 或 use std.db.pg**——加载器
//   为单路径导入树(pool→pg 边已占 pg;消费方再直 use pg 即 E5020 环,
//   探针实证),故借出面经 pool_borrow_pg(PoolQry struct 通道)穿透,
//   消费方面不触 pg 符号。不 use std.net/std.redis(redis 侧分类自持
//   标量面,不拉整个 redis.ct——池分类只依赖 err 标量)。

use std.db.pg.{ pg_conn_dirty, pg_query_script, pgr_rc, pgr_err, pgr_status, pgr_next }

fn poolz() -> I64 {
    var w: I64 = 4294967296
    return w - w
}

// ReadyForQuery 状态字节(pg.ct 同值;'I'=73 idle / 'T'=84 in-tx / 'E'=69)
fn poolx_st_idle() -> I64 { return 73 }

// ---- 池状态(struct 通道;槽位平行表 + 帧库 + 计数)----
// 槽位下标 = slot id(0..nslots);帧库 frames = 各连接回放脚本顺序拼接,
// fstarts/fends = 槽的帧区间(fence:复位消费不得越过 fend——防串池)。

pub struct PoolState {
    var ok: I64
    var cap: I64
    var kinds: List[I32]
    var inuse: List[I32]
    var cls: List[I32]
    var status: List[I32]
    var fds: List[I32]
    var fstarts: List[I32]
    var fends: List[I32]
    var curs: List[I32]
    var frames: List[Str]
    var idle: List[I32]
    var nadd: I64
    var ntake: I64
    var nrel: I64
    var nreset: I64
    var ndrop: I64
}

pub fn pool_ok(s: PoolState) -> I64 { return s.ok }
pub fn pool_cap(s: PoolState) -> I64 { return s.cap }
pub fn pool_nslots(s: PoolState) -> I64 { return s.kinds.len }
pub fn pool_nidle(s: PoolState) -> I64 { return s.idle.len }
pub fn pool_nadd(s: PoolState) -> I64 { return s.nadd }
pub fn pool_ntake(s: PoolState) -> I64 { return s.ntake }
pub fn pool_nrel(s: PoolState) -> I64 { return s.nrel }
pub fn pool_nreset(s: PoolState) -> I64 { return s.nreset }
pub fn pool_ndrop(s: PoolState) -> I64 { return s.ndrop }

fn poolx_slot_at(a: List[I32], i: I64) -> I64 {
    if i < 0 || i >= a.len {
        return -1
    }
    return poolz() + a[i]
}

// ---- 栅(防串池;P5-F 两处对齐 + 语义注)----
// 两处栅**有意半开/全闭异形**,合一形即坏:
//   借出栅 = [fstart, fend) 半开——借出须有未消费帧可跑(cur == fend =
//   本槽帧恰好耗尽,无帧可跑,越栅即消费他槽帧,fail-closed err 2);
//   回池栅 = [fstart, fend] 全闭——next == fend = 本槽帧恰好耗尽的合法
//   idle 终态(健康连接,弃之即误伤;回池后若再借出,借出栅 err 2 显形,
//   属主层弃用收口)。消费方可见不变式:回池成功 ⇒ curs ∈ [fstart, fend]。
fn poolx_fence_borrow(cur: I64, fstart: I64, fend: I64) -> I64 {
    if cur < fstart || cur >= fend {
        return 0
    }
    return 1
}

fn poolx_fence_release(next: I64, fstart: I64, fend: I64) -> I64 {
    if next < fstart || next > fend {
        return 0
    }
    return 1
}

// 槽位面(OOB → -1;kind 0 pg / 1 redis;cls 0 clean / 1 dirty / 2 drain;
// status = 最近 ReadyForQuery 字节或 0)
pub fn pool_slot_kind(s: PoolState, slot: I64) -> I64 { return poolx_slot_at(s.kinds, slot) }
pub fn pool_slot_inuse(s: PoolState, slot: I64) -> I64 { return poolx_slot_at(s.inuse, slot) }
pub fn pool_slot_cls(s: PoolState, slot: I64) -> I64 { return poolx_slot_at(s.cls, slot) }
pub fn pool_slot_status(s: PoolState, slot: I64) -> I64 { return poolx_slot_at(s.status, slot) }
pub fn pool_slot_cur(s: PoolState, slot: I64) -> I64 { return poolx_slot_at(s.curs, slot) }
pub fn pool_slot_fd(s: PoolState, slot: I64) -> I64 { return poolx_slot_at(s.fds, slot) }

fn poolx_empty(ok: I64, cap: I64) -> PoolState {
    var s = PoolState { ok: ok, cap: cap, kinds: List[I32](), inuse: List[I32](), cls: List[I32](), status: List[I32](), fds: List[I32](), fstarts: List[I32](), fends: List[I32](), curs: List[I32](), frames: List[Str](), idle: List[I32](), nadd: 0, ntake: 0, nrel: 0, nreset: 0, ndrop: 0 }
    return s
}

// 池构造(容量必填;cap < 1 → ok 0 fail-closed:后续零操作)
pub fn pool_open(cap: I64) -> PoolState {
    if cap < 1 {
        return poolx_empty(0, cap)
    }
    return poolx_empty(1, cap)
}

// ---- 入池(add;仅 clean 新连接)----

// PG 连接入池(frames = 该连接的回放脚本帧;fd = 真源 fd,回放面 -1)。
// 池满(槽数达 cap)或池坏 → 原样返回(fail-closed)。
pub fn pool_add_pg(s: PoolState, frames: List[Str], fd: I64) -> PoolState {
    if s.ok != 1 {
        return s
    }
    if s.kinds.len >= s.cap {
        return s
    }
    var fstart: I64 = poolz() + s.frames.len
    var kinds = List[I32]()
    var inuse = List[I32]()
    var cls = List[I32]()
    var status = List[I32]()
    var fds = List[I32]()
    var fstarts = List[I32]()
    var fends = List[I32]()
    var curs = List[I32]()
    var idle = List[I32]()
    var all = List[Str]()
    var i: I64 = 0
    while i < s.kinds.len {
        kinds.push(s.kinds[i])
        inuse.push(s.inuse[i])
        cls.push(s.cls[i])
        status.push(s.status[i])
        fds.push(s.fds[i])
        fstarts.push(s.fstarts[i])
        fends.push(s.fends[i])
        curs.push(s.curs[i])
        i += 1
    }
    i = 0
    while i < s.idle.len {
        idle.push(s.idle[i])
        i += 1
    }
    i = 0
    while i < s.frames.len {
        all.push(s.frames[i])
        i += 1
    }
    i = 0
    while i < frames.len {
        all.push(frames[i])
        i += 1
    }
    var slot: I32 = s.kinds.len.as[I32]()
    kinds.push(0)
    inuse.push(0)
    cls.push(0)
    status.push(0)
    fds.push(fd.as[I32]())
    fstarts.push(fstart.as[I32]())
    fends.push((fstart + frames.len).as[I32]())
    curs.push(fstart.as[I32]())
    idle.push(slot)
    var out = PoolState { ok: s.ok, cap: s.cap, kinds: kinds, inuse: inuse, cls: cls, status: status, fds: fds, fstarts: fstarts, fends: fends, curs: curs, frames: all, idle: idle, nadd: s.nadd + 1, ntake: s.ntake, nrel: s.nrel, nreset: s.nreset, ndrop: s.ndrop }
    return out
}

// Redis 连接入池(v1 无会话态 ⇒ 无回放帧;kind 1;fd 同上)
pub fn pool_add_redis(s: PoolState, fd: I64) -> PoolState {
    if s.ok != 1 {
        return s
    }
    if s.kinds.len >= s.cap {
        return s
    }
    var fstart: I64 = poolz() + s.frames.len
    var kinds = List[I32]()
    var inuse = List[I32]()
    var cls = List[I32]()
    var status = List[I32]()
    var fds = List[I32]()
    var fstarts = List[I32]()
    var fends = List[I32]()
    var curs = List[I32]()
    var idle = List[I32]()
    var i: I64 = 0
    while i < s.kinds.len {
        kinds.push(s.kinds[i])
        inuse.push(s.inuse[i])
        cls.push(s.cls[i])
        status.push(s.status[i])
        fds.push(s.fds[i])
        fstarts.push(s.fstarts[i])
        fends.push(s.fends[i])
        curs.push(s.curs[i])
        i += 1
    }
    i = 0
    while i < s.idle.len {
        idle.push(s.idle[i])
        i += 1
    }
    var slot: I32 = s.kinds.len.as[I32]()
    kinds.push(1)
    inuse.push(0)
    cls.push(0)
    status.push(0)
    fds.push(fd.as[I32]())
    fstarts.push(fstart.as[I32]())
    fends.push(fstart.as[I32]())
    curs.push(fstart.as[I32]())
    idle.push(slot)
    var out = PoolState { ok: s.ok, cap: s.cap, kinds: kinds, inuse: inuse, cls: cls, status: status, fds: fds, fstarts: fstarts, fends: fends, curs: curs, frames: s.frames, idle: idle, nadd: s.nadd + 1, ntake: s.ntake, nrel: s.nrel, nreset: s.nreset, ndrop: s.ndrop }
    return out
}

// ---- 获取(take;FIFO;空池 miss 不阻塞)----

pub struct PoolAcq {
    var ok: I64
    var slot: I64
    var kind: I64
    var fd: I64
    var cur: I64
    var fstart: I64
    var fend: I64
    // 取后池态(值语义:调用方持新态线程化推进;见 pa_st)
    var st: PoolState
}

pub fn pa_ok(a: PoolAcq) -> I64 { return a.ok }
pub fn pa_slot(a: PoolAcq) -> I64 { return a.slot }
pub fn pa_kind(a: PoolAcq) -> I64 { return a.kind }
pub fn pa_fd(a: PoolAcq) -> I64 { return a.fd }
pub fn pa_cur(a: PoolAcq) -> I64 { return a.cur }
pub fn pa_fstart(a: PoolAcq) -> I64 { return a.fstart }
pub fn pa_fend(a: PoolAcq) -> I64 { return a.fend }
pub fn pa_st(a: PoolAcq) -> PoolState { return a.st }

// 获取:idle FIFO 队首(先入先出);空池 → ok 0(miss;等待接线 = 调用方
// 于空闲槽通道 recv 阻塞,背压显式——见头注)。池绝不发放脏连接:入 idle
// 者仅 add(clean)与复位成功面。**取后态经 pa_st 线程化**(值语义:
// st 不变式 — 调用方须以 pa_st(a) 为后续 release/take 的基态)。
pub fn pool_take(s: PoolState) -> PoolAcq {
    if s.ok != 1 || s.idle.len == 0 {
    var miss = PoolAcq { ok: 0, slot: -1, kind: -1, fd: -1, cur: -1, fstart: -1, fend: -1, st: s }
    return miss
    }
    var slot: I64 = poolz() + s.idle[0]
    var kinds = List[I32]()
    var inuse = List[I32]()
    var idle = List[I32]()
    var i: I64 = 0
    while i < s.kinds.len {
        kinds.push(s.kinds[i])
        if i == slot {
            inuse.push(1)
        } else {
            inuse.push(s.inuse[i])
        }
        i += 1
    }
    i = 1
    while i < s.idle.len {
        idle.push(s.idle[i])
        i += 1
    }
    var out = PoolState { ok: s.ok, cap: s.cap, kinds: kinds, inuse: inuse, cls: s.cls, status: s.status, fds: s.fds, fstarts: s.fstarts, fends: s.fends, curs: s.curs, frames: s.frames, idle: idle, nadd: s.nadd, ntake: s.ntake + 1, nrel: s.nrel, nreset: s.nreset, ndrop: s.ndrop }
    var a = PoolAcq { ok: 1, slot: slot, kind: poolx_slot_at(out.kinds, slot), fd: poolx_slot_at(out.fds, slot), cur: poolx_slot_at(out.curs, slot), fstart: poolx_slot_at(out.fstarts, slot), fend: poolx_slot_at(out.fends, slot), st: out }
    return a
}

// ---- 分类面(接线层/池共驱一核;头注分类面)----
// 返回 0 直接回池 / 1 复位回池 / 2 弃用。
pub fn pool_classify(err: I64, status: I64) -> I64 {
    var cls = pg_conn_dirty(err)
    if cls == 1 {
        return 2
    }
    // Z('T') 陷阱:err 0 但状态 'T' = 在事务中(P5-D 评审裁定)
    if cls == 2 {
        return 1
    }
    if status == 84 {
        return 1
    }
    return 0
}

// ---- 借出面(执行查询;消费方面不触 pg 符号,见 use 纪律)----

// 借出连接上执行查询(回放源 = 池帧库;cur = 起跑游标,多查询会话由
// 调用方以 pq_next 线程化推进)。结果经 PoolQry
// struct 通道((h) 裁定);**栅内执行**:cur 出槽位帧区间 [fstart, fend)
// = 协议违例 err 2,防串池(复位路径同栅)。
pub struct PoolQry {
    var rc: I64
    var err: I64
    var status: I64
    var next: I64
}

pub fn pq_rc(q: PoolQry) -> I64 { return q.rc }
pub fn pq_err(q: PoolQry) -> I64 { return q.err }
// ReadyForQuery 状态字节('I'=73/'T'=84/'E'=69;未见 Z = 0)
pub fn pq_status(q: PoolQry) -> I64 { return q.status }
// 会话游标(下一查询续跑位;借出面见 pg.ct pgr_next 语义)
pub fn pq_next(q: PoolQry) -> I64 { return q.next }

pub fn pool_borrow_pg(s: PoolState, slot: I64, cur: I64, sql: Str) -> PoolQry {
    var bad = PoolQry { rc: -1, err: 2, status: 0, next: -1 }
    if s.ok != 1 || slot < 0 || slot >= s.kinds.len {
        return bad
    }
    var fstart: I64 = poolx_slot_at(s.fstarts, slot)
    var fend: I64 = poolx_slot_at(s.fends, slot)
    // 借出栅(半开;见 poolx_fence_borrow 注——cur == fend 槽尾耗尽态
    // 不可再借,err 2 fail-closed)
    if poolx_fence_borrow(cur, fstart, fend) != 1 {
        return bad
    }
    var r = pg_query_script(s.frames, cur, sql)
    var q = PoolQry { rc: pgr_rc(r), err: 0, status: pgr_status(r), next: pgr_next(r) }
    if pgr_rc(r) != 0 {
        // err 面直透(pg.ct err 码表;pool_classify 按其分级)
        q.err = pgr_err(r)
    }
    return q
}

// ---- 回池(release;复位三件套见头注)----

// PG 连接回池。err = 最近操作 err 面(PoolQry pq_err),status = 最近
// ReadyForQuery 状态字节(pq_status;未见 Z = 0),next = 最近操作后的
// 会话游标(pq_next;线上位置随查询推进)。复位 = ROLLBACK 回放
// (drain 档先排空尾随 Z;Z('T') 陷阱直滚);成功 = rc 0 且状态 'I' 且
// 栅内(next ≤ fend);否则弃用。脏(cls 2)直弃——不复位不回池。
pub fn pool_release_pg(s: PoolState, slot: I64, err: I64, status: I64, next: I64) -> PoolState {
    if s.ok != 1 || slot < 0 || slot >= s.kinds.len {
        return s
    }
    // 双重归还防呆:非借出态(inuse 0)→ 原样返回(fail-closed,防 idle
    // 双推同槽被二次取用)
    if poolx_slot_at(s.inuse, slot) != 1 {
        return s
    }
    var act = pool_classify(err, status)
    var fstart: I64 = poolx_slot_at(s.fstarts, slot)
    var fend: I64 = poolx_slot_at(s.fends, slot)
    var cur: I64 = poolx_slot_at(s.curs, slot)
    var kinds = List[I32]()
    var inuse = List[I32]()
    var cls = List[I32]()
    var statusl = List[I32]()
    var curs = List[I32]()
    var idle = List[I32]()
    var i: I64 = 0
    while i < s.kinds.len {
        kinds.push(s.kinds[i])
        inuse.push(s.inuse[i])
        cls.push(s.cls[i])
        statusl.push(s.status[i])
        curs.push(s.curs[i])
        i += 1
    }
    i = 0
    while i < s.idle.len {
        idle.push(s.idle[i])
        i += 1
    }
    // 默认面:dirty 直弃
    var keep: I64 = 0
    var nreset = s.nreset
    var ndrop = s.ndrop
    var nrel = s.nrel
    // 线上位置随借出查询推进(借出面 next;回池栅全闭收槽尾终态——见
    // poolx_fence_release 注;越栅 = 串池违例弃用)
    if poolx_fence_release(next, fstart, fend) == 1 {
        curs[slot] = next.as[I32]()
        cur = next
    } else {
        keep = 0
        act = 2
    }
    if act == 0 {
        keep = 1
        nrel = s.nrel + 1
    }
    if act == 1 {
        // 复位路径(Task 4 回放面):drain 档(err != 0,Z 待排空)先排空,
        // Z('T') 陷阱(err 0 状态 'T',Z 已消费)直滚。
        // **drain 档 recovered-'I' 注(P5-F)**:排空读回的 Z 若已是 'I'
        // (服务端已自行收口事务),则跳过 ROLLBACK 直接收 keep——此途
        // nreset **不**计(未执行回滚,仅 nrel 计),cls 复 0 回池;回滚
        // 途径的 nreset 计数不受影响。
        var pos = cur
        if err != 0 {
            var dr = pg_query_script(s.frames, pos, "")
            if pgr_rc(dr) != 0 {
                keep = 0
                pos = -1
            } else {
                pos = pgr_next(dr)
                status = pgr_status(dr)
            }
        }
        if pos >= 0 && status != poolx_st_idle() {
            var rb = pg_query_script(s.frames, pos, "ROLLBACK")
            if pgr_rc(rb) == 0 && pgr_status(rb) == poolx_st_idle() && pgr_next(rb) <= fend && pgr_next(rb) >= fstart {
                keep = 1
                pos = pgr_next(rb)
                status = poolx_st_idle()
                nreset = s.nreset + 1
            } else {
                keep = 0
                pos = -1
            }
        }
        if pos >= 0 && keep == 1 {
            nrel = s.nrel + 1
        }
        if keep == 1 {
            var si = slot.as[I32]()
            curs[slot] = pos.as[I32]()
            statusl[slot] = status.as[I32]()
            cls[slot] = 0
            inuse[slot] = 0
            idle.push(si)
        }
    }
    if act == 2 || keep == 0 {
        ndrop = s.ndrop + 1
        cls[slot] = 1
        inuse[slot] = 0
    } else {
        if act == 0 {
            cls[slot] = 0
            inuse[slot] = 0
            statusl[slot] = status.as[I32]()
            idle.push(slot.as[I32]())
        }
    }
    var out = PoolState { ok: s.ok, cap: s.cap, kinds: kinds, inuse: inuse, cls: cls, status: statusl, fds: s.fds, fstarts: s.fstarts, fends: s.fends, curs: curs, frames: s.frames, idle: idle, nadd: s.nadd, ntake: s.ntake, nrel: nrel, nreset: nreset, ndrop: ndrop }
    return out
}

// Redis 连接回池(v1 无会话态:err 0 即 clean 直回池;否则弃用)。
pub fn pool_release_redis(s: PoolState, slot: I64, err: I64) -> PoolState {
    if s.ok != 1 || slot < 0 || slot >= s.kinds.len {
        return s
    }
    // 双重归还防呆(同 pool_release_pg)
    if poolx_slot_at(s.inuse, slot) != 1 {
        return s
    }
    var act: I64 = 0
    if err != 0 {
        act = 2
    }
    var inuse = List[I32]()
    var cls = List[I32]()
    var idle = List[I32]()
    var i: I64 = 0
    while i < s.kinds.len {
        inuse.push(s.inuse[i])
        cls.push(s.cls[i])
        i += 1
    }
    i = 0
    while i < s.idle.len {
        idle.push(s.idle[i])
        i += 1
    }
    var ndrop = s.ndrop
    var nrel = s.nrel
    if act == 2 {
        ndrop = s.ndrop + 1
        cls[slot] = 1
        inuse[slot] = 0
    } else {
        nrel = s.nrel + 1
        cls[slot] = 0
        inuse[slot] = 0
        idle.push(slot.as[I32]())
    }
    var out = PoolState { ok: s.ok, cap: s.cap, kinds: s.kinds, inuse: inuse, cls: cls, status: s.status, fds: s.fds, fstarts: s.fstarts, fends: s.fends, curs: s.curs, frames: s.frames, idle: idle, nadd: s.nadd, ntake: s.ntake, nrel: nrel, nreset: s.nreset, ndrop: ndrop }
    return out
}
