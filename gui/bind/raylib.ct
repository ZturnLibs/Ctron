// gui/bind/raylib.ct —— raylib 窄绑定(规范 §11.2/§12.1)
// 原则:#[trusted] 收敛在本目录(§3.3);Str → const char* 只读借用(§3.3-2)
// S1:全标量;S2 起增 repr(c) GUI struct(已由 tests/gui/s2_ab 定点实证)

#[trusted]
extern "c" fn InitWindow(w: I32, h: I32, title: Str) -> Void

#[trusted]
extern "c" fn CloseWindow() -> Void

#[trusted]
extern "c" fn WindowShouldClose() -> Bool

#[trusted]
extern "c" fn SetTargetFPS(fps: I32) -> Void

#[trusted]
extern "c" fn BeginDrawing() -> Void

#[trusted]
extern "c" fn EndDrawing() -> Void

// ---- repr(c) GUI struct(S2 实证:tests/gui/s2_ab,按值双向) ----

#[repr(c)]
struct Color { r: U8, g: U8, b: U8, a: U8 }

#[repr(c)]
struct Vector2 { x: F32, y: F32 }

#[trusted]
extern "c" fn ClearBackground(color: Color) -> Void

#[trusted]
extern "c" fn DrawTextV(text: Str, position: Vector2, size: I32, color: Color) -> Void
