// 自举:Ctron 词法器 v2 —— 关键字/整数/多字符运算符/标点/注释 → 每记号一个种类名
fn or2(a: Bool, b: Bool) -> Bool {
    return !(!a && !b)
}

fn is_ws(b: I32) -> Bool {
    return or2(or2(b == 32, b == 9), b == 13)
}

fn is_digit(b: I32) -> Bool {
    return b >= 48 && b <= 57
}

fn is_alpha(b: I32) -> Bool {
    return or2(b >= 65 && b <= 90, b >= 97 && b <= 122)
}

fn is_al(b: I32) -> Bool {
    return or2(is_alpha(b), b == 95)
}

fn is_ac(b: I32) -> Bool {
    return or2(is_al(b), is_digit(b))
}

fn kw(text: Str) -> Str {
    if text == "fn" {
        return "Fn"
    }
    if text == "let" {
        return "Let"
    }
    if text == "var" {
        return "Var"
    }
    if text == "if" {
        return "If"
    }
    if text == "else" {
        return "Else"
    }
    if text == "return" {
        return "Return"
    }
    if text == "true" {
        return "True"
    }
    if text == "false" {
        return "False"
    }
    if text == "while" {
        return "While"
    }
    if text == "for" {
        return "For"
    }
    if text == "in" {
        return "In"
    }
    if text == "struct" {
        return "Struct"
    }
    if text == "class" {
        return "Class"
    }
    if text == "enum" {
        return "Enum"
    }
    if text == "impl" {
        return "Impl"
    }
    return "Ident"
}

fn op_kind(a: I32, b: I32) -> Str {
    if a == 43 && b == 37 {
        return "WrapPlus"
    }
    if a == 43 && b == 61 {
        return "PlusEq"
    }
    if a == 45 && b == 37 {
        return "WrapMinus"
    }
    if a == 45 && b == 62 {
        return "Arrow"
    }
    if a == 45 && b == 61 {
        return "MinusEq"
    }
    if a == 42 && b == 61 {
        return "StarEq"
    }
    if a == 37 && b == 61 {
        return "PercentEq"
    }
    if a == 47 && b == 61 {
        return "SlashEq"
    }
    if a == 61 && b == 61 {
        return "EqEq"
    }
    if a == 61 && b == 62 {
        return "FatArrow"
    }
    if a == 60 && b == 61 {
        return "LtEq"
    }
    if a == 62 && b == 61 {
        return "GtEq"
    }
    if a == 33 && b == 61 {
        return "NotEq"
    }
    if a == 38 && b == 38 {
        return "AndAnd"
    }
    return "?"
}

fn single_kind(b: I32) -> Str {
    if b == 43 {
        return "Plus"
    }
    if b == 45 {
        return "Minus"
    }
    if b == 42 {
        return "Star"
    }
    if b == 47 {
        return "Slash"
    }
    if b == 37 {
        return "Percent"
    }
    if b == 61 {
        return "Assign"
    }
    if b == 60 {
        return "Lt"
    }
    if b == 62 {
        return "Gt"
    }
    if b == 33 {
        return "Bang"
    }
    if b == 63 {
        return "Question"
    }
    if b == 46 {
        return "Dot"
    }
    if b == 44 {
        return "Comma"
    }
    if b == 58 {
        return "Colon"
    }
    if b == 91 {
        return "LBracket"
    }
    if b == 93 {
        return "RBracket"
    }
    if b == 40 {
        return "LParen"
    }
    if b == 41 {
        return "RParen"
    }
    if b == 123 {
        return "LBrace"
    }
    if b == 125 {
        return "RBrace"
    }
    if b == 124 {
        return "Pipe"
    }
    if b == 38 {
        return "Amp"
    }
    if b == 35 {
        return "Hash"
    }
    if b == 64 {
        return "At"
    }
    return "?"
}

fn lex(src: Str) -> Str {
    var out = ""
    var n = src.len
    var i: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        if is_ws(b) {
            i += 1
        } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            while i < n && byte_at(src, i) != 10 {
                i += 1
            }
        } else if is_al(b) {
            var start = i
            while i < n && is_ac(byte_at(src, i)) {
                i += 1
            }
            var word = byte_slice(src, start, i)
            if word == "_" {
                out = out + "Underscore" + "\n"
            } else {
                out = out + kw(word) + "\n"
            }
        } else if is_digit(b) {
            while i < n && is_digit(byte_at(src, i)) {
                i += 1
            }
            out = out + "Int" + "\n"
        } else {
            var two = "?"
            if i + 1 < n {
                two = op_kind(b, byte_at(src, i + 1))
            }
            if two != "?" {
                out = out + two + "\n"
                i += 2
            } else {
                var s = single_kind(b)
                if s != "?" {
                    out = out + s + "\n"
                }
                i += 1
            }
        }
    }
    out = out + "Eof"
    return out
}

fn main() -> I32 {
    let src = read_file("../selfhosted/input_ops.ct")
    match src {
        Some(s) => {
            var text = lex(s)
            print(text)
            return 0
        }
        None => {
            println("read-failed")
            return 1
        }
    }
}
