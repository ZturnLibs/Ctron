// 自举:Ctron 词法器 v5 —— 数值全特征 payload(进制/下划线/指数/12 后缀,与 C lex_number 同表)
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }
fn or3(a: Bool, b: Bool, c: Bool) -> Bool { return or2(or2(a, b), c) }
fn is_ws(b: I32) -> Bool { return or3(b == 32, b == 9, b == 13) }
fn is_digit(b: I32) -> Bool { return b >= 48 && b <= 57 }
fn is_alpha(b: I32) -> Bool { return or2(b >= 65 && b <= 90, b >= 97 && b <= 122) }
fn is_al(b: I32) -> Bool { return or2(is_alpha(b), b == 95) }
fn is_ac(b: I32) -> Bool { return or2(is_al(b), is_digit(b)) }
fn is_hex(b: I32) -> Bool { return or2(is_digit(b), or2(b >= 65 && b <= 70, b >= 97 && b <= 102)) }
fn is_oct(b: I32) -> Bool { return b >= 48 && b <= 55 }
fn is_bin(b: I32) -> Bool { return b >= 48 && b <= 49 }

// 数值后缀(小写精确 + 词边界,与 C 同表:0 后缀前必须 i+2<=n,防越界 byte_at)
fn suffix_len(src: Str, n: I32, i: I32) -> I32 {
    if i + 2 <= n {
        var a = byte_at(src, i)
        var b = byte_at(src, i + 1)
        var len: I32 = 0
        if a == 105 && b == 56 {
            len = 2
        }
        if a == 105 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 {
            len = 3
        }
        if a == 105 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 {
            len = 3
        }
        if a == 105 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 {
            len = 3
        }
        if a == 105 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 {
            len = 5
        }
        if a == 117 && b == 56 {
            len = 2
        }
        if a == 117 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 {
            len = 3
        }
        if a == 117 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 {
            len = 3
        }
        if a == 117 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 {
            len = 3
        }
        if a == 117 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 {
            len = 5
        }
        if a == 102 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 {
            len = 3
        }
        if a == 102 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 {
            len = 3
        }
        if len > 0 {
            if i + len < n && is_ac(byte_at(src, i + len)) {
                return 0
            }
            return len
        }
    }
    return 0
}

fn kw(text: Str) -> Str {
    if text == "fn" { return "Fn" }
    if text == "let" { return "Let" }
    if text == "var" { return "Var" }
    if text == "const" { return "Const" }
    if text == "static" { return "Static" }
    if text == "comptime" { return "Comptime" }
    if text == "if" { return "If" }
    if text == "else" { return "Else" }
    if text == "match" { return "Match" }
    if text == "while" { return "While" }
    if text == "for" { return "For" }
    if text == "in" { return "In" }
    if text == "return" { return "Return" }
    if text == "struct" { return "Struct" }
    if text == "class" { return "Class" }
    if text == "enum" { return "Enum" }
    if text == "trait" { return "Trait" }
    if text == "impl" { return "Impl" }
    if text == "own" { return "Own" }
    if text == "scope" { return "Scope" }
    if text == "test" { return "Test" }
    if text == "use" { return "Use" }
    if text == "pub" { return "Pub" }
    if text == "extern" { return "Extern" }
    if text == "prop" { return "Prop" }
    if text == "true" { return "True" }
    if text == "false" { return "False" }
    if text == "void" { return "Void" }
    if text == "self" { return "Self" }
    return "Ident"
}

fn op2(a: I32, b: I32) -> Str {
    if a == 43 && b == 37 { return "WrapPlus" }
    if a == 45 && b == 37 { return "WrapMinus" }
    if a == 43 && b == 61 { return "PlusEq" }
    if a == 45 && b == 61 { return "MinusEq" }
    if a == 42 && b == 61 { return "StarEq" }
    if a == 47 && b == 61 { return "SlashEq" }
    if a == 37 && b == 61 { return "PercentEq" }
    if a == 61 && b == 61 { return "EqEq" }
    if a == 33 && b == 61 { return "NotEq" }
    if a == 60 && b == 61 { return "LtEq" }
    if a == 62 && b == 61 { return "GtEq" }
    if a == 38 && b == 38 { return "AndAnd" }
    if a == 45 && b == 62 { return "Arrow" }
    if a == 61 && b == 62 { return "FatArrow" }
    return "?"
}

fn op1(b: I32) -> Str {
    if b == 43 { return "Plus" }
    if b == 45 { return "Minus" }
    if b == 42 { return "Star" }
    if b == 47 { return "Slash" }
    if b == 37 { return "Percent" }
    if b == 61 { return "Assign" }
    if b == 60 { return "Lt" }
    if b == 62 { return "Gt" }
    if b == 33 { return "Bang" }
    if b == 63 { return "Question" }
    if b == 46 { return "Dot" }
    if b == 44 { return "Comma" }
    if b == 58 { return "Colon" }
    if b == 91 { return "LBracket" }
    if b == 93 { return "RBracket" }
    if b == 40 { return "LParen" }
    if b == 41 { return "RParen" }
    if b == 123 { return "LBrace" }
    if b == 125 { return "RBrace" }
    if b == 124 { return "Pipe" }
    if b == 38 { return "Amp" }
    if b == 35 { return "Hash" }
    if b == 64 { return "At" }
    return "?"
}

fn end_cont(k: Str) -> Bool {
    if k == "Comma" { return true }
    if k == "Assign" { return true }
    if k == "Arrow" { return true }
    if k == "FatArrow" { return true }
    if k == "AndAnd" { return true }
    if k == "DotDot" { return true }
    if k == "DotDotEq" { return true }
    if k == "Plus" { return true }
    if k == "Minus" { return true }
    if k == "Star" { return true }
    if k == "Slash" { return true }
    if k == "Percent" { return true }
    if k == "WrapPlus" { return true }
    if k == "WrapMinus" { return true }
    if k == "EqEq" { return true }
    if k == "NotEq" { return true }
    if k == "Lt" { return true }
    if k == "Gt" { return true }
    if k == "LtEq" { return true }
    if k == "GtEq" { return true }
    if k == "LParen" { return true }
    if k == "LBracket" { return true }
    if k == "LBrace" { return true }
    if k == "Pipe" { return true }
    return false
}

fn next_cont(k: Str) -> Bool {
    if k == "Dot" { return true }
    if k == "Plus" { return true }
    if k == "Minus" { return true }
    if k == "Star" { return true }
    if k == "Slash" { return true }
    if k == "Percent" { return true }
    if k == "WrapPlus" { return true }
    if k == "WrapMinus" { return true }
    if k == "EqEq" { return true }
    if k == "NotEq" { return true }
    if k == "Lt" { return true }
    if k == "Gt" { return true }
    if k == "LtEq" { return true }
    if k == "GtEq" { return true }
    if k == "AndAnd" { return true }
    if k == "DotDot" { return true }
    if k == "DotDotEq" { return true }
    return false
}

// 扫描整串 → List[Str](含 "Newline" 条目)
fn scan(src: Str, toks: List[Str]) {
    var n = src.len
    var i: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        if b == 10 {
            toks.push("Newline")
            i += 1
        } else if is_ws(b) {
            i += 1
        } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            while i < n && byte_at(src, i) != 10 {
                i += 1
            }
        } else if b == 34 {
            var q0 = i
            i += 1
            var done = false
            while i < n && !done {
                var c = byte_at(src, i)
                if c == 34 {
                    i += 1
                    done = true
                } else if c == 92 {
                    i += 2
                } else if c == 10 {
                    done = true
                } else {
                    i += 1
                }
            }
            toks.push("Str:" + byte_slice(src, q0, i))
        } else if is_al(b) {
            var start = i
            while i < n && is_ac(byte_at(src, i)) {
                i += 1
            }
            var word = byte_slice(src, start, i)
            if word == "_" {
                toks.push("Underscore")
            } else if kw(word) != "Ident" {
                toks.push(kw(word))
            } else {
                toks.push("Ident:" + word)
            }
        } else if is_digit(b) {
            var tstart = i
            var radix: I32 = 0
            if b == 48 && i + 1 < n {
                var p = byte_at(src, i + 1)
                if p == 120 {
                    radix = 16
                }
                if p == 111 {
                    radix = 8
                }
                if p == 98 {
                    radix = 2
                }
            }
            var fnum = false
            var tend = i
            if radix > 0 {
                i += 2
                if radix == 16 {
                    while i < n && or2(is_hex(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if radix == 8 {
                    while i < n && or2(is_oct(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if radix == 2 {
                    while i < n && or2(is_bin(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                tend = i
            } else {
                while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) {
                    i += 1
                }
                if i + 1 < n && byte_at(src, i) == 46 && is_digit(byte_at(src, i + 1)) {
                    fnum = true
                    i += 1
                    while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if i < n && or2(byte_at(src, i) == 101, byte_at(src, i) == 69) {
                    var esign = false
                    if i + 1 < n && or2(byte_at(src, i + 1) == 43, byte_at(src, i + 1) == 45) {
                        esign = true
                    }
                    var eok = false
                    if esign && i + 2 < n && is_digit(byte_at(src, i + 2)) {
                        eok = true
                    }
                    if !esign && i + 1 < n && is_digit(byte_at(src, i + 1)) {
                        eok = true
                    }
                    if eok {
                        fnum = true
                        i += 1
                        if esign {
                            i += 1
                        }
                        while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) {
                            i += 1
                        }
                    }
                }
                tend = i
            }
            var sl = suffix_len(src, n, i)
            if sl > 0 {
                i += sl
            }
            if fnum {
                toks.push("Float:" + byte_slice(src, tstart, tend))
            } else {
                toks.push("Int:" + byte_slice(src, tstart, tend))
            }
        } else {
            if b == 46 && i + 1 < n && byte_at(src, i + 1) == 46 {
                if i + 2 < n && byte_at(src, i + 2) == 61 {
                    toks.push("DotDotEq")
                    i += 3
                } else {
                    toks.push("DotDot")
                    i += 2
                }
            } else {
                var t = "?"
                if i + 1 < n {
                    t = op2(b, byte_at(src, i + 1))
                }
                if t != "?" {
                    toks.push(t)
                    i += 2
                } else {
                    var s = op1(b)
                    if s != "?" {
                        toks.push(s)
                    }
                    i += 1
                }
            }
        }
    }
}

// §1.6 换行过滤(等价 C filter_newlines)
fn filter(toks: List[Str]) -> List[Str] {
    var raw = List[Str]()
    var i: I32 = 0
    var n = toks.len
    var lead = 0
    while i < n && toks[i] == "Newline" {
        lead += 1
        i += 1
    }
    var j = 1
    while j < lead {
        raw.push("Newline")
        j += 1
    }
    while i < n {
        if toks[i] != "Newline" {
            raw.push(toks[i])
            i += 1
        } else {
            var run = i
            while run < n && toks[run] == "Newline" {
                run += 1
            }
            var nxt = "Eof"
            if run < n {
                nxt = toks[run]
            }
            var lastk = raw[raw.len - 1]
            var sup = end_cont(lastk)
            if !sup {
                sup = next_cont(nxt)
            }
            if !sup {
                raw.push("Newline")
            }
            i = run
        }
    }
    return raw
}

fn main() -> I32 {
    let src = read_file("selfhost/input_num.ct")
    match src {
        Some(s) => {
            var toks = List[Str]()
            scan(s, toks)
            var f = filter(toks)
            var out = ""
            var i = 0
            while i < f.len {
                out = out + f[i] + "\n"
                i += 1
            }
            out = out + "Eof"
            print(out)
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
