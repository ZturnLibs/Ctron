// 自举种子:Ctron 写的 ASCII 词法器(计数)+ EOF 记号
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }

fn is_digit(b: I32) -> Bool { return b >= 48 && b <= 57 }
fn is_ident_start(b: I32) -> Bool {
    return or2(or2(b >= 65 && b <= 90, b >= 97 && b <= 122), b == 95)
}
fn is_ident_cont(b: I32) -> Bool { return or2(is_ident_start(b), is_digit(b)) }

fn count_tokens(src: Str) -> I32 {
    var n = src.len
    var i: I32 = 0
    var count: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        if or2(or2(b == 32, b == 9), b == 13) {
            i += 1
        } else if b == 47 {
            if i + 1 < n && byte_at(src, i + 1) == 47 {
                while i < n && byte_at(src, i) != 10 { i += 1 }
            } else {
                i += 1
                count += 1
            }
        } else if is_ident_start(b) {
            while i < n && is_ident_cont(byte_at(src, i)) { i += 1 }
            count += 1
        } else if is_digit(b) {
            while i < n && is_digit(byte_at(src, i)) { i += 1 }
            count += 1
        } else {
            i += 1
            count += 1
        }
    }
    return count + 1
}

fn main() -> I32 {
    let src = read_file("selfhost/input_small.ct")
    match src {
        Some(s) => {
            println("tokens=" + count_tokens(s).to_string())
            return 0
        }
        None => {
            println("read-failed")
            return 1
        }
    }
}
