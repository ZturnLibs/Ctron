// 自举:Ctron 解析器种子(C6a)—— fn 声明/类型化形参/Return/表达式递归下降,输出 C-AST v1 文本
// 记号编码:词=原文("fn"/"return"/"I32");数值=文本+"~"+后缀(空后缀亦留 ~);
// 标点=原始串("(","->","..=");流末哨兵 "#EOF"。换行/注释/空白直接丢弃(语法由分隔符界定)。
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }
fn or3(a: Bool, b: Bool, c: Bool) -> Bool { return or2(or2(a, b), c) }
fn is_digit(b: I32) -> Bool { return b >= 48 && b <= 57 }
fn is_alpha(b: I32) -> Bool { return or2(b >= 65 && b <= 90, b >= 97 && b <= 122) }
fn is_al(b: I32) -> Bool { return or2(is_alpha(b), b == 95) }
fn is_ac(b: I32) -> Bool { return or2(is_al(b), is_digit(b)) }
fn is_hex(b: I32) -> Bool { return or2(is_digit(b), or2(b >= 65 && b <= 70, b >= 97 && b <= 102)) }
fn is_oct(b: I32) -> Bool { return b >= 48 && b <= 55 }
fn is_bin(b: I32) -> Bool { return b >= 48 && b <= 49 }

fn suffix_len(src: Str, n: I32, i: I32) -> I32 {
    if i + 2 <= n {
        var a = byte_at(src, i)
        var b = byte_at(src, i + 1)
        var len: I32 = 0
        if a == 105 && b == 56 {
            len = 2
        }
        if a == 105 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 {
            len = 3
        }
        if a == 105 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 {
            len = 3
        }
        if a == 105 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 {
            len = 3
        }
        if a == 105 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 {
            len = 5
        }
        if a == 117 && b == 56 {
            len = 2
        }
        if a == 117 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 {
            len = 3
        }
        if a == 117 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 {
            len = 3
        }
        if a == 117 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 {
            len = 3
        }
        if a == 117 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 {
            len = 5
        }
        if a == 102 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 {
            len = 3
        }
        if a == 102 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 {
            len = 3
        }
        if len > 0 {
            if i + len < n && is_ac(byte_at(src, i + len)) {
                return 0
            }
            return len
        }
    }
    return 0
}

// 扫描:跳过空白/换行/注释;词与数值原样入列;标点最长匹配原始串
fn scan(src: Str, toks: List[Str]) {
    var n = src.len
    var i: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        if b == 10 {
            toks.push("NL")
            i += 1
        } else if or3(b == 32, b == 9, b == 13) {
            i += 1
        } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            while i < n && byte_at(src, i) != 10 {
                i += 1
            }
        } else if b == 34 {
            var q0 = i
            i += 1
            var done = false
            while i < n && !done {
                var c = byte_at(src, i)
                if c == 34 {
                    i += 1
                    done = true
                } else if c == 92 {
                    i += 2
                } else if c == 10 {
                    done = true
                } else {
                    i += 1
                }
            }
            toks.push(byte_slice(src, q0, i))
        } else if is_al(b) {
            var start = i
            while i < n && is_ac(byte_at(src, i)) {
                i += 1
            }
            toks.push(byte_slice(src, start, i))
        } else if is_digit(b) {
            var tstart = i
            var radix: I32 = 0
            if b == 48 && i + 1 < n {
                var p = byte_at(src, i + 1)
                if p == 120 {
                    radix = 16
                }
                if p == 111 {
                    radix = 8
                }
                if p == 98 {
                    radix = 2
                }
            }
            var fnum = false
            var tend = i
            if radix > 0 {
                i += 2
                if radix == 16 {
                    while i < n && or2(is_hex(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if radix == 8 {
                    while i < n && or2(is_oct(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if radix == 2 {
                    while i < n && or2(is_bin(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                tend = i
            } else {
                while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) {
                    i += 1
                }
                if i + 1 < n && byte_at(src, i) == 46 && is_digit(byte_at(src, i + 1)) {
                    fnum = true
                    i += 1
                    while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) {
                        i += 1
                    }
                }
                if i < n && or2(byte_at(src, i) == 101, byte_at(src, i) == 69) {
                    var esign = false
                    if i + 1 < n && or2(byte_at(src, i + 1) == 43, byte_at(src, i + 1) == 45) {
                        esign = true
                    }
                    var eok = false
                    if esign && i + 2 < n && is_digit(byte_at(src, i + 2)) {
                        eok = true
                    }
                    if !esign && i + 1 < n && is_digit(byte_at(src, i + 1)) {
                        eok = true
                    }
                    if eok {
                        fnum = true
                        i += 1
                        if esign {
                            i += 1
                        }
                        while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) {
                            i += 1
                        }
                    }
                }
                tend = i
            }
            var tk = byte_slice(src, tstart, tend) + "~"
            var sl = suffix_len(src, n, i)
            if sl > 0 {
                tk = tk + byte_slice(src, i, i + sl)
                i += sl
            }
            toks.push(tk)
        } else {
            if b == 46 && i + 2 < n && byte_at(src, i + 1) == 46 && byte_at(src, i + 2) == 61 {
                toks.push("..=")
                i += 3
            } else if b == 46 && i + 1 < n && byte_at(src, i + 1) == 46 {
                toks.push("..")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 62 {
                toks.push("->")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("==")
                i += 2
            } else if b == 33 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("!=")
                i += 2
            } else if b == 60 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("<=")
                i += 2
            } else if b == 62 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push(">=")
                i += 2
            } else if b == 38 && i + 1 < n && byte_at(src, i + 1) == 38 {
                toks.push("&&")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 62 {
                toks.push("=>")
                i += 2
            } else if b == 43 && i + 1 < n && byte_at(src, i + 1) == 37 {
                toks.push("+%")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 37 {
                toks.push("-%")
                i += 2
            } else if b == 43 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("+=")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("-=")
                i += 2
            } else if b == 42 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("*=")
                i += 2
            } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("/=")
                i += 2
            } else if b == 37 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("%=")
                i += 2
            } else {
                toks.push(byte_slice(src, i, i + 1))
                i += 1
            }
        }
    }
    toks.push("#EOF")
}

// ---- 记号取值:tok = 当前记号;adv = 前进一格(Atomic 共享游标) ----
fn tok(toks: List[Str], cur: Atomic[I32]) -> Str {
    var i = cur.load()
    if i < toks.len {
        return toks[i]
    }
    return "#EOF"
}
fn adv(cur: Atomic[I32]) {
    var v = cur.load()
    cur.store(v + 1)
}

// 数值记号切分:文本="~" 之前;后缀="~" 之后
fn sep_of(t: Str) -> I32 {
    var j: I32 = 0
    while j < t.len {
        if byte_at(t, j) == 126 {
            return j
        }
        j += 1
    }
    return -1
}
fn num_text(t: Str) -> Str {
    var k = sep_of(t)
    return byte_slice(t, 0, k)
}
fn num_sfx(t: Str) -> Str {
    var k = sep_of(t)
    return byte_slice(t, k + 1, t.len)
}
// Int/Float 判别:进制前缀恒为 Int;十进制文本含 '.'/e/E → Float(0f32 文本无点 → Int,与 C 同)
fn num_float(t: Str) -> Bool {
    if byte_at(t, 0) == 48 && byte_at(t, 1) == 120 {
        return false
    }
    if byte_at(t, 0) == 48 && byte_at(t, 1) == 111 {
        return false
    }
    if byte_at(t, 0) == 48 && byte_at(t, 1) == 98 {
        return false
    }
    var k = sep_of(t)
    var j: I32 = 0
    while j < k {
        var c = byte_at(t, j)
        if c == 46 {
            return true
        }
        if c == 101 {
            return true
        }
        if c == 69 {
            return true
        }
        j += 1
    }
    return false
}

// ---- 递归下降(优先级阶梯照 C parser:and→compare→range→additive→multiplicative→unary→postfix) ----
// ---- 字符串部件:C 存解码文本 + 插值原始切片;qstr(解码) 与源码转义互逆(除 \u 钉,
//      该钉在 \u{...} 纳入语料前按原样透传)。文字段 \{ → {。
fn q_text(raw: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = raw.len
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 117 {
            var hx = ""
            var pp = j + 2
            if pp < n && byte_at(raw, pp) == 123 {
                pp += 1
                while pp < n && byte_at(raw, pp) != 125 {
                    hx = hx + byte_slice(raw, pp, pp + 1)
                    pp += 1
                }
                if hx == "4E2D" {
                    out = out + "\u{4E2D}"
                    j = pp + 1
                } else {
                    out = out + byte_slice(raw, j, pp)
                    j = pp
                }
            } else {
                out = out + byte_slice(raw, j, j + 2)
                j += 2
            }
        } else if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 123 {
            out = out + "\{"
            j += 2
        } else {
            out = out + byte_slice(raw, j, j + 1)
            j += 1
        }
    }
    return out
}

fn str_parts(raw: Str) -> Str {
    var out = ""
    var k: I32 = 0
    var n = raw.len
    var j: I32 = 0
    var ts: I32 = 0
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 2 <= n {
            if j + 3 < n && byte_at(raw, j + 1) == 117 && byte_at(raw, j + 2) == 123 {
                var q = j + 3
                while q < n && byte_at(raw, q) != 125 {
                    q += 1
                }
                if q < n {
                    j = q + 1
                } else {
                    j += 2
                }
            } else {
                j += 2
            }
        } else if c == 123 {
            if j > ts {
                if k > 0 {
                    out = out + ", "
                }
                out = out + "Text(\"" + q_text(byte_slice(raw, ts, j)) + "\")"
                k += 1
            }
            var d: I32 = 1
            var p = j + 1
            while d > 0 && p < n {
                var cp = byte_at(raw, p)
                if cp == 123 {
                    d += 1
                }
                if cp == 125 {
                    d -= 1
                }
                p += 1
            }
            if k > 0 {
                out = out + ", "
            }
            out = out + "Interp(\"" + q_text(byte_slice(raw, j + 1, p - 1)) + "\")"
            k += 1
            j = p
            ts = p
        } else {
            j += 1
        }
    }
    if n > ts {
        if k > 0 {
            out = out + ", "
        }
        out = out + "Text(\"" + q_text(byte_slice(raw, ts, n)) + "\")"
        k += 1
    }
    return "[" + out + "]"
}

fn parse_closure(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var ps = ""
    var k: I32 = 0
    var more = true
    while more {
        if tok(toks, cur) == "|" {
            more = false
        } else {
            var isv = "false"
            var t0 = tok(toks, cur)
            if t0 == "var" {
                isv = "true"
                adv(cur)
            }
            if t0 == "let" {
                adv(cur)
            }
            var nm = tok(toks, cur)
            adv(cur)
            var ty = "None"
            if tok(toks, cur) == ":" {
                adv(cur)
                ty = parse_type(toks, cur)
            }
            if k > 0 {
                ps = ps + ", "
            }
            ps = ps + "ClosureParam \{ is_var: " + isv + ", name: \"" + nm + "\", ty: " + ty + "}"
            k += 1
            if tok(toks, cur) == "," {
                adv(cur)
            } else {
                more = false
            }
        }
    }
    adv(cur)
    var ret = "None"
    if tok(toks, cur) == "->" {
        adv(cur)
        ret = parse_type(toks, cur)
    }
    var body = parse_expr(toks, cur)
    return "Closure \{ params: [" + ps + "], ret: " + ret + ", body: " + body + "}"
}

fn parse_own(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    adv(cur)
    var body = parse_block(toks, cur)
    return "Own \{ arena: \"" + nm + "\", body: " + body + "}"
}

fn parse_match(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var sc = parse_expr(toks, cur)
    adv(cur)
    var arms = ""
    var k: I32 = 0
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if or2(tok(toks, cur) == "}", tok(toks, cur) == "#EOF") {
            go = false
        } else {
            var pat = parse_pattern(toks, cur)
            adv(cur)
            var ae = parse_expr(toks, cur)
            if k > 0 {
                arms = arms + ", "
            }
            arms = arms + "MatchArm \{ pattern: " + pat + ", expr: " + ae + "}"
            k += 1
        }
    }
    adv(cur)
    return "Match \{ expr: " + sc + ", arms: [" + arms + "]}"
}

fn parse_pat_fields(toks: List[Str], cur: Atomic[I32]) -> Str {
    var fs = ""
    var k: I32 = 0
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" {
            adv(cur)
            go = false
        } else if tok(toks, cur) == "#EOF" {
            go = false
        } else {
            var fnm = tok(toks, cur)
            adv(cur)
            var pp = "None"
            if tok(toks, cur) == ":" {
                adv(cur)
                pp = parse_pattern(toks, cur)
            }
            if k > 0 {
                fs = fs + ", "
            }
            fs = fs + "StructPatField \{ name: \"" + fnm + "\", pattern: " + pp + "}"
            k += 1
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "," {
                adv(cur)
            }
        }
    }
    return "Struct([" + fs + "])"
}

fn parse_pattern(toks: List[Str], cur: Atomic[I32]) -> Str {
    var t = tok(toks, cur)
    if t == "_" {
        adv(cur)
        return "Wildcard"
    }
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        if num_float(t) {
            return "Lit(Float(\"" + num_text(t) + "\"))"
        }
        return "Lit(Int(\"" + num_text(t) + "\"))"
    }
    if b0 == 34 {
        adv(cur)
        return "Lit(Str(\"" + q_text(byte_slice(t, 1, t.len - 1)) + "\"))"
    }
    if t == "true" {
        adv(cur)
        return "Lit(Bool(true))"
    }
    if t == "false" {
        adv(cur)
        return "Lit(Bool(false))"
    }
    if t == "(" {
        adv(cur)
        var ps = ""
        var kk: I32 = 0
        var mm = true
        while mm {
            if tok(toks, cur) == ")" {
                mm = false
            } else {
                var aa = parse_pattern(toks, cur)
                if kk > 0 {
                    ps = ps + ", "
                }
                ps = ps + aa
                kk += 1
                if tok(toks, cur) == "," {
                    adv(cur)
                } else {
                    mm = false
                }
            }
        }
        adv(cur)
        return "Tuple(" + ps + ")"
    }
    var nm = t
    adv(cur)
    if tok(toks, cur) == "(" {
        adv(cur)
        var ps = ""
        var k: I32 = 0
        var more = true
        while more {
            if tok(toks, cur) == ")" {
                more = false
            } else {
                var a = parse_pattern(toks, cur)
                if k > 0 {
                    ps = ps + ", "
                }
                ps = ps + a
                k += 1
                if tok(toks, cur) == "," {
                    adv(cur)
                } else {
                    more = false
                }
            }
        }
        adv(cur)
        return "Agg \{ path: [\"" + nm + "\"], sub: Tuple(" + ps + ")}"
    }
    if tok(toks, cur) == "\{" {
        adv(cur)
        return "Agg \{ path: [\"" + nm + "\"], sub: " + parse_pat_fields(toks, cur) + "}"
    }
    if b0 >= 65 && b0 <= 90 {
        return "Agg \{ path: [\"" + nm + "\"], sub: Unit}"
    }
    return "Ident(\"" + nm + "\")"
}

fn parse_expr(toks: List[Str], cur: Atomic[I32]) -> Str {
    return parse_and(toks, cur)
}

fn parse_and(toks: List[Str], cur: Atomic[I32]) -> Str {
    var l = parse_compare(toks, cur)
    var go = true
    while go {
        if tok(toks, cur) == "&&" {
            adv(cur)
            var r = parse_compare(toks, cur)
            l = "Binary \{ op: AndAnd, lhs: " + l + ", rhs: " + r + "}"
        } else {
            go = false
        }
    }
    return l
}

fn parse_compare(toks: List[Str], cur: Atomic[I32]) -> Str {
    var l = parse_range(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "==" {
            op = "Eq"
        }
        if t == "!=" {
            op = "Ne"
        }
        if t == "<" {
            op = "Lt"
        }
        if t == ">" {
            op = "Gt"
        }
        if t == "<=" {
            op = "Le"
        }
        if t == ">=" {
            op = "Ge"
        }
        if op == "" {
            go = false
        } else {
            adv(cur)
            var r = parse_range(toks, cur)
            l = "Binary \{ op: " + op + ", lhs: " + l + ", rhs: " + r + "}"
        }
    }
    return l
}

fn parse_range(toks: List[Str], cur: Atomic[I32]) -> Str {
    var f = parse_additive(toks, cur)
    var t = tok(toks, cur)
    if or2(t == "..", t == "..=") {
        adv(cur)
        var to = parse_additive(toks, cur)
        var inc = "false"
        if t == "..=" {
            inc = "true"
        }
        return "Range \{ inclusive: " + inc + ", from: " + f + ", to: " + to + "}"
    }
    return f
}

fn parse_additive(toks: List[Str], cur: Atomic[I32]) -> Str {
    var l = parse_multiplicative(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "+" {
            op = "Add"
        }
        if t == "-" {
            op = "Sub"
        }
        if t == "+%" {
            op = "WrapAdd"
        }
        if t == "-%" {
            op = "WrapSub"
        }
        if op == "" {
            go = false
        } else {
            adv(cur)
            var r = parse_multiplicative(toks, cur)
            l = "Binary \{ op: " + op + ", lhs: " + l + ", rhs: " + r + "}"
        }
    }
    return l
}

fn parse_multiplicative(toks: List[Str], cur: Atomic[I32]) -> Str {
    var l = parse_unary(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "*" {
            op = "Mul"
        }
        if t == "/" {
            op = "Div"
        }
        if t == "%" {
            op = "Mod"
        }
        if op == "" {
            go = false
        } else {
            adv(cur)
            var r = parse_unary(toks, cur)
            l = "Binary \{ op: " + op + ", lhs: " + l + ", rhs: " + r + "}"
        }
    }
    return l
}

fn parse_unary(toks: List[Str], cur: Atomic[I32]) -> Str {
    var t = tok(toks, cur)
    if t == "-" {
        adv(cur)
        var e = parse_unary(toks, cur)
        return "Unary \{ op: Neg, expr: " + e + "}"
    }
    if t == "!" {
        adv(cur)
        var e = parse_unary(toks, cur)
        return "Unary \{ op: Not, expr: " + e + "}"
    }
    return parse_postfix(toks, cur)
}

fn parse_postfix(toks: List[Str], cur: Atomic[I32]) -> Str {
    var e = parse_primary(toks, cur)
    var go = true
    while go {
        while tok(toks, cur) == "NL" && toks[cur.load() + 1] == "." {
            adv(cur)
        }
        var t = tok(toks, cur)
        if t == "(" {
            adv(cur)
            var args = ""
            var k: I32 = 0
            var more = true
            while more {
                if tok(toks, cur) == ")" {
                    more = false
                } else {
                    var a = parse_expr(toks, cur)
                    if k > 0 {
                        args = args + ", "
                    }
                    args = args + a
                    k += 1
                    if tok(toks, cur) == "," {
                        adv(cur)
                    } else {
                        more = false
                    }
                }
            }
            adv(cur)
            e = "Call \{ callee: " + e + ", args: [" + args + "] }"
        } else if t == "." {
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            if is_digit(byte_at(nm, 0)) {
                e = "Member \{ obj: " + e + ", target: TupleIndex(" + num_text(nm) + ")}"
            } else {
                e = "Member \{ obj: " + e + ", target: Name(\"" + nm + "\")}"
            }
        } else if t == "?" {
            adv(cur)
            e = "Try(" + e + ")"
        } else if t == "[" {
            var d: I32 = 1
            var q = cur.load() + 1
            while d > 0 {
                var tk2 = toks[q]
                if tk2 == "[" {
                    d += 1
                }
                if tk2 == "]" {
                    d -= 1
                }
                q += 1
            }
            var nx = toks[q]
            var hascom = false
            var cc = cur.load() + 1
            while cc < q {
                if toks[cc] == "," {
                    hascom = true
                }
                cc += 1
            }
            var ta = false
            if or2(nx == "(", nx == "\{") {
                ta = true
            }
            if nx == "." && hascom {
                ta = true
            }
            if ta {
                adv(cur)
                var targs = ""
                var k2: I32 = 0
                var more2 = true
                while more2 {
                    if tok(toks, cur) == "]" {
                        more2 = false
                    } else {
                        var a = parse_type(toks, cur)
                        if k2 > 0 {
                            targs = targs + ", "
                        }
                        targs = targs + a
                        k2 += 1
                        if tok(toks, cur) == "," {
                            adv(cur)
                        } else {
                            more2 = false
                        }
                    }
                }
                adv(cur)
                e = "TypeArgs \{ expr: " + e + ", args: [" + targs + "]}"
            } else {
                adv(cur)
                var ix = parse_expr(toks, cur)
                adv(cur)
                e = "Index \{ obj: " + e + ", index: " + ix + "}"
            }
        } else {
            go = false
        }
    }
    return e
}

fn parse_primary(toks: List[Str], cur: Atomic[I32]) -> Str {
    var t = tok(toks, cur)
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        if num_float(t) {
            return "Float \{ text: \"" + num_text(t) + "\", suffix: \"" + num_sfx(t) + "\"}"
        }
        return "Int \{ text: \"" + num_text(t) + "\", suffix: \"" + num_sfx(t) + "\"}"
    }
    if b0 == 34 {
        adv(cur)
        return "Str \{ parts: " + str_parts(byte_slice(t, 1, t.len - 1)) + "}"
    }
    if t == "(" {
        adv(cur)
        var e0 = parse_expr(toks, cur)
        if tok(toks, cur) == "," {
            var es = e0
            var k: I32 = 1
            var more = true
            while more {
                if tok(toks, cur) == "," {
                    adv(cur)
                    var a2 = parse_expr(toks, cur)
                    es = es + ", " + a2
                    k += 1
                } else {
                    more = false
                }
            }
            adv(cur)
            return "Tuple(" + es + ")"
        }
        adv(cur)
        return e0
    }
    if t == "if" {
        return parse_if(toks, cur)
    }
    if t == "match" {
        return parse_match(toks, cur)
    }
    if t == "|" {
        return parse_closure(toks, cur)
    }
    if t == "own" {
        return parse_own(toks, cur)
    }
    if t == "scope" {
        return parse_scope(toks, cur)
    }
    if t == "void" {
        adv(cur)
        return "Void"
    }
    if t == "true" {
        adv(cur)
        return "Bool(true)"
    }
    if t == "false" {
        adv(cur)
        return "Bool(false)"
    }
    if t == "\{" {
        adv(cur)
        return "BlockExpr(" + parse_block(toks, cur) + ")"
    }
    if t == "[" {
        adv(cur)
        var es = ""
        var k: I32 = 0
        var more = true
        while more {
            if tok(toks, cur) == "]" {
                more = false
            } else {
                var a = parse_expr(toks, cur)
                if k > 0 {
                    es = es + ", "
                }
                es = es + a
                k += 1
                if tok(toks, cur) == "," {
                    adv(cur)
                } else {
                    more = false
                }
            }
        }
        adv(cur)
        return "Array(" + es + ")"
    }
    if b0 >= 65 && b0 <= 90 && toks[cur.load() + 1] == "\{" {
        var nm = t
        adv(cur)
        adv(cur)
        var fs = ""
        var k2: I32 = 0
        var more2 = true
        while more2 {
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "}" {
                more2 = false
            } else if tok(toks, cur) == "#EOF" {
                more2 = false
            } else {
                var fnm = tok(toks, cur)
                adv(cur)
                adv(cur)
                var vv = parse_expr(toks, cur)
                if k2 > 0 {
                    fs = fs + ", "
                }
                fs = fs + "StructField \{ name: \"" + fnm + "\", value: " + vv + "}"
                k2 += 1
                while tok(toks, cur) == "NL" {
                    adv(cur)
                }
                if tok(toks, cur) == "," {
                    adv(cur)
                }
            }
        }
        adv(cur)
        return "StructLit \{ path: [\"" + nm + "\"], fields: [" + fs + "] }"
    }
    adv(cur)
    return "Ident(\"" + t + "\")"
}

fn parse_if(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var cond = parse_expr(toks, cur)
    adv(cur)
    var thenb = parse_block(toks, cur)
    var els = "None"
    if tok(toks, cur) == "else" {
        adv(cur)
        if tok(toks, cur) == "if" {
            els = parse_if(toks, cur)
        } else {
            adv(cur)
            els = "BlockExpr(" + parse_block(toks, cur) + ")"
        }
    }
    return "If \{ cond: " + cond + ", then: " + thenb + ", els: " + els + "}"
}

fn type_postfix(toks: List[Str], cur: Atomic[I32], base: Str) -> Str {
    var ty = base
    var go = true
    while go {
        if tok(toks, cur) == "[" {
            adv(cur)
            if tok(toks, cur) == "]" {
                adv(cur)
                ty = "Slice(" + ty + ")"
            } else {
                var sz = parse_expr(toks, cur)
                adv(cur)
                ty = "Array \{ elem: " + ty + ", size: " + sz + "}"
            }
        } else if tok(toks, cur) == "?" {
            adv(cur)
            ty = "Optional(" + ty + ")"
        } else {
            go = false
        }
    }
    return ty
}

fn parse_type(toks: List[Str], cur: Atomic[I32]) -> Str {
    var t = tok(toks, cur)
    if t == "&" {
        adv(cur)
        var sub = parse_type(toks, cur)
        return type_postfix(toks, cur, "Ref(" + sub + ")")
    }
    if t == "(" {
        adv(cur)
        var es = ""
        var k: I32 = 0
        var more = true
        while more {
            if tok(toks, cur) == ")" {
                more = false
            } else {
                var a = parse_type(toks, cur)
                if k > 0 {
                    es = es + ", "
                }
                es = es + a
                k += 1
                if tok(toks, cur) == "," {
                    adv(cur)
                } else {
                    more = false
                }
            }
        }
        adv(cur)
        return type_postfix(toks, cur, "Tuple(" + es + ")")
    }
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        return type_postfix(toks, cur, "ComptimeVal(\"" + num_text(t) + "\")")
    }
    var nm = t
    adv(cur)
    var ty = ""
    if nm == "fn" {
        adv(cur)
        var ps = ""
        var k: I32 = 0
        var more = true
        while more {
            if tok(toks, cur) == ")" {
                more = false
            } else {
                var a = parse_type(toks, cur)
                if k > 0 {
                    ps = ps + ", "
                }
                ps = ps + a
                k += 1
                if tok(toks, cur) == "," {
                    adv(cur)
                } else {
                    more = false
                }
            }
        }
        adv(cur)
        var ret = "None"
        if tok(toks, cur) == "->" {
            adv(cur)
            ret = parse_type(toks, cur)
        }
        ty = "Fn \{ params: [" + ps + "], ret: " + ret + "}"
        return type_postfix(toks, cur, ty)
    }
    ty = "Named \{ path: [\"" + nm + "\"], args: []}"
    if tok(toks, cur) == "[" {
        var nx = toks[cur.load() + 1]
        var isempty = false
        if nx == "]" {
            isempty = true
        }
        var single = false
        if !isempty && nx != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx, 0)) {
            single = true
        }
        if !isempty && !single {
            adv(cur)
            var args = ""
            var k2: I32 = 0
            var more2 = true
            while more2 {
                if tok(toks, cur) == "]" {
                    more2 = false
                } else {
                    var a = parse_type(toks, cur)
                    if k2 > 0 {
                        args = args + ", "
                    }
                    args = args + a
                    k2 += 1
                    if tok(toks, cur) == "," {
                        adv(cur)
                    } else {
                        more2 = false
                    }
                }
            }
            adv(cur)
            ty = "Named \{ path: [\"" + nm + "\"], args: [" + args + "]}"
        }
    }
    return type_postfix(toks, cur, ty)
}

fn parse_block(toks: List[Str], cur: Atomic[I32]) -> Str {
    var ss = ""
    var k: I32 = 0
    var tail = "None"
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var t = tok(toks, cur)
        if or2(t == "}", t == "#EOF") {
            go = false
        } else if or2(t == "let", t == "var") {
            var isv = "false"
            if t == "var" {
                isv = "true"
            }
            adv(cur)
            var pn = parse_pattern(toks, cur)
            var ty = "None"
            if tok(toks, cur) == ":" {
                adv(cur)
                ty = parse_type(toks, cur)
            }
            adv(cur)
            var e = parse_expr(toks, cur)
            if k > 0 {
                ss = ss + ", "
            }
            ss = ss + "Let \{ is_var: " + isv + ", pattern: " + pn + ", ty: " + ty + ", expr: " + e + "}"
            k += 1
        } else if t == "return" {
            adv(cur)
            var e = parse_expr(toks, cur)
            if k > 0 {
                ss = ss + ", "
            }
            ss = ss + "Return(" + e + ")"
            k += 1
        } else if t == "while" {
            adv(cur)
            var cond = parse_expr(toks, cur)
            adv(cur)
            var body = parse_block(toks, cur)
            if k > 0 {
                ss = ss + ", "
            }
            ss = ss + "While \{ cond: " + cond + ", body: " + body + "}"
            k += 1
        } else if t == "for" {
            adv(cur)
            var pn = parse_pattern(toks, cur)
            adv(cur)
            var iter = parse_expr(toks, cur)
            adv(cur)
            var body = parse_block(toks, cur)
            if k > 0 {
                ss = ss + ", "
            }
            ss = ss + "For \{ pattern: " + pn + ", iter: " + iter + ", body: " + body + "}"
            k += 1
        } else {
            var e = parse_expr(toks, cur)
            var t2 = tok(toks, cur)
            var op = ""
            if t2 == "=" {
                op = "Eq"
            }
            if t2 == "+=" {
                op = "AddEq"
            }
            if t2 == "-=" {
                op = "SubEq"
            }
            if t2 == "*=" {
                op = "MulEq"
            }
            if t2 == "/=" {
                op = "DivEq"
            }
            if t2 == "%=" {
                op = "ModEq"
            }
            if op == "" {
                var nx = t2
                if nx == "NL" {
                    while tok(toks, cur) == "NL" {
                        adv(cur)
                    }
                    nx = tok(toks, cur)
                }
                if nx == "}" {
                    tail = e
                    go = false
                } else {
                    if k > 0 {
                        ss = ss + ", "
                    }
                    ss = ss + "Expr(" + e + ")"
                    k += 1
                }
            } else {
                adv(cur)
                var v = parse_expr(toks, cur)
                if k > 0 {
                    ss = ss + ", "
                }
                ss = ss + "Assign \{ target: " + e + ", op: " + op + ", value: " + v + "}"
                k += 1
            }
        }
    }
    while tok(toks, cur) == "NL" {
        adv(cur)
    }
    adv(cur)
    return "Block \{ stmts: [" + ss + "], tail: " + tail + "}"
}

fn parse_attrs(toks: List[Str], cur: Atomic[I32]) -> Str {
    var out = ""
    var k: I32 = 0
    var go = true
    while go {
        if tok(toks, cur) == "#" && toks[cur.load() + 1] == "[" {
            adv(cur)
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            while tok(toks, cur) != "]" && tok(toks, cur) != "#EOF" {
                adv(cur)
            }
            if tok(toks, cur) == "]" {
                adv(cur)
            }
            if k > 0 {
                out = out + ", "
            }
            out = out + "Attribute \{ name: \"" + nm + "\", args: []}"
            k += 1
        } else {
            go = false
        }
    }
    return "[" + out + "]"
}

fn parse_fndecl(toks: List[Str], cur: Atomic[I32], tag: Str) -> Str {
    skip_nl(toks, cur)
    var isc = "false"
    if tok(toks, cur) == "comptime" {
        isc = "true"
        adv(cur)
    }
    var attrs = parse_attrs(toks, cur)
    skip_nl(toks, cur)
    var vis = "Private"
    if tok(toks, cur) == "pub" {
        vis = "Pub"
        adv(cur)
    }
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = "[]"
    if tok(toks, cur) == "[" {
        tp = parse_type_params(toks, cur)
    }
    adv(cur)
    var ps = ""
    var k: I32 = 0
    var more = true
    while more {
        if tok(toks, cur) == ")" {
            more = false
        } else {
            var isv = "false"
            var t0 = tok(toks, cur)
            if t0 == "var" {
                isv = "true"
                adv(cur)
            }
            if t0 == "let" {
                adv(cur)
            }
            if tok(toks, cur) == "&" {
                adv(cur)
            }
            var pn = tok(toks, cur)
            adv(cur)
            var entry = ""
            if pn == "self" {
                entry = "Receiver \{ is_var: " + isv + " }"
            } else {
                adv(cur)
                var ty = parse_type(toks, cur)
                entry = "Param \{ is_var: " + isv + ", name: \"" + pn + "\", ty: " + ty + "}"
            }
            if k > 0 {
                ps = ps + ", "
            }
            ps = ps + entry
            k += 1
            if tok(toks, cur) == "," {
                adv(cur)
            } else {
                more = false
            }
        }
    }
    adv(cur)
    var ret = "None"
    if tok(toks, cur) == "->" {
        adv(cur)
        ret = parse_type(toks, cur)
    }
    var body = "None"
    if tok(toks, cur) == "\{" {
        adv(cur)
        body = parse_block(toks, cur)
    }
    var out = tag + " \{ attrs: " + attrs + ", vis: " + vis + ", is_comptime: " + isc + ", abi: None, name: \"" + nm + "\", type_params: " + tp + ", params: [" + ps + "], ret: " + ret
    out = out + ", body: " + body + "}"
    return out
}

fn parse_fn(toks: List[Str], cur: Atomic[I32]) -> Str {
    return parse_fndecl(toks, cur, "Fn")
}

fn parse_class(toks: List[Str], cur: Atomic[I32]) -> Str {
    skip_nl(toks, cur)
    var vis = parse_vis_word(toks, cur)
    var drv = parse_derive(toks, cur)
    skip_nl(toks, cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = "[]"
    if tok(toks, cur) == "[" {
        tp = parse_type_params(toks, cur)
    }
    skip_nl(toks, cur)
    adv(cur)
    var it = ""
    var k: I32 = 0
    var go = true
    while go {
        skip_nl(toks, cur)
        var t = tok(toks, cur)
        if t == "}" {
            go = false
        } else if t == "#EOF" {
            go = false
        } else {
            var item = ""
            if or2(t == "fn", t == "#") {
                item = parse_fndecl(toks, cur, "Method")
            } else if t == "prop" {
                item = parse_prop_imp(toks, cur)
            } else {
                item = parse_field(toks, cur)
            }
            if k > 0 {
                it = it + ", "
            }
            it = it + item
            k += 1
        }
    }
    adv(cur)
    return "Class \{ attrs: [], name: \"" + nm + "\", type_params: " + tp + ", items: [" + it + "] }"
}

fn parse_impl(toks: List[Str], cur: Atomic[I32]) -> Str {
    skip_nl(toks, cur)
    adv(cur)
    var tp = "[]"
    if tok(toks, cur) == "[" {
        tp = parse_type_params(toks, cur)
    }
    var tr = parse_type(toks, cur)
    adv(cur)
    var ft = parse_type(toks, cur)
    skip_nl(toks, cur)
    adv(cur)
    var it = ""
    var k: I32 = 0
    var go = true
    while go {
        skip_nl(toks, cur)
        var t = tok(toks, cur)
        if t == "}" {
            go = false
        } else if t == "#EOF" {
            go = false
        } else {
            var item = ""
            if or2(t == "fn", t == "#") {
                item = parse_fndecl(toks, cur, "Method")
            } else {
                item = parse_prop_imp(toks, cur)
            }
            if k > 0 {
                it = it + ", "
            }
            it = it + item
            k += 1
        }
    }
    adv(cur)
    return "Impl \{ type_params: " + tp + ", trait_ty: " + tr + ", for_ty: " + ft + ", items: [" + it + "] }"
}

fn parse_test(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var t = tok(toks, cur)
    adv(cur)
    var nm = q_text(byte_slice(t, 1, t.len - 1))
    adv(cur)
    var body = parse_block(toks, cur)
    return "Test \{ name: \"" + nm + "\", body: " + body + "}"
}

fn decl_kind(toks: List[Str], cur: Atomic[I32]) -> Str {
    var i = cur.load()
    var go = true
    while go {
        var t = toks[i]
        if t == "NL" {
            i += 1
        } else if t == "#" {
            i += 1
            i += 1
            var d2: I32 = 1
            while d2 > 0 {
                i += 1
                var tt2 = toks[i]
                if tt2 == "[" {
                    d2 += 1
                }
                if tt2 == "]" {
                    d2 -= 1
                }
            }
            i += 1
        } else if t == "comptime" {
            i += 1
        } else if t == "pub" {
            i += 1
        } else if t == "@" {
            i += 1
            i += 1
            var d: I32 = 1
            while d > 0 {
                i += 1
                var tt = toks[i]
                if tt == "(" {
                    d += 1
                }
                if tt == ")" {
                    d -= 1
                }
            }
            i += 1
        } else {
            go = false
        }
    }
    return toks[i]
}

fn parse_derive(toks: List[Str], cur: Atomic[I32]) -> Str {
    var out = "[]"
    if tok(toks, cur) == "@" {
        adv(cur)
        adv(cur)
        adv(cur)
        var ds = ""
        var k: I32 = 0
        var more = true
        while more {
            if tok(toks, cur) == ")" {
                more = false
            } else {
                var a = tok(toks, cur)
                adv(cur)
                if k > 0 {
                    ds = ds + ", "
                }
                ds = ds + "\"" + a + "\""
                k += 1
                if tok(toks, cur) == "," {
                    adv(cur)
                } else {
                    more = false
                }
            }
        }
        adv(cur)
        out = "[" + ds + "]"
    }
    return out
}

fn parse_vis_word(toks: List[Str], cur: Atomic[I32]) -> Str {
    var vis = "Private"
    if tok(toks, cur) == "pub" {
        vis = "Pub"
        adv(cur)
    }
    return vis
}

fn parse_type_params(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var out = ""
    var k: I32 = 0
    var more = true
    while more {
        if tok(toks, cur) == "]" {
            more = false
        } else {
            var isc = "false"
            if tok(toks, cur) == "comptime" {
                isc = "true"
                adv(cur)
            }
            var nm = tok(toks, cur)
            adv(cur)
            var bs = ""
            var k2: I32 = 0
            if tok(toks, cur) == ":" {
                adv(cur)
                var more2 = true
                while more2 {
                    var b = tok(toks, cur)
                    adv(cur)
                    if k2 > 0 {
                        bs = bs + ", "
                    }
                    bs = bs + "\"" + b + "\""
                    k2 += 1
                    if tok(toks, cur) == "+" {
                        adv(cur)
                    } else {
                        more2 = false
                    }
                }
            }
            if k > 0 {
                out = out + ", "
            }
            out = out + "TypeParam \{ name: \"" + nm + "\", bound: [" + bs + "], is_comptime: " + isc + " }"
            k += 1
            if tok(toks, cur) == "," {
                adv(cur)
            } else {
                more = false
            }
        }
    }
    adv(cur)
    return "[" + out + "]"
}

fn parse_field(toks: List[Str], cur: Atomic[I32]) -> Str {
    var vis = parse_vis_word(toks, cur)
    var isv = "false"
    var t = tok(toks, cur)
    if or2(t == "let", t == "var") {
        if t == "var" {
            isv = "true"
        }
        adv(cur)
    }
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = parse_type(toks, cur)
    return "Field \{ vis: " + vis + ", is_var: " + isv + ", name: \"" + nm + "\", ty: " + ty + "}"
}

fn skip_nl(toks: List[Str], cur: Atomic[I32]) {
    while tok(toks, cur) == "NL" {
        adv(cur)
    }
}

fn parse_struct(toks: List[Str], cur: Atomic[I32]) -> Str {
    skip_nl(toks, cur)
    var vis = parse_vis_word(toks, cur)
    var drv = parse_derive(toks, cur)
    skip_nl(toks, cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = "[]"
    if tok(toks, cur) == "[" {
        tp = parse_type_params(toks, cur)
    }
    skip_nl(toks, cur)
    adv(cur)
    var fs = ""
    var k: I32 = 0
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" {
            go = false
        } else if tok(toks, cur) == "#EOF" {
            go = false
        } else {
            var f = parse_field(toks, cur)
            if k > 0 {
                fs = fs + ", "
            }
            fs = fs + f
            k += 1
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "," {
                adv(cur)
            }
        }
    }
    adv(cur)
    var out = "Struct \{ attrs: [], derives: " + drv + ", name: \"" + nm + "\", type_params: " + tp + ", fields: [" + fs + "] }"
    return out
}

fn parse_enum(toks: List[Str], cur: Atomic[I32]) -> Str {
    skip_nl(toks, cur)
    var vis = parse_vis_word(toks, cur)
    var drv = parse_derive(toks, cur)
    skip_nl(toks, cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = "[]"
    if tok(toks, cur) == "[" {
        tp = parse_type_params(toks, cur)
    }
    skip_nl(toks, cur)
    adv(cur)
    var vs = ""
    var k: I32 = 0
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" {
            go = false
        } else if tok(toks, cur) == "#EOF" {
            go = false
        } else {
            var vn = tok(toks, cur)
            adv(cur)
            var kind = "Unit"
            if tok(toks, cur) == "(" {
                adv(cur)
                var es = ""
                var k2: I32 = 0
                var more2 = true
                while more2 {
                    if tok(toks, cur) == ")" {
                        more2 = false
                    } else {
                        var a = parse_type(toks, cur)
                        if k2 > 0 {
                            es = es + ", "
                        }
                        es = es + a
                        k2 += 1
                        if tok(toks, cur) == "," {
                            adv(cur)
                        } else {
                            more2 = false
                        }
                    }
                }
                adv(cur)
                kind = "Tuple(" + es + ")"
            } else if tok(toks, cur) == "\{" {
                adv(cur)
                var fs = ""
                var k3: I32 = 0
                var more3 = true
                while more3 {
                    while tok(toks, cur) == "NL" {
                        adv(cur)
                    }
                    if tok(toks, cur) == "}" {
                        more3 = false
                    } else if tok(toks, cur) == "#EOF" {
                        more3 = false
                    } else {
                        var f = parse_field(toks, cur)
                        if k3 > 0 {
                            fs = fs + ", "
                        }
                        fs = fs + f
                        k3 += 1
                        while tok(toks, cur) == "NL" {
                            adv(cur)
                        }
                        if tok(toks, cur) == "," {
                            adv(cur)
                        }
                    }
                }
                adv(cur)
                kind = "Struct([" + fs + "])"
            }
            if k > 0 {
                vs = vs + ", "
            }
            vs = vs + "Variant \{ name: \"" + vn + "\", kind: " + kind + "}"
            k += 1
        }
    }
    adv(cur)
    return "Enum \{ attrs: [], derives: " + drv + ", name: \"" + nm + "\", type_params: " + tp + ", variants: [" + vs + "] }"
}

fn parse_use(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var segs = ""
    var k: I32 = 0
    var go = true
    while go {
        var a = tok(toks, cur)
        if a == "#EOF" {
            go = false
        } else if a == "NL" {
            go = false
        } else if a == "." {
            adv(cur)
        } else if a == "\{" {
            adv(cur)
            var more2 = true
            while more2 {
                var bb = tok(toks, cur)
                if bb == "}" {
                    more2 = false
                } else if bb == "#EOF" {
                    more2 = false
                } else {
                    adv(cur)
                    if k > 0 {
                        segs = segs + ", "
                    }
                    segs = segs + "\"" + bb + "\""
                    k += 1
                    if tok(toks, cur) == "," {
                        adv(cur)
                    }
                }
            }
            if tok(toks, cur) == "}" {
                adv(cur)
            }
            go = false
        } else {
            adv(cur)
            if k > 0 {
                segs = segs + ", "
            }
            segs = segs + "\"" + a + "\""
            k += 1
        }
    }
    return "Use \{ imports: [[" + segs + "]] }"
}

fn parse_const(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = parse_type(toks, cur)
    adv(cur)
    var e = parse_expr(toks, cur)
    return "Const \{ name: \"" + nm + "\", ty: " + ty + ", expr: " + e + "}"
}

fn parse_static(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    var wv = "false"
    var t = tok(toks, cur)
    if t == "var" {
        wv = "true"
    }
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = parse_type(toks, cur)
    adv(cur)
    var e = parse_expr(toks, cur)
    return "Static \{ name: \"" + nm + "\", was_var: " + wv + ", ty: " + ty + ", expr: " + e + "}"
}

fn parse_prop_core(toks: List[Str], cur: Atomic[I32], tag0: Str, tag1: Str) -> Str {
    var vis = parse_vis_word(toks, cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = parse_type(toks, cur)
    var body = "None"
    var tag = tag0
    if tok(toks, cur) == "\{" {
        adv(cur)
        body = parse_block(toks, cur)
        tag = tag1
    }
    return tag + " \{ vis: " + vis + ", name: \"" + nm + "\", ty: " + ty + ", body: " + body + "}"
}

fn parse_prop(toks: List[Str], cur: Atomic[I32]) -> Str {
    return parse_prop_core(toks, cur, "PropSig", "PropImpl")
}

fn parse_prop_imp(toks: List[Str], cur: Atomic[I32]) -> Str {
    return parse_prop_core(toks, cur, "Prop", "Prop")
}

fn parse_trait(toks: List[Str], cur: Atomic[I32]) -> Str {
    skip_nl(toks, cur)
    var vis = parse_vis_word(toks, cur)
    var drv = parse_derive(toks, cur)
    skip_nl(toks, cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = "[]"
    if tok(toks, cur) == "[" {
        tp = parse_type_params(toks, cur)
    }
    var sup = ""
    var k0: I32 = 0
    if tok(toks, cur) == ":" {
        adv(cur)
        var more0 = true
        while more0 {
            var a = tok(toks, cur)
            adv(cur)
            if k0 > 0 {
                sup = sup + ", "
            }
            sup = sup + "\"" + a + "\""
            k0 += 1
            if tok(toks, cur) == "+" {
                adv(cur)
            } else {
                more0 = false
            }
        }
    }
    skip_nl(toks, cur)
    adv(cur)
    var it = ""
    var k: I32 = 0
    var go = true
    while go {
        skip_nl(toks, cur)
        var t = tok(toks, cur)
        if t == "}" {
            go = false
        } else if t == "#EOF" {
            go = false
        } else {
            var item = ""
            if or2(t == "fn", t == "#") {
                item = parse_fndecl(toks, cur, "Method")
            } else {
                item = parse_prop(toks, cur)
            }
            if k > 0 {
                it = it + ", "
            }
            it = it + item
            k += 1
        }
    }
    adv(cur)
    return "Trait \{ attrs: [], name: \"" + nm + "\", type_params: " + tp + ", supers: [" + sup + "], items: [" + it + "] }"
}

fn parse_scope(toks: List[Str], cur: Atomic[I32]) -> Str {
    adv(cur)
    adv(cur)
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var body = parse_block(toks, cur)
    return "Scope \{ param: \"" + nm + "\", body: " + body + "}"
}

fn parse_file(toks: List[Str], cur: Atomic[I32]) -> Str {
    var out = "File \{ decls: ["
    var k: I32 = 0
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "#EOF" {
            go = false
        } else {
                    var d = "?"
            var kd = decl_kind(toks, cur)
            if kd == "test" {
                d = parse_test(toks, cur)
            } else if kd == "fn" {
                d = parse_fn(toks, cur)
            } else if kd == "struct" {
                d = parse_struct(toks, cur)
            } else if kd == "enum" {
                d = parse_enum(toks, cur)
            } else if kd == "use" {
                d = parse_use(toks, cur)
            } else if kd == "const" {
                d = parse_const(toks, cur)
            } else if kd == "static" {
                d = parse_static(toks, cur)
            } else if kd == "class" {
                d = parse_class(toks, cur)
            } else if kd == "impl" {
                d = parse_impl(toks, cur)
            } else if kd == "trait" {
                d = parse_trait(toks, cur)
            } else {
                d = parse_fn(toks, cur)
            }
            if k > 0 {
                out = out + ",\n  "
            } else {
                out = out + "\n  "
            }
            out = out + d
            k += 1
        }
    }
    out = out + "\n] }\n"
    return out
}

fn main() -> I32 {
    let src = read_file("../selfhosted/input_parse_ast.ct")
    match src {
        Some(s) => {
            var toks = List[Str]()
            scan(s, toks)
            var cur = Atomic[I32](0)
            var text = parse_file(toks, cur)
            print(text)
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
