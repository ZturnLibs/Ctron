struct Pt {
    var x: I32
    var y: I32
}

enum Color {
    Red
    Green
    Blue
}

fn name_of(c: Color) -> Str {
    return match c {
        Red => "red"
        Green => "green"
        Blue => "blue"
    }
}

fn maybe_even(n: I32) -> I32? {
    if n % 2 == 1 {
        return None
    }
    return Some(n)
}

fn add2(x: I32) -> I32 {
    return x + 2
}

fn main() -> I32 {
    var xs = [3, 5, 7]
    var t = 0
    for i in 0..xs.len {
        t = t + xs[i]
    }
    println(t.to_string())
    var u = 0
    for x in xs {
        u = u + x
    }
    println(u.to_string())
    var s = ""
    match 5 {
        5 => { s = "five" }
        _ => { s = "other" }
    }
    println(s)
    var a = maybe_even(6)
    var o1 = ""
    match a {
        Some(v) => { o1 = v.to_string() }
        None => { o1 = "none" }
    }
    println(o1)
    var b = maybe_even(3)
    var o2 = ""
    match b {
        Some(v) => { o2 = v.to_string() }
        None => { o2 = "none" }
    }
    println(o2)
    var p = Pt { x: 2, y: 3 }
    println(p.x.to_string())
    println(name_of(Green))
    println(add2(40).to_string())
    return 0
}
