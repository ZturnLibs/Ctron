// ctcl_chk.ct —— CTCL 清单校验器(自举线;第四线黄金对拍口径,规范 config-language-v1 §9)
// 语义镜像 C 线 ctcl_load / Rust 线 parse_manifest_full:全量 E 码 + 规范消息 + did-you-mean。
// 用法:ctronc run ../selfhosted/ctcl_chk.ct(扫描 ../tests/manifest/all 下全部 .ctcl)
// 注:本文件不渲染规范形态(第四臂仅对拍诊断);种子 I32 数值域为已知限值。

// BRACE_ANCHOR: { ... }
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }

fn seq2(a: Str, b: Str) -> Bool {
    if a.len != b.len {
        return false
    }
    var i: I32 = 0
    while i < a.len {
        if byte_at(a, i) != byte_at(b, i) {
            return false
        }
        i += 1
    }
    return true
}

// 花括号字面量经自身源码切片取得(种子字符串插值禁止裸花括号)
fn c_anchor_src() -> Str {
    var t = ""
    match read_file("../selfhosted/ctcl_chk.ct") {
        Some(x) => {
            t = x
        }
        None => {}
    }
    return t
}

fn c_lb() -> Str {
    var t = c_anchor_src()
    var i: I32 = 0
    while i < t.len {
        if c_at(t, i, "BRACE_ANCHOR:") {
            var j = i
            while j < t.len && byte_at(t, j) != 123 {
                j += 1
            }
            return byte_slice(t, j, j + 1)
        }
        i += 1
    }
    return ""
}

fn c_rb() -> Str {
    var t = c_anchor_src()
    var i: I32 = 0
    while i < t.len {
        if c_at(t, i, "BRACE_ANCHOR:") {
            var j = i
            while j < t.len && byte_at(t, j) != 123 {
                j += 1
            }
            while j < t.len && byte_at(t, j) != 125 {
                j += 1
            }
            return byte_slice(t, j, j + 1)
        }
        i += 1
    }
    return ""
}

fn c_dots() -> Str {
    return c_lb() + " ... " + c_rb()
}

fn c_block_hint() -> Str {
    return "pkg " + c_lb() + " ... " + c_rb() + " / dep \"名\" " + c_lb() + " ... " + c_rb()
}

fn c_print_ln(ds: List[Str], i: I32) -> I32 {
    print(ds[i])
    print("\n")
    return 0
}

fn c_at(t: Str, i: I32, key: Str) -> Bool {
    var k: I32 = 0
    while k < key.len {
        if i + k >= t.len || byte_at(t, i + k) != byte_at(key, k) {
            return false
        }
        k += 1
    }
    return true
}

fn c_pre(t: Str, i: I32) -> Bool {
    if i == 0 {
        return true
    }
    var p = byte_at(t, i - 1)
    if (p >= 97 && p <= 122) || p == 95 || (p >= 48 && p <= 57) {
        return false
    }
    return true
}

fn c_ident_len(t: Str, i: I32) -> I32 {
    if i >= t.len {
        return 0
    }
    var c = byte_at(t, i)
    if !((c >= 97 && c <= 122) || c == 95) {
        return 0
    }
    var n: I32 = 0
    while i + n < t.len {
        var d = byte_at(t, i + n)
        if (d >= 97 && d <= 122) || d == 95 || (d >= 48 && d <= 57) {
            n += 1
        } else {
            return n
        }
    }
    return n
}

fn c_trim(s: Str) -> Str {
    var a: I32 = 0
    var b = s.len
    while a < b && (byte_at(s, a) == 32 || byte_at(s, a) == 9) {
        a += 1
    }
    while b > a && (byte_at(s, b - 1) == 32 || byte_at(s, b - 1) == 9 || byte_at(s, b - 1) == 13) {
        b -= 1
    }
    return byte_slice(s, a, b)
}

fn c_split_nl(s: Str) -> List[Str] {
    var out = List[Str]()
    var start: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == 10 {
            out.push(byte_slice(s, start, i))
            start = i + 1
        }
        i += 1
    }
    if start < s.len {
        out.push(byte_slice(s, start, s.len))
    }
    return out
}

fn c_is_name(v: Str) -> Bool {
    if v.len == 0 {
        return false
    }
    if byte_at(v, 0) < 97 || byte_at(v, 0) > 122 {
        return false
    }
    var i: I32 = 0
    while i < v.len {
        var c = byte_at(v, i)
        if !((c >= 97 && c <= 122) || c == 95 || (c >= 48 && c <= 57) || c == 45) {
            return false
        }
        i += 1
    }
    return true
}

fn c_semver_pat() -> Str {
    return "(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?"
}

fn c_is_semver(v: Str) -> Bool {
    var np: I32 = 0
    var i: I32 = 0
    while i < v.len {
        var c = byte_at(v, i)
        if c == 46 {
            np += 1
            i += 1
        } else if c >= 48 && c <= 57 {
            i += 1
        } else {
            return false
        }
    }
    if np != 2 {
        return false
    }
    var segs = List[Str]()
    var st: I32 = 0
    var k: I32 = 0
    while k < v.len {
        if byte_at(v, k) == 46 {
            segs.push(byte_slice(v, st, k))
            st = k + 1
        }
        k += 1
    }
    segs.push(byte_slice(v, st, v.len))
    var si: I32 = 0
    while si < 3 {
        var seg = segs[si]
        if seg.len == 0 {
            return false
        }
        if seg.len == 1 && byte_at(seg, 0) == 48 {
            si += 1
            continue
        }
        if byte_at(seg, 0) < 49 || byte_at(seg, 0) > 57 {
            return false
        }
        si += 1
    }
    return true
}

fn c_is_int(v: Str) -> Bool {
    if v.len == 0 {
        return false
    }
    var i: I32 = 0
    if byte_at(v, 0) == 45 {
        i = 1
    }
    if i >= v.len {
        return false
    }
    if byte_at(v, i) == 48 {
        return v.len == i + 1
    }
    if byte_at(v, i) < 49 || byte_at(v, i) > 57 {
        return false
    }
    while i < v.len {
        if byte_at(v, i) < 48 || byte_at(v, i) > 57 {
            return false
        }
        i += 1
    }
    return true
}

fn c_is_float(v: Str) -> Bool {
    if v.len == 0 {
        return false
    }
    var i: I32 = 0
    if byte_at(v, 0) == 45 {
        i = 1
    }
    while i < v.len && byte_at(v, i) >= 48 && byte_at(v, i) <= 57 {
        i += 1
    }
    if i + 1 >= v.len || byte_at(v, i) != 46 {
        return false
    }
    return byte_at(v, i + 1) >= 48 && byte_at(v, i + 1) <= 57
}

fn c_lev(a: Str, b: Str) -> I32 {
    var la = a.len
    var lb = b.len
    if la > 40 {
        la = 40
    }
    if lb > 40 {
        lb = 40
    }
    var prev = List[I32]()
    var cur = List[I32]()
    var j: I32 = 0
    while j <= lb {
        prev.push(j)
        cur.push(0)
        j += 1
    }
    var i: I32 = 1
    while i <= la {
        cur[0] = i
        j = 1
        while j <= lb {
            var cost: I32 = 1
            if byte_at(a, i - 1) == byte_at(b, j - 1) {
                cost = 0
            }
            var m = prev[j] + 1
            if cur[j - 1] + 1 < m {
                m = cur[j - 1] + 1
            }
            if prev[j - 1] + cost < m {
                m = prev[j - 1] + cost
            }
            cur[j] = m
            j += 1
        }
        j = 0
        while j <= lb {
            prev[j] = cur[j]
            j += 1
        }
        i += 1
    }
    return prev[lb]
}

// 返回建议键;无建议返回 ""
fn c_close(k: Str, keys: List[Str]) -> Str {
    var bestd: I32 = 99
    var best = ""
    var i: I32 = 0
    while i < keys.len {
        var d = c_lev(k, keys[i])
        if d < bestd {
            bestd = d
            best = keys[i]
        }
        i += 1
    }
    if bestd <= 2 {
        return best
    }
    return ""
}

// 剥注释:返回 [代码段, 注释文本, 是否截断] 三元素
fn c_strip(line: Str) -> List[Str] {
    var code = ""
    var trail = ""
    var cut = 0
    var in_str = false
    var esc = false
    var i: I32 = 0
    var stopped = 0
    while i < line.len {
        var c = byte_at(line, i)
        if in_str {
            code = code + byte_slice(line, i, i + 1)
            if esc {
                esc = false
            } else if c == 92 {
                esc = true
            } else if c == 34 {
                in_str = false
            }
            i += 1
        } else if c == 34 {
            in_str = true
            code = code + byte_slice(line, i, i + 1)
            i += 1
        } else if c == 47 && i + 1 < line.len && byte_at(line, i + 1) == 47 {
            trail = c_trim(byte_slice(line, i + 2, line.len))
            stopped = 1
            break
        } else if c == 35 {
            trail = c_trim(byte_slice(line, i + 1, line.len))
            cut = 1
            stopped = 1
            break
        } else {
            code = code + byte_slice(line, i, i + 1)
            i += 1
        }
    }
    if in_str {
        stopped = 2
    }
    var out = List[Str]()
    out.push(code)
    out.push(trail)
    if cut > 0 {
        out.push("1")
    } else {
        out.push("0")
    }
    if stopped == 2 {
        out.push("unclosed")
    }
    return out
}

// 整值字符串:返回 [是否字符串值(0/1), 内容]
fn c_str_val(v: Str) -> List[Str] {
    var out = List[Str]()
    if v.len < 2 || byte_at(v, 0) != 34 || byte_at(v, v.len - 1) != 34 {
        out.push("0")
        out.push("")
        return out
    }
    var body = byte_slice(v, 1, v.len - 1)
    var out2 = ""
    var i: I32 = 0
    while i < body.len {
        var c = byte_at(body, i)
        if c == 92 {
            if i + 1 >= body.len {
                out.push("0")
                out.push("")
                return out
            }
            var n = byte_at(body, i + 1)
            if n != 34 && n != 92 {
                out.push("0")
                out.push("")
                return out
            }
            out2 = out2 + byte_slice(body, i + 1, i + 2)
            i += 2
        } else if c == 34 {
            out.push("0")
            out.push("")
            return out
        } else {
            out2 = out2 + byte_slice(body, i, i + 1)
            i += 1
        }
    }
    out.push("1")
    out.push(out2)
    return out
}

// 值分类:0=str 1=int 2=bool 3=list;-1=非法(已诊断)。列表内容写入 items。
fn c_classify(v: Str, ds: List[Str], ln: I32, items: List[Str]) -> I32 {
    if seq2(v, "true") || seq2(v, "false") {
        return 2
    }
    if byte_at(v, 0) == 39 {
        ds.push("E5048 不支持单引号字符串(唯一拼写:双引号)")
        return -1
    }
    if byte_at(v, 0) == 34 {
        var r = c_str_val(v)
        if seq2(r[0], "1") {
            items.push(r[1])
            return 0
        }
        ds.push("E5048 非法字符串值(转义只允许 反斜杠加引号 与 双反斜杠)")
        return -1
    }
    if c_is_int(v) {
        if v.len > 18 {
            ds.push("E5048 整数超出 I64")
            return -1
        }
        items.push(v)
        return 1
    }
    if c_is_float(v) {
        ds.push("E5040 不支持浮点;数值配置一律定点整数(如 85 表 85%)")
        return -1
    }
    if byte_at(v, 0) == 123 {
        ds.push("E5040 不支持内联表;复杂记录请用键控块表达(块 \"名\" " + c_lb() + " ... " + c_rb() + ")")
        return -1
    }
    if byte_at(v, 0) == 91 {
        if byte_at(v, v.len - 1) != 93 {
            ds.push("E5040 列表必须单行且以 ] 结尾;若元素是复杂结构,请改用键控块(块 \"名\" " + c_lb() + " ... " + c_rb() + ")而非多行列表")
            return -1
        }
        var inner = byte_slice(v, 1, v.len - 1)
        var t2 = c_trim(inner)
        if t2.len == 0 {
            return 3
        }
        if byte_at(t2, t2.len - 1) == 44 {
            ds.push("E5048 列表不允许尾逗号(最后元素后直接 ']')")
            return -1
        }
        var parts = List[Str]()
        var start: I32 = 0
        var i: I32 = 0
        while i < t2.len {
            if byte_at(t2, i) == 44 {
                parts.push(c_trim(byte_slice(t2, start, i)))
                start = i + 1
            }
            i += 1
        }
        parts.push(c_trim(byte_slice(t2, start, t2.len)))
        var bad = 0
        i = 0
        while i < parts.len {
            var r = c_str_val(parts[i])
            if seq2(r[0], "1") {
                items.push(r[1])
            } else {
                ds.push("E5048 列表元素必须是双引号字符串;复杂结构请用键控块")
                bad = 1
                break
            }
            i += 1
        }
        if bad > 0 {
            // 清回退:整列表非法
            while items.len > 0 {
                items.pop()
            }
            return -1
        }
        return 3
    }
    ds.push("E5040 无法识别的值:" + v)
    return -1
}

fn validate_text(t: Str) -> List[Str] {
    var ds = List[Str]()
    var block = ""
    var skipping = false
    var bal: I32 = 0
    var saw_pkg = false
    var saw_name = false
    var saw_version = false
    var has_mver = false
    var mver_ok = false
    var b_saw_pkg = false
    var b_saw_name = false
    var b_saw_version = false
    var b_has_mver = false
    var b_mver_ok = false
    var dep_active = false
    var has_path = 0
    var has_git = 0
    var has_rev = 0
    var has_version = 0
    var seen_keys = List[Str]()
    var seen_deps = List[Str]()
    var seen_dep_ln = List[I32]()
    var comptime_seen = false
    var budget_ok = false
    var budget: I32 = 0

    var lines = c_split_nl(t)
    var ln: I32 = 0
    while ln < lines.len {
        ln += 1
        var parts = c_strip(lines[ln - 1])
        if parts.len > 3 {
            ds.push("E5040 字符串未闭合")
            continue
        }
        if seq2(parts[2], "1") {
            ds.push("E5042 本语言注释是 // 而非 #(与宿主语言一致);本行已按 // 恢复")
        }
        var line = c_trim(parts[0])
        if line.len == 0 {
            continue
        }

        if block.len > 0 && skipping {
            var i: I32 = 0
            while i < line.len {
                if byte_at(line, i) == 123 {
                    bal += 1
                }
                if byte_at(line, i) == 125 {
                    bal -= 1
                }
                i += 1
            }
            if bal <= 0 {
                skipping = false
            }
            continue
        }

        if block.len > 0 {
            if seq2(line, "}") {
            if b_saw_pkg {
                saw_pkg = true
            }
            if b_saw_name {
                saw_name = true
            }
            if b_saw_version {
                saw_version = true
            }
            if b_has_mver {
                has_mver = true
            }
            if b_mver_ok {
                mver_ok = true
            }
            b_saw_pkg = false
            b_saw_name = false
            b_saw_version = false
            b_has_mver = false
            b_mver_ok = false
                if dep_active {
                    var np: I32 = 0
                    var first = ""
                    var second = ""
                    if has_path > 0 {
                        if np == 0 {
                            first = "path"
                        } else if np == 1 {
                            second = "path"
                        }
                        np += 1
                    }
                    var g2 = 0
                    if has_git > 0 && has_rev > 0 {
                        g2 = 1
                    }
                    if g2 > 0 {
                        if np == 0 {
                            first = "git+rev"
                        } else {
                            second = "git+rev"
                        }
                        np += 1
                    }
                    if has_version > 0 {
                        if np == 0 {
                            second = "version"
                        } else if np == 1 {
                            second = "version"
                        }
                        np += 1
                    }
                    if np >= 2 {
                        ds.push("E5049 dep 来源互斥:" + first + " 与 " + second + " 同现")
                    } else if np == 0 {
                        ds.push("E5049 dep 需要且仅需要一种来源:path | git+rev | version")
                    }
                    dep_active = false
                }
                block = ""
                continue
            }
            var has_brace = false
            var i2: I32 = 0
            while i2 < line.len {
                if byte_at(line, i2) == 123 || byte_at(line, i2) == 125 {
                    has_brace = true
                }
                i2 += 1
            }
            if has_brace {
                ds.push("E5040 块内禁止嵌套块/单行块(深度恒 1);此块已被跳过")
                skipping = true
                bal = 0
                i2 = 0
                while i2 < line.len {
                    if byte_at(line, i2) == 123 {
                        bal += 1
                    }
                    if byte_at(line, i2) == 125 {
                        bal -= 1
                    }
                    i2 += 1
                }
                continue
            }
        }

        if block.len == 0 {
            if byte_at(line, 0) == 91 {
                ds.push("E5040 本语言不用 [section] 段头;请用块:" + c_block_hint())
                continue
            }
            var il = c_ident_len(line, 0)
            if il == 0 {
                ds.push("E5040 块外只允许块头(NAME [\"名\"]) " + c_lb())
                continue
            }
            var id = byte_slice(line, 0, il)
            var rest_raw = byte_slice(line, il, line.len)
            var rs = c_trim(rest_raw)
            var rest_first: I32 = -1
            var z: I32 = 0
            while z < rest_raw.len {
                if byte_at(rest_raw, z) != 32 && byte_at(rest_raw, z) != 9 {
                    rest_first = z
                    z = rest_raw.len
                }
                z += 1
            }
            var has_arg = rs.len > 0 && byte_at(rs, 0) == 34
            if has_arg && rest_first >= 0 && byte_at(rest_raw, rest_first) != 34 {
                // 首个非空白不是引号 → 无实参或非法;仅当实参存在且紧贴时才报空格
            }
            var spaced = rest_raw.len > 0 && (byte_at(rest_raw, 0) == 32 || byte_at(rest_raw, 0) == 9)
            if has_arg && !spaced {
                ds.push("E5040 块名与名字实参之间需要空格:dep \"名\"")
            }
            var rest = rs
            var arg = ""
            var tail = rest
            if rest.len > 0 && byte_at(rest, 0) == 34 {
                var q = List[Str]()
                q.push("")
                var qi: I32 = 1
                var closed = 0
                while qi < rest.len {
                    if byte_at(rest, qi) == 92 && qi + 1 < rest.len {
                        q.push(byte_slice(rest, qi + 1, qi + 2))
                        qi += 2
                    } else if byte_at(rest, qi) == 34 {
                        closed = 1
                        qi += 1
                        break
                    } else {
                        q.push(byte_slice(rest, qi, qi + 1))
                        qi += 1
                    }
                }
                if closed == 0 {
                    ds.push("E5040 非法的名字实参")
                    continue
                }
                var qq: I32 = 1
                while qq < q.len {
                    arg = arg + q[qq]
                    qq += 1
                }
                tail = c_trim(byte_slice(rest, qi, rest.len))
            }
            var tail_ok = tail.len > 0 && byte_at(tail, tail.len - 1) == 123
            if !tail_ok {
                ds.push("E5040 块外只允许块头(NAME [\"名\"]) " + c_lb())
                continue
            }
            if !or2(seq2(id, "pkg"), or2(seq2(id, "comptime"), seq2(id, "dep"))) {
                ds.push("E5044 未知块 " + id + ";合法块:comptime, dep, pkg")
                block = "skip"
                continue
            }
            seen_keys = List[Str]()
            if seq2(id, "dep") {
                if arg.len == 0 {
                    ds.push("E5041 dep 是键控块:dep \"名\" " + c_lb() + " ... " + c_rb())
                    block = "skip"
                    continue
                }
                if !c_is_name(arg) {
                    ds.push("E5048 键控块名 '" + arg + "' 不符合包名规则")
                    block = "skip"
                    continue
                }
                var dupi: I32 = -1
                var i3: I32 = 0
                while i3 < seen_deps.len {
                    if seq2(seen_deps[i3], arg) {
                        dupi = i3
                    }
                    i3 += 1
                }
                if dupi >= 0 {
                    ds.push("E5045 重复的 dep \"" + arg + "\"(首次在第 " + seen_dep_ln[dupi].to_string() + " 行);同名块禁止追加")
                } else {
                    seen_deps.push(arg)
                    seen_dep_ln.push(ln)
                }
                dep_active = true
                has_path = 0
                has_git = 0
                has_rev = 0
                has_version = 0
            } else if seq2(id, "pkg") && arg.len > 0 {
                ds.push("E5041 pkg 是记录块,不带名字实参")
                block = "skip"
                continue
            }
            if seq2(id, "pkg") {
                b_saw_pkg = true
            }
            block = id
            continue
        }

        // 字段:IDENT = value
        var eq: I32 = -1
        var z4: I32 = 0
        while z4 < line.len {
            if byte_at(line, z4) == 61 {
                eq = z4
            }
            z4 += 1
        }
        if eq < 0 {
            ds.push("E5040 块内每行必须是 键 = 值")
            continue
        }
        var key = c_trim(byte_slice(line, 0, eq))
        var klen = c_ident_len(key, 0)
        if klen != key.len {
            ds.push("E5040 块内每行必须是 键 = 值")
            continue
        }
        var val = c_trim(byte_slice(line, eq + 1, line.len))

        // 值词法分类
        var items = List[Str]()
        var int_txt = ""
        var vkind: I32 = -1
        if seq2(val, "true") || seq2(val, "false") {
            vkind = 2
        } else if byte_at(val, 0) == 39 {
            ds.push("E5048 不支持单引号字符串(唯一拼写:双引号)")
            vkind = -1
        } else if byte_at(val, 0) == 34 {
            var r = c_str_val(val)
            if seq2(r[0], "1") {
                vkind = 0
                items.push(r[1])
            } else {
                ds.push("E5048 非法字符串值(转义只允许 反斜杠加引号 与 双反斜杠)")
                vkind = -1
            }
        } else if c_is_int(val) {
            if val.len > 18 {
                ds.push("E5048 整数超出 I64")
                vkind = -1
            } else {
                vkind = 1
                int_txt = val
            }
        } else if c_is_float(val) {
            ds.push("E5040 不支持浮点;数值配置一律定点整数(如 85 表 85%)")
            vkind = -1
        } else if byte_at(val, 0) == 123 {
            ds.push("E5040 不支持内联表;复杂记录请用键控块表达(块 \"名\" " + c_lb() + " ... " + c_rb() + ")")
            vkind = -1
        } else if byte_at(val, 0) == 91 {
            if byte_at(val, val.len - 1) != 93 {
                ds.push("E5040 列表必须单行且以 ] 结尾;若元素是复杂结构,请改用键控块(块 \"名\" " + c_lb() + " ... " + c_rb() + ")而非多行列表")
                vkind = -1
            } else {
                var inner = c_trim(byte_slice(val, 1, val.len - 1))
                if inner.len == 0 {
                    vkind = 3
                } else if byte_at(inner, inner.len - 1) == 44 {
                    ds.push("E5048 列表不允许尾逗号(最后元素后直接 ']')")
                    vkind = -1
                } else {
                    var bad = 0
                    var start: I32 = 0
                    var i5: I32 = 0
                    while i5 <= inner.len {
                        if i5 == inner.len || byte_at(inner, i5) == 44 {
                            var elem = c_trim(byte_slice(inner, start, i5))
                            if elem.len == 0 {
                                ds.push("E5048 列表元素必须是双引号字符串;复杂结构请用键控块")
                                bad = 1
                                break
                            }
                            var r5 = c_str_val(elem)
                            if seq2(r5[0], "1") {
                                items.push(r5[1])
                            } else {
                                ds.push("E5048 列表元素必须是双引号字符串;复杂结构请用键控块")
                                bad = 1
                                break
                            }
                            start = i5 + 1
                        }
                        i5 += 1
                    }
                    if bad == 0 {
                        vkind = 3
                    } else {
                        vkind = -1
                    }
                }
            }
        } else {
            ds.push("E5040 无法识别的值:" + val)
            vkind = -1
        }

        // 重复键
        var dup = 0
        var i6: I32 = 0
        while i6 < seen_keys.len {
            if seq2(seen_keys[i6], key) {
                dup = 1
            }
            i6 += 1
        }
        if dup > 0 {
            ds.push("E5045 重复键 " + key + "(同名键只允许一次)")
            continue
        }
        seen_keys.push(key)

        if seq2(block, "pkg") {
            var known = or2(or2(seq2(key, "manifest_version"), seq2(key, "name")), or2(seq2(key, "version"), seq2(key, "caps")))
            if !known {
                var hint = ""
                var keys_l = List[Str]()
                keys_l.push("manifest_version")
                keys_l.push("name")
                keys_l.push("version")
                keys_l.push("caps")
                var d = c_close(key, keys_l)
                if d.len > 0 {
                    hint = ";你是不是想要 " + d + "?"
                }
                ds.push("E5043 块 pkg 中未知键 " + key + hint + ";合法键:manifest_version, name, version, caps")
                continue
            }
            if seq2(key, "manifest_version") {
                b_has_mver = true
                if vkind == -1 {
                    continue
                }
                if vkind == 1 {
                    if int_txt != "1" {
                        ds.push("E5050 manifest_version 必须为 1")
                    } else {
                        b_mver_ok = true
                    }
                } else {
                    ds.push("E5046 manifest_version 的类型应为 int")
                }
            } else if seq2(key, "name") {
                b_saw_name = true
                if vkind == -1 {
                    continue
                }
                if vkind == 0 {
                    if !c_is_name(items[0]) {
                        ds.push("E5046 键 name 值 '" + items[0] + "' 不符合 [a-z][a-z0-9_-]*")
                    }
                } else {
                    ds.push("E5046 name 的类型应为 str")
                }
            } else if seq2(key, "version") {
                b_saw_version = true
                if vkind == -1 {
                    continue
                }
                if vkind != 0 {
                    ds.push("E5046 version 的类型应为 str")
                } else if !c_is_semver(items[0]) {
                    ds.push("E5046 键 version 值 '" + items[0] + "' 不符合 " + c_semver_pat())
                }
            } else {
                if vkind == 3 {
                    var i7: I32 = 0
                    while i7 < items.len {
                        var x = items[i7]
                        if !or2(seq2(x, "fs"), seq2(x, "time")) {
                            ds.push("E5043 未知能力 " + x + ";合法:fs, time(能力是安全边界,未知即拒绝)")
                        }
                        i7 += 1
                    }
                } else if vkind >= 0 {
                    ds.push("E5046 caps 的类型应为 list")
                }
            }
        } else if seq2(block, "comptime") {
            if seq2(key, "budget_ms") {
                comptime_seen = true
                if vkind == -1 {
                    continue
                }
                if vkind == 1 && (byte_at(val, 0) == 45 || seq2(val, "0")) {
                    ds.push("E5046 键 budget_ms 必须 >= 1")
                }
                if vkind == 1 {
                    budget_ok = true
                    budget = 0

                    var sign: I32 = 1

                    var bi: I32 = 0

                    if byte_at(int_txt, 0) == 45 {

                        sign = -1

                        bi = 1

                    }

                    while bi < int_txt.len {

                        budget = budget * 10 + (byte_at(int_txt, bi) - 48)

                        bi += 1

                    }

                    budget = sign * budget
                } else {
                    ds.push("E5046 budget_ms 的类型应为 int")
                }
            } else {
                ds.push("E5043 块 comptime 中未知键 " + key + ";合法键:budget_ms")
            }
        } else {
            var known2 = or2(or2(seq2(key, "path"), seq2(key, "git")), or2(seq2(key, "rev"), seq2(key, "version")))
            if !known2 {
                ds.push("E5043 块 dep 中未知键 " + key + ";合法键:path, git, rev, version")
                continue
            }
            if seq2(key, "path") {
                has_path = 1
            } else if seq2(key, "git") {
                has_git = 1
            } else if seq2(key, "rev") {
                has_rev = 1
            } else {
                has_version = 1
            }
        }
    }

    if block != "" {
        ds.push("E5040 块未闭合(缺 })")
    }
    if !saw_pkg {
        ds.push("E5047 缺 pkg 块")
    } else {
        if !has_mver {
            ds.push("E5050 pkg 缺语言版本键 manifest_version(必须存在且 = 1)")
        } else if !mver_ok {
            ds.push("E5050 manifest_version 必须为 1")
        }
        if !saw_name {
            ds.push("E5047 pkg 缺必填键 name")
        }
        if !saw_version {
            ds.push("E5047 pkg 缺必填键 version")
        }
    }
    return ds
}

fn c_cmp(a: Str, b: Str) -> I32 {
    var i: I32 = 0
    while i < a.len && i < b.len {
        if byte_at(a, i) != byte_at(b, i) {
            if byte_at(a, i) < byte_at(b, i) {
                return -1
            }
            return 1
        }
        i += 1
    }
    if a.len < b.len {
        return -1
    }
    if a.len > b.len {
        return 1
    }
    return 0
}

fn main() -> I32 {
    var root = "../tests/manifest/all"
    var raw = ""
    match read_dir(root) {
        Some(s) => {
            raw = s
        }
        None => {}
    }
    var names = c_split_nl(raw)
    var i: I32 = 0
    while i + 1 < names.len {
        var j: I32 = 0
        while j + 1 < names.len - i {
            if c_cmp(names[j], names[j + 1]) > 0 {
                var t = names[j]
                names[j] = names[j + 1]
                names[j + 1] = t
            }
            j += 1
        }
        i += 1
    }
    i = 0
    while i < names.len {
        var n = c_trim(names[i])
        if n.len >= 5 && c_at(n, n.len - 5, ".ctcl") {
            var txt = ""
            match read_file(root + "/" + n) {
                Some(x) => {
                    txt = x
                }
                None => {}
            }
            print("== " + n + "\n")
            var ds = validate_text(txt)
            var k: I32 = 0
            while k < ds.len {
                print(ds[k] + "\n")
                k += 1
            }
        }
        i += 1
    }
    return 0
}
