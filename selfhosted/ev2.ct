// C7a 原型:Ctron 结构化 AST(数据树)+ 树打印 → C-AST v1 逐字节(v0:fn/let/return/二元/数值)
// 节点 = List[Str]:child[0]=tag,其后按模式放标量 Str 或子节点(List)。打印按 tag 模式走树。
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }
fn or3(a: Bool, b: Bool, c: Bool) -> Bool { return or2(or2(a, b), c) }
fn is_digit(b: I32) -> Bool { return b >= 48 && b <= 57 }
fn is_alpha(b: I32) -> Bool { return or2(b >= 65 && b <= 90, b >= 97 && b <= 122) }
fn is_al(b: I32) -> Bool { return or2(is_alpha(b), b == 95) }
fn is_ac(b: I32) -> Bool { return or2(is_al(b), is_digit(b)) }

fn is_hex(b: I32) -> Bool { return or2(b >= 48 && b <= 57, or2(b >= 65 && b <= 70, b >= 97 && b <= 102)) }
fn is_oct(b: I32) -> Bool { return b >= 48 && b <= 55 }
fn is_bin(b: I32) -> Bool { return b >= 48 && b <= 49 }

fn suffix_len(src: Str, n: I32, i: I32) -> I32 {
    if i + 2 <= n {
        var a = byte_at(src, i)
        var b = byte_at(src, i + 1)
        var len: I32 = 0
        if a == 105 && b == 56 { len = 2 }
        if a == 105 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 { len = 3 }
        if a == 105 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 105 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if a == 105 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 { len = 5 }
        if a == 117 && b == 56 { len = 2 }
        if a == 117 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 { len = 3 }
        if a == 117 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 117 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if a == 117 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 { len = 5 }
        if a == 102 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 102 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if len > 0 {
            if i + len < n && is_ac(byte_at(src, i + len)) { return 0 }
            return len
        }
    }
    return 0
}

// 词法:空白/换行(NL)/注释丢弃;数值=text~sfx;标点原始串;哨兵 #EOF
// ---------------- C9i①:换行过滤(镜像 C lexer filter_newlines,规范 §1.6 行延续规则) ----------------
// 行尾延续集 → 其后换行抑制;下一行首在延续集 → 换行抑制;连续换行折叠为一个。
fn nl_set_line_end(t: Str) -> Bool {
    var ops = List[Str]()
    ops.push(",")
    ops.push("=")
    ops.push("->")
    ops.push("=>")
    ops.push("&&")
    ops.push("||")
    ops.push("..")
    ops.push("..=")
    ops.push("+")
    ops.push("-")
    ops.push("*")
    ops.push("/")
    ops.push("%")
    ops.push("+%")
    ops.push("-%")
    ops.push("==")
    ops.push("!=")
    ops.push("<")
    ops.push(">")
    ops.push("<=")
    ops.push(">=")
    ops.push("(")
    ops.push("[")
    ops.push("|")
    var i: I32 = 0
    while i < ops.len {
        if ops[i] == t { return true }
        i += 1
    }
    return false
}
fn nl_set_next(t: Str) -> Bool {
    var ops = List[Str]()
    ops.push(".")
    ops.push("+")
    ops.push("-")
    ops.push("*")
    ops.push("/")
    ops.push("%")
    ops.push("+%")
    ops.push("-%")
    ops.push("==")
    ops.push("!=")
    ops.push("<")
    ops.push(">")
    ops.push("<=")
    ops.push(">=")
    ops.push("&&")
    ops.push("||")
    ops.push("..")
    ops.push("..=")
    var i: I32 = 0
    while i < ops.len {
        if ops[i] == t { return true }
        i += 1
    }
    return false
}
fn filter_nl(raw: List[Str], toks: List[Str]) {
    var i: I32 = 0
    while i < raw.len && raw[i] == "NL" {
        i += 1
    }
    while i < raw.len {
        if raw[i] != "NL" {
            toks.push(raw[i])
            i += 1
        } else {
            var run = i
            while run < raw.len && raw[run] == "NL" {
                run += 1
            }
            var nxt = "#EOF"
            if run < raw.len {
                nxt = raw[run]
            }
            var suppressed = false
            if toks.len > 0 && nl_set_line_end(toks[toks.len - 1]) {
                suppressed = true
            }
            if nl_set_next(nxt) {
                suppressed = true
            }
            if !suppressed {
                toks.push("NL")
            }
            i = run
        }
    }
}
fn scan(src: Str, toks: List[Str]) {
    var raw = List[Str]()
    var n = src.len
    var i: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        if b == 10 {
            raw.push("NL")
            i += 1
        } else if or2(b == 32, or2(b == 9, b == 13)) {
            i += 1
        } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            while i < n && byte_at(src, i) != 10 { i += 1 }
        } else if b == 34 {
            var q0 = i
            i += 1
            var done = false
            while i < n && !done {
                var c = byte_at(src, i)
                if c == 34 {
                    i += 1
                    done = true
                } else if c == 92 {
                    i += 2
                } else if c == 10 {
                    done = true
                } else {
                    i += 1
                }
            }
            raw.push(byte_slice(src, q0, i))
        } else if is_al(b) {
            var start = i
            while i < n && is_ac(byte_at(src, i)) { i += 1 }
            raw.push(byte_slice(src, start, i))
        } else if is_digit(b) {
            var tstart = i
            var radix: I32 = 0
            if b == 48 && i + 1 < n {
                var p2 = byte_at(src, i + 1)
                if p2 == 120 { radix = 16 }
                if p2 == 111 { radix = 8 }
                if p2 == 98 { radix = 2 }
            }
            var fnum = false
            if radix > 0 {
                i += 2
                if radix == 16 {
                    while i < n && or2(is_hex(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
                if radix == 8 {
                    while i < n && or2(is_oct(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
                if radix == 2 {
                    while i < n && or2(is_bin(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
            } else {
                while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                if i + 1 < n && byte_at(src, i) == 46 && is_digit(byte_at(src, i + 1)) {
                    fnum = true
                    i += 1
                    while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
                if i < n && or2(byte_at(src, i) == 101, byte_at(src, i) == 69) {
                    var esign = false
                    if i + 1 < n && or2(byte_at(src, i + 1) == 43, byte_at(src, i + 1) == 45) { esign = true }
                    var eok = false
                    if esign && i + 2 < n && is_digit(byte_at(src, i + 2)) { eok = true }
                    if !esign && i + 1 < n && is_digit(byte_at(src, i + 1)) { eok = true }
                    if eok {
                        fnum = true
                        i += 1
                        if esign { i += 1 }
                        while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                    }
                }
            }
            var tend = i
            var tk = byte_slice(src, tstart, tend) + "~"
            var sl = suffix_len(src, n, i)
            if sl > 0 { tk = tk + byte_slice(src, i, i + sl) }
            i += sl
            raw.push(tk)
        } else {
            if b == 46 && i + 2 < n && byte_at(src, i + 1) == 46 && byte_at(src, i + 2) == 61 {
                raw.push("..=")
                i += 3
            } else if b == 46 && i + 1 < n && byte_at(src, i + 1) == 46 {
                raw.push("..")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 62 {
                raw.push("->")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 62 {
                raw.push("=>")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("==")
                i += 2
            } else if b == 33 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("!=")
                i += 2
            } else if b == 60 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("<=")
                i += 2
            } else if b == 62 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push(">=")
                i += 2
            } else if b == 38 && i + 1 < n && byte_at(src, i + 1) == 38 {
                raw.push("&&")
                i += 2
            } else if b == 43 && i + 1 < n && byte_at(src, i + 1) == 37 {
                raw.push("+%")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 37 {
                raw.push("-%")
                i += 2
            } else if b == 43 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("+=")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("-=")
                i += 2
            } else if b == 42 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("*=")
                i += 2
            } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("/=")
                i += 2
            } else if b == 37 && i + 1 < n && byte_at(src, i + 1) == 61 {
                raw.push("%=")
                i += 2
            } else {
                raw.push(byte_slice(src, i, i + 1))
                i += 1
            }
        }
    }
    filter_nl(raw, toks)
    toks.push("#EOF")
}

fn tok(toks: List[Str], cur: Atomic[I32]) -> Str {
    var i = cur.load()
    if i < toks.len { return toks[i] }
    return "#EOF"
}
fn adv(cur: Atomic[I32]) {
    cur.store(cur.load() + 1)
}

fn num_text(t: Str) -> Str {
    var k: I32 = 0
    while k < t.len && byte_at(t, k) != 126 { k += 1 }
    return byte_slice(t, 0, k)
}
fn num_sfx(t: Str) -> Str {
    var k: I32 = 0
    while k < t.len && byte_at(t, k) != 126 { k += 1 }
    return byte_slice(t, k + 1, t.len)
}

// ---------------- 树节点 ----------------
fn mk(t: Str) -> List[Str] {
    var n = List[Str]()
    n.push(t)
    return n
}

// ---------------- 解析(建树) ----------------
fn qtext(raw: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = raw.len
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 117 {
            var hx = ""
            var pp = j + 2
            var mapped = false
            if pp < n && byte_at(raw, pp) == 123 {
                pp += 1
                while pp < n && byte_at(raw, pp) != 125 {
                    hx = hx + byte_slice(raw, pp, pp + 1)
                    pp += 1
                }
                if hx == "4E2D" {
                    out = out + "中"
                    mapped = true
                }
            }
            if mapped {
                j = pp + 1
            } else {
                out = out + byte_slice(raw, j, j + 2)
                j += 2
            }
        } else if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 123 {
            out = out + "\{"
            j += 2
        } else {
            out = out + byte_slice(raw, j, j + 1)
            j += 1
        }
    }
    return out
}

fn parts_of(raw: Str) -> List[Str] {
    var np = mk("Parts")
    var k: I32 = 0
    var n = raw.len
    var j: I32 = 0
    var ts: I32 = 0
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 2 <= n {
            if j + 3 < n && byte_at(raw, j + 1) == 117 && byte_at(raw, j + 2) == 123 {
                var q = j + 3
                while q < n && byte_at(raw, q) != 125 { q += 1 }
                if q < n { j = q + 1 } else { j += 2 }
            } else {
                j += 2
            }
        } else if c == 123 {
            if j > ts {
                var tx = mk("Text")
                tx.push(qtext(byte_slice(raw, ts, j)))
                np.push(tx)
                k += 1
            }
            var d: I32 = 1
            var p = j + 1
            while d > 0 && p < n {
                var cp = byte_at(raw, p)
                if cp == 123 { d += 1 }
                if cp == 125 { d -= 1 }
                p += 1
            }
            var ix = mk("Interp")
            ix.push(qtext(byte_slice(raw, j + 1, p - 1)))
            np.push(ix)
            k += 1
            j = p
            ts = p
        } else {
            j += 1
        }
    }
    if n > ts {
        var ty = mk("Text")
        ty.push(qtext(byte_slice(raw, ts, n)))
        np.push(ty)
        k += 1
    }
    return np
}

fn p_and(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var l = p_cmp(toks, cur, al)
    var go = true
    while go {
        if tok(toks, cur) == "&&" {
            adv(cur)
            var r = p_cmp(toks, cur, al)
            var nb = mk("Binary")
            nb.push("AndAnd")
            nb.push(l)
            nb.push(r)
            l = nb
        } else { go = false }
    }
    return l
}

fn p_cmp(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var l = p_rng(toks, cur, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "==" { op = "Eq" }
        if t == "!=" { op = "Ne" }
        if t == "<" { op = "Lt" }
        if t == ">" { op = "Gt" }
        if t == "<=" { op = "Le" }
        if t == ">=" { op = "Ge" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_rng(toks, cur, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_rng(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var f = p_add(toks, cur, al)
    var t = tok(toks, cur)
    if or2(t == "..", t == "..=") {
        adv(cur)
        var to = p_add(toks, cur, al)
        var nb = mk("Range")
        if t == "..=" {
            nb.push("true")
        } else {
            nb.push("false")
        }
        nb.push(f)
        nb.push(to)
        return nb
    }
    return f
}

fn p_add(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var l = p_mul(toks, cur, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "+" { op = "Add" }
        if t == "-" { op = "Sub" }
        if t == "+%" { op = "WrapAdd" }
        if t == "-%" { op = "WrapSub" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_mul(toks, cur, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_mul(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var l = p_una(toks, cur, al)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "*" { op = "Mul" }
        if t == "/" { op = "Div" }
        if t == "%" { op = "Mod" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_una(toks, cur, al)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_una(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var t = tok(toks, cur)
    if t == "-" {
        adv(cur)
        var e = p_una(toks, cur, al)
        var nu = mk("Unary")
        nu.push("Neg")
        nu.push(e)
        return nu
    }
    if t == "!" {
        adv(cur)
        var e = p_una(toks, cur, al)
        var nu = mk("Unary")
        nu.push("Not")
        nu.push(e)
        return nu
    }
    return p_post(toks, cur, al)
}

fn p_post(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var e = p_pri(toks, cur, al)
    var go = true
    while go {
        while tok(toks, cur) == "NL" && toks[cur.load() + 1] == "." {
            adv(cur)
        }
        var t = tok(toks, cur)
        if t == "(" {
            adv(cur)
            var ag = mk("Args")
            var more = true
            while more {
                if tok(toks, cur) == ")" {
                    more = false
                } else {
                    ag.push(p_stmt_expr(toks, cur, "1"))
                    if tok(toks, cur) == "," {
                        adv(cur)
                    } else {
                        more = false
                    }
                }
            }
            adv(cur)
            var cl = mk("Call")
            cl.push(e)
            cl.push(ag)
            e = cl
        } else if t == "." {
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            var mb = mk("Member")
            mb.push(e)
            if is_digit(byte_at(nm, 0)) {
                mb.push("TIdx")
                mb.push(num_text(nm))
            } else {
                mb.push("Nm")
                mb.push(nm)
            }
            e = mb
        } else if t == "[" {
            var d: I32 = 1
            var q = cur.load() + 1
            var hascom = false
            while d > 0 {
                var tk2 = toks[q]
                if tk2 == "[" { d += 1 }
                if tk2 == "]" { d -= 1 }
                if tk2 == "," && d == 1 { hascom = true }
                q += 1
            }
            var nx = toks[q]
            var ta = false
            if or2(nx == "(", nx == "\{") { ta = true }
            if nx == "." && hascom { ta = true }
            if ta {
                adv(cur)
                var ag = mk("TArgs2")
                var more = true
                while more {
                    if tok(toks, cur) == "]" { more = false } else {
                        var at = tok(toks, cur)
                        if is_digit(byte_at(at, 0)) {
                            var cv = mk("ComptimeVal")
                            cv.push(num_text(at))
                            ag.push(cv)
                            adv(cur)
                        } else {
                            ag.push(p_typ(toks, cur))
                        }
                        if tok(toks, cur) == "," { adv(cur) } else { more = false }
                    }
                }
                adv(cur)
                var tg = mk("TypeArgs")
                tg.push(e)
                tg.push(ag)
                e = tg
            } else {
                adv(cur)
                var ix = p_stmt_expr(toks, cur, "1")
                adv(cur)
                var inode = mk("Index")
                inode.push(e)
                inode.push(ix)
                e = inode
            }
        } else if t == "?" {
            adv(cur)
            var tr = mk("Try")
            tr.push(e)
            e = tr
        } else {
            go = false
        }
    }
    return e
}

fn p_pri(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    var t = tok(toks, cur)
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        var nb = mk("Int")
        var isf = false
        var tx = num_text(t)
        var jj: I32 = 0
        while jj < tx.len {
            var cc = byte_at(tx, jj)
            if or2(cc == 46, or2(cc == 101, cc == 69)) { isf = true }
            jj += 1
        }
        if isf { nb = mk("Float") }
        nb.push(num_text(t))
        nb.push(num_sfx(t))
        return nb
    }
    if t == "if" {
        return p_if(toks, cur)
    }
    if t == "match" {
        return p_match(toks, cur)
    }
    if t == "void" {
        adv(cur)
        return mk("Void")
    }
    if t == "true" {
        adv(cur)
        var bt = mk("Bool")
        bt.push("true")
        return bt
    }
    if t == "false" {
        adv(cur)
        var bf = mk("Bool")
        bf.push("false")
        return bf
    }
    if t == "own" {
        adv(cur)
        adv(cur)
        var an = tok(toks, cur)
        adv(cur)
        adv(cur)
        adv(cur)
        var ow = mk("Own")
        ow.push(an)
        ow.push(p_block(toks, cur))
        return ow
    }
    if t == "|" {
        adv(cur)
        var cl = mk("Closure")
        var cp = mk("CPs")
        var more = true
        while more {
            if tok(toks, cur) == "|" { more = false } else {
                var isv = "false"
                var t0 = tok(toks, cur)
                if t0 == "var" { isv = "true" }
                if or2(t0 == "var", t0 == "let") { adv(cur) }
                var cn = tok(toks, cur)
                adv(cur)
                var cpar = mk("ClosureParam")
                cpar.push(isv)
                cpar.push(cn)
                var ty = mk("None")
                if tok(toks, cur) == ":" {
                    adv(cur)
                    ty = p_typ(toks, cur)
                }
                cpar.push(ty)
                cp.push(cpar)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        var ret = mk("None")
        if tok(toks, cur) == "->" {
            adv(cur)
            ret = p_typ(toks, cur)
        }
        cl.push(cp)
        cl.push(ret)
        cl.push(p_stmt_expr(toks, cur, "1"))
        return cl
    }
    if t == "scope" {
        adv(cur)
        adv(cur)
        adv(cur)
        var pn = tok(toks, cur)
        adv(cur)
        adv(cur)
        var sc = mk("Scope")
        sc.push(pn)
        sc.push(p_block(toks, cur))
        return sc
    }
    if b0 == 34 {
        adv(cur)
        var ns = mk("Str")
        ns.push(parts_of(byte_slice(t, 1, t.len - 1)))
        return ns
    }
    if t == "\{" {
        adv(cur)
        var be = mk("BlockExpr")
        be.push(p_block(toks, cur))
        return be
    }
    if t == "[" {
        adv(cur)
        var al = mk("ArrLit")
        var more = true
        while more {
            if tok(toks, cur) == "]" { more = false } else {
                al.push(p_stmt_expr(toks, cur, "1"))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return al
    }
    if t == "(" {
        adv(cur)
        var e0 = p_and(toks, cur, "1")
        if tok(toks, cur) == "," {
            var tn = mk("TupleE")
            tn.push(e0)
            var more = true
            while more {
                if tok(toks, cur) == "," {
                    adv(cur)
                    tn.push(p_and(toks, cur, "1"))
                } else {
                    more = false
                }
            }
            adv(cur)
            return tn
        }
        adv(cur)
        return e0
    }
    if al == "1" && b0 >= 65 && b0 <= 90 && toks[cur.load() + 1] == "\{" {
        var nm = t
        adv(cur)
        adv(cur)
        var sl = mk("StructLit")
        sl.push(nm)
        var lf = mk("LitFs")
        var more = true
        while more {
            if or2(tok(toks, cur) == "}", tok(toks, cur) == "#EOF") {
                more = false
            } else if tok(toks, cur) == "NL" {
                adv(cur)
            } else {
                var fnm = tok(toks, cur)
                adv(cur)
                adv(cur)
                var fv = mk("LField")
                fv.push(fnm)
                fv.push(p_stmt_expr(toks, cur, "1"))
                lf.push(fv)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        sl.push(lf)
        return sl
    }
    adv(cur)
    var ni = mk("Ident")
    ni.push(t)
    return ni
}

fn p_tpars(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var tp = mk("TPs")
    var more = true
    while more {
        if tok(toks, cur) == "]" { more = false } else {
            var isc = "false"
            if tok(toks, cur) == "comptime" {
                isc = "true"
                adv(cur)
            }
            var nm = tok(toks, cur)
            adv(cur)
            var tp1 = mk("TPar")
            tp1.push(nm)
            tp1.push(isc)
            var bd = mk("Bounds")
            if tok(toks, cur) == ":" {
                adv(cur)
                var more2 = true
                while more2 {
                    bd.push(tok(toks, cur))
                    adv(cur)
                    if tok(toks, cur) == "+" { adv(cur) } else { more2 = false }
                }
            }
            tp1.push(bd)
            tp.push(tp1)
            if tok(toks, cur) == "," { adv(cur) } else { more = false }
        }
    }
    adv(cur)
    return tp
}

fn p_typ(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var t = tok(toks, cur)
    if t == "(" {
        adv(cur)
        var tt = mk("TupleT")
        var more = true
        while more {
            if tok(toks, cur) == ")" { more = false } else {
                tt.push(p_typ(toks, cur))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return tt
    }
    if t == "&" {
        adv(cur)
        var rf = mk("Ref")
        rf.push(p_typ(toks, cur))
        if tok(toks, cur) == "?" {
            adv(cur)
            var op = mk("Optional")
            op.push(rf)
            return op
        }
        return rf
    }
    if t == "fn" {
        adv(cur)
        var ft = mk("FnT")
        adv(cur)
        var more2 = true
        while more2 {
            if tok(toks, cur) == ")" { more2 = false } else {
                ft.push(p_typ(toks, cur))
                if tok(toks, cur) == "," { adv(cur) } else { more2 = false }
            }
        }
        adv(cur)
        var fret = mk("None")
        if tok(toks, cur) == "->" {
            adv(cur)
            fret = p_typ(toks, cur)
        }
        var ftn = mk("FnType")
        ftn.push(ft)
        ftn.push(fret)
        if tok(toks, cur) == "?" {
            adv(cur)
            var op2 = mk("Optional")
            op2.push(ftn)
            return op2
        }
        return ftn
    }
    var nm = tok(toks, cur)
    adv(cur)
    var nt = mk("Named")
    nt.push(nm)
    var ta = mk("TArgs")
    if tok(toks, cur) == "[" {
        var nx1 = toks[cur.load() + 1]
        var isempty = false
        var single = false
        if nx1 == "]" { isempty = true }
        if !isempty && nx1 != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx1, 0)) { single = true }
        if !isempty && !single {
            adv(cur)
            var more = true
            while more {
                if tok(toks, cur) == "]" { more = false } else {
                    ta.push(p_typ(toks, cur))
                    if tok(toks, cur) == "," { adv(cur) } else { more = false }
                }
            }
            adv(cur)
        }
    }
    nt.push(ta)
    var base = nt
    if tok(toks, cur) == "[" {
        var nx2 = toks[cur.load() + 1]
        var isarr = false
        if nx2 == "]" { isarr = true }
        if nx2 != "#EOF" && toks[cur.load() + 2] == "]" && is_digit(byte_at(nx2, 0)) { isarr = true }
        if isarr {
            adv(cur)
            if tok(toks, cur) == "]" {
                adv(cur)
                var sl = mk("Slice")
                sl.push(base)
                base = sl
            } else {
                var sz = p_stmt_expr(toks, cur, "1")
                adv(cur)
                var ar = mk("ArrayT")
                ar.push(base)
                ar.push(sz)
                base = ar
            }
        }
    }
    if tok(toks, cur) == "?" {
        adv(cur)
        var op3 = mk("Optional")
        op3.push(base)
        base = op3
    }
    return base
}

fn p_stmt_expr(toks: List[Str], cur: Atomic[I32], al: Str) -> List[Str] {
    return p_and(toks, cur, al)
}

fn p_pattern(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var t = tok(toks, cur)
    if t == "_" {
        adv(cur)
        return mk("PatWild")
    }
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        var isf = false
        var tx = num_text(t)
        var jj: I32 = 0
        while jj < tx.len {
            var cc = byte_at(tx, jj)
            if or2(cc == 46, or2(cc == 101, cc == 69)) { isf = true }
            jj += 1
        }
        var np = mk("PatLitI")
        if isf { np = mk("PatLitF") }
        np.push(num_text(t))
        return np
    }
    if b0 == 34 {
        adv(cur)
        var np = mk("PatLitS")
        np.push(qtext(byte_slice(t, 1, t.len - 1)))
        return np
    }
    if t == "true" {
        adv(cur)
        var np = mk("PatLitB")
        np.push("true")
        return np
    }
    if t == "false" {
        adv(cur)
        var np = mk("PatLitB")
        np.push("false")
        return np
    }
    if t == "(" {
        adv(cur)
        var np = mk("PatTup")
        var more = true
        while more {
            if tok(toks, cur) == ")" { more = false } else {
                np.push(p_pattern(toks, cur))
                if tok(toks, cur) == "," { adv(cur) } else { more = false }
            }
        }
        adv(cur)
        return np
    }
    var nm = t
    adv(cur)
    if tok(toks, cur) == "(" {
        adv(cur)
        var agg = mk("PatAgg")
        agg.push(nm)
        var sub = mk("SubTup")
        var more2 = true
        while more2 {
            if tok(toks, cur) == ")" { more2 = false } else {
                sub.push(p_pattern(toks, cur))
                if tok(toks, cur) == "," { adv(cur) } else { more2 = false }
            }
        }
        adv(cur)
        agg.push(sub)
        return agg
    }
    if tok(toks, cur) == "\{" {
        adv(cur)
        var agg = mk("PatAgg")
        agg.push(nm)
        var sub = mk("SubSt")
        var more3 = true
        while more3 {
            if tok(toks, cur) == "}" { more3 = false } else {
                var fnm = tok(toks, cur)
                adv(cur)
                var pp = mk("None")
                if tok(toks, cur) == ":" {
                    adv(cur)
                    pp = p_pattern(toks, cur)
                }
                var fld = mk("PatFld")
                fld.push(fnm)
                fld.push(pp)
                sub.push(fld)
                if tok(toks, cur) == "," { adv(cur) }
            }
        }
        adv(cur)
        agg.push(sub)
        return agg
    }
    if or2(b0 >= 65, false) && b0 <= 90 {
        var agg = mk("PatAgg")
        agg.push(nm)
        agg.push(mk("SubUnit"))
        return agg
    }
    var pi = mk("PatId")
    pi.push(nm)
    return pi
}

fn p_match(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nm = mk("Match")
    nm.push(p_stmt_expr(toks, cur, "0"))
    adv(cur)
    var arms = mk("Arms")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" { go = false } else if tok(toks, cur) == "#EOF" { go = false } else {
            var ma = mk("Arm")
            ma.push(p_pattern(toks, cur))
            adv(cur)
            ma.push(p_stmt_expr(toks, cur, "1"))
            arms.push(ma)
        }
    }
    adv(cur)
    nm.push(arms)
    return nm
}


fn p_if(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var ni = mk("If")
    ni.push(p_and(toks, cur, "0"))
    adv(cur)
    ni.push(p_block(toks, cur))
    var els = mk("None")
    if tok(toks, cur) == "else" {
        adv(cur)
        if tok(toks, cur) == "if" {
            els = p_if(toks, cur)
        } else {
            adv(cur)
            var be = mk("BlockExpr")
            be.push(p_block(toks, cur))
            els = be
        }
    }
    ni.push(els)
    return ni
}


fn p_block(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var nb = mk("Block")
    var tailSet = false
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var p0 = cur.load()
        var t = tok(toks, cur)
        if t == "}" {
            adv(cur)
            go = false
        } else if t == "#EOF" {
            go = false
        } else if t == "return" {
            adv(cur)
            var re = mk("Return")
            var rt = tok(toks, cur)
            if or3(rt == "}", rt == "#EOF", rt == "NL") {
                var rn = mk("None")
                re.push(rn)
            } else {
                re.push(p_stmt_expr(toks, cur, "1"))
            }
            nb.push(re)
        } else if or2(t == "let", t == "var") {
            var isv = "false"
            if t == "var" { isv = "true" }
            adv(cur)
            var pp = p_pattern(toks, cur)
            var ty = mk("None")
            if tok(toks, cur) == ":" {
                adv(cur)
                ty = p_typ(toks, cur)
            }
            adv(cur)
            var lv = mk("Let")
            lv.push(isv)
            lv.push(pp)
            lv.push(ty)
            lv.push(p_stmt_expr(toks, cur, "1"))
            nb.push(lv)
        } else if t == "while" {
            adv(cur)
            var wc = p_stmt_expr(toks, cur, "0")
            adv(cur)
            var wb = p_block(toks, cur)
            var wh = mk("While")
            wh.push(wc)
            wh.push(wb)
            nb.push(wh)
        } else if t == "for" {
            adv(cur)
            var fp = p_pattern(toks, cur)
            adv(cur)
            var it = p_stmt_expr(toks, cur, "0")
            adv(cur)
            var fb = p_block(toks, cur)
            var fo = mk("For")
            fo.push(fp)
            fo.push(it)
            fo.push(fb)
            nb.push(fo)
        } else {
            var e = p_stmt_expr(toks, cur, "1")
            var t2 = tok(toks, cur)
            var op = ""
            if t2 == "=" { op = "Eq" }
            if t2 == "+=" { op = "AddEq" }
            if t2 == "-=" { op = "SubEq" }
            if t2 == "*=" { op = "MulEq" }
            if t2 == "/=" { op = "DivEq" }
            if t2 == "%=" { op = "ModEq" }
            if op != "" {
                adv(cur)
                var asn = mk("Assign")
                asn.push(e)
                asn.push(op)
                asn.push(p_stmt_expr(toks, cur, "1"))
                nb.push(asn)
            } else {
                var nx = t2
                if nx == "NL" {
                    while tok(toks, cur) == "NL" {
                        adv(cur)
                    }
                    nx = tok(toks, cur)
                }
                if nx == "}" {
                    adv(cur)
                    nb.push(e)
                    tailSet = true
                    go = false
                } else {
                    var es = mk("Expr")
                    es.push(e)
                    nb.push(es)
                }
            }
        }
        if cur.load() == p0 {
            adv(cur)
        }
    }
    if !tailSet {
        var nn = mk("None")
        nb.push(nn)
    }
    return nb
}

fn p_fn2(toks: List[Str], cur: Atomic[I32], tag: Str) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var nf = mk(tag)
    nf.push(nm)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    adv(cur)
    var ps = mk("Ps")
    var more = true
    while more {
        if tok(toks, cur) == ")" { more = false } else {
            var isv = "false"
            var t0 = tok(toks, cur)
            if t0 == "var" { isv = "true" }
            if or2(t0 == "var", t0 == "let") { adv(cur) }
            if tok(toks, cur) == "&" {
                adv(cur)
            }
            var pn = tok(toks, cur)
            adv(cur)
            if pn == "self" {
                var rc = mk("Receiver")
                rc.push(isv)
                ps.push(rc)
            } else {
                adv(cur)
                var pty = p_typ(toks, cur)
                var par = mk("Param")
                par.push(isv)
                par.push(pn)
                par.push(pty)
                ps.push(par)
            }
            if tok(toks, cur) == "," { adv(cur) } else { more = false }
        }
    }
    adv(cur)
    var ret = mk("None")
    if tok(toks, cur) == "->" {
        adv(cur)
        ret = p_typ(toks, cur)
    }
    var body = mk("None")
    if tok(toks, cur) == "\{" {
        adv(cur)
        body = p_block(toks, cur)
    }
    nf.push(tp)
    nf.push(ps)
    nf.push(ret)
    nf.push(body)
    return nf
}

fn p_fn(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    return p_fn2(toks, cur, "Fn")
}


fn p_test(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var t = tok(toks, cur)
    adv(cur)
    var nt = mk("Test")
    nt.push(qtext(byte_slice(t, 1, t.len - 1)))
    adv(cur)
    nt.push(p_block(toks, cur))
    return nt
}

fn p_field(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var isv = "false"
    var t = tok(toks, cur)
    if t == "var" { isv = "true" }
    if or2(t == "let", t == "var") { adv(cur) }
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var f = mk("Field")
    f.push(isv)
    f.push(nm)
    f.push(p_typ(toks, cur))
    return f
}

fn p_struct2(toks: List[Str], cur: Atomic[I32], dr: List[Str]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    adv(cur)
    var ns = mk("Struct")
    ns.push(nm)
    ns.push(dr)
    ns.push(tp)
    var fs = mk("Fields")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" { go = false } else if tok(toks, cur) == "#EOF" { go = false } else {
            fs.push(p_field(toks, cur))
        }
    }
    adv(cur)
    ns.push(fs)
    return ns
}

fn p_struct(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var dr0 = mk("Drvs")
    return p_struct2(toks, cur, dr0)
}

fn p_enum2(toks: List[Str], cur: Atomic[I32], dr: List[Str]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ne = mk("Enum")
    ne.push(nm)
    ne.push(dr)
    var vs = mk("Vars")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        if tok(toks, cur) == "}" { go = false } else if tok(toks, cur) == "#EOF" { go = false } else {
            var vn = tok(toks, cur)
            adv(cur)
            var v = mk("Variant")
            v.push(vn)
            var kind = mk("KUnit")
            if tok(toks, cur) == "(" {
                adv(cur)
                kind = mk("KTuple")
                var more = true
                while more {
                    if tok(toks, cur) == ")" { more = false } else {
                        kind.push(p_typ(toks, cur))
                        if tok(toks, cur) == "," { adv(cur) } else { more = false }
                    }
                }
                adv(cur)
            } else if tok(toks, cur) == "\{" {
                adv(cur)
                kind = mk("KStruct")
                var more2 = true
                while more2 {
                    while tok(toks, cur) == "NL" {
                        adv(cur)
                    }
                    if tok(toks, cur) == "}" { more2 = false } else if tok(toks, cur) == "#EOF" { more2 = false } else {
                        kind.push(p_field(toks, cur))
                        while tok(toks, cur) == "NL" {
                            adv(cur)
                        }
                        if tok(toks, cur) == "," {
                            adv(cur)
                        }
                    }
                }
                adv(cur)
            }
            v.push(kind)
            vs.push(v)
        }
    }
    adv(cur)
    ne.push(vs)
    return ne
}

fn p_prop_item(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    return p_prop_item2(toks, cur, "sig")
}

fn p_prop_item2(toks: List[Str], cur: Atomic[I32], kind: Str) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur)
    var body = mk("None")
    var tag = "PropSig"
    if tok(toks, cur) == "\{" {
        adv(cur)
        body = p_block(toks, cur)
        tag = "PropImpl"
    }
    if kind == "imp" {
        tag = "Prop"
    }
    var pn = mk(tag)
    pn.push(nm)
    pn.push(ty)
    pn.push(body)
    return pn
}

fn p_items(toks: List[Str], cur: Atomic[I32], kind: Str) -> List[Str] {
    var it = mk("Items")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var t = tok(toks, cur)
        if or2(t == "}", t == "#EOF") {
            adv(cur)
            go = false
        } else if t == "#" {
            adv(cur)
            adv(cur)
            var anm = tok(toks, cur)
            adv(cur)
            while tok(toks, cur) != "]" && tok(toks, cur) != "#EOF" {
                adv(cur)
            }
            if tok(toks, cur) == "]" {
                adv(cur)
            }
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var md = p_fn2(toks, cur, "Method")
            md.push(anm)
            it.push(md)
        } else if t == "fn" {
            it.push(p_fn2(toks, cur, "Method"))
        } else if t == "prop" {
            var pk = "sig"
            if or2(kind == "impl", kind == "class") {
                pk = "imp"
            }
            it.push(p_prop_item2(toks, cur, pk))
        } else if kind == "trait" {
            go = false
        } else {
            it.push(p_field(toks, cur))
        }
    }
    adv(cur)
    return it
}

fn p_class(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var nc = mk("Class")
    nc.push(nm)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    adv(cur)
    nc.push(tp)
    nc.push(p_items(toks, cur, "class"))
    return nc
}

fn p_impl(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var ni = mk("Impl")
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    ni.push(tp)
    ni.push(p_typ(toks, cur))
    adv(cur)
    ni.push(p_typ(toks, cur))
    adv(cur)
    ni.push(p_items(toks, cur, "impl"))
    return ni
}

fn p_trait(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    var nt = mk("Trait")
    nt.push(nm)
    var tp = mk("TPs")
    if tok(toks, cur) == "[" {
        tp = p_tpars(toks, cur)
    }
    nt.push(tp)
    var sup = mk("Bounds")
    if tok(toks, cur) == ":" {
        adv(cur)
        var more = true
        while more {
            sup.push(tok(toks, cur))
            adv(cur)
            if tok(toks, cur) == "+" { adv(cur) } else { more = false }
        }
    }
    nt.push(sup)
    adv(cur)
    nt.push(p_items(toks, cur, "trait"))
    return nt
}

fn p_enum(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var dr0 = mk("Drvs")
    return p_enum2(toks, cur, dr0)
}

fn p_use(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nu = mk("Use")
    var more = true
    while more {
        var a = tok(toks, cur)
        if a == "." {
            adv(cur)
        } else if a == "\{" {
            adv(cur)
            var more2 = true
            while more2 {
                var b2 = tok(toks, cur)
                if or2(b2 == "}", b2 == "#EOF") {
                    more2 = false
                } else {
                    nu.push(b2)
                    adv(cur)
                    if tok(toks, cur) == "," {
                        adv(cur)
                    }
                }
            }
            if tok(toks, cur) == "}" {
                adv(cur)
            }
            more = false
        } else if a == "#EOF" {
            more = false
        } else {
            nu.push(a)
            adv(cur)
            var nx = tok(toks, cur)
            if nx != "." {
                more = false
            }
        }
    }
    return nu
}

fn p_const(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur)
    adv(cur)
    var nc = mk("Const")
    nc.push(nm)
    nc.push(ty)
    nc.push(p_stmt_expr(toks, cur, "1"))
    return nc
}

fn p_static(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var wv = "false"
    var t = tok(toks, cur)
    if t == "var" { wv = "true" }
    if or2(t == "var", t == "let") { adv(cur) }
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur)
    adv(cur)
    var ns = mk("Static")
    ns.push(nm)
    ns.push(wv)
    ns.push(ty)
    ns.push(p_stmt_expr(toks, cur, "1"))
    return ns
}

fn p_file(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var nf = mk("File")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var p0 = cur.load()
        var t = tok(toks, cur)
        if t == "#EOF" {
            go = false
        } else if t == "#" {
            adv(cur)
            adv(cur)
            var anm = tok(toks, cur)
            adv(cur)
            while tok(toks, cur) != "]" && tok(toks, cur) != "#EOF" {
                adv(cur)
            }
            if tok(toks, cur) == "]" {
                adv(cur)
            }
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var fd = p_fn2(toks, cur, "Fn")
            fd.push(anm)
            nf.push(fd)
        } else if t == "pub" {
            adv(cur)
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "fn" {
                nf.push(p_fn2(toks, cur, "FnPub"))
            } else {
                nf.push(p_fn(toks, cur))
            }
        } else if t == "comptime" {
            adv(cur)
            nf.push(p_fn2(toks, cur, "FnC"))
        } else if t == "@" {
            adv(cur)
            adv(cur)
            adv(cur)
            var dr2 = mk("Drvs")
            var more3 = true
            while more3 {
                if tok(toks, cur) == ")" {
                    more3 = false
                } else {
                    dr2.push(tok(toks, cur))
                    adv(cur)
                    if tok(toks, cur) == "," { adv(cur) }
                }
            }
            adv(cur)
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var t2 = tok(toks, cur)
            if t2 == "struct" {
                nf.push(p_struct2(toks, cur, dr2))
            } else if t2 == "enum" {
                nf.push(p_enum2(toks, cur, dr2))
            } else if t2 == "trait" {
                nf.push(p_trait(toks, cur))
            } else {
                nf.push(p_fn(toks, cur))
            }
        } else if t == "test" {
            nf.push(p_test(toks, cur))
        } else if t == "enum" {
            nf.push(p_enum(toks, cur))
        } else if t == "struct" {
            nf.push(p_struct(toks, cur))
        } else if t == "class" {
            nf.push(p_class(toks, cur))
        } else if t == "impl" {
            nf.push(p_impl(toks, cur))
        } else if t == "trait" {
            nf.push(p_trait(toks, cur))
        } else if t == "use" {
            nf.push(p_use(toks, cur))
        } else if t == "const" {
            nf.push(p_const(toks, cur))
        } else if t == "static" {
            nf.push(p_static(toks, cur))
        } else {
            nf.push(p_fn(toks, cur))
        }
        if cur.load() == p0 {
            adv(cur)
        }
    }
    return nf
}




// ---------------- 树打印 → C-AST v1 ----------------
fn pjoin(n: List[Str]) -> Str {
    var out = ""
    var i: I32 = 1
    while i < n.len {
        if i > 1 { out = out + ", " }
        out = out + pnode(n[i])
        i += 1
    }
    return out
}

fn pnode(n: List[Str]) -> Str {
    var t = n[0]
    var out = ""
    if t == "File" {
        out = out + "File \{ decls: ["
        var i: I32 = 1
        while i < n.len {
            if i > 1 {
                out = out + ",\n  "
            } else {
                out = out + "\n  "
            }
            out = out + pnode(n[i])
            i += 1
        }
        out = out + "\n] }\n"
        } else if t == "FnPub" {
        out = out + "Fn \{ attrs: [], vis: Pub, is_comptime: false, abi: None, name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], params: ["
        var ps = n[3]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[4]) + ", body: " + pnode(n[5]) + "}"
    } else if t == "FnC" {
        out = out + "Fn \{ attrs: [], vis: Private, is_comptime: true, abi: None, name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], params: ["
        var ps = n[3]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[4]) + ", body: " + pnode(n[5]) + "}"
    } else if or2(t == "Fn", t == "Method") {
        var atxt = "[]"
        if n.len >= 7 {
            atxt = "[Attribute \{ name: \"" + n[6] + "\", args: []}]"
        }
        out = out + t + " \{ attrs: " + atxt + ", vis: Private, is_comptime: false, abi: None, name: \""
        out = out + n[1] + "\", type_params: ["
        var tp = n[2]
        var tj: I32 = 1
        while tj < tp.len {
            if tj > 1 { out = out + ", " }
            out = out + pnode(tp[tj])
            tj += 1
        }
        out = out + "], params: ["
        var ps = n[3]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[4]) + ", body: " + pnode(n[5]) + "}"
    } else if t == "Ps" {
    } else if t == "Ps" {
        var j2: I32 = 1
        while j2 < n.len {
            if j2 > 1 { out = out + ", " }
            out = out + pnode(n[j2])
            j2 += 1
        }
        } else if t == "Param" {
        out = out + "Param \{ is_var: " + n[1] + ", name: \"" + n[2] + "\", ty: " + pnode(n[3]) + "}"
    } else if t == "Receiver" {
        out = out + "Receiver \{ is_var: " + n[1] + " }"
    } else if t == "TPs" {
        var tj2: I32 = 1
        while tj2 < n.len {
            if tj2 > 1 { out = out + ", " }
            out = out + pnode(n[tj2])
            tj2 += 1
        }
    } else if t == "TPar" {
        out = out + "TypeParam \{ name: \"" + n[1] + "\", bound: ["
        var bd = n[3]
        var bj: I32 = 1
        while bj < bd.len {
            if bj > 1 { out = out + ", " }
            out = out + "\"" + bd[bj] + "\""
            bj += 1
        }
        out = out + "], is_comptime: " + n[2] + " }"
    } else if t == "TupleT" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "Ref" {
        out = out + "Ref(" + pnode(n[1]) + ")"
    } else if t == "Optional" {
        out = out + "Optional(" + pnode(n[1]) + ")"
    } else if t == "FnType" {
        out = out + "Fn \{ params: [" + pjoin(n[1]) + "], ret: " + pnode(n[2]) + "}"
    } else if t == "Slice" {
        out = out + "Slice(" + pnode(n[1]) + ")"
    } else if t == "ArrayT" {
        out = out + "Array \{ elem: " + pnode(n[1]) + ", size: " + pnode(n[2]) + "}"
    } else if t == "Named" {
        out = out + "Named \{ path: [\"" + n[1] + "\"], args: ["
        var tt = n[2]
        var tk2: I32 = 1
        while tk2 < tt.len {
            if tk2 > 1 { out = out + ", " }
            out = out + pnode(tt[tk2])
            tk2 += 1
        }
        out = out + "]}"
    } else if t == "None" {
        out = out + "None"
    } else if t == "Block" {
        out = out + "Block \{ stmts: ["
        var k: I32 = 1
        while k < n.len - 1 {
            if k > 1 { out = out + ", " }
            out = out + pnode(n[k])
            k += 1
        }
        out = out + "], tail: " + pnode(n[n.len - 1]) + "}"
    } else if t == "Return" {
        out = out + "Return(" + pnode(n[1]) + ")"
    } else if t == "Let" {
        out = out + "Let \{ is_var: " + n[1] + ", pattern: " + pnode(n[2]) + ", ty: " + pnode(n[3]) + ", expr: " + pnode(n[4]) + "}"
    } else if t == "Expr" {
        out = out + "Expr(" + pnode(n[1]) + ")"
    } else if t == "Assign" {
        out = out + "Assign \{ target: " + pnode(n[1]) + ", op: " + n[2] + ", value: " + pnode(n[3]) + "}"
    } else if t == "Binary" {
        out = out + "Binary \{ op: " + n[1] + ", lhs: " + pnode(n[2]) + ", rhs: " + pnode(n[3]) + "}"
    } else if t == "Unary" {
        out = out + "Unary \{ op: " + n[1] + ", expr: " + pnode(n[2]) + "}"
    } else if t == "Range" {
        out = out + "Range \{ inclusive: " + n[1] + ", from: " + pnode(n[2]) + ", to: " + pnode(n[3]) + "}"
    } else if t == "If" {
        out = out + "If \{ cond: " + pnode(n[1]) + ", then: " + pnode(n[2]) + ", els: " + pnode(n[3]) + "}"
    } else if t == "BlockExpr" {
        out = out + "BlockExpr(" + pnode(n[1]) + ")"
    } else if t == "While" {
        out = out + "While \{ cond: " + pnode(n[1]) + ", body: " + pnode(n[2]) + "}"
    } else if t == "For" {
        out = out + "For \{ pattern: " + pnode(n[1]) + ", iter: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "Call" {
        out = out + "Call \{ callee: " + pnode(n[1]) + ", args: ["
        var al = n[2]
        var ak: I32 = 1
        while ak < al.len {
            if ak > 1 { out = out + ", " }
            out = out + pnode(al[ak])
            ak += 1
        }
        out = out + "] }"
    } else if t == "Member" {
        out = out + "Member \{ obj: " + pnode(n[1]) + ", target: "
        if n[2] == "TIdx" {
            out = out + "TupleIndex(" + n[3] + ")"
        } else {
            out = out + "Name(\"" + n[3] + "\")"
        }
        out = out + "}"
    } else if t == "Index" {
        out = out + "Index \{ obj: " + pnode(n[1]) + ", index: " + pnode(n[2]) + "}"
    } else if t == "TypeArgs" {
        out = out + "TypeArgs \{ expr: " + pnode(n[1]) + ", args: ["
        var tl = n[2]
        var tk: I32 = 1
        while tk < tl.len {
            if tk > 1 { out = out + ", " }
            out = out + pnode(tl[tk])
            tk += 1
        }
        out = out + "]}"
    } else if t == "Try" {
        out = out + "Try(" + pnode(n[1]) + ")"
    } else if t == "Own" {
        out = out + "Own \{ arena: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "Closure" {
        out = out + "Closure \{ params: ["
        var cp = n[1]
        var cj: I32 = 1
        while cj < cp.len {
            if cj > 1 { out = out + ", " }
            out = out + pnode(cp[cj])
            cj += 1
        }
        out = out + "], ret: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "ClosureParam" {
        out = out + "ClosureParam \{ is_var: " + n[1] + ", name: \"" + n[2] + "\", ty: " + pnode(n[3]) + "}"
    } else if t == "Scope" {
        out = out + "Scope \{ param: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "Match" {
        out = out + "Match \{ expr: " + pnode(n[1]) + ", arms: ["
        var ar = n[2]
        var ak: I32 = 1
        while ak < ar.len {
            if ak > 1 { out = out + ", " }
            out = out + pnode(ar[ak])
            ak += 1
        }
        out = out + "]}"
    } else if t == "Arm" {
        out = out + "MatchArm \{ pattern: " + pnode(n[1]) + ", expr: " + pnode(n[2]) + "}"
    } else if t == "PatWild" {
        out = out + "Wildcard"
    } else if t == "PatLitI" {
        out = out + "Lit(Int(\"" + n[1] + "\"))"
    } else if t == "PatLitF" {
        out = out + "Lit(Float(\"" + n[1] + "\"))"
    } else if t == "PatLitS" {
        out = out + "Lit(Str(\"" + n[1] + "\"))"
    } else if t == "PatLitB" {
        out = out + "Lit(Bool(" + n[1] + "))"
    } else if t == "PatId" {
        out = out + "Ident(\"" + n[1] + "\")"
    } else if t == "PatTup" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "PatAgg" {
        out = out + "Agg \{ path: [\"" + n[1] + "\"], sub: " + pnode(n[2]) + "}"
    } else if t == "SubUnit" {
        out = out + "Unit"
    } else if t == "SubTup" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "SubSt" {
        out = out + "Struct(["
        var j2: I32 = 1
        while j2 < n.len {
            if j2 > 1 { out = out + ", " }
            out = out + pnode(n[j2])
            j2 += 1
        }
        out = out + "])"
    } else if t == "PatFld" {
        out = out + "StructPatField \{ name: \"" + n[1] + "\", pattern: " + pnode(n[2]) + "}"
    } else if t == "StructLit" {
        out = out + "StructLit \{ path: [\"" + n[1] + "\"], fields: ["
        var ll = n[2]
        var lj: I32 = 1
        while lj < ll.len {
            if lj > 1 { out = out + ", " }
            out = out + pnode(ll[lj])
            lj += 1
        }
        out = out + "] }"
    } else if t == "LField" {
        out = out + "StructField \{ name: \"" + n[1] + "\", value: " + pnode(n[2]) + "}"
            } else if t == "Struct" {
        out = out + "Struct \{ attrs: [], derives: ["
        var dv = n[2]
        var dj: I32 = 1
        while dj < dv.len {
            if dj > 1 { out = out + ", " }
            out = out + "\"" + dv[dj] + "\""
            dj += 1
        }
        out = out + "], name: \"" + n[1] + "\", type_params: [" + pjoin(n[3]) + "], fields: [" + pjoin(n[4]) + "] }"
    } else if t == "Enum" {
        out = out + "Enum \{ attrs: [], derives: ["
        var dv2 = n[2]
        var dj2: I32 = 1
        while dj2 < dv2.len {
            if dj2 > 1 { out = out + ", " }
            out = out + "\"" + dv2[dj2] + "\""
            dj2 += 1
        }
        out = out + "], name: \"" + n[1] + "\", type_params: [], variants: [" + pjoin(n[3]) + "] }"
} else if t == "Field" {
        out = out + "Field \{ vis: Private, is_var: " + n[1] + ", name: \"" + n[2] + "\", ty: " + pnode(n[3]) + "}"
    } else if t == "Variant" {
        out = out + "Variant \{ name: \"" + n[1] + "\", kind: " + pnode(n[2]) + "}"
    } else if t == "KUnit" {
        out = out + "Unit"
    } else if t == "KTuple" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "KStruct" {
        out = out + "Struct([" + pjoin(n) + "])"
    } else if t == "Class" {
        out = out + "Class \{ attrs: [], name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], items: [" + pjoin(n[3]) + "] }"
    } else if t == "Impl" {
        out = out + "Impl \{ type_params: [" + pjoin(n[1]) + "], trait_ty: " + pnode(n[2]) + ", for_ty: " + pnode(n[3]) + ", items: [" + pjoin(n[4]) + "] }"
    } else if or3(t == "PropSig", t == "PropImpl", t == "Prop") {
        out = out + t + " \{ vis: Private, name: \"" + n[1] + "\", ty: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "Trait" {
        out = out + "Trait \{ attrs: [], name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], supers: ["
        var su = n[3]
        var sj: I32 = 1
        while sj < su.len {
            if sj > 1 { out = out + ", " }
            out = out + "\"" + su[sj] + "\""
            sj += 1
        }
        out = out + "], items: [" + pjoin(n[4]) + "] }"
    } else if t == "Items" {
        out = out + pjoin(n)
    } else if t == "Use" {
        out = out + "Use \{ imports: [["
        var uj: I32 = 1
        while uj < n.len {
            if uj > 1 { out = out + ", " }
            out = out + "\"" + n[uj] + "\""
            uj += 1
        }
        out = out + "]] }"
    } else if t == "Const" {
        out = out + "Const \{ name: \"" + n[1] + "\", ty: " + pnode(n[2]) + ", expr: " + pnode(n[3]) + "}"
    } else if t == "Static" {
        out = out + "Static \{ name: \"" + n[1] + "\", was_var: " + n[2] + ", ty: " + pnode(n[3]) + ", expr: " + pnode(n[4]) + "}"
    } else if t == "Str" {
        out = out + "Str \{ parts: "
        var pl = n[1]
        var pk: I32 = 1
        out = out + "["
        while pk < pl.len {
            if pk > 1 { out = out + ", " }
            out = out + pnode(pl[pk])
            pk += 1
        }
        out = out + "]}"
    } else if t == "Text" {
        out = out + "Text(\"" + qtext(n[1]) + "\")"
    } else if t == "Interp" {
        out = out + "Interp(\"" + qtext(n[1]) + "\")"
    } else if t == "Test" {
        out = out + "Test \{ name: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "BlockExpr" {
        out = out + "BlockExpr(" + pnode(n[1]) + ")"
    } else if t == "ComptimeVal" {
        out = out + "ComptimeVal(\"" + n[1] + "\")"
    } else if t == "Int" {
        out = out + "Int \{ text: \"" + n[1] + "\", suffix: \"" + n[2] + "\"}"
    } else if t == "Float" {
        out = out + "Float \{ text: \"" + n[1] + "\", suffix: \"" + n[2] + "\"}"
    } else if t == "Bool" {
        out = out + "Bool(" + n[1] + ")"
    } else if t == "Void" {
        out = out + "Void"
    } else if t == "ArrLit" {
        out = out + "Array(" + pjoin(n) + ")"
    } else if t == "TupleE" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "Ident" {
        out = out + "Ident(\"" + n[1] + "\")"
    }
    return out
}

fn seq2(a: Str, b: Str) -> Bool {
    if a.len != b.len { return false }
    var j: I32 = 0
    while j < a.len {
        if byte_at(a, j) != byte_at(b, j) { return false }
        j += 1
    }
    return true
}

// ---------------- C9b-0:Ctron 执行种子(数值子集树求值器) ----------------
fn digit_of(c: I32) -> I32 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 97 + 10 }
    if c >= 65 && c <= 70 { return c - 65 + 10 }
    return 0
}
fn txt_num(t: Str) -> I32 {
    // 支持 0x/0b/0o/十进制(去下划线)
    var i: I32 = 0
    var n = t.len
    var radix: I32 = 10
    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 120 {
        radix = 16
        i = 2
    }
    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 111 {
        radix = 8
        i = 2
    }
    if n >= 2 && byte_at(t, 0) == 48 && byte_at(t, 1) == 98 {
        radix = 2
        i = 2
    }
    var acc: I32 = 0
    while i < n {
        var c = byte_at(t, i)
        if c == 95 {
            i += 1
        } else {
            acc = acc * radix + digit_of(c)
            i += 1
        }
    }
    return acc
}
// ---------------- C9b①:Ctron 求值器扩面(纯函数式树行走) ----------------
// 值 = List[Str]:[0]=类别 I(Int文本)/B(true|false)/S(文本)/V(void)/R(range)
// env = 绑定 List(新在前);表达式求值线程 env/out;返回 [flow,env,val,out]
// flow:k 正常 / r return / a 断言失败;run_stmt/run_block 返回 [flow,env,out,val]

fn vI(x: I32) -> List[Str] {
    var v = List[Str]()
    v.push("I")
    v.push(x.to_string())
    return v
}
fn vB(b: Bool) -> List[Str] {
    var v = List[Str]()
    v.push("B")
    if b {
        v.push("true")
    } else {
        v.push("false")
    }
    return v
}
fn vS(s: Str) -> List[Str] {
    var v = List[Str]()
    v.push("S")
    v.push(s)
    return v
}
fn vV2() -> List[Str] {
    var v = List[Str]()
    v.push("V")
    return v
}
// C9f①:List 域 —— 客体 List 直接持有宿主 List 对象(引用语义,push 原地变、别名可见,
// 镜像 rt.c listnode);布局 ["L", item…](同 A:类别槽后逐元素)。
fn vL() -> List[Str] {
    var v = List[Str]()
    v.push("L")
    return v
}
// into_gc 深拷贝(镜像 rt.c clone_val):按种类分发,U 域名/值交错、A/L 值槽递归,
// 标量/T/F/C 逐槽重建(槽内容不窥探 —— 字符串载荷不可索引)
fn vdeep(v: List[Str]) -> List[Str] {
    var k0 = v[0]
    if k0 == "U" {
        var ou = List[Str]()
        ou.push("U")
        ou.push(v[1])
        var iu: I32 = 2
        while iu + 1 < v.len {
            ou.push(v[iu])
            ou.push(vdeep(v[iu + 1]))
            iu += 2
        }
        return ou
    }
    if or2(k0 == "A", k0 == "L") {
        var oa = List[Str]()
        oa.push(k0)
        var ia: I32 = 1
        while ia < v.len {
            oa.push(vdeep(v[ia]))
            ia += 1
        }
        return oa
    }
    var out = List[Str]()
    out.push(v[0])
    var i: I32 = 1
    while i < v.len {
        out.push(v[i])
        i += 1
    }
    return out
}
fn dvi(t: Str) -> I32 {
    var neg = false
    var k: I32 = 0
    if t.len > 0 && byte_at(t, 0) == 45 {
        neg = true
        k = 1
    }
    var acc: I32 = 0
    while k < t.len {
        acc = acc * 10 + byte_at(t, k) - 48
        k += 1
    }
    if neg {
        return 0 - acc
    }
    return acc
}
fn truth(v: List[Str]) -> Bool {
    var k = v[0]
    if k == "B" {
        return seq2(v[1], "true")
    }
    if k == "I" {
        return dvi(v[1]) != 0
    }
    return true
}
fn veq(a: List[Str], b: List[Str]) -> Bool {
    var ka = a[0]
    var kb = b[0]
    if ka == "I" && kb == "I" {
        return dvi(a[1]) == dvi(b[1])
    }
    if ka == "B" && kb == "B" {
        return seq2(a[1], b[1])
    }
    if ka == "S" && kb == "S" {
        return seq2(a[1], b[1])
    }
    return false
}
fn scmp(a: Str, b: Str) -> I32 {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    var i: I32 = 0
    while i < n {
        var x = byte_at(a, i)
        var y = byte_at(b, i)
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        i += 1
    }
    if a.len < b.len {
        return -1
    }
    if a.len > b.len {
        return 1
    }
    return 0
}
fn vcmp(a: List[Str], b: List[Str]) -> I32 {
    if a[0] == "S" && b[0] == "S" {
        return scmp(a[1], b[1])
    }
    var x = dvi(a[1])
    var y = dvi(b[1])
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    return 0
}
fn ari(op: Str, x: I32, y: I32) -> I32 {
    if op == "Add" {
        return x + y
    }
    if op == "Sub" {
        return x - y
    }
    if op == "Mul" {
        return x * y
    }
    if op == "Div" {
        return x / y
    }
    if op == "Mod" {
        return x % y
    }
    if op == "WrapAdd" {
        return x + y
    }
    if op == "WrapSub" {
        return x - y
    }
    if op == "AddEq" {
        return x + y
    }
    if op == "SubEq" {
        return x - y
    }
    if op == "MulEq" {
        return x * y
    }
    if op == "DivEq" {
        return x / y
    }
    if op == "ModEq" {
        return x % y
    }
    return 0
}
fn val_arith(op: Str, a: List[Str], b: List[Str]) -> List[Str] {
    return vI(ari(op, dvi(a[1]), dvi(b[1])))
}
fn fmt(v: List[Str]) -> Str {
    var k = v[0]
    if k == "I" {
        return v[1]
    }
    if k == "B" {
        return v[1]
    }
    if k == "S" {
        return v[1]
    }
    if k == "V" {
        return ""
    }
    return "<value>"
}
fn env_at(env: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if seq2(en[0], nm) {
            return en
        }
        i += 1
    }
    return List[Str]()
}
fn env_add(env: List[Str], nm: Str, val: List[Str]) -> List[Str] {
    var out = List[Str]()
    var en = List[Str]()
    en.push(nm)
    en.push(val)
    out.push(en)
    var i: I32 = 0
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
fn env_set(env: List[Str], nm: Str, val: List[Str]) -> List[Str] {
    var out = List[Str]()
    var done = false
    var i: I32 = 0
    while i < env.len {
        var en = env[i]
        if !done && seq2(en[0], nm) {
            var nb = List[Str]()
            nb.push(nm)
            nb.push(val)
            out.push(nb)
            done = true
        } else {
            out.push(en)
        }
        i += 1
    }
    return out
}
fn env_drop(env: List[Str], n: I32) -> List[Str] {
    var out = List[Str]()
    var i = n
    while i < env.len {
        out.push(env[i])
        i += 1
    }
    return out
}
fn e4(fl: Str, env: List[Str], vv: List[Str], out: Str) -> List[Str] {
    var r = List[Str]()
    r.push(fl)
    r.push(env)
    r.push(vv)
    r.push(out)
    return r
}
fn s4(fl: Str, env: List[Str], out: Str, vv: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push(fl)
    r.push(env)
    r.push(out)
    r.push(vv)
    return r
}
fn expr_of_text(s: Str) -> List[Str] {
    var toks = List[Str]()
    scan(s, toks)
    var cur = Atomic[I32](0)
    return p_stmt_expr(toks, cur, "1")
}
fn find_decl(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        var tt = d[0]
        if seq2(d[1], nm) && or3(seq2(tt, "Fn"), seq2(tt, "FnPub"), seq2(tt, "FnC")) {
            return d
        }
        i += 1
    }
    return List[Str]()
}
fn unesc(s: Str) -> Str {
    var out = ""
    var i: I32 = 0
    var n = s.len
    while i < n {
        var c = byte_at(s, i)
        if c == 92 && i + 1 < n {
            var e = byte_at(s, i + 1)
            if e == 110 {
                out = out + "\n"
                i += 2
            } else if e == 116 {
                out = out + "\t"
                i += 2
            } else if e == 114 {
                out = out + "\r"
                i += 2
            } else if e == 123 {
                out = out + "\{"
                i += 2
            } else if e == 34 {
                out = out + "\""
                i += 2
            } else if e == 92 {
                out = out + "\\"
                i += 2
            } else {
                out = out + byte_slice(s, i, i + 2)
                i += 2
            }
        } else {
            out = out + byte_slice(s, i, i + 1)
            i += 1
        }
    }
    return out
}

fn eval_str(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var parts = e[1]
    var acc = ""
    var env2 = env
    var j: I32 = 1
    while j < parts.len {
        var p = parts[j]
        if p[0] == "Text" {
            acc = acc + unesc(p[1])
        } else {
            var ex = expr_of_text(p[1])
            var er = eval_expr(file, env2, out, ex)
            out = er[3]
            if er[0] != "k" {
                return er
            }
            env2 = er[1]
            acc = acc + fmt(er[2])
        }
        j += 1
    }
    return e4("k", env2, vS(acc), out)
}
fn pm2(ok: Str, env: List[Str]) -> List[Str] {
    var r = List[Str]()
    r.push(ok)
    r.push(env)
    return r
}
fn enum_var(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Enum" {
            var vs = d[3]
            var k: I32 = 1
            while k < vs.len {
                if seq2(vs[k][1], nm) {
                    return true
                }
                k += 1
            }
        }
        i += 1
    }
    return false
}
// ---------------- C9f②:trait/impl 方法域(镜像 rt.c cls_method/cls_prop/call_*_body) ----------------
// 节点 schema:Method=[Method,nm,TPs,Ps,ret,body];Impl=[Impl,TPs,trait_ty,for_ty,Items];
// Trait=[Trait,nm,TPs,Bounds,Items];Prop=[Prop,nm,ty,body];Class=[Class,nm,TPs,Items]
fn ty_head(ty: List[Str]) -> Str {
    var t = ty[0]
    if t == "Named" {
        return ty[1]
    }
    if or3(t == "Ref", or2(t == "Slice", t == "Optional")) {
        return ty_head(ty[1])
    }
    return ""
}
fn find_trait(file: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Trait" && seq2(d[1], nm) {
            return d
        }
        i += 1
    }
    return List[Str]()
}
fn is_class(file: List[Str], nm: Str) -> Bool {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Class" && seq2(d[1], nm) {
            return true
        }
        i += 1
    }
    return false
}
fn find_impl_method(file: List[Str], cls: Str, m: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" && seq2(ty_head(d[3]), cls) {
            var its = d[4]
            var k: I32 = 1
            while k < its.len {
                var it = its[k]
                if it[0] == "Method" && seq2(it[1], m) {
                    return it
                }
                k += 1
            }
            var tn = ty_head(d[2])
            if tn.len > 0 {
                var tr = find_trait(file, tn)
                if tr.len > 0 {
                    var tits = tr[4]
                    var j: I32 = 1
                    while j < tits.len {
                        var tit = tits[j]
                        if tit[0] == "Method" && seq2(tit[1], m) && tit[5][0] != "None" {
                            return tit
                        }
                        j += 1
                    }
                }
            }
        }
        i += 1
    }
    return List[Str]()
}
fn find_impl_prop(file: List[Str], cls: Str, m: Str) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Impl" && seq2(ty_head(d[3]), cls) {
            var its = d[4]
            var k: I32 = 1
            while k < its.len {
                var it = its[k]
                if it[0] == "Prop" && seq2(it[1], m) && it[3][0] != "None" {
                    return it
                }
                k += 1
            }
        }
        i += 1
    }
    return List[Str]()
}
fn call_method_vals(file: List[Str], env: List[Str], out: Str, mth: List[Str], sv: List[Str], vals: List[Str]) -> List[Str] {
    var ps = mth[3]
    var nenv = env_add(List[Str](), "self", bind_of(file, sv))
    var k: I32 = 1
    var ai: I32 = 0
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            nenv = env_add(nenv, pr[2], bind_of(file, vals[ai]))
            ai += 1
        }
        k += 1
    }
    var br = run_block(file, nenv, out, mth[5])
    var fl = "k"
    if br[0] == "a" {
        fl = "a"
    }
    return e4(fl, env, br[3], br[2])
}
fn call_prop_vals(file: List[Str], env: List[Str], out: Str, pp: List[Str], sv: List[Str]) -> List[Str] {
    var nenv = env_add(List[Str](), "self", sv)
    var br = run_block(file, nenv, out, pp[3])
    var fl = "k"
    if br[0] == "a" {
        fl = "a"
    }
    return e4(fl, env, br[3], br[2])
}
// ---------------- C9g:绑定克隆与原地写(镜像 rt.c env_let/ST_ASSIGN) ----------------
// rt env_let:结构体值(非类)深克隆后才入绑定槽;类/List/标量保持引用。
// 成员写经绑定槽原地生效:结构体无别名(绑定时已克隆)→ 原地 == 重建;
// 类共享 → 原地写对别名可见。
fn bind_of(file: List[Str], v: List[Str]) -> List[Str] {
    if v[0] == "U" && !is_class(file, v[1]) {
        return vdeep(v)
    }
    return v
}
fn u_set_ip(u: List[Str], nm: Str, nv: List[Str]) -> Bool {
    var i: I32 = 2
    while i + 1 < u.len {
        if seq2(u[i], nm) {
            u[i + 1] = nv
            return true
        }
        i += 2
    }
    return false
}
fn u_field(u: List[Str], nm: Str) -> List[Str] {
    var i: I32 = 2
    while i + 1 < u.len {
        if seq2(u[i], nm) {
            return u[i + 1]
        }
        i += 2
    }
    return List[Str]()
}
fn u_set(u: List[Str], nm: Str, nv: List[Str]) -> List[Str] {
    var out = List[Str]()
    out.push("U")
    out.push(u[1])
    var i: I32 = 2
    var done = false
    while i < u.len {
        if !done && seq2(u[i], nm) {
            out.push(nm)
            out.push(nv)
            done = true
        } else {
            out.push(u[i])
            out.push(u[i + 1])
        }
        i += 2
    }
    return out
}
fn pat_match(pat: List[Str], v: List[Str], env: List[Str]) -> List[Str] {
    var t = pat[0]
    if t == "PatWild" {
        return pm2("1", env)
    }
    if t == "PatLitI" {
        if v[0] == "I" && dvi(v[1]) == dvi(pat[1]) {
            return pm2("1", env)
        }
        return pm2("0", env)
    }
    if t == "PatLitS" {
        if v[0] == "S" && seq2(v[1], pat[1]) {
            return pm2("1", env)
        }
        return pm2("0", env)
    }
    if t == "PatLitB" {
        if v[0] == "B" && seq2(v[1], pat[1]) {
            return pm2("1", env)
        }
        return pm2("0", env)
    }
    if t == "PatAgg" {
        var sub = pat[2]
        if v[0] == "U" && seq2(v[1], pat[1]) && sub[0] == "SubSt" {
            var env2 = env
            var ok3 = true
            var k: I32 = 1
            while k < sub.len && ok3 {
                var pf = sub[k]
                var nm2 = pf[1]
                var fv2 = u_field(v, nm2)
                if fv2.len == 0 {
                    ok3 = false
                } else {
                    if pf[2][0] == "None" {
                        env2 = env_add(env2, nm2, fv2)
                    } else {
                        var pr3 = pat_match(pf[2], fv2, env2)
                        if !seq2(pr3[0], "1") {
                            ok3 = false
                        } else {
                            env2 = pr3[1]
                        }
                    }
                }
                k += 1
            }
            if ok3 {
                return pm2("1", env2)
            }
            return pm2("0", env)
        }
        if v[0] == "T" && seq2(v[1], pat[1]) {
            if sub[0] == "SubUnit" {
                if v.len == 2 {
                    return pm2("1", env)
                }
                return pm2("0", env)
            }
            if sub[0] == "SubTup" {
                var np = sub.len - 1
                var npv = v.len - 2
                if np == npv {
                    var env3 = env
                    var ok2 = true
                    var k: I32 = 1
                    while k < sub.len && ok2 {
                        var pp = sub[k]
                        var pv = v[k + 1]
                        var pr2 = pat_match(pp, pv, env3)
                        if !seq2(pr2[0], "1") {
                            ok2 = false
                        } else {
                            env3 = pr2[1]
                        }
                        k += 1
                    }
                    if ok2 {
                        return pm2("1", env3)
                    }
                }
                return pm2("0", env)
            }
        }
        return pm2("0", env)
    }
    if t == "PatId" {
        return pm2("1", env_add(env, pat[1], v))
    }
    return pm2("0", env)
}
fn eval_expr(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var t = e[0]
    if t == "Int" {
        return e4("k", env, vI(txt_num(e[1])), out)
    }
    if t == "Bool" {
        if seq2(e[1], "true") {
            return e4("k", env, vB(true), out)
        }
        return e4("k", env, vB(false), out)
    }
    if t == "Str" {
        return eval_str(file, env, out, e)
    }
    if t == "Ident" {
        var en = env_at(env, e[1])
        if en.len > 0 {
            return e4("k", env, en[1], out)
        }
        if or2(seq2(e[1], "Some"), or2(seq2(e[1], "None"), or2(seq2(e[1], "Ok"), seq2(e[1], "Err")))) {
            var tv = List[Str]()
            tv.push("T")
            tv.push(e[1])
            return e4("k", env, tv, out)
        }
        if enum_var(file, e[1]) {
            var tv2 = List[Str]()
            tv2.push("T")
            tv2.push(e[1])
            return e4("k", env, tv2, out)
        }
        var fnd = find_decl(file, e[1])
        if fnd.len > 0 {
            var fv = List[Str]()
            fv.push("F")
            fv.push(e[1])
            return e4("k", env, fv, out)
        }
        panic("unbound:" + e[1])
        return e4("a", env, vV2(), out)
    }
    if t == "Unary" {
        var ur = eval_expr(file, env, out, e[2])
        if ur[0] != "k" {
            return ur
        }
        if seq2(e[1], "Neg") {
            return e4("k", ur[1], vI(0 - dvi(ur[2][1])), ur[3])
        }
        return e4("k", ur[1], vB(!truth(ur[2])), ur[3])
    }
    if t == "Binary" {
        var op = e[1]
        if seq2(op, "AndAnd") {
            var lr = eval_expr(file, env, out, e[2])
            if lr[0] != "k" {
                return lr
            }
            if !truth(lr[2]) {
                return e4("k", lr[1], vB(false), lr[3])
            }
            var rr = eval_expr(file, lr[1], lr[3], e[3])
            if rr[0] != "k" {
                return rr
            }
            return e4("k", rr[1], vB(truth(rr[2])), rr[3])
        }
        var lr2 = eval_expr(file, env, out, e[2])
        if lr2[0] != "k" {
            return lr2
        }
        var rr2 = eval_expr(file, lr2[1], lr2[3], e[3])
        if rr2[0] != "k" {
            return rr2
        }
        var a = lr2[2]
        var b = rr2[2]
        if seq2(op, "Eq") {
            return e4("k", rr2[1], vB(veq(a, b)), rr2[3])
        }
        if seq2(op, "Ne") {
            return e4("k", rr2[1], vB(!veq(a, b)), rr2[3])
        }
        if seq2(op, "Lt") {
            return e4("k", rr2[1], vB(vcmp(a, b) < 0), rr2[3])
        }
        if seq2(op, "Gt") {
            return e4("k", rr2[1], vB(vcmp(a, b) > 0), rr2[3])
        }
        if seq2(op, "Le") {
            return e4("k", rr2[1], vB(vcmp(a, b) <= 0), rr2[3])
        }
        if seq2(op, "Ge") {
            return e4("k", rr2[1], vB(vcmp(a, b) >= 0), rr2[3])
        }
        if seq2(op, "Add") {
            if a[0] == "S" && b[0] == "S" {
                return e4("k", rr2[1], vS(fmt(a) + fmt(b)), rr2[3])
            }
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        if or3(seq2(op, "Sub"), seq2(op, "Mul"), seq2(op, "Div")) {
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        if seq2(op, "Mod") {
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        if or2(seq2(op, "WrapAdd"), seq2(op, "WrapSub")) {
            return e4("k", rr2[1], val_arith(op, a, b), rr2[3])
        }
        panic("binop:" + op)
        return e4("a", env, vV2(), out)
    }
    if t == "Range" {
        var fr = eval_expr(file, env, out, e[2])
        if fr[0] != "k" {
            return fr
        }
        var tr = eval_expr(file, fr[1], fr[3], e[3])
        if tr[0] != "k" {
            return tr
        }
        var rv = List[Str]()
        rv.push("R")
        rv.push(e[1])
        rv.push(fr[2])
        rv.push(tr[2])
        return e4("k", tr[1], rv, tr[3])
    }
    if t == "Member" {
        var ob = eval_expr(file, env, out, e[1])
        if ob[0] != "k" {
            return ob
        }
        var recv = ob[2]
        if seq2(e[2], "Nm") {
            var m = e[3]
            if seq2(m, "len") {
                if recv[0] == "S" {
                    return e4("k", ob[1], vI(recv[1].len), ob[3])
                }
                if recv[0] == "A" {
                    return e4("k", ob[1], vI(recv.len - 1), ob[3])
                }
                if recv[0] == "L" {
                    return e4("k", ob[1], vI(recv.len - 1), ob[3])
                }
                panic("len target")
                return e4("a", env, vV2(), out)
            }
            if recv[0] == "U" {
                var fv = u_field(recv, m)
                if fv.len > 0 {
                    return e4("k", ob[1], fv, ob[3])
                }
                // C9f②:类实例 impl prop(rt.c EX_MEMBER 字段→cls_prop 同序)
                if is_class(file, recv[1]) {
                    var pp = find_impl_prop(file, recv[1], m)
                    if pp.len > 0 {
                        var prr = call_prop_vals(file, ob[1], ob[3], pp, recv)
                        return e4(prr[0], ob[1], prr[2], prr[3])
                    }
                }
                panic("field:" + m)
                return e4("a", env, vV2(), out)
            }
            panic("member:" + m)
            return e4("a", env, vV2(), out)
        }
        panic("tindex")
        return e4("a", env, vV2(), out)
    }
    if t == "If" {
        var cr = eval_expr(file, env, out, e[1])
        if cr[0] != "k" {
            return cr
        }
        if truth(cr[2]) {
            var br = run_block(file, cr[1], cr[3], e[2])
            return e4(br[0], br[1], br[3], br[2])
        }
        var el = e[3]
        if el[0] == "None" {
            return e4("k", cr[1], vV2(), cr[3])
        }
        return eval_expr(file, cr[1], cr[3], el)
    }
    if t == "BlockExpr" {
        var br = run_block(file, env, out, e[1])
        return e4(br[0], br[1], br[3], br[2])
    }
    if t == "Closure" {
        var cv = List[Str]()
        cv.push("C")
        cv.push(e[1])
        cv.push(e[3])
        cv.push(env)
        return e4("k", env, cv, out)
    }
    if t == "ArrLit" {
        var arr = List[Str]()
        arr.push("A")
        var env2 = env
        var out2 = out
        var k: I32 = 1
        while k < e.len {
            var er = eval_expr(file, env2, out2, e[k])
            if er[0] != "k" {
                return er
            }
            env2 = er[1]
            out2 = er[3]
            arr.push(er[2])
            k += 1
        }
        return e4("k", env2, arr, out2)
    }
    if t == "StructLit" {
        var su = List[Str]()
        su.push("U")
        su.push(e[1])
        var lf = e[2]
        var env2 = env
        var out2 = out
        var k: I32 = 1
        while k < lf.len {
            var fld = lf[k]
            var fv = eval_expr(file, env2, out2, fld[2])
            if fv[0] != "k" {
                return fv
            }
            env2 = fv[1]
            out2 = fv[3]
            su.push(fld[1])
            su.push(fv[2])
            k += 1
        }
        return e4("k", env2, su, out2)
    }
    if t == "Index" {
        var ob = eval_expr(file, env, out, e[1])
        if ob[0] != "k" {
            return ob
        }
        var ix = eval_expr(file, ob[1], ob[3], e[2])
        if ix[0] != "k" {
            return ix
        }
        var arrv = ob[2]
        var idx = dvi(ix[2][1])
        // C9f①:L 与 A 同布局(类别槽后逐元素),索引读同轨道(rt.c V_LIST/V_ARR 同分支)
        if !or2(seq2(arrv[0], "A"), seq2(arrv[0], "L")) {
            panic("index target")
            return e4("a", env, vV2(), out)
        }
        if idx < 0 {
            panic("index target")
            return e4("a", env, vV2(), out)
        }
        if idx >= arrv.len - 1 {
            panic("index target")
            return e4("a", env, vV2(), out)
        }
        return e4("k", ix[1], arrv[idx + 1], ix[3])
    }
    if t == "Match" {
        var sr = eval_expr(file, env, out, e[1])
        if sr[0] != "k" {
            return sr
        }
        var arms = e[2]
        var i2: I32 = 1
        var found = false
        var res = e4("k", sr[1], vV2(), sr[3])
        while i2 < arms.len && !found {
            var arm = arms[i2]
            var pm = pat_match(arm[1], sr[2], sr[1])
            if seq2(pm[0], "1") {
                var ae = eval_expr(file, pm[1], sr[3], arm[2])
                res = ae
                found = true
            }
            i2 += 1
        }
        if found {
            return res
        }
        panic("match no arm")
        return e4("a", env, vV2(), out)
    }
    if t == "TypeArgs" {
        return eval_expr(file, env, out, e[1])
    }
    if t == "Try" {
        var xr = eval_expr(file, env, out, e[1])
        if xr[0] != "k" {
            return xr
        }
        var xv = xr[2]
        if xv[0] == "T" {
            if or2(seq2(xv[1], "None"), seq2(xv[1], "Err")) {
                return e4("r", xr[1], xv, xr[3])
            }
            if or2(seq2(xv[1], "Some"), seq2(xv[1], "Ok")) {
                if xv.len == 3 {
                    return e4("k", xr[1], xv[2], xr[3])
                }
                return e4("k", xr[1], xv, xr[3])
            }
        }
        return e4("k", xr[1], xv, xr[3])
    }
    if t == "Call" {
        return eval_call(file, env, out, e)
    }
    if t == "Void" {
        return e4("k", env, vV2(), out)
    }
    panic("expr:" + t)
    return e4("a", env, vV2(), out)
}
fn call_decl_vals(file: List[Str], env: List[Str], out: Str, d: List[Str], vals: List[Str]) -> List[Str] {
    var ps = d[3]
    var nenv = List[Str]()
    var k: I32 = 1
    while k < ps.len {
        var pr = ps[k]
        if pr[0] == "Param" {
            nenv = env_add(nenv, pr[2], bind_of(file, vals[k - 1]))
        }
        k += 1
    }
    var br = run_block(file, nenv, out, d[5])
    var fl = "k"
    if br[0] == "a" {
        fl = "a"
    }
    return e4(fl, env, br[3], br[2])
}
fn call_cv(file: List[Str], env: List[Str], out: Str, v: List[Str], vals: List[Str]) -> List[Str] {
    if seq2(v[0], "F") {
        var d = find_decl(file, v[1])
        if d.len == 0 {
            panic("no fn:" + v[1])
            return e4("a", env, vV2(), out)
        }
        return call_decl_vals(file, env, out, d, vals)
    }
    if seq2(v[0], "C") {
        var cap = v[3]
        var cp = v[1]
        var nenv = cap
        var k: I32 = 1
        while k < cp.len {
            nenv = env_add(nenv, cp[k][2], vals[k - 1])
            k += 1
        }
        var br = eval_expr(file, nenv, out, v[2])
        return e4(br[0], env, br[2], br[3])
    }
    panic("call value")
    return e4("a", env, vV2(), out)
}
fn call_id(file: List[Str], env: List[Str], out: Str, nm: Str, vals: List[Str]) -> List[Str] {
    if seq2(nm, "print") {
        if vals.len == 1 {
            return e4("k", env, vV2(), out + fmt(vals[0]))
        }
        panic("print arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "println") {
        if vals.len == 1 {
            return e4("k", env, vV2(), out + fmt(vals[0]) + "\n")
        }
        panic("println arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert") {
        if vals.len == 1 {
            if truth(vals[0]) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert failed"), out)
        }
        panic("assert arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert_eq") {
        if vals.len == 2 {
            if veq(vals[0], vals[1]) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert_eq failed: " + fmt(vals[0]) + " != " + fmt(vals[1])), out)
        }
        panic("assert_eq arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "assert_ne") {
        if vals.len == 2 {
            if !veq(vals[0], vals[1]) {
                return e4("k", env, vV2(), out)
            }
            return e4("a", env, vS("assert_ne failed: " + fmt(vals[0]) + " != " + fmt(vals[1])), out)
        }
        panic("assert_ne arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "read_file") {
        if vals.len == 1 && vals[0][0] == "S" {
            var rr = read_file(vals[0][1])
            match rr {
                Some(s) => {
                    var tv = List[Str]()
                    tv.push("T")
                    tv.push("Some")
                    tv.push(vS(s))
                    return e4("k", env, tv, out)
                }
                None => {
                    var tw = List[Str]()
                    tw.push("T")
                    tw.push("None")
                    return e4("k", env, tw, out)
                }
            }
        }
        panic("read_file args")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "byte_at") {
        if vals.len == 2 && vals[0][0] == "S" && vals[1][0] == "I" {
            return e4("k", env, vI(byte_at(vals[0][1], dvi(vals[1][1]))), out)
        }
        panic("byte_at arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "byte_slice") {
        if vals.len == 3 && vals[0][0] == "S" && vals[1][0] == "I" && vals[2][0] == "I" {
            return e4("k", env, vS(byte_slice(vals[0][1], dvi(vals[1][1]), dvi(vals[2][1]))), out)
        }
        panic("byte_slice arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(nm, "panic") {
        if vals.len == 1 {
            panic(fmt(vals[0]))
        }
        panic("panic arity")
        return e4("a", env, vV2(), out)
    }
    if or2(seq2(nm, "Some"), or2(seq2(nm, "None"), or2(seq2(nm, "Ok"), seq2(nm, "Err")))) {
        var tv = List[Str]()
        tv.push("T")
        tv.push(nm)
        var qq: I32 = 0
        while qq < vals.len {
            tv.push(vals[qq])
            qq += 1
        }
        return e4("k", env, tv, out)
    }
    var evb = env_at(env, nm)
    if evb.len > 0 {
        var kv = evb[1]
        if or2(seq2(kv[0], "C"), seq2(kv[0], "F")) {
            return call_cv(file, env, out, kv, vals)
        }
    }
    var d = find_decl(file, nm)
    if d.len == 0 {
        panic("no fn:" + nm)
        return e4("a", env, vV2(), out)
    }
    return call_decl_vals(file, env, out, d, vals)
}
fn call_mem(file: List[Str], env: List[Str], out: Str, cal: List[Str], vals: List[Str]) -> List[Str] {
    var ob = eval_expr(file, env, out, cal[1])
    if ob[0] != "k" {
        return ob
    }
    var recv = ob[2]
    var m = cal[3]
    if seq2(m, "to_string") {
        if vals.len == 0 {
            return e4("k", ob[1], vS(fmt(recv)), ob[3])
        }
        panic("to_string arity")
        return e4("a", env, vV2(), out)
    }
    if seq2(m, "slice") {
        if vals.len == 1 && recv[0] == "S" && vals[0][0] == "R" {
            var rv = vals[0]
            var lo = dvi(rv[2][1])
            var hi = dvi(rv[3][1])
            if seq2(rv[1], "true") {
                hi += 1
            }
            if lo < 0 {
                lo = 0
            }
            var L = recv[1].len
            if hi > L {
                hi = L
            }
            if hi < lo {
                hi = lo
            }
            return e4("k", ob[1], vS(byte_slice(recv[1], lo, hi)), ob[3])
        }
        panic("slice args")
        return e4("a", env, vV2(), out)
    }
    if seq2(m, "load") {
        if recv[0] == "M" && vals.len == 0 {
            return e4("k", ob[1], recv[1], ob[3])
        }
    }
    if seq2(m, "store") {
        if recv[0] == "M" && vals.len == 1 {
            recv[1] = vals[0]
            return e4("k", ob[1], vV2(), ob[3])
        }
    }
    if seq2(m, "push") {
        if recv[0] == "L" && vals.len == 1 {
            recv.push(vals[0])
            return e4("k", ob[1], vV2(), ob[3])
        }
    }
    if seq2(m, "into_gc") {
        if recv[0] == "L" && vals.len == 0 {
            return e4("k", ob[1], vdeep(recv), ob[3])
        }
    }
    // C9f②:类实例方法/trait 默认方法(镜像 rt.c V_STRUCT&&is_class 先于 UFCS;
    // 类找不到方法直接 panic,不落 UFCS)
    if recv[0] == "U" && is_class(file, recv[1]) {
        var mth = find_impl_method(file, recv[1], m)
        if mth.len > 0 {
            return call_method_vals(file, ob[1], ob[3], mth, recv, vals)
        }
        panic("unknown method:" + m)
        return e4("a", env, vV2(), out)
    }
    var ddx = find_decl(file, m)
    if ddx.len > 0 {
        var fvv = List[Str]()
        fvv.push(recv)
        var qq: I32 = 0
        while qq < vals.len {
            fvv.push(vals[qq])
            qq += 1
        }
        return call_decl_vals(file, ob[1], ob[3], ddx, fvv)
    }
    panic("method:" + m)
    return e4("a", env, vV2(), out)
}
fn eval_call(file: List[Str], env: List[Str], out: Str, e: List[Str]) -> List[Str] {
    var ag = e[2]
    var vals = List[Str]()
    var env2 = env
    var out2 = out
    var i: I32 = 1
    while i < ag.len {
        var ar = eval_expr(file, env2, out2, ag[i])
        if ar[0] != "k" {
            return ar
        }
        env2 = ar[1]
        out2 = ar[3]
        vals.push(ar[2])
        i += 1
    }
    var cal = e[1]
    if cal[0] == "Ident" {
        return call_id(file, env2, out2, cal[1], vals)
    }
    if cal[0] == "Member" {
        return call_mem(file, env2, out2, cal, vals)
    }
    // C9f①:List 构造 List[T]()(rt.c:同参忽略,恒空表;arena.list[T]() 同)
    if cal[0] == "TypeArgs" {
        var base = cal[1]
        var islist = false
        if base[0] == "Ident" && seq2(base[1], "List") {
            islist = true
        }
        if base[0] == "Member" && seq2(base[2], "Nm") && seq2(base[3], "list") && base[1][0] == "Ident" && seq2(base[1][1], "arena") {
            islist = true
        }
        if islist {
            return e4("k", env2, vL(), out2)
        }
        if base[0] == "Ident" && seq2(base[1], "Atomic") {
            var mv = List[Str]()
            mv.push("M")
            if vals.len > 0 {
                mv.push(vals[0])
            } else {
                mv.push(vV2())
            }
            return e4("k", env2, mv, out2)
        }
    }
    panic("call target")
    return e4("a", env, vV2(), out)
}
fn run_stmt(file: List[Str], env: List[Str], out: Str, st: List[Str]) -> List[Str] {
    var t = st[0]
    if t == "Return" {
        if st[1][0] == "None" {
            return s4("r", env, out, vV2())
        }
        var er = eval_expr(file, env, out, st[1])
        if er[0] != "k" {
            return s4(er[0], er[1], er[3], er[2])
        }
        return s4("r", er[1], er[3], er[2])
    }
    if t == "Let" {
        var pat = st[2]
        if pat[0] == "PatId" {
            var er = eval_expr(file, env, out, st[4])
            if er[0] != "k" {
                return s4(er[0], er[1], er[3], er[2])
            }
            return s4("k", env_add(er[1], pat[1], bind_of(file, er[2])), er[3], vV2())
        }
        if pat[0] == "PatWild" {
            var er = eval_expr(file, env, out, st[4])
            if er[0] != "k" {
                return s4(er[0], er[1], er[3], er[2])
            }
            return s4("k", er[1], er[3], vV2())
        }
        panic("let pat:" + pat[0])
        return s4("a", env, out, vV2())
    }
    if t == "Expr" {
        var er = eval_expr(file, env, out, st[1])
        return s4(er[0], er[1], er[3], er[2])
    }
    if t == "Assign" {
        var tg = st[1]
        if tg[0] == "Member" && tg[2] == "Nm" && tg[1][0] == "Ident" {
            var oname = tg[1][1]
            var fname = tg[3]
            var en = env_at(env, oname)
            if en.len == 0 {
                panic("unbound:" + oname)
                return s4("a", env, out, vV2())
            }
            var ov = en[1]
            if ov[0] != "U" {
                panic("member assign target")
                return s4("a", env, out, vV2())
            }
            var vr = eval_expr(file, env, out, st[3])
            if vr[0] != "k" {
                return s4(vr[0], vr[1], vr[3], vr[2])
            }
            var op = st[2]
            var nv = vr[2]
            if !seq2(op, "Eq") {
                var oldf = u_field(ov, fname)
                nv = vI(ari(op, dvi(oldf[1]), dvi(nv[1])))
            }
            // C9g:原地写(镜像 rt.c ST_ASSIGN 经绑定槽直接改;结构体绑定时已克隆,类共享可见)
            if !u_set_ip(ov, fname, nv) {
                panic("field:" + fname)
                return s4("a", env, out, vV2())
            }
            return s4("k", vr[1], vr[3], vV2())
        }
        if tg[0] == "Ident" {
            var nm = tg[1]
            var en = env_at(env, nm)
            if en.len == 0 {
                panic("unbound:" + nm)
                return s4("a", env, out, vV2())
            }
            var vr = eval_expr(file, env, out, st[3])
            if vr[0] != "k" {
                return s4(vr[0], vr[1], vr[3], vr[2])
            }
            var op = st[2]
            var nv = vr[2]
            if !seq2(op, "Eq") {
                var oa = en[1]
                nv = vI(ari(op, dvi(oa[1]), dvi(nv[1])))
            }
            // C9g:结构体右值赋给绑定也克隆(镜像 rt.c b->slot = clone…)
            return s4("k", env_set(vr[1], nm, bind_of(file, nv)), vr[3], vV2())
        }
        // C9f①:索引赋值 a[i] = v / a[i] op= v —— A/L 同布局;L 经宿主 List 索引写
        // 写透共享后备(镜像 rt.c ST_ASSIGN 的 V_LIST/V_ARR 写透分支)
        if tg[0] == "Index" && tg[1][0] == "Ident" {
            var nm3 = tg[1][1]
            var en3 = env_at(env, nm3)
            if en3.len == 0 {
                panic("unbound:" + nm3)
                return s4("a", env, out, vV2())
            }
            var cont = en3[1]
            if !or2(seq2(cont[0], "A"), seq2(cont[0], "L")) {
                panic("index assign target")
                return s4("a", env, out, vV2())
            }
            var ixr = eval_expr(file, env, out, tg[2])
            if ixr[0] != "k" {
                return s4(ixr[0], ixr[1], ixr[3], ixr[2])
            }
            var idx = dvi(ixr[2][1])
            if or2(idx < 0, idx >= cont.len - 1) {
                panic("index out of bounds")
                return s4("a", env, out, vV2())
            }
            var vr = eval_expr(file, env, out, st[3])
            if vr[0] != "k" {
                return s4(vr[0], vr[1], vr[3], vr[2])
            }
            var op3 = st[2]
            var nv3 = vr[2]
            if !seq2(op3, "Eq") {
                var old3 = cont[idx + 1]
                nv3 = vI(ari(op3, dvi(old3[1]), dvi(nv3[1])))
            }
            cont[idx + 1] = nv3
            return s4("k", ixr[1], ixr[3], vV2())
        }
        panic("assign target:" + tg[0])
        return s4("a", env, out, vV2())
    }
    if t == "While" {
        var go = true
        var envw = env
        var outw = out
        while go {
            var cr = eval_expr(file, envw, outw, st[1])
            if cr[0] != "k" {
                return s4(cr[0], cr[1], cr[3], cr[2])
            }
            envw = cr[1]
            outw = cr[3]
            if truth(cr[2]) {
                var br = run_block(file, envw, outw, st[2])
                if br[0] != "k" {
                    return s4(br[0], br[1], br[2], br[3])
                }
                envw = br[1]
                outw = br[2]
            } else {
                go = false
            }
        }
        return s4("k", envw, outw, vV2())
    }
    if t == "For" {
        var pat = st[1]
        var nm = "_"
        if pat[0] == "PatId" {
            nm = pat[1]
        }
        var ir = eval_expr(file, env, out, st[2])
        if ir[0] != "k" {
            return s4(ir[0], ir[1], ir[3], ir[2])
        }
        var it = ir[2]
        if it[0] == "A" {
            var envw3 = ir[1]
            var outw3 = ir[3]
            var c2: I32 = 1
            while c2 < it.len {
                var eit = env_add(envw3, nm, it[c2])
                var br = run_block(file, eit, outw3, st[3])
                if br[0] != "k" {
                    return s4(br[0], br[1], br[2], br[3])
                }
                envw3 = env_drop(br[1], 1)
                outw3 = br[2]
                c2 += 1
            }
            return s4("k", envw3, outw3, vV2())
        }
        if it[0] != "R" {
            panic("for iter not range")
            return s4("a", env, out, vV2())
        }
        var lo = dvi(it[2][1])
        var hi = dvi(it[3][1])
        var incl = seq2(it[1], "true")
        var envw = ir[1]
        var outw = ir[3]
        var cur = lo
        var more = true
        if incl {
            if cur > hi {
                more = false
            }
        } else {
            if cur >= hi {
                more = false
            }
        }
        while more {
            var eit = env_add(envw, nm, vI(cur))
            var br = run_block(file, eit, outw, st[3])
            if br[0] != "k" {
                return s4(br[0], br[1], br[2], br[3])
            }
            envw = env_drop(br[1], 1)
            outw = br[2]
            cur += 1
            if incl {
                if cur > hi {
                    more = false
                }
            } else {
                if cur >= hi {
                    more = false
                }
            }
        }
        return s4("k", envw, outw, vV2())
    }
    panic("stmt:" + t)
    return s4("a", env, out, vV2())
}
fn run_block(file: List[Str], env0: List[Str], out: Str, blk: List[Str]) -> List[Str] {
    var flow = "k"
    var env = env0
    var o2 = out
    var val = vV2()
    var i: I32 = 1
    while i < blk.len - 1 {
        if flow == "k" {
            var sr = run_stmt(file, env, o2, blk[i])
            flow = sr[0]
            env = sr[1]
            o2 = sr[2]
            val = sr[3]
        }
        i += 1
    }
    if flow == "k" {
        var tl = blk[blk.len - 1]
        if tl[0] == "None" {
            val = vV2()
        } else {
            var er = eval_expr(file, env, o2, tl)
            flow = er[0]
            env = er[1]
            val = er[2]
            o2 = er[3]
        }
    }
    var extra = env.len - env0.len
    if extra > 0 {
        env = env_drop(env, extra)
    }
    return s4(flow, env, o2, val)
}
fn run_tests(file: List[Str]) -> List[Str] {
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Test" {
            var br = run_block(file, List[Str](), "", d[2])
            if br[0] == "a" {
                return br
            }
        }
        i += 1
    }
    return s4("k", List[Str](), "", vV2())
}
fn main() -> I32 {
    let src = read_file("../selfhosted/input_ev2.ct")
    match src {
        Some(s) => {
            var toks = List[Str]()
            scan(s, toks)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur)
            var d = find_decl(file, "main")
            if d.len > 0 {
                var br = run_block(file, List[Str](), "", d[5])
                if br[0] == "a" {
                    print(fmt(br[3]))
                    return 1
                }
                print(br[2])
                return 0
            }
            var tr = run_tests(file)
            if tr[0] == "a" {
                print(fmt(tr[3]))
                return 1
            }
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
