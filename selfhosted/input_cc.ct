fn abs2(x: I32) -> I32 {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn fib(n: I32) -> I32 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn fact(n: I32) -> I32 {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

fn sum_up(hi: I32) -> I32 {
    var s: I32 = 0
    var i: I32 = 0
    while i <= hi {
        s = s + i
        i += 1
    }
    return s
}

fn main() -> I32 {
    var x = 2 + 3 * 4
    println(x.to_string())
    println(fib(10).to_string())
    println(fact(6).to_string())
    println(sum_up(10).to_string())
    println(abs2(0 - 5).to_string())
    var t = x > 10 && x < 20
    println(t.to_string())
    println((x == 14).to_string())
    println((x != 14).to_string())
    println((3 < 2).to_string())
    println("x={x}")
    println("f={x + 1}")
    var acc = 0
    for i in 1..5 {
        acc = acc + i
    }
    println(acc.to_string())
    for i in 0..=3 {
        println(i.to_string())
    }
    var q = 1
    if true {
        var q = 2
        println(q.to_string())
    }
    println(q.to_string())
    var z = 1
    if true {
        z += 10
    }
    println(z.to_string())
    var w = "a"
    if x >= 90 {
        w = "hi"
    } else if x >= 15 {
        w = "mid"
    } else {
        w = "lo"
    }
    println(w)
    println("fib3={fib(3)}")
    return 0
}
