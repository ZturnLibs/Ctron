fn add(a: I32, b: I32) -> I32 {
    return a + b
}
fn fact(n: I32) -> I32 {
    var r = 1
    var i = 2
    while i <= n {
        r = r * i
        i = i + 1
    }
    return r
}
fn main() -> I32 {
    println(add(40, 2))
    println(fact(5))
    println(fact(10))
    var i = 0
    while i < 3 {
        println(i)
        i = i + 1
    }
    return 0
}
