// trans_v5.ct —— 发射面值位 if(§4.6 三元)+ 字符串插值(§4.11)
struct Point {
    let x: I32
    let y: I32
}
fn sign(x: I32) -> I32 {
    return if x < 0 { 0 - 1 } else { 1 }
}
fn pick(flag: Bool) -> Str {
    return if flag { "yes" } else { "no" }
}
fn main() -> I32 {
    let a = 5
    let label = if a > 3 { "big" } else { "small" }
    println(label)
    println("a={a}")
    let b = 7
    println("sum {a + b}")
    println(sign(0 - 2).to_string())
    println(pick(a < b))
    let p = Point { x: 2, y: 9 }
    println("p=({p.x},{p.y}) sum={p.x + p.y}")
    let nested = if a > 1 { if b > 1 { "both" } else { "a" } } else { "none" }
    println(nested)
    return 0
}
