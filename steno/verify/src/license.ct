// license.ct —— stenolicense.v1:license 验证 + sign-license 生产面
// 契约:docs/superpowers/specs/2026-10-17-steno-verify-format-spec.md §2。
// 信封单行紧凑 JSON,core = 最后一个 `,"sig":"` 之前全部字节;无哈希链(纯签名面)。
// 模块间传值:Ok 面 = TSV(product\temail\tmachine\tissued_at\tupdates_until\tnonce)——
// 内部通道而非契约面;email 含制表符为病态输入,仅损 --json 展示,不判真伪。
use std.json.{parse, qval, qtag, jget_i64}
use std.str.{rindex, count_sub, ends_with, trim_right}
use crypto.{ed25519_verify_hex, ed25519_sign_hex}
use steno_verify.util.{is_lower_hex}

fn lic_msg(why: Str) -> Str {
    return "license: " + why
}

// 信封字段核对;Ok = TSV 字段行
fn check_license_fields(es: List[List[Str]]) -> Result[Str, Str] {
    let gv = jget_i64(es, "$.v")
    match gv {
        Ok(v) => {
            if v != 1 {
                return Err(lic_msg("v must be 1"))
            }
        }
        Err(_) => {
            return Err(lic_msg("v missing or not an integer"))
        }
    }
    if qtag(es, "$.product") != "s" {
        return Err(lic_msg("product missing or not a string"))
    }
    let product = qval(es, "$.product")
    if product.len == 0 {
        return Err(lic_msg("product must be non-empty"))
    }
    if qtag(es, "$.email") != "s" {
        return Err(lic_msg("email missing or not a string"))
    }
    let email = qval(es, "$.email")
    if email.len == 0 {
        return Err(lic_msg("email must be non-empty"))
    }
    if qtag(es, "$.machine") != "s" {
        return Err(lic_msg("machine missing or not a string"))
    }
    let machine = qval(es, "$.machine")
    if machine.len != 64 {
        return Err(lic_msg("machine must be exactly 64 chars"))
    }
    if is_lower_hex(machine) == false {
        return Err(lic_msg("machine must be 64 lowercase hex chars"))
    }
    var issued: I64 = 0 - 1
    let gi = jget_i64(es, "$.issued_at")
    match gi {
        Ok(v) => {
            issued = v
        }
        Err(_) => {
            return Err(lic_msg("issued_at missing or not an integer"))
        }
    }
    if issued < 0 {
        return Err(lic_msg("issued_at must be >= 0"))
    }
    var updates: I64 = 0 - 1
    let gu = jget_i64(es, "$.updates_until")
    match gu {
        Ok(v) => {
            updates = v
        }
        Err(_) => {
            return Err(lic_msg("updates_until missing or not an integer"))
        }
    }
    if updates < 0 {
        return Err(lic_msg("updates_until must be >= 0"))
    }
    if qtag(es, "$.nonce") != "s" {
        return Err(lic_msg("nonce missing or not a string"))
    }
    let nonce = qval(es, "$.nonce")
    if nonce.len != 32 {
        return Err(lic_msg("nonce must be exactly 32 chars"))
    }
    if is_lower_hex(nonce) == false {
        return Err(lic_msg("nonce must be 32 lowercase hex chars"))
    }
    return Ok(product + "\t" + email + "\t" + machine + "\t" + issued.to_string() + "\t" + updates.to_string() + "\t" + nonce)
}

// 验证 license:Ok(TSV 字段行) / Err(报告)
pub fn verify_license(pub_hex: Str, text: Str) -> Result[Str, Str] {
    if pub_hex.len != 64 {
        return Err("config: pub key must be 64 hex chars")
    }
    if is_lower_hex(pub_hex) == false {
        return Err("config: pub key must be lowercase hex")
    }
    let line = trim_right(text)
    if line.len == 0 {
        return Err(lic_msg("empty file"))
    }
    let sm_count = count_sub(line, ",\"sig\":\"")
    if sm_count != 1 {
        return Err(lic_msg("sig marker must occur exactly once"))
    }
    if ends_with(line, "\"}") == false {
        return Err(lic_msg("line must end with sig closing quote+brace"))
    }
    let sm = rindex(line, ",\"sig\":\"")
    let sig_len = line.len - 2 - (sm + 8)
    if sig_len != 128 {
        return Err(lic_msg("sig field must be exactly 128 chars"))
    }
    let core = byte_slice(line, 0, sm)
    let sig_hex = byte_slice(line, sm + 8, line.len - 2)
    if is_lower_hex(sig_hex) == false {
        return Err(lic_msg("sig must be 128 lowercase hex chars"))
    }
    let pr = parse(line)
    if pr.is_ok() == false {
        return Err(lic_msg("invalid JSON"))
    }
    let es = pr.expect("parse")
    let fv = check_license_fields(es)
    var bad = ""
    match fv {
        Err(m) => {
            bad = m
        }
        Ok(_) => {
        }
    }
    if bad.len != 0 {
        return Err(bad)
    }
    let fields = fv.expect("fields")
    let vv = ed25519_verify_hex(pub_hex, core, sig_hex)
    if vv != 1 {
        return Err(lic_msg("signature invalid"))
    }
    return Ok(fields)
}

// sign-license:未签名信封行(无 sig 字段)→ 补签名完整行(Ok = 输出文本)
pub fn sign_license(priv_hex: Str, in_text: Str) -> Result[Str, Str] {
    if priv_hex.len != 64 {
        return Err("config: priv key must be 64 hex chars")
    }
    if is_lower_hex(priv_hex) == false {
        return Err("config: priv key must be lowercase hex")
    }
    let line = trim_right(in_text)
    if line.len == 0 {
        return Err(lic_msg("empty input"))
    }
    if count_sub(line, ",\"sig\":\"") != 0 {
        return Err(lic_msg("input already carries a sig field"))
    }
    if ends_with(line, "}") == false {
        return Err(lic_msg("input line must end with }"))
    }
    let pr = parse(line)
    if pr.is_ok() == false {
        return Err(lic_msg("invalid JSON"))
    }
    let es = pr.expect("parse")
    let fv = check_license_fields(es)
    var bad = ""
    match fv {
        Err(m) => {
            bad = m
        }
        Ok(_) => {
        }
    }
    if bad.len != 0 {
        return Err(bad)
    }
    let core = byte_slice(line, 0, line.len - 1)
    let sg = ed25519_sign_hex(priv_hex, core)
    if sg.len != 128 {
        return Err(lic_msg("sign failed"))
    }
    return Ok(core + ",\"sig\":\"" + sg + "\"}" + "\n")
}
