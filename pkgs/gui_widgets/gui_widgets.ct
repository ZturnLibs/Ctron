// gui_widgets/gui_widgets.ct —— 组件库(gui.ct 拆分阶段三;2026-09-27 拆分规划)
//
// 16 组件全量规范形态(2026-10-04 全量统一):Select/WList/Dialog/Menu/EditMenu/
// MenuBar/List/MultiList/Slider/Progress/Tabs/Badge/Accordion/Tooltip/Toast/Table。
// 纯 prop 契约:组件体仅消费自家 prop 与内建名(dragpx/mods/fld),宿主模型零耦合;
// 事件处理器驻留宿主(名字扁平视图解析,合约Ⅱ-b 模型捕获直传)。宿主按需定义:
//   Select: sel_toggle / sel_pick            Dialog: dialog_close / dialog_cancel / dialog_confirm
//   WList:  list_pick                        Menu:   menu_toggle / menu_pick
//   List:   list_sel                         Slider: slide
//   MultiList: ml2_pick                      Progress: (无;值经 prop,宿主 act 改模型)
//   EditMenu: ed_toggle / ed_pick            Tabs:   tab_go
//   Accordion: acc_toggle                    Tooltip: tip_noop
//   Table:  tab_pick                         Toast:  (无;show prop 驱动)
//   Palette: pal_type(文本通道)/pal_go(submit 通道)/pal_pick(行) / pal_close
//   DatePick: dp_prev / dp_next / dp0..dp6(行后缀=行,头名位=列)——月历/周头全 prop
//   TimePick: tp_step(显参通道,"h+1"/"m-1" 形)——locale(周首日/月名)走 props
//   ColorPick: cp_paint(绘制帧)/cp_drag(显参 dragpx/dragpy 带标 permille)/
//     cp_hue(行)/cp_hex(文本通道)——SV 方 canvas 标记容器;组件内 bind=源名通道
//   BarChart: (无事件;vals=条高像素串,归一/负值钳位在宿主)——零数据安全
//   LineChart: lt_paint(绘制帧;pts=千分比 y 串,宿主画折线)——sparkline=同件小形
//
// 消费(声明级 use,GuiBlock 恒随合并——锚一个符号,视图+样式全量并入):
//   use gui_widgets.{gui_widgets_ver}
//   ... <Select label: {m.catlabel} open: {m.catopen} opts: {m.opts}/>
// 样式预设:snake_case 类名(w_* 族)+主题令牌色(随 theme_apply 换装);
// 几何敏感值按陈列室原值(spacer 轨道 220x8/progress 轨 200x10/fill=百分比×2)。
// ⚠️ 在册观察(2026-10-04):kebab 横线类名(w-select)经跨包 use 合并后样式
// 不应用(行宽塌缩→文本按词折行),snake_case 正常;宿主同名样式须删除避免双份。
pub fn gui_widgets_ver() -> Str {
    return "gui_widgets/0.6"
}

view Select (label: Str, open: Bool, opts: List[Str]) {
  <vbox class="w_select">
    <button class="w_trigger" on:click={sel_toggle()}>{label}</button>
    <when cond={open}>
      <overlay class="w_mask" on:click={sel_toggle()}>
        <vbox class="w_opts">
          <each o in={opts}>
            <button class="w_opt" on:click={sel_pick()}>{o}</button>
          </each>
        </vbox>
      </overlay>
    </when>
  </vbox>
}

view WList (title: Str, items: List[Str]) {
  <vbox class="w_list">
    <label class="w_list_t">{title}</label>
    <each it in={items}>
      <button class="w_row" on:click={list_pick()}>{it}</button>
    </each>
  </vbox>
}

view Dialog (title: Str, open: Bool) {
  <when cond={open}>
    <overlay class="w_mask" on:click={dialog_close()}>
      <vbox class="w_card">
        <label class="w_title">{title}</label>
        <label class="w_body">此操作将写入模型并关闭对话框</label>
        <hbox class="w_actions">
          <button class="w_act" on:click={dialog_cancel}>取消</button>
          <button class="w_act w_actp" on:click={dialog_confirm}>确认</button>
        </hbox>
      </vbox>
    </overlay>
  </when>
}

view Menu (open: Bool, items: List[Str]) {
  <vbox class="w_menu">
    <button class="w_trigger" on:click={menu_toggle}>文件</button>
    <when cond={open}>
      <vbox class="w_opts">
        <each mi in={items}>
          <button class="w_opt" on:click={menu_pick}>{mi}</button>
        </each>
      </vbox>
    </when>
  </vbox>
}

view EditMenu (open: Bool, items: List[Str]) {
  <vbox class="w_menu">
    <button class="w_trigger" on:click={ed_toggle}>编辑</button>
    <when cond={open}>
      <vbox class="w_opts">
        <each ei in={items}>
          <button class="w_opt" on:click={ed_pick}>{ei}</button>
        </each>
      </vbox>
    </when>
  </vbox>
}

view MenuBar (open: Bool, edopen: Bool, items: List[Str], eitems: List[Str]) {
  <hbox class="w_bar">
    <Menu open: {open} items: {items}/>
    <EditMenu open: {edopen} items: {eitems}/>
  </hbox>
}

view List (title: Str, items: List[Str]) {
  <vbox class="w_list">
    <label class="w_list_t">{title}</label>
    <each li in={items}>
      <button class="w_row" on:click={list_sel}>{li}</button>
    </each>
  </vbox>
}

view MultiList (title: Str, items: List[Str]) {
  <vbox class="w_list">
    <label class="w_list_t">{title}</label>
    <each mi in={items}>
      <button class="w_row" on:click={ml2_pick(mods)}>{mi}</button>
    </each>
  </vbox>
}

view Slider (val: I32) {
  <vbox class="w_slider">
    <spacer class="w_track" on:drag={slide(dragpx)}/>
    <label class="w_val">{val}</label>
  </vbox>
}

view Progress (pct: I32) {
  <vbox class="w_prog">
    <hbox class="w_ptk">
      <hbox class="w_pfl"/>
    </hbox>
    <label class="w_pct">{pct}</label>
  </vbox>
}

view Tabs (cur: I32, tabs: List[Str]) {
  <vbox class="w_tabs">
    <hbox class="w_tabrow">
      <each tb in={tabs}>
        <button class="w_tab" on:click={tab_go}>{tb}</button>
      </each>
    </hbox>
    <when cond={cur == 0}>
      <label class="w_tabp">概览内容</label>
    </when>
    <when cond={cur == 1}>
      <label class="w_tabp">详情内容</label>
    </when>
  </vbox>
}

view Badge (text: Str) {
  <label class="w_badge">{text}</label>
}

view Accordion (title: Str, open: Bool) {
  <vbox class="w_acc">
    <button class="w_acch" on:click={acc_toggle}>{title}</button>
    <when cond={open}>
      <slot/>
    </when>
  </vbox>
}

view Tooltip (text: Str) {
  <hbox class="w_tipw">
    <button class="w_tiptrg" hover:wtt on:click={tip_noop}>悬停我</button>
    <when cond={wtt}>
      <label class="w_tip">{text}</label>
    </when>
  </hbox>
}

view Toast (show: Bool, msg: Str) {
  <when cond={show}>
    <overlay class="w_toast">
      <label class="w_toastt">{msg}</label>
    </overlay>
  </when>
}

view Table (items: List[Str]) {
  <vbox class="w_table">
    <hbox class="w_thead">
      <label class="w_th">名称</label>
      <label class="w_th">大小</label>
    </hbox>
    <each ti in={items}>
      <button class="w_tr" on:click={tab_pick}>
        <hbox class="w_trin">
          <label class="w_td1">{fld(ti, "·", 0)}</label>
          <label class="w_td2">{fld(ti, "·", 1)}</label>
        </hbox>
      </button>
    </each>
  </vbox>
}

// Palette(GUI-40 命令面板;纯 prop 契约):open 显隐/q 输入显示(rows 过滤在宿主
// bind 面)/行点击 pal_pick(实例后缀行号)/Enter=pal_go(submit 通道)/遮罩与
// Esc(pal_close)。过滤谓词、高亮前缀("> ")、动作执行全在宿主;input 焦点经
// gui_focus_req("q")(bind 路径=prop 名)由宿主在打开时发起。
view Palette (open: Bool, q: Str, rows: List[Str]) {
  <when cond={open}>
    <overlay class="w_mask" on:click={pal_close}>
      <vbox class="w_pal">
        <input class="w_palq" bind={q} on:input={pal_type()} on:submit={pal_go()} placeholder="输入命令…"/>
        <each it in={rows}>
          <button class="w_palrow" on:click={pal_pick}>{it}</button>
        </each>
      </vbox>
    </overlay>
  </when>
}

// DatePick(GUI-38 月历选日;纯 prop 契约):ym=月标题 hd="一|二|…|日" 周头
// weeks=恒 6 行 "d0|…|d6"(宿主历法+选中 "> " 前缀,空白位空串);dp_prev/next
// 换月(宿主钳日);dp0..dp6 行点击=头名位定列+实例后缀定行,宿主映射日。
// locale 不进引擎(周首日/月名/格式全 props)。
view DatePick (ym: Str, hd: Str, weeks: List[Str]) {
  <vbox class="w_dpk">
    <hbox class="w_dpkbar">
      <button class="w_dpknav" on:click={dp_prev}>‹</button>
      <label class="w_dpkm">{ym}</label>
      <button class="w_dpknav" on:click={dp_next}>›</button>
    </hbox>
    <hbox class="w_dpkrow">
      <label class="w_dpkh">{fld(hd, "|", 0)}</label>
      <label class="w_dpkh">{fld(hd, "|", 1)}</label>
      <label class="w_dpkh">{fld(hd, "|", 2)}</label>
      <label class="w_dpkh">{fld(hd, "|", 3)}</label>
      <label class="w_dpkh">{fld(hd, "|", 4)}</label>
      <label class="w_dpkh">{fld(hd, "|", 5)}</label>
      <label class="w_dpkh">{fld(hd, "|", 6)}</label>
    </hbox>
    <each wk in={weeks}>
      <hbox class="w_dpkrow">
        <button class="w_dpkc" on:click={dp0}>{fld(wk, "|", 0)}</button>
        <button class="w_dpkc" on:click={dp1}>{fld(wk, "|", 1)}</button>
        <button class="w_dpkc" on:click={dp2}>{fld(wk, "|", 2)}</button>
        <button class="w_dpkc" on:click={dp3}>{fld(wk, "|", 3)}</button>
        <button class="w_dpkc" on:click={dp4}>{fld(wk, "|", 4)}</button>
        <button class="w_dpkc" on:click={dp5}>{fld(wk, "|", 5)}</button>
        <button class="w_dpkc" on:click={dp6}>{fld(wk, "|", 6)}</button>
      </hbox>
    </each>
  </vbox>
}

// TimePick(GUI-38 时分步进;纯 prop 契约):hh/mm=宿主预格式化两位串;
// tp_step 显参("h+1"/"h-1"/"m+1"/"m-1",宿主回绕钳位),滑杆显参通道同款。
view TimePick (hh: Str, mm: Str) {
  <hbox class="w_tpk">
    <button class="w_tpkb" on:click={tp_step("h-1")}>‹</button>
    <label class="w_tpkt">{hh}</label>
    <button class="w_tpkb" on:click={tp_step("h+1")}>›</button>
    <label class="w_tpkc">:</label>
    <button class="w_tpkb" on:click={tp_step("m-1")}>‹</button>
    <label class="w_tpkt">{mm}</label>
    <button class="w_tpkb" on:click={tp_step("m+1")}>›</button>
  </hbox>
}

// ColorPick(GUI-39 取色器;纯 prop 契约):SV 方=canvas 标记容器(style canvas:1,
// 盒相对画点由宿主 cp_paint 每帧画);色相条=宿主 hues 色表 each 按钮(cp_hue 行);
// hex 输入=组件内 bind 源名通道("hex",宿主包装应答——组件 bind 不改写 nbid 在册);
// 预览 swatch=样式 bg 表达式消费 cur prop(Progress fill 同款);cp_drag 显参=
// dragpx/dragpy 带标 permille("i:NNN"),宿主折算 SV 写回 cur。
view ColorPick (cur: Str, hex: Str, hues: List[Str]) {
  <vbox class="w_cpk">
    <vbox class="w_cpksv" on:draw={cp_paint} on:drag={cp_drag(dragpx, dragpy)}/>
    <hbox class="w_cpkhuer">
      <each h in={hues}>
        <button class="w_cpkh" on:click={cp_hue}>{h}</button>
      </each>
    </hbox>
    <input class="w_cpkhex" bind={hex} on:input={cp_hex} placeholder="#RRGGBB"/>
    <hbox class="w_cpkin">
      <label class="w_cpksw">sw</label>
      <label class="w_cpkcur">{cur}</label>
    </hbox>
  </vbox>
}

// BarChart(GUI-41 条图 v1;纯 prop 契约):vals=条高像素串(宿主归一 max→像素,
// 负值/空安全钳位);bc_paint canvas 画条(各项样式折叠不通 each 迭代变量——
// 立册缝,树内 RECT 形候切片);轴/刻度=宿主 label 组合;条底色显式十六进制。
view BarChart (vals: List[Str]) {
  <vbox class="w_chart">
    <vbox class="w_chartcv" on:draw={bc_paint}/>
  </vbox>
}

// LineChart(GUI-41 折线 v1;纯 prop 契约):pts=千分比 y 串(0-1000,宿主归一);
// canvas 盒相对画点折线(4px 步进,像素槽 4096 帽在册);sparkline=同件窄形。
view LineChart (pts: List[Str]) {
  <vbox class="w_lchart">
    <vbox class="w_lchartcv" on:draw={lt_paint}/>
  </vbox>
}

// ===== 样式预设(snake_case;令牌色随 theme_apply 换装;几何值=陈列室原值) =====
style w_select { direction: column gap: 4 }
style w_trigger { bg: SURFACE fg: TEXT w: 150 h: 34 }
style w_opts { direction: column gap: 2 }
style w_opt { bg: ELEVATED fg: TEXT w: 150 h: 28 }
style w_list { direction: column gap: 2 }
style w_list_t { fg: TEXT_MUTED size: 13 h: 20 }
style w_row { bg: SURFACE fg: TEXT w: 380 h: 28 }
style w_mask { bg: MASK align: center }
style w_card { direction: column gap: 8 padding: 16 bg: ELEVATED w: 260 }
style w_title { fg: TEXT size: 18 h: 28 }
style w_body { fg: TEXT_MUTED size: 13 h: 20 }
style w_actions { direction: row gap: 10 }
style w_act { bg: SURFACE fg: TEXT w: 86 h: 30 }
style w_actp { bg: ACCENT fg: "#ffffff" }
style w_menu { direction: column gap: 4 }
style w_bar { direction: row gap: 12 }
style w_table { direction: column gap: 2 }
style w_thead { direction: row gap: 24 }
style w_th { fg: TEXT_MUTED size: 13 w: 90 h: 22 }
style w_tr { bg: SURFACE w: 200 h: 26 }
style w_trin { direction: row }
style w_td1 { fg: TEXT w: 90 h: 24 }
style w_td2 { fg: TEXT h: 24 }
style w_slider { direction: column gap: 4 }
style w_track { h: 8 w: 220 bg: BORDER }
style w_val { fg: TEXT_MUTED size: 13 h: 20 }
style w_prog { direction: column gap: 4 }
style w_ptk { direction: column w: 200 h: 10 bg: DISABLED_BG }
style w_pfl { direction: column w: "{pct * 2}" h: 10 bg: ACCENT }
style w_pct { fg: TEXT_MUTED size: 13 h: 20 }
style w_tabs { direction: column gap: 4 }
style w_tabrow { direction: row gap: 6 }
style w_tab { bg: SURFACE fg: TEXT w: 130 h: 28 }
style w_tabp { fg: TEXT_MUTED size: 14 h: 24 }
style w_badge { bg: ACCENT fg: "#ffffff" size: 12 w: 52 h: 20 }
style w_acc { direction: column gap: 4 }
style w_acch { bg: SURFACE fg: TEXT w: 150 h: 30 }
style w_accb { fg: TEXT_MUTED size: 13 h: 22 }
style w_tipw { direction: row gap: 8 }
style w_tiptrg { bg: SURFACE fg: TEXT w: 90 h: 28 }
style w_tip { fg: TEXT_MUTED size: 12 h: 20 }
style w_toast { bg: "#00000000" align: center }
style w_toastt { bg: ELEVATED fg: TEXT size: 14 w: 160 h: 36 }
style w_pal { direction: column gap: 6 padding: 12 bg: ELEVATED w: 300 }
style w_palq { bg: SURFACE fg: TEXT w: 276 h: 32 }
style w_palrow { bg: SURFACE fg: TEXT w: 276 h: 28 }
style w_dpk { direction: column gap: 2 }
style w_dpkbar { direction: row gap: 8 }
style w_dpknav { bg: SURFACE fg: TEXT w: 30 h: 26 }
style w_dpkm { fg: TEXT size: 14 w: 110 h: 26 }
style w_dpkrow { direction: row gap: 2 }
style w_dpkh { fg: TEXT_MUTED size: 12 w: 34 h: 20 }
style w_dpkc { bg: SURFACE fg: TEXT w: 38 h: 24 }
style w_tpk { direction: row gap: 4 }
style w_tpkb { bg: SURFACE fg: TEXT w: 28 h: 28 }
style w_tpkt { fg: TEXT size: 16 w: 34 h: 28 }
style w_tpkc { fg: TEXT_MUTED size: 16 w: 12 h: 28 }
style w_cpk { direction: column gap: 8 }
style w_cpksv { direction: column w: 160 h: 120 bg: "#1a1a2e" canvas: 1 }
style w_cpkhuer { direction: row gap: 2 }
style w_cpkh { bg: SURFACE fg: TEXT size: 12 w: 26 h: 22 }
style w_cpkhex { bg: SURFACE fg: TEXT w: 160 h: 30 }
style w_cpkin { direction: row gap: 8 }
style w_cpksw { direction: column w: 40 h: 24 bg: "{cur}" }
style w_cpkcur { fg: TEXT_MUTED size: 13 h: 24 }
style w_chart { direction: column h: 130 }
style w_chartcv { direction: column w: 200 h: 120 bg: "#111827" canvas: 1 }
style w_lchart { direction: column }
style w_lchartcv { direction: column w: 200 h: 80 bg: "#111827" canvas: 1 }
style w_div { h: 2 w: 200 bg: BORDER }
style w_card2 { bg: ELEVATED h: 60 }
style w_ct { fg: TEXT size: 13 h: 20 }
