// tui_widgets.ct —— W4 组件库(§14;input 一期:真 LED 光标全链)
// 形态:pkgs/tui 域内子文件(§14 的 pkgs/tui_widgets 拆分 = 二期;门面 re-export 已通)。
// input:props value/cur(字素下标)/focused;结构 = box(cls focused?accent:muted)
// + [text 前段, cursor 标记(cls=cursor;渲染期收格位), text 后段]。
// 光标请求全链(§13):paint 期 marks.push 格位 → render 解析 cx/cy →
// driver 帧尾 \e[y;xH 定位;失焦/无标记 = 无请求即隐。

fn cp_off(s: Str, n: I32) -> I32 {
    // 字素(码点)下标 → 字节偏移(UTF-8 续字节跟随首字节;区间判定 = unicode.ct 惯例)
    var i: I32 = 0
    var k: I32 = 0
    while i < s.len && k < n {
        i += 1
        while i < s.len && byte_at(s, i) >= 128 && byte_at(s, i) < 192 {
            i += 1
        }
        k += 1
    }
    return i
}

pub fn input(aid: Str, value: Str, cur: I32, focused: Bool) -> TuiTree {
    let off = cp_off(value, cur)
    let before = text(byte_slice(value, 0, off))
    let after = text(byte_slice(value, off, value.len))
    // 光标标记:空 text + cls=cursor(paint 期收 r.x/r.y;占位零宽)
    let cm = with_cls(text(""), "cursor")
    let kids = List[TuiTree]()
    kids.push(before)
    kids.push(cm)
    kids.push(after)
    let row = hbox(kids)
    let bcls = "muted"
    if focused {
        bcls = "accent"
    }
    let b = box(w_kids1(row), bcls)
    return with_id(b, aid)
}

fn w_kids1(a: TuiTree) -> List[TuiTree] {
    var l = List[TuiTree]()
    l.push(a)
    return l
}

// P3/W4 批2:dialog 居中 overlay 层(§14/§16)——overlay 全帧矩形内
// double 盒居中(w = 给定;h = lines+4:边框2+标题1+内容1... opts 行另计)。
// 键面(应用转接,§14):←/→/Tab 换钮、Enter 确认、Esc 取消;focus = 选中
// 钮下标(accent 高亮)。mask 暗化 = §16 在册债(不做)。
pub fn dialog_layer(title: Str, lines: List[Str], opts: List[Str], focus: I32, w: I32) -> TuiTree {
    var kids = List[TuiTree]()
    kids.push(text(title))
    var li: I32 = 0
    while li < lines.len {
        kids.push(text(lines[li]))
        li += 1
    }
    var okids = List[TuiTree]()
    var oi: I32 = 0
    while oi < opts.len {
        var ocls = ""
        if oi == focus {
            ocls = "accent"
        }
        okids.push(with_cls(text(opts[oi]), ocls))
        if oi + 1 < opts.len {
            okids.push(text("  "))
        }
        oi += 1
    }
    kids.push(hbox(okids))
    let inner = vbox(kids)
    let b = box(w_kids1(inner), "double")
    let bw = with_w(b, w)
    let bh = with_h(bw, lines.len + 4)
    return overlay(w_kids1(bh))
}
