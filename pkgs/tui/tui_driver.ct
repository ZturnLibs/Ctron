// tui_driver.ct —— run_app 主循环 + test headless 驱动 + d_* 断言族(设计 §8/§9)
// 铁律 §8:任何退出路径必还原(enter/leave C 侧 atexit 兜底;panic 消息重放 = stderr
// 全缓冲,leave 还原终端后冲刷,§18)。事件驱动重画 §19:无事件不重画(tick 除外)。
// 形状纪律:struct 值整体重赋值发射坏 C(W3b 坑 ②)——front 缓冲走 Box[TuiBuf] 槽写。
// 模型按值传(2026-10-18 定案):发射臂 Box 链式写面(v.field=x/v.list.push 整族)在册缺口
// ——模型标量一律 List 槽(引用语义过值拷贝,42z 形态);MUV 纯度不受影响。
use tui.tui_event.{Event, poll_ev, ev_none, ev_key, ev_char, ev_mouse, ev_resize, ev_act, ev_tick, k_up}

fn frame_buf(tree: TuiTree, w: I32, h: I32, th: Theme) -> TuiBuf {
    // Err(E 码)= 应用静态布局 bug(裁决 1)→ panic 坐标诊断
    let r = render(tree, w, h, th)
    var emsg = ""
    match r {
        Err(m) => {
            emsg = m
        }
        Ok(_) => {
        }
    }
    if emsg.len != 0 {
        panic("tui: 布局错误: " + emsg)
    }
    return r.expect("buf")
}

// 小终端降级屏(§18:w<20 或 h<6 = 单行提示,不崩不乱画)
fn mini_frame(w: I32, h: I32) -> TuiBuf {
    var b = buf_new(w, h)
    buf_put_wide(b, 0, 0, "终", 0 - 1, 0 - 1)
    buf_put_wide(b, 2, 0, "端", 0 - 1, 0 - 1)
    buf_put_wide(b, 4, 0, "太", 0 - 1, 0 - 1)
    buf_put_wide(b, 6, 0, "小", 0 - 1, 0 - 1)
    return b
}

fn frame_out(front: TuiBuf, tree: TuiTree, w: I32, h: I32, th: Theme) -> TuiBuf {
    var b2 = buf_new(0, 0)
    if w < 20 {
        b2 = mini_frame(w, h)
    } else {
        if h < 6 {
            b2 = mini_frame(w, h)
        } else {
            b2 = frame_buf(tree, w, h, th)
        }
    }
    out(buf_diff(front, b2))
    // P3/§13:帧尾光标定位(请求在 = \e[y+1;x+1H;无请求不动,终端态保持)
    if b2.cx >= 0 {
        if b2.cy >= 0 {
            out("\u{1b}[" + (b2.cy + 1).to_string() + ";" + (b2.cx + 1).to_string() + "H")
        }
    }
    return b2
}

// P3/§13:headless 光标断言面(tt.v.buf.cx;−1 = 无请求)
pub fn d_cursor_x[M](tt: Box[TuiTest[M]]) -> I32 {
    return tt.v.buf.cx
}

pub fn d_cursor_y[M](tt: Box[TuiTest[M]]) -> I32 {
    return tt.v.buf.cy
}

// 主循环(§8 生命周期;§18 退出协议:tui.quit → rc)
pub fn run_app[M](view: fn(M) -> TuiTree, update: fn(M, Event), m: M, theme: Theme) -> I32 {
    enter()
    var front: TuiBuf = buf_new(0, 0)
    var w = term_w()
    var h = term_h()
    front = frame_out(front, view(m), w, h, theme)
    while quit_requested() == false {
        var waitms: I32 = 500
        if tui_tick_get() > 0 {
            waitms = tui_tick_get().as[I32]()
        }
        var ev = poll_ev(waitms)
        var got: Bool = false
        while ev.kind != ev_none() {
            if ev.kind == ev_resize() {
                w = ev.w
                h = ev.h
            }
            update(m, ev)
            got = true
            ev = poll_ev(0)
        }
        if resized_take() {
            w = term_w()
            h = term_h()
            var re = Event { kind: ev_resize(), code: 0, ch: 0, shift: false, ctrl: false, alt: false, mx: 0, my: 0, w: w, h: h, name: "", args: List[Str]() }
            update(m, re)
            got = true
        }
        if got == false {
            if tui_tick_get() > 0 {
                var te = Event { kind: ev_tick(), code: 0, ch: 0, shift: false, ctrl: false, alt: false, mx: 0, my: 0, w: 0, h: 0, name: "", args: List[Str]() }
                update(m, te)
                got = true
            }
        }
        if got {
            front = frame_out(front, view(m), w, h, theme)
        }
    }
    leave()
    return 0
}

// ---- headless 测试驱动(§9;批C-3A 回填,批C 关闭 2026-10-22)----
// 回填史:批C 立案(合并名槽泄漏 E5030)→ 三勘(①E5030 自愈 ②发射面 B: 码丢
// 实例实参+推断无 Box 分支已修(批C-2 W1–W3) ③闭包形参无签型→批C-3A)。
// 设计定案:TuiTest[M] 仅持数据(buf/frames/w/h/m);view/update/th 走 d_* 显式
// 形参——fn 字段调用返回 struct 过 ct_clop 面无装箱(编组白名单=标量族限,在册)
// 的绕行,直接调用走 fn 形参盒化既有通装(test__u_Model 实证解盒正确)。----

pub struct TuiTest[M] {
    var buf: TuiBuf
    var frames: I32
    var w: I32
    var h: I32
    var m: M
}

pub fn test[M](view: fn(M) -> TuiTree, update: fn(M, Event), m: M, theme: Theme, w: I32, h: I32,
               script: fn(Box[TuiTest[M]]) -> Void) -> I32 {
    let b0 = frame_buf(view(m), w, h, theme)
    var tt = Box[TuiTest[M]](TuiTest { buf: b0, frames: 1, w: w, h: h, m: m })
    script(tt)
    return 0
}

fn tt_frame[M](tt: Box[TuiTest[M]], view: fn(M) -> TuiTree, m: M, th: Theme) {
    tt.v.buf = frame_buf(view(m), tt.v.w, tt.v.h, th)
    tt.v.frames += 1
}

fn d_send[M](tt: Box[TuiTest[M]], view: fn(M) -> TuiTree, update: fn(M, Event), m: M, th: Theme, e: Event) {
    update(m, e)
    tt_frame[M](tt, view, m, th)
}

pub fn d_key[M](tt: Box[TuiTest[M]], view: fn(M) -> TuiTree, update: fn(M, Event), m: M, th: Theme, code: I32) {
    var e = Event { kind: ev_key(), code: code, ch: 0, shift: false, ctrl: false, alt: false, mx: 0, my: 0, w: 0, h: 0, name: "", args: List[Str]() }
    d_send[M](tt, view, update, m, th, e)
}

pub fn d_frame[M](tt: Box[TuiTest[M]]) -> I32 {
    return tt.v.frames
}

pub fn d_expect_text[M](tt: Box[TuiTest[M]], x: I32, y: I32, n: I32, s: Str) {
    var seg = ""
    var i: I32 = 0
    while i < n {
        seg = seg + buf_at(tt.v.buf, x + i, y)
        i += 1
    }
    if seg != s {
        panic("tui d_expect_text: (" + x.to_string() + "," + y.to_string() + ") 期望 [" + s + "] 实得 [" + seg + "]")
    }
}
