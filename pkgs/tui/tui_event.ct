// tui_event.ct —— 事件常量(fn 出面,跨文件 const 双坑规避 §3.3)+ C 解码产物 → Event 映射
// 一期事件建模 = I32 码(裁决 3:enum+match 批落库整体换装);修饰键具名拆槽(裁决 2)。

// 事件种类
pub fn ev_none() -> I32 {
    return 0
}

pub fn ev_key() -> I32 {
    return 1
}

pub fn ev_char() -> I32 {
    return 2
}

pub fn ev_mouse() -> I32 {
    return 3
}

pub fn ev_resize() -> I32 {
    return 4
}

pub fn ev_act() -> I32 {
    return 5
}

pub fn ev_tick() -> I32 {
    return 6
}

