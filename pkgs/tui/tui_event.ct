// C 解码产物 → Event(一轮一枚;kind 0 = 无事件)
pub fn poll_ev(ms: I32) -> Event {
    var e = Event { kind: ev_none(), code: 0, ch: 0, shift: false, ctrl: false, alt: false, mx: 0, my: 0, w: 0, h: 0, name: "", args: List[Str]() }
    let r = tui_poll(ms.as[I64]())
    if r != 1 {
        return e
    }
    e.kind = tui_ev_kind().as[I32]()
    e.code = tui_ev_code().as[I32]()
    e.ch = tui_ev_ch().as[I32]()
    if tui_ev_shift() == 1 {
        e.shift = true
    }
    if tui_ev_ctrl() == 1 {
        e.ctrl = true
    }
    if tui_ev_alt() == 1 {
        e.alt = true
    }
    e.mx = tui_ev_mx().as[I32]()
    e.my = tui_ev_my().as[I32]()
    return e
}
