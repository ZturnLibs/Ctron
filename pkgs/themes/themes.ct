// themes/themes.ct —— 主题包(GUI-31:主题作为可导入包的分发形态)
//
// 形态裁决(2026-10-04,F 档):主题 = 包,不进引擎。内置 theme_dark/light/mac_*/
// win_*/linux_* 族(平台×明暗缺省,gui.ct)保持最小核;品味主题经本包分发——
// 每主题一枚 pub fn 构造全套 gui.Theme(25 字段),应用 use 后一步换装:
//
//   use gui.{theme_apply}
//   use themes.{nord, dracula}
//   ...
//   theme_apply(nord())
//
// 令牌契约(§3.4):色 14 字段 #RRGGBB;尺寸 11 字段 I32 逻辑像素。尺寸全部
// 对齐缺省(theme_default)——主题差异在色板;radius/size/space 个性化另册。
// 新主题入包守则:全套 25 字段一个不少;色值取上游官方基色,无上游杜撰的
// 槽(border_strong/mask 等)按明度梯度就近推导并注释来源。

use gui.{ Theme }

// ---- Nord(polar night;上游 nordtheme.com)----

pub fn nord() -> Theme {
    return Theme {
        bg_base: "#2E3440"
        surface: "#3B4252"
        elevated: "#434C5E"
        border: "#4C566A"
        border_strong: "#616E88"
        text: "#ECEFF4"
        text_muted: "#7B88A1"
        accent: "#88C0D0"
        accent_hover: "#8FBCBB"
        danger: "#BF616A"
        success: "#A3BE8C"
        mask: "#242933"
        disabled_fg: "#6f7d95"
        disabled_bg: "#3B4252"
        radius_sm: 4
        radius_md: 8
        radius_lg: 12
        size_xs: 12
        size_sm: 14
        size_md: 16
        size_lg: 20
        size_xl: 24
        space_sm: 4
        space_md: 8
        space_lg: 16
    }
}

// ---- Nord Snow Storm(浅色;snow storm 三色作面 + frost 作强调)----

