// gui/parse.ct —— mini-CTML 解析器(canonical 版,GUI 泳道 S5/S6 交付)
// 语法面:view + vbox/hbox + label/button + class + on:事件 + 叶子文本(前缀 + 至多一个
//   {ident} 绑定 + 后缀)+ style(direction/gap/padding/bg);颜色 #RRGGBB;限深 1。
// 契约(并行表,调用方持有):tags/cls/pre/bid/post 按 root=0、子元素自 1 对齐;
//   事件表 ev_el/ev_name/ev_fn。游标 = Atomic[I32]。
// 注:夹具(tests/gui/s*)当前各自内嵌快照;包级 use 集成随 P2-B 落地后切换。
// trim 规则:{ 前尾随空格是语义字符(有绑定只去左空白);无绑定双边去。
// ==================== 迷你词法(承 S5) ====================

fn ws(src: Str, cur: Atomic[I32]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        var b: I32 = byte_at(src, cur.load())
        if b == 32 {
            cur.store(cur.load() + 1)
        } else {
            if b == 10 {
                cur.store(cur.load() + 1)
            } else {
                if b == 13 {
                    cur.store(cur.load() + 1)
                } else {
                    if b == 9 {
                        cur.store(cur.load() + 1)
                    } else {
                        return 0
                    }
                }
            }
        }
    }
    return 0
}

fn word(src: Str, cur: Atomic[I32]) -> Str {
    ws(src, cur)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        var al: Bool = b >= 65 && b <= 90
        var low: Bool = b >= 97 && b <= 122
        var dg: Bool = b >= 48 && b <= 57
        if al {
            i += 1
        } else {
            if low {
                i += 1
            } else {
                if b == 95 {
                    i += 1
                } else {
                    if b == 45 {
                        i += 1
                    } else {
                        if dg {
                            i += 1
                        } else {
                            break
                        }
                    }
                }
            }
        }
    }
    cur.store(i)
    if i > start {
        return byte_slice(src, start, i)
    }
    panic("s6: 期待标识符 @byte " + cur.load().to_string())
    return ""
}

fn lit(src: Str, cur: Atomic[I32], c: I32) -> I32 {
    ws(src, cur)
    if byte_at(src, cur.load()) != c {
        panic("s6: 期待字符码 " + c.to_string() + " @byte " + cur.load().to_string())
    }
    cur.store(cur.load() + 1)
    return 0
}

fn str_lit(src: Str, cur: Atomic[I32]) -> Str {
    lit(src, cur, 34)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == 34 {
            break
        }
        i += 1
    }
    cur.store(i + 1)
    return byte_slice(src, start, i)
}

// 到 stop 字节为止(右开),首尾去空白;游标停在 stop
fn span_until(src: Str, cur: Atomic[I32], stop: I32) -> Str {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == stop {
            break
        }
        i += 1
    }
    var e: I32 = i
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    while e > start {
        var c1: I32 = byte_at(src, e - 1)
        if c1 == 32 {
            e -= 1
        } else {
            if c1 == 10 {
                e -= 1
            } else {
                if c1 == 9 {
                    e -= 1
                } else {
                    break
                }
            }
        }
    }
    cur.store(i)
    if e > start {
        return byte_slice(src, start, e)
    }
    return ""
}

// ==================== 颜色 ====================

fn hex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("s6: 非法十六进制")
    return 0
}

fn parse_color(v: Str) -> I32 {
    if byte_at(v, 0) == 35 {
        if v.len != 7 {
            panic("s6: 颜色须 #RRGGBB,得 " + v)
        }
        var r: I32 = hex1(byte_at(v, 1)) * 16 + hex1(byte_at(v, 2))
        var g: I32 = hex1(byte_at(v, 3)) * 16 + hex1(byte_at(v, 4))
        var b: I32 = hex1(byte_at(v, 5)) * 16 + hex1(byte_at(v, 6))
        return r * 65536 + g * 256 + b
    }
    panic("s6: 未知令牌 " + v)
    return 0
}

fn s2i(s: Str) -> I32 {
    var v: I32 = 0
    var i: I32 = 0
    while i < s.len {
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    }
    return v
}

// ==================== 解析(承 S5 + 绑定/事件) ====================

// 属性:class="..." 与 on:名={handler};返回 class 值
fn attrs(src: Str, cur: Atomic[I32], el: I32, ev_el: List[I32],
         ev_name: List[Str], ev_fn: List[Str]) -> Str {
    var out: Str = ""
    while true {
        ws(src, cur)
        if byte_at(src, cur.load()) == 62 {
            break
        }
        var an: Str = word(src, cur)
        if an == "on" {
            lit(src, cur, 58)
            var evn: Str = word(src, cur)
            lit(src, cur, 61)
            lit(src, cur, 123)
            var fnn: Str = word(src, cur)
            lit(src, cur, 125)
            ev_el.push(el)
            ev_name.push(evn)
            ev_fn.push(fnn)
        } else {
            lit(src, cur, 61)
            var av: Str = str_lit(src, cur)
            if an == "class" {
                out = av
            }
        }
    }
    return out
}

// 叶子文本:前缀字面量 + 至多一个 {ident} + 后缀字面量
// 前缀扫描双停止:'{'(进入绑定)或 '<'(无绑定);勿单停 '{'(会吞闭合标签,踩过)
fn leaf_text(src: Str, cur: Atomic[I32], pre: List[Str], bid: List[Str],
             post: List[Str]) -> I32 {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 123 {
            break
        }
        if b == 60 {
            break
        }
        i += 1
    }
    var e: I32 = i
    var has_bind: Bool = false
    if i < n {
        if byte_at(src, i) == 123 {
            has_bind = true
        }
    }
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    if !has_bind {
        while e > start {
            var c1: I32 = byte_at(src, e - 1)
            if c1 == 32 {
                e -= 1
            } else {
                if c1 == 10 {
                    e -= 1
                } else {
                    if c1 == 9 {
                        e -= 1
                    } else {
                        break
                    }
                }
            }
        }
    }
    var p0: Str = ""
    if e > start {
        p0 = byte_slice(src, start, e)
    }
    cur.store(i)
    var b: Str = ""
    var p1: Str = ""
    if has_bind {
        cur.store(cur.load() + 1)
        b = word(src, cur)
        lit(src, cur, 125)
        p1 = span_until(src, cur, 60)
    }
    pre.push(p0)
    bid.push(b)
    post.push(p1)
    return 0
}

fn parse_leaf(src: Str, cur: Atomic[I32], el: I32, tags: List[Str], cls: List[Str],
              pre: List[Str], bid: List[Str], post: List[Str],
              ev_el: List[I32], ev_name: List[Str], ev_fn: List[Str]) -> I32 {
    lit(src, cur, 60)
    var tag: Str = word(src, cur)
    if tag != "label" {
        if tag != "button" {
            panic("s6: 子元素仅 label/button,得 " + tag)
        }
    }
    var c: Str = attrs(src, cur, el, ev_el, ev_name, ev_fn)
    lit(src, cur, 62)
    if byte_at(src, cur.load()) == 60 {
        if byte_at(src, cur.load() + 1) != 47 {
            panic("s6: 限深 1")
        }
    }
    leaf_text(src, cur, pre, bid, post)
    lit(src, cur, 60)
    lit(src, cur, 47)
    var et: Str = word(src, cur)
    if et != tag {
        panic("s6: 闭合标签不匹配 " + et)
    }
    lit(src, cur, 62)
    println("  el " + tag + " cls=" + c)
    tags.push(tag)
    cls.push(c)
    return 0
}

fn parse_view(src: Str, cur: Atomic[I32], tags: List[Str], cls: List[Str],
              pre: List[Str], bid: List[Str], post: List[Str],
              ev_el: List[I32], ev_name: List[Str], ev_fn: List[Str]) -> I32 {
    var name: Str = word(src, cur)
    println("view " + name)
    ws(src, cur)
    lit(src, cur, 123)
    ws(src, cur)
    lit(src, cur, 60)
    var tag: Str = word(src, cur)
    if tag != "vbox" {
        if tag != "hbox" {
            panic("s6: 根容器仅 vbox/hbox,得 " + tag)
        }
    }
    var rootcls: Str = attrs(src, cur, 0, ev_el, ev_name, ev_fn)
    lit(src, cur, 62)
    println("  root " + tag + " cls=" + rootcls)
    tags.push(tag)
    cls.push(rootcls)
    pre.push("")
    bid.push("")
    post.push("")
    var el: I32 = 1
    while true {
        ws(src, cur)
        if byte_at(src, cur.load()) == 60 {
            if byte_at(src, cur.load() + 1) == 47 {
                break
            }
        }
        parse_leaf(src, cur, el, tags, cls, pre, bid, post, ev_el, ev_name, ev_fn)
        el += 1
    }
    lit(src, cur, 60)
    lit(src, cur, 47)
    var et: Str = word(src, cur)
    lit(src, cur, 62)
    ws(src, cur)
    lit(src, cur, 125)
    return 0
}

fn parse_style(src: Str, cur: Atomic[I32], sk: List[Str], sv: List[Str]) -> I32 {
    var name: Str = word(src, cur)
    var line: Str = "style " + name
    ws(src, cur)
    lit(src, cur, 123)
    while true {
        ws(src, cur)
        if byte_at(src, cur.load()) == 125 {
            break
        }
        var p: Str = word(src, cur)
        lit(src, cur, 58)
        ws(src, cur)
        var v: Str = ""
        if byte_at(src, cur.load()) == 34 {
            v = str_lit(src, cur)
        } else {
            v = word(src, cur)
        }
        if p == "bg" {
            var packed: I32 = parse_color(v)
            if packed < 0 {
                panic("s6: 颜色解析失败")
            }
        }
        line = line + " " + p + "=" + v
        sk.push(name + "." + p)
        sv.push(v)
        ws(src, cur)
        if byte_at(src, cur.load()) == 59 {
            lit(src, cur, 59)
        }
    }
    lit(src, cur, 125)
    println(line)
    return 0
}

fn parse_all(src: Str, cur: Atomic[I32], tags: List[Str], cls: List[Str],
             pre: List[Str], bid: List[Str], post: List[Str],
             ev_el: List[I32], ev_name: List[Str], ev_fn: List[Str],
             sk: List[Str], sv: List[Str]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        ws(src, cur)
        if cur.load() >= n {
            break
        }
        var w: Str = word(src, cur)
        if w == "view" {
            parse_view(src, cur, tags, cls, pre, bid, post, ev_el, ev_name, ev_fn)
        } else {
            if w == "style" {
                parse_style(src, cur, sk, sv)
            } else {
                panic("s6: 顶层仅 view/style,得 " + w)
            }
        }
    }
    return 0
}

fn style_get(sk: List[Str], sv: List[Str], key: Str, dflt: Str) -> Str {
    var i: I32 = 0
    while i < sk.len {
        if sk[i] == key {
            return sv[i]
        }
        i += 1
    }
    return dflt
}

