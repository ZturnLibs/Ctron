// gui_driver.ct —— gui 域包·驱动面(gui.ct 拆分阶段二⑤;2026-09-27 拆分规划)
//
// 内容:rt_window_loop 双循环(真窗+headless d 循环)+ rt_nokey 缺省键 + 入口
// 装配(rt_run/rt_run_kb/rt_run_d/rt_run_kb_d/rt_run_src/rt_run_kb_src/
// rt_run_anchor)+ 入口与测试驱动(test/test_sk/Driver/d_* 全族)+ 输入辅助
// (char_str/热重载探针/杂项)+ GUI-15 on:after 定时事件。
// 无 use 行:扁平视图名字解析全局;消费=门面 use gui.gui_driver.{test, d_frame,
// d_click, rt_run_kb_src}(锚例;其余 pub 符号照旧经 gui.{...} 请求)。

fn rt_nokey(k: I32) -> Void {
}

fn rt_window_loop(t: GuiTree, title: Str, w: I32, h: I32,
                  bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void,
                  key: fn(I32) -> Void, has_key: Bool) -> I32 {
    var rects = List[I32]()
    var hits = List[I32]()
    var hinst = List[I32]()
    gui_clay_init(w, h)
    var hov: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
    var dn: I32 = gui_mouse_down()
    var n: I32 = rt_draw_frame(t, bind, w, h, hits, hinst, hov, dn)
    rt_collect_rects(n, rects)
    gui_ime_feed_caret(rects, hits)
    rt_scroll_req_apply(t, rects, hits)
    rt_after_pump(t, bind, act)
    rt_feed_input_w(t, rects, hits)
    gui_autofocus_first_input(t, bind)
    SetConfigFlags(8192)
    InitWindow(w, h, title)
    SetTargetFPS(60)
    while rt_close_check(t, bind, act) == 1 {
        rt_drag_sel(t, rects, hits, bind)
        rt_thumb_drag(t, rects, hits, bind)
        rt_dgev_frame(t, bind, act)
        var evt: I32 = gui_poll_event()
        if evt == 2 {
            if rt_menu_click(t, bind, act) == 1 {
                evt = 0
            }
        }
        if evt == 2 {
            // 拖拽事件缝武装:命中带 on:drag 的元素(盒几何入 C;首发一次=
            // 点击即设值;移动逐帧由 rt_dgev_frame 触发)
            var dgn7: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
            if dgn7 >= 0 {
                if dgn7 < t.ntag.len {
                    var dde7: Str = rt_in_expr(t, dgn7, "drag")
                    if dde7 != "" {
                        var dbi7: I32 = rt_node_box(rects, hits, dgn7)
                        if dbi7 >= 0 {
                            gui_dgev_begin(gui_cmd_x100(dbi7) / 100, gui_cmd_y100(dbi7) / 100, gui_cmd_w100(dbi7) / 100, gui_cmd_h100(dbi7) / 100)
                            gui_dgev_setnode(dgn7)
                            ev_fire(t, dde7, bind, act)
                        }
                    }
                }
            }
        }
        if evt == 5 {
            rt_ctx_open_at(t, rects, hits)
        }
        if evt == 6 {
            rt_drop_fire(t, bind, act)
        }
        if evt == 2 {
            var name: Str = rt_hit_name(t, hits, hinst, rects, gui_evt_x(), gui_evt_y())
            // 波次二:click-to-focus——命中 input 聚焦(光标置尾),命中其它失焦
            var fnode: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
            if fnode >= 0 {
                var ised: Bool = false
                if t.ntag[fnode] == "input" {
                    ised = true
                }
                if t.ntag[fnode] == "textarea" {
                    ised = true
                }
                if ised {
                    rt_click_text(t, fnode, bind, rects, hits)
                } else {
                    gui_focus_set(-1)
                }
            } else {
                gui_focus_set(-1)
            }
            if name != "" {
                // S2:on:dblclick——双击命中带 dblclick 事件的元素=只发 dblclick
                // (不发 click;单双击聚类 gui_click_kind,编辑件已在 rt_click_text 消费)
                var kdn: I32 = gui_click_kind(gui_evt_x(), gui_evt_y())
                var fired2: I32 = 0
                if kdn == 1 {
                    var dn7: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
                    if dn7 >= 0 {
                        if dn7 < t.ntag.len {
                            var de7: Str = rt_in_handler(t, dn7, "dblclick")
                            if de7 != "" {
                                ev_fire(t, de7, bind, act)
                                fired2 = 1
                            }
                        }
                    }
                }
                if fired2 == 0 {
                    // SL-8c-3:事件表达式触发面(单标识符旧契约直发,调用形态按头分发)
                    ev_fire(t, name, bind, act)
                }
            }
        } else {
            if evt == 4 {
                // GUI-21:textarea 未消费的滚轮进 scroll 偏移(步长应用侧换算)
                if rt_ta_wheel(t, rects, hits, gui_evt_key(), bind) == 0 {
                    gui_scroll_add(gui_evt_key() * 66)
                }
            }
            if evt == 3 {
                // 波次二:焦点 input 消费字符(编辑管线),未聚焦原样弃置(旧口径)
                var ic: Bool = rt_input_char(t, bind, act, gui_evt_key())
                if !ic {
                    if has_key {
                        key(gui_evt_key())
                    }
                }
            } else {
                if evt == 1 {
                    // 波次二:焦点 input 编辑键优先(消费边界=不进 key 闭包,s33 锁)
                    var ik: Bool = rt_input_key(t, bind, act, gui_evt_key())
                    if !ik {
                        // 波次三:键盘模态——末帧有 overlay:Esc 转其 on:click(自锁
                        // 修复=Esc 永可达),余键吞,键闭包挂起
                        var ov: I32 = rt_top_overlay(t, hits)
                        if ov >= 0 {
                            if gui_evt_key() == 256 {
                                var oh: Str = rt_in_handler(t, ov, "click")
                                if oh != "" {
                                    act(oh, List[Str]())
                                }
                            }
                        } else {
                            // P2:Tab 焦点环(导航位,先于快捷键表;Shift 反向)
                            if gui_evt_key() == 258 {
                                var md: I32 = gui_hotkey_mods()
                                var sh: I32 = md / 2
                                var sh2: I32 = sh / 2
                                var rev: I32 = 0
                                if sh - sh2 * 2 == 1 {
                                    rev = 1
                                }
                                var nf: I32 = rt_focus_next(t, gui_focus_node(), rev)
                                gui_focus_set(nf)
                                if nf >= 0 {
                                    var fbv2: Str = rt_in_val(t, nf, bind)
                                    gui_caret_set(fbv2.len)
                                } else {
                                    gui_caret_set(0)
                                }
                            } else {
                                // 波次五b:快捷键表(§2.11 路由链第三位;未中回落 key 闭包)
                                var hk: I32 = gui_hotkey_match(gui_evt_key(), gui_hotkey_mods())
                                if hk >= 0 {
                                    var han: Str = ""
                                    var hi: I32 = 0
                                    while hi < hk {
                                        han = han + utf8_enc(gui_hotkey_action_byte(hi))
                                        hi += 1
                                    }
                                    act(han, List[Str]())
                                } else {
                                    if has_key {
                                        key(gui_evt_key())
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var hv2: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
        gui_cursor_set(rt_cursor_for(t, hv2))
        var nfr: I32 = rt_draw_frame(t, bind, w, h, hits, hinst, hv2, gui_mouse_down())
        rects = List[I32]()
        rt_collect_rects(nfr, rects)
        gui_ime_feed_caret(rects, hits)
        rt_scroll_req_apply(t, rects, hits)
        rt_after_pump(t, bind, act)
        BeginDrawing()
        gui_clear(27, 27, 29)
        ctron_gui_flush()
        // GUI-25 真窗直绘:canvas fire 在 flush 之后——帧头 fire 被 clear 抹除、
        // flush 前 fire 被盒背景矩形覆盖(手验 1003 双层实证);UI 之上画点=z 序本义
        gui_px_clear()
        rt_canvas_frame(t, rects, hits, bind, act)
        EndDrawing()
    }
    CloseWindow()
    return 0
}

// 带热重载的循环(R2/W4-E3 收编):每 60 帧比对 CTML 内容,变更即原址重解析
// (骨架/几何刷新,rects 重收集;用户闭包与状态不动)
fn rt_window_loop_d(t: GuiTree, src: Str, reload: Str, title: Str, w: I32, h: I32,
                    bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void,
                    key: fn(I32) -> Void, has_key: Bool) -> I32 {
    var rects = List[I32]()
    var hits = List[I32]()
    var hinst = List[I32]()
    gui_clay_init(w, h)
    var hov: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
    var dn: I32 = gui_mouse_down()
    var n: I32 = rt_draw_frame(t, bind, w, h, hits, hinst, hov, dn)
    rt_collect_rects(n, rects)
    gui_ime_feed_caret(rects, hits)
    rt_scroll_req_apply(t, rects, hits)
    rt_after_pump(t, bind, act)
    rt_feed_input_w(t, rects, hits)
    gui_autofocus_first_input(t, bind)
    SetConfigFlags(8192)
    InitWindow(w, h, title)
    SetTargetFPS(60)
    var frames: I32 = 0
    while rt_close_check(t, bind, act) == 1 {
        rt_drag_sel(t, rects, hits, bind)
        rt_thumb_drag(t, rects, hits, bind)
        rt_dgev_frame(t, bind, act)
        frames += 1
        if frames >= 60 {
            frames = 0
            // GUI-27:探针走锚合并源(无 use 行 = read_file 字节恒等;导入族
            // 变更(components.ctml 等)同帧可见)
            var src2: Str = gt_anchor_src(reload)
            // 空源守卫(SL-7α):文件缺失(内嵌兜底形态/运行中被删)不重解析——
            // 此前 src2="" != src 会 gt_parse("") 清空 UI
            if src2 != "" {
                if src2 != src {
                    var t2: GuiTree = gt_parse(src2)
                    t = t2
                    src = src2
                    hits = List[I32]()
                    hinst = List[I32]()
                    var hv3: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
                    gui_cursor_set(rt_cursor_for(t, hv3))
                    n = rt_draw_frame(t, bind, w, h, hits, hinst, hv3, gui_mouse_down())
                    rects = List[I32]()
                    rt_collect_rects(n, rects)
                    gui_ime_feed_caret(rects, hits)
                    rt_scroll_req_apply(t, rects, hits)
                    rt_after_pump(t, bind, act)
                    rt_feed_input_w(t, rects, hits)
                }
            }
        }
        var evt: I32 = gui_poll_event()
        if evt == 2 {
            if rt_menu_click(t, bind, act) == 1 {
                evt = 0
            }
        }
        if evt == 2 {
            // 拖拽事件缝武装:命中带 on:drag 的元素(盒几何入 C;首发一次=
            // 点击即设值;移动逐帧由 rt_dgev_frame 触发)
            var dgn7: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
            if dgn7 >= 0 {
                if dgn7 < t.ntag.len {
                    var dde7: Str = rt_in_expr(t, dgn7, "drag")
                    if dde7 != "" {
                        var dbi7: I32 = rt_node_box(rects, hits, dgn7)
                        if dbi7 >= 0 {
                            gui_dgev_begin(gui_cmd_x100(dbi7) / 100, gui_cmd_y100(dbi7) / 100, gui_cmd_w100(dbi7) / 100, gui_cmd_h100(dbi7) / 100)
                            gui_dgev_setnode(dgn7)
                            ev_fire(t, dde7, bind, act)
                        }
                    }
                }
            }
        }
        if evt == 5 {
            rt_ctx_open_at(t, rects, hits)
        }
        if evt == 6 {
            rt_drop_fire(t, bind, act)
        }
        if evt == 2 {
            var name: Str = rt_hit_name(t, hits, hinst, rects, gui_evt_x(), gui_evt_y())
            // 波次二:click-to-focus——命中 input 聚焦(光标置尾),命中其它失焦
            var fnode: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
            if fnode >= 0 {
                var ised: Bool = false
                if t.ntag[fnode] == "input" {
                    ised = true
                }
                if t.ntag[fnode] == "textarea" {
                    ised = true
                }
                if ised {
                    rt_click_text(t, fnode, bind, rects, hits)
                } else {
                    gui_focus_set(-1)
                }
            } else {
                gui_focus_set(-1)
            }
            if name != "" {
                // S2:on:dblclick——双击命中带 dblclick 事件的元素=只发 dblclick
                // (不发 click;单双击聚类 gui_click_kind,编辑件已在 rt_click_text 消费)
                var kdn: I32 = gui_click_kind(gui_evt_x(), gui_evt_y())
                var fired2: I32 = 0
                if kdn == 1 {
                    var dn7: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
                    if dn7 >= 0 {
                        if dn7 < t.ntag.len {
                            var de7: Str = rt_in_handler(t, dn7, "dblclick")
                            if de7 != "" {
                                ev_fire(t, de7, bind, act)
                                fired2 = 1
                            }
                        }
                    }
                }
                if fired2 == 0 {
                    // SL-8c-3:事件表达式触发面(单标识符旧契约直发,调用形态按头分发)
                    ev_fire(t, name, bind, act)
                }
            }
        } else {
            if evt == 4 {
                // GUI-21:textarea 未消费的滚轮进 scroll 偏移(步长应用侧换算)
                if rt_ta_wheel(t, rects, hits, gui_evt_key(), bind) == 0 {
                    gui_scroll_add(gui_evt_key() * 66)
                }
            }
            if evt == 3 {
                // 波次二:焦点 input 消费字符(编辑管线),未聚焦原样弃置(旧口径)
                var ic: Bool = rt_input_char(t, bind, act, gui_evt_key())
                if !ic {
                    if has_key {
                        key(gui_evt_key())
                    }
                }
            } else {
                if evt == 1 {
                    // 波次二:焦点 input 编辑键优先(消费边界=不进 key 闭包,s33 锁)
                    var ik: Bool = rt_input_key(t, bind, act, gui_evt_key())
                    if !ik {
                        // 波次三:键盘模态——末帧有 overlay:Esc 转其 on:click(自锁
                        // 修复=Esc 永可达),余键吞,键闭包挂起
                        var ov: I32 = rt_top_overlay(t, hits)
                        if ov >= 0 {
                            if gui_evt_key() == 256 {
                                var oh: Str = rt_in_handler(t, ov, "click")
                                if oh != "" {
                                    act(oh, List[Str]())
                                }
                            }
                        } else {
                            // P2:Tab 焦点环(导航位,先于快捷键表;Shift 反向)
                            if gui_evt_key() == 258 {
                                var mdb: I32 = gui_hotkey_mods()
                                var shb: I32 = mdb / 2
                                var shb2: I32 = shb / 2
                                var revb: I32 = 0
                                if shb - shb2 * 2 == 1 {
                                    revb = 1
                                }
                                var nfb: I32 = rt_focus_next(t, gui_focus_node(), revb)
                                gui_focus_set(nfb)
                                if nfb >= 0 {
                                    var fbv: Str = rt_in_val(t, nfb, bind)
                                    var cax: I32 = gui_caret_at_x(t, nfb, fbv, gui_evt_x(), rects, hits)
                                    gui_caret_set(cax)
                                    var dblk2: I32 = gui_click_kind(gui_evt_x(), gui_evt_y())
                                    if dblk2 == 1 {
                                        var wr2 = List[I32]()
                                        gui_word_range(fbv, cax, wr2)
                                        if wr2.len >= 2 {
                                            if wr2[1] > wr2[0] {
                                                gui_sel_anchor_set(wr2[0])
                                                gui_caret_set(wr2[1])
                                            }
                                        }
                                    } else {
                                        gui_sel_anchor_set(cax)
                                        gui_drag_begin()
                                    }
                                } else {
                                    gui_caret_set(0)
                                }
                            } else {
                                // 波次五b:快捷键表(§2.11 路由链第三位;未中回落 key 闭包)
                                var hk: I32 = gui_hotkey_match(gui_evt_key(), gui_hotkey_mods())
                                if hk >= 0 {
                                    var han: Str = ""
                                    var hi: I32 = 0
                                    while hi < hk {
                                        han = han + utf8_enc(gui_hotkey_action_byte(hi))
                                        hi += 1
                                    }
                                    act(han, List[Str]())
                                } else {
                                    if has_key {
                                        key(gui_evt_key())
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var hv2: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
        gui_cursor_set(rt_cursor_for(t, hv2))
        var nfr: I32 = rt_draw_frame(t, bind, w, h, hits, hinst, hv2, gui_mouse_down())
        rects = List[I32]()
        rt_collect_rects(nfr, rects)
        gui_ime_feed_caret(rects, hits)
        rt_scroll_req_apply(t, rects, hits)
        rt_after_pump(t, bind, act)
        BeginDrawing()
        gui_clear(27, 27, 29)
        ctron_gui_flush()
        // GUI-25 真窗直绘:canvas fire 在 flush 之后——帧头 fire 被 clear 抹除、
        // flush 前 fire 被盒背景矩形覆盖(手验 1003 双层实证);UI 之上画点=z 序本义
        gui_px_clear()
        rt_canvas_frame(t, rects, hits, bind, act)
        EndDrawing()
    }
    CloseWindow()
    return 0
}

pub fn rt_run(t: GuiTree, title: Str, w: I32, h: I32,
              bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    return rt_window_loop(t, title, w, h, bind, act, rt_nokey, false)
}

pub fn rt_run_kb(t: GuiTree, title: Str, w: I32, h: I32,
                 bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void,
                 key: fn(I32) -> Void) -> I32 {
    return rt_window_loop(t, title, w, h, bind, act, key, true)
}

// d 变体:热重载路径 = 清单 gui.entry 烘焙值(J18;缺省 "app.ctml")
pub fn rt_run_d(t: GuiTree, src: Str, title: Str, w: I32, h: I32,
                bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    return rt_window_loop_d(t, src, ctron_gui_entry(), title, w, h, bind, act, rt_nokey, false)
}

pub fn rt_run_kb_d(t: GuiTree, src: Str, title: Str, w: I32, h: I32,
                   bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void,
                   key: fn(I32) -> Void) -> I32 {
    return rt_window_loop_d(t, src, ctron_gui_entry(), title, w, h, bind, act, key, true)
}

// ==================== 入口与测试驱动(headless) ====================

pub struct Driver {
    var t: GuiTree
    var rects: List[I32]
    var hits: List[I32]
    var hinst: List[I32]
    var hov: I32
    var actn: I32
    var w: I32
    var h: I32
}

fn d_btn_index(t: GuiTree, name: Str) -> I32 {
    var j: I32 = 0
    while j < t.btns.len {
        var node: I32 = t.btns[j]
        var e: I32 = 0
        while e < t.nec[node] {
            var gi: I32 = t.nes[node] + e
            // SL-8c-3:按头匹配(单标识符旧契约全等特例;表达式 {d1(m)} ↔ d_click(t,"d1"))
            if ev_head(t.ev_fn[gi]) == name {
                return j
            }
            e += 1
        }
        j += 1
    }
    return -1
}

pub fn d_click(t: Box[Driver], name: Str) -> Str {
    var j: I32 = d_btn_index(t.t, name)
    if j < 0 {
        panic("gui test: 未知动作 " + name)
        return ""
    }
    var ci: I32 = t.rects[j]
    var cx: I32 = gui_cmd_x100(ci) / 100 + gui_cmd_w100(ci) / 200
    var cy: I32 = gui_cmd_y100(ci) / 100 + gui_cmd_h100(ci) / 200
    gui_inject_click(cx, cy)
    var evt: I32 = gui_poll_event()
    if evt != 2 {
        panic("gui test: 点击事件丢失 " + name)
        return ""
    }
    return name
}

// 交互态注入口(§2.1 headless):名→命中节点(d_btn_index 按钮面);"" 清除
pub fn d_hover(t: Box[Driver], name: Str) -> I32 {
    if name == "" {
        t.hov = -1
        t.actn = 0
        return 0
    }
    var bi: I32 = d_btn_index(t.t, name)
    if bi >= 0 {
        var bl: List[I32] = t.t.btns
        t.hov = bl[bi]
    }
    return 0
}

pub fn d_active(t: Box[Driver], on: I32) -> I32 {
    t.actn = on
    return 0
}

// 焦点注入口(§2.2 headless):聚焦树内首个 input;失焦 = d_blur
#[trusted]
extern "c" fn gui_ime_test_set(text: Str) -> I32

// P-M3:headless 组词注入(test 驱动面;渲染即断言,零真窗)
pub fn d_ime_set(text: Str) -> I32 {
    return gui_ime_test_set(text)
}

pub fn d_focus(t: Box[Driver]) -> I32 {
    var i: I32 = 0
    while i < t.t.ntag.len {
        if t.t.ntag[i] == "input" {
            gui_focus_set(i)
            gui_caret_set(0)
            return 0
        }
        if t.t.ntag[i] == "textarea" {
            gui_focus_set(i)
            gui_caret_set(0)
            return 0
        }
        if t.t.ntag[i] == "textarea" {
            gui_focus_set(i)
            gui_caret_set(0)
            return 0
        }
        i += 1
    }
    return -1
}

pub fn d_blur(t: Box[Driver]) -> I32 {
    gui_focus_set(-1)
    gui_caret_set(0)
    return 0
}

// 剪贴板注入口(headless 直控缓冲;真窗路径 rt_input_key 粘贴前自系统同步)
