// ==================== 输入辅助 ====================

// 字符码 → 单字符 Str(TextInput/type 3 事件;utf8_enc 透传)
pub fn char_str(k: I32) -> Str {
    return utf8_enc(k)
}

// SL-8c-4④:事件名实例后缀取整("头:N" 尾部数字;无后缀 = 0)——
// 合成 act 的逐行事件分支消费(P-H1 命中契约的解码侧)
// 选区非空时消费:置 caret=s0,返回 s1(调用方执行真删 [s0,s1));-1 = 无选区
// (旧版返回 Bool 且调用方以消费后 caret 拼接 = [0,s0)+[s0,end) 原串重组,
// 什么都没删——用户实测「Delete 不删选中」根因)
fn rt_sel_take() -> I32 {
    var an: I32 = gui_sel_anchor_get()
    if an < 0 {
        return -1
    }
    var ca: I32 = gui_caret_get()
    var s0: I32 = an
    var s1: I32 = ca
    if s0 > s1 {
        s0 = ca
        s1 = an
    }
    if s1 <= s0 {
        return -1
    }
    gui_sel_clear()
    gui_caret_set(s0)
    return s1
}

// 拖拽事件缝逐帧(on:drag 武装中且按住=触发;表达式内建名取 permille;
// 松开解除。evt2 武装在循环命中后)
fn rt_dgev_frame(t: GuiTree, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    if gui_dgev_on() == 0 {
        return 0
    }
    if gui_mouse_down() == 0 {
        gui_dgev_end()
        return 0
    }
    var node: I32 = gui_dgev_node()
    var de: Str = rt_in_expr(t, node, "drag")
    if de != "" {
        ev_fire(t, de, bind, act)
    }
    return 1
}

// GUI-20:文件拖入触发(窗口级事件,on:drop 声明在根元素)——逐文件 fire,
// droppath 内建随 setcur 游标走,dropn=本次总数
fn rt_drop_fire(t: GuiTree, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    var de: Str = rt_in_expr(t, gui_root_id(t), "drop")
    if de == "" {
        return 0
    }
    var n: I32 = gui_drop_count()
    var i: I32 = 0
    while i < n {
        gui_drop_setcur(i)
        ev_fire(t, de, bind, act)
        i += 1
    }
    return 1
}

// GUI-22:文本测量(直调 ft 实测;-1=无字体/FT_OFF 回启发式字节式)
fn rt_meas_w(s: Str, px: I32, wt: I32) -> I32 {
    var wi: I32 = gui_ft_measure_n_wt(s, s.len, px, wt, 0)
    if wi >= 0 {
        return wi
    }
    return s.len * px * 55 / 100
}

// GUI-22:单行省略——超 maxw 预算逐码点截断+…(切点只在 UTF-8 首字节;
// 测量轮直调,启发式回退与黄金口径同式)
fn rt_ellipsis(s: Str, maxw: I32, px: I32, wt: I32) -> Str {
    if maxw <= 0 {
        return s
    }
    var ew: I32 = rt_meas_w("…", px, wt)
    if rt_meas_w(s, px, wt) + ew <= maxw {
        return s
    }
    var cut: I32 = 0
    var i: I32 = 0
    while i < s.len {
        var b: I32 = byte_at(s, i)
        if b / 64 != 2 {
            if rt_meas_w(byte_slice(s, 0, i), px, wt) + ew > maxw {
                break
            }
            cut = i
        }
        i += 1
    }
    return byte_slice(s, 0, cut) + "…"
}

// GUI-22 v2:maxlines 行钳制——按显式 \n 行截前 N 行,截断时尾行收 …;
// 行源=显式换行(按宽折行属 textarea 折行表面);N<=0 透传(负例锚)
fn rt_maxlines(s: Str, n: I32) -> Str {
    if n <= 0 {
        return s
    }
    var out: Str = ""
    var row: I32 = 0
    var seg: I32 = 0
    var i: I32 = 0
    var truncated: Bool = false
    while i <= s.len {
        if i == s.len || byte_at(s, i) == 10 {
            if row < n {
                if row > 0 {
                    out = out + "\n"
                }
                out = out + byte_slice(s, seg, i)
            } else {
                truncated = true
            }
            row += 1
            seg = i + 1
            if i == s.len {
                break
            }
        }
        i += 1
    }
    if truncated {
        out = out + "…"
    }
    return out
}

// GUI-25:canvas 绘制帧——盒几何自 rects 同步+on:draw fire(真窗每帧;
// headless 经 d_draw 驱动)
fn rt_canvas_frame(t: GuiTree, rects: List[I32], hits: List[I32], bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    // GUI-41:多 canvas 遍历(帧首 gui_canvas_reset,emit 期 setnode 去重追加)
    var ci: I32 = 0
    var fired: I32 = 0
    while ci < gui_canvas_count() {
        var node: I32 = gui_canvas_node_i(ci)
        if node >= 0 {
            var bi: I32 = rt_node_box(rects, hits, node)
            if bi >= 0 {
                gui_canvas_setbox(gui_cmd_x100(bi) / 100, gui_cmd_y100(bi) / 100, gui_cmd_w100(bi) / 100, gui_cmd_h100(bi) / 100)
            }
            var de: Str = rt_in_expr(t, node, "draw")
            if de != "" {
                ev_fire(t, de, bind, act)
                fired += 1
            }
        }
        ci += 1
    }
    return fired
}

// GUI-24:关闭检查(真窗循环每帧头)——根有 on:close 时关闭请求被 C 侧
// 吞掉转事件(应用定去留),返回 1 续跑;无声明保持原语义(退出返 0)
fn rt_close_check(t: GuiTree, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    var ce: Str = rt_in_expr(t, gui_root_id(t), "close")
    if ce != "" {
        if gui_win_close_req() == 1 {
            ev_fire(t, ce, bind, act)
        }
        return 1
    }
    if WindowShouldClose() {
        return 0
    }
    return 1
}

// 滚动条 thumb 拖拽逐帧跟随(几何与渲染 thumb 同源:trackh=boxh-8,
// thumbh=max(16,trackh*boxh/contenth),比例换算钳 [0,maxo];松开结束)
fn rt_thumb_drag(t: GuiTree, rects: List[I32], hits: List[I32], bind: fn(List[Str]) -> Void) -> I32 {
    if gui_thdrag_on() == 0 {
        return 0
    }
    if gui_mouse_down() == 0 {
        gui_thdrag_end()
        return 0
    }
    var node: I32 = gui_thdrag_node()
    if node < 0 {
        gui_thdrag_end()
        return 0
    }
    var hs: Str = gt_cls_prop(t.ncls[node], "h", "", t)
    if hs == "" {
        gui_thdrag_end()
        return 0
    }
    var boxh: I32 = gs2i(hs)
    var tsz: I32 = gs2i(gt_cls_prop(t.ncls[node], "size", "16", t))
    var pitch: I32 = tsz + tsz / 4 + 2
    var val: Str = rt_in_val(t, node, bind)
    var w: I32 = gui_in_w_get(node) - 8
    if w < 40 {
        w = 40
    }
    var vs = List[I32]()
    var ve = List[I32]()
    ta_rows(node, val, w, tsz, vs, ve)
    var contenth: I32 = vs.len * pitch + 8
    var maxo: I32 = contenth - boxh
    if maxo <= 0 {
        return 0
    }
    var trackh: I32 = boxh - 8
    var thumbh: I32 = trackh * boxh / contenth
    if thumbh < 16 {
        thumbh = 16
    }
    var den: I32 = trackh - thumbh
    if den < 1 {
        den = 1
    }
    var ns: I32 = gui_thdrag_s0() + (gui_mouse_y() - gui_thdrag_y0()) * maxo / den
    if ns > maxo {
        ns = maxo
    }
    if ns < 0 {
        ns = 0
    }
    gui_ta_scroll_set(node, ns)
    return 1
}

// 输入拖动选区(逐帧:按下命中输入锚定,拖动更新活动端,松开结束)
fn rt_drag_sel(t: GuiTree, rects: List[I32], hits: List[I32], bind: fn(List[Str]) -> Void) -> I32 {
    if gui_drag_active() == 0 {
        return 0
    }
    if gui_mouse_down() == 0 {
        gui_drag_end()
        return 0
    }
    var fn0: I32 = gui_focus_node()
    if fn0 < 0 {
        return 0
    }
    if t.ntag[fn0] != "input" {
        if t.ntag[fn0] != "textarea" {
            return 0
        }
    }
    var cur: Str = rt_in_val(t, fn0, bind)
    var cax: I32 = gui_caret_at_click(t, fn0, cur, gui_mouse_x(), gui_mouse_y(), rects, hits)
    gui_caret_set(cax)
    return 1
}

// 字符类别(双击选词):0=分隔(空白/标点) 1=词(字母数字_) 2=CJK(多字节连片)
fn gui_chr_cls(val: Str, i: I32) -> I32 {
    var b: I32 = byte_at(val, i)
    if b >= 128 {
        return 2
    }
    if b == 95 {
        return 1
    }
    if b >= 48 && b <= 57 {
        return 1
    }
    if b >= 65 && b <= 90 {
        return 1
    }
    if b >= 97 && b <= 122 {
        return 1
    }
    return 0
}

// 双击选词:从点击边界按类别向两侧扩(同类连片;out[0]=start out[1]=end 字节位)
// 类别选取:左邻优先,左邻为分隔时用右邻——点击词左缘(边界邻空白)时仍选中
// 该词而非空白串(用户实测「双击没选对词语」根因)
fn gui_word_range(val: Str, pos: I32, out: List[I32]) -> I32 {
    var s0: I32 = pos
    var s1: I32 = pos
    var cls: I32 = 0
    if s0 > 0 {
        cls = gui_chr_cls(val, s0 - 1)
    }
    if cls == 0 {
        if s1 < val.len {
            cls = gui_chr_cls(val, s1)
        }
    }
    while s0 > 0 {
        if gui_chr_cls(val, s0 - 1) == cls {
            // 多字节回退到码点首
            var bc: I32 = s0 - 1
            while bc > 0 {
                var bb: I32 = byte_at(val, bc)
                if bb >= 128 && bb < 192 {
                    bc -= 1
                } else {
                    break
                }
            }
            if gui_chr_cls(val, bc) != cls {
                break
            }
            s0 = bc
        } else {
            break
        }
    }
    while s1 < val.len {
        if gui_chr_cls(val, s1) == cls {
            // 多字节前进到码点尾
            var fe: I32 = s1 + 1
            while fe < val.len {
                var fb: I32 = byte_at(val, fe)
                if fb >= 128 && fb < 192 {
                    fe += 1
                } else {
                    break
                }
            }
            s1 = fe
        } else {
            break
        }
    }
    out.push(s0)
    out.push(s1)
    return 0
}

// 词跳(成熟 GUI Alt+←→ 口径):分隔类(cls 0)跳过、词类连片(字母数字/_
// /CJK 多字节)跨过;码点边界安全。prev=前一词首,next=后一词尾
fn gui_word_prev(val: Str, pos: I32) -> I32 {
    var i: I32 = pos
    if i > val.len {
        i = val.len
    }
    if i < 0 {
        i = 0
    }
    while i > 0 {
        var bc: I32 = i - 1
        while bc > 0 {
            var bb: I32 = byte_at(val, bc)
            if bb >= 128 && bb < 192 {
                bc -= 1
            } else {
                break
            }
        }
        if gui_chr_cls(val, bc) != 0 {
            break
        }
        i = bc
    }
    while i > 0 {
        var bc2: I32 = i - 1
        while bc2 > 0 {
            var bb2: I32 = byte_at(val, bc2)
            if bb2 >= 128 && bb2 < 192 {
                bc2 -= 1
            } else {
                break
            }
        }
        if gui_chr_cls(val, bc2) == 0 {
            break
        }
        i = bc2
    }
    return i
}

fn gui_word_next(val: Str, pos: I32) -> I32 {
    var i: I32 = pos
    if i > val.len {
        i = val.len
    }
    if i < 0 {
        i = 0
    }
    while i < val.len {
        if gui_chr_cls(val, i) != 0 {
            break
        }
        var fe: I32 = i + 1
        while fe < val.len {
            var fb: I32 = byte_at(val, fe)
            if fb >= 128 && fb < 192 {
                fe += 1
            } else {
                break
            }
        }
        i = fe
    }
    while i < val.len {
        if gui_chr_cls(val, i) == 0 {
            break
        }
        var fe2: I32 = i + 1
        while fe2 < val.len {
            var fb2: I32 = byte_at(val, fe2)
            if fb2 >= 128 && fb2 < 192 {
                fe2 += 1
            } else {
                break
            }
        }
        i = fe2
    }
    return i
}

// 单行输入内宽回填(视口消费;每帧 collect 后:节点取配对最宽矩形,避浮条)
// textarea 同源回填:折行(ta_wrap)/键盘导航/点击定位共用 gui_in_w_get,缺回填
// 则恒 0→clamp 40px,长词被误折(s51 "xcdef" 实证)
fn rt_feed_input_w(t: GuiTree, rects: List[I32], hits: List[I32]) -> I32 {
    var j: I32 = 0
    while j < hits.len {
        var nd: I32 = hits[j]
        if nd >= 0 {
            if nd < t.ntag.len {
                if t.ntag[nd] == "input" {
                    if j < rects.len {
                        var wj: I32 = gui_cmd_w100(rects[j]) / 100
                        var cw: I32 = gui_in_w_get(nd)
                        if wj > cw {
                            gui_in_w_set(nd, wj)
                        }
                    }
                }
                if t.ntag[nd] == "textarea" {
                    if j < rects.len {
                        var wj2: I32 = gui_cmd_w100(rects[j]) / 100
                        var cw2: I32 = gui_in_w_get(nd)
                        if wj2 > cw2 {
                            gui_in_w_set(nd, wj2)
                        }
                    }
                }
            }
        }
        j += 1
    }
    return 0
}

// textarea 滚轮滚动(聚焦态;每档 3 行;钳 [0, 内容高-框高])
fn rt_ta_wheel(t: GuiTree, rects: List[I32], hits: List[I32], v: I32, bind: fn(List[Str]) -> Void) -> I32 {
    if v == 0 {
        return 0
    }
    var fn0: I32 = gui_focus_node()
    if fn0 < 0 {
        return 0
    }
    if fn0 >= t.ntag.len {
        return 0
    }
    if t.ntag[fn0] != "textarea" {
        return 0
    }
    var hs: Str = gt_cls_prop(t.ncls[fn0], "h", "", t)
    if hs == "" {
        return 0
    }
    var boxh: I32 = gs2i(hs)
    var tszw: I32 = gs2i(gt_cls_prop(t.ncls[fn0], "size", "16", t))
    var pitchw: I32 = tszw + tszw / 4 + 2
    var val: Str = rt_in_val(t, fn0, bind)
    // 内容高按视觉行数(折行撑高;同源 wrap 宽=内宽)
    var wwhl: I32 = gui_in_w_get(fn0) - 8
    if wwhl < 40 {
        wwhl = 40
    }
    var wvs = List[I32]()
    var wve = List[I32]()
    ta_rows(fn0, val, wwhl, tszw, wvs, wve)
    var contenth: I32 = wvs.len * pitchw + 8
    var maxo: I32 = contenth - boxh
    if maxo < 0 {
        maxo = 0
    }
    var curs: I32 = gui_ta_scroll_get(fn0)
    curs = curs - v * 3 * pitchw
    if curs > maxo {
        curs = maxo
    }
    if curs < 0 {
        curs = 0
    }
    gui_ta_scroll_set(fn0, curs)
    return 1
}

// 通用点击定位(input: x 单维;textarea: x+y 行列双维)
fn gui_caret_at_click(t: GuiTree, node: I32, val: Str, px: I32, py: I32, rects: List[I32], hits: List[I32]) -> I32 {
    if t.ntag[node] == "textarea" {
        var boxi2: I32 = -1
        var boxw2: I32 = 0
        var jj: I32 = 0
        while jj < hits.len {
            if hits[jj] == node {
                if jj < rects.len {
                    var wj2: I32 = gui_cmd_w100(rects[jj])
                    if wj2 > boxw2 {
                        boxw2 = wj2
                        boxi2 = rects[jj]
                    }
                }
            }
            jj += 1
        }
        if boxi2 < 0 {
            return val.len
        }
        var tsz5: I32 = gs2i(gt_cls_prop(t.ncls[node], "size", "16", t))
        var tpitch2: I32 = tsz5 + tsz5 / 4 + 2
        var wpx2: I32 = gui_cmd_w100(boxi2) / 100 - 8
        if wpx2 < 40 {
            wpx2 = 40
        }
        var row: I32 = (py - gui_cmd_y100(boxi2) / 100 - 4 + gui_ta_scroll_get(node)) / tpitch2
        if row < 0 {
            row = 0
        }
        var vls2 = List[I32]()
        var vle2 = List[I32]()
        ta_wrap(val, wpx2, tsz5, vls2, vle2)
        if row >= vls2.len {
            row = vls2.len - 1
        }
        var ls2: I32 = vls2[row]
        var le2: I32 = vle2[row]
        var line: Str = byte_slice(val, ls2, le2)
        var offx2: I32 = px - gui_cmd_x100(boxi2) / 100 - 4
        var bi: I32 = 0
        var bbest: I32 = 0
        var bbd: I32 = offx2
        if bbd < 0 {
            bbd = 0 - bbd
        }
        while bi <= line.len {
            var okb2: Bool = true
            if bi < line.len {
                var bb2: I32 = byte_at(line, bi)
                if bb2 >= 128 && bb2 < 192 {
                    okb2 = false
                }
            }
            if okb2 {
                var w2: I32 = gui_ft_measure_n_wt(line, bi, tsz5, 400, 0)
                var d2: I32 = w2 - offx2
                if d2 < 0 {
                    d2 = 0 - d2
                }
                if d2 < bbd {
                    bbd = d2
                    bbest = bi
                }
            }
            bi += 1
        }
        return ls2 + bbest
    }
    return gui_caret_at_x(t, node, val, px, rects, hits)
}

// P-M3:点击 x → 最近码点边界(成熟 GUI 点击定位光标):沿码点边界步行累计
// 前缀实测宽(与布局同源),取 |w-off| 最小边界;框体定位取该节点配对矩形中
// 最宽者(浮条 2px RECT 亦配对命中,须避开)
fn gui_caret_at_x(t: GuiTree, node: I32, val: Str, clickx: I32, rects: List[I32], hits: List[I32]) -> I32 {
    var boxi: I32 = -1
    var boxw: I32 = 0
    var j: I32 = 0
    while j < hits.len {
        if hits[j] == node {
            if j < rects.len {
                var wj: I32 = gui_cmd_w100(rects[j])
                if wj > boxw {
                    boxw = wj
                    boxi = rects[j]
                }
            }
        }
        j += 1
    }
    if boxi < 0 {
        return val.len
    }
    var ipd2: I32 = gs2i(gt_cls_prop(t.ncls[node], "pad", "8", t))
    var off: I32 = clickx - gui_cmd_x100(boxi) / 100 - ipd2 + gui_in_xo_get(node)
    var isz: I32 = gs2i(gt_cls_prop(t.ncls[node], "size", "20", t))
    var ifw: I32 = gs2i(gt_cls_prop(t.ncls[node], "font_weight", "400", t))
    var wt2: I32 = ifw % 10000
    var fam2: I32 = ifw / 10000
    var best: I32 = 0
    var bestd: I32 = off
    if bestd < 0 {
        bestd = 0 - bestd
    }
    var i: I32 = 0
    while i <= val.len {
        var okb: Bool = true
        if i < val.len {
            var b: I32 = byte_at(val, i)
            if b >= 128 && b < 192 {
                okb = false
            }
        }
        if okb {
            var w: I32 = gui_ft_measure_n_wt(val, i, isz, wt2, fam2)
            var d: I32 = w - off
            if d < 0 {
                d = 0 - d
            }
            if d < bestd {
                bestd = d
                best = i
            }
        }
        i += 1
    }
    return best
}

// P-M3:开窗自动聚焦首个 input(成熟语言输入体验:启动即可打字,无需点击;
// caret 置尾 = append 惯例,与 click-to-focus 一致)

// ==================== GUI-15:on:after 定时事件(§2.7 tick→事件通道) ====================
// 视图元素属性 on:after="ms:handler":元素存活域一次性定时——首见布防,期限
// 即 fire act(handler) 一次并拆防;when 假(灶灭)不 fire;on:input 同节点重臂
// =防抖口径(每击键重置期限)。headless 时钟=d_tick 注入口径,d_after_pump
// 显式泵;真窗循环每帧自动泵。handler v1=简单名(E8120 门在册)。

// "ms:handler" 冒号前毫秒;非形态回 -1
fn rt_after_ms(e: Str) -> I32 {
    var ci: I32 = 0
    while ci < e.len {
        if byte_at(e, ci) == 58 {
            break
        }
        ci += 1
    }
    if ci == 0 {
        return -1
    }
    if ci >= e.len {
        return -1
    }
    var ms: I32 = gs2i(byte_slice(e, 0, ci))
    if ms <= 0 {
        return -1
    }
    return ms
}

// 到期泵:due 节点拆防即 fire(一次性);隐灶(seen 过期)不 fire
pub fn rt_after_pump(t: GuiTree, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    var i: I32 = 0
    while i < t.ntag.len {
        var e: I32 = 0
        while e < t.nec[i] {
            var gi: I32 = t.nes[i] + e
            if t.ev_name[gi] == "after" {
                if gui_after_due(i) {
                    gui_after_disarm(i)
                    var afn: Str = t.ev_fn[gi]
                    var ci: I32 = 0
                    while ci < afn.len {
                        if byte_at(afn, ci) == 58 {
                            break
                        }
                        ci += 1
                    }
                    if ci < afn.len {
                        act(byte_slice(afn, ci + 1, afn.len), List[Str]())
                    }
                }
            }
            e += 1
        }
        i += 1
    }
    return 0
}

// headless 泵(d_tick 注入时钟推进后由断言脚本显式调)
pub fn d_after_pump(t: Box[Driver], bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    return rt_after_pump(t.t, bind, act)
}

fn gui_autofocus_first_input(t: GuiTree, bind: fn(List[Str]) -> Void) -> I32 {
    // 首个可编辑件(input 或 textarea,树序)——textarea 开窗即可打字,
    // 与成熟编辑器开箱即输入同口径
    var afi: I32 = 0
    var af: I32 = -1
    while afi < t.ntag.len {
        if t.ntag[afi] == "input" {
            af = afi
            afi = t.ntag.len
        }
        if t.ntag[afi] == "textarea" {
            if af < 0 {
                af = afi
                afi = t.ntag.len
            }
        }
        afi += 1
    }
    if af > 0 {
        gui_focus_set(af)
        var av: Str = rt_in_val(t, af, bind)
        gui_caret_set(av.len)
    }
    return af
}

// P-M3:聚焦节点 rect 反喂 IME shim(候选窗定位;cmd ×100 域;v1 静态布局
// 口径——反喂点 = collect 时点,动态布局随帧刷新登记)
fn gui_ime_feed_caret(rects: List[I32], hits: List[I32]) -> I32 {
    var fn0: I32 = gui_focus_node()
    if fn0 < 0 {
        return 1
    }
    // 拼装制(候选窗锚定终态契约):渲染期恒写框相对光标线(cx,cy,ch);
    // 此处取聚焦节点最宽配对矩形=框体(每帧必在,无渲染帧竞态),拼出
    // 绝对光标条反喂。回退=最窄正宽矩形(无框体输入件)。
    // 竞态实证:输入法整个组词期仅询问一次首 rect,闪烁暗相帧窄矩形扫描
    // 抓到滚动条 thumb(4x48 trace)→面板压住首行文字;框体恒在故拼装制
    // 对询问时机零敏感。
    var box: I32 = -1
    var best: I32 = -1
    var bw: I32 = 0
    var j: I32 = 0
    // 盒判据:宽≥40 且高≥光标行高(排除光标条/下划线 h=2/thumb w=4 等浮条
    // 被误当框体——无样式输入件浮条是仅有的配对矩形)
    var boxmh: I32 = gui_ime_caret_h()
    if boxmh < 8 {
        boxmh = 8
    }
    while j < hits.len {
        if hits[j] == fn0 {
            if j < rects.len {
                var wj: I32 = gui_cmd_w100(rects[j])
                var hj: I32 = gui_cmd_h100(rects[j])
                if wj > 0 {
                    if wj >= 4000 {
                        if hj >= boxmh * 100 {
                            if box < 0 {
                                box = rects[j]
                            } else {
                                if wj > gui_cmd_w100(box) {
                                    box = rects[j]
                                }
                            }
                        }
                    }
                    if best < 0 {
                        best = rects[j]
                        bw = wj
                    } else {
                        if wj < bw {
                            bw = wj
                            best = rects[j]
                        }
                    }
                }
            }
        }
        j += 1
    }
    if box >= 0 {
        if gui_ime_cx_get() >= 0 {
            if gui_ime_caret_h() > 0 {
                gui_ime_set_caret(gui_cmd_x100(box) / 100 + gui_ime_cx_get(), gui_cmd_y100(box) / 100 + gui_ime_caret_y(), 2, gui_ime_caret_h())
                return 0
            }
        }
    }
    if best >= 0 {
        gui_ime_set_caret(gui_cmd_x100(best) / 100, gui_cmd_y100(best) / 100, gui_cmd_w100(best) / 100, gui_cmd_h100(best) / 100)
    }
    return 0
}

#[trusted]
extern "c" fn gui_ime_preedit() -> Str
extern "c" fn gui_ime_has_preedit() -> I32
#[trusted]
extern "c" fn gui_ime_set_caret(x: I32, y: I32, w: I32, h: I32) -> I32
extern "c" fn gui_ime_cx_set(x: I32) -> I32
extern "c" fn gui_ime_cx_get() -> I32
extern "c" fn gui_ime_caret_line_set(y: I32, h: I32) -> I32
extern "c" fn gui_ime_caret_y() -> I32
extern "c" fn gui_ime_caret_h() -> I32
extern "c" fn gui_ta_scroll_set(node: I32, y: I32) -> I32
extern "c" fn gui_ta_scroll_get(node: I32) -> I32
extern "c" fn gui_ta_follow_get(node: I32) -> I32
extern "c" fn gui_ta_follow_set(node: I32, c: I32) -> I32
extern "c" fn gui_wrap_cache_hit(node: I32, val: Str, w: I32, size: I32) -> I32
extern "c" fn gui_wrap_cache_putrow(i: I32, s: I32, e: I32) -> I32
extern "c" fn gui_wrap_cache_commit(node: I32, val: Str, w: I32, size: I32, rows: I32) -> I32
extern "c" fn gui_wrap_row_s(i: I32) -> I32
extern "c" fn gui_wrap_row_e(i: I32) -> I32
extern "c" fn gui_ime_prev_set(s: Str) -> I32
extern "c" fn gui_ime_prev_eq(s: Str) -> I32

// 文本点击选区(窗口循环 evt2 与 headless d_click_text 同源唯一入口):
// 单击=光标定位(启动拖动锚)/双击=词/三击=视觉行/四击=全选(连击阶梯);
// Shift+点击(已聚焦且有锚)=扩选到点击位
fn rt_click_text(t: GuiTree, fnode: I32, bind: fn(List[Str]) -> Void, rects: List[I32], hits: List[I32]) -> I32 {
    var hadf: Bool = gui_focus_node() == fnode
    gui_focus_set(fnode)
    var fbv: Str = ""
    if t.nbid[fnode] != "" {
        if gt_slot_simple(t.nbid[fnode]) && t.props.len == 0 {
            fbv = bxv_show(rt_bind_text(bind, t.nbid[fnode]))
        } else {
            fbv = bxv_show(bxv_eval(t, t.nbid[fnode], bind, "", ""))
        }
    }
    // thumb 命中:右缘 thumb 区按下=拖拽滚动(不定位光标、不启文本拖选;
    // 命中区比 4px 视觉宽各放 2px,几何与渲染/逐帧跟随同源)
    var tbb: I32 = rt_node_box(rects, hits, fnode)
    if tbb >= 0 {
        var tw: I32 = gui_in_w_get(fnode) - 8
        if tw < 40 {
            tw = 40
        }
        var tsz6: I32 = gs2i(gt_cls_prop(t.ncls[fnode], "size", "16", t))
        var tp6: I32 = tsz6 + tsz6 / 4 + 2
        var tc6 = List[I32]()
        var td6 = List[I32]()
        ta_rows(fnode, fbv, tw, tsz6, tc6, td6)
        var tch6: I32 = tc6.len * tp6 + 8
        var tbh6: I32 = gui_cmd_h100(tbb) / 100
        if tch6 > tbh6 {
            var tmax6: I32 = tch6 - tbh6
            var ttr6: I32 = tbh6 - 8
            var tth6: I32 = ttr6 * tbh6 / tch6
            if tth6 < 16 {
                tth6 = 16
            }
            var tscr6: I32 = gui_ta_scroll_get(fnode)
            var ttx: I32 = gui_cmd_x100(tbb) / 100 + tw + 2
            var tty: I32 = gui_cmd_y100(tbb) / 100 + 4 + (ttr6 - tth6) * tscr6 / tmax6
            var mx6: I32 = gui_evt_x()
            var my6: I32 = gui_evt_y()
            var inx6: Bool = false
            if mx6 >= ttx - 2 {
                if mx6 <= ttx + 6 {
                    inx6 = true
                }
            }
            var iny6: Bool = false
            if my6 >= tty - 2 {
                if my6 <= tty + tth6 + 2 {
                    iny6 = true
                }
            }
            if inx6 {
                if iny6 {
                    gui_thdrag_begin(fnode, my6, tscr6)
                    return fnode
                }
            }
        }
    }
    var cax: I32 = gui_caret_at_click(t, fnode, fbv, gui_evt_x(), gui_evt_y(), rects, hits)
    gui_caret_set(cax)
    // 双击选词不启拖动(按压仍按住数帧,逐帧拖动会把词选光标
    // 拽回点击位——选区截成 [词首,点击位],用户实测「只选 re」)
    var dblk: I32 = gui_click_kind(gui_evt_x(), gui_evt_y())
    if dblk == 1 {
        var wr = List[I32]()
        gui_word_range(fbv, cax, wr)
        if wr.len >= 2 {
            if wr[1] > wr[0] {
                gui_sel_anchor_set(wr[0])
                gui_caret_set(wr[1])
            }
        }
    } else {
        if dblk == 2 {
            // 三击=选视觉行(连击阶梯 词→行→全选;input=全串)
            gui_sel_row(t, fnode, fbv, cax)
        } else {
            if dblk == 3 {
                // 四击=全选
                gui_sel_anchor_set(0)
                gui_caret_set(fbv.len)
            } else {
                if gui_mod_shift() == 1 && hadf && gui_sel_anchor_get() >= 0 {
                    gui_caret_set(cax)
                } else {
                    gui_sel_anchor_set(cax)
                    gui_drag_begin()
                }
            }
        }
    }
    return fnode
}

// 三击选行(连击阶梯 词→行→全选):textarea=视觉行(同源 wrap 宽);input=全串
fn gui_sel_row(t: GuiTree, node: I32, val: Str, caret: I32) -> I32 {
    if t.ntag[node] == "textarea" {
        var a: I32 = gui_ta_row_start(t, node, val, caret)
        var b: I32 = gui_ta_row_end(t, node, val, caret)
        if b > a {
            gui_sel_anchor_set(a)
            gui_caret_set(b)
        } else {
            gui_sel_anchor_set(a)
            gui_caret_set(a)
        }
        return 0
    }
    gui_sel_anchor_set(0)
    gui_caret_set(val.len)
    return 0
}

// 光标所在视觉行界(⌘←→/⌘⌫/⌘⌦ 行首尾导航;与渲染/点击同源 wrap 宽)
fn gui_ta_row_start(t: GuiTree, node: I32, val: Str, caret: I32) -> I32 {
    var w: I32 = gui_in_w_get(node) - 8
    if w < 40 {
        w = 40
    }
    var sz: I32 = gs2i(gt_cls_prop(t.ncls[node], "size", "16", t))
    var vs = List[I32]()
    var ve = List[I32]()
    ta_rows(node, val, w, sz, vs, ve)
    var row: I32 = 0
    var i: I32 = 0
    while i < vs.len {
        if vs[i] <= caret {
            row = i
        }
        i += 1
    }
    return vs[row]
}

fn gui_ta_row_end(t: GuiTree, node: I32, val: Str, caret: I32) -> I32 {
    var w: I32 = gui_in_w_get(node) - 8
    if w < 40 {
        w = 40
    }
    var sz: I32 = gs2i(gt_cls_prop(t.ncls[node], "size", "16", t))
    var vs = List[I32]()
    var ve = List[I32]()
    ta_rows(node, val, w, sz, vs, ve)
    var row: I32 = 0
    var i: I32 = 0
    while i < vs.len {
        if vs[i] <= caret {
            row = i
        }
        i += 1
    }
    return ve[row]
}

// 折行表共享缓存消费(单槽,键=节点+值+宽+字号):绘制/焦点几何/选区/滚轮/
// 键导航同帧多份消费,值未变即整表复用(O(n²) 测量×4→×1,输入卡顿根治面)
fn ta_rows(id: I32, val: Str, wpx: I32, size: I32, outS: List[I32], outE: List[I32]) -> I32 {
    var n: I32 = gui_wrap_cache_hit(id, val, wpx, size)
    if n < 0 {
        ta_wrap(val, wpx, size, outS, outE)
        var i: I32 = 0
        while i < outS.len {
            gui_wrap_cache_putrow(i, outS[i], outE[i])
            i += 1
        }
        gui_wrap_cache_commit(id, val, wpx, size, outS.len)
        return 0
    }
    var i2: I32 = 0
    while i2 < n {
        outS.push(gui_wrap_row_s(i2))
        outE.push(gui_wrap_row_e(i2))
        i2 += 1
    }
    return 0
}

// 视觉行构建:按宽折行(码点贪心;换行符强制断;空逻辑行=空视觉行占位)
// outS/outE = 每视觉行 [起,止) 字节位(止不含 \n)
fn ta_wrap(val: Str, wpx: I32, size: I32, outS: List[I32], outE: List[I32]) -> I32 {
    var i: I32 = 0
    var n: I32 = val.len
    while i <= n {
        var ls: I32 = i
        var hard: I32 = -1
        var q: I32 = i
        while q < n {
            if byte_at(val, q) == 10 {
                hard = q
                q = n + 1
            } else {
                q += 1
            }
        }
        var le: I32 = n
        if hard >= 0 {
            le = hard
        }
        // 逻辑行 [ls,le):贪心折
        var cs: I32 = ls
        while cs < le {
            // 行内基线测量提升(边界宽=前缀测量差)——基线必须随行首走:
            // 提到行组外则续行全前缀宽误作行内宽,续行逐字断行(用户实测
            // 「行末打单词新行一字母一行」实证)
            var wbase: I32 = gui_ft_measure_n_wt(val, cs, size, 400, 0)
            var ce: I32 = cs
            var lastok: I32 = cs
            while ce < le {
                var nb: I32 = ce + 1
                while nb < le {
                    var bb: I32 = byte_at(val, nb)
                    if bb >= 128 && bb < 192 {
                        nb += 1
                    } else {
                        break
                    }
                }
                var wq: I32 = gui_ft_measure_n_wt(val, nb, size, 400, 0) - wbase
                if wq > wpx {
                    if lastok == cs {
                        // 单码点超宽(极端):独占一行防死循环
                        lastok = nb
                    }
                    break
                }
                lastok = nb
                ce = nb
                if nb >= le {
                    break
                }
            }
            outS.push(cs)
            outE.push(lastok)
            cs = lastok
        }
        // 空逻辑行占位
        if cs == ls {
            outS.push(ls)
            outE.push(ls)
        }
        if hard < 0 {
            break
        }
        i = hard + 1
    }
    return outS.len
}

fn gui_ta_lines(val: Str, out: List[I32]) -> I32 {
    out.push(0)
    var i: I32 = 0
    while i < val.len {
        if byte_at(val, i) == 10 {
            out.push(i + 1)
        }
        i += 1
    }
    return out.len
}

pub fn ev_suffix_i(name: Str) -> I32 {
    var j: I32 = name.len
    while j > 0 {
        var d: I32 = byte_at(name, j - 1)
        if d >= 48 && d <= 57 {
            j -= 1
        } else {
            break
        }
    }
    if j > 1 {
        if byte_at(name, j - 1) == 58 {
            return gs2i(byte_slice(name, j, name.len))
        }
    }
    return 0
}

