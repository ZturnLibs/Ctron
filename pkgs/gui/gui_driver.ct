// GUI-24 headless 驱动:模拟关闭请求——根有 on:close 则 fire(拦截语义,
// 脚本继续即「未退出」)返回 1;无声明 panic(真窗此时会退出)
pub fn d_close_req(t: Box[Driver], bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    var ce: Str = rt_in_expr(t.t, gui_root_id(t.t), "close")
    if ce == "" {
        panic("gui test: 根元素无 on:close")
        return 0
    }
    ev_fire(t.t, ce, bind, act)
    return 1
}

