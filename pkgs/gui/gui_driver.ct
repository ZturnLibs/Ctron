// GUI-21 headless 驱动:滚动偏移累计(与真窗滚轮同槽)
pub fn d_scroll(t: Box[Driver], delta: I32) -> I32 {
    return gui_scroll_add(delta)
}

pub fn d_scroll_off() -> I32 {
    return gui_scroll_off()
}

// 应用面:当前滚动偏移(bind 组装可见窗口行消费)
pub fn scroll_off() -> I32 {
    return gui_scroll_off()
}

// 绘制原语(应用 on:draw 回调内调;坐标相对 canvas 盒)
pub fn canvas_px(x: I32, y: I32, r: I32, g: I32, b: I32) -> I32 {
    return gui_px(x, y, r, g, b)
}

// 负断言:want 不出现在任何 TEXT 命令(when 隐藏面)
pub fn d_expect_absent(t: Box[Driver], want: Str) -> I32 {
    var n: I32 = gui_cmd_count()
    var i: I32 = 0
    while i < n {
        if gui_cmd_type(i) == 1 {
            if gui_cmd_text_len(i) == want.len {
                var ok: Bool = true
                var j: I32 = 0
                while j < want.len {
                    if gui_cmd_text_byte(i, j) != byte_at(want, j) {
                        ok = false
                        j = want.len
                    }
                    j += 1
                }
                if ok {
                    panic("gui test: 负断言失败,显示出现 [" + want + "]")
                    return 1
                }
            }
        }
        i += 1
    }
    return 0
}

pub fn test(src: Str, w: I32, h: I32,
            bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void,
            key: fn(I32) -> Void,
            script: fn(Box[Driver], fn(Str, List[Str]) -> Void, fn(I32) -> Void) -> Void) -> I32 {
    theme_auto_apply()
    var t: GuiTree = gt_parse(src)
    gui_clay_init(w, h)
    var d = Box[Driver](Driver { t: t, rects: List[I32](), hits: List[I32](), hinst: List[I32](), hov: -1, actn: 0, w: w, h: h })
    var n: I32 = rt_draw_frame(d.t, bind, w, h, d.hits, d.hinst, d.hov, d.actn)
    rt_collect_rects(n, d.rects)
    rt_feed_input_w(d.t, d.rects, d.hits)
    script(d, act, key)
    return 0
}

// SL-7β2:骨架直通测试入口——树已由编译期解析(gui_sk_load)给出,不再经
// gt_parse;其余口径与 test 完全一致(d_* 驱动断言族全可用)
pub fn test_sk(t: GuiTree, w: I32, h: I32,
               bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void,
               key: fn(I32) -> Void,
               script: fn(Box[Driver], fn(Str, List[Str]) -> Void, fn(I32) -> Void) -> Void) -> I32 {
    theme_auto_apply()
    gui_clay_init(w, h)
    var d = Box[Driver](Driver { t: t, rects: List[I32](), hits: List[I32](), hinst: List[I32](), hov: -1, actn: 0, w: w, h: h })
    var n: I32 = rt_draw_frame(d.t, bind, w, h, d.hits, d.hinst, d.hov, d.actn)
    rt_collect_rects(n, d.rects)
    rt_feed_input_w(d.t, d.rects, d.hits)
    script(d, act, key)
    return 0
}

