// 字体族注册(§2.8 P2):路径验载成功返回族 id(1..8,0=默认族),失败 -1;
// 样式侧 font_family: <id 数字>;combo 编码 = id*10000+字重
pub fn gui_font_register(path: Str) -> I32 {
    return gui_font_register_c(path)
}

// 快捷键注册(§2.11 应用侧):combo = "mod+s"/"ctrl+shift+k"/"alt+1";
// mods 位 1=ctrl/cmd 2=shift 4=alt;action 直发 act
pub fn gui_hotkey(combo: Str, action: Str) -> I32 {
    var mods: I32 = 0
    var key: I32 = 0
    var part: Str = ""
    var i: I32 = 0
    while i <= combo.len {
        if i == combo.len {
            if byte_at(combo, combo.len - 1) == 43 {
                part = part
            } else {
                if i > 0 {
                    if byte_at(combo, i - 1) != 43 {
                        // 末段=键位
                        var kb: I32 = byte_at(combo, i - 1)
                        if kb >= 97 {
                            if kb <= 122 {
                                kb = kb - 32
                            }
                        }
                        key = kb
                    }
                }
            }
            // 收尾段处理(见下方统一逻辑的替代——此处仅处理单段组合)
        }
        i += 1
    }
    // 逐段扫描(+' 分隔;Ctron 无 split,字节态机)
    mods = 0
    key = 0
    var j: I32 = 0
    var seg: Str = ""
    while j <= combo.len {
        var ch: I32 = 43
        if j < combo.len {
            ch = byte_at(combo, j)
        }
        if ch == 43 || j == combo.len {
            if seg == "mod" {
                mods = mods + 1
            }
            if seg == "ctrl" {
                mods = mods + 1
            }
            if seg == "shift" {
                mods = mods + 2
            }
            if seg == "alt" {
                mods = mods + 4
            }
            if seg.len == 1 {
                var kb: I32 = byte_at(seg, 0)
                if kb >= 97 {
                    if kb <= 122 {
                        kb = kb - 32
                    }
                }
                key = kb
            }
            seg = ""
        } else {
            seg = seg + utf8_enc(ch)
        }
        j += 1
    }
    if key != 0 {
        gui_hotkey_set(mods, key, action)
    }
    return 0
}

// headless 编辑管线注入口:注入→poll→焦点 input 编辑管线路由;消费返 0,未消费返原码
// (与窗口循环同一管线;s33 键消费边界夹具依赖此语义)
pub fn d_send_char(t: Box[Driver], ch: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    gui_inject_char(ch)
    var evt: I32 = gui_poll_event()
    if evt != 3 {
        panic("gui test: 字符事件丢失")
    }
    var k: I32 = gui_evt_key()
    if rt_input_char(t.t, bind, act, k) {
        return 0
    }
    return k
}

pub fn d_send_key(t: Box[Driver], k: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    gui_inject_key(k)
    var evt: I32 = gui_poll_event()
    if evt != 1 {
        panic("gui test: 键事件丢失")
    }
    if rt_input_key(t.t, bind, act, gui_evt_key()) {
        return 0
    }
    // 键盘模态镜像(窗口循环同语义):overlay 在场 Esc 转 on:click、余键吞
    var ov: I32 = rt_top_overlay(t.t, t.hits)
    if ov >= 0 {
        if gui_evt_key() == 256 {
            var oh: Str = rt_in_handler(t.t, ov, "click")
            if oh != "" {
                act(oh, List[Str]())
            }
        }
        return 0
    }
    // Tab 焦点环镜像(窗口循环同语义)
    if gui_evt_key() == 258 {
        var mdm: I32 = gui_hotkey_mods()
        var shm: I32 = mdm / 2
        var shm2: I32 = shm / 2
        var revm: I32 = 0
        if shm - shm2 * 2 == 1 {
            revm = 1
        }
        var nfm: I32 = rt_focus_next(t.t, gui_focus_node(), revm)
        gui_focus_set(nfm)
        if nfm >= 0 {
            var fvb: Str = rt_in_val(t.t, nfm, bind)
            gui_caret_set(fvb.len)
        } else {
            gui_caret_set(0)
        }
        return 0
    }
    // 快捷键表镜像(窗口循环同语义)
    var hk: I32 = gui_hotkey_match(gui_evt_key(), gui_hotkey_mods())
    if hk >= 0 {
        var han: Str = ""
        var hi: I32 = 0
        while hi < hk {
            han = han + utf8_enc(gui_hotkey_action_byte(hi))
            hi += 1
        }
        act(han)
        return 0
    }
    return gui_evt_key()
}

// 文本位置点击(headless):与窗口循环同一 rt_click_text 路径——连击阶梯
// (词/行/全选)唯一断言口(d_click_xy 是按钮命中面,不含文本点击语义)
pub fn d_click_text(t: Box[Driver], x: I32, y: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    gui_inject_click(x, y)
    var evt: I32 = gui_poll_event()
    if evt != 2 {
        panic("gui test: 点击事件丢失")
    }
    if rt_menu_click(t.t, bind, act) == 1 {
        return 0
    }
    var rc2 = List[I32]()
    var n: I32 = gui_cmd_count()
    rt_collect_rects(n, rc2)
    var name: Str = rt_hit_name(t.t, t.hits, t.hinst, rc2, x, y)
    var fnode: I32 = rt_hover_node(rc2, t.hits, x, y)
    var ised: Bool = false
    if fnode >= 0 {
        if fnode < t.t.ntag.len {
            if t.t.ntag[fnode] == "input" {
                ised = true
            }
            if t.t.ntag[fnode] == "textarea" {
                ised = true
            }
        }
    }
    if ised {
        rt_click_text(t.t, fnode, bind, rc2, t.hits)
    } else {
        gui_focus_set(-1)
    }
    if name != "" {
        ev_fire(t.t, name, bind, act)
    }
    return 0
}

// 拖拽(headless):override 鼠标位,武装+首发,再拖至终点触发;清覆盖
pub fn d_drag(t: Box[Driver], x1: I32, y: I32, x2: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    var rc2 = List[I32]()
    var n: I32 = gui_cmd_count()
    rt_collect_rects(n, rc2)
    var fn0: I32 = rt_hover_node(rc2, t.hits, x1, y)
    if fn0 < 0 {
        panic("gui test: 拖拽起点未命中")
        return -1
    }
    var de: Str = rt_in_expr(t.t, fn0, "drag")
    if de == "" {
        panic("gui test: 元素无 on:drag node=" + fn0.to_string())
        return -1
    }
    var bi: I32 = rt_node_box(rc2, t.hits, fn0)
    if bi < 0 {
        panic("gui test: 拖拽元素无盒")
        return -1
    }
    gui_mouse_override(x1, y)
    gui_dgev_begin(gui_cmd_x100(bi) / 100, gui_cmd_y100(bi) / 100, gui_cmd_w100(bi) / 100, gui_cmd_h100(bi) / 100)
    gui_dgev_setnode(fn0)
    ev_fire(t.t, de, bind, act)
    gui_mouse_override(x2, y)
    ev_fire(t.t, de, bind, act)
    gui_mouse_clear()
    gui_dgev_end()
    return 0
}

// 垂直拖拽(headless):x 固定,y1→y2;两帧口径与 d_drag 同源(GUI-17 分隔条)
pub fn d_dragv(t: Box[Driver], x: I32, y1: I32, y2: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    var rc2 = List[I32]()
    var n: I32 = gui_cmd_count()
    rt_collect_rects(n, rc2)
    var fn0: I32 = rt_hover_node(rc2, t.hits, x, y1)
    if fn0 < 0 {
        panic("gui test: 拖拽起点未命中")
        return -1
    }
    var de: Str = rt_in_expr(t.t, fn0, "drag")
    if de == "" {
        panic("gui test: 元素无 on:drag node=" + fn0.to_string() + " tag=" + t.t.ntag[fn0])
        return -1
    }
    var bi: I32 = rt_node_box(rc2, t.hits, fn0)
    if bi < 0 {
        panic("gui test: 拖拽元素无盒")
        return -1
    }
    gui_mouse_override(x, y1)
    gui_dgev_begin(gui_cmd_x100(bi) / 100, gui_cmd_y100(bi) / 100, gui_cmd_w100(bi) / 100, gui_cmd_h100(bi) / 100)
    gui_dgev_setnode(fn0)
    ev_fire(t.t, de, bind, act)
    gui_mouse_override(x, y2)
    ev_fire(t.t, de, bind, act)
    gui_mouse_clear()
    gui_dgev_end()
    return 0
}

// 文件拖入(headless):paths 填 C 槽后直触 rt_drop_fire(真窗经 evt=6 分发;
// GUI-20 测试缝)
pub fn d_drop(t: Box[Driver], paths: List[Str], bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    gui_drop_begin()
    var i: I32 = 0
    while i < paths.len {
        gui_drop_add(paths[i])
        i += 1
    }
    if rt_drop_fire(t.t, bind, act) == 0 {
        panic("gui test: 根元素无 on:drop")
        return -1
    }
    return gui_drop_count()
}

// 双击(headless):两击同位注入;返回元素 on:dblclick 处理头名(夹具 act 自
// 分发,与 d_click 同模式;真窗单双击聚类在循环 gui_click_kind)
pub fn d_dblclick(t: Box[Driver], name: Str) -> Str {
    // 按动作头定位节点(d_btn_index 的 btns↔rects 索引在多控件页会错位
    // ——实测点到 input),再取该节点盒中心注入双击
    var node: I32 = -1
    var i: I32 = 0
    while i < t.t.ntag.len {
        var e: I32 = 0
        while e < t.t.nec[i] {
            var gi: I32 = t.t.nes[i] + e
            if ev_head(t.t.ev_fn[gi]) == name {
                node = i
            }
            e += 1
        }
        i += 1
    }
    if node < 0 {
        panic("gui test: 未知动作 " + name)
        return ""
    }
    var rc2 = List[I32]()
    var n: I32 = gui_cmd_count()
    rt_collect_rects(n, rc2)
    var bi: I32 = rt_node_box(rc2, t.hits, node)
    if bi < 0 {
        panic("gui test: 动作无盒 " + name)
        return ""
    }
    var cx: I32 = gui_cmd_x100(bi) / 100 + gui_cmd_w100(bi) / 200
    var cy: I32 = gui_cmd_y100(bi) / 100 + gui_cmd_h100(bi) / 200
    gui_inject_click(cx, cy)
    gui_poll_event()
    gui_inject_click(cx, cy)
    gui_poll_event()
    var de: Str = rt_in_handler(t.t, node, "dblclick")
    if de != "" {
        return de
    }
    panic("gui test: 元素无 on:dblclick " + name)
    return ""
}

// 右键位置点击(headless):evt5 注入;与循环同路径开/关菜单
pub fn d_rclick(t: Box[Driver], x: I32, y: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    gui_inject_rclick(x, y)
    var evt: I32 = gui_poll_event()
    if evt != 5 {
        panic("gui test: 右键事件丢失")
    }
    var rc2 = List[I32]()
    var n: I32 = gui_cmd_count()
    rt_collect_rects(n, rc2)
    rt_ctx_open_at(t.t, rc2, t.hits)
    return 0
}

// 位置点击(headless):注入 xy 点击→真实命中路径(后向最优先)+焦点转移+ev_fire
// ——遮罩吃穿透/卡片不透等位置语义的唯一断言口(d_click 按名绕过命中面)
pub fn d_click_xy(t: Box[Driver], x: I32, y: I32, bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    gui_inject_click(x, y)
    var evt: I32 = gui_poll_event()
    if evt != 2 {
        panic("gui test: 点击事件丢失")
    }
    if rt_menu_click(t.t, bind, act) == 1 {
        return 0
    }
    var rc2 = List[I32]()
    var n: I32 = gui_cmd_count()
    rt_collect_rects(n, rc2)
    var name: Str = rt_hit_name(t.t, t.hits, t.hinst, rc2, x, y)
    var fnode: I32 = rt_hover_node(rc2, t.hits, x, y)
    if fnode >= 0 {
        if t.t.ntag[fnode] == "input" {
            gui_focus_set(fnode)
        } else {
            gui_focus_set(-1)
        }
    }
    if name != "" {
        ev_fire(t.t, name, bind, act)
    }
    return 0
}

pub fn d_press_key(t: Box[Driver], k: I32) -> I32 {
    gui_inject_key(k)
    var evt: I32 = gui_poll_event()
    if evt != 1 {
        panic("gui test: 键事件丢失")
        return -1
    }
    return k
}

pub fn d_frame(t: Box[Driver], bind: fn(List[Str]) -> Void) -> I32 {
    var nh = List[I32]()
    var hi = List[I32]()
    var n: I32 = rt_draw_frame(t.t, bind, t.w, t.h, nh, hi, t.hov, t.actn)
    t.hits = nh
    t.hinst = hi
    // GUI-14:滚动可见请求应用(headless 口径;rects 本帧现收,真窗在 collect 点)
    var rc = List[I32]()
    rt_collect_rects(n, rc)
    rt_scroll_req_apply(t.t, rc, nh)
    return n
}

// 注入字符事件(type 3),返回字符码(应用键钩子自行编辑模型)
// SL-8c-4④:实例分发按压——each 行按钮的驱动面(rt_hit_name "名:下标"
// 契约的镜像;按名+实例定矩形,补 d_click 单实例几何缺口)
pub fn d_click_inst(t: Box[Driver], name: Str, inst: I32) -> Str {
    var found: I32 = -1
    var j: I32 = 0
    while j < t.hits.len {
        var node: I32 = t.hits[j]
        if node >= 0 {
            if t.hinst[j] == inst {
                var e: I32 = 0
                while e < t.t.nec[node] {
                    var gi: I32 = t.t.nes[node] + e
                    if ev_head(t.t.ev_fn[gi]) == name {
                        found = j
                    }
                    e += 1
                }
            }
        }
        j += 1
    }
    if found < 0 {
        panic("gui test: 未知动作 " + name + ":" + inst.to_string())
        return ""
    }
    var ci: I32 = t.rects[found]
    var cx: I32 = gui_cmd_x100(ci) / 100 + gui_cmd_w100(ci) / 200
    var cy: I32 = gui_cmd_y100(ci) / 100 + gui_cmd_h100(ci) / 200
    gui_inject_click(cx, cy)
    var evt: I32 = gui_poll_event()
    if evt != 2 {
        panic("gui test: 点击事件丢失 " + name)
        return ""
    }
    return name + ":" + inst.to_string()
}

