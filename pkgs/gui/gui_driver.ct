// d 变体:默认锚 = 清单 gui.entry 烘焙值(J18;缺省 "app.ctml")+ 热重载环
//(60 帧内容比对,变更原址重解析)
pub fn rt_run_anchor(title: Str, w: I32, h: I32,
             bind: fn(List[Str]) -> Void, act: fn(Str, List[Str]) -> Void) -> I32 {
    // 文件优先(开发环 + 热重载),缺失回落内嵌块(SL-7α:程序自身 view/style,
    // 独立二进制零 CWD 依赖)。GUI-27:锚合并源(use 闭包 DFS,入口最后)
