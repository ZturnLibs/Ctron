// gui_parse.ct —— gui 域包·解析面(gui.ct 拆分阶段二①;2026-09-27 拆分规划)
//
// 内容:迷你词法(gws/gword/glit/gstr/gspan)+ GuiTree 结构 + CTML 解析核心
// (gt_new/gt_bx_*/gt_slot_simple/gt_attrs/gt_leaf_text/gt_cond_pick/gt_node/
// gt_style/gt_props_names)+ GUI-27 跨文件 view 导入锚合并(gt_anchor_*)+
// gt_parse/gt_ext_resolve/gt_sk_has/sk_dump/gt_cls_prop/gt_dim。
// 无 use 行:扁平视图名字解析是全局的(门面 use 本文件后,跨文件引用在
// 合并视图上解析;闭包 keep 集自动携带被引用符号)。
// 消费:gui.ct 门面 use gui.gui_parse.{gt_parse, gt_anchor_src, sk_dump, GuiTree}。

// ==================== 迷你词法(同步自 s6/s7) ====================

fn gws(src: Str, cur: Atomic[I32]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        var b: I32 = byte_at(src, cur.load())
        if b == 47 {
            if cur.load() + 1 < n {
                if byte_at(src, cur.load() + 1) == 47 {
                    cur.store(cur.load() + 2)
                    while cur.load() < n {
                        if byte_at(src, cur.load()) == 10 {
                            break
                        }
                        cur.store(cur.load() + 1)
                    }
                    continue
                }
            }
        }
        if b == 32 {
            cur.store(cur.load() + 1)
        } else {
            if b == 10 {
                cur.store(cur.load() + 1)
            } else {
                if b == 13 {
                    cur.store(cur.load() + 1)
                } else {
                    if b == 9 {
                        cur.store(cur.load() + 1)
                    } else {
                        return 0
                    }
                }
            }
        }
    }
    return 0
}

fn gword(src: Str, cur: Atomic[I32]) -> Str {
    gws(src, cur)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        var al: Bool = b >= 65 && b <= 90
        var low: Bool = b >= 97 && b <= 122
        var dg: Bool = b >= 48 && b <= 57
        if al {
            i += 1
        } else {
            if low {
                i += 1
            } else {
                if b == 95 {
                    i += 1
                } else {
                    if b == 45 {
                        i += 1
                    } else {
                        if dg {
                            i += 1
                        } else {
                            break
                        }
                    }
                }
            }
        }
    }
    cur.store(i)
    if i > start {
        return byte_slice(src, start, i)
    }
    panic("gui: 期待标识符 @byte " + cur.load().to_string())
    return ""
}

fn glit(src: Str, cur: Atomic[I32], c: I32) -> I32 {
    gws(src, cur)
    if byte_at(src, cur.load()) != c {
        var around: Str = "?"
        if cur.load() > 40 {
            around = byte_slice(src, cur.load() - 40, cur.load())
        } else {
            around = byte_slice(src, 0, cur.load())
        }
        panic("gui: 期待字符码 " + c.to_string() + " @byte " + cur.load().to_string() + " srclen=" + src.len.to_string() + " 前文=[" + around + "]")
    }
    cur.store(cur.load() + 1)
    return 0
}

fn gstr(src: Str, cur: Atomic[I32]) -> Str {
    glit(src, cur, 34)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == 34 {
            break
        }
        i += 1
    }
    cur.store(i + 1)
    return byte_slice(src, start, i)
}

fn gspan(src: Str, cur: Atomic[I32], stop: I32) -> Str {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == stop {
            break
        }
        i += 1
    }
    var e: I32 = i
    while start < e {
        var c0w: I32 = byte_at(src, start)
        if c0w == 32 {
            start += 1
        } else {
            if c0w == 10 {
                start += 1
            } else {
                if c0w == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    while e > start {
        var c1: I32 = byte_at(src, e - 1)
        if c1 == 32 {
            e -= 1
        } else {
            if c1 == 10 {
                e -= 1
            } else {
                if c1 == 9 {
                    e -= 1
                } else {
                    break
                }
            }
        }
    }
    cur.store(i)
    if e > start {
        return byte_slice(src, start, e)
    }
    return ""
}

fn gt_new() -> GuiTree {
    return GuiTree {
        ntag: List[Str](),
        ncls: List[Str](),
        npre: List[Str](),
        nbid: List[Str](),
        npost: List[Str](),
        nfc: List[I32](),
        ns: List[I32](),
        nes: List[I32](),
        nec: List[I32](),
        ev_name: List[Str](),
        ev_fn: List[Str](),
        btns: List[I32](),
        sk: List[Str](),
        sv: List[Str](),
        nflag: List[Str](),
        props: List[Str](),
        vreg_name: List[Str](),
        vreg_root: List[I32](),
        vreg_ps: List[I32](),
        vreg_pn: List[I32](),
        vc_prop: List[Str](),
        vc_expr: List[Str](),
        vc_ps: List[I32](),
        vc_pn: List[I32](),
        env_n: List[Str](),
        env_v: List[Str]()
    }
}

// SL-8a:花括号槽表达式捕获(源字节面)——配对闭花括号下标;字符串字面量内
// 花括号不参与配对(转义 \" 不出串)。编译侧 token 直拼与本侧剥空白捕获同规范形。
fn gt_bx_end(src: Str, start: I32) -> I32 {
    var depth: I32 = 1
    var i: I32 = start
    var instr: Bool = false
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if b == 123 {
                    depth += 1
                } else {
                    if b == 125 {
                        depth -= 1
                        if depth == 0 {
                            return i
                        }
                    }
                }
            }
        }
        i += 1
    }
    return n
}

// [a,b) 剥空白规范化(字符串字面量内空白保留,转义对直纳)
fn gt_bx_strip(src: Str, a: I32, b: I32) -> Str {
    var out: Str = ""
    var i: I32 = a
    var instr: Bool = false
    while i < b {
        var c: I32 = byte_at(src, i)
        if instr {
            out = out + byte_slice(src, i, i + 1)
            if c == 92 {
                if i + 1 < b {
                    out = out + byte_slice(src, i + 1, i + 2)
                    i += 1
                }
            } else {
                if c == 34 {
                    instr = false
                }
            }
        } else {
            if c == 34 {
                instr = true
                out = out + byte_slice(src, i, i + 1)
            } else {
                if c == 32 || c == 9 || c == 10 || c == 13 {
                    out = out
                } else {
                    out = out + byte_slice(src, i, i + 1)
                }
            }
        }
        i += 1
    }
    return out
}

fn gt_bx_expr(src: Str, cur: Atomic[I32]) -> Str {
    var e: I32 = gt_bx_end(src, cur.load())
    var out: Str = gt_bx_strip(src, cur.load(), e)
    cur.store(e + 1)
    return out
}

// SL-8a:槽形态判——标识符/点链(名字查询通道直通)与否;含运算符的表达式槽
// 待 8b 求值器,运行时响亮 panic(不静默空渲染)
fn gt_slot_simple(v: Str) -> Bool {
    if v.len == 0 {
        return false
    }
    var i: I32 = 0
    while i < v.len {
        var b: I32 = byte_at(v, i)
        if b == 46 || b == 95 {
            i += 1
        } else {
            if b >= 48 {
                if b <= 57 {
                    i += 1
                } else {
                    if b >= 65 {
                        if b <= 90 {
                            i += 1
                        } else {
                            if b >= 97 {
                                if b <= 122 {
                                    i += 1
                                } else {
                                    return false
                                }
                            } else {
                                return false
                            }
                        }
                    } else {
                        return false
                    }
                }
            } else {
                return false
            }
        }
    }
    return true
}

fn gt_attrs(src: Str, cur: Atomic[I32], t: GuiTree, conds: List[Str], binds: List[Str], strs: List[Str]) -> Str {
    var out: Str = ""
    while true {
        gws(src, cur)
        var b: I32 = byte_at(src, cur.load())
        if b == 62 || b == 47 {
            // > 结束;/ = 自闭合标记(input/>,留给调用方消费)
            break
        }
        var an: Str = gword(src, cur)
        if an == "hover" {
            // S3:hover:名 裸属性——悬停态 bind 暴露(§2.4 显式扩展点):
            // 入事件表(name="hover",fn=名),渲染期注册,bind 询问钩消费
            glit(src, cur, 58)
            var hn7: Str = gword(src, cur)
            t.ev_name.push("hover")
            t.ev_fn.push(hn7)
        } else {
        if an == "password" {
            // input 变体:掩码显示(渲染期扫事件表;零 schema)
            t.ev_name.push("password")
            t.ev_fn.push("")
        } else {
        if an == "numeric" {
            // input 变体:数字过滤(退格/删除不受限)
            t.ev_name.push("numeric")
            t.ev_fn.push("")
        } else {
        if an == "switch" {
            // checkbox 变体:药丸滑块视觉(渲染期 rt_has_mark 消费;零 schema)
            t.ev_name.push("switch")
            t.ev_fn.push("")
        } else {
        if an == "radio" {
            // checkbox 变体:单选圆钮视觉(机制全同 checkbox,单选清他在模型)
            t.ev_name.push("radio")
            t.ev_fn.push("")
        } else {
        if an == "on" {
            glit(src, cur, 58)
            var evn: Str = gword(src, cur)
            glit(src, cur, 61)
            gws(src, cur)
            if byte_at(src, cur.load()) == 34 {
                // GUI-15:on:after="ms:handler" 引号串事件(定时;存活域一次性)
                var qv3: Str = gstr(src, cur)
                t.ev_name.push(evn)
                t.ev_fn.push(qv3)
                gws(src, cur)
                continue
            }
            glit(src, cur, 123)
            // SL-8c-3:事件表达式平衡捕获(编译侧 gui_bx_expr 同规范形;单标识符
            // 旧契约为其特例)——glit 已过 {,捕获消费至配对 }
            var fnn: Str = gt_bx_expr(src, cur)
            t.ev_name.push(evn)
            t.ev_fn.push(fnn)
        } else {
            glit(src, cur, 61)
            // 花括号属性值(cond={表达式}):SL-8a 平衡捕获+剥空白规范形
            var av: Str = ""
            if byte_at(src, cur.load()) == 123 {
                cur.store(cur.load() + 1)
                av = gt_bx_expr(src, cur)
            } else {
                av = gstr(src, cur)
            }
            if an == "class" {
                out = av
            }
            if an == "cond" {
                conds.push(av)
            }
            if an == "disabled" {
                // P-W3:button/checkbox 禁用态表达式(复用 cond 通道 → nflag;
                // 逐帧求值,真 = 命中表 -1 哨兵不可点)
                conds.push(av)
            }
            if an == "bind" {
                binds.push(av)
            }
            if an == "checked" {
                // checkbox 选中态表达式(值形态同 bind 槽;SL-8b 求值器消费)
                binds.push(av)
            }
            if an == "placeholder" {
                strs.push(av)
            }
            if an == "src" {
                // 波次五a:image 源路径(与 placeholder 同 strs 槽位;各自元素取用)
                strs.push(av)
            }
        }
        }
        }
        }
        }
        }
    }
    return out
}

fn gt_leaf_text(src: Str, cur: Atomic[I32], t: GuiTree) -> I32 {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 123 {
            break
        }
        if b == 60 {
            break
        }
        i += 1
    }
    var e: I32 = i
    var has_bind: Bool = false
    if i < n {
        if byte_at(src, i) == 123 {
            has_bind = true
        }
    }
    while start < e {
        var c0t: I32 = byte_at(src, start)
        if c0t == 32 {
            start += 1
        } else {
            if c0t == 10 {
                start += 1
            } else {
                if c0t == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    if !has_bind {
        while e > start {
            var c1: I32 = byte_at(src, e - 1)
            if c1 == 32 {
                e -= 1
            } else {
                if c1 == 10 {
                    e -= 1
                } else {
                    if c1 == 9 {
                        e -= 1
                    } else {
                        break
                    }
                }
            }
        }
    }
    var p0: Str = ""
    if e > start {
        p0 = byte_slice(src, start, e)
    }
    cur.store(i)
    var b: Str = ""
    var p1: Str = ""
    if has_bind {
        cur.store(cur.load() + 1)
        b = gt_bx_expr(src, cur)
        p1 = gspan(src, cur, 60)
    }
    t.npre.push(p0)
    t.nbid.push(b)
    t.npost.push(p1)
    return 0
}


// 本节点 cond 名(cstart 后最后一个;无 = "")
fn gt_cond_pick(conds: List[Str], cstart: I32) -> Str {
    if conds.len > cstart {
        return conds[conds.len - 1]
    }
    return ""
}

fn gt_node(src: Str, cur: Atomic[I32], t: GuiTree, conds: List[Str], binds: List[Str], strs: List[Str], depth: I32) -> I32 {
    glit(src, cur, 60)
    var tag: Str = gword(src, cur)
    // 波次四:ViewCall(大写首字母 = 组件实例)——props 形如 `名: 表达式`
    // (冒号分隔,引号串/裸词/花括号表达式三形);自闭合或带子树皆收口
    var fb: I32 = byte_at(tag, 0)
    if fb >= 65 {
        if fb <= 90 {
            var vps: I32 = t.vc_prop.len
            while true {
                gws(src, cur)
                var ab: I32 = byte_at(src, cur.load())
                if ab == 62 || ab == 47 {
                    break
                }
                var pn: Str = gword(src, cur)
                // W1a:分隔符 :/= 双收(冒号形 legacy;值三形不变)
                gws(src, cur)
                var sep: I32 = byte_at(src, cur.load())
                if sep != 58 {
                    if sep != 61 {
                        panic("gui: 实例 prop 期待 : 或 = @byte " + cur.load().to_string())
                    }
                }
                cur.store(cur.load() + 1)
                gws(src, cur)
                var pv: Str = ""
                if byte_at(src, cur.load()) == 34 {
                    // 字面串:0x01 哨兵前缀(展开期直取,不经表达式求值)
                    pv = utf8_enc(1) + gstr(src, cur)
                } else {
                    if byte_at(src, cur.load()) == 123 {
                        cur.store(cur.load() + 1)
                        pv = gt_bx_expr(src, cur)
                    } else {
                        pv = gword(src, cur)
                    }
                }
                t.vc_prop.push(pn)
                t.vc_expr.push(pv)
            }
            if byte_at(src, cur.load()) == 47 {
                glit(src, cur, 47)
                // 自闭合:<Badge ... />——无投影子树
                glit(src, cur, 62)
                t.ntag.push("call:" + tag)
                t.ncls.push("")
                // 区间存节点自有槽(扁平表不能按节点 id 寻址——垃圾读数实证)
                t.npre.push(vps.to_string())
                t.nbid.push((t.vc_prop.len - vps).to_string())
                t.npost.push("")
                t.nfc.push(-1)
                t.ns.push(-1)
                t.nes.push(t.ev_name.len)
                t.nec.push(0)
                t.nflag.push("")
                return t.ntag.len - 1
            }
            glit(src, cur, 62)
            // P2 投影实例:<Badge ...> 子树 </Badge>——子树链接到实例节点,
            // 展开期在组件体 <slot/> 锚位拼接(宿主内容保宿主语义:bind/事件
            // 全按主文件解析,s50 锁定)
            t.ntag.push("call:" + tag)
            t.ncls.push("")
            t.npre.push(vps.to_string())
            t.nbid.push((t.vc_prop.len - vps).to_string())
            t.npost.push("")
            t.nfc.push(-1)
            t.ns.push(-1)
            t.nes.push(t.ev_name.len)
            t.nec.push(0)
            t.nflag.push("")
            var vid: I32 = t.ntag.len - 1
            var prev: I32 = -1
            while true {
                gws(src, cur)
                if byte_at(src, cur.load()) == 60 {
                    if byte_at(src, cur.load() + 1) == 47 {
                        break
                    }
                }
                var kid: I32 = gt_node(src, cur, t, conds, binds, strs, depth + 1)
                var fcl: List[I32] = t.nfc
                var nsl: List[I32] = t.ns
                if prev < 0 {
                    fcl[vid] = kid
                } else {
                    nsl[prev] = kid
                }
                prev = kid
            }
            glit(src, cur, 60)
            glit(src, cur, 47)
            var et3: Str = gword(src, cur)
            if et3 != tag {
                panic("gui: 闭合标签不匹配 " + et3)
            }
            glit(src, cur, 62)
            return vid
        }
    }
    var is_leaf: Bool = false
    if tag == "label" {
        is_leaf = true
    }
    if tag == "button" {
        is_leaf = true
    }
    var is_when: Bool = false
    if tag == "when" {
        is_when = true
    }
    var is_each: Bool = false
    if tag == "each" {
        is_each = true
    }
    var is_input: Bool = false
    if tag == "input" {
        is_input = true
    }
    var is_check: Bool = false
    if tag == "checkbox" {
        is_check = true
    }
    var is_ov: Bool = false
    if tag == "overlay" {
        is_ov = true
    }
    var is_img: Bool = false
    if tag == "image" {
        is_img = true
    }
    var is_ta: Bool = false
    if tag == "textarea" {
        is_ta = true
    }
    if !is_leaf {
        if !is_when {
            if !is_each {
                if !is_input {
                    if !is_ta {
                        if !is_check {
                            if !is_img {
                                if !is_ov {
                                    if tag != "vbox" {
                                        if tag != "hbox" {
                                            if tag != "spacer" {
                                                if tag != "scroll" {
                                                    if tag != "slot" {
                                                        panic("gui: 未知元素 " + tag)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if !is_leaf {
        if depth >= 16 {
            panic("gui: 嵌套超限(16)")
        }
    }
    var itemvar: Str = ""
    var listname: Str = ""
    if is_each {
        // 头:item in={列表表达式}(先于 attrs;SL-8a 平衡捕获)
        itemvar = gword(src, cur)
        var inkw: Str = gword(src, cur)
        if inkw != "in" {
            panic("gui: each 期待 in,得 " + inkw)
        }
        glit(src, cur, 61)
        glit(src, cur, 123)
        listname = gt_bx_expr(src, cur)
        gws(src, cur)
    }
    var estart: I32 = t.ev_name.len
    var cstart: I32 = conds.len
    var bstart: I32 = binds.len
    var sstart: I32 = strs.len
    var c: Str = gt_attrs(src, cur, t, conds, binds, strs)
    var id: I32 = t.ntag.len
    if is_input {
        // 自闭合:<input ... />;bind 名 → nbid,placeholder → npre
        glit(src, cur, 47)
        glit(src, cur, 62)
        var ph: Str = ""
        if strs.len > sstart {
            ph = strs[strs.len - 1]
        }
        var bn: Str = ""
        if binds.len > bstart {
            bn = binds[binds.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(ph)
        t.nbid.push(bn)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        return id
    }
    if is_img {
        // 自闭合:<image src="路径" class ... />(§2.6);src → npre
        glit(src, cur, 47)
        glit(src, cur, 62)
        var sn: Str = ""
        if strs.len > sstart {
            sn = strs[strs.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(sn)
        t.nbid.push("")
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        return id
    }
    if is_ta {
        // 自闭合:<textarea bind={名} placeholder="..." ... />(§2.10 P2;多行文本)
        glit(src, cur, 47)
        glit(src, cur, 62)
        var pht: Str = ""
        if strs.len > sstart {
            pht = strs[strs.len - 1]
        }
        var bnt: Str = ""
        if binds.len > bstart {
            bnt = binds[binds.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(pht)
        t.nbid.push(bnt)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        return t.ntag.len - 1
    }
    if is_check {
        // 自闭合:<checkbox checked={表达式} ... />;checked → nbid;登记可点击
        glit(src, cur, 47)
        glit(src, cur, 62)
        var bn: Str = ""
        if binds.len > bstart {
            bn = binds[binds.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push("")
        t.nbid.push(bn)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        t.btns.push(id)
        return id
    }
    if byte_at(src, cur.load()) == 47 {
        // 自闭合空元素(spacer 等,§4.2 内建集):attrs 后 "/>" 即收口无子树
        glit(src, cur, 47)
        glit(src, cur, 62)
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(listname)
        t.nbid.push(itemvar)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        return id
    }
    glit(src, cur, 62)
    if is_leaf {
        // GUI:button 带子树形态(多列单元格行/图标按钮)——子树容器式解析,
        // btns 注册照旧;显示侧按钮分支不关盒,子经共享尾循环落按钮盒内
        gws(src, cur)
        var childmode: Bool = false
        if byte_at(src, cur.load()) == 60 {
            if byte_at(src, cur.load() + 1) != 47 {
                childmode = true
            }
        }
        if childmode {
            t.ntag.push(tag)
            t.ncls.push(c)
            t.npre.push("")
            t.nbid.push("")
            t.npost.push("")
            t.nfc.push(-1)
            t.ns.push(-1)
            t.nes.push(estart)
            t.nec.push(t.ev_name.len - estart)
            t.nflag.push(gt_cond_pick(conds, cstart))
            var prevk: I32 = -1
            while true {
                gws(src, cur)
                if byte_at(src, cur.load()) == 60 {
                    if byte_at(src, cur.load() + 1) == 47 {
                        break
                    }
                }
                var kid: I32 = gt_node(src, cur, t, conds, binds, strs, depth + 1)
                var fcl: List[I32] = t.nfc
                var nsl: List[I32] = t.ns
                if prevk < 0 {
                    fcl[id] = kid
                } else {
                    nsl[prevk] = kid
                }
                prevk = kid
            }
            glit(src, cur, 60)
            glit(src, cur, 47)
            var et3: Str = gword(src, cur)
            if et3 != tag {
                panic("gui: 闭合标签不匹配 " + et3)
            }
            glit(src, cur, 62)
            if tag == "button" {
                t.btns.push(id)
            }
            return id
        }
        gt_leaf_text(src, cur, t)
        t.ntag.push(tag)
        t.ncls.push(c)
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        glit(src, cur, 60)
        glit(src, cur, 47)
        var et: Str = gword(src, cur)
        if et != tag {
            panic("gui: 闭合标签不匹配 " + et)
        }
        glit(src, cur, 62)
        if tag == "button" {
            t.btns.push(id)
        }
    } else {
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(listname)
        t.nbid.push(itemvar)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        var prev: I32 = -1
        while true {
            gws(src, cur)
            if byte_at(src, cur.load()) == 60 {
                if byte_at(src, cur.load() + 1) == 47 {
                    break
                }
            }
            var kid: I32 = gt_node(src, cur, t, conds, binds, strs, depth + 1)
            // 成员链索引赋值(t.nfc[id]=…)解释口径不支持(assign target:Index),
            // 取局部引用中转——List 引用语义下同一底层列表(SL-2v 实证配方)
            var fcl: List[I32] = t.nfc
            var nsl: List[I32] = t.ns
            if prev < 0 {
                fcl[id] = kid
            } else {
                nsl[prev] = kid
            }
            prev = kid
        }
        glit(src, cur, 60)
        glit(src, cur, 47)
        var et2: Str = gword(src, cur)
        if et2 != tag {
            panic("gui: 闭合标签不匹配 " + et2)
        }
        glit(src, cur, 62)
    }
    return id
}

fn gt_style(src: Str, cur: Atomic[I32], t: GuiTree, ext: List[Str]) -> I32 {
    var name: Str = gword(src, cur)
    gws(src, cur)
    // P-W2:extends 单亲派生(§5 StyleExt,仅限本文件)——记 (child, parent) 对
    if cur.load() < src.len {
        if byte_at(src, cur.load()) == 101 {
            var kw: Str = gword(src, cur)
            if kw == "extends" {
                gws(src, cur)
                var pn: Str = gword(src, cur)
                ext.push(name)
                ext.push(pn)
                gws(src, cur)
            }
        }
    }
    glit(src, cur, 123)
    while true {
        gws(src, cur)
        if byte_at(src, cur.load()) == 125 {
            break
        }
        var p: Str = gword(src, cur)
        glit(src, cur, 58)
        gws(src, cur)
        var v: Str = ""
        if byte_at(src, cur.load()) == 34 {
            v = gstr(src, cur)
        } else {
            v = gtok_mark(gword(src, cur))
        }
        t.sk.push(name + "." + p)
        t.sv.push(v)
        gws(src, cur)
        if byte_at(src, cur.load()) == 59 {
            glit(src, cur, 59)
        }
    }
    glit(src, cur, 125)
    return 0
}

// SL-8c-2:view props 形参段("a: T" 逗号分隔,括号已剥)取名入 t.props——
// 冒号前段剥空白;与编译侧 gui_props_names 同名表(s22 双端差分)
fn gt_props_names(seg: Str, t: GuiTree) -> I32 {
    var pi: I32 = 0
    while pi < seg.len {
        var ps: I32 = pi
        while pi < seg.len {
            if byte_at(seg, pi) == 44 {
                break
            }
            pi += 1
        }
        var unit: Str = byte_slice(seg, ps, pi)
        var ui: I32 = 0
        while ui < unit.len {
            if byte_at(unit, ui) == 58 {
                var pn: Str = byte_slice(unit, 0, ui)
                var pe: I32 = pn.len
                while pe > 0 {
                    var pc: I32 = byte_at(pn, pe - 1)
                    if pc == 32 || pc == 9 {
                        pe -= 1
                    } else {
                        break
                    }
                }
                var psi: I32 = 0
                while psi < pe {
                    if byte_at(pn, psi) != 32 && byte_at(pn, psi) != 9 {
                        break
                    }
                    psi += 1
                }
                if pe > psi {
                    t.props.push(byte_slice(pn, psi, pe))
                }
                ui = unit.len
            }
            ui += 1
        }
        pi += 1
    }
    return 0
}

// ==================== GUI-27:跨文件 view 导入(锚合并) ====================
// 规格 §4.3.1:pub view 导出 + use mod.Name 导入。运行时合并 = DFS
// imports-先-自身-后(应用根=最后声明视图契约保持),文本级拼接(运行时
// 解析无行:列,零位置顾虑);路径集环守卫;缺文件跳过(红归检查面)。
// 无 use 行文件字节恒等 = 热重载/内嵌兜底回归保障(w4/s26 口径)。

fn gt_anchor_dir(p: Str) -> Str {
    var i: I32 = p.len - 1
    while i >= 0 {
        if byte_at(p, i) == 47 {
            return byte_slice(p, 0, i)
        }
        i -= 1
    }
    return ""
}

fn gt_anchor_join(dir: Str, mod: Str) -> Str {
    if dir.len == 0 {
        return mod + ".ctml"
    }
    return dir + "/" + mod + ".ctml"
}

// 顶层 use 行模块名提取(行式;串/注释感知,{} 深度>0 不采;模块 = 首段)
fn gt_anchor_uses(src: Str, out: List[Str]) -> I32 {
    var n: I32 = src.len
    var i: I32 = 0
    var depth: I32 = 0
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 34 {
            i += 1
            while i < n {
                if byte_at(src, i) == 92 {
                    i += 2
                    continue
                }
                if byte_at(src, i) == 34 {
                    i += 1
                    break
                }
                i += 1
            }
            continue
        }
        if b == 47 {
            if i + 1 < n {
                if byte_at(src, i + 1) == 47 {
                    while i < n {
                        if byte_at(src, i) == 10 {
                            break
                        }
                        i += 1
                    }
                    continue
                }
            }
        }
        if b == 123 {
            depth += 1
        }
        if b == 125 {
            if depth > 0 {
                depth -= 1
            }
        }
        if depth == 0 {
            if b == 117 {
                if i + 4 <= n {
                    // "use"+空白 才算导入行("user" 等词不误采)
                    if byte_at(src, i + 1) == 115 {
                        if byte_at(src, i + 2) == 101 {
                            var nb: I32 = byte_at(src, i + 3)
                            if nb == 32 || nb == 9 {
                                var pb: I32 = 10
                                if i > 0 {
                                    pb = byte_at(src, i - 1)
                                }
                                if pb == 10 || pb == 9 || pb == 32 || pb == 13 {
                                    var j: I32 = i + 4
                                    while j < n {
                                        var wb: I32 = byte_at(src, j)
                                        if wb == 32 || wb == 9 {
                                            j += 1
                                            continue
                                        }
                                        break
                                    }
                                    var s: I32 = j
                                    while j < n {
                                        var mb: I32 = byte_at(src, j)
                                        if mb == 46 || mb == 123 || mb == 32 || mb == 9 || mb == 10 || mb == 13 {
                                            break
                                        }
                                        j += 1
                                    }
                                    if j > s {
                                        out.push(byte_slice(src, s, j))
                                    }
                                    while i < n {
                                        if byte_at(src, i) == 10 {
                                            break
                                        }
                                        i += 1
                                    }
                                    continue
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    return 0
}

fn gt_anchor_walk(path: Str, seen: List[Str], out: List[Str]) -> I32 {
    var si: I32 = 0
    while si < seen.len {
        if seen[si] == path {
            return 0
        }
        si += 1
    }
    var text: Str = read_file(path)
    if text == "" {
        return 0
    }
    seen.push(path)
    var mods = List[Str]()
    gt_anchor_uses(text, mods)
    var dir: Str = gt_anchor_dir(path)
    var mi: I32 = 0
    while mi < mods.len {
        gt_anchor_walk(gt_anchor_join(dir, mods[mi]), seen, out)
        mi += 1
    }
    out.push(text)
    return 0
}

// 锚合并源:入口 ctml + 其 use 闭包的合并文本(热重载探针同源)。
// 无 use 行 = 与 read_file 字节恒等(单文件零迁移)
pub fn gt_anchor_src(anchor: Str) -> Str {
    var out = List[Str]()
    var seen = List[Str]()
    gt_anchor_walk(anchor, seen, out)
    var src: Str = ""
    var i: I32 = 0
    while i < out.len {
        if i > 0 {
            src = src + "\n"
        }
        src = src + out[i]
        i += 1
    }
    return src
}

pub fn gt_parse(src: Str) -> GuiTree {
    var t: GuiTree = gt_new()
    var binds = List[Str]()
    var strs = List[Str]()
    var conds = List[Str]()
    var ext = List[Str]()
    var cur = Atomic[I32](0)
    var n: I32 = src.len
    while cur.load() < n {
        gws(src, cur)
        if cur.load() >= n {
            break
        }
        var w: Str = gword(src, cur)
        // GUI-27:pub 导出标记吞并(pub 后必 view/style);use 导入行跳读至行尾
        if w == "pub" {
            w = gword(src, cur)
        }
        if w == "use" {
            while cur.load() < n {
                if byte_at(src, cur.load()) == 10 {
                    break
                }
                cur.store(cur.load() + 1)
            }
        } else {
        if w == "view" {
            var vname: Str = gword(src, cur)
            gws(src, cur)
            // 波次四:vreg_ps 须在 props 捕获之前装订(否则 pn 恒 0——实测坑)
            t.vreg_name.push(vname)
            t.vreg_root.push(t.ntag.len)
            t.vreg_ps.push(t.props.len)
            // 8c-2:view props 形参表捕获——"( a: T, b: U )" 平衡圆括号内
            // 逐逗号段取名(冒号前,剥空白)入 t.props(与编译侧 gui_props_names
            // 同名表;s22 双端差分)
            if cur.load() < n {
                if byte_at(src, cur.load()) == 40 {
                    var pd: I32 = 0
                    var us: I32 = -1
                    while cur.load() < n {
                        var pb: I32 = byte_at(src, cur.load())
                        if pb == 40 {
                            pd += 1
                            if pd == 1 {
                                us = cur.load() + 1
                            }
                        } else {
                            if pb == 41 {
                                pd -= 1
                                if pd == 0 {
                                    gt_props_names(byte_slice(src, us, cur.load()), t)
                                    cur.store(cur.load() + 1)
                                    break
                                }
                            }
                        }
                        cur.store(cur.load() + 1)
                    }
                    gws(src, cur)
                }
            }
            glit(src, cur, 123)
            gt_node(src, cur, t, conds, binds, strs, 1)
            gws(src, cur)
            glit(src, cur, 125)
            t.vreg_pn.push(t.props.len - t.vreg_ps[t.vreg_ps.len - 1])
        } else {
            if w == "style" {
                gt_style(src, cur, t, ext)
            } else {
                panic("gui: 顶层仅 view/style,得 " + w)
            }
        }
        }
    }
    gt_ext_resolve(t, ext)
    return t
}

// P-W2:extends 解析——定点迭代把父类属性复制到子类(子已定义者不覆盖;
// 链式派生随迭代收敛,守护 16 轮);父链走查超限 = 环,panic。
fn gt_ext_resolve(t: GuiTree, ext: List[Str]) -> I32 {
    // 环检测:每个 child 沿父链上行;走满 ext 对数仍未到根 = 环
    var ci: I32 = 0
    while ci < ext.len {
        var cur: Str = ext[ci]
        var step: I32 = 0
        var cyc: Bool = true
        while step <= ext.len {
            var found: Bool = false
            var pi: I32 = 0
            while pi < ext.len {
                if ext[pi] == cur {
                    cur = ext[pi + 1]
                    found = true
                    pi = ext.len
                }
                pi += 2
            }
            if !found {
                cyc = false
                step = ext.len + 1
            }
            step += 1
        }
        if cyc {
            panic("gui: 样式 extends 环 " + ext[ci])
        }
        ci += 2
    }
    // 属性复制:定点迭代(g→p→c 链式随轮次收敛)
    var changed: Bool = true
    var guard: I32 = 0
    while changed {
        changed = false
        guard += 1
        if guard > 16 {
            break
        }
        var pi: I32 = 0
        while pi < ext.len {
            var child: Str = ext[pi]
            var parent: Str = ext[pi + 1]
            var pp: Str = parent + "."
            var si: I32 = 0
            while si < t.sk.len {
                var k: Str = t.sk[si]
                if k.len > pp.len {
                    if byte_slice(k, 0, pp.len) == pp {
                        var pname: Str = byte_slice(k, pp.len, k.len)
                        var ck: Str = child + "." + pname
                        if !gt_sk_has(t.sk, ck) {
                            t.sk.push(ck)
                            t.sv.push(t.sv[si])
                            changed = true
                        }
                    }
                }
                si += 1
            }
            pi += 2
        }
    }
    return 0
}

fn gt_sk_has(sk: List[Str], key: Str) -> Bool {
    var i: I32 = 0
    while i < sk.len {
        if sk[i] == key {
            return true
        }
        i += 1
    }
    return false
}

// SL-7β1:骨架表倾倒(与编译器 gui_parse gui_sk_dump_all 同格式,等价差分用)。
// 行口径:n<id> tag= cls= pre= bid= post= flag= fc= ns= es= ec=(空串以 - 表示);
// 之后 e<k> on= fn= 事件表 / btn id= 按钮表 / s 键=值 样式表,序 = push 序。
pub fn sk_dump(t: GuiTree) -> I32 {
    // SL-8c-2:props 名表行(首行;空 = -;与编译器 gui_sk_dump_all 同格式)
    var pline: Str = ""
    var pj: I32 = 0
    while pj < t.props.len {
        if pj > 0 {
            pline = pline + ","
        }
        pline = pline + t.props[pj]
        pj += 1
    }
    if pline == "" {
        pline = "-"
    }
    println("props=" + pline)
    var i: I32 = 0
    while i < t.ntag.len {
        var pre: Str = t.npre[i]
        if pre == "" {
            pre = "-"
        }
        var bid: Str = t.nbid[i]
        if bid == "" {
            bid = "-"
        }
        var post: Str = t.npost[i]
        if post == "" {
            post = "-"
        }
        var flag: Str = t.nflag[i]
        if flag == "" {
            flag = "-"
        }
        var cls: Str = t.ncls[i]
        if cls == "" {
            cls = "-"
        }
        println("n" + i.to_string() + " tag=" + t.ntag[i] + " cls=" + cls + " pre=" + pre + " bid=" + bid + " post=" + post + " flag=" + flag + " fc=" + t.nfc[i].to_string() + " ns=" + t.ns[i].to_string() + " es=" + t.nes[i].to_string() + " ec=" + t.nec[i].to_string())
        i += 1
    }
    var k: I32 = 0
    while k < t.ev_name.len {
        println("e" + k.to_string() + " on=" + t.ev_name[k] + " fn=" + t.ev_fn[k])
        k += 1
    }
    var b: I32 = 0
    while b < t.btns.len {
        println("btn id=" + t.btns[b].to_string())
        b += 1
    }
    var s: I32 = 0
    while s < t.sk.len {
        println("s " + t.sk[s] + "=" + t.sv[s])
        s += 1
    }
    println("sk-end")
    return 0
}

fn gt_cls_prop(classes: Str, prop: Str, dflt: Str, t: GuiTree) -> Str {
    var s: I32 = classes.len - 1
    while s >= 0 {
        var hit: Bool = false
        if s == 0 {
            hit = true
        } else {
            if byte_at(classes, s - 1) == 32 {
                hit = true
            }
        }
        if hit {
            var e: I32 = s
            while e < classes.len {
                if byte_at(classes, e) == 32 {
                    break
                }
                e += 1
            }
            var tok: Str = byte_slice(classes, s, e)
            var key: Str = tok + "." + prop
            var i: I32 = 0
            while i < t.sk.len {
                if t.sk[i] == key {
                    return t.sv[i]
                }
                i += 1
            }
        }
        s -= 1
    }
    return dflt
}

// GUI-16 值驱动宽高(v1):维度值 "{expr}" 形态逐帧求值——style 值以引号串
// 写花括号表达式(w: "{n}"),裸词保持字面量(词法 gword 不吃花括号,引号串
// 经 gstr 原样入表);产出经 gs2i 转整。v1 不做缓存:即时模式每帧重放,
// 小表达式成本可忽略(样式折叠缓存设计留完整面)。
fn gt_dim_v(t: GuiTree, v: Str, bind: fn(List[Str]) -> Void) -> I32 {
    if v.len >= 3 {
        if byte_at(v, 0) == 123 && byte_at(v, v.len - 1) == 125 {
            var r2: Str = bxv_eval(t, byte_slice(v, 1, v.len - 1), bind, "", "")
            // 内建名产出带标(i:/b:),裸串(bind 名)原样——解标后转整
            if bxv_istag(r2) {
                return bxv_iv(r2)
            }
            return gs2i(r2)
        }
    }
    return gs2i(v)
}

fn gt_dim(t: GuiTree, c: Str, prop: Str, dflt: Str, bind: fn(List[Str]) -> Void) -> I32 {
    return gt_dim_v(t, gt_cls_prop(c, prop, dflt, t), bind)
}
