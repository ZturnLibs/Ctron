// gui.ct —— gui 域包(L1;规范 §10 形态的 SL-1 过渡桥)
// 用户代码形态:
//   use gui.{run_kb}
//   fn main() -> I32 {
//       var src: Str = read_file("app.ctml")   // 发射锚(CWD 相对;L2 内嵌形态后消失)
//       var m = CalcModel()
//       rt_run_kb_src(src, "title", 320, 420,
//           |buf| buf.push(m.disp),            // 绑定:buf[0]=名 → push 值
//           |name| dispatch(name, m),          // 点击 → 动作名
//           |k| dispatch(keymap(k), m))        // 键盘(raylib 键码)
//       return 0
//   }
// 通道口径(SL-0 实证):全部钩子 = F1 闭包(Void 返回;List/Str/I32 形参;Box 捕获)。
// Str 返回的 fn 值、零参 fn 类型、pub struct/extern 跨模块导出 = SL-0.6(登记);
// 门面+运行时核;主题面已拆 pkgs/gui_theme(gui_theme.ct),兄弟文件拆分按 2026-09-27 规划推进。
// 测试:test() 强制 headless(域库注入缝 + 命令缓冲断言),env 开关退出用户面。
// 主题面独立包(拆分阶段一):门面 re-export,消费面 use gui.{...} 不变
use gui_theme.{Theme, g_parse_alpha, gs2i, gtok_mark, gui_now, gui_os_dark, gui_platform,
               theme_apply, theme_auto, theme_auto_apply, theme_contrast, theme_default,
               theme_dark, theme_light, theme_linux_dark, theme_linux_light, theme_mac_dark,
               theme_mac_light, theme_win_dark, theme_win_light}

pub struct GuiTree {
    var ntag: List[Str]
    var nflag: List[Str]
    var ncls: List[Str]
    var npre: List[Str]
    var nbid: List[Str]
    var npost: List[Str]
    var nfc: List[I32]
    var ns: List[I32]
    var nes: List[I32]
    var nec: List[I32]
    var ev_name: List[Str]
    var ev_fn: List[Str]
    var btns: List[I32]
    var sk: List[Str]
    var sv: List[Str]
    var props: List[Str]
    var vreg_name: List[Str]
    var vreg_root: List[I32]
    var vreg_ps: List[I32]
    var vreg_pn: List[I32]
    var vc_prop: List[Str]
    var vc_expr: List[Str]
    var vc_ps: List[I32]
    var vc_pn: List[I32]
    var env_n: List[Str]
    var env_v: List[Str]
}

// ==================== 运行时(绑定求值/布局发射/命中/循环) ====================

fn rt_col_r(p: I32) -> I32 {
    return (p / 65536) % 256
}

fn rt_col_g(p: I32) -> I32 {
    return (p / 256) % 256
}

fn rt_col_b(p: I32) -> I32 {
    return p % 256
}

// 列表询问:buf[0] = "each:名",用户逐项 push 标题;返回项文本列表
pub fn rt_bind_items(t: GuiTree, bind: fn(List[Str]) -> Void, listname: Str) -> List[Str] {
    // P2 契约Ⅰ:组件列表 prop env 前置回落——展开期实例实参已垫 List 指针
    // (以 Str 槽穿环境,gui_is_list 魔数判+gui_as_list 恒等转接还原);未垫
    // 回落 bind 通道(宿主自有 each 通道口径不变)。组件视图的 each 通道数据
    // 源即实例实参,宿主合成 bind 无从供给(契约设计提案 Ⅰ)
    // gui_sk_load 编译骨架树不含 env 字段(NULL)——gui_list_ns NULL 门控
    // 先行(bxv_ask 同款先例);headless/真窗 gt_parse 树 env 恒在
    if gui_list_ns(t.env_n) > 0 {
        if gui_list_ns(t.env_v) > 0 {
            var ei: I32 = t.env_n.len - 1
            while ei >= 0 {
                if t.env_n[ei] == listname {
                    if gui_is_list(t.env_v[ei]) == 1 {
                        return gui_as_list(t.env_v[ei])
                    }
                }
                ei -= 1
            }
        }
    }
    // typed-props:struct 根组合——listname 根为 \x02 marker(组件 prop 根
    // 为 struct 引用)时走 eachobj 通道(生成侧 items 臂应答子 marker 串);
    // 非 marker 零改动。env NULL 门控沿 gui_list_ns 先例
    if gui_list_ns(t.env_n) > 0 {
        if gui_list_ns(t.env_v) > 0 {
            if listname.len > 1 {
                var lr: Str = bxv_root(listname)
                var lei: I32 = t.env_n.len - 1
                while lei >= 0 {
                    if t.env_n[lei] == lr {
                        var lv: Str = t.env_v[lei]
                        if lv.len > 1 {
                            if byte_at(lv, 0) == 2 {
                                if listname.len > lr.len {
                                    return rt_bind_obj_items(bind, "eachobj:" + byte_slice(lv, 1, lv.len) + "." + byte_slice(listname, lr.len + 1, listname.len))
                                }
                            }
                        }
                        lei = -1
                    }
                    lei -= 1
                }
            }
        }
    }
    var buf = List[Str]()
    buf.push("each:" + listname)
    bind(buf)
    var out = List[Str]()
    var i: I32 = 1
    while i < buf.len {
        out.push(buf[i])
        i += 1
    }
    return out
}

// typed-props:obj 查询(生成侧 bind obj:/eachobj: 首臂应答;无臂回 ""=通道口径)
fn rt_bind_obj(bind: fn(List[Str]) -> Void, q: Str) -> Str {
    var buf = List[Str]()
    buf.push(q)
    bind(buf)
    if buf.len > 1 {
        return buf[buf.len - 1]
    }
    return ""
}

// typed-props:eachobj 查询(子节点/标量项多项应答;buf[1..] 逐项收集)
fn rt_bind_obj_items(bind: fn(List[Str]) -> Void, q: Str) -> List[Str] {
    var buf = List[Str]()
    buf.push(q)
    bind(buf)
    var out = List[Str]()
    var i: I32 = 1
    while i < buf.len {
        out.push(buf[i])
        i += 1
    }
    return out
}

fn rt_bind_text(bind: fn(List[Str]) -> Void, name: Str) -> Str {
    // S3:hover:名 询问钩——悬停值属运行时(先于应用 bind;1 帧滞后)。
    // when={名} 简单槽问 "when:名"(剥前缀查表)
    var hvn: Str = name
    if hvn.len > 5 {
        if byte_at(hvn, 0) == 119 && byte_at(hvn, 1) == 104 && byte_at(hvn, 2) == 101 && byte_at(hvn, 3) == 110 && byte_at(hvn, 4) == 58 {
            hvn = byte_slice(hvn, 5, hvn.len)
        }
    }
    var hvq: I32 = gui_hover_bind_get(hvn)
    if hvq >= 0 {
        // when: 通道值契约 = "1"/"0"(fv != "1" 即隐藏);bxv 裸名 = b: 打标
        if hvn != name {
            if hvq == 1 {
                return "1"
            }
            return "0"
        }
        if hvq == 1 {
            return "b:1"
        }
        return "b:0"
    }
    var buf = List[Str]()
    buf.push(name)
    bind(buf)
    if buf.len > 1 {
        return buf[buf.len - 1]
    }
    return ""
}

