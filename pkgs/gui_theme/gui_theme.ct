fn gtok_index(w: Str) -> I32 {
    // 槽序 = 规格 §3.1 令牌序 = Theme 字段序(0-13 色 packed,14-24 尺寸 I32)
    if w == "BG_BASE" { return 0 }
    if w == "SURFACE" { return 1 }
    if w == "ELEVATED" { return 2 }
    if w == "BORDER" { return 3 }
    if w == "BORDER_STRONG" { return 4 }
    if w == "TEXT" { return 5 }
    if w == "TEXT_MUTED" { return 6 }
    if w == "ACCENT" { return 7 }
    if w == "ACCENT_HOVER" { return 8 }
    if w == "DANGER" { return 9 }
    if w == "SUCCESS" { return 10 }
    if w == "MASK" { return 11 }
    if w == "DISABLED_FG" { return 12 }
    if w == "DISABLED_BG" { return 13 }
    if w == "RADIUS_SM" { return 14 }
    if w == "RADIUS_MD" { return 15 }
    if w == "RADIUS_LG" { return 16 }
    if w == "SIZE_XS" { return 17 }
    if w == "SIZE_SM" { return 18 }
    if w == "SIZE_MD" { return 19 }
    if w == "SIZE_LG" { return 20 }
    if w == "SIZE_XL" { return 21 }
    if w == "SPACE_SM" { return 22 }
    if w == "SPACE_MD" { return 23 }
    if w == "SPACE_LG" { return 24 }
    return -1
}

// 存储期两段式(§2.4):令牌名 → "@槽位" 标记;折叠期 gs2i/g_parse_color 见 @ 直读槽
pub fn gtok_mark(w: Str) -> Str {
    var i: I32 = gtok_index(w)
    if i >= 0 {
        return "@" + i.to_string()
    }
    return w
}

fn gtok_slot(v: Str) -> I32 {
    var r: I32 = 0
    var i: I32 = 1
    while i < v.len {
        r = r * 10 + (byte_at(v, i) - 48)
        i += 1
    }
    return r
}

fn g_parse_color(v: Str) -> I32 {
    if v.len > 1 {
        if byte_at(v, 0) == 64 {
            return gui_theme_slot_get(gtok_slot(v))
        }
    }
    if byte_at(v, 0) == 35 {
        if v.len != 7 {
            if v.len != 9 {
                panic("gui: 颜色须 #RRGGBB(A),得 " + v)
            }
        }
        var r: I32 = ghex1(byte_at(v, 1)) * 16 + ghex1(byte_at(v, 2))
        var g: I32 = ghex1(byte_at(v, 3)) * 16 + ghex1(byte_at(v, 4))
        var b: I32 = ghex1(byte_at(v, 5)) * 16 + ghex1(byte_at(v, 6))
        return r * 65536 + g * 256 + b
    }
    panic("gui: 未知颜色令牌 " + v)
    return 0
}

// 8 位色 alpha 通道(§7;C1 修订=#RRGGBB(A)):len 9 取末两位十六进制,6 位=255
// color_parse:hex 颜色串 → 打包色(GUI-39 pub 面;#RRGGBB 检查面同款语义)
pub fn color_parse(hex: Str) -> I32 {
    return g_parse_color(hex)
}

pub fn g_parse_alpha(v: Str) -> I32 {
    if v.len == 9 {
        if byte_at(v, 0) == 35 {
            return ghex1(byte_at(v, 7)) * 16 + ghex1(byte_at(v, 8))
        }
    }
    return 255
}

pub fn gs2i(s: Str) -> I32 {
    if s.len > 1 {
        if byte_at(s, 0) == 64 {
            return gui_theme_slot_get(gtok_slot(s))
        }
    }
    var v: I32 = 0
    var i: I32 = 0
    while i < s.len {
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    }
    return v
}
