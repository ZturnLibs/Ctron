// proc/bind.ct —— ctron_proc.c 垫片 extern 面(lib/proc;CW-F3b 2026-10-09)
// 纪律(net/crypto/fio bind 同款):参数表单行;blob = var U8[](NUL 分隔 argv 块,
// 首段 = 程序路径,逻辑长度 n 显式传);可见性 = `pub extern`。
// rc 口径:run 族 = 退出码(-1 fork/chdir/管道败,127 exec 失败);spawn_bg = pid/-1;
// wait = 退出码(信号杀 = -1)。
pub extern "c" fn ctron_proc_run(cwd: Str, bin: Str, arg: Str, var out: U8[]) -> I32
pub extern "c" fn ctron_proc_run_argv(cwd: Str, var blob: U8[], n: I64, var out: U8[]) -> I32
pub extern "c" fn ctron_proc_spawn_bg(cwd: Str, bin: Str, arg: Str, err_path: Str) -> I64
pub extern "c" fn ctron_proc_kill(pid: I64) -> I32
pub extern "c" fn ctron_proc_wait(pid: I64) -> I32

// 工具面原语(git 桥等):execvp(PATH 查找)+ stdin 重定向 + 可选捕获。
// capture = 0 → stdout 继承(rc 型面;截断管道会 SIGPIPE 误杀长输出——不建管道);
// capture > 0 → 捕获至 out 容量,out_len 回实捕字节数(&ProcBox64 裸指针出参,
// net.bind Box64 同款镜像 ABI 纪律;struct 声明留本文件)。
pub struct ProcBox64 {
    var v: I64
}
pub extern "c" fn ctron_proc_run_argv_p(cwd: Str, var blob: U8[], n: I64, stdin_path: Str, capture: I64, var out: U8[], out_len: &ProcBox64) -> I32
