// ffi.ct —— C 边界错误包装(§9.6 深层 errno→Result 首档)
// since: std-0.3 stability: experimental
// 口径:errno() 内建读最近一次系统调用/库调用错误码(线程局域);
// sys_result 把 "rc + errno" 双值惯例折叠成 Result——rc < 0 = 失败,
// Err 载荷为人读消息(strerror 经 str_from_c 深拷,Ctron-owned)。
//
// 域承诺(sys_result):|rc| < 2^31。POSIX 系统调用返回值恒在此域;
// 发射面 Result 载荷槽 32 位(json.ct prior art:Ok(I64) 大值截断)。
//
// 验收通道:本包 test 块为解释桥安全口径(不触 Str 返回 extern);
// Err 臂(strerror 消息面)由 tests/ffi/err_wrap 编译通道钉死——
// 解释桥 Str 返回截断是 E3 在册缺口,包装层不绕。

// strerror 经包垫片中转(ffi/c_src/ctron_ffi.c):Str 边界 = const char*,
// 与 libc char* strerror 原型 const 冲突,自有符号免冲突;私有面。
#[trusted]
extern "c" fn ctron_ffi_strerror(e: I32) -> Str

// 错误码 → 人读消息。垫片返回 C-owned(静态区,后续调用可覆写),
// str_from_c 深拷入 arena 转为 Ctron-owned。
pub fn err_str(e: I64) -> Str {
    return str_from_c(ctron_ffi_strerror(e.as[I32]()))
}

// rc 惯例折叠:rc < 0 = 失败 → Err(err_str(errno()));否则 Ok(rc)。
// 包装作者:let fd = sys_result(dup(0)) 配 match/`?` 消费。
pub fn sys_result(rc: I64) -> Result[I64, Str] {
    if rc < 0 {
        return Err(err_str(errno()))
    }
    return Ok(rc)
}

test "sys_result folds nonneg rc into Ok (interp-safe; Err/strerror arm in err_wrap)" {
    match sys_result(0) {
        Ok(v) => {
            assert_eq(v, 0)
        }
        Err(m) => {
            assert_eq(m.len, -1)
        }
    }
    match sys_result(7) {
        Ok(v) => {
            assert_eq(v, 7)
        }
        Err(m) => {
            assert_eq(m.len, -1)
        }
    }
}
