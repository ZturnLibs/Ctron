// ffi.ct —— C 边界错误包装(§9.6 深层 errno→Result 首档)
// since: std-0.3 stability: experimental
// 口径:errno() 内建读最近一次系统调用/库调用错误码(线程局域);
// sys_result 把 "rc + errno" 双值惯例折叠成 Result——rc < 0 = 失败,
// Err 载荷为人读消息(strerror 经 str_from_c 深拷,Ctron-owned)。
//
// 域承诺(sys_result):|rc| < 2^31。POSIX 系统调用返回值恒在此域;
// 发射面 Result 载荷槽 32 位(json.ct prior art:Ok(I64) 大值截断)。
//
// 验收通道:本包 test 块为解释桥安全口径(不触 Str 返回 extern);
// Err 臂(strerror 消息面)由 tests/ffi/err_wrap 编译通道钉死——
// 解释桥 Str 返回截断是 E3 在册缺口,包装层不绕。

// strerror 经包垫片中转(ffi/c_src/ctron_ffi.c):Str 边界 = const char*,
// 与 libc char* strerror 原型 const 冲突,自有符号免冲突;私有面。
#[trusted]
extern "c" fn ctron_ffi_strerror(e: I32) -> Str

// 错误码 → 人读消息。垫片返回 C-owned(静态区,后续调用可覆写),
// str_from_c 深拷入 arena 转为 Ctron-owned。
pub fn err_str(e: I64) -> Str {
    return str_from_c(ctron_ffi_strerror(e.as[I32]()))
}

// rc 惯例折叠:rc < 0 = 失败 → Err(err_str(errno()));否则 Ok(rc)。
// 包装作者:let fd = sys_result(dup(0)) 配 match/`?` 消费。
pub fn sys_result(rc: I64) -> Result[I64, Str] {
    if rc < 0 {
        return Err(err_str(errno()))
    }
    return Ok(rc)
}

test "sys_result folds nonneg rc into Ok (interp-safe; Err/strerror arm in err_wrap)" {
    match sys_result(0) {
        Ok(v) => {
            assert_eq(v, 0)
        }
        Err(m) => {
            assert_eq(m.len, -1)
        }
    }
    match sys_result(7) {
        Ok(v) => {
            assert_eq(v, 7)
        }
        Err(m) => {
            assert_eq(m.len, -1)
        }
    }
}

// ---- CBox[T]:跨边界所有权包装(§9.6 所有权三约定之 2,Ctron-owned)----
// 承诺:C 堆块所有权入盒后,释放责任显式(cbox_free = #[trusted] 释放面);
// 所有权哨在 C 侧登记表(指针注册/注销)——struct 值拷贝不复制哨状态,任何
// 别名副本同见真值;哨后操作响亮 panic(双 free / free 后使用,不静默)。
// 面形态:自由泛型函数(v0 发射面 trait 方法调用为 T25 v2 在册域,泛型直调
// 推断已随 T45 修通;解释桥指针截断故 CBox 恒编译通道,解释口径不可用)。
// GC 交互:盒壳在 GC 堆(仅 {p} 两字),载荷恒为 C malloc 块——§9.6「arena
// 内存不交 C 长期持有」禁令由「必须经本盒」兑现;壳被回收而未 free = 泄漏
// 不悬垂,责任显式在消费者(v0 无终结器;验收锚 tests/ffi/cbox)。

// 登记表面:泛型 extern 单态化为声明态码(int32_t*),跨 TU 对 void* 定义
// (指针调用约定同型);Bool 以 int 落界(三线统一)。
#[trusted]
extern "c" fn ctron_cbox_reg[T](p: &T)

#[trusted]
extern "c" fn ctron_cbox_live[T](p: &T) -> Bool

#[trusted]
extern "c" fn ctron_cbox_take[T](p: &T)

#[trusted]
extern "c" fn ctron_cbox_drop[T](p: &T)

struct CBox[T] {
    var p: &T
}

// C→Ctron 移交入口(bindgen 包装作者面):p = C 创建/移交的堆块首址,
// 非空承诺在 C 契约侧(NULL 分流列 v2 Option 面);入盒即注册。
pub fn cbox_own[T](p: &T) -> CBox[T] {
    ctron_cbox_reg(p)
    return CBox { p: p }
}

// 借用(约定之 3):&T 交调用期,不外泄不存;哨后响亮 panic
pub fn cbox_borrow[T](b: CBox[T]) -> &T {
    if !ctron_cbox_live(b.p) {
        panic("CBox: use after free")
    }
    return b.p
}

// 移交赴 C(约定之 2 反向):所有权离盒,释放责任随之过界;哨后响亮 panic
pub fn cbox_into_raw[T](b: CBox[T]) -> &T {
    if !ctron_cbox_live(b.p) {
        panic("CBox: use after free")
    }
    ctron_cbox_take(b.p)
    return b.p
}

// 释放(#[trusted] 面):注销 + free;双 free 响亮 panic
pub fn cbox_free[T](b: CBox[T]) {
    if !ctron_cbox_live(b.p) {
        panic("CBox: double free")
    }
    ctron_cbox_drop(b.p)
}
