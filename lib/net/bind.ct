// net/bind.ct - ctron_net.c shim extern surface (§11.2)
// 纪律:参数表单行(C 宿主解析器);fd 全程 I64;出参经 &T 裸指针(P0-B 迁移)。
// 可见性注:此处用 `pub extern` 而非 brief 原案 `#[trusted] extern` —— loader 的
// use 可见性检查仅认 FnExt+pub 尾槽(parse_pkg.ct:285),而 `#[trusted]` 与 `pub`
// 无组合语法(pub 分支不路由属性,属性分支不路由 pub);sem 对 extern 无 trusted
// 检查(E4040 仅 Fn/FnPub),纪律语义由本注释承载。net.ct 经
// use net.bind.{...} 链入,符号随合并进单一命名空间(§11.2)。
//
// 边界形态(P0-B 起,依 v0.9·三 裸指针能力切片 c386078/14a8b73 发射面):
//   - 出参 fd/port = &Box64 裸指针形(p<u:Box64> 码,发射 t_Box64* —— 与
//     C 侧 Box64* 镜像 ABI 同型,符号名零改;tests/ffi/ptr_param 先例)。
//     旧 Box[Box64] 通道被 v0.9 E4046 拒收(所有权谎言收口,sem_main.ct),
//     `use net` 整树 check 硬错,故全族出参迁 &T;消费侧经 net.ct 门面的
//     Box[Box64] 堆胞中间层适配(门面签名不变)。
//   - 缓冲 = var U8[](前缀形参)字节平面视图(发射 ctron_view_w8u 按值;
//     M3C1 CW1a 2026-10-08 迁移——旧 &I64[] lane 形态系"发射器仅预发 i/6/b/s/f
//     typedef"时期的历史绕行,w8u/w8s typedef+trans_ty 映射+视图传参现全链在,
//     垫片直搬视图指针,无 4096 单次上限,零逐字节中转)。
//   - C-owned 串返回(ctron_net_resolve_first/strerror)为 thread-local 静态,
//     Ctron 侧 str_from_c 深拷后用(§9.6 三约定)。
//   - rc 约定:0 成功;<0 失败(错误详情经 ctron_net_last_errno/strerror);
//     读函数 >0 n / 0 eof / <0 err。peer 地址串 P1 全裁(YAGNI,无夹具需要)。
// Box64 struct 声明留本文件:门面堆胞(net.ct)与夹具直接消费面仍用
// Box[Box64] 值形(非 extern 位,E4046 不触及);typedef 随 use 合并带出。
// pub(SL-0.7 尾槽):夹具构造 Box64 字面量须显式请求;非 pub 则 E2020.use.priv。
pub struct Box64 {
    var v: I64
}

pub extern "c" fn ctron_net_now_ns() -> I64
pub extern "c" fn ctron_net_sleep_ms(ms: I64) -> I64
pub extern "c" fn ctron_net_sleep_ns(ns: I64) -> I64
pub extern "c" fn ctron_net_clock_jump(ns: I64) -> I64
pub extern "c" fn ctron_net_last_errno() -> I64
pub extern "c" fn ctron_net_strerror(e: I64) -> Str
pub extern "c" fn str_from_c(s: Str) -> Str
pub extern "c" fn ctron_net_tcp_listen(host: Str, port: I64, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_tcp_sockname(fd: I64, out_port: &Box64) -> I64
pub extern "c" fn ctron_net_tcp_accept(lfd: I64, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_tcp_accept_t(lfd: I64, timeout_ms: I64, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_tcp_connect(host: Str, port: I64, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_read_t(fd: I64, var buf: U8[], cap: I64, timeout_ms: I64) -> I64
pub extern "c" fn ctron_net_write(fd: I64, var buf: U8[], n: I64) -> I64
pub extern "c" fn ctron_net_write_str(fd: I64, s: Str) -> I64
pub extern "c" fn ctron_net_close(fd: I64) -> I64
pub extern "c" fn ctron_net_shutdown_write(fd: I64) -> I64
pub extern "c" fn ctron_net_set_nodelay(fd: I64, on: I64) -> I64
pub extern "c" fn ctron_net_get_nodelay(fd: I64) -> I64
pub extern "c" fn ctron_net_udp_socket(out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_udp_bind(fd: I64, host: Str, port: I64, out_port: &Box64) -> I64
pub extern "c" fn ctron_net_udp_sendto(fd: I64, host: Str, port: I64, var buf: U8[], n: I64) -> I64
pub extern "c" fn ctron_net_udp_recvfrom(fd: I64, var buf: U8[], cap: I64, timeout_ms: I64) -> I64
pub extern "c" fn ctron_net_resolve_first(host: Str) -> Str
pub extern "c" fn ctron_net_resolve_all(host: Str) -> Str
pub extern "c" fn ctron_net_unix_listen(path: Str, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_unix_accept(lfd: I64, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_unix_connect(path: Str, out_fd: &Box64) -> I64
pub extern "c" fn ctron_net_unix_unlink(path: Str) -> I64
pub extern "c" fn ctron_rt_scopes_json() -> Str
