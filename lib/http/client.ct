// http/client.ct —— HTTP/1.1 客户端 + 传输门面(P4-C)
// ═══ use 图与模块形态(本波实测,登记面)═══
// 加载器事实(divergences (g) E5020 的加码实测):栈式查环无 pop ⇒ 任一文件
// 的传递 use 树中【每个模块至多出现一次】——同父双子共享任一叶子(如两个
// std 模块各自 use net.bind)与跨模块菱形同样 E5020;且合并取全量 decl
// ⇒ 同名 decl 二次合并 E5030。⇒ http 的消费方 use 图必须是严格互斥树:
//   client.ct(本文件)= 唯一触 net.bind 的模块(传输 IO 面)
//   sse.ct / ws.ct = 纯叶子(ws → crypto 单子依赖,与 client 树互斥)
// 消费方夹具同批 use 三树 + std.rand 即全量面,不再 use std.net(否则与
// bind.ct 汇合即 E5020)。StdNet 面未用:本文件自出 HttpNet 空 struct 作
// 能力显形参(与 net: StdNet 同构的命名面,不 import std.net)。
// ═══ 面 ═══
//   ① 传输面 client_*(listen/sockname/accept/connect/read_t/write/write_str
//      /close):net 门面 rc 口径的透传薄壳(0 成/<0 败;读 >0 n/0 eof/<0
//      败)——夹具服务端与服务端 SSE/WS 全走此面。
//   ② HttpSock = Drop RAII 句柄(fd < 0 跳过;显式 client_close 后置 -1,
//      net.ct ④ 同款纪律)。
//   ③ 客户端面 client_request:连接(缓存复用)→ 发送(parse/message 树组
//      装)→ 响应读取(CL/chunked 分框,parse.ct 增量解析)→ 重定向跟随
//      (301/302/303 → GET 且弃体;307/308 保方法保体;上限 5 跳;Location
//      支持 绝对路径 与 http://host[:port]/path 全 URL 两形)→ 101 直通
//      (WS upgrade:连接经缓存槽交予调用方,键位失效防误用)。
//   ④ keep-alive 缓存 = 调用方持 HttpKeep(cache = Box[KeepMap],键 =
//      "host:port",容量 8 FIFO 逐出;bru = 复用计数胞,成功走复用连接时
//      自增,测试可见)。多槽化后跨 host 不再关旧连。101 直通经 resp.fd
//      交付(键位出缓存防误复用)。复用失败(对端已关)重连一次 = 重试一次
//      语义(仅复用面失败重试:发送失败或零字节读败;已有部分响应字节
//      不重发)。
//      引擎同模块自持(KeepMap/KeepCell)双因:①发射器结构体 Box 字段
//      【跨模块】类型闭包缺失(t_HMapS/t_Box64 typedef 不随 t_HttpKeep 发出,
//      同模块免疫已探针钉边,2026-10-09)——退役条件 = trans 线补跨模块
//      收集,届时 cache 换 Box[HMapS[I64]] + std/hashmap hmsi_* 具体面;
//      ②use 图 E5020 互斥树毒图:client.ct 一旦 use std.hashmap,消费方
//      直用同模块即 E5020——自持面连根规避,消费方零新 use。附带登记:
//      裸 V 返回非泛型宿主值位 E2010 家族 + V 不参与实参位推断(E2060,
//      发射臂同码绿,seed/emit 宽严反向第三例)——泛型容器公共 API 的
//      消费面形状约束,详见 std/hashmap W2 批 COVERAGE。
//   ⑤ 上限 = parse.ct HttpLimits 缺省档(响应体 1 MiB 强制界,head 之上
//      cap 参数为硬界);超时 = net_read_t 读截止,每次读同参(v1 无整请求
//      deadline,登记)。
//   ⑥ 发射面纪律:无闭包、无方法调用、无 Tuple;(h) 缺口绕行 = getter 面
//      (成员访问不出模块);while 体无 Drop 局部(HttpSock 仅在夹具裸块内
//      生灭;本文件一律裸 fd + 显式 close)。
use net.bind.{ ctron_net_tcp_listen, ctron_net_tcp_sockname, ctron_net_tcp_accept, ctron_net_tcp_connect, ctron_net_read_t, ctron_net_write, ctron_net_write_str, ctron_net_close, ctron_net_sleep_ms, ctron_net_now_ns }
use http.parse.{ http_limits_default, http_parse_head, http_header_value, http_keep_alive, http_rc, http_err_of, http_status_of, http_head_end, http_body_kind, http_clen, http_ver, sl_rc, sl_vs, sl_vl }
use http.message.{ msg_request_line, msg_header, msg_cl_header, msg_head_end, chunk_st_new, chunk_step, cr_consumed, cr_produced, cr_phase, cr_remain }

// ---- 能力 token 与传输面(rc 透传) ----

pub struct HttpNet {
}

pub fn http_net() -> HttpNet {
    return HttpNet {}
}

pub struct KeepMap {
    var slots: List[I32]
    var keys: List[Str]
    var vals: List[I64]
}

pub struct KeepCell {
    var v: I64
}

// keep-alive 多槽缓存态(调用方持有;T2 显式状态门面豁免面,宪章 8 有界)。
// cache = "host:port" → 连接 fd(容量 8,FIFO 逐出);bru = 复用计数。
pub struct HttpKeep {
    var cache: Box[KeepMap]
    var bru: Box[KeepCell]
}

// ── 缓存引擎(同模块具体面;开放寻址+线性探查+负载 3/4 倍增;插入序;
//    形状纪律同 std/hashmap:泛型元素读走形参 List 助手,Box 具体型直写。
//    KeepMap/KeepCell 须 pub 且【声明序先于 HttpKeep】:发射器 typedef 按
//    声明序出、不做依赖序(非 pub 不入消费单元闭包;序错即 t_KeepMap 悬空,
//    2026-10-09 c0_pure 两犯实证)——类型面 pub,引擎 fn 保持非 pub。──
fn keep_idx(s: Str) -> I32 {
    var h: I32 = 5381
    var i: I32 = 0
    while i < s.len {
        h = (h * 33 + byte_at(s, i)) % 100003
        i += 1
    }
    return h
}

fn keep_slot_of(h: I32, cap: I32) -> I32 {
    var m = (h % cap + cap) % cap
    return m
}

fn keep_at_str(xs: List[Str], i: I32, dft: Str) -> Str {
    if i < 0 {
        return dft
    }
    if i >= xs.len {
        return dft
    }
    return xs[i]
}

fn keep_at_i64(xs: List[I64], i: I32, dft: I64) -> I64 {
    if i < 0 {
        return dft
    }
    if i >= xs.len {
        return dft
    }
    return xs[i]
}

fn keep_copy_str(xs: List[Str], hit: I32) -> List[Str] {
    var out = List[Str]()
    var i: I32 = 0
    while i < xs.len {
        if i != hit {
            out.push(xs[i])
        }
        i += 1
    }
    return out
}

fn keep_copy_i64(xs: List[I64], hit: I32) -> List[I64] {
    var out = List[I64]()
    var i: I32 = 0
    while i < xs.len {
        if i != hit {
            out.push(xs[i])
        }
        i += 1
    }
    return out
}

fn keep_new_map() -> Box[KeepMap] {
    var s = List[I32]()
    var i: I32 = 0
    while i < 16 {
        s.push(-1)
        i += 1
    }
    return Box[KeepMap](KeepMap { slots: s, keys: List[Str](), vals: List[I64]() })
}

fn keep_find(m: Box[KeepMap], k: Str) -> I32 {
    var cap = m.slots.len
    var idx = keep_slot_of(keep_idx(k), cap)
    var n: I32 = 0
    while n < cap {
        var s = m.slots[idx]
        if s < 0 {
            return -1
        }
        if keep_at_str(m.keys, s, k) == k {
            return s
        }
        idx += 1
        if idx == cap {
            idx = 0
        }
        n += 1
    }
    return -1
}

fn keep_grow(m: Box[KeepMap]) {
    var ncap = m.slots.len * 2
    var ns = List[I32]()
    var i: I32 = 0
    while i < ncap {
        ns.push(-1)
        i += 1
    }
    var j: I32 = 0
    while j < m.keys.len {
        var idx = keep_slot_of(keep_idx(keep_at_str(m.keys, j, "")), ncap)
        while ns[idx] >= 0 {
            idx += 1
            if idx == ncap {
                idx = 0
            }
        }
        ns[idx] = j
        j += 1
    }
    m.slots = ns
}

fn keep_put(m: Box[KeepMap], k: Str, v: I64) {
    var hit = keep_find(m, k)
    if hit >= 0 {
        var nv = List[I64]()
        var j: I32 = 0
        while j < m.vals.len {
            if j == hit {
                nv.push(v)
            } else {
                nv.push(keep_at_i64(m.vals, j, v))
            }
            j += 1
        }
        m.vals = nv
        return
    }
    if m.keys.len * 4 > m.slots.len * 3 {
        keep_grow(m)
    }
    var cap = m.slots.len
    var idx = keep_slot_of(keep_idx(k), cap)
    var n: I32 = 0
    while n < cap {
        if m.slots[idx] < 0 {
            m.slots[idx] = m.keys.len
            m.keys.push(k)
            m.vals.push(v)
            return
        }
        idx += 1
        if idx == cap {
            idx = 0
        }
        n += 1
    }
}

fn keep_has(m: Box[KeepMap], k: Str) -> Bool {
    if keep_find(m, k) < 0 {
        return false
    }
    return true
}

fn keep_get(m: Box[KeepMap], k: Str, dft: I64) -> I64 {
    var s = keep_find(m, k)
    if s < 0 {
        return dft
    }
    return keep_at_i64(m.vals, s, dft)
}

fn keep_del(m: Box[KeepMap], k: Str) {
    var hit = keep_find(m, k)
    if hit < 0 {
        return
    }
    var nk = keep_copy_str(m.keys, hit)
    var nv = keep_copy_i64(m.vals, hit)
    var cap = m.slots.len
    var ns = List[I32]()
    var i: I32 = 0
    while i < cap {
        ns.push(-1)
        i += 1
    }
    var j: I32 = 0
    while j < nk.len {
        var idx = keep_slot_of(keep_idx(keep_at_str(nk, j, "")), cap)
        while ns[idx] >= 0 {
            idx += 1
            if idx == cap {
                idx = 0
            }
        }
        ns[idx] = j
        j += 1
    }
    m.keys = nk
    m.vals = nv
    m.slots = ns
}

fn keep_len(m: Box[KeepMap]) -> I32 {
    return m.keys.len
}

fn keep_keys(m: Box[KeepMap]) -> List[Str] {
    return keep_copy_str(m.keys, -1)
}

pub fn http_keep_new() -> HttpKeep {
    return HttpKeep { cache: keep_new_map(), bru: Box[KeepCell](KeepCell { v: 0 }) }
}

// 关闭并清空缓存全部连接(调用方收尾卫生;bru 计数不动)
pub fn http_keep_drain(kp: HttpKeep) {
    var ks = keep_keys(kp.cache)
    var i: I32 = 0
    while i < ks.len {
        var fd = keep_get(kp.cache, ks[i], -1)
        if fd >= 0 {
            ctron_net_close(fd)
        }
        keep_del(kp.cache, ks[i])
        i += 1
    }
}

pub fn client_listen(host: Str, port: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_tcp_listen(host, port, out_fd)
}

pub fn client_sockname(fd: I64, out_port: Box[Box64]) -> I64 {
    return ctron_net_tcp_sockname(fd, out_port)
}

pub fn client_accept(lfd: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_tcp_accept(lfd, out_fd)
}

pub fn client_connect(host: Str, port: I64, out_fd: Box[Box64]) -> I64 {
    return ctron_net_tcp_connect(host, port, out_fd)
}

// 读:>0 n / 0 eof / <0 败(超时亦 <0);单次至多搬运 min(cap, 4096)。
pub fn client_read_t(fd: I64, var buf: U8[], cap: I64, timeout_ms: I64) -> I64 {
    return ctron_net_read_t(fd, buf, cap, timeout_ms)
}

pub fn client_write(fd: I64, var buf: U8[], n: I64) -> I64 {
    return ctron_net_write(fd, buf, n)
}

pub fn client_write_str(fd: I64, s: Str) -> I64 {
    return ctron_net_write_str(fd, s)
}

pub fn client_close(fd: I64) -> I64 {
    return ctron_net_close(fd)
}

// 时钟/睡眠透传(夹具服务端节奏控制与耗时测量;std.net 不可入的 use 图约束下
// 的同口径面)
pub fn client_sleep_ms(ms: I64) -> I64 {
    return ctron_net_sleep_ms(ms)
}

pub fn client_now_ns() -> I64 {
    return ctron_net_now_ns()
}

// RAII 句柄:作用域出口关 fd(显式 client_close 后须 sock.fd = -1)。
pub struct HttpSock {
    var fd: I64
}

impl Drop for HttpSock {
    fn drop(var self) {
        if self.fd >= 0 {
            ctron_net_close(self.fd)
        }
    }
}

// ---- 缓存键(host 哈希;djb2 取模防溢出) ----

pub fn client_hash_host(host: Str) -> I64 {
    var h: I64 = 5381
    var i: I32 = 0
    while i < host.len {
        h = (h % 1000000007) * 33 + byte_at(host, i)
        h = h % 1000000007
        i += 1
    }
    return h
}

// ---- Location 解析(纯面) ----

pub struct HttpLoc {
    let ok: I64
    let host: Str
    let port: I64
    let path: Str
}

pub fn loc_ok(l: HttpLoc) -> I64 { return l.ok }
pub fn loc_host(l: HttpLoc) -> Str { return l.host }
pub fn loc_port(l: HttpLoc) -> I64 { return l.port }
pub fn loc_path(l: HttpLoc) -> Str { return l.path }

// Location 头解析:v1 两形 —— 绝对路径("/...")与全 URL("http://host[:port]/...");
// 其余(协议相对 //、相对路径、https)→ ok = 0。host 空(全 URL 无端口)→ 继承 base。
pub fn client_loc_resolve(loc: Str, base_host: Str, base_port: I64) -> HttpLoc {
    // 形一:绝对路径
    if loc.len > 0 && byte_at(loc, 0) == 47 {
        return HttpLoc { ok: 1, host: base_host, port: base_port, path: loc }
    }
    // 形二:http://host[:port]/path
    if loc.len >= 8 {
        var is_http = 1
        var scheme = "http://"
        var k: I32 = 0
        while k < 7 {
            if byte_at(loc, k) != byte_at(scheme, k) {
                is_http = 0
            }
            k += 1
        }
        if is_http == 1 {
            var rest: I32 = 7
            var slash: I32 = rest
            while slash < loc.len && byte_at(loc, slash) != 47 {
                slash += 1
            }
            var hostend = slash
            var pport: I64 = 80
            var colon: I32 = rest
            var found = 0
            while colon < slash {
                if byte_at(loc, colon) == 58 {
                    found = 1
                }
                if found == 1 {
                    colon = slash
                } else {
                    colon += 1
                }
            }
            colon = rest
            while colon < slash {
                if byte_at(loc, colon) == 58 {
                    hostend = colon
                }
                colon += 1
            }
            if found == 1 {
                var acc: I64 = 0
                var d = hostend + 1
                if d == slash {
                    return HttpLoc { ok: 0, host: "", port: 0, path: "" }
                }
                while d < slash {
                    let c = byte_at(loc, d)
                    if c < 48 || c > 57 {
                        return HttpLoc { ok: 0, host: "", port: 0, path: "" }
                    }
                    // C10 宽域惯用法(parse.ct:275 同款):acc 值域落 [2^28,2^31)
                    // 带(端口 ≥9 位数字)时解释器按 I32 宽度误判 acc*10 上溢即
                    // panic(divergences (i) 族第五处,2026-09-21 终审);+2^32-2^32
                    // 提升参与值域,乘法按 I64。emit 行为恒等(纯恒等改写)。
                    acc = (acc + 4294967296 - 4294967296) * 10 + (c - 48).as[I64]()
                    d += 1
                }
                pport = acc
            }
            var host = byte_slice(loc, rest, hostend)
            if host.len == 0 {
                return HttpLoc { ok: 0, host: "", port: 0, path: "" }
            }
            var path = "/"
            if slash < loc.len {
                path = byte_slice(loc, slash, loc.len)
            }
            return HttpLoc { ok: 1, host: host, port: pport, path: path }
        }
    }
    return HttpLoc { ok: 0, host: "", port: 0, path: "" }
}

// ---- 内部助手 ----

// lane 切片 → Str(printable ASCII;含 0x20..0x7e;非法 → "")—— Location 值域
fn cx_slice_str(src: &U8[], a: I64, b: I64) -> Str {
    var out = ""
    var i = a
    while i < b {
        let c = src[i].as[I64]()
        if c < 32 || c > 126 || c == 123 {
            return ""
        }
        if c < 123 {
            out = out + byte_slice(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz", c - 32, c - 31)
        } else {
            out = out + byte_slice("|}~", c - 124, c - 123)
        }
        i += 1
    }
    return out
}

// 读取步结果(模块内):rc = 0 完整响应 / -1 败(已见部分字节或帧面坏)/
// -2 败(零字节干净败 —— 对端早关,复用重试的判据)/ -3 容量 / -4 解析。
struct CxRead {
    let rc: I64
    let n: I64
    let blen: I64
    let left: I64
}

fn cx_rd(rc: I64, n: I64, blen: I64, left: I64) -> CxRead {
    return CxRead { rc: rc, n: n, blen: blen, left: left }
}

// 追加一读(经 scratch;lane 无偏移读面 —— 登记绕行)
fn cx_read_append(fd: I64, var buf: U8[], n: I64, cap: I64, var scr: U8[], scap: I64, timeout_ms: I64) -> I64 {
    let r = ctron_net_read_t(fd, scr, scap, timeout_ms)
    if r < 0 {
        return -1
    }
    var i: I64 = 0
    while i < r {
        if n + i >= cap {
            return -2
        }
        buf[n + i] = scr[i].as[I64]()
        i += 1
    }
    return r
}

// 响应读取:头(parse 增量重扫)+ 体(CL / chunked 就地分框;1.0 无 CL 读到 EOF)
fn cx_read_resp(fd: I64, var buf: U8[], cap: I64, var scr: U8[], scap: I64, timeout_ms: I64) -> CxRead {
    let lim = http_limits_default()
    var n: I64 = 0
    var need_head = 1
    var head = http_parse_head(buf, 0, lim)
    while need_head == 1 {
        head = http_parse_head(buf, n, lim)
        let rc = http_rc(head)
        if rc == 1 {
            need_head = 0
        } else {
            if rc == -1 {
                if n == 0 {
                    return cx_rd(-2, 0, 0, 0)
                }
                return cx_rd(-4, n, 0, 0)
            }
            if n >= cap {
                return cx_rd(-3, n, 0, 0)
            }
            let r = cx_read_append(fd, buf, n, cap, scr, scap, timeout_ms)
            if r < 0 {
                if n == 0 {
                    return cx_rd(-2, 0, 0, 0)
                }
                return cx_rd(-1, n, 0, 0)
            }
            if r == 0 {
                if n == 0 {
                    return cx_rd(-2, 0, 0, 0)
                }
                return cx_rd(-1, n, 0, 0)
            }
            n = n + r
        }
    }
    let hend = http_head_end(head)
    let kind = http_body_kind(head)
    var blen: I64 = 0
    if kind == 1 {
        // chunked:就地分框(dst = src,dfill+out ≤ i 恒成立 → 无重叠写)
        var pos = hend
        var dfill = hend
        var st = chunk_st_new()
        var total: I64 = 0
        var done = 0
        var guard: I64 = 0
        while done == 0 && guard < 100000 {
            guard += 1
            if guard == 99999 {
                // 步进守卫耗尽 = 恶意/损坏流(非干净终止)→ 协议错
                return cx_rd(-4, n, 0, 0)
            }
            let r = chunk_step(buf, n, pos, st, buf, dfill, cap)
            pos = pos + cr_consumed(r)
            dfill = dfill + cr_produced(r)
            total = total + cr_produced(r)
            let rc = cr_rc(r)
            if rc == -1 {
                return cx_rd(-4, n, 0, 0)
            }
            if rc == 2 {
                return cx_rd(-3, n, 0, 0)
            }
            if total > lim.max_body {
                return cx_rd(-3, n, 0, 0)
            }
            if rc == 1 || cr_phase(r) == 4 {
                done = 1
            } else {
                if n >= cap {
                    return cx_rd(-3, n, 0, 0)
                }
                let ar = cx_read_append(fd, buf, n, cap, scr, scap, timeout_ms)
                if ar < 0 {
                    return cx_rd(-1, n, 0, 0)
                }
                if ar == 0 {
                    return cx_rd(-1, n, 0, 0)
                }
                n = n + ar
            }
            // 状态随值携带(重入契约:message.ct ③)
            st = ChunkSt { phase: cr_phase(r), remain: cr_remain(r), err: 0 }
        }
        blen = total
        return cx_rd(0, n, blen, n - pos)
    }
    // kind 0:CL 或无分框
    let clen = http_clen(head)
    if clen > 0 {
        let need = hend + clen
        while n < need {
            if n >= cap {
                return cx_rd(-3, n, 0, 0)
            }
            let r = cx_read_append(fd, buf, n, cap, scr, scap, timeout_ms)
            if r < 0 {
                return cx_rd(-1, n, 0, 0)
            }
            if r == 0 {
                return cx_rd(-1, n, 0, 0)
            }
            n = n + r
        }
        blen = clen
        return cx_rd(0, n, blen, 0)
    }
    if http_ver(head) == 0 {
        // 1.0 无 CL:读到 EOF
        while 1 == 1 {
            let r = cx_read_append(fd, buf, n, cap, scr, scap, timeout_ms)
            if r == 0 {
                break
            }
            if r < 0 {
                return cx_rd(-1, n, 0, 0)
            }
            n = n + r
            if n >= cap {
                return cx_rd(-3, n, 0, 0)
            }
        }
        blen = n - hend
        return cx_rd(0, n, blen, 0)
    }
    return cx_rd(0, n, 0, 0)
}

// ---- 客户端主面 ----

pub struct HttpResp {
    var rc: I64
    var err: I64
    var status: I64
    var ver: I64
    var keep: I64
    var nredir: I64
    var reuses: I64
    var head_end: I64
    var body_off: I64
    var body_len: I64
    var fd: I64
}

pub fn rr_rc(r: HttpResp) -> I64 { return r.rc }
pub fn rr_err(r: HttpResp) -> I64 { return r.err }
pub fn rr_status(r: HttpResp) -> I64 { return r.status }
pub fn rr_ver(r: HttpResp) -> I64 { return r.ver }
pub fn rr_keep(r: HttpResp) -> I64 { return r.keep }
pub fn rr_nredir(r: HttpResp) -> I64 { return r.nredir }
pub fn rr_reuses(r: HttpResp) -> I64 { return r.reuses }
pub fn rr_head_end(r: HttpResp) -> I64 { return r.head_end }
pub fn rr_body_off(r: HttpResp) -> I64 { return r.body_off }
pub fn rr_body_len(r: HttpResp) -> I64 { return r.body_len }
pub fn rr_fd(r: HttpResp) -> I64 { return r.fd }

// 请求执行(重定向跟随 + 多槽 keep-alive 缓存 + 复用失败重试一次)。
// err 码:1 连接败 / 2 发送败 / 3 接收败(干净)/ 4 接收败(有字节或帧坏)/
// 5 解析 / 6 Location 坏 / 7 重定向超限。重试一次仅限【复用连接】上的发送
// 败或零字节读败(对端已关语义);有部分响应字节绝不重发。
pub fn client_request(io: HttpNet, method: Str, host: Str, port: I64, path: Str, extra: Str, var body: U8[], blen: I64, var buf: U8[], cap: I64, var scr: U8[], timeout_ms: I64, kp: HttpKeep) -> HttpResp {
    var resp = HttpResp { rc: -1, err: 0, status: -1, ver: -1, keep: 0, nredir: 0, reuses: 0, head_end: 0, body_off: 0, body_len: 0, fd: -1 }
    var cache = kp.cache
    var bru = kp.bru
    var cur_method = method
    var cur_host = host
    var cur_port = port
    var cur_path = path
    var cur_blen = blen
    var done = 0
    var guard: I64 = 0
    while done == 0 && guard < 24 {
        guard += 1
        var fd: I64 = -1
        var reused: I64 = 0
        // ── 取连接:缓存命中("host:port" 键)复用,否则新连(容量 8 FIFO 逐出)──
        let ckey = cur_host + ":" + cur_port.to_string()
        if keep_has(cache, ckey) {
            fd = keep_get(cache, ckey, -1)
            reused = 1
        } else {
            if keep_len(cache) >= 8 {
                var ks = keep_keys(cache)
                var ofd = keep_get(cache, ks[0], -1)
                if ofd >= 0 {
                    ctron_net_close(ofd)
                }
                keep_del(cache, ks[0])
            }
            let cb = Box[Box64](Box64 { v: -1 })
            if ctron_net_tcp_connect(cur_host, cur_port, cb) != 0 {
                resp = HttpResp { rc: -1, err: 1, status: -1, ver: -1, keep: 0, nredir: resp.nredir, reuses: bru.v, head_end: 0, body_off: 0, body_len: 0, fd: -1 }
                done = 1
            } else {
                fd = cb.v
                keep_put(cache, ckey, fd)
            }
        }
        if done == 1 {
            break
        }
        // ── 发送(Host 头 = host:port;CL 恒在)──
        let head = msg_request_line(cur_method, cur_path, 1) + msg_header("Host", cur_host + ":" + cur_port.to_string()) + extra + msg_cl_header(cur_blen) + msg_head_end()
        var w = ctron_net_write_str(fd, head)
        if w >= 0 && cur_blen > 0 {
            w = ctron_net_write(fd, body, cur_blen)
        }
        if w < 0 {
            ctron_net_close(fd)
            keep_del(cache, ckey)
            if reused == 1 {
                continue
            }
            resp = HttpResp { rc: -1, err: 2, status: -1, ver: -1, keep: 0, nredir: resp.nredir, reuses: bru.v, head_end: 0, body_off: 0, body_len: 0, fd: -1 }
            done = 1
            break
        }
        // ── 读响应 ──
        let crd = cx_read_resp(fd, buf, cap, scr, scr.len.as[I64](), timeout_ms)
        if crd.rc != 0 {
            ctron_net_close(fd)
            keep_del(cache, ckey)
            if reused == 1 && crd.rc == -2 {
                continue
            }
            if crd.rc == -2 {
                resp = HttpResp { rc: -1, err: 3, status: -1, ver: -1, keep: 0, nredir: resp.nredir, reuses: bru.v, head_end: 0, body_off: 0, body_len: 0, fd: -1 }
            } else {
                resp = HttpResp { rc: -1, err: 4, status: -1, ver: -1, keep: 0, nredir: resp.nredir, reuses: bru.v, head_end: 0, body_off: 0, body_len: 0, fd: -1 }
            }
            done = 1
            break
        }
        let lim2 = http_limits_default()
        let h = http_parse_head(buf, crd.n, lim2)
        resp.rc = 0
        resp.err = 0
        resp.status = http_status_of(h)
        resp.ver = http_ver(h)
        resp.keep = 0
        resp.head_end = http_head_end(h)
        resp.body_off = resp.head_end
        resp.body_len = crd.blen
        // ── 连接善后:101 直通 / keep-alive 记账 / 关闭 ──
        var keep = http_keep_alive(buf, h)
        if crd.left > 0 {
            keep = 0
        }
        if resp.status == 101 {
            // WS upgrade:连接键位出缓存(防后续误复用),fd 经 resp.fd 交付
            // 调用方(rr_fd);完成后调用方显式 close
            keep_del(cache, ckey)
            resp.fd = fd
            done = 1
            break
        }
        if keep == 1 {
            if reused == 1 {
                bru.v = bru.v + 1
            }
            resp.keep = 1
        } else {
            ctron_net_close(fd)
            keep_del(cache, ckey)
        }
        // ── 重定向跟随(301/302/303 → GET 弃体;307/308 保方法保体;≤5 跳)──
        var isredir = 0
        if resp.status == 301 || resp.status == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308 {
            isredir = 1
        }
        if isredir == 0 {
            done = 1
            break
        }
        let loc = http_header_value(buf, h, "location")
        var badloc = 0
        if sl_rc(loc) != 0 {
            badloc = 1
        }
        var locstr = ""
        if badloc == 0 {
            locstr = cx_slice_str(buf, sl_vs(loc), sl_vs(loc) + sl_vl(loc))
            if locstr.len == 0 {
                badloc = 1
            }
        }
        let locv = client_loc_resolve(locstr, cur_host, cur_port)
        if badloc == 1 || loc_ok(locv) != 1 {
            resp.rc = -1
            resp.err = 6
            done = 1
            break
        }
        if resp.status == 301 || resp.status == 302 || resp.status == 303 {
            cur_method = "GET"
            cur_blen = 0
        }
        cur_host = loc_host(locv)
        cur_port = loc_port(locv)
        cur_path = loc_path(locv)
        resp.nredir = resp.nredir + 1
        if resp.nredir > 5 {
            resp.rc = -1
            resp.err = 7
            done = 1
            break
        }
    }
    resp.reuses = bru.v
    return resp
}

// ---- inline tests(纯面自检;IO 行为面见 tests/http/client_fixtures)----

test "client loc resolve" {
    let a = client_loc_resolve("/a/b?q=1", "127.0.0.1", 8080)
    assert(loc_ok(a) == 1 && loc_host(a) == "127.0.0.1" && loc_port(a) == 8080 && loc_path(a) == "/a/b?q=1")
    let b = client_loc_resolve("http://example.com/x", "127.0.0.1", 8080)
    assert(loc_ok(b) == 1 && loc_host(b) == "example.com" && loc_port(b) == 80 && loc_path(b) == "/x")
    let c = client_loc_resolve("http://example.com:9090/x/y", "127.0.0.1", 8080)
    assert(loc_ok(c) == 1 && loc_host(c) == "example.com" && loc_port(c) == 9090 && loc_path(c) == "/x/y")
    let d = client_loc_resolve("http://example.com", "127.0.0.1", 8080)
    assert(loc_ok(d) == 1 && loc_host(d) == "example.com" && loc_port(d) == 80 && loc_path(d) == "/")
    let e = client_loc_resolve("other:80/x", "127.0.0.1", 8080)
    assert(loc_ok(e) == 0)
    let f = client_loc_resolve("https://s.io/x", "127.0.0.1", 8080)
    assert(loc_ok(f) == 0)
    let g = client_loc_resolve("http://h:port/x", "127.0.0.1", 8080)
    assert(loc_ok(g) == 0)
}

test "http keep new empty" {
    var kp = http_keep_new()
    assert(keep_len(kp.cache) == 0)
    assert(kp.bru.v == 0)
    keep_put(kp.cache, "h:1", 31)
    keep_put(kp.cache, "h:2", 32)
    assert(keep_len(kp.cache) == 2)
    assert(keep_get(kp.cache, "h:1", -1) == 31)
    keep_del(kp.cache, "h:1")
    assert(keep_len(kp.cache) == 1)
    http_keep_drain(kp)
    assert(keep_len(kp.cache) == 0)
}

test "client hash host stable and discriminating" {
    assert(client_hash_host("a") == client_hash_host("a"))
    assert(client_hash_host("a") != client_hash_host("b"))
    assert(client_hash_host("127.0.0.1") == client_hash_host("127.0.0.1"))
}
