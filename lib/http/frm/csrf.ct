// http/frm/csrf.ct —— CSRF 双提交令牌中间件(P6-B;HMAC 签名对 + SameSite 默认)
//
// 语义登记(v1 口径):
//   形 = 无状态双提交(statemless double-submit)+ HMAC 签名硬化:签发面
//   csrf_issue(key, nonce) → tok = nonce "." hex(HMAC-SHA256(key, nonce))
//   (std/crypto hmac_sha256 —— ws.ct `use std.crypto` 先例,纯叶无 W8052);
//   校验面 csrf_verify(key, cookie_tok, submit_tok):cookie token 与提交
//   (header/form)token 串等值(双提交)+ 签名重算恒等验证。缺任一端/
//   不等/形坏/签坏 → 结构化拒(why 码;composition 层映射 403)。
//
//   恒时比较:签名 hex 段比较走逐字节算术平方累计 diff(长度差一并计入;
//   差非零即平方 > 0,累计和恒 0 当且仅当全等)——字符串早期退出面收窄;
//   真·恒时(数据无关访存)登记志向(Task 3 auth 同面,hmac + 常时比较
//   助手归口)。【emit 缺口登记(P6-B 实证)】位或 `|` 表达式位 = ctron-emit
//   挂死(最小探针:interp 绿,emit 侧无输出即杀;语言无位运算 §4.5 在案
//   —— lexer 有 `|` token 但 emit 侧无 lowering)——草稿原形
//   `diff = diff | (da-db)*(da-db)` 即触;本文件以算术累计绕行,crypto.ct
//   xor32 手工位抽取同口径。
//
//   Cookie 面 = Set-Cookie 助手:SameSite=Lax 默认(题面);HttpOnly 不设
//   (双提交要求 JS 可读提交 —— 经典权衡,登记);Secure/Domain/自定义名
//   列志向。cookie/form 取值助手(csrf_cookie_get/csrf_form_get)零解码
//   (token 域 = [A-Za-z0-9]{16..64},percent/plus 解码登记缺席 —— 签发域
//   即不含,从严)。
//
//   nonce 熵源 = composition 层注入(uuid_v4/random 序号/会话指纹)—— 纯层
//   无熵,uuid.ct 依赖 net 垫片为 emit 专臂,故本模块收 nonce 形参(可确定性
//   测试;真钟/真熵装配归 composition)。
//
//   注入面:Set-Cookie 值恒出自本模块签发(nonce 域校验 + hex 签名)——
//   CR/LF/控制字节不可达;csrf_set_cookie 对外仍按「仅喂 csrf_issue 产物」
//   约定登记(不再二次校验,v1)。请求侧取值面(csrf_cookie_get/csrf_form_get)
//   产出只进 csrf_verify 比较面,永不回流响应头 —— 头走私面封口。
//
//   Task 3 auth 对齐登记:cookie 名 csrf、属性序 `Path=/; SameSite=Lax`
//   —— auth.ct 会话 cookie 沿用同属性序(Path 前置、SameSite=Lax 收尾),
//   会话版增 HttpOnly;双提交令牌 cookie 特意不带 HttpOnly(JS 需读提交,
//   经典权衡见上)。
//
// use 面:std.crypto 单叶(零共享 —— 多中间件同入口组合不触严格树 E5020;
//   middleware/router 不引,链形适配由消费方组合层完成,同 cors.ct 登记)。
//   消费方若自用 std.crypto 再 use 本模块 = 同叶双径 E5020,禁(fixture 以
//   本模块面消费 crypto,直用面归 tests/crypto_vec)。

use std.crypto.{ hmac_sha256, bytes_to_hex }

// ---- 签发 ----

pub struct CsrfTok {
    let ok: I64
    let why: I64
    let tok: Str
}

// why:0 ok / 1 nonce 形坏(域 [A-Za-z0-9]{16..64})
pub fn ct_rc(t: CsrfTok) -> I64 { return t.ok }
pub fn ct_why(t: CsrfTok) -> I64 { return t.why }
pub fn ct_tok(t: CsrfTok) -> Str { return t.tok }

fn cr_nonce_ok(s: Str) -> I64 {
    if s.len < 16 || s.len > 64 {
        return 0
    }
    var i: I32 = 0
    while i < s.len {
        let c = byte_at(s, i)
        let alnum = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
        if !alnum {
            return 0
        }
        i += 1
    }
    return 1
}

// Str → 字节 List[I32](ASCII 域;key/nonce 皆 token 形,越域不发生)
fn cr_bytes(s: Str) -> List[I32] {
    var out = List[I32]()
    var i: I32 = 0
    while i < s.len {
        out.push(byte_at(s, i))
        i += 1
    }
    return out
}

// 签发:tok = nonce "." hex(HMAC-SHA256(key, nonce))
pub fn csrf_issue(key: Str, nonce: Str) -> CsrfTok {
    if cr_nonce_ok(nonce) != 1 {
        return CsrfTok { ok: 0, why: 1, tok: "" }
    }
    let sig = bytes_to_hex(hmac_sha256(cr_bytes(key), cr_bytes(nonce)))
    return CsrfTok { ok: 1, why: 0, tok: nonce + "." + sig }
}

// ---- 校验 ----

pub struct CsrfVer {
    let rc: I64
    let why: I64
}

// why:0 ok / 1 cookie 端缺 / 2 提交端缺 / 3 双提交不等 / 4 形坏(无点分/
//   nonce 域坏/sig 非 64 hex)/ 5 签名不合
pub fn cv_rc(v: CsrfVer) -> I64 { return v.rc }
pub fn cv_why(v: CsrfVer) -> I64 { return v.why }

// hex 域判(偶长 + 全 hex 数位;crypto.hex_valid 同式本模块私铸 —— 直用
//   crypto 即同叶双径,注册)
fn cr_hex_ok(s: Str) -> I64 {
    if s.len % 2 != 0 {
        return 0
    }
    if s.len == 0 {
        return 0
    }
    var i: I32 = 0
    while i < s.len {
        let c = byte_at(s, i)
        let lo = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)
        let up = c >= 65 && c <= 70
        if !(lo || up) {
            return 0
        }
        i += 1
    }
    return 1
}

// 恒时形等值(长度差计入累计;逐字节差平方累加 —— 见头注 emit 缺口登记:
//   位或 `|` 表达式位 ctron-emit 挂死,算术累计绕行)
fn cr_ct_eq(a: Str, b: Str) -> I64 {
    var diff: I64 = 0
    if a.len != b.len {
        diff = 1
    }
    var n: I32 = a.len
    if b.len < n {
        n = b.len
    }
    var i: I32 = 0
    while i < n {
        let da: I64 = byte_at(a, i).as[I64]()
        let db: I64 = byte_at(b, i).as[I64]()
        let dd = da - db
        diff = diff + dd * dd
        i += 1
    }
    if diff == 0 {
        return 1
    }
    return 0
}

// 双提交校验:cookie_tok/submit_tok(header 或 form 提交值)
pub fn csrf_verify(key: Str, cookie_tok: Str, submit_tok: Str) -> CsrfVer {
    if cookie_tok.len == 0 {
        return CsrfVer { rc: 0, why: 1 }
    }
    if submit_tok.len == 0 {
        return CsrfVer { rc: 0, why: 2 }
    }
    if cr_ct_eq(cookie_tok, submit_tok) != 1 {
        return CsrfVer { rc: 0, why: 3 }
    }
    var dot: I32 = -1
    var i: I32 = 0
    var dots: I64 = 0
    while i < cookie_tok.len {
        if byte_at(cookie_tok, i) == 46 {
            dot = i
            dots += 1
        }
        i += 1
    }
    if dot <= 0 || dots != 1 {
        return CsrfVer { rc: 0, why: 4 }
    }
    let nonce = byte_slice(cookie_tok, 0, dot)
    let sig = byte_slice(cookie_tok, dot + 1, cookie_tok.len)
    if cr_nonce_ok(nonce) != 1 || cr_hex_ok(sig) != 1 || sig.len != 64 {
        return CsrfVer { rc: 0, why: 4 }
    }
    let want = bytes_to_hex(hmac_sha256(cr_bytes(key), cr_bytes(nonce)))
    if cr_ct_eq(want, sig) != 1 {
        return CsrfVer { rc: 0, why: 5 }
    }
    return CsrfVer { rc: 1, why: 0 }
}

// ---- Cookie / form 取值助手(零解码;值域即签发域) ----

// Cookie 头值 "a=b; c=d" → 名精确匹配值(无 → "";首匹配胜出)
pub fn csrf_cookie_get(cookie_hdr: Str, name: Str) -> Str {
    var i: I32 = 0
    var start: I32 = 0
    while i <= cookie_hdr.len {
        var isend: I64 = 0
        if i == cookie_hdr.len {
            isend = 1
        }
        if isend == 0 {
            if byte_at(cookie_hdr, i) == 59 {
                isend = 1
            }
        }
        if isend == 1 {
            var a = start
            var b = i
            while a < b && (byte_at(cookie_hdr, a) == 32 || byte_at(cookie_hdr, a) == 9) {
                a += 1
            }
            while b > a && (byte_at(cookie_hdr, b - 1) == 32 || byte_at(cookie_hdr, b - 1) == 9) {
                b -= 1
            }
            var eq: I32 = a
            while eq < b && byte_at(cookie_hdr, eq) != 61 {
                eq += 1
            }
            if eq < b {
                if byte_slice(cookie_hdr, a, eq) == name {
                    return byte_slice(cookie_hdr, eq + 1, b)
                }
            }
            start = i + 1
        }
        i += 1
    }
    return ""
}

// form-urlencoded 体 "a=b&c=d" → 名精确匹配值(无 → "";零解码,头注)
pub fn csrf_form_get(body: Str, name: Str) -> Str {
    var i: I32 = 0
    var start: I32 = 0
    while i <= body.len {
        var isend: I64 = 0
        if i == body.len {
            isend = 1
        }
        if isend == 0 {
            if byte_at(body, i) == 38 {
                isend = 1
            }
        }
        if isend == 1 {
            var eq: I32 = start
            while eq < i && byte_at(body, eq) != 61 {
                eq += 1
            }
            if eq < i {
                if byte_slice(body, start, eq) == name {
                    return byte_slice(body, eq + 1, i)
                }
            }
            start = i + 1
        }
        i += 1
    }
    return ""
}

// Set-Cookie 行(SameSite=Lax 默认;HttpOnly 不设 —— 头注权衡;CRLF 自备)
pub fn csrf_set_cookie(tok: Str) -> Str {
    return "Set-Cookie: csrf=" + tok + "; Path=/; SameSite=Lax\r\n"
}

// 拒响应面(composition 层校验 rc=0 即发;403 + body 13)
pub fn csrf_resp_403() -> Str {
    return "HTTP/1.1 403 Forbidden\r\n" + "Content-Length: 13\r\n" + "\r\n" + "csrf rejected"
}

// ---- inline tests(正反语料见 tests/http/frm_mw/a_csrf.ct) ----

test "issue verify roundtrip" {
    let t = csrf_issue("k0", "abcdefghijklmnop")
    assert(ct_rc(t) == 1 && ct_tok(t).len == 81)
    let v = csrf_verify("k0", ct_tok(t), ct_tok(t))
    assert(cv_rc(v) == 1 && cv_why(v) == 0)
    let bad = csrf_verify("k1", ct_tok(t), ct_tok(t))
    assert(cv_rc(bad) == 0 && cv_why(bad) == 5)
}

test "issue rejects bad nonce" {
    let t1 = csrf_issue("k", "short")
    assert(ct_rc(t1) == 0 && ct_why(t1) == 1)
    let t2 = csrf_issue("k", "has_space_abcdef")
    assert(ct_rc(t2) == 0)
    // 注入面钉:nonce 携 CR/LF/控制字节 → 签发即拒(Set-Cookie 值域封口)
    let t3 = csrf_issue("k", "abc\r\nX-Evil: 1abcdefgh")
    assert(ct_rc(t3) == 0)
    let t4 = csrf_issue("k", "abc\nX-Evil: 1abcdefg")
    assert(ct_rc(t4) == 0)
}

test "verify fail matrix" {
    let t = csrf_issue("k0", "abcdefghijklmnop")
    let tok = ct_tok(t)
    // 形坏:无点 / 双点 / sig 非 64 hex
    let v1 = csrf_verify("k0", "nodot", "nodot")
    assert(cv_rc(v1) == 0 && cv_why(v1) == 4)
    let v2 = csrf_verify("k0", "a.b.c", "a.b.c")
    assert(cv_rc(v2) == 0 && cv_why(v2) == 4)
    let v3 = csrf_verify("k0", "abcdefghijklmnop.zzz", "abcdefghijklmnop.zzz")
    assert(cv_rc(v3) == 0 && cv_why(v3) == 4)
    // 双提交不等(签名段一致,nonce 错位)
    let v4 = csrf_verify("k0", tok, tok + "x")
    assert(cv_rc(v4) == 0 && cv_why(v4) == 3)
    // 端缺
    let v5 = csrf_verify("k0", "", tok)
    assert(cv_rc(v5) == 0 && cv_why(v5) == 1)
    let v6 = csrf_verify("k0", tok, "")
    assert(cv_rc(v6) == 0 && cv_why(v6) == 2)
    // 签名篡改(首 hex 位 0/1 翻转 —— 形完好,重算不合 → why 5)
    var flip: Str = "0"
    if byte_at(tok, 17) == 48 {
        flip = "1"
    }
    let tam = byte_slice(tok, 0, 17) + flip + byte_slice(tok, 18, tok.len)
    let v7 = csrf_verify("k0", tam, tam)
    assert(cv_rc(v7) == 0 && cv_why(v7) == 5)
    // 取值面:cookie/form 名精确匹配
    let ck = csrf_cookie_get("a=1; csrf=" + tok + "; b=2", "csrf")
    assert(ck == tok)
    assert(csrf_cookie_get("a=1", "csrf") == "")
    let fm = csrf_form_get("x=9&csrf=" + tok, "csrf")
    assert(fm == tok)
    // Set-Cookie 形(SameSite=Lax 默认;CRLF 仅行尾)
    assert(csrf_set_cookie(tok) == "Set-Cookie: csrf=" + tok + "; Path=/; SameSite=Lax\r\n")
}
