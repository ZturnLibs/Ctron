// std/ndjson.ct —— NDJSON 逐行游标(P8-C;T1 档:零 use 纯函数,无 IO 无时钟)
//
// 形态(router/pb 同款零 use 纯模块):lane 游标面(不整载——消费方按窗口
//   逐行取用,行文本经可印表 Str 化后交 std/json parse;大文件分块喂入 =
//   调用方移动 pos,本模块不持状态)。NDJSON(RFC 7463 惯例):每行一个
//   JSON 值;空白行跳过;行尾 \r 剥离(容忍 CRLF);尾行可无换行符。
// 【策略登记】坏行(非 JSON 语义)不在本层判定——行窗口交消费方 json.parse,
//   跳过或报错 = 消费方策略;本层只保证窗口切分正确。
// 分层准入(宪章 v2 四问):零依赖/纯函数/无平台面/与 json·csv 同类 —— T1。

pub struct NdLine {
    let rc: I64
    let start: I64
    let ln: I64
}

pub fn nd_rc_line() -> I64 { return 1 }
pub fn nd_rc_eof() -> I64 { return 0 }
pub fn nd_rc_bad() -> I64 { return 0 - 1 }

// 游标:自 pos 起跳过空白行,返回下一非空行窗口(行尾 \r 剥离)。
// rc 1=行 / 0=EOF。npos = 下一游标(消费方直传回)。
pub fn nd_next(buf: &I64[], n: I64, pos: I64) -> NdLine {
    var p = pos
    // 跳过空白行:行内只有 空格/\t/\r/\n 即空白
    while p < n {
        var i = p
        var blank = true
        while i < n {
            let c = buf[i]
            if c == 10 {
                i += 1
                break
            }
            if (c != 32) && (c != 9) && (c != 13) {
                blank = false
                break
            }
            i += 1
        }
        if blank {
            p = i
            continue
        }
        // 非空行:窗口 [p..行尾),剥尾 \r
        var e = p
        while (e < n) && (buf[e] != 10) {
            e += 1
        }
        var ln = e - p
        if (ln > 0) && (buf[p + ln - 1] == 13) {
            ln -= 1
        }
        var nl = NdLine { rc: nd_rc_line(), start: p, ln: ln }
        return nl
    }
    return NdLine { rc: nd_rc_eof(), start: n, ln: 0 }
}

// 行窗口 → Str(可印透传;JSON 文本可印口径)
pub fn nd_line_str(buf: &I64[], f: NdLine) -> Str {
    var out = ""
    var i: I64 = 0
    while i < f.ln {
        let c = buf[f.start + i]
        if (c >= 32) && (c < 127) {
            out = out + byte_slice(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|}~", c - 32, c - 31)
        }
        i += 1
    }
    return out
}
