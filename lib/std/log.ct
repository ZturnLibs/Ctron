// std/log.ct —— 结构化 kv 日志(P7-A;T1 档:零 use 纯函数,无 extern 无时钟)
//
// 形态纪律(router/enc 同款零 use 纯模块):本模块不取时钟、不落 IO ——
//   ts 由消费方传(now_iso_utc()),写出由消费方 println;本模块只做
//   「级别解析/门控/行构造」三件纯面,双臂(解释/发射)天然可对拍。
//
// 行格式(v1):
//     <ts> <LEVEL> <msg><kv>\n          ts = ISO8601 UTC(消费方经 std/time)
//     kv = (" k=v")*                    lg_kv 逐个拼接;v1 单行约定
// 级别:debug=0 < info=1 < warn=2 < error=3;阈值门 = level >= thresh
//   阈值解析 lg_level_parse(env CTRON_LOG 值):debug/info/warn/error 精确
//   小写匹配,空/未知 → info(1)——诚实缺省,静默降档即丢日志,从严。
// 值转义 lg_esc_val:值含 空格/引号/等号/反斜杠/控制字符 或为空 → 引裹,
//   裹内 " → \" 、\ → \\ 、\n → \n(两字符)、\r、\t 同形;其余控制字节(<32)
//   丢弃;≥128 字节透传(UTF-8 中文不破坏——丢弃即毁消息,透传是唯一诚实形)。
//   键不做转义(v1:键 = 代码常量;动态键列志向)。
// 分层准入(宪章 v2 四问):零依赖/纯函数/无平台面/与 json·enc 同类 —— T1。

// ---- 级别码(稳定;阈值比较用) ----

pub fn lg_debug() -> I64 { return 0 }
pub fn lg_info() -> I64 { return 1 }
pub fn lg_warn() -> I64 { return 2 }
pub fn lg_error() -> I64 { return 3 }

// 长度感知等值(发射面债:==/strcmp 对非 NUL 结尾串读越界,router.eqs 同款)
fn lg_eqs(a: Str, b: Str) -> Bool {
    if a.len != b.len {
        return false
    }
    var i: I32 = 0
    while i < a.len {
        if byte_at(a, i) != byte_at(b, i) {
            return false
        }
        i += 1
    }
    return true
}

// 阈值解析:CTRON_LOG 值 → 级别码;空/未知 → info(1)
pub fn lg_level_parse(v: Str) -> I64 {
    if lg_eqs(v, "debug") {
        return lg_debug()
    }
    if lg_eqs(v, "info") {
        return lg_info()
    }
    if lg_eqs(v, "warn") {
        return lg_warn()
    }
    if lg_eqs(v, "error") {
        return lg_error()
    }
    return lg_info()
}

// 门控:level 达阈值才出
pub fn lg_enabled(thresh: I64, level: I64) -> Bool {
    return level >= thresh
}

// 级别名(4/5 字母大写;越界码 → INFO 诚实降档,不 panic)
pub fn lg_level_name(level: I64) -> Str {
    if level == 0 {
        return "DEBUG"
    }
    if level == 2 {
        return "WARN"
    }
    if level == 3 {
        return "ERROR"
    }
    return "INFO"
}

// 值转义(见头注;返回原串或引裹转义形)
pub fn lg_esc_val(v: Str) -> Str {
    var need = false
    if v.len == 0 {
        need = true
    }
    var i: I32 = 0
    while i < v.len {
        let c = byte_at(v, i)
        if c == 32 || c == 34 || c == 61 || c == 92 || c < 32 {
            need = true
        }
        i += 1
    }
    if need == false {
        return v
    }
    var out = "\""
    i = 0
    while i < v.len {
        let c = byte_at(v, i)
        if c == 34 {
            out = out + "\\\""
        } else {
            if c == 92 {
                out = out + "\\\\"
            } else {
                if c == 10 {
                    out = out + "\\n"
                } else {
                    if c == 13 {
                        out = out + "\\r"
                    } else {
                        if c == 9 {
                            out = out + "\\t"
                        } else {
                            if c < 32 {
                                // 其余控制字节丢弃(登记:计数面列志向)
                            } else {
                                out = out + byte_slice(v, i, i + 1)
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    return out + "\""
}

// kv 片:前导空格 + k=v(值经转义)
pub fn lg_kv(k: Str, v: Str) -> Str {
    return " " + k + "=" + lg_esc_val(v)
}

// 整行构造(纯;尾含 \n)
pub fn lg_line(ts: Str, level: I64, msg: Str, kv: Str) -> Str {
    return ts + " " + lg_level_name(level) + " " + msg + kv + "\n"
}

test "level parse exact and honest default" {
    assert_eq(lg_level_parse("debug"), 0)
    assert_eq(lg_level_parse("info"), 1)
    assert_eq(lg_level_parse("warn"), 2)
    assert_eq(lg_level_parse("error"), 3)
    assert_eq(lg_level_parse(""), 1)
    assert_eq(lg_level_parse("INFO"), 1)
    assert_eq(lg_level_parse("verbose"), 1)
}

test "gate boundary" {
    assert_eq(lg_enabled(1, 0), false)
    assert_eq(lg_enabled(1, 1), true)
    assert_eq(lg_enabled(1, 3), true)
    assert_eq(lg_enabled(3, 2), false)
}

test "esc plain passthrough and quoting rules" {
    assert_eq(lg_esc_val("plain"), "plain")
    assert_eq(lg_esc_val(""), "\"\"")
    assert_eq(lg_esc_val("a b"), "\"a b\"")
    assert_eq(lg_esc_val("a=b"), "\"a=b\"")
    assert_eq(lg_esc_val("a\"b"), "\"a\\\"b\"")
    assert_eq(lg_esc_val("a\\b"), "\"a\\\\b\"")
    assert_eq(lg_esc_val("a\nb"), "\"a\\nb\"")
    assert_eq(lg_esc_val("a\tb"), "\"a\\tb\"")
    assert_eq(lg_esc_val("中文值"), "中文值")
}

test "line golden composition" {
    let l = lg_line("2026-09-25T00:00:00Z", lg_info(), "server started", lg_kv("addr", "127.0.0.1:8091"))
    assert_eq(l, "2026-09-25T00:00:00Z INFO server started addr=127.0.0.1:8091\n")
    let w = lg_line("2026-09-25T00:00:00Z", lg_warn(), "slow request", lg_kv("ms", "1 500"))
    assert_eq(w, "2026-09-25T00:00:00Z WARN slow request ms=\"1 500\"\n")
}
