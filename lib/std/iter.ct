// std/iter.ct —— 迭代器适配器链(§3.8.2/§4.8 UFCS;T16 收口 + 续波 R-P3b 面)
//@ tier: alloc
// 形态:Seq[T, S] trait(get 基惰性适配器)+ UFCS 自由函数入口(数组接收者)。
// get(i) = 纯位置读取(无内部状态推进),链任意深度组合;终结器(sum/collect/
// count/any/all/fold/reduce/foreach/min/max/last/position)索引驱动逐元素拉取,
// 零中间集合。数组另有快路径直终结入口。
// 续波(2026-10-03,R-P3b 承诺面收口):适配器补 skip/take_while/rev/enumerate/
// zip/chain;终结子补 fold/reduce/foreach/min/max/last/position;Pair[F,G] 载
// enumerate/zip 元组位;ListSeq[T] 接入 List(前奏 class 直 impl trait 派发不挂,
// 探针实证——包装 struct 同 RawSeq 形,from_list 入口)。
// v0 语义注记:next 基适配器在 var-self 写回语义落库前不可组合(interp 逐调用
// 拷贝接收者,p12 实证);自定义 Iterator 经 for-重放 get(03k 语义)接入同一面。
// zip/chain 为同型 S 面(other 与 self 同适配器型):数组入口双侧同包 RawSeq 故
// xs.zip(ys)/xs.chain(ys) 直用;异型两侧(如 map 后 zip 裸数组)登记后续。
// rev/chain 的 get 为无状态重扫(O(n) 每次,总量 O(n·m)):正确性优先,缓存化
// 待有状态接收语义(var-self 写回)落库后评估。
// min/max 与 std/math 的二元 min/max 同名不同签:use 显式导入制下同导两名才
// E5030;方法调用形(xs.max())不走自由函数命名空间,无冲突。
// 发射面:trait 方法调用与 for-over-Iterator 发射在册(T25 v2 域),本面按 03k
// 先例以双 interp 口径入主套件。
// since: std-0.6 stability: experimental

// ---- 链面 trait:S = 接收者自身型(适配器持上游而设);T = 元素型 ----

// Seq —— 惰性序列 trait:S = 接收者自身型(适配器持上游),T = 元素型
// get(i) 纯位置读取、无状态推进,链任意深度可组合;适配器方法带缺省实现,
// 终结器索引驱动逐元素拉取零中间集合
trait Seq[T, S] {
    fn get(var self, i: I64) -> T?
    fn map(var self, f: fn(T) -> T) -> MapSeq[T, S] {
        return MapSeq { it: self, f: f }
    }
    fn filter(var self, p: fn(T) -> Bool) -> FilterSeq[T, S] {
        return FilterSeq { it: self, p: p }
    }
    fn take(var self, k: I64) -> TakeSeq[T, S] {
        return TakeSeq { it: self, k: k }
    }
    fn skip(var self, n: I64) -> SkipSeq[T, S] {
        return SkipSeq { it: self, n: n }
    }
    fn take_while(var self, p: fn(T) -> Bool) -> TakeWhileSeq[T, S] {
        return TakeWhileSeq { it: self, p: p }
    }
    fn rev(var self) -> RevSeq[T, S] {
        return RevSeq { it: self }
    }
    fn enumerate(var self) -> EnumSeq[T, S] {
        return EnumSeq { it: self }
    }
    fn zip(var self, other: S) -> ZipSeq[T, S] {
        return ZipSeq { it: self, ot: other }
    }
    fn chain(var self, other: S) -> ChainSeq[T, S] {
        return ChainSeq { a: self, b: other }
    }
    fn sum(var self) -> I64 {
        var t: I64 = 0
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    t += v
                    i += 1
                }
                None => { go = false }
            }
        }
        return t
    }
    fn count(var self) -> I64 {
        var c: I64 = 0
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    c += 1
                    i += 1
                }
                None => { go = false }
            }
        }
        return c
    }
    fn collect(var self) -> List[T] {
        let out = List[T]()
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    out.push(v)
                    i += 1
                }
                None => { go = false }
            }
        }
        return out
    }
    fn any(var self, p: fn(T) -> Bool) -> Bool {
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    if p(v) {
                        return true
                    }
                    i += 1
                }
                None => { go = false }
            }
        }
        return false
    }
    fn all(var self, p: fn(T) -> Bool) -> Bool {
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    if !p(v) {
                        return false
                    }
                    i += 1
                }
                None => { go = false }
            }
        }
        return true
    }
    fn fold(var self, init: I64, f: fn(I64, T) -> I64) -> I64 {
        var acc: I64 = init
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    acc = f(acc, v)
                    i += 1
                }
                None => { go = false }
            }
        }
        return acc
    }
    fn reduce(var self, f: fn(T, T) -> T) -> T? {
        var acc: T? = None
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    match acc {
                        Some(a) => { acc = Some(f(a, v)) }
                        None => { acc = Some(v) }
                    }
                    i += 1
                }
                None => { go = false }
            }
        }
        return acc
    }
    fn foreach(var self, f: fn(T)) -> I64 {
        var n: I64 = 0
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    f(v)
                    n += 1
                    i += 1
                }
                None => { go = false }
            }
        }
        return n
    }
    fn min(var self) -> T? {
        var best: T? = None
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    match best {
                        Some(b) => {
                            if v < b {
                                best = Some(v)
                            }
                        }
                        None => { best = Some(v) }
                    }
                    i += 1
                }
                None => { go = false }
            }
        }
        return best
    }
    fn max(var self) -> T? {
        var best: T? = None
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    match best {
                        Some(b) => {
                            if b < v {
                                best = Some(v)
                            }
                        }
                        None => { best = Some(v) }
                    }
                    i += 1
                }
                None => { go = false }
            }
        }
        return best
    }
    fn last(var self) -> T? {
        var out: T? = None
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    out = Some(v)
                    i += 1
                }
                None => { go = false }
            }
        }
        return out
    }
    fn position(var self, p: fn(T) -> Bool) -> I64? {
        var i: I64 = 0
        var go = true
        while go {
            match self.get(i) {
                Some(v) => {
                    if p(v) {
                        return Some(i)
                    }
                    i += 1
                }
                None => { go = false }
            }
        }
        return None
    }
}

// ---- 适配器 struct(get 变换;泛型单态化零成本) ----

// Pair —— enumerate/zip 的二元组元(fst=索引/左,snd=值/右)
struct Pair[F, G] {
    let fst: F
    let snd: G
}

// RawSeq —— 数组原始序列包装(src 直接索引;数组入口的接收者型)
struct RawSeq[S, T] {
    let src: S
}

// ListSeq —— List 包装序列(from_list 入口;前奏 class 直 impl trait 派发不挂,
// 探针实证,包装 struct 同 RawSeq 形接入)
struct ListSeq[T] {
    let src: List[T]
}

// MapSeq —— 映射适配器:逐位置应用 f
struct MapSeq[T, S] {
    let it: S
    let f: fn(T) -> T
}

// FilterSeq —— 过滤适配器:get 重扫上游取第 i 个过 p 的元素
struct FilterSeq[T, S] {
    let it: S
    let p: fn(T) -> Bool
}

// TakeSeq —— 截前 k 个适配器
struct TakeSeq[T, S] {
    let it: S
    let k: I64
}

// SkipSeq —— 跳前 n 个适配器(位置平移)
struct SkipSeq[T, S] {
    let it: S
    let n: I64
}

// TakeWhileSeq —— 取前缀适配器(遇首个不满足即断,与 filter 的逐点保留有别)
struct TakeWhileSeq[T, S] {
    let it: S
    let p: fn(T) -> Bool
}

// RevSeq —— 反转适配器(无状态重扫:每次 get O(n),总量 O(n·m))
struct RevSeq[T, S] {
    let it: S
}

// EnumSeq —— 索引配对适配器:get → Pair[I64, T]
struct EnumSeq[T, S] {
    let it: S
}

// ZipSeq —— 同型双序列拉链适配器(短者截断)
struct ZipSeq[T, S] {
    let it: S
    let ot: S
}

// ChainSeq —— 同型双序列串接适配器(b 侧定位含 a 全长重扫)
struct ChainSeq[T, S] {
    let a: S
    let b: S
}

// RawSeq:数组位置直读
impl Seq[T, RawSeq[S, T]] for RawSeq[S, T] {
    fn get(var self, i: I64) -> T? {
        if i < self.src.len {
            return Some(self.src[i])
        }
        return None
    }
}

// ListSeq:List 位置直读
impl Seq[T, ListSeq[T]] for ListSeq[T] {
    fn get(var self, i: I64) -> T? {
        if i < self.src.len {
            return Some(self.src[i])
        }
        return None
    }
}

// MapSeq:上游 get 后应用 f(逐点映射,不短路)
impl Seq[T, MapSeq[T, S]] for MapSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        let g = self.f
        match self.it.get(i) {
            Some(v) => { return Some(g(v)) }
            None => { return None }
        }
    }
}

// FilterSeq:重扫上游收集过 p 者,取第 i 个(O(n) 每次)
impl Seq[T, FilterSeq[T, S]] for FilterSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        let g = self.p
        var seen: I64 = 0
        var j: I64 = 0
        var go = true
        while go {
            match self.it.get(j) {
                Some(v) => {
                    if g(v) {
                        if seen == i {
                            return Some(v)
                        }
                        seen += 1
                    }
                    j += 1
                }
                None => { go = false }
            }
        }
        return None
    }
}

// TakeSeq:i < k 透传上游,此后 None
impl Seq[T, TakeSeq[T, S]] for TakeSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        if i < self.k {
            return self.it.get(i)
        }
        return None
    }
}

// SkipSeq:位置平移 i+n 读上游
impl Seq[T, SkipSeq[T, S]] for SkipSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        return self.it.get(i + self.n)
    }
}

// TakeWhileSeq:重扫上游取前缀,遇首不满足即断
impl Seq[T, TakeWhileSeq[T, S]] for TakeWhileSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        let g = self.p
        var seen: I64 = 0
        var j: I64 = 0
        var go = true
        while go {
            match self.it.get(j) {
                Some(v) => {
                    if g(v) {
                        if seen == i {
                            return Some(v)
                        }
                        seen += 1
                        j += 1
                    } else {
                        go = false
                    }
                }
                None => { go = false }
            }
        }
        return None
    }
}

// RevSeq:每次 get 先数上游全长再倒序取(O(n) 每次;缓存待 var-self 写回语义)
impl Seq[T, RevSeq[T, S]] for RevSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        // 无状态重扫:每次 get 计上游全长(正确性优先;缓存待 var-self 写回语义)
        var total: I64 = 0
        var j: I64 = 0
        var go = true
        while go {
            match self.it.get(j) {
                Some(_) => {
                    total += 1
                    j += 1
                }
                None => { go = false }
            }
        }
        if i < total {
            return self.it.get(total - 1 - i)
        }
        return None
    }
}

// EnumSeq:Pair{fst: i, snd: v} 直包上游
impl Seq[T, EnumSeq[T, S]] for EnumSeq[T, S] {
    fn get(var self, i: I64) -> Pair[I64, T]? {
        match self.it.get(i) {
            Some(v) => { return Some(Pair { fst: i, snd: v }) }
            None => { return None }
        }
    }
}

// ZipSeq:双侧同位读取,任一侧尽即 None(短者截断)
impl Seq[T, ZipSeq[T, S]] for ZipSeq[T, S] {
    fn get(var self, i: I64) -> Pair[T, T]? {
        match self.it.get(i) {
            Some(a) => {
                match self.ot.get(i) {
                    Some(b) => { return Some(Pair { fst: a, snd: b }) }
                    None => { return None }
                }
            }
            None => { return None }
        }
    }
}

// ChainSeq:a.get(i) 命中直返;否则数 a 全长 m 后读 b 的 i-m 位
impl Seq[T, ChainSeq[T, S]] for ChainSeq[T, S] {
    fn get(var self, i: I64) -> T? {
        match self.a.get(i) {
            Some(v) => { return Some(v) }
            None => {
                // a.get(i) 已尽则 a 长 m ≤ i:无状态重扫取 m,再读 b 的 i-m 位
                var m: I64 = 0
                var j: I64 = 0
                var go = true
                while go {
                    match self.a.get(j) {
                        Some(_) => {
                            m += 1
                            j += 1
                        }
                        None => { go = false }
                    }
                }
                return self.b.get(i - m)
            }
        }
    }
}

// ---- 数组入口(UFCS:xs.map(f) 以接收者填首参;§4.8) ----

// 数组入口:xs.map(f)(UFCS 接收者填首参;包 RawSeq 成 MapSeq)
pub fn map(xs: I32[], f: fn(I32) -> I32) -> MapSeq[I32, RawSeq[I32[], I32]] {
    return MapSeq { it: RawSeq { src: xs }, f: f }
}

// 数组入口:xs.filter(p)
pub fn filter(xs: I32[], p: fn(I32) -> Bool) -> FilterSeq[I32, RawSeq[I32[], I32]] {
    return FilterSeq { it: RawSeq { src: xs }, p: p }
}

// 数组入口:xs.take(k) 截前 k 个
pub fn take(xs: I32[], k: I64) -> TakeSeq[I32, RawSeq[I32[], I32]] {
    return TakeSeq { it: RawSeq { src: xs }, k: k }
}

// 数组入口:xs.skip(n) 跳前 n 个
pub fn skip(xs: I32[], n: I64) -> SkipSeq[I32, RawSeq[I32[], I32]] {
    return SkipSeq { it: RawSeq { src: xs }, n: n }
}

// 数组入口:xs.take_while(p) 取前缀直遇首败
pub fn take_while(xs: I32[], p: fn(I32) -> Bool) -> TakeWhileSeq[I32, RawSeq[I32[], I32]] {
    return TakeWhileSeq { it: RawSeq { src: xs }, p: p }
}

// 数组入口:xs.rev() 反转视图(无状态重扫)
pub fn rev(xs: I32[]) -> RevSeq[I32, RawSeq[I32[], I32]] {
    return RevSeq { it: RawSeq { src: xs } }
}

// 数组入口:xs.enumerate() → Pair[I64, T] 序列
pub fn enumerate(xs: I32[]) -> EnumSeq[I32, RawSeq[I32[], I32]] {
    return EnumSeq { it: RawSeq { src: xs } }
}

// 数组入口:xs.zip(ys) 同型拉链(短者截断)
pub fn zip(xs: I32[], ys: I32[]) -> ZipSeq[I32, RawSeq[I32[], I32]] {
    return ZipSeq { it: RawSeq { src: xs }, ot: RawSeq { src: ys } }
}

// 数组入口:xs.chain(ys) 同型串接
pub fn chain(xs: I32[], ys: I32[]) -> ChainSeq[I32, RawSeq[I32[], I32]] {
    return ChainSeq { a: RawSeq { src: xs }, b: RawSeq { src: ys } }
}

// List 入口:iter.from_list(xs)(前奏 class 直 impl 派发不挂,包装 struct 接入)
pub fn from_list(xs: List[I32]) -> ListSeq[I32] {
    return ListSeq { src: xs }
}

// ---- 数组直终结(快路径:零包装直接索引循环) ----

// 数组直终结快路径:I64 累加(零包装索引循环)
pub fn sum(xs: I32[]) -> I64 {
    var t: I64 = 0
    var i: I64 = 0
    while i < xs.len {
        t += xs[i]
        i += 1
    }
    return t
}

// 数组直终结:len 直返
pub fn count(xs: I32[]) -> I64 {
    return xs.len
}

// 数组直终结:转 List[I32]
pub fn collect(xs: I32[]) -> List[I32] {
    let out = List[I32]()
    var i: I64 = 0
    while i < xs.len {
        out.push(xs[i])
        i += 1
    }
    return out
}

// 数组直终结:短路存在判定
pub fn any(xs: I32[], p: fn(I32) -> Bool) -> Bool {
    var i: I64 = 0
    while i < xs.len {
        if p(xs[i]) {
            return true
        }
        i += 1
    }
    return false
}

// 数组直终结:短路全称判定
pub fn all(xs: I32[], p: fn(I32) -> Bool) -> Bool {
    var i: I64 = 0
    while i < xs.len {
        if !p(xs[i]) {
            return false
        }
        i += 1
    }
    return true
}

// 数组直终结:I64 折叠(init 起,逐元素左折叠)
pub fn fold(xs: I32[], init: I64, f: fn(I64, I32) -> I64) -> I64 {
    var acc: I64 = init
    var i: I64 = 0
    while i < xs.len {
        acc = f(acc, xs[i])
        i += 1
    }
    return acc
}

// 数组直终结:同型归并;空数组 None
pub fn reduce(xs: I32[], f: fn(I32, I32) -> I32) -> I32? {
    if xs.len == 0 {
        return None
    }
    var acc: I32 = xs[0]
    var i: I64 = 1
    while i < xs.len {
        acc = f(acc, xs[i])
        i += 1
    }
    return Some(acc)
}

// 数组直终结:逐元素执行 f,返回处理数
pub fn foreach(xs: I32[], f: fn(I32)) -> I64 {
    var n: I64 = 0
    var i: I64 = 0
    while i < xs.len {
        f(xs[i])
        n += 1
        i += 1
    }
    return n
}

// 数组直终结:最小值;空数组 None
pub fn min(xs: I32[]) -> I32? {
    if xs.len == 0 {
        return None
    }
    var best: I32 = xs[0]
    var i: I64 = 1
    while i < xs.len {
        if xs[i] < best {
            best = xs[i]
        }
        i += 1
    }
    return Some(best)
}

// 数组直终结:最大值;空数组 None
pub fn max(xs: I32[]) -> I32? {
    if xs.len == 0 {
        return None
    }
    var best: I32 = xs[0]
    var i: I64 = 1
    while i < xs.len {
        if best < xs[i] {
            best = xs[i]
        }
        i += 1
    }
    return Some(best)
}

// 数组直终结:末元素;空数组 None
pub fn last(xs: I32[]) -> I32? {
    if xs.len == 0 {
        return None
    }
    return Some(xs[xs.len - 1])
}

// 数组直终结:首个满足 p 的下标;无则 None
pub fn position(xs: I32[], p: fn(I32) -> Bool) -> I64? {
    var i: I64 = 0
    while i < xs.len {
        if p(xs[i]) {
            return Some(i)
        }
        i += 1
    }
    return None
}

// ---- T17:parallel 域面汇聚(§7.7 std.iter 归位;前奏内建薄包装) ----
// use std.iter.{parallel} 后 parallel.map/reduce 可用;前奏直用 parallel
// 保持兼容(过渡双轨,迁移注记入 COVERAGE)

// 前奏 parallel.map 薄包装(§7.7 归位;前奏直用 parallel 过渡兼容)
pub fn parallel_map(xs: List[I32], f: fn(I32) -> I32) -> List[I32] {
    return parallel.map(xs, f)
}

// 前奏 parallel.reduce 薄包装(init 起 I32 归并;过渡兼容同上)
pub fn parallel_reduce(xs: List[I32], init: I32, f: fn(I32, I32) -> I32) -> I32 {
    return parallel.reduce(xs, init, f)
}
