// examples/todo_v10 —— SL-8c-4④:§10.3 Todo 照抄面(合成用户面 v1)
// 规范 §10 v10 终锚的 8c-4 兑现形态:main 装配一行(run(TodoApp(m: make()))),
// 零手写 bind/act——bind/act/装配由编译器从 view 槽/事件表合成(8c-4②)。
// 差集如实登记(随终锚):on:input 键入持久化(名通道契约的生成面待做)、
// 每行勾选/删除(key/实例分发对偶面)、跨文件 view 导入(组件模型 P2)、
// checkbox(T1 里程碑)。列表删除 = 过滤重建配方(List 无删除原语)。
use gui.{test, d_frame, d_expect_text, d_expect_absent}

struct Model {
    var draft: Str
    var todos: List[Str]
}

fn make() -> Model {
    return Model { draft: "", todos: List[Str]() }
}

fn input(m: Box[Model], text: Str) {
    m.draft = text
}

fn add_todo(m: Box[Model]) {
    if m.draft.len > 0 {
        m.todos.push(m.draft)
        m.draft = ""
    }
}



fn remove_last(m: Box[Model]) {
    if m.todos.len > 0 {
        var kept = List[Str]()
        var i: I32 = 0
        while i < m.todos.len - 1 {
            kept.push(m.todos[i])
            i += 1
        }
        m.todos = kept
    }
}

view TodoApp(m: Model) {
  <vbox class="root">
    <label class="title">todos</label>
    <input bind={m.draft} class="fld" on:input={input(m)}/>
    <button class="btn" on:click={add_todo(m)}>add</button>
    <when cond={m.todos.len == 0}>
      <label class="empty">nothing yet</label>
    </when>
    <each t in={m.todos}>
      <label class="row">{t}</label>
    </each>
    <button class="del" on:click={remove_last(m)}>remove last</button>
  </vbox>
}
style root { direction: column gap: 8 padding: 16 }
style title { fg: "#ffffff" size: 28 h: 44 }
style fld { bg: "#2a2a2e" fg: "#ffffff" h: 36 }
style btn { bg: "#2563eb" fg: "#ffffff" w: 120 h: 44 }
style empty { fg: "#888888" h: 30 }
style row { fg: "#e5e5e5" h: 32 }
style rowtext { fg: "#e5e5e5" h: 32 }

style del { bg: "#7f1d1d" fg: "#ffffff" w: 140 h: 40 }

// headless 自动验收:合成 fn 直驱(与生成装配同契约)——模型级设置代替
// 键入(on:input 持久化差集在案),断言 when 空态/each 渲染/act 分发/删末项
fn seed_second(m: Box[Model]) {
    m.todos.push("second item")
}

fn headless_suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[Model](make())
    var rc: I32 = test(src, 320, 640,
        |buf| __gui_bind_TodoApp(buf, m),
        |name| __gui_act_TodoApp(name, m),
        |k| { },
        |t, act, key| {
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "todos")
            // when 空态:v10 差集面
            d_expect_text(t, "nothing yet")
            // 键入持久化:on:input 名通道("头名:全文")→ 合成 act 前缀分支
            __gui_act_TodoApp("input:write the spec", m)
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "write the spec")
            // 合成分发 add_todo
            __gui_act_TodoApp("add_todo", m)
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            d_expect_text(t, "write the spec")
            d_expect_absent(t, "nothing yet")
            seed_second(m)
            d_frame(t, |buf| __gui_bind_TodoApp(buf, m))
            // 行内换行按词拆绘制命令(渲染细节),按词断言
            d_expect_text(t, "second item")
            // 删末项:过滤重建配方
            act("remove_last:0")
        })
    return rc
}

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return headless_suite()
    }
    return run(TodoApp(m: make()))
}
