// examples/gui_files —— 文件查看器(L1 域包形态;真实 IO 首例)
// 平台全在 gui 域包;用户树 = 目录状态 + 导航动作 + 视图。
// 双口径:CTRON_GUI_HEADLESS=1 → 域包 test()(列表/导航/预览/错误态,全自动);
//   缺省/--run → run_kb 真窗口。
// 差集(登记):行级点击导航 = 实例索引分发 L1 缺口,输入导航替代;IME 组词随 M3。
// 注:main 首个 read_file 字面量为发射锚(烘焙 app.ctml;run.sh 已 cd 本目录);
//   注释内不放花括号(发射词法)。

use gui.{run_kb, test, d_click, d_frame, d_type_char, d_expect_text, d_expect_absent, char_str}

struct Model {
    var cwd: Str
    var draft: Str
    var entries: List[Str]
    var preview: Str
    var hasprev: Bool
    var msgon: Bool
    var msg: Str
}

// E8120 处理函数声明 stub(真分发在 act)
fn go() {
}
fn up() {
}

// 路径拼接:尾带斜杠(根 "/")不重复
fn join(a: Str, b: Str) -> Str {
    if a.len > 0 {
        if byte_at(a, a.len - 1) == 47 {
            return a + b
        }
    }
    return a + "/" + b
}

// 上级目录:剥末段;无分隔符(相对根)回 "/"
fn parent_of(p: Str) -> Str {
    var e: I32 = p.len
    if e > 1 {
        if byte_at(p, e - 1) == 47 {
            e = e - 1
        }
        var i: I32 = e - 1
        while i > 0 {
            if byte_at(p, i) == 47 {
                return byte_slice(p, 0, i)
            }
            i = i - 1
        }
    }
    return "/"
}

// read_dir 产物(换行分隔)切条目;跳过空段(readdir 序不保证,如实展示)
fn split_entries(s: Str) -> List[Str] {
    var out = List[Str]()
    var start: I32 = 0
    var i: I32 = 0
    while i < s.len {
        if byte_at(s, i) == 10 {
            if i > start {
                out.push(byte_slice(s, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < s.len {
        out.push(byte_slice(s, start, s.len))
    }
    return out
}

// 预览截头(单行显示;UTF-8 截尾由渲染侧容错)
fn head_bytes(s: Str, n: I32) -> Str {
    if s.len > n {
        return byte_slice(s, 0, n)
    }
    return s
}

// 进入目录:成功则换 cwd 并刷新列表(目录探测 = read_dir 可读性,内建无 is_dir)
fn try_chdir(m: Box[Model], target: Str) -> Bool {
    var ok: Bool = false
    match read_dir(target) {
        Some(s) => {
            m.cwd = target
            m.entries = split_entries(s)
            ok = true
        }
        None => {
            ok = false
        }
    }
    return ok
}

// 文件预览:可读则上屏,不可读则报错
fn show_file(m: Box[Model], target: Str) {
    match read_file(target) {
        Some(txt) => {
            m.preview = head_bytes(txt, 240)
            m.hasprev = true
            m.msgon = false
        }
        None => {
            m.hasprev = false
            m.msgon = true
            m.msg = "打不开: " + m.draft
        }
    }
}

// 动作收口:go = 目录优先,退而预览文件,再而报错;up = 上级
fn act(name: Str, m: Box[Model]) {
    if name == "go" {
        if m.draft.len > 0 {
            var target: Str = join(m.cwd, m.draft)
            if try_chdir(m, target) {
                m.hasprev = false
                m.msgon = false
                m.preview = ""
                m.draft = ""
            } else {
                show_file(m, target)
                if m.hasprev {
                    m.draft = ""
                }
            }
        }
    } else {
        if name == "up" {
            var p2: Str = parent_of(m.cwd)
            if try_chdir(m, p2) {
                m.hasprev = false
                m.msgon = false
                m.preview = ""
            }
        }
    }
}

// 键入:退格删尾,可打印 ASCII 追加(IME 组词随 M3)
fn on_key(k: I32, m: Box[Model]) {
    if k == 259 {
        if m.draft.len > 0 {
            m.draft = byte_slice(m.draft, 0, m.draft.len - 1)
        }
    } else {
        if k >= 32 {
            if k < 127 {
                m.draft = m.draft + char_str(k)
            }
        }
    }
}

fn b2s(b: Bool) -> Str {
    if b {
        return "1"
    }
    return "0"
}

// bind 通道分发:cwd/draft/preview/msg 标量、when:* 三态、each:entries 逐项
fn bind_all(buf: List[Str], m: Box[Model]) {
    if buf[0] == "cwd" {
        buf.push(m.cwd)
    }
    if buf[0] == "draft" {
        buf.push(m.draft)
    }
    if buf[0] == "preview" {
        buf.push(m.preview)
    }
    if buf[0] == "msg" {
        buf.push(m.msg)
    }
    if buf[0] == "when:msgon" {
        buf.push(b2s(m.msgon))
    }
    if buf[0] == "when:hasprev" {
        buf.push(b2s(m.hasprev))
    }
    if buf[0] == "when:empty" {
        if m.entries.len == 0 {
            buf.push("1")
        } else {
            buf.push("0")
        }
    }
    if buf[0] == "each:entries" {
        var i: I32 = 0
        while i < m.entries.len {
            buf.push(m.entries[i])
            i = i + 1
        }
    }
}

// 初始目录装配(不可读则错误态上屏)
fn refresh(m: Box[Model]) {
    var ok: Bool = try_chdir(m, m.cwd)
    if ok {
        m.msgon = false
    } else {
        m.msgon = true
        m.msg = "打不开: " + m.cwd
    }
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var m = Box[Model](Model { cwd: "testdata", draft: "", entries: List[Str](), preview: "", hasprev: false, msgon: false, msg: "" })
    refresh(m)
    if env_get("CTRON_GUI_HEADLESS") != "" {
        // headless:域包 test() 驱动,断言走命令缓冲(列表/导航/预览/错误态)
        var rc: I32 = test(src, 480, 640,
            |buf| bind_all(buf, m),
            |name, args| act(name, m),
            |k| on_key(k, m),
            |t, a, key| {
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "目录: testdata")
                d_expect_text(t, "hello.txt")
                d_expect_text(t, "笔记.txt")
                d_expect_text(t, "sub")
                // 键入 hello.txt → 打开 → 预览上屏
                key(d_type_char(t, 104))
                key(d_type_char(t, 101))
                key(d_type_char(t, 108))
                key(d_type_char(t, 108))
                key(d_type_char(t, 111))
                key(d_type_char(t, 46))
                key(d_type_char(t, 116))
                key(d_type_char(t, 120))
                key(d_type_char(t, 116))
                a(d_click(t, "go"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "你好,来自 gui_files 的预览!")
                d_expect_absent(t, "空目录")
                // 键入 sub → 打开 → 进入子目录,父目录条目消失
                key(d_type_char(t, 115))
                key(d_type_char(t, 117))
                key(d_type_char(t, 98))
                a(d_click(t, "go"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "目录: testdata/sub")
                d_expect_text(t, "中文文件.txt")
                d_expect_absent(t, "hello.txt")
                // 上级 → 回 testdata
                a(d_click(t, "up"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "目录: testdata")
                d_expect_text(t, "sub")
                // 键入 nope → 打开 → 错误态
                key(d_type_char(t, 110))
                key(d_type_char(t, 111))
                key(d_type_char(t, 112))
                key(d_type_char(t, 101))
                a(d_click(t, "go"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "打不开: nope")
                println("gui_files: headless 全链路全绿(列表/导航/预览/错误态)")
            })
        return rc
    }
    // 窗口口径:run_kb(键入钩子 + 点击分发,域包事件循环)
    run_kb(src, "ctron gui_files", 480, 640,
        |buf| bind_all(buf, m),
        |name, args| act(name, m),
        |k| on_key(k, m))
    println("gui_files: 窗口退出,cwd = " + m.cwd)
    return 0
}
