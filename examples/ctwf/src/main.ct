// ctwf —— 词频统计工具(自举 Ctron 示例应用;R-P2b 出口:纯 Ctron CLI 程序)
// 用法:ctwf run <file> → 每行 "<词> <次数>"(插入序,确定性)+ 末行汇总。
// 汇总行 "distinct=<N>|total=<M>|<路径>" 经 std.str.join 组装(锚定 join 发射面)。
use std.str.{words, join}
use std.fmap.{fnew, fput, fget, flen, fwords, fvals}
use std.sort.{sorted_by_desc}

// 词频查值(线性;闭包捕获两平行 List——struct 值不入 ct_i 包装,故不直接捕获 m)
fn cnt_of(ks: List[Str], vs: List[I32], w: Str) -> I32 {
    var i: I32 = 0
    while i < ks.len {
        if ks[i] == w {
            return vs[i]
        }
        i += 1
    }
    return 0
}

fn main() -> I32 {
    var path = ctron_entry()
    if path == "" {
        println("ctwf: usage: ctwf run <file>")
        return 1
    }
    match read_file(path) {
        Some(s) => {
            var ws = words(s)
            var m = fnew[I32]()
            var i: I32 = 0
            while i < ws.len {
                m = fput[I32](m, ws[i], fget[I32](m, ws[i], 0) + 1)
                i += 1
            }
            var vocab = fwords[I32](m)
            var j: I32 = 0
            while j < vocab.len {
                println(vocab[j] + " " + fget[I32](m, vocab[j], 0).to_string())
                j += 1
            }
            var parts = List[Str]()
            parts.push("distinct=" + flen[I32](m).to_string())
            parts.push("total=" + ws.len.to_string())
            parts.push(path)
            println(join(parts, "|"))
            // Top-3:索引排序(sorted_by_desc[I32],闭包形参限 32 位 ct_i ABI——
            // 捕获词表/值表/全表三个 List 句柄,count 比较经 cnt_of)
            var ks = fwords[I32](m)
            var vs = fvals[I32](m)
            var idxs = List[I32]()
            var j2: I32 = 0
            while j2 < vocab.len {
                idxs.push(j2)
                j2 += 1
            }
            var byidx = sorted_by_desc[I32](idxs, |a, b| cnt_of(ks, vs, vocab[a]) < cnt_of(ks, vs, vocab[b]))
            var topk = 3
            if byidx.len < topk {
                topk = byidx.len
            }
            var tops = List[Str]()
            var k2: I32 = 0
            while k2 < topk {
                var w2 = vocab[byidx[k2]]
                tops.push(w2 + "=" + cnt_of(ks, vs, w2).to_string())
                k2 += 1
            }
            println("top:" + join(tops, ","))
        }
        None => {
            println("ctwf: cannot open " + path)
            return 1
        }
    }
    return 0
}
