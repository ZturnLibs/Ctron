// examples/gui_widgets —— 组件陈列室(Select/WList/Dialog 全交互演示)
// headless:开下拉→点选→开模态→Esc 关,四段断言;--rt_run_src 真窗手玩
use gui.{rt_run_kb_anchor, test, d_frame, d_click, d_send_key, d_drag, d_mod, d_press_key, gui_hotkey, ev_arg_i,
         d_expect_text, d_expect_absent, d_cmd_count, d_cmd_type, d_cmd_w100, d_cmd_x100, d_cmd_y100, d_cmd_h100, theme_apply, theme_auto_apply,
         theme_dark, theme_light}

struct Model {
    var picked: Str
    var selopen: Bool
    var dopen: Bool
    var state: Str
    var dark: Bool

    var mopen: Bool
    var mself: I32
    var lsel: I32
    var tsel: I32
    var sval: Str
}

fn sel_toggle() {
}
fn sel_pick() {
}
fn list_pick() {
}
fn dialog_open() {
}
fn dialog_close() {
}
fn dialog_confirm() {
}
fn dialog_cancel() {
}
fn slide(p: I32) {
}
fn track_xy(out: List[I32]) -> I32 {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 2 {
            // spacer=全宽分隔线语义(w 不消费,实测 328x8);以 h=8 特征寻轨
            if d_cmd_h100(i) == 800 {
                if d_cmd_w100(i) > 30000 {
                    out.push(d_cmd_x100(i) / 100 + 30)
                    out.push(d_cmd_y100(i) / 100 + 4)
                    return 0
                }
            }
        }
        i += 1
    }
    var seen: Str = ""
    var j2: I32 = 0
    while j2 < n {
        if d_cmd_type(j2) == 2 {
            seen = seen + (d_cmd_w100(j2) / 100).to_string() + "x" + (d_cmd_h100(j2) / 100).to_string() + " "
        }
        j2 += 1
    }
    panic("widgets: 轨道未渲染 seen=[" + seen + "]")
    return -1
}
fn modstick(mm: Box[Model], md: I32) {
}

fn act(name: Str, args: List[Str], m: Box[Model]) {
    if name == "sel_toggle" {
        if m.selopen {
            m.selopen = false
        } else {
            m.selopen = true
        }
    }
    if name == "sel_pick" {
        m.selopen = false
        m.picked = "Ctron"
        m.state = "已选"
    }
    if name == "list_pick" {
        m.state = "清单点选"
    }
    if name == "dialog_open" {
        m.dopen = true
    }
    if name == "dialog_close" {
        m.dopen = false
        m.state = "已关闭(遮罩)"
    }
    if name == "dialog_confirm" {
        m.dopen = false
        m.state = "已确认"
    }
    if name == "dialog_cancel" {
        m.dopen = false
        m.state = "已取消"
    }
    if name == "menu_toggle" {
        if m.mopen {
            m.mopen = false
        } else {
            m.mopen = true
        }
    }
    if name == "menu_pick" {
        m.mopen = false
        m.mself = 0
        m.state = "菜单已选"
    }
    if name == "edit_menu" {
        m.state = "编辑菜单(演示触发)"
    }
    if name == "list_sel" {
        m.lsel = 0
        m.state = "兴趣已选"
    }
    if name == "tab_pick" {
        m.tsel = 0
        m.state = "表格行已选"
    }
    if name == "slide" {
        // 拖拽事件缝:dragpx 千分比 → 百分比
        m.sval = (ev_arg_i(args, 0) / 10).to_string()
        return
    }
}

fn bind_all(buf: List[Str], m: Box[Model]) {
    if buf[0] == "picked" {
        if m.picked == "" {
            buf.push("选择框架…")
        } else {
            buf.push(m.picked)
        }
    }
    if buf[0] == "selopen" {
        if m.selopen {
            buf.push("b:1")
        } else {
            buf.push("b:0")
        }
    }
    if buf[0] == "dopen" {
        if m.dopen {
            buf.push("b:1")
        } else {
            buf.push("b:0")
        }
    }
    if buf[0] == "state" {
        buf.push(m.state)
    }
    if buf[0] == "each:opts" {
        buf.push("Ctron")
        buf.push("raylib")
        buf.push("Clay")
    }
    if buf[0] == "each:items" {
        buf.push("写发布说明")
        buf.push("打标签 v0.1")
    }
    if buf[0] == "mopen" {
        if m.mopen {
            buf.push("b:1")
        } else {
            buf.push("b:0")
        }
    }
    if buf[0] == "each:mitems" {
        if m.mself == 0 {
            buf.push("✓ 打开")
        } else {
            buf.push("打开")
        }
        buf.push("另存为")
    }
    if buf[0] == "each:litems" {
        if m.lsel == 0 {
            buf.push("> 读书")
        } else {
            buf.push("读书")
        }
        if m.lsel == 1 {
            buf.push("> 跑步")
        } else {
            buf.push("跑步")
        }
    }
    if buf[0] == "sval" {
        buf.push(m.sval)
    }
    if buf[0] == "each:titems" {
        if m.tsel == 0 {
            buf.push("> 张三 · 32")
        } else {
            buf.push("张三 · 32")
        }
        if m.tsel == 1 {
            buf.push("> 李四 · 28")
        } else {
            buf.push("李四 · 28")
        }
    }
}

// 键 1/2 切主题(应用侧演示;陈列室不内置快捷键合约)
fn apply_key(k: I32, m: Box[Model]) {
    if k == 49 {
        theme_apply(theme_dark())
        m.dark = true
        m.state = "dark"
    }
    if k == 50 {
        theme_apply(theme_light())
        m.dark = false
        m.state = "light"
    }
}

fn main() -> I32 {
    var m = Box[Model](Model { picked: "", selopen: false, dopen: false, state: "", dark: true, mopen: false, mself: 0 - 1, lsel: 0 - 1, tsel: 0 - 1, sval: "0" })
    if env_get("CTRON_GUI_HEADLESS") == "" {
        theme_auto_apply()
        var rc: I32 = rt_run_kb_anchor("Ctron 组件陈列室", 360, 520,
            |buf| bind_all(buf, m),
            |name, args| act(name, args, m),
            |k| apply_key(k, m))
        return rc
    }
    var src: Str = read_file("app.ctml")
    theme_apply(theme_dark())
    var rc: I32 = test(src, 360, 760,
        |buf| bind_all(buf, m),
        |name, args| act(name, args, m),
        |k| apply_key(k, m),
        |t, actc, k2| {
            // 收起态
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "Ctron 组件陈列室")
            d_expect_text(t, "选择框架…")
            d_expect_absent(t, "raylib")
            // 开下拉 → 选项可见
            actc(d_click(t, "sel_toggle"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "raylib")
            // 点选(实例后缀事件) → 收起+选中回显
            actc(d_click(t, "sel_pick"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_absent(t, "raylib")
            d_expect_text(t, "已选")
            // 模态:开 → 取消按钮 → 已取消;再开 → 确认按钮 → 已确认;
            // 遮罩/Esc 关 = 已关闭(遮罩)
            actc("dialog_open", List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "确认操作?")
            actc(d_click(t, "dialog_cancel"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "已取消")
            actc("dialog_open", List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            actc(d_click(t, "dialog_confirm"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "已确认")
            actc("dialog_open", List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            var esk: I32 = d_send_key(t, 256,
                |buf| bind_all(buf, m),
                |nm, ar| act(nm, ar, m))
            if esk != 0 {
                panic("widgets: 模态 Esc 未消费")
            }
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "已关闭(遮罩)")
            // 主题切换:light 全套换装
            k2(d_press_key(t, 50))
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "light")
            // ===== 组件目录第二波 =====
            // Menu:开 → 项可见 → pick → ✓ 前缀 + 收起
            actc(d_click(t, "menu_toggle"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "打开")
            actc(d_click(t, "menu_pick"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_absent(t, "另存为")
            // 重开验选中前缀持久(pick 收起菜单)
            actc(d_click(t, "menu_toggle"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "✓ 打开")
            // List:行点选 → "> " 前缀
            actc(d_click(t, "list_sel"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "> 读书")
            // Table:行点选 → "> " 前缀
            actc(d_click(t, "tab_pick"), List[Str]())
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "> 张三 · 32")
            // Divider/Card:渲染存在
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "卡片内容:ELEVATED 包装")
            // ===== Slider(拖拽事件缝:on:drag + dragpx 内建名) =====
            // 轨道矩形运行时扫描(w=220 特征),坐标免布局估计
            var txy = List[I32]()
            track_xy(txy)
            d_drag(t, txy[0], txy[1], txy[0] + 110, |buf| bind_all(buf, m), |nm, ar| act(nm, ar, m))
            d_frame(t, |buf| bind_all(buf, m))
            d_expect_text(t, "42")
            println("WIDGETS-GREEN")
        })
    return rc
}
