fn track_xy(out: List[I32]) -> I32 {
    var n: I32 = d_cmd_count()
    var i: I32 = 0
    while i < n {
        if d_cmd_type(i) == 2 {
            // spacer=全宽分隔线语义(w 不消费,实测 328x8);以 h=8 特征寻轨
            if d_cmd_h100(i) == 800 {
                // GUI-16 统一语义:spacer 轨道 w:220 旧忽略恒 GROW,现 FIXED 220
                if d_cmd_w100(i) > 20000 {
                    out.push(d_cmd_x100(i) / 100 + 30)
                    out.push(d_cmd_y100(i) / 100 + 4)
                    return 0
                }
            }
        }
        i += 1
    }
    var seen: Str = ""
    var j2: I32 = 0
    while j2 < n {
        if d_cmd_type(j2) == 2 {
            seen = seen + (d_cmd_w100(j2) / 100).to_string() + "x" + (d_cmd_h100(j2) / 100).to_string() + " "
        }
        j2 += 1
    }
    panic("widgets: 轨道未渲染 seen=[" + seen + "]")
    return -1
}
