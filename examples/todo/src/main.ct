// examples/todo —— 规范 §10 Todo 演绎,L1 域包形态(use gui 收敛,SL-5 门面)
// 平台(解析/布局/命中/事件循环)全部在 std/gui 域包;用户树 = 数据 + 动作 + 视图。
// 双口径:CTRON_GUI_HEADLESS=1 → 域包 test() 注入断言(headless 全自动);
//   缺省/--run → run_kb 真窗口(键入 + 点击)。
// 差集(登记):per-row checkbox/逐项删除 = 实例索引分发 L1 缺口,del 末项替代;
//   on:submit/IME 组词随 M3;行文本直显(旧形态 [x] 前缀随 checkbox 一并退役)。
// 坑位:headless 视口须容得下全内容——Clay 对视口外元素剔除渲染命令,列表增高后
//   行/空态文本会从命令缓冲消失(视口 320x640;上回迁移二试 when 不渲染疑云即此)。
// 注:main 首个 read_file 字面量为发射锚(烘焙 app.ctml;run.sh 已 cd 本目录);
//   注释内不放花括号(发射词法)。

use std.gui.{run_kb, test, d_click, d_frame, d_type_char, d_expect_text, d_expect_absent}

struct Model {
    var draft: Str
    var todos: List[Str]
}

// E8120 处理函数声明 stub(真分发在 act)
fn add() {
}
fn del() {
}

// bind 通道分发:绑定名 n/draft、when:empty、each:todos(逐帧活值实时询问)
fn bind_all(buf: List[Str], m: Box[Model]) {
    if buf[0] == "n" {
        buf.push(m.todos.len.to_string())
    }
    if buf[0] == "draft" {
        buf.push(m.draft)
    }
    if buf[0] == "when:empty" {
        if m.todos.len == 0 {
            buf.push("1")
        } else {
            buf.push("0")
        }
    }
    if buf[0] == "each:todos" {
        var i: I32 = 0
        while i < m.todos.len {
            buf.push(m.todos[i])
            i += 1
        }
    }
}

// 动作收口:add 回显值入列并清 draft;del 移除末项(重建配方——零参方法发射
// 缺口 t_pop 悬空逗号登记归发射泳道,此处以重建+成员赋值绕行)
fn act(name: Str, m: Box[Model]) {
    if name == "add" {
        if m.draft.len > 0 {
            m.todos.push(m.draft)
            m.draft = ""
        }
    } else {
        if name == "del" {
            if m.todos.len > 0 {
                var kept = List[Str]()
                var i: I32 = 0
                while i < m.todos.len - 1 {
                    kept.push(m.todos[i])
                    i += 1
                }
                m.todos = kept
            }
        }
    }
}

// 键入:退格删尾,可打印 ASCII 追加
fn on_key(k: I32, m: Box[Model]) {
    if k == 259 {
        if m.draft.len > 0 {
            m.draft = byte_slice(m.draft, 0, m.draft.len - 1)
        }
    } else {
        if k >= 32 {
            if k < 127 {
                m.draft = m.draft + char_str(k)
            }
        }
    }
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var m = Box[Model](Model { draft: "", todos: List[Str]() })
    if env_get("CTRON_GUI_HEADLESS") != "" {
        // headless:域包 test() 驱动,断言走命令缓冲(键入/回显/添加/列表/空态/删除)
        var rc: I32 = test(src, 320, 640,
            |buf| bind_all(buf, m),
            |name| act(name, m),
            |k| on_key(k, m),
            |t, a, key| {
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "todo: 0")
                d_expect_text(t, "nothing yet")
                key(d_type_char(t, 97))
                key(d_type_char(t, 98))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "ab")
                a(d_click(t, "add"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "todo: 1")
                d_expect_text(t, "ab")
                d_expect_absent(t, "nothing yet")
                key(d_type_char(t, 99))
                key(d_type_char(t, 100))
                a(d_click(t, "add"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "todo: 2")
                d_expect_text(t, "cd")
                a(d_click(t, "del"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "todo: 1")
                d_expect_absent(t, "cd")
                a(d_click(t, "del"))
                d_frame(t, |buf| bind_all(buf, m))
                d_expect_text(t, "todo: 0")
                d_expect_text(t, "nothing yet")
                println("todo: headless 全链路全绿(键入/回显/添加/列表/空态/删除)")
            })
        return rc
    }
    // 窗口口径:run_kb(键入钩子 + 点击分发,域包事件循环)
    run_kb(src, "ctron todo", 320, 640,
        |buf| bind_all(buf, m),
        |name| act(name, m),
        |k| on_key(k, m))
    println("todo: 窗口退出,todos = " + m.todos.len.to_string())
    return 0
}
