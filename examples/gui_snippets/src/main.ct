// examples/gui_snippets —— 代码片段管理器(跨文件组件+契约Ⅰ列表 prop+Ⅱ-b 模型捕获)
// 组件居 widgets.ct(Select/WList/Dialog),根视图 run(ViewCall) 一行装配;
// 组件事件首参 Box = 模型捕获直传(Ⅱ-b),组件事件即可改宿主模型;
// headless 直驱合成 fn 全链:列表过滤选择/新建/保存/删除模态/Esc 关。
// 组件消费共享库:pkgs/gui_widgets(Select/WList/Dialog+w-* 预设;
// GuiBlock 恒随合并,锚 gui_widgets_ver 一符全量并入;事件处理器仍驻宿主)
use gui_widgets.{gui_widgets_ver}
use gui.{test, d_frame, d_click, d_send_key,
         d_expect_text, d_expect_absent, d_cmd_count, d_cmd_type, d_cmd_text_len, d_cmd_text_byte, char_str}

struct Model {
    var names: List[Str]
    var bodies: List[Str]
    var cats: List[Str]
    var opts: List[Str]
    var items: List[Str]
    var sel: I32
    var catlabel: Str
    var catopen: Bool
    var catidx: I32
    var listtitle: Str
    var content: Str
    var status: Str
    var delopen: Bool
    var editing: Bool
}

fn snip_tag() -> Str {
    return "SNIP"
}

fn make() -> Model {
    var tl = List[Str]()
    tl.push("hello world")
    tl.push("deploy script")
    var ol = List[Str]()
    ol.push("all")
    ol.push("ct")
    ol.push("sh")
    return Model { names: List[Str](), bodies: List[Str](), cats: List[Str](), opts: ol, items: tl, sel: 0, catlabel: "all", catopen: false, catidx: 0, listtitle: "Snippets", content: "", status: "", delopen: false, editing: false }
}

fn sel_toggle(m: Box[Model]) {
    if m.catopen {
        m.catopen = false
    } else {
        m.catopen = true
    }
}

fn sel_pick(m: Box[Model], row: I32) {
    m.catopen = false
    m.catidx = 1
    m.catlabel = "all"
}

fn list_pick(m: Box[Model], row: I32) {
    m.editing = true
    m.status = "SELECTED"
}

fn new_snip(m: Box[Model]) {
    m.content = ""
    m.editing = true
    m.status = "NEWSNIP"
}

fn save_snip(m: Box[Model]) {
    m.status = "SAVED"
}

fn del_ask(m: Box[Model]) {
    m.delopen = true
}

fn del_confirm(m: Box[Model]) {
    m.delopen = false
    m.status = "deleted"
}

// 库全事件名集空壳桩:骨架面按合并库全量注册事件表(未实例化组件也在),
// 消费方按需备桩;实际行为经 act 名字分发(本应用仅实例化 Select/WList/Dialog)
fn menu_toggle(m: Box[Model]) {
}

fn menu_pick(m: Box[Model], row: I32) {
}

fn list_sel(m: Box[Model], row: I32) {
}

fn slide(m: Box[Model], p: Str) {
}

fn ml2_pick(m: Box[Model], row: I32) {
}

fn ed_toggle(m: Box[Model]) {
}

fn ed_pick(m: Box[Model], row: I32) {
}

fn tab_go(m: Box[Model], row: I32) {
}

fn acc_toggle(m: Box[Model]) {
}

fn tip_noop(m: Box[Model]) {
}

fn tab_pick(m: Box[Model], row: I32) {
}

fn wtt() -> Bool {
    return false
}

// 统一对话框契约(pkgs/gui_widgets):遮罩/取消=仅关,确认=删并关
fn dialog_close(m: Box[Model]) {
    m.delopen = false
}

fn dialog_cancel(m: Box[Model]) {
    m.delopen = false
}

fn dialog_confirm(m: Box[Model]) {
    del_confirm(m)
}

fn set_content(m: Box[Model], text: Str) {
    m.content = text
}

// Palette 桩(库 0.3 新事件头;本例未实例化,骨架面全量注册=按需备桩)
fn pal_type(m: Box[Model], text: Str) {
}
fn pal_go(m: Box[Model], text: Str) {
}
fn pal_pick(m: Box[Model], row: I32) {
}
fn pal_close(m: Box[Model]) {
}

fn headless_suite() -> I32 {
    var src: Str = ctron_embedded()
    var m = Box[Model](make())
    var rc: I32 = test(src, 420, 560,
        |buf| __gui_bind_Snippets(buf, m),
        |name, ar| __gui_act_Snippets(name, ar, m),
        |k| k,
        |t, actc, k2| {
            d_frame(t, |buf| __gui_bind_Snippets(buf, m))
            d_expect_text(t, "Snippet Manager")
            var dn: I32 = d_cmd_count()
            var di: I32 = 0
            while di < dn {
                var ty: I32 = d_cmd_type(di)
                var txt: Str = ""
                if ty == 1 {
                    var tl: I32 = d_cmd_text_len(di)
                    var bi: I32 = 0
                    while bi < tl {
                        txt = txt + char_str(d_cmd_text_byte(di, bi))
                        bi += 1
                    }
                }
                println("T-CMD " + di.to_string() + " t=" + ty.to_string() + " [" + txt + "]")
                di += 1
            }
            d_expect_text(t, "hello world")
            // 契约Ⅱ-b:组件事件模型捕获(list_pick 改 status)
            d_click(t, "list_pick")
            // 直驱面模拟真窗命中名(P-H1 行后缀):actc 供后缀名走 Ⅱ-b 分支
            actc("list_pick:0", List[Str]())
            d_frame(t, |buf| __gui_bind_Snippets(buf, m))
            d_expect_text(t, "SELECTED")
            actc("new_snip", List[Str]())
            d_frame(t, |buf| __gui_bind_Snippets(buf, m))
            d_expect_text(t, "NEWSNIP")
            actc("save_snip", List[Str]())
            d_frame(t, |buf| __gui_bind_Snippets(buf, m))
            d_expect_text(t, "SAVED")
            actc("del_ask", List[Str]())
            d_frame(t, |buf| __gui_bind_Snippets(buf, m))
            d_send_key(t, 256,
                |buf| __gui_bind_Snippets(buf, m),
                |nm, ar| __gui_act_Snippets(nm, ar, m))
            d_frame(t, |buf| __gui_bind_Snippets(buf, m))
            // dialog_close 关窗但不改 status(仅遮罩 close,非确认删)
            d_expect_absent(t, "Delete this snippet?")
            println("SNIPPETS-GREEN " + gui_widgets_ver())
        })
    return rc
}

view Snippets (m: Model) {
  <vbox class="root">
    <label class="title">Snippet Manager</label>
    <hbox class="toolbar">
      <Select label: {m.catlabel} open: {m.catopen} opts: {m.opts}/>
      <button class="newbtn" on:click={new_snip(m)}>+ New</button>
    </hbox>
    <WList title: {m.listtitle} items: {m.items}/>
    <label class="preview_t">Content</label>
    <textarea bind={m.content} class="ta" on:input={set_content(m)}/>
    <hbox class="actrow">
      <button class="save" on:click={save_snip(m)}>Save</button>
      <button class="del" on:click={del_ask(m)}>Delete</button>
    </hbox>
    <label class="status">{m.status}</label>
    <Dialog title: "Delete this snippet?" open: {m.delopen}/>
  </vbox>
}
style root { direction: column gap: 10 padding: 16 }
style title { fg: "#e5e7eb" size: 22 h: 30 }
style toolbar { direction: row gap: 8 h: 40 }
style newbtn { bg: "#2563eb" fg: "#ffffff" w: 80 h: 34 }
style preview_t { fg: "#9ca3af" size: 13 h: 20 }
style ta { bg: "#111827" fg: "#e5e7eb" size: 14 h: 160 }
style actrow { direction: row gap: 8 h: 40 }
style save { bg: "#22c55e" fg: "#0b0f19" w: 80 h: 32 }
style del { bg: "#7f1d1d" fg: "#ffffff" w: 90 h: 32 }
style status { fg: "#9ca3af" size: 12 h: 20 }

fn main() -> I32 {
    if env_get("CTRON_GUI_HEADLESS") != "" {
        return headless_suite()
    }
    return run(Snippets(m: make()))
}
