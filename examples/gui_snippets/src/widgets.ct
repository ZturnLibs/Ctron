// examples/gui_snippets/widgets.ct —— 跨文件组件模块(契约Ⅰ列表 prop+Ⅱ-b 模型捕获)
// Select/WList/Dialog 三件套;组件体仅用自家 prop;组件事件首参 Box = 模型
// 捕获直传(合成 act 分支按 fbox 豁免 +1),列表数据经实例实参直传
pub fn snip_tag() -> Str {
    return "SNIP"
}

view Select (label: Str, open: Bool, opts: List[Str]) {
  <vbox class="w_select">
    <button class="w_trigger" on:click={sel_toggle()}>{label}</button>
    <when cond={open}>
      <vbox class="w_opts">
        <each o in={opts}>
          <button class="w_opt" on:click={sel_pick()}>{o}</button>
        </each>
      </vbox>
    </when>
  </vbox>
}

view WList (title: Str, items: List[Str]) {
  <vbox class="w_list">
    <label class="w_list_t">{title}</label>
    <each it in={items}>
      <button class="w_row" on:click={list_pick()}>{it}</button>
    </each>
  </vbox>
}

view Dialog (title: Str, open: Bool) {
  <when cond={open}>
    <overlay class="w_mask" on:click={dialog_dismiss()}>
      <vbox class="w_card">
        <label class="w_title">{title}</label>
      </vbox>
    </overlay>
  </when>
}
