// 组件三件套声明(同源;跨文件分发待 view 导入)
view Select (label: Str, open: Bool) {
  <vbox class="w-select">
    <button class="w-trigger" on:click={sel_toggle()}>{label}</button>
    <when cond={open}>
      <vbox class="w-opts">
        <each o in={opts}>
          <button class="w-opt" on:click={sel_pick()}>{o}</button>
        </each>
      </vbox>
    </when>
  </vbox>
}
view WList (title: Str) {
  <vbox class="w-list">
    <label class="w-list-t">{title}</label>
    <each it in={items}>
      <button class="w-row" on:click={list_pick()}>{it}</button>
    </each>
  </vbox>
}
view Dialog (title: Str, open: Bool) {
  <when cond={open}>
    <overlay class="w-mask" on:click={dialog_dismiss()}>
      <vbox class="w-card">
        <label class="w-title">{title}</label>
      </vbox>
    </overlay>
  </when>
}

view Snippets {
  <vbox class="root">
    <label class="title">Snippet Manager</label>
    <hbox class="toolbar">
      <Select label: {catlabel} open: {catopen}/>
      <button class="newbtn" on:click={new_snip}>+ New</button>
    </hbox>
    <WList title: {listtitle}/>
    <label class="preview-t">Content</label>
    <textarea bind={content} class="ta" on:input={set_content}/>
    <hbox class="actrow">
      <button class="save" on:click={save_snip}>Save</button>
      <button class="del" on:click={del_ask}>Delete</button>
    </hbox>
    <label class="status">{status}</label>
    <Dialog title: "Delete this snippet?" open: {delopen}/>
  </vbox>
}
style root { direction: column gap: 10 padding: 16 }
style title { fg: TEXT size: 22 font_weight: 700 h: 30 }
style toolbar { direction: hbox gap: 8 h: 40 }
style newbtn { bg: ACCENT fg: "#ffffff" w: 80 h: 34 }
style preview-t { fg: TEXT_MUTED size: 13 font_weight: 700 h: 20 }
style ta { bg: SURFACE fg: TEXT size: 14 h: 160 }
style actrow { direction: hbox gap: 8 h: 40 }
style save { bg: SUCCESS fg: "#000000" w: 80 h: 32 }
style del { bg: DANGER fg: "#ffffff" w: 90 h: 32 }
style status { fg: TEXT_MUTED size: 12 h: 20 }
style w-select { direction: column gap: 4 }
style w-trigger { bg: SURFACE fg: TEXT w: 130 h: 34 }
style w-opts { direction: column gap: 2 }
style w-opt { bg: ELEVATED fg: TEXT w: 130 h: 28 }
style w-list { direction: column gap: 2 }
style w-list-t { fg: TEXT_MUTED size: 13 h: 20 }
style w-row { bg: SURFACE fg: TEXT w: 200 h: 28 }
style w-mask { bg: MASK align: center }
style w-card { bg: ELEVATED w: 200 h: 90 }
style w-title { fg: TEXT size: 18 h: 28 }
