#[trusted]
extern "c" fn gui_close() -> I32

#[trusted]
extern "c" fn gui_cfg(dir: I32, gap: I32, padx: I32, pady: I32, ax: I32, ay: I32,
                      wmode: I32, wval: I32, hmode: I32, hval: I32, bg: I32) -> I32

#[trusted]
extern "c" fn gui_text(s: Str, size: I32, r: I32, g: I32, b: I32, a: I32) -> I32

#[trusted]
extern "c" fn gui_end_layout() -> I32

#[trusted]
extern "c" fn gui_cmd_count() -> I32

#[trusted]
extern "c" fn gui_cmd_type(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_x100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_y100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_w100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_h100(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_text_len(i: I32) -> I32

#[trusted]
extern "c" fn gui_cmd_text_byte(i: I32, j: I32) -> I32

#[trusted]
extern "c" fn gui_inject_click(x: I32, y: I32) -> I32

#[trusted]
extern "c" fn gui_poll_event() -> I32

#[trusted]
extern "c" fn gui_evt_x() -> I32

#[trusted]
extern "c" fn gui_evt_y() -> I32

#[trusted]
extern "c" fn InitWindow(w: I32, h: I32, title: Str) -> Void

#[trusted]
extern "c" fn CloseWindow() -> Void

#[trusted]
extern "c" fn WindowShouldClose() -> Bool

#[trusted]
extern "c" fn SetTargetFPS(fps: I32) -> Void

#[trusted]
extern "c" fn BeginDrawing() -> Void

#[trusted]
extern "c" fn EndDrawing() -> Void

#[trusted]
