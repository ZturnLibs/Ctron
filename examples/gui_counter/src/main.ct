// examples/gui_counter —— L1 域包形态(SL-3 切包)
// UI 在 app.ctml(view Counter);逻辑在此;平台(解析/布局/命中/循环)全部在 std/gui
// 域包——`use std.gui` 一行,用户树零 #[trusted]、零解析器、零事件循环。
// 双口径:CTRON_GUI_HEADLESS=1 → 域包 test()(注入断言);缺省 → run_d(窗口 + 热重载环)。
// 状态恢复(W4 裁决 1A):CTRON_GUI_STATE=count=N 环境注入,退出回传快照。

use std.gui.{run_d, test, d_click, d_frame, d_expect_text}

struct Model {
    var count: I32
}

// 领域操作:动作名 → 状态变更(收口装配点)
fn act_counter(name: Str, m: Box[Model]) {
    if name == "inc" {
        m.count = m.count + 1
    } else {
        if name == "clear" {
            m.count = 0
        }
    }
}

// "count=N" → N(无 '=' 或空 → 0)
fn state_count(st: Str) -> I32 {
    var eq: I32 = -1
    var i: I32 = 0
    while i < st.len {
        if byte_at(st, i) == 61 {
            eq = i
            i = st.len
        } else {
            i += 1
        }
    }
    if eq < 0 {
        return 0
    }
    var v: I32 = 0
    var j: I32 = eq + 1
    while j < st.len {
        v = v * 10 + (byte_at(st, j) - 48)
        j += 1
    }
    return v
}

fn main() -> I32 {
    var src: Str = read_file("app.ctml")
    var m = Box[Model](Model { count: state_count(env_get("CTRON_GUI_STATE")) })
    if env_get("CTRON_GUI_HEADLESS") != "" {
        // headless:域包 test() 注入点击,断言走命令缓冲读回
        var rc: I32 = test(src, 320, 200,
            |buf| buf.push(m.count.to_string()),
            |name| act_counter(name, m),
            |k| k,
            |t, act, key| {
                d_expect_text(t, "count: " + m.count.to_string())
                act(d_click(t, "inc"))
                act(d_click(t, "inc"))
                act(d_click(t, "inc"))
                d_frame(t, |buf| buf.push(m.count.to_string()))
                d_expect_text(t, "count: " + m.count.to_string())
                act(d_click(t, "clear"))
                d_frame(t, |buf| buf.push(m.count.to_string()))
                d_expect_text(t, "count: 0")
            })
        println("CTRON_GUI_STATE count=" + m.count.to_string())
        return rc
    }
    // 窗口口径:run_d 自带热重载环(每 60 帧比对 app.ctml,变更原址重解析,状态保留)
    run_d("ctron gui counter", 320, 200,
        |buf| buf.push(m.count.to_string()),
        |name| act_counter(name, m))
    println("CTRON_GUI_STATE count=" + m.count.to_string())
    return 0
}
