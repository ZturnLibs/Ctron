// 注:窗口文本用 ASCII——Clay TEXT 走默认字体,无 CJK 字形(中文渲染见 examples/gui_cjk)
view Counter {
  <vbox class="root">
    <label>count: {count}</label>
    <button class="btn" on:click={inc}>+1</button>
    <button class="btn-danger" on:click={clear}>clear</button>
  </vbox>
}
style root { direction: column; gap: 8; padding: 16 }
style btn { bg: "#2563eb" }
style btn-danger { bg: "#c83c3c" }
