test "bench_arr" {
    let a: I32[8] = [5, 3, 8, 1, 9, 2, 7, 4]
    var passes = 0
    while passes < 4000 {
        var j = 0
        while j < 7 {
            // T1 回归利用:下标紧跟块起始的自然写法(修复前需绕开)
            if a[j] > a[j + 1] {
                var tmp = a[j]
                a[j] = a[j + 1]
                a[j + 1] = tmp
            }
            j += 1
        }
        passes += 1
    }
    var sum = 0
    var i = 0
    while i < 8 {
        sum += a[i]
        i += 1
    }
    assert_eq(sum, 39)
}
