have_cc() {
    TMPCC=$(mktemp /tmp/ctron_ccp.XXXXXX)
    printf 'int main(void){return 0;}' > "$TMPCC.c"
    if "$CC_BIN" -O0 -w -o "$TMPCC" "$TMPCC.c" >/dev/null 2>&1; then
        rm -rf "$TMPCC" "$TMPCC.c"; return 0
    fi
    rm -rf "$TMPCC" "$TMPCC.c"; return 1
}

cc_missing_guidance() {
    echo "ctron: 未找到可用的 C 编译器('$CC_BIN' 冒烟失败)—— ctron build 需要。" >&2
    echo "  两条出路:" >&2
    echo "  ① 安装编译器后重跑:macOS 'xcode-select --install' / linux 发行版 gcc / windows MSYS2 或 w64devkit" >&2
    echo "  ② C 已发射到 $1 —— 可手动编译,或拿到任何有 cc 的机器上: cc -O2 -w $1 -o <名>" >&2
}

# T36 后端注册表(§9.7;与 compiler/ctc.sh 同表)。T40:bare 双靶注册——
# 构建管线与 ctc.sh 同源(bare 工具链三通道 env/宿主/docker 见 lib/rt/bare/README.md)
# T43 lint(§9.7):check 命令化+汇总。口径:错误(E####)红 rc=1;警告(W####)
# 默认只汇总不红(常规 lint 面;check 的警告也 rc=1 是既有严格面,二面并存);
# --trusted 透传 ctron-chk 信任边界审计(§9.6);--strict 警告也红。
cmd_lint() {
    LINT_TARGET=$1; shift
    LINT_TRUSTED=0; LINT_STRICT=0
    for a in "$@"; do
        case $a in
            --trusted) LINT_TRUSTED=1 ;;
            --strict) LINT_STRICT=1 ;;
            *) die2 "lint 未知旗标: $a(支持: --trusted --strict)" ;;
        esac
    done
    if [ -d "$LINT_TARGET" ]; then
        LINT_DIR="$LINT_TARGET"
        [ -d "$LINT_TARGET/src" ] && LINT_DIR="$LINT_TARGET/src"
        LINT_FILES=$(find "$LINT_DIR" -maxdepth 1 -type f -name '*.ct' | LC_ALL=C sort)
        [ -n "$LINT_FILES" ] || die2 "lint 目录无 .ct 文件: $LINT_TARGET"
    else
        [ -f "$LINT_TARGET" ] || die2 "lint 目标不存在: $LINT_TARGET"
        LINT_FILES="$LINT_TARGET"
    fi
    LINT_TMP=$(mktemp /tmp/ctron_lint.XXXXXX)
    LINT_TOT_E=0; LINT_TOT_W=0; LINT_NF=0; LINT_HARD=0
    for f in $LINT_FILES; do
        LINT_NF=$((LINT_NF+1))
        [ $LINT_NF -gt 1 ] && echo "-- $f"
        if [ $LINT_TRUSTED -eq 1 ]; then
            "$BIN/ctron-chk" run "$f" --trusted > "$LINT_TMP" 2>&1
        else
            "$BIN/ctron-chk" run "$f" > "$LINT_TMP" 2>&1
        fi
        CHKR=$?
        grep -v '^check OK' "$LINT_TMP"
        LINT_FE=$(grep -c '^E[0-9][0-9][0-9][0-9]' "$LINT_TMP")
        LINT_FW=$(grep -c '^W[0-9][0-9][0-9][0-9]' "$LINT_TMP")
        # 驱动 rc≥2 且无 E 行 = 非诊断面异常(崩/缺件),按硬错误计
        [ "$CHKR" -ge 2 ] && [ "$LINT_FE" -eq 0 ] && LINT_HARD=$((LINT_HARD+1))
        LINT_TOT_E=$((LINT_TOT_E+LINT_FE)); LINT_TOT_W=$((LINT_TOT_W+LINT_FW))
    done
    rm -f "$LINT_TMP"
    echo "lint: $LINT_NF 文件,$((LINT_TOT_E+LINT_HARD)) 个错误 / $LINT_TOT_W 警告"
    [ $((LINT_TOT_E+LINT_HARD)) -gt 0 ] && exit 1
    [ $LINT_STRICT -eq 1 ] && [ $LINT_TOT_W -gt 0 ] && exit 1
    exit 0
}

# T43 bench(§9.7):tests/ 基准族统一入口。注册表同 ctc.sh targets 哲学:
# 未列名=清晰诊断(fail-closed);脚本自定位仓库根,任目录可跑;仅 dev 布局随发。
# 路径基=DEVROOT(回落前的脚本目录):dev=仓库根;装机=bin(ROOT 是装机语义 exe/../,
# dev 下指仓库父目录,直接用会指错——smoke 实测两族双败在案)。
cmd_bench() {
    if [ $# -lt 1 ]; then
        echo "ctron bench —— 基准族注册表(§9.4 性能口径;脚本内含门禁与归因)"
        echo "  lang   own/热点算术核 vs C 同构对照(T44;门 ≤1.05,WARN 档)"
        echo "  gc     GC 档 vs bump 档 churn(T32;门 ≤1.15)"
        echo "  http   http_parse_head vs picohttpparser(CTRON_HTTP_BENCH=1 启用)"
        echo "  net    吞吐/协程切换三门禁(CTRON_NET_BENCH=1 启用)"
        echo "  ffi    FFI 边界微基准四场景(报告制)"
        echo "用法: ctron bench <族>"
        exit 0
    fi
    BENCH_S=""
    case $1 in
        lang) BENCH_S="$DEVROOT/tests/lang/bench/bench.sh" ;;
        gc) BENCH_S="$DEVROOT/tests/gc/bench.sh" ;;
        http) BENCH_S="$DEVROOT/tests/http/bench/bench.sh" ;;
        net) BENCH_S="$DEVROOT/tests/net/bench/bench.sh" ;;
        ffi) BENCH_S="$DEVROOT/compiler/test/bench_ffi.sh" ;;
        *) die2 "未注册基准族: $1(注册表: lang gc http net ffi;ctron bench 看详)" ;;
    esac
    [ -f "$BENCH_S" ] || die2 "基准族脚本缺席: $BENCH_S(基准族仅 dev 布局随发;装机形态未含)"
    sh "$BENCH_S"
}

# T43 add(§9.7):骨架。registry 未接(T49 前置未到)——只做参数校验+出路指引,
# 零写入零网络(fail-closed;publish 涉对外发布面,未经用户确认不得接真 registry)。
add_validate() {
    ADD_SPEC=$1
    ADD_NAME=${ADD_SPEC%%@*}
    ADD_REQ=""
    case $ADD_SPEC in
        *@*) ADD_REQ=${ADD_SPEC#*@} ;;
    esac
    case $ADD_NAME in
        ""|*[!A-Za-z0-9_-]*|[-0-9]*) die2 "add: 依赖名非法: '$ADD_NAME'(形: <name>[@<版本约束>],name = [A-Za-z_][A-Za-z0-9_-]*)" ;;
    esac
    if [ -n "$ADD_REQ" ]; then
        # 版本约束白名单校验走 grep(方括号不经 shell case 解析;case 模式内
        # 裸 < > 被 bash 解析器当重定向记号,引号嵌套也救不回——实测三连败)
        if printf '%s' "$ADD_REQ" | grep -q '[^A-Za-z0-9.^~<>=,*_-]'; then
            die2 "add: 版本约束非法: '$ADD_REQ'(semver 约束形,T49 实装)"
        fi
    fi
}

ct_target_check() {
    CTRON_TARGET=${CTRON_TARGET:-native}
    case $CTRON_TARGET in
        native) : ;;
        thumbv7em-none-eabi|riscv32imac-unknown-none) : ;;
        wasm32-unknown-unknown) : ;;
        *) die2 "未注册后端 target: $CTRON_TARGET(注册表: native, thumbv7em-none-eabi, riscv32imac-unknown-none, wasm32-unknown-unknown)" ;;
    esac
}

cmd_build() {
    ct_target_check
    IN=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
    STEM=$(basename "${IN%.ct}")
    OUTDIR=$(dirname "$IN")
    if [ "$CTRON_TARGET" != "native" ]; then
        # T40 bare 靶:委派 ctc.sh 同管线(minilibc+startup+链接脚本+工具链解析)
        "$ROOT/compiler/ctc.sh" build "$IN" --target "$CTRON_TARGET" -o "$OUTDIR/$STEM" || exit 2
        echo "ctron: 已构建 $OUTDIR/$STEM(target: $CTRON_TARGET)"
        exit 0
    fi
    "$BIN/ctron-emit" run "$IN" > "$OUTDIR/$STEM.c" || exit 1
    if ! have_cc; then
        cc_missing_guidance "$OUTDIR/$STEM.c"
        exit 2
    fi
    (CDPATH= cd -- "$OUTDIR" && "$CC_BIN" -O2 -w -pthread "$STEM.c" -o "$STEM") || exit 2
    echo "ctron: 已构建 $OUTDIR/$STEM(target: $CTRON_TARGET)"
}

cmd_build_proj() {
    if [ ! -f Ctron.ctcl ] && [ -f Ctron.toml ]; then
        die2 "清单格式已硬切 CTCL(T48):检测到 Ctron.toml——请迁移为 Ctron.ctcl:pkg { manifest_version = 1, name = \"…\", version = \"…\" }(设计:docs/superpowers/specs/2026-09-16-config-language-v1.md)"
    fi
    [ -f Ctron.ctcl ] || die2 "项目模式需 Ctron.ctcl"
    NAME=$(sed -n 's/^ *name *= *"\(.*\)".*/\1/p' Ctron.ctcl | head -1)
    [ -n "$NAME" ] || NAME=$(basename "$PWD")
    [ -f src/main.ct ] || die2 "缺入口 src/main.ct"
    # T49:清单含 dep → 先过依赖解析(lock 生成/校验),再发射
    if grep -q '^dep "' Ctron.ctcl 2>/dev/null; then
        if [ -x "$BIN/ctron-dep" ]; then
            "$BIN/ctron-dep" run "$PWD/Ctron.ctcl" || exit 1
        else
            echo "ctron: 清单含 dep 但缺 ctron-dep,跳过 lock 校验(重装工具链解锁)" >&2
        fi
    fi
    # T49:workspace 根清单 → 逐成员子构建
    if grep -q '^workspace' Ctron.ctcl 2>/dev/null; then
        WSPATHS=$(awk '/^member "/{n=$0; sub(/^member "/,"",n); sub(/".*$/,"",n); m=n} /^[[:space:]]*path[[:space:]]*=[[:space:]]*"/{if(m!=""){v=$0; sub(/.*= *"/,"",v); sub(/".*$/,"",v); print m" "v; m=""}}' Ctron.ctcl)
        for WSE in $WSPATHS; do
            MDIR=${WSE%% *}
            echo "ctron: workspace 成员 $MDIR"
            (CDPATH= cd -- "$MDIR" && "$0" build) || exit 1
        done
        exit 0
    fi
    mkdir -p build
    "$BIN/ctron-emit" run "$PWD/src/main.ct" > "build/$NAME.c" || exit 1
    if ! have_cc; then
        cc_missing_guidance "build/$NAME.c"
        exit 2
    fi
    SRCS=""
    for C in c_src/*.c; do [ -f "$C" ] && SRCS="$SRCS $C"; done
    "$CC_BIN" -O2 -w -pthread "build/$NAME.c" $SRCS -o "build/$NAME" || exit 2
    echo "ctron: 已构建 build/$NAME"
}
# T50/S3:pkg trace record/replay —— 黄金轨迹(编排层码gen;宿主 ctron-cc)。
# α 纯函数:值 = to_string 规范形。γ(S3-β 首片扩展)效果函数:--fs 种子挂
# 最近 --case,args 位写 MemFs 变量名(fs),expect = Ok 值(Err 路径 expect()
# panic → 录制即失败);码gen 内嵌脚本化 MemFs(种子文件映射,读-only;
# write no-op = S3-γ 写效果捕获登记)。轨迹块形:
#   trace "greet" {
#     fs "name.txt" = "ada"
#     args = "fs"
#     expect = "ada"
#   }
# 运行环境:码gen 驱动逐命令带 CTRON_STDPATH=ROOT/lib/std(dev 布局 std 解析;
# 单命令作用域不污染 smoke 环境)。
cmd_pkg_trace() {
    [ $# -ge 1 ] || die2 "pkg trace 需要子命令(用法: pkg trace record <src.ct> --case <fn>=<args> [--fs <path>=<content>]... / pkg trace replay <src.ct>)"
    TR_SUB=$1; shift
    case $TR_SUB in
        record|replay) ;;
        *) die2 "pkg trace: 未知子命令 '$TR_SUB'(现支持: record replay)" ;;
    esac
    [ -x "$BIN/ctron-cc" ] || die2 "pkg trace: 缺 ctron-cc(重装工具链;或先: compiler/native.sh)"
    TR_SRC=""
    TR_PREV=0
    TR_MAN=$(mktemp /tmp/ctron_trm.XXXXXX)
    TR_NF=0
    TR_FN=""
    TR_ARGS=""
    TR_FSS=""
    TR_FLUSH() {
        # 落一条用例进 manifest(行制三行头 + NF 对 path/content 行)
        [ -n "$TR_FN" ] || return 0
        printf '%s\n%s\n%s\n' "$TR_FN" "$TR_ARGS" "$TR_NF" >> "$TR_MAN"
        if [ -n "$TR_FSS" ]; then
            printf '%s' "$TR_FSS" >> "$TR_MAN"
        fi
        TR_FN=""; TR_ARGS=""; TR_FSS=""; TR_NF=0
    }
    for TR_A in "$@"; do
        if [ "$TR_PREV" = 1 ]; then
            TR_FN=${TR_A%%=*}
            TR_ARGS=${TR_A#*=}
            case $TR_FN in
                ""|*[!A-Za-z0-9_]*|[0-9]*) rm -f "$TR_MAN"; die2 "pkg trace record: fn 名非法: '$TR_FN'([A-Za-z_][A-Za-z0-9_]*)" ;;
            esac
            TR_PREV=0
            continue
        fi
        if [ "$TR_PREV" = 2 ]; then
            [ -n "$TR_FN" ] || { rm -f "$TR_MAN"; die2 "pkg trace: --fs 须跟在 --case 之后(种子挂最近用例)"; }
            TR_FP=${TR_A%%=*}
            TR_FC=${TR_A#*=}
            TR_FSS="$TR_FSS$TR_FP
$TR_FC
"
            TR_NF=$((TR_NF+1))
            TR_PREV=0
            continue
        fi
        case $TR_A in
            --case) TR_FLUSH; TR_PREV=1 ;;
            --case=*)
                TR_FLUSH
                TR_A2=${TR_A#--case=}
                TR_FN=${TR_A2%%=*}
                TR_ARGS=${TR_A2#*=}
                case $TR_FN in
                    ""|*[!A-Za-z0-9_]*|[0-9]*) rm -f "$TR_MAN"; die2 "pkg trace record: fn 名非法: '$TR_FN'([A-Za-z_][A-Za-z0-9_]*)" ;;
                esac ;;
            --fs)
                TR_PREV=2 ;;
            --fs=*)
                [ -n "$TR_FN" ] || { rm -f "$TR_MAN"; die2 "pkg trace: --fs 须跟在 --case 之后(种子挂最近用例)"; }
                TR_A2=${TR_A#--fs=}
                TR_FP=${TR_A2%%=*}
                TR_FC=${TR_A2#*=}
                TR_FSS="$TR_FSS$TR_FP
$TR_FC
"
                TR_NF=$((TR_NF+1)) ;;
            *) [ -z "$TR_SRC" ] && TR_SRC=$TR_A ;;
        esac
    done
    [ "$TR_PREV" = 0 ] || { rm -f "$TR_MAN"; die2 "pkg trace: --case/--fs 缺值"; }
    [ -n "$TR_SRC" ] || { rm -f "$TR_MAN"; die2 "pkg trace $TR_SUB 需要源文件"; }
    [ -f "$TR_SRC" ] || { rm -f "$TR_MAN"; die2 "pkg trace: 源文件不存在: $TR_SRC"; }
    if grep -q "fn main" "$TR_SRC"; then
        rm -f "$TR_MAN"
        die2 "pkg trace: 源含 main(轨迹面向无 main 的 provider 源)"
    fi
    TR_DIR=$(CDPATH= cd -- "$(dirname -- "$TR_SRC")" && pwd)
    TR_STEM=$(basename -- "$TR_SRC" .ct)
    TR_TGT="$TR_DIR/traces/$TR_STEM.ctrt"
    TR_STD="$ROOT/lib/std"
    if [ "$TR_SUB" = record ]; then
        TR_FLUSH
        TR_TOTAL=$(wc -l < "$TR_MAN" | tr -d ' ')
        [ "$TR_TOTAL" -ge 1 ] || { rm -f "$TR_MAN"; die2 "pkg trace record 需要 --case <fn>=<args>(可多例;--fs 种子挂最近 --case)"; }
        mkdir -p "$TR_DIR/traces"
        : > "$TR_TGT"
        TR_N=0
        while IFS= read -r TR_FN && IFS= read -r TR_ARGS && IFS= read -r TR_NF; do
            TR_ARGS_E=$(printf '%s' "$TR_ARGS" | sed 's/"/\\"/g')
            TR_D=$(mktemp -d /tmp/ctron_tr.XXXXXX)
            cat "$TR_SRC" > "$TR_D/drv.ct"
            if [ "$TR_NF" -ge 1 ]; then
                # γ 效果用例:脚本化 MemFs 码gen(种子映射;读-only)+ expect 解包
                TR_I=0
                TR_FIELDS=""
                TR_READS=""
                TR_EXISTS=""
                TR_INIT=""
                TR_FSLINES=""
                while [ "$TR_I" -lt "$TR_NF" ]; do
                    IFS= read -r TR_FP
                    IFS= read -r TR_FC
                    TR_FC_E=$(printf '%s' "$TR_FC" | sed 's/"/\\"/g')
                    TR_FIELDS="$TR_FIELDS    let f$TR_I: Str
    let b$TR_I: Str
"
                    TR_READS="$TR_READS        if path == self.f$TR_I {
            return Ok(self.b$TR_I.to_string())
        }
"
                    TR_EXISTS="$TR_EXISTS        if path == self.f$TR_I {
            return true
        }
"
                    TR_INIT="$TR_INIT f$TR_I: \"$TR_FP\", b$TR_I: \"$TR_FC_E\","
                    TR_FSLINES="$TR_FSLINES  fs \"$TR_FP\" = \"$TR_FC_E\"
"
                    TR_I=$((TR_I+1))
                done
                {
                    printf '\nclass MemFs {\n%s}\n\n' "$TR_FIELDS"
                    printf 'impl Fs for MemFs {\n    fn read_to_string(&self, path: Str) -> Result[String, FsError] {\n%s        return Err(FsError { message: "not found".to_string() })\n    }\n' "$TR_READS"
                    printf '    fn write(&self, path: Str, data: Str) -> Result[Void, FsError] {\n        return Ok(void)\n    }\n'
                    printf '    fn exists(&self, path: Str) -> Bool {\n%s        return false\n    }\n}\n\n' "$TR_EXISTS"
                    printf 'fn main() {\n    let fs = MemFs { %s }
    match %s(%s) {
        Ok(v) => println(v.to_string())
        Err(_) => println("<err>")
    }\n}\n' "$TR_INIT" "$TR_FN" "$TR_ARGS"
                } >> "$TR_D/drv.ct"
            else
                printf '\nfn main() {\n    println(%s(%s).to_string())\n}\n' "$TR_FN" "$TR_ARGS" >> "$TR_D/drv.ct"
            fi
            TR_OUT=$(CTRON_STDPATH="$TR_STD" "$BIN/ctron-cc" run "$TR_D/drv.ct" 2>&1)
            TR_RC=$?
            if [ "$TR_RC" -ne 0 ]; then
                printf '%s\n' "$TR_OUT" >&2
                rm -rf "$TR_D" "$TR_MAN"
                die2 "pkg trace record: 用例 $TR_FN($TR_ARGS) 运行失败(rc=$TR_RC)"
            fi
            if [ "$(printf '%s\n' "$TR_OUT" | wc -l)" -gt 1 ]; then
                rm -rf "$TR_D" "$TR_MAN"
                die2 "pkg trace record: 用例 $TR_FN($TR_ARGS) 输出多行(轨迹面向单值函数)"
            fi
            {
                printf 'trace "%s" {\n' "$TR_FN"
                if [ -n "${TR_FSLINES:-}" ]; then
                    printf '%s' "$TR_FSLINES"
                fi
                TR_EXPECT_E=$(printf '%s' "$TR_OUT" | sed 's/"/\\"/g')
                printf '  args = "%s"\n  expect = "%s"\n}\n' "$TR_ARGS_E" "$TR_EXPECT_E"
            } >> "$TR_TGT"
            rm -rf "$TR_D"
            TR_N=$((TR_N+1))
        done < "$TR_MAN"
        rm -f "$TR_MAN"
        echo "ctron: 轨迹已录制 $TR_N 用例 → $TR_TGT"
        exit 0
    fi
    # replay(行制:fn/args/expect/NF + NF 对 path/content;read 保空字段)
    [ -f "$TR_TGT" ] || { rm -f "$TR_MAN"; die2 "pkg trace replay: 无轨迹文件: $TR_TGT"; }
    TR_N=0
    TR_BAD=0
    TR_BLK=$(mktemp /tmp/ctron_trb.XXXXXX)
    awk '
        /^trace "/  { l=$0; sub(/^trace "/, "", l); sub(/" \{$/, "", l); cfn=l; nfs=0; np=0 }
        /^  fs /    { p=$0; sub(/^  fs "/, "", p); sub(/" = "/, "\t", p); sub(/"$/, "", p); split(p, pa, "\t"); pair[np++] = pa[1]; pair[np++] = pa[2]; nfs++ }
        /^  args = /   { a=$0; sub(/^  args = "/, "", a); sub(/"$/, "", a); cargs=a }
        /^  expect = / { x=$0; sub(/^  expect = "/, "", x); sub(/"$/, "", x); cexp=x }
        /^\}$/      { print cfn; print cargs; print nfs + 0; for (i = 0; i < np; i++) print pair[i]; print cexp }
    ' "$TR_TGT" > "$TR_BLK"
    if [ ! -s "$TR_BLK" ]; then
        rm -f "$TR_BLK" "$TR_MAN"
        die2 "pkg trace replay: 轨迹文件无块: $TR_TGT"
    fi
    while IFS= read -r TR_FN && IFS= read -r TR_ARGS && IFS= read -r TR_NF; do
        TR_ARGS=$(printf '%s' "$TR_ARGS" | sed 's/\\"/"/g')
        TR_D=$(mktemp -d /tmp/ctron_tr.XXXXXX)
        cat "$TR_SRC" > "$TR_D/drv.ct"
        if [ "$TR_NF" -ge 1 ]; then
            TR_I=0
            TR_FIELDS=""
            TR_READS=""
            TR_EXISTS=""
            TR_INIT=""
            while [ "$TR_I" -lt "$TR_NF" ]; do
                IFS= read -r TR_FP
                IFS= read -r TR_FC
                TR_FC_E=$(printf '%s' "$TR_FC" | sed 's/"/\\"/g')
                TR_FIELDS="$TR_FIELDS    let f$TR_I: Str
    let b$TR_I: Str
"
                TR_READS="$TR_READS        if path == self.f$TR_I {
            return Ok(self.b$TR_I.to_string())
        }
"
                TR_EXISTS="$TR_EXISTS        if path == self.f$TR_I {
            return true
        }
"
                TR_INIT="$TR_INIT f$TR_I: \"$TR_FP\", b$TR_I: \"$TR_FC_E\","
                TR_I=$((TR_I+1))
            done
            {
                printf '\nclass MemFs {\n%s}\n\n' "$TR_FIELDS"
                printf 'impl Fs for MemFs {\n    fn read_to_string(&self, path: Str) -> Result[String, FsError] {\n%s        return Err(FsError { message: "not found".to_string() })\n    }\n' "$TR_READS"
                printf '    fn write(&self, path: Str, data: Str) -> Result[Void, FsError] {\n        return Ok(void)\n    }\n'
                printf '    fn exists(&self, path: Str) -> Bool {\n%s        return false\n    }\n}\n\n' "$TR_EXISTS"
                printf 'fn main() {\n    let fs = MemFs { %s }
    match %s(%s) {
        Ok(v) => println(v.to_string())
        Err(_) => println("<err>")
    }\n}\n' "$TR_INIT" "$TR_FN" "$TR_ARGS"
            } >> "$TR_D/drv.ct"
        else
            printf '\nfn main() {\n    println(%s(%s).to_string())\n}\n' "$TR_FN" "$TR_ARGS" >> "$TR_D/drv.ct"
        fi
        TR_OUT=$(CTRON_STDPATH="$TR_STD" "$BIN/ctron-cc" run "$TR_D/drv.ct" 2>&1)
        TR_RC=$?
        if [ "$TR_RC" -ne 0 ]; then
            printf '%s\n' "$TR_OUT" >&2
            rm -rf "$TR_D" "$TR_BLK" "$TR_MAN"
            die2 "pkg trace replay: 用例 $TR_FN($TR_ARGS) 运行失败(rc=$TR_RC)"
        fi
        IFS= read -r TR_EXP
        TR_EXP=$(printf '%s' "$TR_EXP" | sed 's/\\"/"/g')
        if [ "$TR_OUT" != "$TR_EXP" ]; then
            echo "trace mismatch: $TR_FN($TR_ARGS) 记录 $TR_EXP 实际 $TR_OUT" >&2
            TR_BAD=$((TR_BAD+1))
        fi
        rm -rf "$TR_D"
        TR_N=$((TR_N+1))
    done < "$TR_BLK"
    rm -f "$TR_BLK" "$TR_MAN"
    if [ "$TR_BAD" -gt 0 ]; then
        echo "pkg trace replay: $TR_N 用例中 $TR_BAD 不符" >&2
        exit 1
    fi
    echo "trace replay OK: $TR_N 用例"
    exit 0
}

# T50/S4-②:pkg attest —— 发布公证(§5.4):attest.ctcl 对工件 self_digest 与
# 轨迹数自证;deep verify 的 attest 腿验其一致(漂移/伪造 = E5057)。hosts α =
# 单线 ["interp-cc"](三线一致判定 = 需求方触发件,诚实登记)。
cmd_pkg_attest() {
    [ $# -ge 1 ] || die2 "pkg attest 需要工件目录(.ctart;须先 seal)"
    PA_DIR=$1
    [ -d "$PA_DIR" ] || die2 "pkg attest: 工件目录不存在: $PA_DIR"
    [ -f "$PA_DIR/meta.ctcl" ] || die2 "pkg attest: 缺 meta.ctcl(工件须先 seal)"
    PA_NAME=$(sed -n 's/^artifact "\([^"]*\)".*/\1/p' "$PA_DIR/meta.ctcl" | head -1)
    [ -n "$PA_NAME" ] || die2 "pkg attest: meta artifact 块缺失"
    PA_SD=$(sed -n 's/.*self_digest = "\(.*\)"/\1/p' "$PA_DIR/meta.ctcl" | head -1)
    [ -n "$PA_SD" ] || die2 "pkg attest: meta 缺 self_digest(工件须先 seal 摘要步骤)"
    PA_TC=0
    if [ -d "$PA_DIR/traces" ]; then
        for TR_F in "$PA_DIR"/traces/*.ctrt; do
            [ -f "$TR_F" ] || continue
            PA_C=$(grep -c '^trace "' "$TR_F")
            PA_TC=$((PA_TC+PA_C))
        done
    fi
    PA_VER="dev"
    if [ -f "$ROOT/VERSION" ]; then
        PA_VER=$(cat "$ROOT/VERSION")
    fi
    printf 'attest "%s" {\n  artifact_digest = "%s"\n  toolchain = "%s"\n  hosts = ["interp-cc"]\n  trace_count = %s\n}\n' "$PA_NAME" "$PA_SD" "$PA_VER" "$PA_TC" > "$PA_DIR/attest.ctcl"
    echo "ctron: attest 已生成 → $PA_DIR/attest.ctcl(摘要 $PA_SD;轨迹 $PA_TC 例)"
    exit 0
}

# T50/S4-③:pkg log —— 透明日志仓最小面(§7.1 公证层:append-only git 仓,
# 只存证据不存内容;记录 = records/<名>/<digest>/attest.ctcl 内容寻址不可变)。
# 零网络(logdir = 本地路径;远端同步 = git push 由发布方自理)。
cmd_pkg_log() {
    [ $# -ge 1 ] || die2 "pkg log 需要子命令(用法: pkg log append <日志仓> <工件目录> / pkg log query <日志仓> [名])"
    PL_SUB=$1; shift
    case $PL_SUB in
        append|query) ;;
        *) die2 "pkg log: 未知子命令 '$PL_SUB'(现支持: append query)" ;;
    esac
    if [ "$PL_SUB" = append ]; then
        [ $# -ge 2 ] || die2 "pkg log append 需要 <日志仓> <工件目录>"
        PL_LOG=$1
        PL_ART=$2
        [ -d "$PL_ART" ] || die2 "pkg log append: 工件目录不存在: $PL_ART"
        PL_MF="$PL_ART/meta.ctcl"
        PL_AT="$PL_ART/attest.ctcl"
        [ -f "$PL_MF" ] || die2 "pkg log append: 缺 meta.ctcl(工件须先 seal)"
        [ -f "$PL_AT" ] || die2 "pkg log append: 缺 attest.ctcl(工件须先 pkg attest;日志只存证据)"
        PL_NAME=$(sed -n 's/^artifact "\([^"]*\)".*/\1/p' "$PL_MF" | head -1)
        PL_SD=$(sed -n 's/.*self_digest = "\(.*\)"/\1/p' "$PL_MF" | head -1)
        [ -n "$PL_NAME" ] && [ -n "$PL_SD" ] || die2 "pkg log append: meta artifact/self_digest 缺失"
        mkdir -p "$PL_LOG"
        if [ ! -d "$PL_LOG/.git" ]; then
            git -C "$PL_LOG" init -q || die2 "pkg log append: git init 失败($PL_LOG)"
        fi
        PL_DST="$PL_LOG/records/$PL_NAME/$PL_SD"
        if [ -f "$PL_DST/attest.ctcl" ]; then
            if cmp -s "$PL_AT" "$PL_DST/attest.ctcl"; then
                echo "ctron: 日志记录已存在(幂等): records/$PL_NAME/$PL_SD"
                exit 0
            fi
            die2 "pkg log append: 记录已存在且内容不同(append-only;同 digest 不得翻改公证): records/$PL_NAME/$PL_SD"
        fi
        mkdir -p "$PL_DST"
        cp "$PL_AT" "$PL_DST/attest.ctcl"
        git -C "$PL_LOG" add records >/dev/null 2>&1
        git -C "$PL_LOG" -c user.name=ctron-log -c user.email=ctron@local commit -q -m "log: $PL_NAME @ $PL_SD" || die2 "pkg log append: git commit 失败"
        echo "ctron: 日志已记 → records/$PL_NAME/$PL_SD(commit $(git -C "$PL_LOG" rev-parse --short HEAD))"
        exit 0
    fi
    # query
    [ $# -ge 1 ] || die2 "pkg log query 需要 <日志仓>[ 名]"
    PL_LOG=$1
    PL_NAME=""
    [ $# -ge 2 ] && PL_NAME=$2
    if [ ! -d "$PL_LOG/records" ]; then
        echo "ctron: 日志仓无记录($PL_LOG/records 缺席)" >&2
        exit 1
    fi
    if [ -n "$PL_NAME" ]; then
        PL_D="$PL_LOG/records/$PL_NAME"
        [ -d "$PL_D" ] || { echo "ctron: 日志无 $PL_NAME 的记录" >&2; exit 1; }
        for PL_D2 in "$PL_D"/*/; do
            [ -f "$PL_D2/attest.ctcl" ] || continue
            echo "record: $PL_NAME @ $(basename "$PL_D2")"
            grep -E "toolchain|trace_count" "$PL_D2/attest.ctcl" | sed 's/^/  /'
        done
        exit 0
    fi
    for PL_N in "$PL_LOG/records"/*/; do
        [ -d "$PL_N" ] || continue
        echo "name: $(basename "$PL_N")"
    done
    exit 0
}

[ $# -lt 1 ] && { usage; exit 2; }
CMD=$1; shift
# <cmd> --help / <cmd> -h:子命令详助入口(usage 宣传的第四帮助入口),先于各分派臂拦截
case $CMD in
    run|check|build|test|new|fmt|doc|lint|bench|add|publish|lock|pkg)
        case ${1-} in --help|-h) help_cmd "$CMD"; exit 0 ;; esac ;;
esac
case $CMD in
    --help|-h|help) if [ $# -ge 1 ]; then help_cmd "$1"; else usage; fi; exit 0 ;;
    --version|-V)
        if [ -f "$ROOT/VERSION" ]; then echo "ctron $(cat "$ROOT/VERSION")"; else echo "ctron dev"; fi
        exit 0 ;;
    run)
        [ $# -ge 1 ] || die2 "run 需要输入文件"
        exec "$BIN/ctron-cc" run "$1"
        ;;
    check)
        [ $# -ge 1 ] || die2 "check 需要输入文件"
        IN=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1"); shift
        exec "$BIN/ctron-chk" run "$IN" "$@"
        ;;
    doc)
        [ $# -ge 1 ] || die2 "doc 需要输入文件"
        case $1 in
            */*) IN=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1");;
            # §5.3:std.<module> 形原样透传(无 / 无 .ct),由 ctron-doc 四级 std 根解析
            *) IN=$1;;
        esac
        shift
        exec "$BIN/ctron-doc" run "$IN" "$@"
        ;;
    build)
        prev_t=0
        for a in "$@"; do
            if [ "$prev_t" = "1" ]; then CTRON_TARGET=$a; prev_t=0; continue; fi
            case $a in
                --target=*) CTRON_TARGET=${a#--target=} ;;
                --target) prev_t=1 ;;
            esac
        done
        if [ $# -ge 1 ]; then cmd_build "$1"; else cmd_build_proj; fi ;;
    test)
        [ $# -ge 1 ] || die2 "test 需要输入文件"
        exec "$BIN/ctron-cc" run "$1"
        ;;
    fmt)
        # R-P2d:ctron fmt <file|pkg目录> [-w|--check](语义对齐 compiler-rust main.rs fmt 分支)
        [ $# -ge 1 ] || die2 "fmt 需要输入文件或 pkg 目录"
        FMT_TARGET=$1; shift
        FMT_W=0; FMT_CHECK=0
        for a in "$@"; do
            case $a in
                -w|--write) FMT_W=1 ;;
                --check) FMT_CHECK=1 ;;
            esac
        done
        # 目标集:目录 → src/*.ct(无 src 则直下),文件名序;单文件直通
        if [ -d "$FMT_TARGET" ]; then
            FMT_DIR="$FMT_TARGET"
            [ -d "$FMT_TARGET/src" ] && FMT_DIR="$FMT_TARGET/src"
            FMT_FILES=$(find "$FMT_DIR" -maxdepth 1 -type f -name '*.ct' | LC_ALL=C sort)
        else
            FMT_FILES="$FMT_TARGET"
        fi
        FMT_ERR=0; FMT_UNF=0
        FMT_TMP=$(mktemp /tmp/ctron_fmt.XXXXXX)
        for f in $FMT_FILES; do
            "$BIN/ctron-fmt" run "$f" > "$FMT_TMP"
            if [ $? -ne 0 ]; then
                cat "$FMT_TMP" >&2
                FMT_ERR=1
                continue
            fi
            if [ $FMT_CHECK -eq 1 ]; then
                cmp -s "$FMT_TMP" "$f" || { echo "$f"; FMT_UNF=$((FMT_UNF+1)); }
            elif [ $FMT_W -eq 1 ]; then
                if ! cmp -s "$FMT_TMP" "$f"; then cp "$FMT_TMP" "$f"; fi
                echo "$f"
            else
                cat "$FMT_TMP"
            fi
        done
        rm -f "$FMT_TMP"
        [ $FMT_ERR -eq 1 ] && exit 1
        if [ $FMT_CHECK -eq 1 ] && [ $FMT_UNF -gt 0 ]; then
            echo "$FMT_UNF 个文件待格式化" >&2
            exit 1
        fi
        exit 0
        ;;
    new)
        [ $# -ge 1 ] || die2 "new 需要目录名"
        mkdir -p "$1/src" || exit 2
        printf 'pkg {\n    manifest_version = 1\n    name = "%s"\n    version = "0.1.0"\n}\n' "$(basename "$1")" > "$1/Ctron.ctcl"
        printf 'fn main() {\n    println("hello, ctron")\n}\n' > "$1/src/main.ct"
        echo "ctron: 已生成 $1/(ctron run $1/src/main.ct 试跑)"
        ;;
    lint)
        [ $# -ge 1 ] || die2 "lint 需要输入文件或 pkg 目录"
        cmd_lint "$@"
        ;;
    bench)
        cmd_bench "$@"
        ;;
    add)
        [ $# -ge 1 ] || die2 "add 需要依赖名(形: <name>[@<版本约束>])"
        add_validate "$1"
        [ -f Ctron.ctcl ] || die2 "add: 当前目录缺 Ctron.ctcl(项目模式)"
        REG=${CTRON_REGPATH:-$HOME/.ctron/registry}
        [ -d "$REG/$ADD_NAME" ] || die2 "add: registry 无包 $ADD_NAME(registry: $REG;试: ctron publish)"
        if [ -z "$ADD_REQ" ]; then
            ADD_VER=$(ls "$REG/$ADD_NAME" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
        else
            case $ADD_REQ in
                *.*.*) ADD_VER=$ADD_REQ ;;
                *)
                    # 前缀约束(X / X.Y)匹配:case 模式带括号不可入 $()(模式内 ) 会
                    # 提前闭合命令替换,T43 同族坑)——先收集再排序取最大
                    CANDS=""
                    for v in $(ls "$REG/$ADD_NAME"); do
                        case $v in
                            "$ADD_REQ"|"$ADD_REQ".*) CANDS="$CANDS $v" ;;
                        esac
                    done
                    ADD_VER=$(printf '%s\n' $CANDS | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
                    ;;
            esac
        fi
        [ -n "$ADD_VER" ] || die2 "add: $ADD_NAME 无满足约束 $ADD_REQ 的版本"
        [ -f "$REG/$ADD_NAME/$ADD_VER/module" ] || die2 "add: registry 损坏:缺 module($ADD_NAME@$ADD_VER)"
        if grep -q "dep \"$ADD_NAME\"" Ctron.ctcl; then
            echo "ctron: dep \"$ADD_NAME\" 已在清单(不重复追加)" >&2
        else
            printf '\ndep "%s" {\n    version = "%s"\n}\n' "$ADD_NAME" "$ADD_VER" >> Ctron.ctcl
        fi
        mkdir -p "pkgs/$ADD_NAME"
        cp "$REG/$ADD_NAME/$ADD_VER/module" "pkgs/$ADD_NAME/$ADD_NAME.ct"
        cp "$REG/$ADD_NAME/$ADD_VER/manifest" "pkgs/$ADD_NAME/Ctron.ctcl"
        echo "ctron: 已安装 pkgs/$ADD_NAME/($ADD_NAME@$ADD_VER)"
        [ -x "$BIN/ctron-dep" ] || die2 "add: 缺 ctron-dep(重装工具链;或试: ctc.sh dep Ctron.ctcl)"
        "$BIN/ctron-dep" run "$PWD/Ctron.ctcl" || exit 1
        ;;
    lock)
        [ -f Ctron.ctcl ] || die2 "lock: 当前目录缺 Ctron.ctcl"
        [ -x "$BIN/ctron-dep" ] || die2 "lock: 缺 ctron-dep(重装工具链;或试: ctc.sh dep Ctron.ctcl)"
        "$BIN/ctron-dep" run "$PWD/Ctron.ctcl"
        ;;
    publish)
        [ -f Ctron.ctcl ] || die2 "publish 需项目清单 Ctron.ctcl(当前目录)"
        PUB_NAME=$(sed -n 's/^ *name *= *"\(.*\)".*/\1/p' Ctron.ctcl | head -1)
        [ -n "$PUB_NAME" ] || PUB_NAME=$(basename "$PWD")
        PUB_VER=$(sed -n 's/^ *version *= *"\(.*\)".*/\1/p' Ctron.ctcl | head -1)
        [ -n "$PUB_VER" ] || die2 "publish: 清单缺 version"
        echo "$PUB_VER" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$' || die2 "publish: version '$PUB_VER' 不符严格 semver"
        [ -f src/main.ct ] || die2 "publish: v0 registry 单文件包,需 src/main.ct"
        PN=$(find src -name '*.ct' | wc -l | tr -d ' ')
        [ "$PN" = "1" ] || die2 "publish: v0 registry 单文件包(src/ 下有 $PN 个 .ct);多文件 tar 志向"
        REG=${CTRON_REGPATH:-$HOME/.ctron/registry}
        PTGT="$REG/$PUB_NAME/$PUB_VER"
        [ -e "$PTGT" ] && die2 "publish: $PUB_NAME@$PUB_VER 已发布(版本不可覆盖)"
        mkdir -p "$PTGT" || exit 2
        cp Ctron.ctcl "$PTGT/manifest"
        cp src/main.ct "$PTGT/module"
        sha256_file "$PTGT/module" > "$PTGT/sha256"
        echo "ctron: 已发布 $PUB_NAME@$PUB_VER → $PTGT(sha256:$(cat "$PTGT/sha256"))"
        ;;
    pkg)
        [ $# -ge 1 ] || die2 "pkg 需要子命令(现支持: pkg verify [--deep] <工件目录> / pkg trace / pkg attest)"
        PV_SUB=$1; shift
        case $PV_SUB in
            verify) ;;
            trace) cmd_pkg_trace "$@" ;;
            attest) cmd_pkg_attest "$@" ;;
            log) cmd_pkg_log "$@" ;;
            *) die2 "pkg: 未知子命令 '$PV_SUB'(现支持: verify trace attest log)" ;;
        esac
        PV_DEEP=0
        PV_DIR=""
        for PV_A in "$@"; do
            case $PV_A in
                --deep) PV_DEEP=1 ;;
                *) [ -z "$PV_DIR" ] && PV_DIR=$PV_A ;;
            esac
        done
        [ -n "$PV_DIR" ] || die2 "pkg verify 需要工件目录(.ctart)"
        [ -d "$PV_DIR" ] || die2 "pkg verify: 工件目录不存在: $PV_DIR"
        # --deep = L3 载体(native 摘要 ctron-verify,C 速)+ S3-β 复放腿(§7.2
        # verify = 校验和 + 复放轨迹;D3 信任协议:工件行为 vs 录制期望,不符 =
        # E4040 点名 fn/双值)。fail-closed:轨迹在场而缺 ctron-cc = 硬失败。
        if [ "$PV_DEEP" = 1 ]; then
            [ -x "$BIN/ctron-verify" ] || die2 "pkg verify --deep: 缺 ctron-verify(重装工具链;或先: compiler/native.sh)"
            VDIR=$(CDPATH= cd -- "$PV_DIR" && pwd)
            "$BIN/ctron-verify" run "$VDIR"
            VRC=$?
            [ "$VRC" -eq 0 ] || exit 1
            PV_RN=0
            PV_RB=0
            if [ -d "$VDIR/traces" ] && ls "$VDIR"/traces/*.ctrt >/dev/null 2>&1; then
                if [ ! -x "$BIN/ctron-cc" ]; then
                    echo "ctron pkg verify: traces 在场但缺 ctron-cc(复放腿不可跳过;重装工具链)" >&2
                    exit 1
                fi
                PV_NAME=$(sed -n 's/^artifact "\([^"]*\)".*/\1/p' "$VDIR/meta.ctcl" | head -1)
                if [ -z "$PV_NAME" ]; then
                    echo "ctron pkg verify: meta artifact 块缺失(复放腿无包名)" >&2
                    exit 1
                fi
                for TR_F in "$VDIR"/traces/*.ctrt; do
                    TR_MOD=$(basename "$TR_F" .ctrt)
                    TR_HAS=""
                    for TR_A2 in "$VDIR"/impl/*.ast; do
                        [ "$(basename "$TR_A2" .ast)" = "$TR_MOD" ] && TR_HAS=1
                    done
                    if [ -z "$TR_HAS" ]; then
                        echo "ctron pkg verify: 陈旧信任证据: traces/$TR_MOD.ctrt 的模块 $TR_MOD 不在工件 impl/(清理或重录)" >&2
                        exit 1
                    fi
                    TR_FNS=$(awk '/^trace "/ { l=$0; sub(/^trace "/, "", l); sub(/" \{$/, "", l); print l }' "$TR_F" | sort -u | tr '\n' ',' | sed 's/,$//')
                    TRP=$(mktemp -d /tmp/ctron_trp.XXXXXX)
                    mkdir -p "$TRP/deps/$PV_NAME.ctart"
                    cp -r "$VDIR/." "$TRP/deps/$PV_NAME.ctart/"
                    awk '
                        /^trace "/  { l=$0; sub(/^trace "/, "", l); sub(/" \{$/, "", l); cfn=l; nfs=0; np=0 }
                        /^  fs /    { p=$0; sub(/^  fs "/, "", p); sub(/" = "/, "\t", p); sub(/"$/, "", p); split(p, pa, "\t"); pair[np++] = pa[1]; pair[np++] = pa[2]; nfs++ }
                        /^  args = /   { a=$0; sub(/^  args = "/, "", a); sub(/"$/, "", a); cargs=a }
                        /^  expect = / { x=$0; sub(/^  expect = "/, "", x); sub(/"$/, "", x); cexp=x }
                        /^\}$/      { print cfn; print cargs; print nfs + 0; for (i = 0; i < np; i++) print pair[i]; print cexp }
                    ' "$TR_F" > "$TRP/cases.txt"
                    while IFS= read -r TR_FN && IFS= read -r TR_ARGS && IFS= read -r TR_NF; do
                        TR_ARGS=$(printf '%s' "$TR_ARGS" | sed 's/\\"/"/g')
                        TR_HEAD="use $PV_NAME.$TR_MOD.{ $TR_FNS }"
                        TR_FIELDS=""
                        TR_READS=""
                        TR_EXISTS=""
                        TR_FSLINES=""
                        TR_I=0
                        while [ "$TR_I" -lt "$TR_NF" ]; do
                            IFS= read -r TR_FP
                            IFS= read -r TR_FC
                            TR_HEAD="use std.fs.{ Fs, FsError }
$TR_HEAD"
                            TR_FC_E=$(printf '%s' "$TR_FC" | sed 's/"/\\"/g')
                            TR_FIELDS="$TR_FIELDS    let f$TR_I: Str
    let b$TR_I: Str
"
                            TR_READS="$TR_READS        if path == self.f$TR_I {
            return Ok(self.b$TR_I.to_string())
        }
"
                            TR_EXISTS="$TR_EXISTS        if path == self.f$TR_I {
            return true
        }
"
                            TR_FSLINES="$TR_FSLINES f$TR_I: \"$TR_FP\", b$TR_I: \"$TR_FC_E\","
                            TR_I=$((TR_I+1))
                        done
                        printf '%s\n' "$TR_HEAD" > "$TRP/main.ct"
                        if [ "$TR_NF" -ge 1 ]; then
                            {
                                printf '\nclass MemFs {\n%s}\n\n' "$TR_FIELDS"
                                printf 'impl Fs for MemFs {\n    fn read_to_string(&self, path: Str) -> Result[String, FsError] {\n%s        return Err(FsError { message: "not found".to_string() })\n    }\n' "$TR_READS"
                                printf '    fn write(&self, path: Str, data: Str) -> Result[Void, FsError] {\n        return Ok(void)\n    }\n'
                                printf '    fn exists(&self, path: Str) -> Bool {\n%s        return false\n    }\n}\n\n' "$TR_EXISTS"
                                printf 'fn main() {\n    let fs = MemFs { %s }\n    match %s(%s) {
        Ok(v) => println(v.to_string())
        Err(_) => println("<err>")
    }\n}\n' "$TR_FSLINES" "$TR_FN" "$TR_ARGS"
                            } >> "$TRP/main.ct"
                        else
                            printf 'fn main() {\n    println(%s(%s).to_string())\n}\n' "$TR_FN" "$TR_ARGS" >> "$TRP/main.ct"
                        fi
                        IFS= read -r TR_EXP
                        TR_EXP=$(printf '%s' "$TR_EXP" | sed 's/\\"/"/g')
                        TRP_P=$PWD
                        cd "$TRP"
                        TR_OUT=$(CTRON_STDPATH="$ROOT/lib/std" "$BIN/ctron-cc" run main.ct 2>&1)
                        TR_RC=$?
                        cd "$TRP_P"
                        if [ "$TR_RC" -ne 0 ]; then
                            printf '%s\n' "$TR_OUT" >&2
                            rm -rf "$TRP"
                            echo "ctron pkg verify: 复放用例 $TR_FN($TR_ARGS) 运行失败(rc=$TR_RC)" >&2
                            exit 1
                        fi
                        if [ "$TR_OUT" != "$TR_EXP" ]; then
                            echo "E5056 trace mismatch: $TR_FN($TR_ARGS) 记录 $TR_EXP 实际 $TR_OUT" >&2
                            PV_RB=$((PV_RB+1))
                        fi
                        PV_RN=$((PV_RN+1))
                    done < "$TRP/cases.txt"
                    rm -rf "$TRP"
                done
                if [ "$PV_RB" -gt 0 ]; then
                    echo "ctron pkg verify: 复放 $PV_RN 用例中 $PV_RB 不符(E5056)" >&2
                    exit 1
                fi
            fi
            # S4-② attest 腿(§5.4):attest.ctcl 在场即验其与工件一致(漂移/伪造 = E5057)
            if [ -f "$VDIR/attest.ctcl" ]; then
                PA_AD=$(sed -n 's/^  artifact_digest = "\(.*\)"/\1/p' "$VDIR/attest.ctcl" | head -1)
                PA_ATC=$(sed -n 's/^  trace_count = \(.*\)$/\1/p' "$VDIR/attest.ctcl" | head -1)
                if [ -z "$PA_AD" ] || [ -z "$PA_ATC" ]; then
                    echo "ctron pkg verify: attest 畸形(缺 artifact_digest/trace_count;E5057)" >&2
                    exit 1
                fi
                PA_SD2=$(sed -n 's/.*self_digest = "\(.*\)"/\1/p' "$VDIR/meta.ctcl" | head -1)
                if [ "$PA_AD" != "$PA_SD2" ]; then
                    echo "E5057 attest 与工件不符: artifact_digest 记录 $PA_AD 实际 $PA_SD2" >&2
                    exit 1
                fi
                PV_TC=0
                if [ -d "$VDIR/traces" ]; then
                    for TR_F in "$VDIR"/traces/*.ctrt; do
                        [ -f "$TR_F" ] || continue
                        PA_C2=$(grep -c '^trace "' "$TR_F")
                        PV_TC=$((PV_TC+PA_C2))
                    done
                fi
                if [ "$PA_ATC" != "$PV_TC" ]; then
                    echo "E5057 attest 与工件不符: trace_count 记录 $PA_ATC 实际 $PV_TC" >&2
                    exit 1
                fi
                echo "ctron pkg verify OK: $VDIR(deep: 摘要自洽;复放 $PV_RN 用例;attest 过验)"
                exit 0
            fi
            echo "ctron pkg verify OK: $VDIR(deep: 摘要自洽;复放 $PV_RN 用例)"
            exit 0
        fi
        PV_BAD=0
        PV_N=0
        # ① 形态面(§3.5 后缀即契约:自称 .ctart 而缺成员 = 损坏/伪造,fail-closed)
        for PV_F in meta.ctcl SHA256SUMS; do
            [ -f "$PV_DIR/$PV_F" ] || { echo "ctron pkg verify: 缺 $PV_F(fail-closed 拒载)" >&2; PV_BAD=1; }
        done
        [ -d "$PV_DIR/impl" ] || { echo "ctron pkg verify: 缺 impl/(密封实现目录;fail-closed 拒载)" >&2; PV_BAD=1; }
        [ "$PV_BAD" -eq 0 ] || exit 1
        # ② SHA256SUMS 逐成员重算(路径字节序由 seal 保证,此处只对账;SHA256SUMS 是不可信输入)
        while IFS= read -r PV_LINE; do
            [ -n "$PV_LINE" ] || continue
            PV_HEX=${PV_LINE%%  *}
            PV_PATH=${PV_LINE#*  }
            if [ "$PV_HEX" = "$PV_LINE" ] || ! printf '%s' "$PV_HEX" | grep -Eq '^[0-9a-f]{64}$'; then
                echo "ctron pkg verify: SHA256SUMS 行畸形: $PV_LINE" >&2
                PV_BAD=1; continue
            fi
            case $PV_PATH in
                /*|*..*|"")
                    echo "ctron pkg verify: 成员路径越界: $PV_PATH" >&2
                    PV_BAD=1; continue ;;
            esac
            if [ ! -f "$PV_DIR/$PV_PATH" ]; then
                echo "ctron pkg verify: 成员缺失: $PV_PATH" >&2
                PV_BAD=1; continue
            fi
            PV_ACT=$(sha256_file "$PV_DIR/$PV_PATH")
            if [ "$PV_ACT" != "$PV_HEX" ]; then
                echo "ctron pkg verify: 成员摘要不符: $PV_PATH 记录 $PV_HEX 实际 $PV_ACT" >&2
                PV_BAD=1
            fi
            PV_N=$((PV_N+1))
        done < "$PV_DIR/SHA256SUMS"
        # ③ self_digest 重算 = sha256(SHA256SUMS 字节)(D8-2 冻结定义;与成员腿相互独立)
        PV_SD=$(sed -n 's/.*self_digest = "\(.*\)"/\1/p' "$PV_DIR/meta.ctcl" | head -1)
        PV_SUM=$(sha256_file "$PV_DIR/SHA256SUMS")
        if [ -z "$PV_SD" ]; then
            echo "ctron pkg verify: meta 缺 self_digest(fail-closed;工件须经 ctc.sh ast --ast=seal 摘要步骤)" >&2
            PV_BAD=1
        elif [ "$PV_SD" != "sha256:$PV_SUM" ]; then
            echo "ctron pkg verify: self_digest 不符: 记录 $PV_SD 实际 sha256:$PV_SUM" >&2
            PV_BAD=1
        fi
        # ④ 判决(shell 轻面 = 摘要四段;复放腿在 --deep 路径)
        if [ "$PV_BAD" -eq 0 ]; then
            echo "ctron pkg verify OK: $PV_DIR($PV_N 成员,self_digest sha256:$PV_SUM)"
            exit 0
        fi
        exit 1
        ;;
    *)
        echo "ctron: 未知子命令 '$CMD'(详见 ctron --help)" >&2
        exit 2 ;;
esac
