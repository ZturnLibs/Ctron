#!/bin/sh
# ctron —— Ctron 工具链用户驱动(v0.0.1;命令面基准,ctron.ps1 与此同文)
# rc 约定:0 成功 / 1 程序诊断失败 / 2 ctron 环境或用法错误
#
# 二进制定位:正式形态为安装布局(本脚本与 ctron-{cc,chk,emit} 同目录)。
# dev 场景(脚本在仓库根、二进制在 compiler/bin/)可用以下任一方式:
#   PATH=compiler/bin:$PATH 后不生效于本脚本(exec 走 BIN 同目录),
#   故脚本内置回落:BIN 下找不到 ctron-cc 时回落 <脚本目录>/compiler/bin;
#   或将四件套软链至仓库根。回落不含任何 std 路径逻辑(std 解析全在编译器内)。
set -u
BIN=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(dirname "$BIN")
DEVROOT=$BIN
# T37 随批修:脚本目录即仓库根(dev 布局/worktree 同构)时 ROOT 取脚本目录——
# 非 native 靶委派 "$ROOT/compiler/ctc.sh" 此前取 dirname 落到仓库外(worktree 必红;
# 安装布局脚本在 <prefix>/bin,dirname 即 <prefix>,不受影响)
if [ -f "$BIN/compiler/ctc.sh" ]; then
    ROOT=$BIN
fi
# dev 兼容回落:仅当同目录无二进制、且仓库 dev 布局命中时才切换,安装布局不受影响
if [ ! -x "$BIN/ctron-cc" ] && [ -x "$BIN/compiler/bin/ctron-cc" ]; then
    BIN="$BIN/compiler/bin"
fi
CC_BIN=${CC:-cc}

die2() { echo "ctron: $*" >&2; exit 2; }

sha256_file() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else sha256sum "$1" | cut -d' ' -f1; fi
}

usage() {
cat <<'USAGE'
ctron —— Ctron 工具链驱动
用法:
  ctron run <file.ct>          解释执行(不需要 C 编译器)
  ctron check <file.ct> [--format=json] [--profile=bare]
                             静态检查
  ctron doc <file.ct> [--format=json]
                             iface 投影:pub 符号表 + trait/impl 面 + 契约注释
  ctron build <file.ct>        发射 C → 本机 cc → 可执行 <stem>(C 侧 <stem>.c)
  ctron build                  项目模式:读 Ctron.ctcl(入口 src/main.ct,链接 c_src/*.c)
  ctron test <file.ct>         test 块执行(无 main 走解释;含 main 文件的 test 执行挂账)
  ctron fmt <file|pkg目录> [-w|--check]
                             规范格式化(docs/fmt-spec.md):默认打印;-w 原位写回;
                             --check 列出待格式化文件后非零退出
  ctron lint <file|pkg目录> [--trusted] [--strict]
                             lint 汇总:错误红(rc=1),警告默认只汇总;
                             --trusted 信任审计枚举(§9.6);--strict 警告也红
  ctron bench [族]            基准族入口(lang/gc/http/net/ffi;dev 布局)
  ctron add <名>[@<版本约束>] 装包:写 dep 块 + pkgs/ 安装 + 刷新 Ctron.lock(T49 本地 registry)
  ctron publish               发布当前目录单文件包到本地 registry(T49;CTRON_REGPATH,缺省 ~/.ctron/registry)
  ctron lock                  解析依赖并生成/校验 Ctron.lock(内容寻址)
  ctron pkg verify <artifact-dir>
                             密封工件(.ctart)摘要自洽校验(D8-2 L1):SHA256SUMS 逐成员重算
                             + self_digest 重算;fail-closed,不过即 rc=1;--deep 走
                             in-language 发射验证器(ctron-verify,C 速,L3 载体)
  ctron pkg trace record <src.ct> --case <fn>=<args 字面量> [--case ...]
                             黄金轨迹录制(S3:纯函数+效果函数 γ):值=to_string 规范形,--fs 种子挂 case,落
                             traces/<stem>.ctrt;含 main 源不支持
  ctron pkg trace replay <src.ct>
                             轨迹复放:逐字比对,不符即 rc=1 点名双值(S3)
  ctron pkg log append <日志仓> <工件目录>
                             透明日志追加(§7.1 公证层):records/<名>/<digest>/attest
                             内容寻址不可变,append-only git 仓;零网络
  ctron pkg log query <日志仓> [名]
                             日志查询:列名或列某名的 digest+公证要点
  ctron new <dir>              脚手架:hello + Ctron.ctcl
  ctron --version              版本
  ctron --help | help [cmd]    帮助(亦可 ctron <cmd> --help)
环境变量:CC(默认 cc)、CTRON_STDPATH(覆盖标准库位置)
rc 约定:0 成功 / 1 程序诊断失败 / 2 ctron 环境或用法错误
USAGE
}

