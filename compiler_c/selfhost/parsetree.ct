// C7a 原型:Ctron 结构化 AST(数据树)+ 树打印 → C-AST v1 逐字节(v0:fn/let/return/二元/数值)
// 节点 = List[Str]:child[0]=tag,其后按模式放标量 Str 或子节点(List)。打印按 tag 模式走树。
fn or2(a: Bool, b: Bool) -> Bool { return !(!a && !b) }
fn is_digit(b: I32) -> Bool { return b >= 48 && b <= 57 }
fn is_alpha(b: I32) -> Bool { return or2(b >= 65 && b <= 90, b >= 97 && b <= 122) }
fn is_al(b: I32) -> Bool { return or2(is_alpha(b), b == 95) }
fn is_ac(b: I32) -> Bool { return or2(is_al(b), is_digit(b)) }

fn suffix_len(src: Str, n: I32, i: I32) -> I32 {
    if i + 2 <= n {
        var a = byte_at(src, i)
        var b = byte_at(src, i + 1)
        var len: I32 = 0
        if a == 105 && b == 56 { len = 2 }
        if a == 105 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 { len = 3 }
        if a == 105 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 105 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if a == 105 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 { len = 5 }
        if a == 117 && b == 56 { len = 2 }
        if a == 117 && b == 49 && i + 2 < n && byte_at(src, i + 2) == 54 { len = 3 }
        if a == 117 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 117 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if a == 117 && b == 115 && i + 5 <= n && byte_at(src, i + 2) == 105 && byte_at(src, i + 3) == 122 && byte_at(src, i + 4) == 101 { len = 5 }
        if a == 102 && b == 51 && i + 2 < n && byte_at(src, i + 2) == 50 { len = 3 }
        if a == 102 && b == 54 && i + 2 < n && byte_at(src, i + 2) == 52 { len = 3 }
        if len > 0 {
            if i + len < n && is_ac(byte_at(src, i + len)) { return 0 }
            return len
        }
    }
    return 0
}

// 词法:空白/换行(NL)/注释丢弃;数值=text~sfx;标点原始串;哨兵 #EOF
fn scan(src: Str, toks: List[Str]) {
    var n = src.len
    var i: I32 = 0
    while i < n {
        var b = byte_at(src, i)
        if or2(or2(b == 10, b == 32), or2(b == 9, b == 13)) {
            i += 1
        } else if b == 47 && i + 1 < n && byte_at(src, i + 1) == 47 {
            while i < n && byte_at(src, i) != 10 { i += 1 }
        } else if b == 34 {
            var q0 = i
            i += 1
            var done = false
            while i < n && !done {
                var c = byte_at(src, i)
                if c == 34 {
                    i += 1
                    done = true
                } else if c == 92 {
                    i += 2
                } else if c == 10 {
                    done = true
                } else {
                    i += 1
                }
            }
            toks.push(byte_slice(src, q0, i))
        } else if is_al(b) {
            var start = i
            while i < n && is_ac(byte_at(src, i)) { i += 1 }
            toks.push(byte_slice(src, start, i))
        } else if is_digit(b) {
            var tstart = i
            while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
            var fnum = false
            var tend = i
            if i + 1 < n && byte_at(src, i) == 46 && is_digit(byte_at(src, i + 1)) {
                fnum = true
                i += 1
                while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                tend = i
            }
            if i < n && or2(byte_at(src, i) == 101, byte_at(src, i) == 69) {
                var esign = false
                if i + 1 < n && or2(byte_at(src, i + 1) == 43, byte_at(src, i + 1) == 45) { esign = true }
                var eok = false
                if esign && i + 2 < n && is_digit(byte_at(src, i + 2)) { eok = true }
                if !esign && i + 1 < n && is_digit(byte_at(src, i + 1)) { eok = true }
                if eok {
                    fnum = true
                    i += 1
                    if esign { i += 1 }
                    while i < n && or2(is_digit(byte_at(src, i)), byte_at(src, i) == 95) { i += 1 }
                }
            }
            if !fnum { tend = i }
            var tk = byte_slice(src, tstart, tend) + "~"
            var sl = suffix_len(src, n, i)
            if sl > 0 { tk = tk + byte_slice(src, i, i + sl) }
            i += sl
            toks.push(tk)
        } else {
            if b == 46 && i + 2 < n && byte_at(src, i + 1) == 46 && byte_at(src, i + 2) == 61 {
                toks.push("..=")
                i += 3
            } else if b == 46 && i + 1 < n && byte_at(src, i + 1) == 46 {
                toks.push("..")
                i += 2
            } else if b == 45 && i + 1 < n && byte_at(src, i + 1) == 62 {
                toks.push("->")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 62 {
                toks.push("=>")
                i += 2
            } else if b == 61 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("==")
                i += 2
            } else if b == 33 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("!=")
                i += 2
            } else if b == 60 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push("<=")
                i += 2
            } else if b == 62 && i + 1 < n && byte_at(src, i + 1) == 61 {
                toks.push(">=")
                i += 2
            } else if b == 38 && i + 1 < n && byte_at(src, i + 1) == 38 {
                toks.push("&&")
                i += 2
            } else {
                toks.push(byte_slice(src, i, i + 1))
                i += 1
            }
        }
    }
    toks.push("#EOF")
}

fn tok(toks: List[Str], cur: Atomic[I32]) -> Str {
    var i = cur.load()
    if i < toks.len { return toks[i] }
    return "#EOF"
}
fn adv(cur: Atomic[I32]) {
    cur.store(cur.load() + 1)
}

fn num_text(t: Str) -> Str {
    var k: I32 = 0
    while k < t.len && byte_at(t, k) != 126 { k += 1 }
    return byte_slice(t, 0, k)
}
fn num_sfx(t: Str) -> Str {
    var k: I32 = 0
    while k < t.len && byte_at(t, k) != 126 { k += 1 }
    return byte_slice(t, k + 1, t.len)
}

// ---------------- 树节点 ----------------
fn mk(t: Str) -> List[Str] {
    var n = List[Str]()
    n.push(t)
    return n
}

// ---------------- 解析(建树) ----------------
fn qtext(raw: Str) -> Str {
    var out = ""
    var j: I32 = 0
    var n = raw.len
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 1 < n && byte_at(raw, j + 1) == 123 {
            out = out + "\{"
            j += 2
        } else {
            out = out + byte_slice(raw, j, j + 1)
            j += 1
        }
    }
    return out
}

fn parts_of(raw: Str) -> List[Str] {
    var np = mk("Parts")
    var k: I32 = 0
    var n = raw.len
    var j: I32 = 0
    var ts: I32 = 0
    while j < n {
        var c = byte_at(raw, j)
        if c == 92 && j + 2 <= n {
            if j + 3 < n && byte_at(raw, j + 1) == 117 && byte_at(raw, j + 2) == 123 {
                var q = j + 3
                while q < n && byte_at(raw, q) != 125 { q += 1 }
                if q < n { j = q + 1 } else { j += 2 }
            } else {
                j += 2
            }
        } else if c == 123 {
            if j > ts {
                var tx = mk("Text")
                tx.push(qtext(byte_slice(raw, ts, j)))
                np.push(tx)
                k += 1
            }
            var d: I32 = 1
            var p = j + 1
            while d > 0 && p < n {
                var cp = byte_at(raw, p)
                if cp == 123 { d += 1 }
                if cp == 125 { d -= 1 }
                p += 1
            }
            var ix = mk("Interp")
            ix.push(qtext(byte_slice(raw, j + 1, p - 1)))
            np.push(ix)
            k += 1
            j = p
            ts = p
        } else {
            j += 1
        }
    }
    if n > ts {
        var ty = mk("Text")
        ty.push(qtext(byte_slice(raw, ts, n)))
        np.push(ty)
        k += 1
    }
    return np
}

fn p_and(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var l = p_cmp(toks, cur)
    var go = true
    while go {
        if tok(toks, cur) == "&&" {
            adv(cur)
            var r = p_cmp(toks, cur)
            var nb = mk("Binary")
            nb.push("AndAnd")
            nb.push(l)
            nb.push(r)
            l = nb
        } else { go = false }
    }
    return l
}

fn p_cmp(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var l = p_rng(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "==" { op = "Eq" }
        if t == "!=" { op = "Ne" }
        if t == "<" { op = "Lt" }
        if t == ">" { op = "Gt" }
        if t == "<=" { op = "Le" }
        if t == ">=" { op = "Ge" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_rng(toks, cur)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_rng(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var f = p_add(toks, cur)
    var t = tok(toks, cur)
    if or2(t == "..", t == "..=") {
        adv(cur)
        var to = p_add(toks, cur)
        var nb = mk("Range")
        if t == "..=" {
            nb.push("true")
        } else {
            nb.push("false")
        }
        nb.push(f)
        nb.push(to)
        return nb
    }
    return f
}

fn p_add(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var l = p_mul(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "+" { op = "Add" }
        if t == "-" { op = "Sub" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_mul(toks, cur)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_mul(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var l = p_una(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        var op = ""
        if t == "*" { op = "Mul" }
        if t == "/" { op = "Div" }
        if t == "%" { op = "Mod" }
        if op == "" { go = false } else {
            adv(cur)
            var r = p_una(toks, cur)
            var nb = mk("Binary")
            nb.push(op)
            nb.push(l)
            nb.push(r)
            l = nb
        }
    }
    return l
}

fn p_una(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var t = tok(toks, cur)
    if t == "-" {
        adv(cur)
        var e = p_una(toks, cur)
        var nu = mk("Unary")
        nu.push("Neg")
        nu.push(e)
        return nu
    }
    if t == "!" {
        adv(cur)
        var e = p_una(toks, cur)
        var nu = mk("Unary")
        nu.push("Not")
        nu.push(e)
        return nu
    }
    return p_post(toks, cur)
}

fn p_post(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var e = p_pri(toks, cur)
    var go = true
    while go {
        var t = tok(toks, cur)
        if t == "(" {
            adv(cur)
            var ag = mk("Args")
            var more = true
            while more {
                if tok(toks, cur) == ")" {
                    more = false
                } else {
                    ag.push(p_stmt_expr(toks, cur))
                    if tok(toks, cur) == "," {
                        adv(cur)
                    } else {
                        more = false
                    }
                }
            }
            adv(cur)
            var cl = mk("Call")
            cl.push(e)
            cl.push(ag)
            e = cl
        } else if t == "." {
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            var mb = mk("Member")
            mb.push(e)
            mb.push(nm)
            e = mb
        } else {
            go = false
        }
    }
    return e
}

fn p_pri(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var t = tok(toks, cur)
    var b0 = byte_at(t, 0)
    if is_digit(b0) {
        adv(cur)
        var nb = mk("Int")
        var isf = false
        var tx = num_text(t)
        var jj: I32 = 0
        while jj < tx.len {
            var cc = byte_at(tx, jj)
            if or2(cc == 46, or2(cc == 101, cc == 69)) { isf = true }
            jj += 1
        }
        if isf { nb = mk("Float") }
        nb.push(num_text(t))
        nb.push(num_sfx(t))
        return nb
    }
    if t == "if" {
        return p_if(toks, cur)
    }
    if b0 == 34 {
        adv(cur)
        var ns = mk("Str")
        ns.push(parts_of(byte_slice(t, 1, t.len - 1)))
        return ns
    }
    if t == "(" {
        adv(cur)
        var e = p_and(toks, cur)
        adv(cur)
        return e
    }
    adv(cur)
    var ni = mk("Ident")
    ni.push(t)
    return ni
}

fn p_typ(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var nm = tok(toks, cur)
    adv(cur)
    var nt = mk("Named")
    nt.push(nm)
    return nt
}

fn p_stmt_expr(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    return p_and(toks, cur)
}

fn p_if(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var ni = mk("If")
    ni.push(p_and(toks, cur))
    adv(cur)
    ni.push(p_block(toks, cur))
    var els = mk("None")
    if tok(toks, cur) == "else" {
        adv(cur)
        if tok(toks, cur) == "if" {
            els = p_if(toks, cur)
        } else {
            adv(cur)
            var be = mk("BlockExpr")
            be.push(p_block(toks, cur))
            els = be
        }
    }
    ni.push(els)
    return ni
}


fn p_block(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var nb = mk("Block")
    var hasTail = false
    var go = true
    while go {
        var t = tok(toks, cur)
        if t == "}" {
            adv(cur)
            go = false
        } else if t == "#EOF" {
            go = false
        } else if t == "return" {
            adv(cur)
            var re = mk("Return")
            re.push(p_stmt_expr(toks, cur))
            nb.push(re)
        } else if t == "while" {
            adv(cur)
            var wc = p_and(toks, cur)
            adv(cur)
            var wb = p_block(toks, cur)
            var wh = mk("While")
            wh.push(wc)
            wh.push(wb)
            nb.push(wh)
        } else if t == "for" {
            adv(cur)
            var pn = tok(toks, cur)
            adv(cur)
            adv(cur)
            var it = p_and(toks, cur)
            adv(cur)
            var fb = p_block(toks, cur)
            var fo = mk("For")
            fo.push(pn)
            fo.push(it)
            fo.push(fb)
            nb.push(fo)
        } else if or2(t == "let", t == "var") {
            var isv = "false"
            if t == "var" { isv = "true" }
            adv(cur)
            var nm = tok(toks, cur)
            adv(cur)
            var ty = mk("None")
            if tok(toks, cur) == ":" {
                adv(cur)
                ty = p_typ(toks, cur)
            }
            adv(cur)
            var lv = mk("Let")
            lv.push(isv)
            lv.push(nm)
            lv.push(ty)
            lv.push(p_stmt_expr(toks, cur))
            nb.push(lv)
        } else {
            var e = p_stmt_expr(toks, cur)
            var t2 = tok(toks, cur)
            var op = ""
            if t2 == "=" { op = "Eq" }
            if t2 == "+=" { op = "AddEq" }
            if t2 == "-=" { op = "SubEq" }
            if t2 == "*=" { op = "MulEq" }
            if t2 == "/=" { op = "DivEq" }
            if t2 == "%=" { op = "ModEq" }
            if op == "" {
                nb.push(e)
                hasTail = true
                if tok(toks, cur) == "}" {
                    adv(cur)
                }
                go = false
            } else {
                adv(cur)
                var asn = mk("Assign")
                asn.push(e)
                asn.push(op)
                asn.push(p_stmt_expr(toks, cur))
                nb.push(asn)
            }
        }
    }
    if !hasTail {
        var nn = mk("None")
        nb.push(nn)
    }
    return nb
}

fn p_fn(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var nf = mk("Fn")
    nf.push(nm)
    var ps = mk("Ps")
    var more = true
    while more {
        if tok(toks, cur) == ")" { more = false } else {
            var pn = tok(toks, cur)
            adv(cur)
            adv(cur)
            var pty = p_typ(toks, cur)
            var par = mk("Param")
            par.push(pn)
            par.push(pty)
            ps.push(par)
            if tok(toks, cur) == "," { adv(cur) } else { more = false }
        }
    }
    adv(cur)
    var ret = mk("None")
    if tok(toks, cur) == "->" {
        adv(cur)
        ret = p_typ(toks, cur)
    }
    adv(cur)
    var body = p_block(toks, cur)
    nf.push(ps)
    nf.push(ret)
    nf.push(body)
    return nf
}

fn p_test(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    adv(cur)
    var t = tok(toks, cur)
    adv(cur)
    var nt = mk("Test")
    nt.push(qtext(byte_slice(t, 1, t.len - 1)))
    adv(cur)
    nt.push(p_block(toks, cur))
    return nt
}

fn p_file(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var nf = mk("File")
    var go = true
    while go {
        if tok(toks, cur) == "#EOF" {
            go = false
        } else if tok(toks, cur) == "test" {
            nf.push(p_test(toks, cur))
        } else {
            nf.push(p_fn(toks, cur))
        }
    }
    return nf
}


// ---------------- 树打印 → C-AST v1 ----------------
fn pnode(n: List[Str]) -> Str {
    var t = n[0]
    var out = ""
    if t == "File" {
        out = out + "File \{ decls: ["
        var i: I32 = 1
        while i < n.len {
            if i > 1 {
                out = out + ",\n  "
            } else {
                out = out + "\n  "
            }
            out = out + pnode(n[i])
            i += 1
        }
        out = out + "\n] }\n"
    } else if t == "Fn" {
        out = out + "Fn \{ attrs: [], vis: Private, is_comptime: false, abi: None, name: \""
        out = out + n[1] + "\", type_params: [], params: ["
        var ps = n[2]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[3]) + ", body: " + pnode(n[4]) + "}"
    } else if t == "Ps" {
        var j2: I32 = 1
        while j2 < n.len {
            if j2 > 1 { out = out + ", " }
            out = out + pnode(n[j2])
            j2 += 1
        }
    } else if t == "Param" {
        out = out + "Param \{ is_var: false, name: \"" + n[1] + "\", ty: " + pnode(n[2]) + "}"
    } else if t == "Named" {
        out = out + "Named \{ path: [\"" + n[1] + "\"], args: []}"
    } else if t == "None" {
        out = out + "None"
    } else if t == "Block" {
        out = out + "Block \{ stmts: ["
        var k: I32 = 1
        while k < n.len - 1 {
            if k > 1 { out = out + ", " }
            out = out + pnode(n[k])
            k += 1
        }
        out = out + "], tail: " + pnode(n[n.len - 1]) + "}"
    } else if t == "Return" {
        out = out + "Return(" + pnode(n[1]) + ")"
    } else if t == "Let" {
        out = out + "Let \{ is_var: " + n[1] + ", pattern: Ident(\"" + n[2] + "\"), ty: " + pnode(n[3]) + ", expr: " + pnode(n[4]) + "}"
    } else if t == "Assign" {
        out = out + "Assign \{ target: " + pnode(n[1]) + ", op: " + n[2] + ", value: " + pnode(n[3]) + "}"
    } else if t == "Binary" {
        out = out + "Binary \{ op: " + n[1] + ", lhs: " + pnode(n[2]) + ", rhs: " + pnode(n[3]) + "}"
    } else if t == "Unary" {
        out = out + "Unary \{ op: " + n[1] + ", expr: " + pnode(n[2]) + "}"
    } else if t == "Range" {
        out = out + "Range \{ inclusive: " + n[1] + ", from: " + pnode(n[2]) + ", to: " + pnode(n[3]) + "}"
    } else if t == "If" {
        out = out + "If \{ cond: " + pnode(n[1]) + ", then: " + pnode(n[2]) + ", els: " + pnode(n[3]) + "}"
    } else if t == "BlockExpr" {
        out = out + "BlockExpr(" + pnode(n[1]) + ")"
    } else if t == "While" {
        out = out + "While \{ cond: " + pnode(n[1]) + ", body: " + pnode(n[2]) + "}"
    } else if t == "For" {
        out = out + "For \{ pattern: Ident(\"" + n[1] + "\"), iter: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "Call" {
        out = out + "Call \{ callee: " + pnode(n[1]) + ", args: ["
        var al = n[2]
        var ak: I32 = 1
        while ak < al.len {
            if ak > 1 { out = out + ", " }
            out = out + pnode(al[ak])
            ak += 1
        }
        out = out + "] }"
    } else if t == "Member" {
        out = out + "Member \{ obj: " + pnode(n[1]) + ", target: Name(\"" + n[2] + "\")}"
    } else if t == "Str" {
        out = out + "Str \{ parts: "
        var pl = n[1]
        var pk: I32 = 1
        out = out + "["
        while pk < pl.len {
            if pk > 1 { out = out + ", " }
            out = out + pnode(pl[pk])
            pk += 1
        }
        out = out + "]}"
    } else if t == "Text" {
        out = out + "Text(\"" + qtext(n[1]) + "\")"
    } else if t == "Interp" {
        out = out + "Interp(\"" + qtext(n[1]) + "\")"
    } else if t == "Test" {
        out = out + "Test \{ name: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "Int" {
        out = out + "Int \{ text: \"" + n[1] + "\", suffix: \"" + n[2] + "\"}"
    } else if t == "Float" {
        out = out + "Float \{ text: \"" + n[1] + "\", suffix: \"" + n[2] + "\"}"
    } else if t == "Ident" {
        out = out + "Ident(\"" + n[1] + "\")"
    }
    return out
}

fn main() -> I32 {
    let src = read_file("selfhost/input_ptree.ct")
    match src {
        Some(s) => {
            var toks = List[Str]()
            scan(s, toks)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur)
            print(pnode(file))
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
