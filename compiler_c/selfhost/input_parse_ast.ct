fn f(x: I32) -> I32 { return x * 2 + 0xFFu8 }
fn g(a: F64) -> F64 { return (a - 1.5e3) / 2.5f64 }
fn h(n: I32) -> Bool { return n >= 0 && !(n > 100) }
fn q() -> I32 { return 0 .. 5 }
fn r(x: I32) -> I32 { return -x + 1_000i16 .. 7 }
fn s(a: I32, b: I32) -> I32 { return a + b * 2 - 6 / 3 % 2 }
fn callf(x: I32) -> I32 { return pick(x, 1 + 2) }
fn tailf(x: I32) -> I32 { x * 2 }
fn multi(x: I32) -> I32 { return x + 1
return x - 1 }
fn lets(x: I32) -> I32 {
    let y = x + 1
    var z: I32 = y * 2
    return z
}
