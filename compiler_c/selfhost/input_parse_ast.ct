fn f(x: I32) -> I32 { return x * 2 + 0xFFu8 }
fn g(a: F64) -> F64 { return (a - 1.5e3) / 2.5f64 }
fn h(n: I32) -> Bool { return n >= 0 && !(n > 100) }
fn q() -> I32 { return 0 .. 5 }
fn r(x: I32) -> I32 { return -x + 1_000i16 .. 7 }
fn s(a: I32, b: I32) -> I32 { return a + b * 2 - 6 / 3 % 2 }
fn callf(x: I32) -> I32 { return pick(x, 1 + 2) }
fn tailf(x: I32) -> I32 { x * 2 }
fn multi(x: I32) -> I32 { return x + 1
return x - 1 }
fn lets(x: I32) -> I32 {
    let y = x + 1
    var z: I32 = y * 2
    return z
}
fn memb(x: I32) -> I32 {
    let y = x.double() + arr[0]
    return y
}
fn assignf(v: I32) -> I32 {
    var n = v
    n = n + 1
    n += 10
    n -= 2
    return n
}
fn loops(n: I32) -> I32 {
    var s = 0
    while s < n {
        s = s + 1
    }
    for i in 0 .. 5 {
        s = s + i
    }
    return s
}
fn iff(n: I32) -> I32 {
    let r = if n > 0 { 1 } else { 0 }
    return r
}
fn ief(n: I32) -> I32 {
    if n > 10 {
        return 1
    }
    return 0
}
fn grad(n: I32) -> I32 {
    return if n > 0 { 1 } else if n < 0 { -1 } else { 0 }
}
fn greet(name: Str) -> Str {
    return "hi " + name
}
test "arithmetic" {
    assert_eq(2 + 3, 5)
    assert_eq("v={1 + 1}", "v=2")
    assert_eq("esc\n\ttab", "x")
}
test "str edge" {
    assert_eq("", "")
    assert_eq("{a}", "a")
    assert_eq("x{y}z", "xyz")
    assert_eq("q\"q", "x")
    assert_eq("lit \{x}", "x")
}
fn useopt(p: Option[Str], r: &I32) -> Option[I32] {
    return p
}
fn applyf(f: fn(I32) -> I32, x: I32) -> I32 {
    return f(x)
}
fn maybe(n: I32?) -> I32 {
    return 0
}
fn name(c: Color, n: I32) -> Str {
    return match c {
        Red   => "red"
        Green => "green"
        Blue  => if n > 0 { "blue+" } else { "blue" }
    }
}
fn mm(o: Option[I32], p: Pt, s: Str) -> I32 {
    match o {
        Some(v) => v
        None => 0
    }
    match s {
        "a" => 1
        _ => 0
    }
    match p {
        Pt { x } => x
        _ => 0
    }
    match 7 {
        0 => assert(false)
        7 => assert(true)
        _ => assert(false)
    }
    return 0
}
