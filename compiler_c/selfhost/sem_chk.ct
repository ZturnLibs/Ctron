    ns.push(wv)
    ns.push(ty)
    ns.push(p_stmt_expr(toks, cur))
    return ns
}

fn p_file(toks: List[Str], cur: Atomic[I32]) -> List[Str] {
    var nf = mk("File")
    var go = true
    while go {
        while tok(toks, cur) == "NL" {
            adv(cur)
        }
        var t = tok(toks, cur)
        if t == "#EOF" {
            go = false
        } else if t == "#" {
            adv(cur)
            adv(cur)
            var anm = tok(toks, cur)
            adv(cur)
            while tok(toks, cur) != "]" && tok(toks, cur) != "#EOF" {
                adv(cur)
            }
            if tok(toks, cur) == "]" {
                adv(cur)
            }
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var fd = p_fn2(toks, cur, "Fn")
            fd.push(anm)
            nf.push(fd)
        } else if t == "pub" {
            adv(cur)
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            if tok(toks, cur) == "fn" {
                nf.push(p_fn2(toks, cur, "FnPub"))
            } else {
                nf.push(p_fn(toks, cur))
            }
        } else if t == "comptime" {
            adv(cur)
            nf.push(p_fn2(toks, cur, "FnC"))
        } else if t == "@" {
            adv(cur)
            adv(cur)
            adv(cur)
            var dr2 = mk("Drvs")
            var more3 = true
            while more3 {
                if tok(toks, cur) == ")" {
                    more3 = false
                } else {
                    dr2.push(tok(toks, cur))
                    adv(cur)
                    if tok(toks, cur) == "," { adv(cur) }
                }
            }
            adv(cur)
            while tok(toks, cur) == "NL" {
                adv(cur)
            }
            var t2 = tok(toks, cur)
            if t2 == "struct" {
                nf.push(p_struct2(toks, cur, dr2))
            } else if t2 == "enum" {
                nf.push(p_enum2(toks, cur, dr2))
            } else if t2 == "trait" {
                nf.push(p_trait(toks, cur))
            } else {
                nf.push(p_fn(toks, cur))
            }
        } else if t == "test" {
            nf.push(p_test(toks, cur))
        } else if t == "enum" {
            nf.push(p_enum(toks, cur))
        } else if t == "struct" {
            nf.push(p_struct(toks, cur))
        } else if t == "class" {
            nf.push(p_class(toks, cur))
        } else if t == "impl" {
            nf.push(p_impl(toks, cur))
        } else if t == "trait" {
            nf.push(p_trait(toks, cur))
        } else if t == "use" {
            nf.push(p_use(toks, cur))
        } else if t == "const" {
            nf.push(p_const(toks, cur))
        } else if t == "static" {
            nf.push(p_static(toks, cur))
        } else {
            nf.push(p_fn(toks, cur))
        }
    }
    return nf
}




// ---------------- 树打印 → C-AST v1 ----------------
fn pjoin(n: List[Str]) -> Str {
    var out = ""
    var i: I32 = 1
    while i < n.len {
        if i > 1 { out = out + ", " }
        out = out + pnode(n[i])
        i += 1
    }
    return out
}

fn pnode(n: List[Str]) -> Str {
    var t = n[0]
    var out = ""
    if t == "File" {
        out = out + "File \{ decls: ["
        var i: I32 = 1
        while i < n.len {
            if i > 1 {
                out = out + ",\n  "
            } else {
                out = out + "\n  "
            }
            out = out + pnode(n[i])
            i += 1
        }
        out = out + "\n] }\n"
        } else if t == "FnPub" {
        out = out + "Fn \{ attrs: [], vis: Pub, is_comptime: false, abi: None, name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], params: ["
        var ps = n[3]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[4]) + ", body: " + pnode(n[5]) + "}"
    } else if t == "FnC" {
        out = out + "Fn \{ attrs: [], vis: Private, is_comptime: true, abi: None, name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], params: ["
        var ps = n[3]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[4]) + ", body: " + pnode(n[5]) + "}"
    } else if or2(t == "Fn", t == "Method") {
        var atxt = "[]"
        if n.len >= 7 {
            atxt = "[Attribute \{ name: \"" + n[6] + "\", args: []}]"
        }
        out = out + t + " \{ attrs: " + atxt + ", vis: Private, is_comptime: false, abi: None, name: \""
        out = out + n[1] + "\", type_params: ["
        var tp = n[2]
        var tj: I32 = 1
        while tj < tp.len {
            if tj > 1 { out = out + ", " }
            out = out + pnode(tp[tj])
            tj += 1
        }
        out = out + "], params: ["
        var ps = n[3]
        var j: I32 = 1
        while j < ps.len {
            if j > 1 { out = out + ", " }
            out = out + pnode(ps[j])
            j += 1
        }
        out = out + "], ret: " + pnode(n[4]) + ", body: " + pnode(n[5]) + "}"
    } else if t == "Ps" {
    } else if t == "Ps" {
        var j2: I32 = 1
        while j2 < n.len {
            if j2 > 1 { out = out + ", " }
            out = out + pnode(n[j2])
            j2 += 1
        }
        } else if t == "Param" {
        out = out + "Param \{ is_var: " + n[1] + ", name: \"" + n[2] + "\", ty: " + pnode(n[3]) + "}"
    } else if t == "Receiver" {
        out = out + "Receiver \{ is_var: " + n[1] + " }"
    } else if t == "TPs" {
        var tj2: I32 = 1
        while tj2 < n.len {
            if tj2 > 1 { out = out + ", " }
            out = out + pnode(n[tj2])
            tj2 += 1
        }
    } else if t == "TPar" {
        out = out + "TypeParam \{ name: \"" + n[1] + "\", bound: ["
        var bd = n[3]
        var bj: I32 = 1
        while bj < bd.len {
            if bj > 1 { out = out + ", " }
            out = out + "\"" + bd[bj] + "\""
            bj += 1
        }
        out = out + "], is_comptime: " + n[2] + " }"
    } else if t == "TupleT" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "Ref" {
        out = out + "Ref(" + pnode(n[1]) + ")"
    } else if t == "Optional" {
        out = out + "Optional(" + pnode(n[1]) + ")"
    } else if t == "FnType" {
        out = out + "Fn \{ params: [" + pjoin(n[1]) + "], ret: " + pnode(n[2]) + "}"
    } else if t == "Slice" {
        out = out + "Slice(" + pnode(n[1]) + ")"
    } else if t == "ArrayT" {
        out = out + "Array \{ elem: " + pnode(n[1]) + ", size: " + pnode(n[2]) + "}"
    } else if t == "Named" {
        out = out + "Named \{ path: [\"" + n[1] + "\"], args: ["
        var tt = n[2]
        var tk2: I32 = 1
        while tk2 < tt.len {
            if tk2 > 1 { out = out + ", " }
            out = out + pnode(tt[tk2])
            tk2 += 1
        }
        out = out + "]}"
    } else if t == "None" {
        out = out + "None"
    } else if t == "Block" {
        out = out + "Block \{ stmts: ["
        var k: I32 = 1
        while k < n.len - 1 {
            if k > 1 { out = out + ", " }
            out = out + pnode(n[k])
            k += 1
        }
        out = out + "], tail: " + pnode(n[n.len - 1]) + "}"
    } else if t == "Return" {
        out = out + "Return(" + pnode(n[1]) + ")"
    } else if t == "Let" {
        out = out + "Let \{ is_var: " + n[1] + ", pattern: " + pnode(n[2]) + ", ty: " + pnode(n[3]) + ", expr: " + pnode(n[4]) + "}"
    } else if t == "Expr" {
        out = out + "Expr(" + pnode(n[1]) + ")"
    } else if t == "Assign" {
        out = out + "Assign \{ target: " + pnode(n[1]) + ", op: " + n[2] + ", value: " + pnode(n[3]) + "}"
    } else if t == "Binary" {
        out = out + "Binary \{ op: " + n[1] + ", lhs: " + pnode(n[2]) + ", rhs: " + pnode(n[3]) + "}"
    } else if t == "Unary" {
        out = out + "Unary \{ op: " + n[1] + ", expr: " + pnode(n[2]) + "}"
    } else if t == "Range" {
        out = out + "Range \{ inclusive: " + n[1] + ", from: " + pnode(n[2]) + ", to: " + pnode(n[3]) + "}"
    } else if t == "If" {
        out = out + "If \{ cond: " + pnode(n[1]) + ", then: " + pnode(n[2]) + ", els: " + pnode(n[3]) + "}"
    } else if t == "BlockExpr" {
        out = out + "BlockExpr(" + pnode(n[1]) + ")"
    } else if t == "While" {
        out = out + "While \{ cond: " + pnode(n[1]) + ", body: " + pnode(n[2]) + "}"
    } else if t == "For" {
        out = out + "For \{ pattern: " + pnode(n[1]) + ", iter: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "Call" {
        out = out + "Call \{ callee: " + pnode(n[1]) + ", args: ["
        var al = n[2]
        var ak: I32 = 1
        while ak < al.len {
            if ak > 1 { out = out + ", " }
            out = out + pnode(al[ak])
            ak += 1
        }
        out = out + "] }"
    } else if t == "Member" {
        out = out + "Member \{ obj: " + pnode(n[1]) + ", target: "
        if n[2] == "TIdx" {
            out = out + "TupleIndex(" + n[3] + ")"
        } else {
            out = out + "Name(\"" + n[3] + "\")"
        }
        out = out + "}"
    } else if t == "Index" {
        out = out + "Index \{ obj: " + pnode(n[1]) + ", index: " + pnode(n[2]) + "}"
    } else if t == "TypeArgs" {
        out = out + "TypeArgs \{ expr: " + pnode(n[1]) + ", args: ["
        var tl = n[2]
        var tk: I32 = 1
        while tk < tl.len {
            if tk > 1 { out = out + ", " }
            out = out + pnode(tl[tk])
            tk += 1
        }
        out = out + "]}"
    } else if t == "Try" {
        out = out + "Try(" + pnode(n[1]) + ")"
    } else if t == "Own" {
        out = out + "Own \{ arena: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "Closure" {
        out = out + "Closure \{ params: ["
        var cp = n[1]
        var cj: I32 = 1
        while cj < cp.len {
            if cj > 1 { out = out + ", " }
            out = out + pnode(cp[cj])
            cj += 1
        }
        out = out + "], ret: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "ClosureParam" {
        out = out + "ClosureParam \{ is_var: " + n[1] + ", name: \"" + n[2] + "\", ty: " + pnode(n[3]) + "}"
    } else if t == "Scope" {
        out = out + "Scope \{ param: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "Match" {
        out = out + "Match \{ expr: " + pnode(n[1]) + ", arms: ["
        var ar = n[2]
        var ak: I32 = 1
        while ak < ar.len {
            if ak > 1 { out = out + ", " }
            out = out + pnode(ar[ak])
            ak += 1
        }
        out = out + "]}"
    } else if t == "Arm" {
        out = out + "MatchArm \{ pattern: " + pnode(n[1]) + ", expr: " + pnode(n[2]) + "}"
    } else if t == "PatWild" {
        out = out + "Wildcard"
    } else if t == "PatLitI" {
        out = out + "Lit(Int(\"" + n[1] + "\"))"
    } else if t == "PatLitF" {
        out = out + "Lit(Float(\"" + n[1] + "\"))"
    } else if t == "PatLitS" {
        out = out + "Lit(Str(\"" + n[1] + "\"))"
    } else if t == "PatLitB" {
        out = out + "Lit(Bool(" + n[1] + "))"
    } else if t == "PatId" {
        out = out + "Ident(\"" + n[1] + "\")"
    } else if t == "PatTup" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "PatAgg" {
        out = out + "Agg \{ path: [\"" + n[1] + "\"], sub: " + pnode(n[2]) + "}"
    } else if t == "SubUnit" {
        out = out + "Unit"
    } else if t == "SubTup" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "SubSt" {
        out = out + "Struct(["
        var j2: I32 = 1
        while j2 < n.len {
            if j2 > 1 { out = out + ", " }
            out = out + pnode(n[j2])
            j2 += 1
        }
        out = out + "])"
    } else if t == "PatFld" {
        out = out + "StructPatField \{ name: \"" + n[1] + "\", pattern: " + pnode(n[2]) + "}"
    } else if t == "StructLit" {
        out = out + "StructLit \{ path: [\"" + n[1] + "\"], fields: ["
        var ll = n[2]
        var lj: I32 = 1
        while lj < ll.len {
            if lj > 1 { out = out + ", " }
            out = out + pnode(ll[lj])
            lj += 1
        }
        out = out + "] }"
    } else if t == "LField" {
        out = out + "StructField \{ name: \"" + n[1] + "\", value: " + pnode(n[2]) + "}"
            } else if t == "Struct" {
        out = out + "Struct \{ attrs: [], derives: ["
        var dv = n[2]
        var dj: I32 = 1
        while dj < dv.len {
            if dj > 1 { out = out + ", " }
            out = out + "\"" + dv[dj] + "\""
            dj += 1
        }
        out = out + "], name: \"" + n[1] + "\", type_params: [" + pjoin(n[3]) + "], fields: [" + pjoin(n[4]) + "] }"
    } else if t == "Enum" {
        out = out + "Enum \{ attrs: [], derives: ["
        var dv2 = n[2]
        var dj2: I32 = 1
        while dj2 < dv2.len {
            if dj2 > 1 { out = out + ", " }
            out = out + "\"" + dv2[dj2] + "\""
            dj2 += 1
        }
        out = out + "], name: \"" + n[1] + "\", type_params: [], variants: [" + pjoin(n[3]) + "] }"
} else if t == "Field" {
        out = out + "Field \{ vis: Private, is_var: " + n[1] + ", name: \"" + n[2] + "\", ty: " + pnode(n[3]) + "}"
    } else if t == "Variant" {
        out = out + "Variant \{ name: \"" + n[1] + "\", kind: " + pnode(n[2]) + "}"
    } else if t == "KUnit" {
        out = out + "Unit"
    } else if t == "KTuple" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "KStruct" {
        out = out + "Struct([" + pjoin(n) + "])"
    } else if t == "Class" {
        out = out + "Class \{ attrs: [], name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], items: [" + pjoin(n[3]) + "] }"
    } else if t == "Impl" {
        out = out + "Impl \{ type_params: [" + pjoin(n[1]) + "], trait_ty: " + pnode(n[2]) + ", for_ty: " + pnode(n[3]) + ", items: [" + pjoin(n[4]) + "] }"
    } else if or3(t == "PropSig", t == "PropImpl", t == "Prop") {
        out = out + t + " \{ vis: Private, name: \"" + n[1] + "\", ty: " + pnode(n[2]) + ", body: " + pnode(n[3]) + "}"
    } else if t == "Trait" {
        out = out + "Trait \{ attrs: [], name: \"" + n[1] + "\", type_params: [" + pjoin(n[2]) + "], supers: ["
        var su = n[3]
        var sj: I32 = 1
        while sj < su.len {
            if sj > 1 { out = out + ", " }
            out = out + "\"" + su[sj] + "\""
            sj += 1
        }
        out = out + "], items: [" + pjoin(n[4]) + "] }"
    } else if t == "Items" {
        out = out + pjoin(n)
    } else if t == "Use" {
        out = out + "Use \{ imports: [["
        var uj: I32 = 1
        while uj < n.len {
            if uj > 1 { out = out + ", " }
            out = out + "\"" + n[uj] + "\""
            uj += 1
        }
        out = out + "]] }"
    } else if t == "Const" {
        out = out + "Const \{ name: \"" + n[1] + "\", ty: " + pnode(n[2]) + ", expr: " + pnode(n[3]) + "}"
    } else if t == "Static" {
        out = out + "Static \{ name: \"" + n[1] + "\", was_var: " + n[2] + ", ty: " + pnode(n[3]) + ", expr: " + pnode(n[4]) + "}"
    } else if t == "Str" {
        out = out + "Str \{ parts: "
        var pl = n[1]
        var pk: I32 = 1
        out = out + "["
        while pk < pl.len {
            if pk > 1 { out = out + ", " }
            out = out + pnode(pl[pk])
            pk += 1
        }
        out = out + "]}"
    } else if t == "Text" {
        out = out + "Text(\"" + qtext(n[1]) + "\")"
    } else if t == "Interp" {
        out = out + "Interp(\"" + qtext(n[1]) + "\")"
    } else if t == "Test" {
        out = out + "Test \{ name: \"" + n[1] + "\", body: " + pnode(n[2]) + "}"
    } else if t == "BlockExpr" {
        out = out + "BlockExpr(" + pnode(n[1]) + ")"
    } else if t == "ComptimeVal" {
        out = out + "ComptimeVal(\"" + n[1] + "\")"
    } else if t == "Int" {
        out = out + "Int \{ text: \"" + n[1] + "\", suffix: \"" + n[2] + "\"}"
    } else if t == "Float" {
        out = out + "Float \{ text: \"" + n[1] + "\", suffix: \"" + n[2] + "\"}"
    } else if t == "Bool" {
        out = out + "Bool(" + n[1] + ")"
    } else if t == "Void" {
        out = out + "Void"
    } else if t == "ArrLit" {
        out = out + "Array(" + pjoin(n) + ")"
    } else if t == "TupleE" {
        out = out + "Tuple(" + pjoin(n) + ")"
    } else if t == "Ident" {
        out = out + "Ident(\"" + n[1] + "\")"
    }
    return out
}


// ---------------- C8a:语义检查(W8010 浅拷贝;树上行走,与 C sem 差分) ----------------
fn sem_walk(file: List[Str]) -> Str {
    var out = ""
    // 第一遍:收集 class 名
    var cls = List[Str]()
    var i: I32 = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Class" {
            cls.push(d[1])
        }
        i += 1
    }
    // 第二遍:struct 字段类型首段命中 class → W8010(每 struct 一条)
    i = 1
    while i < file.len {
        var d = file[i]
        if d[0] == "Struct" {
            var nm = d[1]
            var hit = false
            var hn = ""
            var fs = d[4]
            var j: I32 = 1
            while j < fs.len && !hit {
                var f = fs[j]
                var ty = f[3]
                if ty[0] == "Named" {
                    var h = ty[1]
                    var k: I32 = 0
                    while k < cls.len && !hit {
                        if cls[k] == h {
                            hit = true
                            hn = f[2]
                        }
                        k += 1
                    }
                }
                j += 1
            }
            if hit {
                out = out + "W8010: struct 含类引用字段(浅拷贝):" + nm + "." + hn + "\n"
            }
        }
        i += 1
    }
    return out
}

fn main() -> I32 {
    let src = read_file("selfhost/input_ptree.ct")
    match src {
        Some(s) => {
            var toks = List[Str]()
            scan(s, toks)
            var cur = Atomic[I32](0)
            var file = p_file(toks, cur)
            print(sem_walk(file))
            return 0
        }
        None => {
            print("read-failed")
            return 1
        }
    }
}
