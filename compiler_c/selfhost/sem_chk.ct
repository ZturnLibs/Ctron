    adv(cur)
    var wv = "false"
    var t = tok(toks, cur)
    if t == "var" { wv = "true" }
    if or2(t == "var", t == "let") { adv(cur) }
    var nm = tok(toks, cur)
    adv(cur)
    adv(cur)
    var ty = p_typ(toks, cur)
    adv(cur)
    var ns = mk("Static")
