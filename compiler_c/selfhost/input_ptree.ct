fn f(x: I32) -> I32 { return x * 2 }
fn g(a: F64) -> F64 { return a + 2.5 }
fn h(n: I32) -> Bool { return n > 0 && !(n < 100) }
fn r(x: I32) -> I32 { return -x + 1_000i16 .. 7 }
fn s(a: I32, b: I32) -> I32 {
    let y = a + b * 2
    return y - 6 / 3 % 2
}
fn l(n: I32) -> I32 {
    var s = 0
    while s < n {
        s = s + 1
    }
    for i in 0 .. 5 {
        s = s + i
    }
    return s
}
fn ic(n: I32) -> I32 {
    let r = if n > 0 { 1 } else { 0 }
    return r
}
fn greet(name: Str, n: I32) -> Str {
    return "hi {name} x{n}"
}
test "str edge" {
    assert_eq("esc\n\ttab", "x")
}
enum Color {
    Red
    Hue(I32)
}
struct Pt {
    let x: I32
    let y: I32
}
fn pick(o: Option[I32]) -> I32 {
    match o {
        Some(v) => v
        None => 0
    }
}
use stdweb.dom
const LIMIT: I32 = 5
static let seed: I32 = 1
fn swap[T](pair: (T, T)) -> (T, T) {
    return pair
}
