// 自举 Hello:fn main 执行入口 + read_file/print 内建
fn main() -> I32 {
    let src = read_file("../tests/01_basics.ct")
    match src {
        Some(s) => {
            println("bytes=" + s.len.to_string())
            return 0
        }
        None => {
            println("read-failed")
            return 1
        }
    }
}
