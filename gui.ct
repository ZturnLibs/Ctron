// ==================== 迷你词法(同步自 s6/s7) ====================

fn gws(src: Str, cur: Atomic[I32]) -> I32 {
    var n: I32 = src.len
    while cur.load() < n {
        var b: I32 = byte_at(src, cur.load())
        if b == 47 {
            if cur.load() + 1 < n {
                if byte_at(src, cur.load() + 1) == 47 {
                    cur.store(cur.load() + 2)
                    while cur.load() < n {
                        if byte_at(src, cur.load()) == 10 {
                            break
                        }
                        cur.store(cur.load() + 1)
                    }
                    continue
                }
            }
        }
        if b == 32 {
            cur.store(cur.load() + 1)
        } else {
            if b == 10 {
                cur.store(cur.load() + 1)
            } else {
                if b == 13 {
                    cur.store(cur.load() + 1)
                } else {
                    if b == 9 {
                        cur.store(cur.load() + 1)
                    } else {
                        return 0
                    }
                }
            }
        }
    }
    return 0
}

fn gword(src: Str, cur: Atomic[I32]) -> Str {
    gws(src, cur)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        var al: Bool = b >= 65 && b <= 90
        var low: Bool = b >= 97 && b <= 122
        var dg: Bool = b >= 48 && b <= 57
        if al {
            i += 1
        } else {
            if low {
                i += 1
            } else {
                if b == 95 {
                    i += 1
                } else {
                    if b == 45 {
                        i += 1
                    } else {
                        if dg {
                            i += 1
                        } else {
                            break
                        }
                    }
                }
            }
        }
    }
    cur.store(i)
    if i > start {
        return byte_slice(src, start, i)
    }
    panic("gui: 期待标识符 @byte " + cur.load().to_string())
    return ""
}

fn glit(src: Str, cur: Atomic[I32], c: I32) -> I32 {
    gws(src, cur)
    if byte_at(src, cur.load()) != c {
        var around: Str = "?"
        if cur.load() > 40 {
            around = byte_slice(src, cur.load() - 40, cur.load())
        } else {
            around = byte_slice(src, 0, cur.load())
        }
        panic("gui: 期待字符码 " + c.to_string() + " @byte " + cur.load().to_string() + " srclen=" + src.len.to_string() + " 前文=[" + around + "]")
    }
    cur.store(cur.load() + 1)
    return 0
}

fn gstr(src: Str, cur: Atomic[I32]) -> Str {
    glit(src, cur, 34)
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == 34 {
            break
        }
        i += 1
    }
    cur.store(i + 1)
    return byte_slice(src, start, i)
}

fn gspan(src: Str, cur: Atomic[I32], stop: I32) -> Str {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        if byte_at(src, i) == stop {
            break
        }
        i += 1
    }
    var e: I32 = i
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    while e > start {
        var c1: I32 = byte_at(src, e - 1)
        if c1 == 32 {
            e -= 1
        } else {
            if c1 == 10 {
                e -= 1
            } else {
                if c1 == 9 {
                    e -= 1
                } else {
                    break
                }
            }
        }
    }
    cur.store(i)
    if e > start {
        return byte_slice(src, start, e)
    }
    return ""
}

fn ghex1(b: I32) -> I32 {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    panic("gui: 非法十六进制")
    return 0
}

// ==================== 主题面(§3.4;Theme 全字段=槽序,theme_apply 一步换装) ====================

// 字段序 = gtok_index 槽序 = 规格 §3.1;色 14 字段 #RRGGBB,尺寸 11 字段 I32
pub struct Theme {
    var bg_base: Str
    var surface: Str
    var elevated: Str
    var border: Str
    var border_strong: Str
    var text: Str
    var text_muted: Str
    var accent: Str
    var accent_hover: Str
    var danger: Str
    var success: Str
    var mask: Str
    var disabled_fg: Str
    var disabled_bg: Str
    var radius_sm: I32
    var radius_md: I32
    var radius_lg: I32
    var size_xs: I32
    var size_sm: I32
    var size_md: I32
    var size_lg: I32
    var size_xl: I32
    var space_sm: I32
    var space_md: I32
    var space_lg: I32
}

// 缺省深色主题(值镜像 theme.ct;跨文件 const 不随选择性合并发射,故自含字面量)
// mask 临时 6 位不透明,#RRGGBBAA 随 overlay 波次
pub fn theme_default() -> Theme {
    return Theme {
        bg_base: "#181820"
        surface: "#22222e"
        elevated: "#2a2a38"
        border: "#32323f"
        border_strong: "#454553"
        text: "#e6e6eb"
        text_muted: "#9a9aa8"
        accent: "#2563eb"
        accent_hover: "#3b82f6"
        danger: "#c83c3c"
        success: "#2f9e63"
        mask: "#0a0a12"
        disabled_fg: "#6b6b78"
        disabled_bg: "#23232d"
        radius_sm: 4
        radius_md: 8
        radius_lg: 12
        size_xs: 12
        size_sm: 14
        size_md: 16
        size_lg: 20
        size_xl: 24
        space_sm: 4
        space_md: 8
        space_lg: 16
    }
}

// 一步换装:色字段过 g_parse_color 折 packed,尺寸直写;槽即活值,折叠自动跟随
pub fn theme_apply(t: Theme) -> I32 {
    gui_theme_slot(0, g_parse_color(t.bg_base))
    gui_theme_slot(1, g_parse_color(t.surface))
    gui_theme_slot(2, g_parse_color(t.elevated))
    gui_theme_slot(3, g_parse_color(t.border))
    gui_theme_slot(4, g_parse_color(t.border_strong))
    gui_theme_slot(5, g_parse_color(t.text))
    gui_theme_slot(6, g_parse_color(t.text_muted))
    gui_theme_slot(7, g_parse_color(t.accent))
    gui_theme_slot(8, g_parse_color(t.accent_hover))
    gui_theme_slot(9, g_parse_color(t.danger))
    gui_theme_slot(10, g_parse_color(t.success))
    gui_theme_slot(11, g_parse_color(t.mask))
    gui_theme_slot(12, g_parse_color(t.disabled_fg))
    gui_theme_slot(13, g_parse_color(t.disabled_bg))
    gui_theme_slot(14, t.radius_sm)
    gui_theme_slot(15, t.radius_md)
    gui_theme_slot(16, t.radius_lg)
    gui_theme_slot(17, t.size_xs)
    gui_theme_slot(18, t.size_sm)
    gui_theme_slot(19, t.size_md)
    gui_theme_slot(20, t.size_lg)
    gui_theme_slot(21, t.size_xl)
    gui_theme_slot(22, t.space_sm)
    gui_theme_slot(23, t.space_md)
    gui_theme_slot(24, t.space_lg)
    return 0
}

// 平台 id:0=mac 1=win 2=linux(§2.5;I32 跨界,Str 面由调用方映射)
pub fn gui_platform() -> I32 {
    return gui_platform_id()
}

// 宿主明暗:true=dark(探测不可得回退 dark;进程内缓存)
pub fn gui_os_dark() -> Bool {
    if gui_os_dark_id() == 1 {
        return true
    }
    return false
}

// 缺省主题:CTRON_GUI_THEME 八值钉值 > 平台×明暗(theme_auto 语义,§3.4)
pub fn theme_auto() -> Theme {
    var pin: Str = env_get("CTRON_GUI_THEME")
    if pin == "dark" { return theme_dark() }
    if pin == "light" { return theme_light() }
    if pin == "mac_dark" { return theme_mac_dark() }
    if pin == "mac_light" { return theme_mac_light() }
    if pin == "win_dark" { return theme_win_dark() }
    if pin == "win_light" { return theme_win_light() }
    if pin == "linux_dark" { return theme_linux_dark() }
    if pin == "linux_light" { return theme_linux_light() }
    var pid: I32 = gui_platform_id()
    var dk: I32 = gui_os_dark_id()
    if pid == 0 {
        if dk == 1 { return theme_mac_dark() }
        return theme_mac_light()
    }
    if pid == 1 {
        if dk == 1 { return theme_win_dark() }
        return theme_win_light()
    }
    if dk == 1 { return theme_linux_dark() }
    return theme_linux_light()
}

// 入口缺省换装:用户此前显式 theme_apply 过则不扰(显式优先)
pub fn theme_auto_apply() -> I32 {
    if gui_theme_applied() == 0 {
        return theme_apply(theme_auto())
    }
    return 0
}



