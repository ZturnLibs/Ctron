}

fn gtok_index(w: Str) -> I32 {
    // 槽序 = 规格 §3.1 令牌序 = Theme 字段序(0-13 色 packed,14-24 尺寸 I32)
    if w == "BG_BASE" { return 0 }
    if w == "SURFACE" { return 1 }
    if w == "ELEVATED" { return 2 }
    if w == "BORDER" { return 3 }
    if w == "BORDER_STRONG" { return 4 }
    if w == "TEXT" { return 5 }
    if w == "TEXT_MUTED" { return 6 }
    if w == "ACCENT" { return 7 }
    if w == "ACCENT_HOVER" { return 8 }
    if w == "DANGER" { return 9 }
    if w == "SUCCESS" { return 10 }
    if w == "MASK" { return 11 }
    if w == "DISABLED_FG" { return 12 }
    if w == "DISABLED_BG" { return 13 }
    if w == "RADIUS_SM" { return 14 }
    if w == "RADIUS_MD" { return 15 }
    if w == "RADIUS_LG" { return 16 }
    if w == "SIZE_XS" { return 17 }
    if w == "SIZE_SM" { return 18 }
    if w == "SIZE_MD" { return 19 }
    if w == "SIZE_LG" { return 20 }
    if w == "SIZE_XL" { return 21 }
    if w == "SPACE_SM" { return 22 }
    if w == "SPACE_MD" { return 23 }
    if w == "SPACE_LG" { return 24 }
    return -1
}

// 存储期两段式(§2.4):令牌名 → "@槽位" 标记;折叠期 gs2i/g_parse_color 见 @ 直读槽
fn gtok_mark(w: Str) -> Str {
    var i: I32 = gtok_index(w)
    if i >= 0 {
        return "@" + i.to_string()
    }
    return w
}

fn gtok_slot(v: Str) -> I32 {
    var r: I32 = 0
    var i: I32 = 1
    while i < v.len {
        r = r * 10 + (byte_at(v, i) - 48)
        i += 1
    }
    return r
}

fn g_parse_color(v: Str) -> I32 {
    if v.len > 1 {
        if byte_at(v, 0) == 64 {
            return gui_theme_slot_get(gtok_slot(v))
        }
    }
    if byte_at(v, 0) == 35 {
        if v.len != 7 {
            panic("gui: 颜色须 #RRGGBB,得 " + v)
        }
        var r: I32 = ghex1(byte_at(v, 1)) * 16 + ghex1(byte_at(v, 2))
        var g: I32 = ghex1(byte_at(v, 3)) * 16 + ghex1(byte_at(v, 4))
        var b: I32 = ghex1(byte_at(v, 5)) * 16 + ghex1(byte_at(v, 6))
        return r * 65536 + g * 256 + b
    }
    panic("gui: 未知颜色令牌 " + v)
    return 0
}

fn gs2i(s: Str) -> I32 {
    if s.len > 1 {
        if byte_at(s, 0) == 64 {
            return gui_theme_slot_get(gtok_slot(s))
        }
    }
    var v: I32 = 0
    var i: I32 = 0
    while i < s.len {
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    }
    return v
}

pub struct GuiTree {
    var ntag: List[Str]
    var nflag: List[Str]
    var ncls: List[Str]
    var npre: List[Str]
    var nbid: List[Str]
    var npost: List[Str]
    var nfc: List[I32]
    var ns: List[I32]
    var nes: List[I32]
    var nec: List[I32]
    var ev_name: List[Str]
    var ev_fn: List[Str]
    var btns: List[I32]
    var sk: List[Str]
    var sv: List[Str]
    var props: List[Str]
}

fn gt_new() -> GuiTree {
    return GuiTree {
        ntag: List[Str](),
        ncls: List[Str](),
        npre: List[Str](),
        nbid: List[Str](),
        npost: List[Str](),
        nfc: List[I32](),
        ns: List[I32](),
        nes: List[I32](),
        nec: List[I32](),
        ev_name: List[Str](),
        ev_fn: List[Str](),
        btns: List[I32](),
        sk: List[Str](),
        sv: List[Str](),
        nflag: List[Str](),
        props: List[Str]()
    }
}

// SL-8a:花括号槽表达式捕获(源字节面)——配对闭花括号下标;字符串字面量内
// 花括号不参与配对(转义 \" 不出串)。编译侧 token 直拼与本侧剥空白捕获同规范形。
fn gt_bx_end(src: Str, start: I32) -> I32 {
    var depth: I32 = 1
    var i: I32 = start
    var instr: Bool = false
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        if instr {
            if b == 92 {
                i += 1
            } else {
                if b == 34 {
                    instr = false
                }
            }
        } else {
            if b == 34 {
                instr = true
            } else {
                if b == 123 {
                    depth += 1
                } else {
                    if b == 125 {
                        depth -= 1
                        if depth == 0 {
                            return i
                        }
                    }
                }
            }
        }
        i += 1
    }
    return n
}

// [a,b) 剥空白规范化(字符串字面量内空白保留,转义对直纳)
fn gt_bx_strip(src: Str, a: I32, b: I32) -> Str {
    var out: Str = ""
    var i: I32 = a
    var instr: Bool = false
    while i < b {
        var c: I32 = byte_at(src, i)
        if instr {
            out = out + byte_slice(src, i, i + 1)
            if c == 92 {
                if i + 1 < b {
                    out = out + byte_slice(src, i + 1, i + 2)
                    i += 1
                }
            } else {
                if c == 34 {
                    instr = false
                }
            }
        } else {
            if c == 34 {
                instr = true
                out = out + byte_slice(src, i, i + 1)
            } else {
                if c == 32 || c == 9 || c == 10 || c == 13 {
                    out = out
                } else {
                    out = out + byte_slice(src, i, i + 1)
                }
            }
        }
        i += 1
    }
    return out
}

fn gt_bx_expr(src: Str, cur: Atomic[I32]) -> Str {
    var e: I32 = gt_bx_end(src, cur.load())
    var out: Str = gt_bx_strip(src, cur.load(), e)
    cur.store(e + 1)
    return out
}

// SL-8a:槽形态判——标识符/点链(名字查询通道直通)与否;含运算符的表达式槽
// 待 8b 求值器,运行时响亮 panic(不静默空渲染)
fn gt_slot_simple(v: Str) -> Bool {
    if v.len == 0 {
        return false
    }
    var i: I32 = 0
    while i < v.len {
        var b: I32 = byte_at(v, i)
        if b == 46 || b == 95 {
            i += 1
        } else {
            if b >= 48 {
                if b <= 57 {
                    i += 1
                } else {
                    if b >= 65 {
                        if b <= 90 {
                            i += 1
                        } else {
                            if b >= 97 {
                                if b <= 122 {
                                    i += 1
                                } else {
                                    return false
                                }
                            } else {
                                return false
                            }
                        }
                    } else {
                        return false
                    }
                }
            } else {
                return false
            }
        }
    }
    return true
}

fn gt_attrs(src: Str, cur: Atomic[I32], t: GuiTree, conds: List[Str], binds: List[Str], strs: List[Str]) -> Str {
    var out: Str = ""
    while true {
        gws(src, cur)
        var b: I32 = byte_at(src, cur.load())
        if b == 62 || b == 47 {
            // > 结束;/ = 自闭合标记(input/>,留给调用方消费)
            break
        }
        var an: Str = gword(src, cur)
        if an == "on" {
            glit(src, cur, 58)
            var evn: Str = gword(src, cur)
            glit(src, cur, 61)
            glit(src, cur, 123)
            // SL-8c-3:事件表达式平衡捕获(编译侧 gui_bx_expr 同规范形;单标识符
            // 旧契约为其特例)——glit 已过 {,捕获消费至配对 }
            var fnn: Str = gt_bx_expr(src, cur)
            t.ev_name.push(evn)
            t.ev_fn.push(fnn)
        } else {
            glit(src, cur, 61)
            // 花括号属性值(cond={表达式}):SL-8a 平衡捕获+剥空白规范形
            var av: Str = ""
            if byte_at(src, cur.load()) == 123 {
                cur.store(cur.load() + 1)
                av = gt_bx_expr(src, cur)
            } else {
                av = gstr(src, cur)
            }
            if an == "class" {
                out = av
            }
            if an == "cond" {
                conds.push(av)
            }
            if an == "disabled" {
                // P-W3:button/checkbox 禁用态表达式(复用 cond 通道 → nflag;
                // 逐帧求值,真 = 命中表 -1 哨兵不可点)
                conds.push(av)
            }
            if an == "bind" {
                binds.push(av)
            }
            if an == "checked" {
                // checkbox 选中态表达式(值形态同 bind 槽;SL-8b 求值器消费)
                binds.push(av)
            }
            if an == "placeholder" {
                strs.push(av)
            }
        }
    }
    return out
}

fn gt_leaf_text(src: Str, cur: Atomic[I32], t: GuiTree) -> I32 {
    var start: I32 = cur.load()
    var i: I32 = start
    var n: I32 = src.len
    while i < n {
        var b: I32 = byte_at(src, i)
        if b == 123 {
            break
        }
        if b == 60 {
            break
        }
        i += 1
    }
    var e: I32 = i
    var has_bind: Bool = false
    if i < n {
        if byte_at(src, i) == 123 {
            has_bind = true
        }
    }
    while start < e {
        var c0: I32 = byte_at(src, start)
        if c0 == 32 {
            start += 1
        } else {
            if c0 == 10 {
                start += 1
            } else {
                if c0 == 9 {
                    start += 1
                } else {
                    break
                }
            }
        }
    }
    if !has_bind {
        while e > start {
            var c1: I32 = byte_at(src, e - 1)
            if c1 == 32 {
                e -= 1
            } else {
                if c1 == 10 {
                    e -= 1
                } else {
                    if c1 == 9 {
                        e -= 1
                    } else {
                        break
                    }
                }
            }
        }
    }
    var p0: Str = ""
    if e > start {
        p0 = byte_slice(src, start, e)
    }
    cur.store(i)
    var b: Str = ""
    var p1: Str = ""
    if has_bind {
        cur.store(cur.load() + 1)
        b = gt_bx_expr(src, cur)
        p1 = gspan(src, cur, 60)
    }
    t.npre.push(p0)
    t.nbid.push(b)
    t.npost.push(p1)
    return 0
}


// 本节点 cond 名(cstart 后最后一个;无 = "")
fn gt_cond_pick(conds: List[Str], cstart: I32) -> Str {
    if conds.len > cstart {
        return conds[conds.len - 1]
    }
    return ""
}

fn gt_node(src: Str, cur: Atomic[I32], t: GuiTree, conds: List[Str], binds: List[Str], strs: List[Str], depth: I32) -> I32 {
    glit(src, cur, 60)
    var tag: Str = gword(src, cur)
    var is_leaf: Bool = false
    if tag == "label" {
        is_leaf = true
    }
    if tag == "button" {
        is_leaf = true
    }
    var is_when: Bool = false
    if tag == "when" {
        is_when = true
    }
    var is_each: Bool = false
    if tag == "each" {
        is_each = true
    }
    var is_input: Bool = false
    if tag == "input" {
        is_input = true
    }
    var is_check: Bool = false
    if tag == "checkbox" {
        is_check = true
    }
    if !is_leaf {
        if !is_when {
            if !is_each {
                if !is_input {
                    if !is_check {
                        if tag != "vbox" {
                            if tag != "hbox" {
                                if tag != "spacer" {
                                    panic("gui: 未知元素 " + tag)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if !is_leaf {
        if depth >= 16 {
            panic("gui: 嵌套超限(16)")
        }
    }
    var itemvar: Str = ""
    var listname: Str = ""
    if is_each {
        // 头:item in={列表表达式}(先于 attrs;SL-8a 平衡捕获)
        itemvar = gword(src, cur)
        var inkw: Str = gword(src, cur)
        if inkw != "in" {
            panic("gui: each 期待 in,得 " + inkw)
        }
        glit(src, cur, 61)
        glit(src, cur, 123)
        listname = gt_bx_expr(src, cur)
        gws(src, cur)
    }
    var estart: I32 = t.ev_name.len
    var cstart: I32 = conds.len
    var bstart: I32 = binds.len
    var sstart: I32 = strs.len
    var c: Str = gt_attrs(src, cur, t, conds, binds, strs)
    var id: I32 = t.ntag.len
    if is_input {
        // 自闭合:<input ... />;bind 名 → nbid,placeholder → npre
        glit(src, cur, 47)
        glit(src, cur, 62)
        var ph: Str = ""
        if strs.len > sstart {
            ph = strs[strs.len - 1]
        }
        var bn: Str = ""
        if binds.len > bstart {
            bn = binds[binds.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(ph)
        t.nbid.push(bn)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        return id
    }
    if is_check {
        // 自闭合:<checkbox checked={表达式} ... />;checked → nbid;登记可点击
        glit(src, cur, 47)
        glit(src, cur, 62)
        var bn: Str = ""
        if binds.len > bstart {
            bn = binds[binds.len - 1]
        }
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push("")
        t.nbid.push(bn)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push("")
        t.btns.push(id)
        return id
    }
    if byte_at(src, cur.load()) == 47 {
        // 自闭合空元素(spacer 等,§4.2 内建集):attrs 后 "/>" 即收口无子树
        glit(src, cur, 47)
        glit(src, cur, 62)
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(listname)
        t.nbid.push(itemvar)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        return id
    }
    glit(src, cur, 62)
    if is_leaf {
        if byte_at(src, cur.load()) == 60 {
            if byte_at(src, cur.load() + 1) != 47 {
                panic("gui: 叶子不得嵌套")
            }
        }
        gt_leaf_text(src, cur, t)
        t.ntag.push(tag)
        t.ncls.push(c)
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        glit(src, cur, 60)
        glit(src, cur, 47)
        var et: Str = gword(src, cur)
        if et != tag {
            panic("gui: 闭合标签不匹配 " + et)
        }
        glit(src, cur, 62)
        if tag == "button" {
            t.btns.push(id)
        }
    } else {
        t.ntag.push(tag)
        t.ncls.push(c)
        t.npre.push(listname)
        t.nbid.push(itemvar)
        t.npost.push("")
        t.nfc.push(-1)
        t.ns.push(-1)
        t.nes.push(estart)
        t.nec.push(t.ev_name.len - estart)
        t.nflag.push(gt_cond_pick(conds, cstart))
        var prev: I32 = -1
        while true {
            gws(src, cur)
            if byte_at(src, cur.load()) == 60 {
                if byte_at(src, cur.load() + 1) == 47 {
                    break
                }
            }
            var kid: I32 = gt_node(src, cur, t, conds, binds, strs, depth + 1)
            // 成员链索引赋值(t.nfc[id]=…)解释口径不支持(assign target:Index),
            // 取局部引用中转——List 引用语义下同一底层列表(SL-2v 实证配方)
            var fcl: List[I32] = t.nfc
            var nsl: List[I32] = t.ns
            if prev < 0 {
                fcl[id] = kid
            } else {
                nsl[prev] = kid
            }
            prev = kid
        }
        glit(src, cur, 60)
        glit(src, cur, 47)
        var et2: Str = gword(src, cur)
        if et2 != tag {
            panic("gui: 闭合标签不匹配 " + et2)
        }
        glit(src, cur, 62)
    }
    return id
}

fn gt_style(src: Str, cur: Atomic[I32], t: GuiTree, ext: List[Str]) -> I32 {
    var name: Str = gword(src, cur)
    gws(src, cur)
    // P-W2:extends 单亲派生(§5 StyleExt,仅限本文件)——记 (child, parent) 对
    if cur.load() < src.len {
        if byte_at(src, cur.load()) == 101 {
            var kw: Str = gword(src, cur)
            if kw == "extends" {
                gws(src, cur)
                var pn: Str = gword(src, cur)
                ext.push(name)
                ext.push(pn)
                gws(src, cur)
            }
        }
    }
    glit(src, cur, 123)
    while true {
        gws(src, cur)
        if byte_at(src, cur.load()) == 125 {
            break
        }
        var p: Str = gword(src, cur)
        glit(src, cur, 58)
        gws(src, cur)
        var v: Str = ""
        if byte_at(src, cur.load()) == 34 {
            v = gstr(src, cur)
        } else {
            v = gtok_mark(gword(src, cur))
        }
        t.sk.push(name + "." + p)
        t.sv.push(v)
        gws(src, cur)
        if byte_at(src, cur.load()) == 59 {
            glit(src, cur, 59)
        }
    }
    glit(src, cur, 125)
    return 0
}

// SL-8c-2:view props 形参段("a: T" 逗号分隔,括号已剥)取名入 t.props——
// 冒号前段剥空白;与编译侧 gui_props_names 同名表(s22 双端差分)
fn gt_props_names(seg: Str, t: GuiTree) -> I32 {
    var pi: I32 = 0
    while pi < seg.len {
        var ps: I32 = pi
        while pi < seg.len {
            if byte_at(seg, pi) == 44 {
                break
            }
            pi += 1
        }
        var unit: Str = byte_slice(seg, ps, pi)
        var ui: I32 = 0
        while ui < unit.len {
            if byte_at(unit, ui) == 58 {
                var pn: Str = byte_slice(unit, 0, ui)
                var pe: I32 = pn.len
                while pe > 0 {
                    var pc: I32 = byte_at(pn, pe - 1)
                    if pc == 32 || pc == 9 {
                        pe -= 1
                    } else {
                        break
                    }
                }
                var psi: I32 = 0
                while psi < pe {
                    if byte_at(pn, psi) != 32 && byte_at(pn, psi) != 9 {
                        break
                    }
                    psi += 1
                }
                if pe > psi {
                    t.props.push(byte_slice(pn, psi, pe))
                }
                ui = unit.len
            }
            ui += 1
        }
        pi += 1
    }
    return 0
}

pub fn gt_parse(src: Str) -> GuiTree {
    var t: GuiTree = gt_new()
    var binds = List[Str]()
    var strs = List[Str]()
    var conds = List[Str]()
    var ext = List[Str]()
    var cur = Atomic[I32](0)
    var n: I32 = src.len
    while cur.load() < n {
        gws(src, cur)
        if cur.load() >= n {
            break
        }
        var w: Str = gword(src, cur)
        if w == "view" {
            gword(src, cur)
            gws(src, cur)
            // 8c-2:view props 形参表捕获——"( a: T, b: U )" 平衡圆括号内
            // 逐逗号段取名(冒号前,剥空白)入 t.props(与编译侧 gui_props_names
            // 同名表;s22 双端差分)
            if cur.load() < n {
                if byte_at(src, cur.load()) == 40 {
                    var pd: I32 = 0
                    var us: I32 = -1
                    while cur.load() < n {
                        var pb: I32 = byte_at(src, cur.load())
                        if pb == 40 {
                            pd += 1
                            if pd == 1 {
                                us = cur.load() + 1
                            }
                        } else {
                            if pb == 41 {
                                pd -= 1
                                if pd == 0 {
                                    gt_props_names(byte_slice(src, us, cur.load()), t)
                                    cur.store(cur.load() + 1)
                                    break
                                }
                            }
                        }
                        cur.store(cur.load() + 1)
                    }
                    gws(src, cur)
                }
            }
            glit(src, cur, 123)
            gt_node(src, cur, t, conds, binds, strs, 1)
            gws(src, cur)
            glit(src, cur, 125)
        } else {
            if w == "style" {
                gt_style(src, cur, t, ext)
            } else {
                panic("gui: 顶层仅 view/style,得 " + w)
            }
        }
    }
    gt_ext_resolve(t, ext)
    return t
}

// P-W2:extends 解析——定点迭代把父类属性复制到子类(子已定义者不覆盖;
// 链式派生随迭代收敛,守护 16 轮);父链走查超限 = 环,panic。
fn gt_ext_resolve(t: GuiTree, ext: List[Str]) -> I32 {
    // 环检测:每个 child 沿父链上行;走满 ext 对数仍未到根 = 环
    var ci: I32 = 0
    while ci < ext.len {
        var cur: Str = ext[ci]
        var step: I32 = 0
        var cyc: Bool = true
        while step <= ext.len {
            var found: Bool = false
            var pi: I32 = 0
            while pi < ext.len {
                if ext[pi] == cur {
                    cur = ext[pi + 1]
                    found = true
                    pi = ext.len
                }
                pi += 2
            }
            if !found {
                cyc = false
                step = ext.len + 1
            }
            step += 1
        }
        if cyc {
            panic("gui: 样式 extends 环 " + ext[ci])
        }
        ci += 2
    }
    // 属性复制:定点迭代(g→p→c 链式随轮次收敛)
    var changed: Bool = true
    var guard: I32 = 0
    while changed {
        changed = false
        guard += 1
        if guard > 16 {
            break
        }
        var pi: I32 = 0
        while pi < ext.len {
            var child: Str = ext[pi]
            var parent: Str = ext[pi + 1]
            var pp: Str = parent + "."
            var si: I32 = 0
            while si < t.sk.len {
                var k: Str = t.sk[si]
                if k.len > pp.len {
                    if byte_slice(k, 0, pp.len) == pp {
                        var pname: Str = byte_slice(k, pp.len, k.len)
                        var ck: Str = child + "." + pname
                        if !gt_sk_has(t.sk, ck) {
                            t.sk.push(ck)
                            t.sv.push(t.sv[si])
                            changed = true
                        }
                    }
                }
                si += 1
            }
            pi += 2
        }
    }
    return 0
}

fn gt_sk_has(sk: List[Str], key: Str) -> Bool {
    var i: I32 = 0
    while i < sk.len {
        if sk[i] == key {
            return true
        }
        i += 1
    }
    return false
}

// SL-7β1:骨架表倾倒(与编译器 gui_parse gui_sk_dump_all 同格式,等价差分用)。
// 行口径:n<id> tag= cls= pre= bid= post= flag= fc= ns= es= ec=(空串以 - 表示);
// 之后 e<k> on= fn= 事件表 / btn id= 按钮表 / s 键=值 样式表,序 = push 序。
pub fn sk_dump(t: GuiTree) -> I32 {
    // SL-8c-2:props 名表行(首行;空 = -;与编译器 gui_sk_dump_all 同格式)
    var pline: Str = ""
    var pj: I32 = 0
    while pj < t.props.len {
        if pj > 0 {
            pline = pline + ","
        }
        pline = pline + t.props[pj]
        pj += 1
    }
    if pline == "" {
        pline = "-"
    }
    println("props=" + pline)
    var i: I32 = 0
    while i < t.ntag.len {
        var pre: Str = t.npre[i]
        if pre == "" {
            pre = "-"
        }
        var bid: Str = t.nbid[i]
        if bid == "" {
            bid = "-"
        }
        var post: Str = t.npost[i]
        if post == "" {
            post = "-"
        }
        var flag: Str = t.nflag[i]
        if flag == "" {
            flag = "-"
        }
        var cls: Str = t.ncls[i]
        if cls == "" {
            cls = "-"
        }
        println("n" + i.to_string() + " tag=" + t.ntag[i] + " cls=" + cls + " pre=" + pre + " bid=" + bid + " post=" + post + " flag=" + flag + " fc=" + t.nfc[i].to_string() + " ns=" + t.ns[i].to_string() + " es=" + t.nes[i].to_string() + " ec=" + t.nec[i].to_string())
        i += 1
    }
    var k: I32 = 0
    while k < t.ev_name.len {
        println("e" + k.to_string() + " on=" + t.ev_name[k] + " fn=" + t.ev_fn[k])
        k += 1
    }
    var b: I32 = 0
    while b < t.btns.len {
        println("btn id=" + t.btns[b].to_string())
        b += 1
    }
    var s: I32 = 0
    while s < t.sk.len {
        println("s " + t.sk[s] + "=" + t.sv[s])
        s += 1
    }
    println("sk-end")
    return 0
}

fn gt_cls_prop(classes: Str, prop: Str, dflt: Str, t: GuiTree) -> Str {
    var s: I32 = classes.len - 1
    while s >= 0 {
        var hit: Bool = false
        if s == 0 {
            hit = true
        } else {
            if byte_at(classes, s - 1) == 32 {
                hit = true
            }
        }
        if hit {
            var e: I32 = s
            while e < classes.len {
                if byte_at(classes, e) == 32 {
                    break
                }
                e += 1
            }
            var tok: Str = byte_slice(classes, s, e)
            var key: Str = tok + "." + prop
            var i: I32 = 0
            while i < t.sk.len {
                if t.sk[i] == key {
                    return t.sv[i]
                }
                i += 1
            }
        }
        s -= 1
    }
    return dflt
}
// ==================== 运行时(绑定求值/布局发射/命中/循环) ====================

fn rt_col_r(p: I32) -> I32 {
    return (p / 65536) % 256
}

fn rt_col_g(p: I32) -> I32 {
    return (p / 256) % 256
}

fn rt_col_b(p: I32) -> I32 {
    return p % 256
}

// 列表询问:buf[0] = "each:名",用户逐项 push 标题;返回项文本列表
pub fn rt_bind_items(bind: fn(List[Str]) -> Void, listname: Str) -> List[Str] {
    var buf = List[Str]()
    buf.push("each:" + listname)
    bind(buf)
    var out = List[Str]()
    var i: I32 = 1
    while i < buf.len {
        out.push(buf[i])
        i += 1
    }
    return out
}

fn rt_bind_text(bind: fn(List[Str]) -> Void, name: Str) -> Str {
    var buf = List[Str]()
    buf.push(name)
    bind(buf)
    if buf.len > 1 {
        return buf[buf.len - 1]
    }
    return ""
}

// ==================== SL-8b:受限纯读表达式求值器 ====================
// 值形态 = 打标串:"i:<十进制>" 整 / "b:0|1" 布 / 其余 = 串。bind 通道回答
// 逐字面解码(bare = 串;i:/b: 合形 = 带型),表达式运算产出同形打标串。
// 文法(优先级升):cmp := add (cmpop add)?;add := mul ((+|-) mul)*;
//   mul := unary ((*|/|%) unary)*;unary := - unary | primary;
//   primary := 数字 | "串" | 路径 | ( cmp );路径 := ident(.ident)*(后缀 .len
//   对串回答取字节长)。无调用无赋值(纯读;on: 事件面归 8c)。
// 已知边界(登记):串值恰形如 i:<全数字>/b:0|1 时被解为带型——表达式槽专用,
//   简单槽({ident})不走求值器不受累。

fn bxv_istag(v: Str) -> Bool {
    if v.len < 2 {
        return false
    }
    if byte_at(v, 1) != 58 {
        return false
    }
    var h: I32 = byte_at(v, 0)
    if h == 105 {
        var j: I32 = 2
        if v.len == 2 {
            return false
        }
        while j < v.len {
            var b: I32 = byte_at(v, j)
            if b < 48 || b > 57 {
                return false
            }
            j += 1
        }
        return true
    }
    if h == 98 {
        if v.len != 3 {
            return false
        }
        var t2: I32 = byte_at(v, 2)
        return t2 == 48 || t2 == 49
    }
    return false
}

fn bxv_iv(v: Str) -> I32 {
    var r: I32 = 0
    var j: I32 = 2
    var neg: Bool = false
    if j < v.len {
        if byte_at(v, j) == 45 {
            neg = true
            j += 1
        }
    }
    while j < v.len {
        r = r * 10 + (byte_at(v, j) - 48)
        j += 1
    }
    if neg {
        return -r
    }
    return r
}

fn bxv_tagi(n: I32) -> Str {
    if n == 0 {
        return "i:0"
    }
    var neg: Bool = false
    var m: I32 = n
    if m < 0 {
        neg = true
        m = -m
    }
    var digits: Str = ""
    while m > 0 {
        digits = char_str(48 + m % 10) + digits
        m = m / 10
    }
    if neg {
        return "i:-" + digits
    }
    return "i:" + digits
}

fn bxv_truth(v: Str) -> Bool {
    if bxv_istag(v) {
        if byte_at(v, 0) == 98 {
            return byte_at(v, 2) == 49
        }
        return bxv_iv(v) != 0
    }
    return v != ""
}

// checkbox 选中态真值:带型走 bxv_truth;裸串按约定(""/"0"/"false" = 假)
fn gt_ck_truth(v: Str) -> Bool {
    if bxv_istag(v) {
        return bxv_truth(v)
    }
    if v == "" {
        return false
    }
    if v == "0" {
        return false
    }
    if v == "false" {
        return false
    }
    return true
}

fn bxv_show(v: Str) -> Str {
    if bxv_istag(v) {
        if byte_at(v, 0) == 98 {
            if byte_at(v, 2) == 49 {
                return "true"
            }
            return "false"
        }
        return byte_slice(v, 2, v.len)
    }
    return v
}

fn bxv_ws(e: Str, cur: Atomic[I32]) -> I32 {
    while cur.load() < e.len {
        var b: I32 = byte_at(e, cur.load())
        if b == 32 || b == 9 || b == 10 || b == 13 {
            cur.store(cur.load() + 1)
        } else {
            return 0
        }
    }
    return 0
}

// SL-8c-2:props 链解析(D-8c1 裁决)——props 视图内,prop 根路径先以
// "prop:" 前缀问 props 环境(装配期捕获实例的解析面;8c-4 归 gui.run 生成),
// 未答(空)回落裸名 bind 通道;非 props 视图零改动直问通道。
// 已知边界(登记):each 列表询问("each:名")不经本链,仍走裸名通道。
fn bxv_ask(t: GuiTree, path: Str, bind: fn(List[Str]) -> Void) -> Str {
    if t.props.len > 0 {
        var root: Str = bxv_root(path)
        if gt_sk_has(t.props, root) {
            var pa: Str = rt_bind_text(bind, "prop:" + path)
            if pa != "" {
                return pa
            }
        }
    }
    return rt_bind_text(bind, path)
}

// 路径根:首段(点前)
fn bxv_root(path: Str) -> Str {
    var i: I32 = 0
    while i < path.len {
        if byte_at(path, i) == 46 {
            break
        }
        i += 1
    }
    return byte_slice(path, 0, i)
}

// 路径求值:名通道询问;bare 回答 = 串值(s: 不打标,原样即串);
// 尾 .len 后缀对串回答取字节长(对 i:/b: 带型回答不适用,原样返回)
fn bxv_path(t: GuiTree, e: Str, cur: Atomic[I32], bind: fn(List[Str]) -> Void) -> Str {
    var start: I32 = cur.load()
    while cur.load() < e.len {
        var b: I32 = byte_at(e, cur.load())
        if b == 46 || b == 95 || (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) {
            cur.store(cur.load() + 1)
        } else {
            break
        }
    }
    var path: Str = byte_slice(e, start, cur.load())
    var ans: Str = bxv_ask(t, path, bind)
    if bxv_istag(ans) {
        return ans
    }
    var pl: I32 = path.len
    if pl > 4 {
        if byte_slice(path, pl - 4, pl) == ".len" {
            var base: Str = byte_slice(path, 0, pl - 4)
            if gt_slot_simple(base) {
                var bans: Str = bxv_ask(t, base, bind)
                if !bxv_istag(bans) {
                    return bxv_tagi(bans.len)
                }
            }
        }
    }
    return ans
}

fn bxv_primary(t: GuiTree, e: Str, cur: Atomic[I32], bind: fn(List[Str]) -> Void) -> Str {
    bxv_ws(e, cur)
    if cur.load() >= e.len {
        return ""
    }
    var b: I32 = byte_at(e, cur.load())
    if b == 40 {
        cur.store(cur.load() + 1)
        var v: Str = bxv_cmp(t, e, cur, bind)
        bxv_ws(e, cur)
        if cur.load() < e.len {
            if byte_at(e, cur.load()) == 41 {
                cur.store(cur.load() + 1)
            }
        }
        return v
    }
    if b == 34 {
        cur.store(cur.load() + 1)
        var s: Str = ""
        while cur.load() < e.len {
            var c: I32 = byte_at(e, cur.load())
            cur.store(cur.load() + 1)
            if c == 92 {
                if cur.load() < e.len {
                    s = s + byte_slice(e, cur.load(), cur.load() + 1)
                    cur.store(cur.load() + 1)
                }
            } else {
                if c == 34 {
                    break
                } else {
                    s = s + byte_slice(e, cur.load() - 1, cur.load())
                }
            }
        }
        return s
    }
    if b >= 48 {
        if b <= 57 {
            var start: I32 = cur.load()
            while cur.load() < e.len {
                var d: I32 = byte_at(e, cur.load())
                if d < 48 || d > 57 {
                    break
                }
                cur.store(cur.load() + 1)
            }
            return bxv_tagi(gs2i(byte_slice(e, start, cur.load())))
        }
    }
    if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 {
        return bxv_path(t, e, cur, bind)
    }
    panic("gui 表达式求值:非法记号 " + byte_slice(e, cur.load(), cur.load() + 1))
    return ""
}

fn bxv_unary(t: GuiTree, e: Str, cur: Atomic[I32], bind: fn(List[Str]) -> Void) -> Str {
    bxv_ws(e, cur)
    if cur.load() < e.len {
        if byte_at(e, cur.load()) == 45 {
            cur.store(cur.load() + 1)
            var v: Str = bxv_unary(t, e, cur, bind)
            if bxv_istag(v) {
                if byte_at(v, 0) == 105 {
                    return bxv_tagi(-bxv_iv(v))
                }
            }
            panic("gui 表达式求值:负号仅适用整数")
        }
    }
    return bxv_primary(t, e, cur, bind)
}

fn bxv_mul(t: GuiTree, e: Str, cur: Atomic[I32], bind: fn(List[Str]) -> Void) -> Str {
    var l: Str = bxv_unary(t, e, cur, bind)
    while true {
        bxv_ws(e, cur)
        if cur.load() >= e.len {
            return l
        }
        var op: I32 = byte_at(e, cur.load())
        if op != 42 && op != 47 && op != 37 {
            return l
        }
        cur.store(cur.load() + 1)
        var r: Str = bxv_unary(t, e, cur, bind)
        if op == 42 {
            l = bxv_tagi(bxv_iv(l) * bxv_iv(r))
        } else {
            if op == 47 {
                l = bxv_tagi(bxv_iv(l) / bxv_iv(r))
            } else {
                l = bxv_tagi(bxv_iv(l) % bxv_iv(r))
            }
        }
    }
    return l
}

fn bxv_add(t: GuiTree, e: Str, cur: Atomic[I32], bind: fn(List[Str]) -> Void) -> Str {
    var l: Str = bxv_mul(t, e, cur, bind)
    while true {
        bxv_ws(e, cur)
        if cur.load() >= e.len {
            return l
        }
        var op: I32 = byte_at(e, cur.load())
        if op != 43 && op != 45 {
            return l
        }
        cur.store(cur.load() + 1)
        var r: Str = bxv_mul(t, e, cur, bind)
        var lstr: Bool = !bxv_istag(l)
        var rstr: Bool = !bxv_istag(r)
        if op == 43 {
            if lstr || rstr {
                l = bxv_show(l) + bxv_show(r)
            } else {
                l = bxv_tagi(bxv_iv(l) + bxv_iv(r))
            }
        } else {
            if lstr || rstr {
                panic("gui 表达式求值:串不可减")
            }
            l = bxv_tagi(bxv_iv(l) - bxv_iv(r))
        }
    }
    return l
}

fn bxv_cmp(t: GuiTree, e: Str, cur: Atomic[I32], bind: fn(List[Str]) -> Void) -> Str {
    var l: Str = bxv_add(t, e, cur, bind)
    bxv_ws(e, cur)
    if cur.load() >= e.len {
        return l
    }
    var op: Str = ""
    var b0: I32 = byte_at(e, cur.load())
    if b0 == 61 || b0 == 33 || b0 == 60 || b0 == 62 {
        if cur.load() + 1 < e.len {
            if byte_at(e, cur.load() + 1) == 61 {
                op = byte_slice(e, cur.load(), cur.load() + 2)
                cur.store(cur.load() + 2)
            } else {
                if b0 == 60 || b0 == 62 {
                    op = byte_slice(e, cur.load(), cur.load() + 1)
                    cur.store(cur.load() + 1)
                } else {
                    return l
                }
            }
        } else {
            return l
        }
    } else {
        return l
    }
    var r: Str = bxv_add(t, e, cur, bind)
    var res: Bool = false
    var numeric: Bool = bxv_istag(l) && bxv_istag(r)
    if op == "==" {
        if numeric {
            res = bxv_iv(l) == bxv_iv(r)
        } else {
            res = bxv_show(l) == bxv_show(r)
        }
    } else {
        if op == "!=" {
            if numeric {
                res = bxv_iv(l) != bxv_iv(r)
            } else {
                res = bxv_show(l) != bxv_show(r)
            }
        } else {
            var a: I32 = 0
            var b2: I32 = 0
            if numeric {
                a = bxv_iv(l)
                b2 = bxv_iv(r)
            } else {
                panic("gui 表达式求值:大小比较仅适用整数")
            }
            if op == "<" {
                res = a < b2
            } else {
                if op == "<=" {
                    res = a <= b2
                } else {
                    if op == ">" {
                        res = a > b2
                    } else {
                        res = a >= b2
                    }
                }
            }
        }
    }
    if res {
        return "b:1"
    }
    return "b:0"
}

fn bxv_eval(t: GuiTree, e: Str, bind: fn(List[Str]) -> Void) -> Str {
    var cur = Atomic[I32](0)
    var v: Str = bxv_cmp(t, e, cur, bind)
    return v
}

// ==================== SL-8c-3:事件表达式触发面 ====================
// on:={expr} 自动闭包语义的解释口径落地:单标识符 = 旧名字契约直发(零破坏);
// 调用形态 head(args) = 按头分发(E8120 存在/签名门编译期已校验,"注册表"即
// 装配面 act 闭包),实参经 bind 通道受限求值后弃(值流传待 8c-2 props 环境)。
// ":N" 实例后缀(rt_hit_name each 命中编码)原样透传(P-H1 契约)。

// 事件表达式调用头:前导标识符段(含数字——d1/addn 整段一名)
fn ev_head(e: Str) -> Str {
    var i: I32 = 0
    while i < e.len {
        var b: I32 = byte_at(e, i)
        if b == 95 || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
            i += 1
        } else {
            break
        }
    }
    return byte_slice(e, 0, i)
}

// '(' 配对下标(字符串字面量内标点不参与;失配 = len)
fn ev_paren_end(e: Str, open: I32) -> I32 {
    var depth: I32 = 0
    var instr: Bool = false
    var i: I32 = open
    while i < e.len {
        var c: I32 = byte_at(e, i)
        if instr {
            if c == 92 {
                i += 1
            } else {
                if c == 34 {
                    instr = false
                }
            }
        } else {
            if c == 34 {
                instr = true
            } else {
                if c == 40 {
                    depth += 1
                } else {
                    if c == 41 {
                        depth -= 1
                        if depth == 0 {
                            return i
                        }
                    }
                }
            }
        }
        i += 1
    }
    return e.len
}

// 实参受限求值:顶层逗号切分,逐段 bxv(路径经 bind 通道回答;值现弃——
// 副作用经被调 fn 落地,E8190 豁免面的运行时对偶)
fn ev_eval_args(t: GuiTree, args: Str, bind: fn(List[Str]) -> Void) -> Void {
    var i: I32 = 0
    var start: I32 = 0
    var depth: I32 = 0
    var instr: Bool = false
    while i < args.len {
        var c: I32 = byte_at(args, i)
        if instr {
            if c == 92 {
                i += 1
            } else {
                if c == 34 {
                    instr = false
                }
            }
        } else {
            if c == 34 {
                instr = true
            } else {
                if c == 40 {
                    depth += 1
                } else {
                    if c == 41 {
                        depth -= 1
                    } else {
                        if c == 44 {
                            if depth == 0 {
                                bxv_eval(t, byte_slice(args, start, i), bind)
                                start = i + 1
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    var last: Str = byte_slice(args, start, args.len)
    if last != "" {
        bxv_eval(t, last, bind)
    }
}

// 事件触发统一入口:单标识符直发;调用形态求实参后按头分发。
// 触发期形态非法 = panic 带表达式原文(编译期形态门 E8110 的运行时 belt)。
pub fn ev_fire(t: GuiTree, expr: Str, bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> Void {
    var e: Str = expr
    var suf: Str = ""
    // 尾 ":数字" 实例后缀剥离(仅 ':' 领衔才认——纯数字表达式不误剥)
    var j: I32 = e.len
    while j > 0 {
        var d: I32 = byte_at(e, j - 1)
        if d >= 48 && d <= 57 {
            j -= 1
        } else {
            break
        }
    }
    if j > 0 {
        if j < e.len {
            if byte_at(e, j - 1) == 58 {
                suf = byte_slice(e, j - 1, e.len)
                e = byte_slice(e, 0, j - 1)
            }
        }
    }
    if gt_slot_simple(e) {
        act(e + suf)
    } else {
        var head: Str = ev_head(e)
        if head.len == 0 {
            panic("gui 事件表达式形态非法: " + expr)
        } else {
            var hl: I32 = head.len
            if hl < e.len {
                if byte_at(e, hl) == 40 {
                    var close: I32 = ev_paren_end(e, hl)
                    if close < e.len {
                        ev_eval_args(t, byte_slice(e, hl + 1, close), bind)
                    }
                }
            }
            act(head + suf)
        }
    }
}

// 交互态属性取值(§2.1):st 1=hover 2=active 3=disabled;态前缀属性定义则覆盖,
// 未定义逐级回落基值——零全局默认。前缀形 = 下划线(hover_bg;编译器词法器裸 '-'
// 落算符 token 致样式块段错误,连字符形俟 lex 词法模式补丁后切换——坑位在册)
fn gt_st_prop(c: Str, p: Str, d: Str, t: GuiTree, st: I32) -> Str {
    if st == 3 {
        var dv: Str = gt_cls_prop(c, "disabled_" + p, "", t)
        if dv != "" {
            return dv
        }
        return gt_cls_prop(c, p, d, t)
    }
    if st == 2 {
        var av: Str = gt_cls_prop(c, "active_" + p, "", t)
        if av != "" {
            return av
        }
        var hv: Str = gt_cls_prop(c, "hover_" + p, "", t)
        if hv != "" {
            return hv
        }
        return gt_cls_prop(c, p, d, t)
    }
    if st == 1 {
        var hv2: Str = gt_cls_prop(c, "hover_" + p, "", t)
        if hv2 != "" {
            return hv2
        }
    }
    return gt_cls_prop(c, p, d, t)
}

// 真窗 hover:指针位×命中表首中矩形(与 rt_hit_name 同序同语义),返回节点 id/-1
pub fn rt_hover_node(rects: List[I32], hits: List[I32], px: I32, py: I32) -> I32 {
    var j: I32 = 0
    while j < rects.len {
        var ci: I32 = rects[j]
        var px100: I32 = px * 100
        var py100: I32 = py * 100
        if px100 >= gui_cmd_x100(ci) && px100 < gui_cmd_x100(ci) + gui_cmd_w100(ci) {
            if py100 >= gui_cmd_y100(ci) && py100 < gui_cmd_y100(ci) + gui_cmd_h100(ci) {
                return hits[j]
            }
        }
        j += 1
    }
    return -1
}

fn rt_emit(t: GuiTree, bind: fn(List[Str]) -> Void, itemvar: Str, item: Str, id: I32, hits: List[I32], hinst: List[I32], inst: I32, hov: I32, actn: I32) -> I32 {
    // tag/cls 先读:when 门需在 gui_open 之前定夺(Clay 严序 Open→Configure→Close,
    // 开而未配即关 = CloseElement 崩;when 假必须零触碰)
    var tag: Str = t.ntag[id]
    var c: Str = t.ncls[id]
    // 交互态(§2.1):hover/active 由指针管线穿线;disabled 在各元素 fold 处按真值置 st=3
    var st: I32 = 0
    if hov == id {
        if actn == 1 {
            st = 2
        } else {
            st = 1
        }
    }
    // when 条件:仅 when 元素以旗求值(按钮/checkbox 的 nflag = disabled 槽,P-W3)
    if tag == "when" {
        if t.nflag[id] != "" {
            var fv: Str = "0"
            if gt_slot_simple(t.nflag[id]) && t.props.len == 0 {
                fv = rt_bind_text(bind, "when:" + t.nflag[id])
            } else {
                if bxv_truth(bxv_eval(t, t.nflag[id], bind)) {
                    fv = "1"
                }
            }
            if fv != "1" {
                return 0
            }
        }
    }
    gui_open()
    if tag == "button" {
        // P-W3:disabled 槽(nflag 复用)逐帧求值——真 = 置灰 + 命中表 -1 哨兵
        var dis: Bool = false
        if t.nflag[id] != "" {
            if gt_slot_simple(t.nflag[id]) && t.props.len == 0 {
                dis = gt_ck_truth(rt_bind_text(bind, t.nflag[id]))
            } else {
                dis = bxv_truth(bxv_eval(t, t.nflag[id], bind))
            }
        }
        if dis {
            st = 3
        }
        var bgp: I32 = 0
        var bgv: Str = gt_st_prop(c, "bg", "", t, st)
        if bgv != "" {
            bgp = g_parse_color(bgv)
        }
        gui_cfg(0, 0, 0, 0, 1, 1, 2, gs2i(gt_cls_prop(c, "w", "66", t)),
                2, gs2i(gt_cls_prop(c, "h", "54", t)), bgp)
        var fgs: Str = gt_st_prop(c, "fg", "#ffffff", t, st)
        if dis {
            if gt_cls_prop(c, "disabled_fg", "", t) == "" {
                fgs = "#888888"
            }
        }
        var fgp: I32 = g_parse_color(fgs)
        gui_text(t.npre[id], gs2i(gt_cls_prop(c, "size", "26", t)),
                 rt_col_r(fgp), rt_col_g(fgp), rt_col_b(fgp), 255)
        if dis {
            hits.push(-1)
            hinst.push(-1)
        } else {
            hits.push(id)
            hinst.push(inst)
        }
    } else {
        if tag == "checkbox" {
            // 选中态:nbid 值求值(简单名走通道/表达式走求值器);P-W1 MVP
            var ck: Bool = false
            if t.nbid[id] != "" {
                if gt_slot_simple(t.nbid[id]) && t.props.len == 0 {
                    ck = gt_ck_truth(rt_bind_text(bind, t.nbid[id]))
                } else {
                    ck = bxv_truth(bxv_eval(t, t.nbid[id], bind))
                }
            }
            if t.nflag[id] != "" {
                if gt_slot_simple(t.nflag[id]) && t.props.len == 0 {
                    if gt_ck_truth(rt_bind_text(bind, t.nflag[id])) {
                        st = 3
                    }
                } else {
                    if bxv_truth(bxv_eval(t, t.nflag[id], bind)) {
                        st = 3
                    }
                }
            }
            var cbgv: Str = gt_st_prop(c, "bg", "", t, st)
            var cbgp: I32 = 0
            if cbgv != "" {
                cbgp = g_parse_color(cbgv)
            }
            if cbgp == 0 {
                if ck {
                    cbgp = g_parse_color("#2563eb")
                } else {
                    cbgp = g_parse_color("#3a3a44")
                }
            }
            gui_cfg(0, 0, 0, 0, 1, 1, 2, gs2i(gt_cls_prop(c, "w", "28", t)),
                    2, gs2i(gt_cls_prop(c, "h", "28", t)), cbgp)
            if ck {
                var cfp: I32 = g_parse_color(gt_st_prop(c, "fg", "#ffffff", t, st))
                gui_text("x", gs2i(gt_cls_prop(c, "size", "18", t)),
                         rt_col_r(cfp), rt_col_g(cfp), rt_col_b(cfp), 255)
            }
            hits.push(id)
            hinst.push(inst)
        } else {
        if tag == "label" {
            var ax: I32 = 0
            var al: Str = gt_cls_prop(c, "align", "left", t)
            if al == "right" {
                ax = 2
            } else {
                if al == "center" {
                    ax = 1
                }
            }
            gui_cfg(0, 0, 0, 0, ax, 1, 1, 0, 2, gs2i(gt_cls_prop(c, "h", "40", t)), 0)
            var txt: Str = t.npre[id]
            if t.nbid[id] != "" {
                if t.nbid[id] == itemvar {
                    // each 活动项:项文本直取(不经绑定通道)
                    txt = txt + item + t.npost[id]
                } else {
                    if gt_slot_simple(t.nbid[id]) && t.props.len == 0 {
                        // SL-8c-3:简单名通道也经 bxv_show 解标(带型应答 i:/b:
                        // 上屏取值;裸串应答原样,零破坏)
                        txt = txt + bxv_show(rt_bind_text(bind, t.nbid[id])) + t.npost[id]
                    } else {
                        // SL-8b:表达式槽求值(每帧活值)
                        txt = txt + bxv_show(bxv_eval(t, t.nbid[id], bind)) + t.npost[id]
                    }
                }
            } else {
                txt = txt + t.npost[id]
            }
            var sz: I32 = gs2i(gt_cls_prop(c, "size", "40", t))
            if txt.len > 12 {
                sz = 22
            }
            var fgp2: I32 = g_parse_color(gt_st_prop(c, "fg", "#ffffff", t, st))
            gui_text(txt, sz, rt_col_r(fgp2), rt_col_g(fgp2), rt_col_b(fgp2), 255)
        } else {
        if tag == "input" {
            // 波次二(§2.2):真文本框——盒+值文本(bind 单一起源)+焦点光标(| 前缀
            // 插入,caret 钳制 len=外部改文钉值)+placeholder 灰显(TEXT_MUTED 槽 6)
            var ihm: I32 = 1
            var ihv: I32 = 0
            var ihs: Str = gt_cls_prop(c, "h", "", t)
            if ihs != "" {
                ihm = 2
                ihv = gs2i(ihs)
            }
            var ibgp: I32 = 0
            var ibgv: Str = gt_st_prop(c, "bg", "", t, st)
            if ibgv != "" {
                ibgp = g_parse_color(ibgv)
            }
            gui_cfg(0, 0, 0, 0, 0, 0, 1, 0, ihm, ihv, ibgp)
            var ival: Str = ""
            if t.nbid[id] != "" {
                if gt_slot_simple(t.nbid[id]) && t.props.len == 0 {
                    ival = bxv_show(rt_bind_text(bind, t.nbid[id]))
                } else {
                    ival = bxv_show(bxv_eval(t, t.nbid[id], bind))
                }
            }
            var ifoc: Bool = false
            if gui_focus_node() == id {
                ifoc = true
            }
            var ishow: Str = ival
            var iph: Bool = false
            if !ifoc {
                if ival == "" {
                    if t.npre[id] != "" {
                        ishow = t.npre[id]
                        iph = true
                    }
                }
            } else {
                var ic: I32 = gui_caret_get()
                if ic > ival.len {
                    ic = ival.len
                }
                if ic < 0 {
                    ic = 0
                }
                ishow = byte_slice(ival, 0, ic) + "|" + byte_slice(ival, ic, ival.len)
            }
            if ishow != "" {
                var isz: I32 = gs2i(gt_cls_prop(c, "size", "20", t))
                var ifg: I32 = 0
                if iph {
                    ifg = gui_theme_slot_get(6)
                } else {
                    var ifgs: Str = gt_st_prop(c, "fg", "#ffffff", t, st)
                    ifg = g_parse_color(ifgs)
                }
                gui_text(ishow, isz, rt_col_r(ifg), rt_col_g(ifg), rt_col_b(ifg), 255)
            }
            hits.push(id)
            hinst.push(inst)
        } else {
            var dir: I32 = 1
            if tag == "hbox" {
                dir = 0
            }
            if tag == "hbox" {
                dir = 0
            }
            var gap: I32 = gs2i(gt_cls_prop(c, "gap", "0", t))
            var pad: I32 = gs2i(gt_cls_prop(c, "padding", "0", t))
            var hmode: I32 = 1
            var hval: I32 = 0
            var hs: Str = gt_cls_prop(c, "h", "", t)
            if hs != "" {
                hmode = 2
                hval = gs2i(hs)
            }
            var bgp2: I32 = 0
            var bgv2: Str = gt_st_prop(c, "bg", "", t, st)
            if bgv2 != "" {
                bgp2 = g_parse_color(bgv2)
            }
            gui_cfg(dir, gap, pad, pad, 0, 0, 1, 0, hmode, hval, bgp2)
            if tag == "each" {
                // 按项展开:询问 bind 通道("each:列表名" → 逐项 push 标题),
                // 每项以 itemvar/item 绑定重放孩子子树
                if !gt_slot_simple(t.npre[id]) {
                    panic("gui 绑定表达式解释求值待 SL-8b list: " + t.npre[id])
                }
                var items = rt_bind_items(bind, t.npre[id])
                var ii: I32 = 0
                while ii < items.len {
                    var ch: I32 = t.nfc[id]
                    while ch >= 0 {
                        rt_emit(t, bind, t.nbid[id], items[ii], ch, hits, hinst, ii, hov, actn)
                        ch = t.ns[ch]
                    }
                    ii += 1
                }
            } else {
                var ch: I32 = t.nfc[id]
                while ch >= 0 {
                    rt_emit(t, bind, itemvar, item, ch, hits, hinst, inst, hov, actn)
                    ch = t.ns[ch]
                }
            }
        }
        }
        }
    }
    gui_close()
    return 0
}

pub fn rt_draw_frame(t: GuiTree, bind: fn(List[Str]) -> Void, w: I32, h: I32, hits: List[I32], hinst: List[I32], hov: I32, actn: I32) -> I32 {
    gui_begin_layout(w, h)
    rt_emit(t, bind, "", "", 0, hits, hinst, 0, hov, actn)
    return gui_end_layout()
}

pub fn rt_collect_rects(cmds: I32, out: List[I32]) -> I32 {
    var i: I32 = 0
    while i < cmds {
        if gui_cmd_type(i) == 2 {
            out.push(i)
        }
        i += 1
    }
    return 0
}

pub fn rt_hit_name(t: GuiTree, hits: List[I32], hinst: List[I32], rects: List[I32], px: I32, py: I32) -> Str {
    var j: I32 = 0
    while j < rects.len {
        var ci: I32 = rects[j]
        var px100: I32 = px * 100
        var py100: I32 = py * 100
        if px100 >= gui_cmd_x100(ci) && px100 < gui_cmd_x100(ci) + gui_cmd_w100(ci) {
            if py100 >= gui_cmd_y100(ci) && py100 < gui_cmd_y100(ci) + gui_cmd_h100(ci) {
                if j < hits.len {
                    var node: I32 = hits[j]
                    var inst: I32 = hinst[j]
                    var e: I32 = 0
                    while e < t.nec[node] {
                        var gi: I32 = t.nes[node] + e
                        if t.ev_name[gi] == "click" {
                            if inst > 0 {
                                // each 实例命中:名:下标(旧 todo toggle:idx 契约,
                                // P-H1 实例索引分发缺口收口)
                                return t.ev_fn[gi] + ":" + inst.to_string()
                            }
                            return t.ev_fn[gi]
                        }
                        e += 1
                    }
                }
                return ""
            }
        }
        j += 1
    }
    return ""
}

pub fn rt_expect_text(want: Str) -> I32 {
    var n: I32 = gui_cmd_count()
    var i: I32 = 0
    while i < n {
        if gui_cmd_type(i) == 1 {
            if gui_cmd_text_len(i) == want.len {
                var ok: Bool = true
                var j: I32 = 0
                while j < want.len {
                    if gui_cmd_text_byte(i, j) != byte_at(want, j) {
                        ok = false
                        j = want.len
                    }
                    j += 1
                }
                if ok {
                    return 0
                }
            }
        }
        i += 1
    }
    var d0: I32 = gui_cmd_text_len(0)
    var dump: Str = "cmd0["
    var dj: I32 = 0
    while dj < d0 {
        dump = dump + gui_cmd_text_byte(0, dj).to_string()
        if dj < d0 - 1 { dump = dump + "," }
        dj += 1
    }
    dump = dump + "]"
    panic("gui test: 断言失败,显示无 [" + want + "] cmds=" + gui_cmd_count().to_string() + " " + dump)
    return 1
}

fn rt_nokey(k: I32) -> Void {
}

// ==================== input 编辑管线(波次二 §2.2) ====================

// 值活问:焦点 input 当前文本(bind 单一起源;简单名通道,表达式槽编辑 v1 不支持)
fn rt_in_val(t: GuiTree, node: I32, bind: fn(List[Str]) -> Void) -> Str {
    if t.nbid[node] == "" {
        return ""
    }
    if gt_slot_simple(t.nbid[node]) && t.props.len == 0 {
        return bxv_show(rt_bind_text(bind, t.nbid[node]))
    }
    return ""
}

// on:<evname> 处理器头名提取(节点事件表扫描);未声明返回 ""
fn rt_in_handler(t: GuiTree, node: I32, evname: Str) -> Str {
    var e: I32 = 0
    while e < t.nec[node] {
        var gi: I32 = t.nes[node] + e
        if t.ev_name[gi] == evname {
            return ev_head(t.ev_fn[gi])
        }
        e += 1
    }
    return ""
}

// 「名:载荷」直发(§2.2 事件通道;载荷任意文本,分发取首个冒号)
fn rt_in_fire(t: GuiTree, node: I32, evname: Str, payload: Str, act: fn(Str) -> Void) -> I32 {
    var h: Str = rt_in_handler(t, node, evname)
    if h != "" {
        act(h + ":" + payload)
    }
    return 0
}

// 字符输入:焦点 input 插入码点(utf8_enc)并 fire on:input;非焦点返回 false 回落
fn rt_input_char(t: GuiTree, bind: fn(List[Str]) -> Void, act: fn(Str) -> Void, ch: I32) -> Bool {
    var fn0: I32 = gui_focus_node()
    if fn0 < 0 {
        return false
    }
    if t.ntag[fn0] != "input" {
        return false
    }
    var cur: Str = rt_in_val(t, fn0, bind)
    var caret: I32 = gui_caret_get()
    if caret > cur.len {
        caret = cur.len
    }
    if caret < 0 {
        caret = 0
    }
    var ins: Str = utf8_enc(ch)
    var nw: Str = byte_slice(cur, 0, caret) + ins + byte_slice(cur, caret, cur.len)
    gui_caret_set(caret + ins.len)
    rt_in_fire(t, fn0, "input", nw, act)
    return true
}

// 编辑键:退格/删除(字节级,沿 s12 口径;码点级随 M3)/←→/Home/End/Enter=submit/
// Esc=失焦/Ctrl+V=粘贴;结构编辑后 fire on:input。未消费返回 false 回落 key 闭包
fn rt_input_key(t: GuiTree, bind: fn(List[Str]) -> Void, act: fn(Str) -> Void, k: I32) -> Bool {
    var fn0: I32 = gui_focus_node()
    if fn0 < 0 {
        return false
    }
    if t.ntag[fn0] != "input" {
        return false
    }
    if k == 256 {
        gui_focus_set(-1)
        gui_caret_set(0)
        return true
    }
    var cur: Str = rt_in_val(t, fn0, bind)
    var caret: I32 = gui_caret_get()
    if caret > cur.len {
        caret = cur.len
    }
    if caret < 0 {
        caret = 0
    }
    if k == 259 {
        if caret > 0 {
            var nw: Str = byte_slice(cur, 0, caret - 1) + byte_slice(cur, caret, cur.len)
            gui_caret_set(caret - 1)
            rt_in_fire(t, fn0, "input", nw, act)
        }
        return true
    }
    if k == 261 {
        if caret < cur.len {
            var nw2: Str = byte_slice(cur, 0, caret) + byte_slice(cur, caret + 1, cur.len)
            rt_in_fire(t, fn0, "input", nw2, act)
        }
        return true
    }
    if k == 263 {
        if caret > 0 {
            gui_caret_set(caret - 1)
        }
        return true
    }
    if k == 262 {
        if caret < cur.len {
            gui_caret_set(caret + 1)
        }
        return true
    }
    if k == 268 {
        gui_caret_set(0)
        return true
    }
    if k == 269 {
        gui_caret_set(cur.len)
        return true
    }
    if k == 257 {
        var sh: Str = rt_in_handler(t, fn0, "submit")
        if sh != "" {
            act(sh)
        }
        return true
    }
    if k == 86 {
        if gui_mod_ctrl() == 1 {
            gui_clip_sync()
            var n: I32 = gui_clip_len()
            var cs: Str = ""
            var i: I32 = 0
            while i < n {
                cs = cs + utf8_enc(gui_clip_byte(i))
                i += 1
            }
            var nw3: Str = byte_slice(cur, 0, caret) + cs + byte_slice(cur, caret, cur.len)
            gui_caret_set(caret + cs.len)
            rt_in_fire(t, fn0, "input", nw3, act)
            return true
        }
        return false
    }
    return false
}

fn rt_window_loop(t: GuiTree, title: Str, w: I32, h: I32,
                  bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                  key: fn(I32) -> Void, has_key: Bool) -> I32 {
    var rects = List[I32]()
    var hits = List[I32]()
    var hinst = List[I32]()
    gui_clay_init(w, h)
    var hov: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
    var dn: I32 = gui_mouse_down()
    var n: I32 = rt_draw_frame(t, bind, w, h, hits, hinst, hov, dn)
    rt_collect_rects(n, rects)
    InitWindow(w, h, title)
    SetTargetFPS(60)
    while !WindowShouldClose() {
        var evt: I32 = gui_poll_event()
        if evt == 2 {
            var name: Str = rt_hit_name(t, hits, hinst, rects, gui_evt_x(), gui_evt_y())
            // 波次二:click-to-focus——命中 input 聚焦(光标置尾),命中其它失焦
            var fnode: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
            if fnode >= 0 {
                if t.ntag[fnode] == "input" {
                    gui_focus_set(fnode)
                    var fbv: Str = ""
                    if t.nbid[fnode] != "" {
                        if gt_slot_simple(t.nbid[fnode]) && t.props.len == 0 {
                            fbv = bxv_show(rt_bind_text(bind, t.nbid[fnode]))
                        }
                    }
                    gui_caret_set(fbv.len)
                } else {
                    gui_focus_set(-1)
                }
            } else {
                gui_focus_set(-1)
            }
            if name != "" {
                // SL-8c-3:事件表达式触发面(单标识符旧契约直发,调用形态按头分发)
                ev_fire(t, name, bind, act)
            }
        } else {
            if evt == 3 {
                // 波次二:焦点 input 消费字符(编辑管线),未聚焦原样弃置(旧口径)
                var ic: Bool = rt_input_char(t, bind, act, gui_evt_key())
                if !ic {
                    if has_key {
                        key(gui_evt_key())
                    }
                }
            } else {
                if evt == 1 {
                    // 波次二:焦点 input 编辑键优先(消费边界=不进 key 闭包,s33 锁)
                    var ik: Bool = rt_input_key(t, bind, act, gui_evt_key())
                    if !ik {
                        if has_key {
                            key(gui_evt_key())
                        }
                    }
                }
            }
        }
        rt_draw_frame(t, bind, w, h, hits, hinst,
            rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y()), gui_mouse_down())
        BeginDrawing()
        gui_clear(27, 27, 29)
        ctron_gui_flush()
        EndDrawing()
    }
    CloseWindow()
    return 0
}

// 带热重载的循环(R2/W4-E3 收编):每 60 帧比对 CTML 内容,变更即原址重解析
// (骨架/几何刷新,rects 重收集;用户闭包与状态不动)
fn rt_window_loop_d(t: GuiTree, src: Str, reload: Str, title: Str, w: I32, h: I32,
                    bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                    key: fn(I32) -> Void, has_key: Bool) -> I32 {
    var rects = List[I32]()
    var hits = List[I32]()
    var hinst = List[I32]()
    gui_clay_init(w, h)
    var hov: I32 = rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y())
    var dn: I32 = gui_mouse_down()
    var n: I32 = rt_draw_frame(t, bind, w, h, hits, hinst, hov, dn)
    rt_collect_rects(n, rects)
    InitWindow(w, h, title)
    SetTargetFPS(60)
    var frames: I32 = 0
    while !WindowShouldClose() {
        frames += 1
        if frames >= 60 {
            frames = 0
            var src2: Str = read_file(reload)
            // 空源守卫(SL-7α):文件缺失(内嵌兜底形态/运行中被删)不重解析——
            // 此前 src2="" != src 会 gt_parse("") 清空 UI
            if src2 != "" {
                if src2 != src {
                    var t2: GuiTree = gt_parse(src2)
                    t = t2
                    src = src2
                    hits = List[I32]()
                    hinst = List[I32]()
                    n = rt_draw_frame(t, bind, w, h, hits, hinst,
                        rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y()), gui_mouse_down())
                    rects = List[I32]()
                    rt_collect_rects(n, rects)
                }
            }
        }
        var evt: I32 = gui_poll_event()
        if evt == 2 {
            var name: Str = rt_hit_name(t, hits, hinst, rects, gui_evt_x(), gui_evt_y())
            // 波次二:click-to-focus——命中 input 聚焦(光标置尾),命中其它失焦
            var fnode: I32 = rt_hover_node(rects, hits, gui_evt_x(), gui_evt_y())
            if fnode >= 0 {
                if t.ntag[fnode] == "input" {
                    gui_focus_set(fnode)
                    var fbv: Str = ""
                    if t.nbid[fnode] != "" {
                        if gt_slot_simple(t.nbid[fnode]) && t.props.len == 0 {
                            fbv = bxv_show(rt_bind_text(bind, t.nbid[fnode]))
                        }
                    }
                    gui_caret_set(fbv.len)
                } else {
                    gui_focus_set(-1)
                }
            } else {
                gui_focus_set(-1)
            }
            if name != "" {
                // SL-8c-3:事件表达式触发面(单标识符旧契约直发,调用形态按头分发)
                ev_fire(t, name, bind, act)
            }
        } else {
            if evt == 3 {
                // 波次二:焦点 input 消费字符(编辑管线),未聚焦原样弃置(旧口径)
                var ic: Bool = rt_input_char(t, bind, act, gui_evt_key())
                if !ic {
                    if has_key {
                        key(gui_evt_key())
                    }
                }
            } else {
                if evt == 1 {
                    // 波次二:焦点 input 编辑键优先(消费边界=不进 key 闭包,s33 锁)
                    var ik: Bool = rt_input_key(t, bind, act, gui_evt_key())
                    if !ik {
                        if has_key {
                            key(gui_evt_key())
                        }
                    }
                }
            }
        }
        rt_draw_frame(t, bind, w, h, hits, hinst,
            rt_hover_node(rects, hits, gui_mouse_x(), gui_mouse_y()), gui_mouse_down())
        BeginDrawing()
        gui_clear(27, 27, 29)
        ctron_gui_flush()
        EndDrawing()
    }
    CloseWindow()
    return 0
}

pub fn rt_run(t: GuiTree, title: Str, w: I32, h: I32,
              bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    return rt_window_loop(t, title, w, h, bind, act, rt_nokey, false)
}

pub fn rt_run_kb(t: GuiTree, title: Str, w: I32, h: I32,
                 bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                 key: fn(I32) -> Void) -> I32 {
    return rt_window_loop(t, title, w, h, bind, act, key, true)
}

// d 变体:热重载路径固定 "app.ctml"(默认锚)
pub fn rt_run_d(t: GuiTree, src: Str, title: Str, w: I32, h: I32,
                bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    return rt_window_loop_d(t, src, "app.ctml", title, w, h, bind, act, rt_nokey, false)
}

pub fn rt_run_kb_d(t: GuiTree, src: Str, title: Str, w: I32, h: I32,
                   bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                   key: fn(I32) -> Void) -> I32 {
    return rt_window_loop_d(t, src, "app.ctml", title, w, h, bind, act, key, true)
}

// ==================== 入口与测试驱动(headless) ====================

pub struct Driver {
    var t: GuiTree
    var rects: List[I32]
    var hits: List[I32]
    var hinst: List[I32]
    var hov: I32
    var actn: I32
    var w: I32
    var h: I32
}

fn d_btn_index(t: GuiTree, name: Str) -> I32 {
    var j: I32 = 0
    while j < t.btns.len {
        var node: I32 = t.btns[j]
        var e: I32 = 0
        while e < t.nec[node] {
            var gi: I32 = t.nes[node] + e
            // SL-8c-3:按头匹配(单标识符旧契约全等特例;表达式 {d1(m)} ↔ d_click(t,"d1"))
            if ev_head(t.ev_fn[gi]) == name {
                return j
            }
            e += 1
        }
        j += 1
    }
    return -1
}

pub fn d_click(t: Box[Driver], name: Str) -> Str {
    var j: I32 = d_btn_index(t.t, name)
    if j < 0 {
        panic("gui test: 未知动作 " + name)
        return ""
    }
    var ci: I32 = t.rects[j]
    var cx: I32 = gui_cmd_x100(ci) / 100 + gui_cmd_w100(ci) / 200
    var cy: I32 = gui_cmd_y100(ci) / 100 + gui_cmd_h100(ci) / 200
    gui_inject_click(cx, cy)
    var evt: I32 = gui_poll_event()
    if evt != 2 {
        panic("gui test: 点击事件丢失 " + name)
        return ""
    }
    return name
}

// 交互态注入口(§2.1 headless):名→命中节点(d_btn_index 按钮面);"" 清除
pub fn d_hover(t: Box[Driver], name: Str) -> I32 {
    if name == "" {
        t.hov = -1
        t.actn = 0
        return 0
    }
    var bi: I32 = d_btn_index(t.t, name)
    if bi >= 0 {
        var bl: List[I32] = t.t.btns
        t.hov = bl[bi]
    }
    return 0
}

pub fn d_active(t: Box[Driver], on: I32) -> I32 {
    t.actn = on
    return 0
}

// 焦点注入口(§2.2 headless):聚焦树内首个 input;失焦 = d_blur
pub fn d_focus(t: Box[Driver]) -> I32 {
    var i: I32 = 0
    while i < t.t.ntag.len {
        if t.t.ntag[i] == "input" {
            gui_focus_set(i)
            gui_caret_set(0)
            return 0
        }
        i += 1
    }
    return -1
}

pub fn d_blur(t: Box[Driver]) -> I32 {
    gui_focus_set(-1)
    gui_caret_set(0)
    return 0
}

// 剪贴板注入口(headless 直控缓冲;真窗路径 rt_input_key 粘贴前自系统同步)
pub fn d_clip(t: Box[Driver], s: Str) -> I32 {
    gui_clip_set_c(s)
    return 0
}

// 修饰键注入口(headless;真窗 gui_mod_ctrl 回落 IsKeyDown)
pub fn d_mod(t: Box[Driver], on: I32) -> I32 {
    gui_inject_mod(on)
    return 0
}

// headless 编辑管线注入口:注入→poll→焦点 input 编辑管线路由;消费返 0,未消费返原码
// (与窗口循环同一管线;s33 键消费边界夹具依赖此语义)
pub fn d_send_char(t: Box[Driver], ch: I32, bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    gui_inject_char(ch)
    var evt: I32 = gui_poll_event()
    if evt != 3 {
        panic("gui test: 字符事件丢失")
    }
    var k: I32 = gui_evt_key()
    if rt_input_char(t.t, bind, act, k) {
        return 0
    }
    return k
}

pub fn d_send_key(t: Box[Driver], k: I32, bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    gui_inject_key(k)
    var evt: I32 = gui_poll_event()
    if evt != 1 {
        panic("gui test: 键事件丢失")
    }
    if rt_input_key(t.t, bind, act, gui_evt_key()) {
        return 0
    }
    return gui_evt_key()
}

pub fn d_press_key(t: Box[Driver], k: I32) -> I32 {
    gui_inject_key(k)
    var evt: I32 = gui_poll_event()
    if evt != 1 {
        panic("gui test: 键事件丢失")
        return -1
    }
    return k
}

pub fn d_frame(t: Box[Driver], bind: fn(List[Str]) -> Void) -> I32 {
    var nh = List[I32]()
    var hi = List[I32]()
    var n: I32 = rt_draw_frame(t.t, bind, t.w, t.h, nh, hi, t.hov, t.actn)
    t.hits = nh
    t.hinst = hi
    return n
}

// 注入字符事件(type 3),返回字符码(应用键钩子自行编辑模型)
pub fn d_type_char(t: Box[Driver], k: I32) -> I32 {
    gui_inject_char(k)
    var evt: I32 = gui_poll_event()
    if evt != 3 {
        panic("gui test: 字符事件丢失")
        return -1
    }
    return gui_evt_key()
}

pub fn d_expect_text(t: Box[Driver], want: Str) -> I32 {
    return rt_expect_text(want)
}

// 命令缓冲诊断访问器(自断言钩子/夹具排查用;type: 1=TEXT 2=RECT)
pub fn d_cmd_count() -> I32 {
    return gui_cmd_count()
}

pub fn d_cmd_type(i: I32) -> I32 {
    return gui_cmd_type(i)
}

pub fn d_cmd_text_len(i: I32) -> I32 {
    return gui_cmd_text_len(i)
}

pub fn d_cmd_text_byte(i: I32, j: I32) -> I32 {
    return gui_cmd_text_byte(i, j)
}

// 几何(×100 整数域;黄金帧差分/夹具布局断言用)
pub fn d_cmd_x100(i: I32) -> I32 {
    return gui_cmd_x100(i)
}

pub fn d_cmd_y100(i: I32) -> I32 {
    return gui_cmd_y100(i)
}

pub fn d_cmd_w100(i: I32) -> I32 {
    return gui_cmd_w100(i)
}

pub fn d_cmd_h100(i: I32) -> I32 {
    return gui_cmd_h100(i)
}

// 颜色读回(RECT 命令背景色 0-255;交互态/主题折叠断言用)
pub fn d_cmd_bg_r(i: I32) -> I32 {
    return gui_cmd_bg_r(i)
}

pub fn d_cmd_bg_g(i: I32) -> I32 {
    return gui_cmd_bg_g(i)
}

pub fn d_cmd_bg_b(i: I32) -> I32 {
    return gui_cmd_bg_b(i)
}

// 负断言:want 不出现在任何 TEXT 命令(when 隐藏面)
pub fn d_expect_absent(t: Box[Driver], want: Str) -> I32 {
    var n: I32 = gui_cmd_count()
    var i: I32 = 0
    while i < n {
        if gui_cmd_type(i) == 1 {
            if gui_cmd_text_len(i) == want.len {
                var ok: Bool = true
                var j: I32 = 0
                while j < want.len {
                    if gui_cmd_text_byte(i, j) != byte_at(want, j) {
                        ok = false
                        j = want.len
                    }
                    j += 1
                }
                if ok {
                    panic("gui test: 负断言失败,显示出现 [" + want + "]")
                    return 1
                }
            }
        }
        i += 1
    }
    return 0
}

pub fn test(src: Str, w: I32, h: I32,
            bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
            key: fn(I32) -> Void,
            script: fn(Box[Driver], fn(Str) -> Void, fn(I32) -> Void) -> Void) -> I32 {
    theme_auto_apply()
    var t: GuiTree = gt_parse(src)
    gui_clay_init(w, h)
    var d = Box[Driver](Driver { t: t, rects: List[I32](), hits: List[I32](), hinst: List[I32](), hov: -1, actn: 0, w: w, h: h })
    var n: I32 = rt_draw_frame(d.t, bind, w, h, d.hits, d.hinst, d.hov, d.actn)
    rt_collect_rects(n, d.rects)
    script(d, act, key)
    return 0
}

// SL-7β2:骨架直通测试入口——树已由编译期解析(gui_sk_load)给出,不再经
// gt_parse;其余口径与 test 完全一致(d_* 驱动断言族全可用)
pub fn test_sk(t: GuiTree, w: I32, h: I32,
               bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
               key: fn(I32) -> Void,
               script: fn(Box[Driver], fn(Str) -> Void, fn(I32) -> Void) -> Void) -> I32 {
    theme_auto_apply()
    gui_clay_init(w, h)
    var d = Box[Driver](Driver { t: t, rects: List[I32](), hits: List[I32](), hinst: List[I32](), hov: -1, actn: 0, w: w, h: h })
    var n: I32 = rt_draw_frame(d.t, bind, w, h, d.hits, d.hinst, d.hov, d.actn)
    rt_collect_rects(n, d.rects)
    script(d, act, key)
    return 0
}

pub fn run(src: Str, title: Str, w: I32, h: I32,
           bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    theme_auto_apply()
    var t: GuiTree = gt_parse(src)
    return rt_run(t, title, w, h, bind, act)
}

pub fn run_kb(src: Str, title: Str, w: I32, h: I32,
              bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
              key: fn(I32) -> Void) -> I32 {
    theme_auto_apply()
    var t: GuiTree = gt_parse(src)
    return rt_run_kb(t, title, w, h, bind, act, key)
}

// d 变体:默认锚 "app.ctml" + 热重载环(60 帧内容比对,变更原址重解析)
pub fn run_d(title: Str, w: I32, h: I32,
             bind: fn(List[Str]) -> Void, act: fn(Str) -> Void) -> I32 {
    // 文件优先(开发环 + 热重载),缺失回落内嵌块(SL-7α:程序自身 view/style,
    // 独立二进制零 CWD 依赖)
    var src: Str = read_file("app.ctml")
    if src == "" {
        src = ctron_embedded()
    }
    theme_auto_apply()
    var t: GuiTree = gt_parse(src)
    return rt_run_d(t, src, title, w, h, bind, act)
}

pub fn run_kb_d(title: Str, w: I32, h: I32,
                bind: fn(List[Str]) -> Void, act: fn(Str) -> Void,
                key: fn(I32) -> Void) -> I32 {
    var src: Str = read_file("app.ctml")
    if src == "" {
        src = ctron_embedded()
    }
    theme_auto_apply()
    var t: GuiTree = gt_parse(src)
    return rt_run_kb_d(t, src, title, w, h, bind, act, key)
}

// ==================== 输入辅助 ====================

// 字符码 → 单字符 Str(TextInput/type 3 事件;utf8_enc 透传)
pub fn char_str(k: I32) -> Str {
    return utf8_enc(k)
}
